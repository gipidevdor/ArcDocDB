;;;; C4: native read comparison, fixed scalar baseline, ABBA windows; never a database/NVMe benchmark.
;;; REQ: REQ-AFF-014 REQ-VAL-001 REQ-AFF-008
(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (condition)
                          (unless (typep condition 'sb-kernel:redefinition-warning) (error condition)))))
  (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
  (asdf:load-system "arcdocdb"))

(in-package #:arcdocdb.backup)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(declaim (ftype (function (job io:file-io io:file-io b:index) boolean) benchmark-scalar-file-equal-p))
(defun benchmark-scalar-file-equal-p (job left right size)
  ;; Exact pre-optimization body; name/docstring alone differ from 2acefea's production function.
  (let ((a (job-left job)) (b (job-right job)))
    (loop for offset from 0 below size by (length a) for count = (min (length a) (- size offset))
          always (progn
                   (unless (and (= count (io:leggi-esatto left a 0 count offset))
                                (= count (io:leggi-esatto right b 0 count offset)))
                     (error 'corruption-detected :reason :backup-short-read :offset offset))
                   (loop for i below count always (= (aref a i) (aref b i)))))))

(in-package #:cl-user)
(defun backup-compare-baseline-proof ()
  (let* ((*package* (find-package :arcdocdb.backup)) (*read-eval* nil)
         (old (uiop:run-program '("git" "show" "2acefea:src/backup/copy.lisp") :output :string)))
    (labels ((definition (stream name)
               (loop for form = (read stream nil :eof) until (eq form :eof)
                     when (and (consp form) (eq (car form) 'defun) (eq (second form) name)) return form)))
      (let ((source (with-input-from-string (in old) (definition in 'arcdocdb.backup::equal-file-bytes-p)))
            (frozen (with-open-file (in *load-truename*)
                      (definition in 'arcdocdb.backup::benchmark-scalar-file-equal-p))))
        (unless (and source frozen (equal (third source) (third frozen))
                     (stringp (fourth source)) (equal (cddddr source) (cdddr frozen)))
          (error "Frozen scalar baseline differs from the pinned production body.")))))
  t)
(defun backup-compare-pattern (size)
  (let ((bytes (make-array size :element-type '(unsigned-byte 8))))
    (dotimes (i size bytes) (setf (aref bytes i) (mod i 251)))))
(defun backup-compare-write (path bytes)
  (with-open-file (out path :direction :output :if-exists :error :element-type '(unsigned-byte 8))
    (write-sequence bytes out)))
(defun backup-compare-job (size buffer)
  (arcdocdb.backup::prepare-job (make-array 16 :element-type '(unsigned-byte 8) :initial-element 0)
    (make-array 16 :element-type '(unsigned-byte 8) :initial-element 1)
    (max 4096 size) 1 1 (max 1 (* 2 size)) buffer nil nil))
(defun backup-compare-pair (left-path right-path size buffer consumer)
  (let ((left nil) (right nil) (job (backup-compare-job size buffer)))
    (unwind-protect
         (progn
           (setf left (arcdocdb.io:apri-lettura left-path :max-transfer buffer))
           (setf right (arcdocdb.io:apri-lettura right-path :max-transfer buffer))
           (funcall consumer job left right))
      (when right (arcdocdb.io:chiudi right))
      (when left (arcdocdb.io:chiudi left)))))
(defun backup-compare-self-test (root)
  (let ((checks 0))
    (dolist (size '(0 1 31 32 33 4095 4096 4097 8192 8229))
      (dolist (difference (remove-duplicates (list nil 0 (max 0 (1- size)) 31 4095 4096)))
        (when (or (null difference) (< difference size))
          (let* ((a (backup-compare-pattern size)) (b (copy-seq a))
                 (left (merge-pathnames (format nil "a-~D-~A" size difference) root))
                 (right (merge-pathnames (format nil "b-~D-~A" size difference) root)))
            (when difference (setf (aref b difference) (logxor 1 (aref b difference))))
            (backup-compare-write left a) (backup-compare-write right b)
            (backup-compare-pair left right size 4096
              (lambda (job x y)
                ;; Poison the unused suffix; a final short chunk must not compare it.
                (fill (arcdocdb.backup::job-left job) 19)
                (fill (arcdocdb.backup::job-right job) 23)
                (let ((expected (equalp a b)))
                  (unless (and (eq expected (arcdocdb.backup::benchmark-scalar-file-equal-p job x y size))
                               (eq expected (arcdocdb.backup::equal-file-bytes-p job x y size)))
                    (error "Comparison oracle failed: size=~D difference=~S" size difference))
                  (incf checks))))))))
    (list :kind :backup-comparison-self-test :status :ok :checks checks)))
(defun backup-compare-window (function job left right size iterations)
  (let ((real (get-internal-real-time)) (cpu (get-internal-run-time))
        (bytes (sb-ext:get-bytes-consed)))
    (dotimes (i iterations)
      (unless (funcall function job left right size) (error "Equal-file timing fixture differs.")))
    (let ((allocated (- (sb-ext:get-bytes-consed) bytes))
          (cpu (- (get-internal-run-time) cpu)) (real (- (get-internal-real-time) real)))
      (list :seconds (/ real (float internal-time-units-per-second 1d0))
            :cpu-seconds (/ cpu (float internal-time-units-per-second 1d0))
            :managed-bytes allocated :useful-bytes (* iterations size)
            :physical-read-bytes (* 2 iterations size)))))
(defun backup-compare-run (root &optional reverse-p)
  (let* ((size (+ (* 16 1024 1024) 37)) (bytes (backup-compare-pattern size))
         (left (merge-pathnames "timing-left" root)) (right (merge-pathnames "timing-right" root))
         (order (if reverse-p '(:product :scalar :scalar :product) '(:scalar :product :product :scalar)))
         (rows nil))
    (backup-compare-write left bytes) (backup-compare-write right bytes)
    (dolist (buffer '(4096 65536 1048576))
      (backup-compare-pair left right size buffer
        (lambda (job x y)
          (dolist (function (list #'arcdocdb.backup::benchmark-scalar-file-equal-p
                                 #'arcdocdb.backup::equal-file-bytes-p))
            (unless (funcall function job x y size) (error "Warmup differs.")))
          (sb-ext:gc :full t)
          (dotimes (round 5)
            (dolist (variant order)
              (let* ((function (if (eq variant :scalar) #'arcdocdb.backup::benchmark-scalar-file-equal-p
                                  #'arcdocdb.backup::equal-file-bytes-p))
                     (window (backup-compare-window function job x y size 8)))
                (push (list :buffer-bytes buffer :round round :variant variant :window window) rows)))))))
    (list :schema-version 1 :kind :backup-comparison-benchmark :status :ok
          :runtime (lisp-implementation-version) :machine (machine-type)
          :file-bytes size :iterations-per-window 8 :rounds 5 :order order
          :baseline-ref "2acefea:src/backup/copy.lisp" :baseline-body-verified t
          :rows (nreverse rows)
          :limits '(:native-pread :warm-os-cache :offline-comparison-only :not-end-to-end-backup
                    :not-physical-nvme :host-load-uncontrolled :no-performance-target-qualification))))

(uiop:with-temporary-file (:pathname marker :stream stream :prefix "arcdocdb-compare-" :keep t)
  (close stream)
  (let* ((root (merge-pathnames (make-pathname :name nil :type nil
                                             :directory (append (pathname-directory marker)
                                                                (list (concatenate 'string (file-namestring marker)
                                                                                   ".fixtures"))))))
         (arguments (uiop:command-line-arguments)))
    (ensure-directories-exist (merge-pathnames ".fixture" root))
    (backup-compare-baseline-proof)
    (format t "~&Comparison fixtures retained: ~A~%" root)
    (cond ((equal arguments '("--self-test")) (write (backup-compare-self-test root) :readably t :pretty t))
          ((and (member (length arguments) '(2 3)) (string= "--run" (first arguments))
                (or (= 2 (length arguments)) (string= "--reverse" (third arguments))))
           (let ((result (backup-compare-run root (= 3 (length arguments)))))
             (with-open-file (out (second arguments) :direction :output :if-exists :error)
               (write result :stream out :readably t :pretty t) (terpri out))
             (format t "~&Benchmark completed: ~A~%" (second arguments))))
          (t (error "Use --self-test or --run NEW-RESULT.lisp [--reverse]")))
    (terpri)))
