(defpackage #:arcdocdb.index-rebuild.mutation.probes (:use #:cl))
(in-package #:arcdocdb.index-rebuild.mutation.probes)
(defun run-probes (selected)
  (let ((names '("TEST-REQ-IDX-005-REBUILD-SPLIT-VERIFIED" "TEST-REQ-IDX-005-REBUILD-CORRUPTED-COPY-LOCATION" "TEST-REQ-AFF-008-REBUILD-TRANSIENT-BUDGET" "TEST-REQ-IDX-005-REBUILD-COPY-COMPARISON")))
    (unless (or (null selected) (member selected names :test #'string=))
      (error "Probe sconosciuto."))
    (dolist (name names)
      (when (or (null selected) (string= selected name))
        (setf cl-user::*current-test* name)
        (let ((symbol (find-symbol name "ARCDOCDB.INDEX.PRIMARY.TESTS")))
          (unless (and symbol (fboundp symbol)) (error "Probe assente: ~A" name))
          (funcall symbol))
        (push name cl-user::*passed-tests*)))
    (setf cl-user::*current-test* nil)))
