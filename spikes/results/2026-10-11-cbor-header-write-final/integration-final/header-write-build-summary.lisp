(require :asdf)
(load "tools/evidence-storage.lisp")
(dolist (path (uiop:command-line-arguments))
  (let* ((record (arcdocdb.evidence:read-evidence path))
         (stdout (getf record :stdout))
         (end (search "build e test: nessun avviso, tutti i controlli superati" stdout))
         (lines (uiop:split-string (subseq stdout 0 end) :separator '(#\Newline)))
         (count 0))
    (unless (and end (eq :ok (getf record :status))
                 (eql 0 (getf record :exit-code))
                 (eq :stable (getf record :source-consistency)))
      (error "Controllo completo non riuscito/stabile: ~A." path))
    (dolist (line lines)
      (when (and (plusp (length line)) (digit-char-p (char line 0))
                 (search " test " line) (search "superati." line))
        (incf count (parse-integer line :junk-allowed t))
        (write-line line)))
    (write (list :path path :nominal-tests count :seconds (getf record :wall-seconds)
                 :commit (getf (getf record :environment) :commit)))
    (terpri)))
