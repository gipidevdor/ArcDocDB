;;;; Raccolta conclusiva; codice trusted, registri letti come dati.
(require :asdf)
(let* ((text (uiop:read-file-string "spikes/out/header-write/collect.lisp"))
       (end (search "(let ((args (uiop:command-line-arguments)))" text :from-end t)))
  (unless end (error "Delimitatore del raccoglitore trusted assente."))
  (load (make-string-input-stream (subseq text 0 end))))
(in-package #:cbor-minimal.collection)
(defparameter *publication-root* "spikes/results/2026-10-11-cbor-header-write-final/")
(defun publication-record-path (log)
  (let* ((text (uiop:read-file-string log)) (pos (search "record: " text :from-end t)))
    (unless pos (error "Processo non concluso: ~A." log))
    (string-trim '(#\Space #\Newline #\Return) (subseq text (+ pos 8)))))
(dolist (entry '(("snapshot-coverage-self" "spikes/out/header-write-snapshot-coverage-self.stdout.log")
                 ("snapshot-integrated-check" "spikes/out/header-write-snapshot-integrated-check.stdout.log")
                 ("engine-integrated-check" "spikes/out/header-write-engine-integrated-check.stdout.log")))
  (append-process *publication-root* (first entry) (publication-record-path (second entry))))
(let* ((root (truename *publication-root*)) (path (merge-pathnames "archive-index.lisp" root))
       (index (read-one path)) (files nil))
  (dolist (file (append '(#p"docs/implementazione/cbor-scrittura-risultati.md"
                          #p"arcdocdb.asd" #p"tools/foundation-coverage.lisp"
                          #p"spikes/out/header-write-build-summary.lisp"
                          #p"spikes/out/header-write-publication-append.lisp")
                        (directory "spikes/out/header-write-snapshot-*.log")
                        (directory "spikes/out/header-write-engine-*.log")))
    (push (copy-verified (truename file)
                        (merge-pathnames (format nil "integration-final/~A~A" (file-namestring file)
                                                  (if (equal "md" (pathname-type file)) ".txt" "")) root)
                        root) files))
  (dolist (dir (uiop:subdirectories "spikes/out/"))
    (let* ((name (car (last (pathname-directory dir))))
           (target (merge-pathnames (format nil "integration/~A/" name) root)))
      (when (and (or (search "-check-" name)
                     (equal name "cbor-write-snapshot-coverage-self-20261011"))
                 (not (probe-file target)))
        (dolist (file (selected-files dir))
          (push (copy-verified file (merge-pathnames (enough-namestring file dir) target) root) files)))))
  (setf (getf index :files) (append (getf index :files) (nreverse files)))
  (replace-index path index)
  (audit *publication-root*))
