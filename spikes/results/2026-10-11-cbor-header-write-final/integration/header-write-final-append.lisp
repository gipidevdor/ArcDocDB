;;;; Carica solo il codice trusted del raccoglitore; i registri restano dati.
(require :asdf)
(let* ((text (uiop:read-file-string "spikes/out/header-write/collect.lisp"))
       (end (search "(let ((args (uiop:command-line-arguments)))" text :from-end t)))
  (unless end (error "Delimitatore del raccoglitore trusted assente."))
  (load (make-string-input-stream (subseq text 0 end))))
(in-package #:cbor-minimal.collection)
(defparameter *final-root* "spikes/results/2026-10-11-cbor-header-write-final/")
(defun final-record-path (log)
  (let* ((text (uiop:read-file-string log)) (pos (search "record: " text :from-end t)))
    (unless pos (error "Processo non concluso: ~A." log))
    (string-trim '(#\Space #\Newline #\Return) (subseq text (+ pos 8)))))
(dolist (entry '(("final-collection" "spikes/out/header-write-final-collection.stdout.log")
                  ("integrated-coverage-self" "spikes/out/header-write-integrated-coverage-self.stdout.log")
                  ("integrated-check" "spikes/out/header-write-integrated-check.stdout.log")))
  (append-process *final-root* (first entry) (final-record-path (second entry))))
(let* ((root (truename *final-root*)) (path (merge-pathnames "archive-index.lisp" root))
       (index (read-one path)) (files nil))
  (dolist (file (append '(#p"docs/implementazione/cbor-scrittura-risultati.md"
                          #p"arcdocdb.asd" #p"tools/foundation-coverage.lisp"
                          #p"spikes/out/header-write-final-append.lisp")
                        (directory "spikes/out/header-write-integrated-*.log")))
    (push (copy-verified (truename file)
                        (merge-pathnames (format nil "integration/~A~A" (file-namestring file)
                                                  (if (equal "md" (pathname-type file)) ".txt" "")) root)
                        root) files))
  (dolist (dir (uiop:subdirectories "spikes/out/"))
    (let ((name (car (last (pathname-directory dir)))))
      (when (or (search "-check-" name) (equal name "cbor-write-integrated-coverage-self-20261011"))
        (dolist (file (selected-files dir))
          (push (copy-verified file
                               (merge-pathnames (format nil "integration/~A/~A" name
                                                        (enough-namestring file dir)) root) root) files)))))
  (setf (getf index :files) (append (getf index :files) (nreverse files)))
  (replace-index path index)
  (audit *final-root*))
