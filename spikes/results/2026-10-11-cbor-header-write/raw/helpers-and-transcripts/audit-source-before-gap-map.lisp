;;;; Independent recorded-data audit; never loads product, tests or campaign drivers.
;;;; Only Common Lisp. CLI: --self-test NEWDIR/ | --audit OUT BENCH COVER COVDIR MUT MUTDIR.
(require :asdf)
(require :sb-md5)
(load "tools/evidence-storage.lisp")
(defpackage #:arcdocdb.header-write.audit (:use #:cl))
(in-package #:arcdocdb.header-write.audit)
(declaim (optimize (safety 3) (debug 3)))
(defparameter *observations* nil)
(defparameter *checks* 0)
(defparameter *source* "src/codec/cbor-write.lisp")
(defparameter *source-blob* "61f0d6e2783e4790ed7e19a45bba6407d6e5b3de")
(defparameter *cases*
  '((:inline-23 0 0 23) (:negative-wire-24 1 0 24) (:u16-256 2 0 256)
    (:u32-65536 3 0 65536) (:u64-first 4 1 0)
    (:u64-maximum 5 4294967295 4294967295) (:tag-asymmetric 6 16909060 84281096)))
(defparameter *targets*
  '(("inline-23-nonminimal" "(< low 24)" "(< low 23)")
    ("u8-255-nonminimal" "(< low 256)" "(< low 255)")
    ("u16-65535-nonminimal" "(< low 65536)" "(< low 65535)")
    ("word-little-endian" "(byte 8 (* 8 (- width i 1)))" "(byte 8 (* 8 i))")
    ("u64-high-written-low" "(scrivi-parola-header-cbor bytes cursor next hi 4)"
     "(scrivi-parola-header-cbor bytes cursor next lo 4)")
    ("major-shift-four" "(logior (ash mt 5) ai)" "(logior (ash mt 4) ai)")
    ("physical-capacity" "(when (> size (- limit begin))"
     "(when (> size (- (length bytes) begin))")
    ("returned-next-minus-one" "        next))))" "        (1- next)))))")))

(define-condition audit-failure (error)
  ((label :initarg :label :reader failure-label))
  (:report (lambda (condition stream) (format stream "Audit rejected: ~S" (failure-label condition)))))
(defun need (predicate label)
  (incf *checks*) (unless predicate (error 'audit-failure :label label)) t)
(defun proper (value)
  (handler-case (or (null value) (and (listp value) (list-length value)))
    (type-error () nil)))
(defun plist (value)
  (need (and (consp value) (proper value) (evenp (length value))) :proper-plist)
  (let ((seen nil))
    (loop for key in value by #'cddr do
      (need (and (keywordp key) (not (member key seen))) :unique-keyword)
      (push key seen))) value)
(defun one (stream)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym)))
    (let ((data (read stream nil eof)))
      (need (not (eq eof data)) :nonempty-data)
      (need (eq eof (read stream nil eof)) :single-form-eof) data)))
(defun parsed (text) (with-input-from-string (stream text) (plist (one stream))))
(defun observe (path)
  (push (list :path (namestring (truename path))
              :bytes (arcdocdb.evidence:file-bytes path)
              :sha256 (arcdocdb.evidence:file-sha256 path)) *observations*))
(defun data (path)
  (observe path)
  (arcdocdb.evidence:call-with-evidence-bytes
   path (lambda (plain) (with-open-file (stream plain :external-format :utf-8) (one stream)))))
(defun text (path)
  (observe path)
  (arcdocdb.evidence:call-with-evidence-bytes
   path (lambda (plain) (uiop:read-file-string plain :external-format :utf-8))))
(defun md5 (path)
  (format nil "~(~{~2,'0X~}~)" (coerce (sb-md5:md5sum-file path) 'list)))
(defun stable (report before after)
  (need (and (eq :stable (getf report :source-consistency))
             (consp (getf report before)) (proper (getf report before))
             (equal (getf report before) (getf report after))) :source-stability))
(defun command-object (report)
  (plist report)
  (need (and (eql 1 (getf report :schema-version))
             (eq :command-verification (getf report :kind))
             (eq :ok (getf report :status)) (eql 0 (getf report :exit-code))
             (consp (getf report :command)) (every #'stringp (getf report :command))
             (stringp (getf report :stdout)) (stringp (getf report :stderr))) :command-context)
  (stable report :source-blobs-before :source-blobs-after)
  (let ((entry (find *source* (getf report :source-blobs-before)
                     :key (lambda (entry) (getf (plist entry) :path)) :test #'equal)))
    (need (equal *source-blob* (getf entry :git-blob)) :frozen-product-blob))
  report)
(defun command-record (path)
  (observe path)
  (command-object (arcdocdb.evidence:read-evidence path)))
(defun summary (record)
  (list :command (getf record :command) :status (getf record :status)
        :exit-code (getf record :exit-code) :source-consistency (getf record :source-consistency)
        :started-at-universal-time (getf record :started-at-universal-time)
        :finished-at-universal-time (getf record :finished-at-universal-time)))
(defun approximate (left right)
  (and (realp left) (realp right) (<= (abs (- left right)) (* 1d-10 (max 1d0 (abs right))))))
(defun sink (iterations token)
  (logand most-positive-fixnum (+ (* iterations token) (floor (* iterations (1- iterations)) 2))))
(defun sample-check (sample token count warmup units heap-min heap-max)
  (plist sample)
  (need (and (eql count (getf sample :iterations)) (eql warmup (getf sample :warmup-iterations))
             (eql token (getf sample :expected-return-token))) :sample-parameters)
  (need (and (eql (sink count token) (getf sample :sink))
             (eql (sink count token) (getf sample :expected-sink))) :sample-sink)
  (let ((heap (getf sample :heap-bytes)) (ticks (getf sample :raw-ticks))
        (seconds (getf sample :seconds)) (rate (getf sample :calls-per-second)))
    (need (and (integerp heap) (<= heap-min heap) (or (null heap-max) (<= heap heap-max))) :sample-heap)
    (need (and (integerp ticks) (>= ticks 0) (approximate seconds (/ ticks (float units 1d0)))) :sample-clock)
    (need (if (plusp seconds) (approximate rate (/ count seconds)) (null rate)) :sample-rate)))
(defun reference-header (major high low)
  "Cold independent arithmetic encoder: uses full integer solely in the auditor."
  (let* ((number (+ (* high 4294967296) low))
         (width (cond ((< number 24) 0) ((< number 256) 1) ((< number 65536) 2)
                      ((< number 4294967296) 4) (t 8)))
         (ai (if (zerop width) number (+ 24 (integer-length (1- width))))))
    (cons (+ (* major 32) ai)
          (loop for position from (1- width) downto 0 collect
            (mod (floor number (expt 256 position)) 256)))))
(defun expected-output (bytes) (append '(165 165) bytes '(165 165)))
(defun output-token (bytes next)
  (+ next (loop for byte in bytes for index from 1 sum (* index byte))))
(defun bench-object (report)
  (plist report)
  (need (and (eql 1 (getf report :schema-version)) (eq :cbor-write-benchmark (getf report :kind))
             (eq :ok (getf report :status)) (eql 1 (getf report :workers)) (eql 3 (getf report :safety))) :bench-context)
  (stable report :source-fingerprints-before :source-fingerprints-after)
  (let* ((units (getf report :timer-units-per-second)) (self (plist (getf report :self-test)))
         (cells (getf report :campaigns)) (tokens nil))
    (need (and (integerp units) (plusp units) (eq :ok (getf self :status))) :bench-self-context)
    (sample-check (getf self :baseline) 0 4096 128 units 0 0)
    (sample-check (getf self :positive-control) 1048576 16 0 units 16777216 nil)
    (let ((checker (plist (getf self :output-checker))))
      (need (and (eq :ok (getf checker :status)) (eql 2578 (getf checker :expected-token))
                 (eq t (getf checker :altered-next-rejected))
                 (eql 3 (getf checker :altered-prefix-payload-suffix-rejected))) :output-self-controls))
    (need (and (proper cells) (= 7 (length cells))) :seven-cells)
    (loop for cell in cells for fixture in *cases* do
      (plist cell)
      (destructuring-bind (name major high low) fixture
        (let* ((header (reference-header major high low)) (size (length header))
               (next (+ size 2)) (full (expected-output header)) (token (output-token full next))
               (samples (getf cell :samples)))
          (need (and (eq name (getf cell :name)) (eql major (getf cell :major))
                     (eql high (getf cell :high)) (eql low (getf cell :low))
                     (eql size (getf cell :unit-bytes)) (equal header (getf cell :expected-header-bytes))
                     (equal full (getf cell :expected-full-buffer)) (eql next (getf cell :expected-next))
                     (equal (list next) (getf cell :cold-values)) (eql 1 (getf cell :cold-value-count))
                     (eql token (getf cell :expected-token)) (eql 2 (getf cell :start))
                     (eql next (getf cell :end)) (eq t (getf cell :private-preallocated-buffer))
                     (eq t (getf cell :complete-output-checked-per-call))) :cold-reference-output)
          (need (and (proper samples) (= 5 (length samples))) :five-replicas)
          (dolist (sample samples) (sample-check sample token 4096 128 units 0 0))
          (push (list :name name :header header :next next :token token :sink (sink 4096 token)) tokens))))
    (list :cells 7 :samples 35 :heap-bytes 0 :cold-arity 1 :reference (nreverse tokens)
          :baseline (getf self :baseline) :positive-control (getf self :positive-control))))
(defun bench-audit (path)
  (let ((record (command-record path)))
    (list :wrapper (summary record) :result (bench-object (parsed (getf record :stdout))))))

(defun mutation-output (stdout)
  (let ((at (position #\Newline stdout)))
    (need (and at (uiop:string-prefix-p "Scrittura CBOR: self-test worker superato; " stdout)
               (> at (length "Scrittura CBOR: self-test worker superato; "))) :mutation-known-preamble)
    (parsed (subseq stdout (1+ at)))))
(defun mutation-object (report)
  (plist report)
  (need (and (eql 1 (getf report :schema-version)) (eq :cbor-write-mutations (getf report :kind))
             (eq :ok (getf report :status)) (eql 0 (getf report :worker-errors))) :mutation-context)
  (stable report :source-fingerprints-before :source-fingerprints-after)
  (let ((baseline (plist (getf report :baseline))) (results (getf report :mutants))
        (targets (getf report :targets)))
    (need (and (eq :ok (getf baseline :status)) (eq :ok (getf baseline :result))
               (eql 0 (getf baseline :exit-code)) (null (getf baseline :signal))) :baseline-ok)
    (need (and (proper results) (proper targets) (= 8 (length results)) (= 8 (length targets))) :eight-mutants)
    (loop for entry in results for target in targets for expected in *targets* do
      (plist entry) (plist target)
      (need (and (equal (first expected) (getf entry :name))
                 (equal *source* (getf entry :source-file)) (eq t (getf entry :detected))
                 (eq :detected (getf entry :result)) (null (getf entry :diagnostic))
                 (integerp (getf entry :exit-code)) (not (zerop (getf entry :exit-code)))
                 (null (getf entry :signal))) :mutant-runtime-detected)
      (need (and (equal *source* (getf target :source-file))
                 (equal (first expected) (getf target :name))
                 (equal (second expected) (getf target :before))
                 (equal (third expected) (getf target :after))) :frozen-target-catalog))
    (list :detected 8 :survived 0 :invalid 0 :worker-errors 0)))
(defun line-position (line text)
  (position line (uiop:split-string text :separator '(#\Newline)) :test #'string=
            :key (lambda (row) (string-right-trim '(#\Return) row))))
(defun log-check (path baseline exit signal)
  (let* ((raw (text path)) (smoke (line-position "ok    ARCDOCDB:*VERSION* è una stringa" raw))
         (completion (line-position "build e test: nessun avviso, tutti i controlli superati" raw))
         (rejection (search "Unhandled " raw)))
    (need (and smoke (integerp exit) (null signal)
               (not (some (lambda (needle) (search needle raw :test #'char-equal))
                          '("compilation aborted" "COMPILE-FILE-ERROR" "COMPILE-FILE-WARNED")))
               (if baseline (and (zerop exit) completion (null rejection))
                   (and (not (zerop exit)) (null completion) rejection))) :complete-runtime-log)
    (list :path (namestring path) :smoke-line (1+ smoke) :completion-line (when completion (1+ completion))
          :exit-code exit :signal signal :rejection-position rejection)))
(defun replace-once (source before after)
  (let ((at (search before source)))
    (need (and at (null (search before source :start2 (1+ at)))) :unique-substitution)
    (concatenate 'string (subseq source 0 at) after (subseq source (+ at (length before))))))
(defun safe-relative (name)
  (and (stringp name) (plusp (length name)) (not (char= #\/ (char name 0)))
       (not (find ".." (uiop:split-string name :separator '(#\/)) :test #'equal))))
(defun private-copy (root name fingerprints target)
  (let* ((dir (merge-pathnames (format nil "~A/" name) root)) (changes nil) (count 0))
    (need (and (consp fingerprints) (proper fingerprints)) :copy-fingerprints)
    (dolist (entry fingerprints)
      (plist entry)
      (let ((relative (getf entry :file)))
        (need (safe-relative relative) :copy-relative-path)
        (unless (equal relative "tools/cbor-write-mutation.lisp")
          (let ((path (merge-pathnames relative dir)))
            (need (probe-file path) :copy-file-exists) (incf count)
            (unless (equal (md5 path) (getf entry :md5)) (push relative changes))))))
    (need (equal changes (when target (list *source*))) :one-file-diff)
    (when target
      (need (string= (text (merge-pathnames *source* dir))
                     (replace-once (text (merge-pathnames *source* (merge-pathnames "baseline/" root)))
                                   (second target) (third target))) :exact-substitution))
    (let* ((runner (merge-pathnames "tools/cbor-write-isolated-build.lisp" dir))
           (cache (merge-pathnames "fasl/" dir)) (raw (text runner)))
      (need (and (probe-file cache) (search (namestring dir) raw) (search (namestring cache) raw)
                 (search ":IGNORE-INHERITED-CONFIGURATION" raw :test #'char-equal)
                 (search "tools/build.lisp" raw)) :private-runner-cache))
    (list :copy name :files count :changed-files changes)))
(defun mutations-audit (path directory)
  (let* ((record (command-record path)) (root (uiop:ensure-directory-pathname (truename directory)))
         (report (plist (data (merge-pathnames "report.lisp" root))))
         (baseline (getf report :baseline)) (copies nil) (logs nil))
    (need (equal report (mutation-output (getf record :stdout))) :stdout-final-report)
    (mutation-object report)
    (push (private-copy root "baseline" (getf report :source-fingerprints-before) nil) copies)
    (need (equal (getf baseline :log) (namestring (merge-pathnames "baseline/test.log" root))) :baseline-log-path)
    (push (log-check (merge-pathnames "baseline/test.log" root) t 0 nil) logs)
    (loop for entry in (getf report :mutants) for target in *targets* for index from 0 do
      (let ((log (merge-pathnames (format nil "~D/test.log" index) root)))
        (need (equal (getf entry :log) (namestring log)) :mutant-log-path)
        (push (log-check log nil (getf entry :exit-code) (getf entry :signal)) logs)
        (push (private-copy root index (getf report :source-fingerprints-before) target) copies)))
    (list :wrapper (summary record) :result (mutation-object report)
          :logs (nreverse logs) :copies (nreverse copies))))

(defun strip-tags (raw)
  (with-output-to-string (stream)
    (let ((tag nil)) (loop for character across raw do
      (cond ((char= #\< character) (setf tag t)) ((char= #\> character) (setf tag nil))
            ((not tag) (write-char character stream)))))))
(defun html-parts (raw open close)
  (loop with position = 0 for at = (search open raw :start2 position) while at
    for end = (search close raw :start2 at) do (need end :html-closed-element)
    collect (subseq raw at (+ end (length close))) do (setf position (+ end (length close)))))
(defun html-cells (row)
  (mapcar (lambda (cell) (string-trim '(#\Space #\Newline #\Return) (strip-tags cell)))
          (html-parts row "<td" "</td>")))
(defun coverage-counts (entry)
  (let ((paths (second entry)) (bits (cddr entry)))
    (need (and (vectorp paths) (vectorp bits) (= (length paths) (length bits))) :coverage-vector-length)
    (need (loop for path across paths for bit across bits always
            (and (consp path) (or (numberp (first path)) (keywordp (first path))) (member bit '(0 1)))) :coverage-raw-kinds)
    (list (loop for path across paths for bit across bits count (and (numberp (first path)) (= 1 bit)))
          (loop for path across paths count (numberp (first path)))
          (loop for path across paths for bit across bits count (and (keywordp (first path)) (= 1 bit)))
          (loop for path across paths count (keywordp (first path))))))
(defun coverage-audit (path directory)
  (let* ((record (command-record path)) (root (uiop:ensure-directory-pathname (truename directory)))
         (state-path (merge-pathnames "coverage-state.lisp" root)) (state (data state-path))
         (absolute (namestring (truename *source*)))
         (entry (find absolute state :key #'first :test #'equal))
         (index (text (merge-pathnames "cover-index.html" root)))
         (rows (remove-if-not (lambda (row) (search "<a href='" row)) (html-parts index "<tr" "</tr>"))))
    (need (and (proper state) entry (= 1 (length rows))) :exact-coverage-scope)
    (need (equal "cbor-write" (car (last (getf record :command)))) :coverage-command-scope)
    (let* ((row (first rows)) (cells (html-cells row)) (counts (coverage-counts entry))
           (at (+ 9 (search "<a href='" row))) (end (position #\' row :start at))
           (name (subseq row at end)) (source-html (text (merge-pathnames name root)))
           (source-cells (loop for row in (html-parts source-html "<tr" "</tr>")
                              for cells = (html-cells row)
                              when (member (first cells) '("expression" "branch") :test #'equal) collect cells)))
      (need (and (= 7 (length cells)) (equal "cbor-write.lisp" (first cells))) :coverage-html-source)
      (need (equal counts (mapcar #'parse-integer (list (second cells) (third cells) (fifth cells) (sixth cells)))) :coverage-index-counts)
      (need (and (safe-relative name) (search absolute source-html) (= 2 (length source-cells))
                 (equal counts (loop for cells in source-cells append
                                     (mapcar #'parse-integer (subseq cells 1 3))))) :coverage-source-html-counts)
      (destructuring-bind (ec et bc bt) counts
        (list :wrapper (summary record) :saved-state-file-count (length state) :scope-source-files 1
              :expression-covered ec :expression-total et :branch-covered bc :branch-total bt
              :missing-expressions (- et ec) :missing-branch-outcomes (- bt bc)
              :missing-paths (loop for raw across (second entry) for bit across (cddr entry)
                                  when (zerop bit) collect raw)
              :limits '(:full-denominators :no-guard-exclusions :no-mcdc-claim :no-completeness-inferred))))))

(defun write-new (path value)
  (need (and (uiop:string-prefix-p "spikes/out/header-write/audit" (namestring (pathname path)))
             (not (probe-file path))) :new-authorized-output)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error :if-does-not-exist :create)
    (let ((*print-readably* t)) (write value :stream stream :pretty t) (terpri stream))))
(defun sample-fixture (token iterations warmup units heap)
  (list :iterations iterations :warmup-iterations warmup :expected-return-token token
        :heap-bytes heap :raw-ticks units :seconds 1d0 :calls-per-second (float iterations 1d0)
        :sink (sink iterations token) :expected-sink (sink iterations token)))
(defun bench-fixture ()
  (let ((fingerprints '((:file "fixture" :md5 "fixture"))))
    (list :schema-version 1 :kind :cbor-write-benchmark :status :ok :workers 1 :safety 3
          :source-consistency :stable :source-fingerprints-before fingerprints :source-fingerprints-after fingerprints
          :timer-units-per-second 1000
          :self-test (list :status :ok :baseline (sample-fixture 0 4096 128 1000 0)
                           :positive-control (sample-fixture 1048576 16 0 1000 16777472)
                           :output-checker '(:status :ok :expected-token 2578 :altered-next-rejected t
                                             :altered-prefix-payload-suffix-rejected 3))
          :campaigns (loop for (name major high low) in *cases* collect
            (let* ((header (reference-header major high low)) (next (+ 2 (length header)))
                   (full (expected-output header)) (token (output-token full next)))
              (list :name name :major major :high high :low low :unit-bytes (length header)
                    :expected-header-bytes header :expected-full-buffer full :expected-next next
                    :expected-token token :cold-values (list next) :cold-value-count 1 :start 2 :end next
                    :private-preallocated-buffer t :complete-output-checked-per-call t
                    :samples (loop repeat 5 collect (sample-fixture token 4096 128 1000 0))))))))
(defun mutation-fixture ()
  (let ((fingerprints '((:file "fixture" :md5 "fixture"))))
    (list :schema-version 1 :kind :cbor-write-mutations :status :ok :worker-errors 0
          :source-consistency :stable :source-fingerprints-before fingerprints :source-fingerprints-after fingerprints
          :baseline (list :status :ok :result :ok :exit-code 0 :signal nil)
          :targets (loop for (name before after) in *targets* collect
                     (list :source-file *source* :name name :before before :after after))
          :mutants (loop for (name) in *targets* collect
                     (list :name name :source-file *source* :detected t :result :detected :exit-code 1 :signal nil)))))
(defun rejected (function)
  (handler-case (progn (funcall function) nil) (error () t)))
(defun self-test (directory)
  (let ((root (uiop:ensure-directory-pathname directory)) (results nil))
    (need (not (probe-file root)) :new-self-test-directory)
    (labels ((test (name thunk expected &optional fixture)
               (let ((result (if expected (funcall thunk) (rejected thunk))))
                 (need result (list :self-test name))
                 (write-new (merge-pathnames (format nil "~A.lisp" name) root)
                            (list :case name :expected (if expected :accept :reject) :observed :as-expected :fixture fixture))
                 (push name results))))
      (test "bench-good" (lambda () (bench-object (bench-fixture))) t)
      (dolist (mode '(:heap :sink :arity :full-bytes :stability :positive-control))
        (let ((fixture (bench-fixture)))
          (case mode
            (:heap (setf (getf (first (getf (first (getf fixture :campaigns)) :samples)) :heap-bytes) 1))
            (:sink (incf (getf (first (getf (first (getf fixture :campaigns)) :samples)) :sink)))
            (:arity (setf (getf (first (getf fixture :campaigns)) :cold-values) '(3 4)))
            (:full-bytes (setf (getf (first (getf fixture :campaigns)) :expected-full-buffer) '(0)))
            (:stability (setf (getf fixture :source-consistency) :changed))
            (:positive-control (setf (getf (getf (getf fixture :self-test) :positive-control) :heap-bytes) 0)))
          (test (format nil "bench-~(~A~)" mode) (lambda () (bench-object fixture)) nil fixture)))
      (test "mutants-good" (lambda () (mutation-object (mutation-fixture))) t)
      (dolist (mode '(:signal :survived :invalid :catalog :baseline))
        (let ((fixture (mutation-fixture)))
          (case mode
            (:signal (setf (getf (first (getf fixture :mutants)) :signal) 9))
            (:survived (setf (getf (first (getf fixture :mutants)) :result) :survived))
            (:invalid (setf (getf (first (getf fixture :mutants)) :result) :invalid))
            (:catalog (setf (getf (first (getf fixture :targets)) :after) "wrong"))
            (:baseline (setf (getf (getf fixture :baseline) :exit-code) 1)))
          (test (format nil "mutants-~(~A~)" mode) (lambda () (mutation-object fixture)) nil fixture)))
      (dolist (bad '("(:a 1 :a 2)" "(:a 1) (:b 2)" "#.(error \"reader-eval\")" "(:a 1 . 2)"))
        (test (format nil "reader-~D" (length results)) (lambda () (parsed bad)) nil bad))
      (test "unknown-preamble" (lambda () (mutation-output "unrelated preamble\n(:status :ok)")) nil)
      (test "coverage-good" (lambda () (need (equal '(1 2 1 2)
                       (coverage-counts (list* "fixture" '#((0) (1) (:then 0) (:else 0)) #*1010))) :counts)) t)
      (test "coverage-invalid-bit" (lambda () (coverage-counts (list* "fixture" '#((0)) #(2)))) nil)
      (test "substitution-good" (lambda () (need (equal "aYc" (replace-once "aXc" "X" "Y")) :substitution)) t)
      (test "substitution-duplicate" (lambda () (replace-once "XX" "X" "Y")) nil)
      (list :status :ok :cases (length results) :case-names (nreverse results)
            :limits '(:synthetic-only :no-product-loaded :no-campaign-executed)))))
(defun main ()
  (let ((args (uiop:command-line-arguments)) (report nil) (output nil))
    (cond ((and (= 2 (length args)) (equal "--self-test" (first args)))
           (setf output (merge-pathnames "report.lisp" (uiop:ensure-directory-pathname (second args)))
                 report (self-test (second args))))
          ((and (= 3 (length args)) (equal "--bench-audit" (first args)))
           (setf output (second args)
                 report (list :schema-version 1 :kind :cbor-write-bench-data-audit :status :ok
                              :client-date "2026-10-11" :recorded-at (get-universal-time)
                              :benchmark (bench-audit (third args)))))
          ((and (= 7 (length args)) (equal "--audit" (first args)))
           (setf output (second args))
           (setf report (list :schema-version 1 :kind :cbor-write-data-audit :status :running
                              :recorded-at (get-universal-time) :client-date "2026-10-11"
                              :read-policy '(:read-eval nil :single-form-eof :common-lisp-only :product-not-loaded)))
           (handler-case
               (setf (getf report :benchmark) (bench-audit (third args))
                     (getf report :coverage) (coverage-audit (fourth args) (fifth args))
                     (getf report :mutations) (mutations-audit (sixth args) (seventh args))
                     (getf report :status) :ok)
             (error (condition) (setf (getf report :status) :failed
                                     (getf report :diagnostic) (princ-to-string condition)))))
          (t (error "Usage: --self-test NEWDIR/ | --audit OUT BENCH COVER COVDIR MUT MUTDIR")))
    (setf (getf report :checks) *checks* (getf report :input-observations-before) (nreverse *observations*))
    (let ((after (loop for entry in (getf report :input-observations-before) collect
                   (list :path (getf entry :path) :bytes (arcdocdb.evidence:file-bytes (getf entry :path))
                         :sha256 (arcdocdb.evidence:file-sha256 (getf entry :path))))))
      (setf (getf report :input-observations-after) after)
      (unless (equal (getf report :input-observations-before) after)
        (setf (getf report :status) :source-changed)))
    (write-new output report)
    (format t "Audit ~S, ~D checks: ~A~%" (getf report :status) *checks* output)
    (unless (eq :ok (getf report :status)) (sb-ext:exit :code 1))))
(main)
