(require :asdf)
(load "tools/evidence-storage.lisp")
(dolist (path (uiop:command-line-arguments))
  (let ((record (arcdocdb.evidence:read-evidence path)))
    (write (list :record path :status (getf record :status) :exit (getf record :exit-code)
                 :source (getf record :source-consistency) :seconds (getf record :wall-seconds)))
    (terpri)
    (dolist (line (uiop:split-string (getf record :stdout) :separator '(#\Newline)))
      (when (or (search "test " line) (search "CBOR write" line)
                (search "build e test:" line) (search "errori" line))
        (write-line line)))))
