(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((path (first (uiop:command-line-arguments))) (data (arcdocdb.evidence:read-evidence path))
       (stdout (getf data :stdout)))
  (format t "Record ~A~%Status ~S, exit~S, consistency~S, wall~S~%" path (getf data :status)
          (getf data :exit-code) (getf data :source-consistency) (getf data :wall-seconds))
  (dolist (line (uiop:split-string stdout :separator '(#\Newline)))
    (when (or (search "superati" line) (search "simple write:" line) (search "string write:" line)
              (search "nessun avviso" line) (search "violazioni" line) (search "errori" line))
      (write-line line))))
