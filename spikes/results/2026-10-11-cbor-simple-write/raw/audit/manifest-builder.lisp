(require :asdf)
(load "tools/evidence-storage.lisp")
(defun read-one (path)
  (with-open-file (s path)
    (let ((*read-eval* nil)) (read s))))
(defun save-new (path data)
  (with-open-file (s path :direction :output :if-exists :error)
    (let ((*print-readably* t)) (write data :stream s :pretty t) (terpri s))))
(let* ((root (truename "spikes/out/cbor-simple-write-20261011/"))
       (known (read-one (merge-pathnames "processes.lisp" root)))
       (processes nil) (trees nil) (files nil) (counter 0))
  (dolist (path (sort (directory "spikes/out/*-command-*/report.lisp") #'string< :key #'namestring))
    (let ((datum (arcdocdb.evidence:read-evidence path)))
      (unless (eq :command-verification (getf datum :kind)) (error "Record inatteso ~A" path))
      (push (list (or (first (find (namestring path) known :key #'second :test #'equal))
                      (format nil "extra-~2,'0D" (incf counter))) (namestring path)) processes)))
  (dolist (spec '(("frozen" "frozen/" :all) ("mutations" "mutations/" :lisp-and-log)
                  ("coverage" "coverage/" :all) ("coverage-self-test" "coverage-self-test/" :lisp-and-log)
                  ("audit-self-test" "audit-self-test/" :all) ("worker-protocol-fix" "worker-protocol-fix/" :all)
                  ("physical-capacity-revision" "physical-capacity-revision/" :all)))
    (destructuring-bind (label dir mode) spec
      (push (list label (namestring (truename (merge-pathnames dir root))) mode) trees)))
  (dolist (dir (uiop:subdirectories "spikes/out/"))
    (when (search "cbor-simple-write-worker-self-test" (namestring dir))
      (push (list (car (last (pathname-directory dir))) (namestring dir) :lisp-and-log) trees)))
  (dolist (file (directory (merge-pathnames "coverage-self-test/*.html" root)))
    (push (list (concatenate 'string "coverage-self-test-html/" (file-namestring file)) (namestring file)) files))
  (dolist (file (uiop:directory-files root))
    (unless (or (search "draft" (file-namestring file))
                (equal "manifest.lisp" (file-namestring file)))
      (push (list (concatenate 'string "audit/" (file-namestring file)) (namestring file)) files)))
  (dolist (name '("c4-review-draft.md"))
    (let ((source (merge-pathnames name root))
          (target (merge-pathnames (concatenate 'string name ".txt") root)))
      (unless (probe-file source) (error "Lettura finale mancante ~A" source))
      (when (probe-file target) (error "Lettura snapshot già presente ~A" target))
      (uiop:copy-file source target)
      (push (list (concatenate 'string "readings/" name ".txt") (namestring target)) files)))
  (setf processes (nreverse processes) trees (nreverse trees) files (nreverse files))
  (save-new (merge-pathnames "manifest.lisp" root)
    (list :schema-version 1 :processes processes :trees trees :files files))
  (format t "Manifest: ~D processi, ~D alberi, ~D file espliciti.~%" (length processes) (length trees) (length files)))
