(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((args (uiop:command-line-arguments)) (target (first args))
       (pairs (rest args)) (root (truename "spikes/out/"))
       (processes nil) (trees nil) (files nil) (seen nil))
  (unless (and target (evenp (length pairs))) (error "Manifesto e coppie label/record richiesti."))
  (loop for (label path) on pairs by #'cddr do
    (let ((record (arcdocdb.evidence:read-evidence path)))
      (unless (and (eq :command-verification (getf record :kind))
                   (not (eq :running (getf record :status))))
        (error "Record non concluso: ~A" path))
      (push (truename (uiop:pathname-directory-pathname path)) seen)
      (push (list label path) processes)))
  (dolist (directory (uiop:subdirectories root))
    (let ((name (car (last (pathname-directory directory)))))
      (cond ((search "-command-" name)
             (unless (member directory seen :test #'equal)
               (error "Processo non elencato: ~A" directory)))
            ((not (equal "header-write" name))
             (push (list name (namestring directory)
                         (if (equal name "cbor-string-write-mutations-20261011")
                             :lisp-and-log :all)) trees)))))
  (dolist (file (uiop:directory-files root))
    (push (list (concatenate 'string "setup/" (file-namestring file)) (namestring file)) files))
  (with-open-file (stream target :direction :output :if-exists :error)
    (let ((*print-readably* t))
      (write (list :schema-version 1 :processes (nreverse processes)
                   :trees (nreverse trees) :files (nreverse files)) :stream stream :pretty t)
      (terpri stream)))
  (format t "Manifesto: ~D processi, ~D alberi, ~D file esterni.~%"
          (length processes) (length trees) (length files)))
