(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((path (first (uiop:command-line-arguments)))
       (wrapper (arcdocdb.evidence:read-evidence path))
       (stdout (getf wrapper :stdout)))
  (format t "record ~A status ~S exit ~S source ~S seconds ~S~%"
          path (getf wrapper :status) (getf wrapper :exit-code)
          (getf wrapper :source-consistency) (getf wrapper :wall-seconds))
  (if (and stdout (> (length stdout) 0) (char= (char stdout 0) #\())
      (let* ((*read-eval* nil) (report (read-from-string stdout)))
        (format t "kind ~S status ~S diagnostic ~S~%" (getf report :kind)
                (getf report :status) (getf report :diagnostic))
        (dolist (entry (getf report :campaigns))
          (format t "fixture ~S samples ~D heap ~S seconds ~S~%"
                  (getf entry :name) (length (getf entry :samples))
                  (mapcar (lambda (s) (getf s :heap-bytes)) (getf entry :samples))
                  (mapcar (lambda (s) (getf s :seconds)) (getf entry :samples))))
        (when (getf report :baseline) (format t "baseline ~S~%" (getf report :baseline)))
        (dolist (entry (getf report :mutants))
          (format t "mutant ~S result ~S exit ~S diagnostic ~S~%"
                  (getf entry :name) (getf entry :result)
                  (getf entry :exit-code) (getf entry :diagnostic))))
      (dolist (line (uiop:split-string (or stdout "") :separator '(#\Newline)))
        (when (or (search "superat" line) (search "error" line :test #'char-equal)
                  (search "Rapporto:" line) (search "worker" line :test #'char-equal)
                  (search "fuzz:" line))
          (write-line line))))
  (unless (eq :ok (getf wrapper :status))
    (write-line (or (getf wrapper :stderr) ""))))
