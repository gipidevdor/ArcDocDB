(defpackage #:arcdocdb.key-hash.mutation.probes (:use #:cl))
(in-package #:arcdocdb.key-hash.mutation.probes)
(defun run-probes (selected)
  (let ((names '("TEST-REQ-IDX-001-HASH-VECTORS" "TEST-REQ-IDX-001-HASH-SEED-HIGH" "TEST-REQ-IDX-001-HASH-LENGTH" "TEST-REQ-IDX-001-HASH-TAIL" "TEST-REQ-IDX-001-HASH-BLOCKS" "TEST-REQ-IDX-005-HASH-MAP-PHYSICAL-SLOTS" "TEST-REQ-IDX-005-HASH-MAP-SEED-MISMATCH")))
    (unless (or (null selected) (member selected names :test #'string=))
      (error "Probe sconosciuto."))
    (dolist (name names)
      (when (or (null selected) (string= selected name))
        (setf cl-user::*current-test* name)
        (let* ((package (if (search "REQ-IDX-005" name)
                            "ARCDOCDB.INDEX.PRIMARY.TESTS" "ARCDOCDB.HASH64.TESTS"))
               (symbol (find-symbol name package)))
          (unless (and symbol (fboundp symbol)) (error "Probe assente: ~A" name))
          (funcall symbol))
        (push name cl-user::*passed-tests*)))
    (setf cl-user::*current-test* nil)))
