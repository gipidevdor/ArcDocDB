;;;; DATA only: post-control-merge make build lint trace links; no product/driver call.
;;;; CLI: RECORD HEAD NOMINAL BYTES SHA256.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:cbor-array-control-integration-data-reader (:use #:cl))
(in-package #:cbor-array-control-integration-data-reader)
(defvar *checks* 0)
(defparameter *array-pins*
  '(("src/codec/cbor-array-input.lisp" "d3b3d07fc18bd2a077c1a2d79020a76263b2779e")
    ("src/codec/cbor-array-write.lisp" "a410297c29c5d043ad60d3804bd3711e22c2833b")
    ("tests/codec/cbor-array-write-support.lisp" "eb1fccadb205e375b4a2324a6b6725a860bb546f")
    ("tests/codec/cbor-array-write.lisp" "b13f58264f3cd97e1947ee52936732a7fcebe672")
    ("tests/codec/cbor-array-write-threads.lisp" "5720110265b67019937f08cbd949b4469a04b867")))
(defun check (truth reason)
  (incf *checks*)
  (unless truth (error "Control integration data check failed: ~S" reason)))
(defun plist (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test #'eq)))
    (check (and size (evenp size)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-key)
             (setf (gethash key seen) t)))
  data)
(defun inventory (entries)
  (check (and (consp entries) (list-length entries)) :proper-inventory)
  (let ((seen (make-hash-table :test #'equal)))
    (dolist (entry entries)
      (plist entry)
      (let ((path (getf entry :path)) (hash (getf entry :git-blob)))
        (check (and (stringp path) (stringp hash) (= 40 (length hash)) (not (gethash path seen))) :unique-source)
        (setf (gethash path seen) hash)))
    seen))
(defun prefixp (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))
(defun lines (text)
  (loop for start = 0 then (1+ stop) for stop = (position #\Newline text :start start)
        collect (subseq text start stop) while stop))
(let ((args (uiop:command-line-arguments)))
  (check (= 5 (length args)) :cli-five)
  (destructuring-bind (path head nominal bytes sha) args
    (let* ((before-bytes (arcdocdb.evidence:file-bytes path))
           (before-sha (arcdocdb.evidence:file-sha256 path))
           (data (plist (arcdocdb.evidence:read-evidence path)))
           (env (plist (getf data :environment)))
           (before (inventory (getf data :source-blobs-before)))
           (after (inventory (getf data :source-blobs-after)))
           (command (getf data :command)) (items (lines (getf data :stdout)))
           (marker "build e test: nessun avviso, tutti i controlli superati")
           (stop (position marker items :test #'equal)) (functional (and stop (subseq items 0 stop)))
           (nominal-count (parse-integer nominal)))
      (check (and (= (parse-integer bytes) before-bytes) (equal sha before-sha)) :explicit-physical-observation)
      (check (and (eql 1 (getf data :schema-version)) (eq :command-verification (getf data :kind))
                  (eq :ok (getf data :status)) (eql 0 (getf data :exit-code))
                  (eq :stable (getf data :source-consistency))) :completed-wrapper)
      (check (and (equal head (getf env :commit)) (equal "" (getf env :working-tree))) :commit-and-working-tree)
      (check (and (equal "make" (file-namestring (first command)))
                  (equal '("build" "lint" "trace" "links") (rest command))) :exact-command-profile)
      (check (and (plusp (hash-table-count before)) (= (hash-table-count before) (hash-table-count after))
                  (equal (getf data :source-blobs-before) (getf data :source-blobs-after))) :stable-source-inventories)
      (dolist (pin *array-pins*)
        (check (equal (second pin) (gethash (first pin) before)) :array-before-pin)
        (check (equal (second pin) (gethash (first pin) after)) :array-after-pin))
      (check (and stop (= 1 (count marker items :test #'equal))) :build-marker)
      (check (= nominal-count (count-if (lambda (x) (prefixp "ok    TEST-" x)) functional)) :nominal-before-marker)
      (check (= (+ nominal-count 2) (count-if (lambda (x) (prefixp "ok    " x)) functional)) :nominal-plus-smoke)
      (dolist (smoke '("ok    package ARCDOCDB presente" "ok    ARCDOCDB:*VERSION* è una stringa"))
        (check (= 1 (count smoke functional :test #'equal)) :two-smoke))
      (dolist (line '("200 file, 0 violazioni"
                      "119 requisiti, 65 invarianti, 13 scenari FI, 52 ADR: 0 errori"
                      "420 file, 2856 link controllati, 0 rotti"))
        (check (= 1 (count line (subseq items (1+ stop)) :test #'equal)) :final-check-line))
      (check (and (not (search "tools/run-spikes.lisp --check" (getf data :stdout)))
                  (not (search "--script tools/check-evidence.lisp" (getf data :stdout)))) :no-full-check-inference)
      (dolist (needle '("WARNING:" "STYLE-WARNING:" "compilation aborted"))
        (check (not (search needle (getf data :stderr) :test #'char-equal)) :compiler-warning))
      (check (and (= before-bytes (arcdocdb.evidence:file-bytes path))
                  (equal before-sha (arcdocdb.evidence:file-sha256 path))) :physical-input-unchanged)
      (let ((*print-readably* t))
        (write (list :status :ok :checks *checks* :record path :head head :wrapper-status (getf data :status)
                     :exit-code (getf data :exit-code) :source-consistency (getf data :source-consistency)
                     :source-count (hash-table-count before) :array-pins-before-and-after *array-pins* :command command
                     :nominal-tests nominal-count :smoke 2 :lint "200/0" :trace "119/65/13/52/0"
                     :links "420/2856/0" :wall-seconds (getf data :wall-seconds)
                     :physical-observation (list :bytes before-bytes :sha256 before-sha)
                     :limits '(:data-only :metadata-coherence :no-authentication :no-product-or-driver-load
                               :build-lint-trace-links-only :earlier-full-checks-remain-premerge-observations
                               :no-new-campaign-or-coverage-qualification-claim)) :pretty t)
        (terpri)))))
