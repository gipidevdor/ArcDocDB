;;;; Attach frozen supporting inputs to a completed command folder before archival.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun input-fingerprint (path)
  (list :bytes (arcdocdb.evidence:file-bytes path)
        :sha256 (arcdocdb.evidence:file-sha256 path)))
(let* ((base "spikes/out/cbor-array-write-20261013/")
       (record-root "spikes/out/4000918234-command-80054-0/")
       (record (arcdocdb.evidence:read-evidence (concatenate 'string record-root "report.lisp")))
       (review (merge-pathnames "review/" base))
       (prefix "control-integration-reading")
       (sources (append (list *load-truename*
                              (merge-pathnames "integration-reading-6.md" review)
                              #P"docs/implementazione/cbor-array-risultati.md")
                        (sort (remove-if-not
                               (lambda (path) (uiop:string-prefix-p prefix (file-namestring path)))
                               (uiop:directory-files review)) #'string< :key #'namestring)))
       (copies nil))
  (assert (and (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
               (eq :stable (getf record :source-consistency))
               (getf record :finished-at-universal-time)))
  (assert (probe-file (merge-pathnames "control-integration-reading.md" review)))
  (dolist (source sources)
    (let* ((before (input-fingerprint source))
           (leaf (file-namestring source))
           (name (if (string-equal "md" (or (pathname-type source) ""))
                     (concatenate 'string leaf ".txt") leaf))
           (target (merge-pathnames (concatenate 'string "final-inputs/" name) record-root)))
      (assert (not (probe-file target)))
      (ensure-directories-exist target)
      (uiop:copy-file source target)
      (assert (and (equal before (input-fingerprint source))
                   (equal before (input-fingerprint target))))
      (push (list :source (namestring source) :target (namestring target) :fingerprint before) copies)))
  (let ((report-path (merge-pathnames "final-inputs/copy-observation.lisp" record-root)))
    (with-open-file (stream report-path :direction :output :if-exists :error :external-format :utf-8)
      (let ((*print-readably* t))
        (write (list :schema-version 1 :kind :frozen-input-copy-observation :status :ok
                     :copies (nreverse copies) :limits '(:local-before-after-and-copy :no-authentication))
               :stream stream :pretty t)
        (terpri stream))))
  (format t "Frozen inputs copied and verified: ~D.~%" (length sources)))
