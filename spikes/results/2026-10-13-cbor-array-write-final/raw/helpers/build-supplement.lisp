;;;; C4 supplement manifest builder; does not copy, collect, publish or run product.
;;;; CLI: --write NEWMANIFEST [--process LABEL REPORT] [--file RELATIVE SOURCE]
;;;;      [--tree LABEL DIR all|lisp-and-log]. Extras must already be frozen.
(require :asdf)
(require :sb-posix)
(let ((*load-verbose* nil) (*load-print* nil) (*standard-output* *error-output*))
  (load "tools/evidence-storage.lisp"))
(defpackage #:arcdocdb.cbor-array.supplement-manifest (:use #:cl))
(in-package #:arcdocdb.cbor-array.supplement-manifest)
(declaim (optimize (safety 3) (debug 3)))

(defparameter *base* "spikes/out/cbor-array-write-20261013/")
(defparameter *builder* *load-truename*)
(defparameter *initial-processes*
  '(("final-check3" "spikes/out/4000914822-command-10423-0/report.lisp")
    ("preparation1" "spikes/out/4000915223-command-20470-0/report.lisp")
    ("interrupted-collection1" "spikes/out/4000915242-command-20835-0/report.lisp")
    ("preparation2" "spikes/out/4000915593-command-32424-0/report.lisp")))
(defparameter *initial-trees*
  '(("rawspikes3" "spikes/out/4000915025-check-15198-0/" :lisp-and-log)
    ("snapshot-self-test3" "spikes/out/4000914851-snapshot-self-test-10971-0/" :all)
    ("reader-self-test3" "spikes/out/4000914852-reader-self-test-10981-0/" :all)
    ("review" "spikes/out/cbor-array-write-20261013/review/" :all)))
(defparameter *excluded-directories* '("fasl" "cache" ".cache" "fasl-cache" "private-fasl" "private-cache"))

(defun relative-label-p (value)
  "Same simple relative path domain as collector1; no glob, escape or empty part."
  (and (stringp value) (<= 1 (length value) 4096)
       (not (find-if (lambda (character)
                       (or (< (char-code character) 32) (= (char-code character) 127)
                           (find character "\\:*?[]"))) value))
       (let ((parts (uiop:split-string value :separator "/")))
         (and (<= (length parts) 128)
              (every (lambda (part) (and (plusp (length part))
                                         (not (member part '("." "..") :test #'string=)))) parts)))))
(defun occupied-p (path)
  "LSTAT also rejects a dangling symlink as an occupied output."
  (handler-case
      (progn (sb-posix:lstat (namestring path)) t)
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:enoent (sb-posix:syscall-errno condition)) nil (error condition)))))
(defun tree-mode (word)
  (cond ((string= word "all") :all) ((string= word "lisp-and-log") :lisp-and-log)
        (t (error "Unknown tree mode: ~S." word))))
(defun parse-options (arguments)
  (unless (and (>= (length arguments) 2) (string= "--write" (first arguments)))
    (error "Use --write NEWMANIFEST with optional --process/--file/--tree."))
  (let ((output (second arguments)) (rest (cddr arguments)) (processes nil) (trees nil) (files nil))
    (loop while rest for option = (pop rest)
          do (cond ((and (string= option "--process") (>= (length rest) 2))
                    (push (list (pop rest) (pop rest)) processes))
                   ((and (string= option "--file") (>= (length rest) 2))
                    (push (list (pop rest) (pop rest)) files))
                   ((and (string= option "--tree") (>= (length rest) 3))
                    (let ((label (pop rest)) (directory (pop rest)) (mode (pop rest)))
                      (push (list label directory (tree-mode mode)) trees)))
                   (t (error "Unknown or incomplete manifest option: ~S." option))))
    (values output (nreverse processes) (nreverse trees) (nreverse files))))
(defun compiled-or-cache-p (path)
  (or (string-equal "fasl" (or (pathname-type path) ""))
      (some (lambda (part) (and (stringp part)
                                (member (string-downcase part) *excluded-directories* :test #'equal)))
            (pathname-directory path))))
(defun md-source-p (path)
  (string-equal "md" (or (pathname-type path) "")))
(defun data-label (label source)
  (unless (relative-label-p label) (error "Invalid relative label: ~S." label))
  (if (and (or (md-source-p source) (md-source-p label))
           (not (string-equal "txt" (or (pathname-type label) ""))))
      (concatenate 'string label ".txt") label))
(defun future-reading-p (path review-root)
  "Automatic selection always excludes future collection-reading names.
   A named --file can include one only after the coordinator freezes it."
  (let ((name (file-namestring path)) (prefix "collection-reading"))
    (and (uiop:subpathp path review-root) (<= (length prefix) (length name))
         (string= prefix name :end2 (length prefix)))))
(defun forbidden-tree-p (directory base collection-root)
  "No collection tree, partial attempt, campaign root or ancestor enumeration."
  (or (equal directory base) (uiop:subpathp directory collection-root)
      (uiop:subpathp collection-root directory)))
(defun selected-files (directory mode review-root)
  "Explicit finite inventory; numeric data/code are copied later, never loaded here."
  (let ((base (truename (uiop:ensure-directory-pathname directory)))
        (visited (make-hash-table :test #'equal)) (files nil) (excluded nil))
    (labels ((walk (dir)
               (let* ((canonical (truename dir)) (name (namestring canonical)))
                 (unless (uiop:subpathp canonical base) (error "Tree escapes its root: ~A." dir))
                 (when (gethash name visited) (error "Repeated/cyclic directory: ~A." dir))
                 (setf (gethash name visited) t)
                 (dolist (file (uiop:directory-files canonical))
                   (let ((source (truename file)))
                     (unless (uiop:subpathp source base) (error "File escapes its tree: ~A." file))
                     (cond ((compiled-or-cache-p file) (push (list :path (namestring file) :reason :compiled-or-cache) excluded))
                           ((future-reading-p file review-root) (push (list :path (namestring file) :reason :future-reading-not-frozen) excluded))
                           ((or (eq :all mode) (member (pathname-type file) '("lisp" "log" "gz") :test #'string-equal))
                            (push file files)))))
                 (dolist (sub (uiop:subdirectories canonical))
                   (if (compiled-or-cache-p sub)
                       (push (list :path (namestring sub) :reason :compiled-or-cache-directory) excluded)
                       (walk sub))))))
      (walk base))
    (values (sort files #'string< :key #'namestring)
            (sort excluded #'string< :key (lambda (entry) (getf entry :path))))))
(defun unique-plist (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test #'eq)))
    (unless (and size (evenp size)) (error "Proper plist required."))
    (loop for key in data by #'cddr
          do (unless (and (keywordp key) (not (gethash key seen))) (error "Repeated/invalid plist key: ~S." key))
             (setf (gethash key seen) t)))
  data)
(defun read-process (label source)
  "Only the finished command wrapper is interpreted, never collection SUCCESS."
  (unless (and (relative-label-p label) (not (find #\/ label)))
    (error "Invalid process label: ~S." label))
  (let ((data (unique-plist (arcdocdb.evidence:read-evidence source :max-expanded-bytes 67108864))))
    (unless (and (eql 1 (getf data :schema-version)) (eq :command-verification (getf data :kind))
                 (member (getf data :status) '(:ok :failed))
                 (integerp (getf data :started-at-universal-time))
                 (integerp (getf data :finished-at-universal-time))
                 (<= (getf data :started-at-universal-time) (getf data :finished-at-universal-time))
                 (integerp (getf data :exit-code)) (stringp (getf data :stdout)) (stringp (getf data :stderr)))
      (error "Invalid or unfinished command record: ~A." source))
    data))
(defun main ()
  (multiple-value-bind (output extra-processes extra-trees extra-files)
      (parse-options (rest sb-ext:*posix-argv*))
    (let* ((root (truename "./")) (base (merge-pathnames *base* root))
           (collection-root (merge-pathnames "collection/" base))
           (review-root (merge-pathnames "review/" base))
           (destination (merge-pathnames output root))
           (process-inputs (append (copy-tree *initial-processes*) extra-processes))
           (tree-inputs (append (copy-tree *initial-trees*) extra-trees))
           (file-inputs (append (list (list "helpers/build-supplement.lisp" (namestring *builder*))
                                     (list "helpers/append.lisp" (namestring (merge-pathnames "append.lisp" collection-root)))) extra-files))
           (process-labels (make-hash-table :test #'equal)) (tree-labels (make-hash-table :test #'equal))
           (targets (make-hash-table :test #'equal)) (sources (make-hash-table :test #'equal))
           (processes nil) (files nil) (process-inventory nil) (tree-inventory nil) (exclusions nil))
      (when (or (uiop:directory-pathname-p destination) (occupied-p destination))
        (error "Manifest output must be a new file: ~A." destination))
      (labels ((add-target (target source)
                 (unless (relative-label-p target) (error "Invalid archive target: ~S." target))
                 (when (gethash target targets) (error "Duplicate archive target: ~A." target))
                 (when (gethash (namestring source) sources) (error "Duplicate explicit source: ~A." source))
                 (setf (gethash target targets) t (gethash (namestring source) sources) t))
               (add-file (label path)
                 (let* ((source (truename path)) (name (data-label label source)))
                   (when (or (uiop:directory-pathname-p source) (compiled-or-cache-p source))
                     (error "Non-file or compiled/cache explicit source: ~A." source))
                   (add-target (concatenate 'string "raw/" name) source)
                   (push (list name (namestring source)) files))))
        (dolist (entry process-inputs)
          (destructuring-bind (label path) entry
            (when (gethash label process-labels) (error "Duplicate process label: ~A." label))
            (setf (gethash label process-labels) t)
            (let* ((source (truename path)) (directory (uiop:pathname-directory-pathname source))
                   (data (read-process label source)))
              (when (uiop:subpathp destination directory) (error "Output lies inside a process input: ~A." directory))
              (multiple-value-bind (selected excluded) (selected-files directory :all review-root)
                ;; Collector1 owns process-directory copying: it cannot rename/filter these members.
                (when excluded (error "Process directory contains excluded files/cache; isolate its finished record: ~A." directory))
                (dolist (file selected)
                  (when (md-source-p file) (error "Process directory contains Markdown; isolate its finished record: ~A." file))
                  (add-target (format nil "processes/~A/~A" label (enough-namestring file directory)) (truename file))))
              (push (list label (namestring source)) processes)
              (push (list :label label :path (namestring source) :status (getf data :status)
                          :exit-code (getf data :exit-code) :source-consistency (getf data :source-consistency)
                          :result-policy :finished-wrapper-only-no-result-inference) process-inventory))))
        (dolist (entry tree-inputs)
          (destructuring-bind (label path mode) entry
            (unless (and (relative-label-p label) (member mode '(:all :lisp-and-log)))
              (error "Invalid tree: ~S." entry))
            (when (gethash label tree-labels) (error "Duplicate tree label: ~A." label))
            (setf (gethash label tree-labels) t)
            (let ((directory (truename (uiop:ensure-directory-pathname path))))
              (when (or (forbidden-tree-p directory base collection-root) (uiop:subpathp destination directory))
                (error "Live/partial collection tree or output within selected tree: ~A." directory))
              (multiple-value-bind (selected excluded) (selected-files directory mode review-root)
                (dolist (file selected)
                  (add-file (format nil "~A/~A" label (enough-namestring file directory)) file))
                (setf exclusions (append exclusions excluded))
                (push (list :label label :source (namestring directory) :mode mode
                            :selected-files (length selected) :expanded-into-files t) tree-inventory)))))
        (dolist (entry file-inputs) (add-file (first entry) (second entry))))
      (let ((manifest (list :schema-version 1 :processes (nreverse processes) :trees nil
                            :files (sort files #'string< :key #'first)
                            :preparation-inventory
                            (list :processes (nreverse process-inventory) :trees (nreverse tree-inventory)
                                  :excluded (sort exclusions #'string< :key (lambda (entry) (getf entry :path))))
                            :preparation-limits
                            '(:explicit-frozen-inputs :caller-confirms-extra-input-freeze
                              :finished-command-status-not-collection-success :failed-wrappers-preserved
                              :no-live-or-partial-collection-tree :no-latest-directory-selection
                              :tree-inventory-expanded-into-files :future-collection-readings-not-automatically-selected
                              :markdown-destinations-md-txt :compiled-and-cache-inputs-excluded
                              :explicit-source-and-target-collisions-rejected :no-product-execution
                              :no-byte-copy-or-collection-or-publication :inventory-not-authentication))))
        (ensure-directories-exist destination)
        (with-open-file (stream destination :direction :output :if-exists :error :external-format :utf-8)
          (let ((*print-readably* t)) (write manifest :stream stream :pretty t) (terpri stream)))
        (let ((*print-readably* t))
          (write (list :schema-version 1 :kind :cbor-array-supplement-manifest-preparation :status :ok
                       :manifest (namestring destination) :process-count (length (getf manifest :processes))
                       :tree-input-count (length tree-inputs) :explicit-file-count (length files)
                       :limits '(:manifest-preparation-only :no-collection-success-inference)) :pretty t)
          (terpri))))))

(main)
