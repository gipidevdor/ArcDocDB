;;;; Preserve the original observation; prepare a verified independent copy for compression.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((source "spikes/out/cbor-array-write-20261013/collection/collection-observation-4000915863-37359-0.lisp")
       (target "spikes/out/cbor-array-write-20261013/collection/observation-copy/collection-observation.lisp")
       (before (list :bytes (arcdocdb.evidence:file-bytes source)
                     :sha256 (arcdocdb.evidence:file-sha256 source))))
  (assert (not (probe-file target)))
  (ensure-directories-exist target)
  (uiop:copy-file source target)
  (dolist (path (list source target))
    (assert (equal before (list :bytes (arcdocdb.evidence:file-bytes path)
