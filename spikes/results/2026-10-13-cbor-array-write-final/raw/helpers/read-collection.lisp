;;;; Read a completed collection and its independent closure as DATA only.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((args (rest sb-ext:*posix-argv*))
       (observation-path (first args))
       (closure-path (second args)))
  (assert (= 2 (length args)))
  (let* ((observation (arcdocdb.evidence:read-evidence observation-path))
         (closure (arcdocdb.evidence:read-evidence closure-path))
         (execution (getf observation :independent-closure)))
    (assert (and (eq :parallel-collection-observation (getf observation :kind))
                 (eq :ok (getf observation :status))
                 (eq :complete (getf observation :phase))
                 (= 4 (getf observation :workers))
                 (= 4 (length (getf observation :worker-errors)))
                 (every #'null (getf observation :worker-errors))
                 (= (getf observation :planned-files)
                    (reduce #'+ (getf observation :worker-copied-counts)))
                 (eql 0 (getf execution :exit-code))
                 (null (getf execution :signal))
                 (equal (truename closure-path) (truename (getf execution :log)))
                 (eq :command-archive-audit (getf closure :kind))
                 (eq :ok (getf closure :status))
                 (getf closure :closed-inventory)
                 (= (getf observation :planned-files) (getf closure :indexed-files))))
    (let ((*print-readably* t))
      (write (list :schema-version 1 :kind :collection-data-reading :status :ok
                   :observation observation :independent-closure closure
                   :limits '(:completed-metadata-only :no-product-load :no-new-campaign
                             :no-extra-sha-sweep :no-authentication :pre-append-inventory))
             :pretty t)
      (terpri))))
