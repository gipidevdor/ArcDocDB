;;;; C4: frozen collection data, sizes and mapping only; no SHA sweep or driver execution.
(load "tools/evidence-storage.lisp")
(defpackage #:array.collection.reading (:use #:cl))
(in-package #:array.collection.reading)

(defun text (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((result (make-string (file-length stream))))
      (subseq result 0 (read-sequence result stream)))))
(defun plain-data (path)
  ;; Used for the compressed-evidence descriptor, without expanding its payload.
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof))) (assert (eq eof (read stream nil eof))) form))))
(defun prefixp (prefix string)
  (and (<= (length prefix) (length string)) (string= prefix string :end2 (length prefix))))
(defun hex64-p (value)
  (and (stringp value) (= 64 (length value))
       (every (lambda (character) (find character "0123456789abcdef")) value)))
(defun data (path) (arcdocdb.evidence:read-evidence path))
(defun schema (record kind)
  (assert (and (eql 1 (getf record :schema-version)) (eq kind (getf record :kind)))))
(defun inventory (root)
  ;; Size/path inventory, never file SHA. Symlinks and special objects are rejected.
  (let ((files (make-hash-table :test #'equal)) (visits 0))
    (labels ((walk (directory depth)
               (assert (<= depth 128))
               (dolist (path (directory (make-pathname :name :wild :type :wild :defaults directory)
                                       :resolve-symlinks nil))
                 (assert (<= (incf visits) 100000))
                 (let* ((name (string-right-trim "/" (namestring path)))
                        (mode (sb-posix:stat-mode (sb-posix:lstat name))))
                   (cond ((sb-posix:s-isdir mode) (walk path (1+ depth)))
                         ((sb-posix:s-isreg mode)
                          (let ((relative (subseq (namestring path) (length (namestring root)))))
                            (assert (not (gethash relative files)))
                            (setf (gethash relative files) (arcdocdb.evidence:file-bytes path))))
                         (t (error "Nonregular archive entry: ~A" path)))))))
      (walk root 0)) files))
(defun metadata-equal (left right)
  (every (lambda (key) (equalp (getf left key) (getf right key)))
         '(:label :record-path :status :exit-code :source-consistency :command)))
(defun mapped-origin (entry manifest)
  (let ((relative (getf entry :path)) (source (getf entry :source)) (matches 0))
    (flet ((match (wanted-relative wanted-source)
             (when (and (string= wanted-relative relative)
                        (string= (namestring (truename wanted-source)) source))
               (incf matches))))
      (match "collection-manifest.lisp" "spikes/out/cbor-array-write-20261013/collection/manifest-2.lisp")
      (match "collection-source.lisp" "spikes/out/cbor-array-write-20261013/collection/collect.lisp")
      (dolist (pair (getf manifest :files))
        (match (concatenate 'string "raw/" (first pair)) (second pair))))
    (dolist (pair (getf manifest :processes))
      (let* ((prefix (format nil "processes/~A/" (first pair)))
             (base (namestring (make-pathname :name nil :type nil :defaults (truename (second pair))))))
        (when (and (prefixp prefix relative)
                   (string= source (concatenate 'string base (subseq relative (length prefix)))))
          (incf matches))))
    (dolist (tree (getf manifest :trees))
      (let ((prefix (format nil "raw/~A/" (first tree)))
            (base (namestring (truename (second tree)))))
        (when (and (prefixp prefix relative)
                   (string= source (concatenate 'string base (subseq relative (length prefix)))))
          (assert (not (find "fasl" (pathname-directory (pathname relative)) :test #'string=)))
          (when (eq :lisp-and-log (third tree))
            (assert (member (pathname-type relative) '("lisp" "log" "gz") :test #'string=)))
          (incf matches))))
    (assert (= 1 matches))))

(let* ((base "spikes/out/cbor-array-write-20261013/collection/")
       (outer-path "spikes/out/4000915862-command-37341-0/report.lisp")
       (manifest-path (concatenate 'string base "manifest-2.lisp"))
       (preflight-path (concatenate 'string base "preflight-2.lisp"))
       (observation-path (concatenate 'string base "collection-observation-4000915863-37359-0.lisp"))
       (closure-path (concatenate 'string base "closed-check-4000916242-37359-0.log"))
       (root (truename "spikes/results/2026-10-13-cbor-array-write/"))
       (index-path (merge-pathnames "archive-index.lisp" root))
       (catalogue-path (merge-pathnames "catalogo.lisp" root))
       (metadata-paths (list outer-path manifest-path preflight-path observation-path closure-path index-path catalogue-path))
       (metadata-sizes (mapcar #'arcdocdb.evidence:file-bytes metadata-paths))
       (metadata-shas (mapcar #'arcdocdb.evidence:file-sha256 metadata-paths))
       (outer (data outer-path)) (manifest (data manifest-path)) (preflight (data preflight-path))
       (observation (data observation-path)) (closure (data closure-path))
       (index (data index-path)) (catalogue (data catalogue-path))
       (files (getf index :files)) (processes (getf index :processes))
       (copied (getf observation :copy-results)) (actual (inventory root))
       (indexed (make-hash-table :test #'equal)) (copy-map (make-hash-table :test #'equal))
       (sum 0) (plain-count 0) (gzip-count 0) (max-plain 0) (max-gzip 0) (ok 0) (failed 0))
  (schema outer :command-verification)
  (assert (and (eq :ok (getf outer :status)) (eql 0 (getf outer :exit-code))
               (eq :stable (getf outer :source-consistency))
               (equalp (getf outer :source-blobs-before) (getf outer :source-blobs-after))
               (zerop (length (getf outer :stderr)))
               (member manifest-path (getf outer :command) :test #'string=)))
  (format t "OUTER OK/exit0/STABLE source-blobs~D wall~S HEAD~A stderr0; stdout~A"
          (length (getf outer :source-blobs-before)) (getf outer :wall-seconds)
          (getf (getf outer :environment) :commit) (getf outer :stdout))
  (schema preflight :archive-preflight) (schema observation :parallel-collection-observation)
  (schema closure :command-archive-audit) (schema index :original-command-archive)
  (schema catalogue :evidence-catalog)
  (assert (and (eq :ok (getf preflight :status)) (eql 1 (getf manifest :schema-version))
               (equalp manifest (data (merge-pathnames "collection-manifest.lisp" root)))
               (string= (text (concatenate 'string base "collect.lisp"))
                        (text (merge-pathnames "collection-source.lisp" root)))))
  (assert (and (eq :ok (getf observation :status)) (eq :complete (getf observation :phase))
               (eql 4 (getf observation :workers)) (eql 3 (getf observation :sha-per-copy))
               (equal '(nil nil nil nil) (getf observation :worker-errors))
               (= 4 (length (getf observation :worker-copied-counts)))
               (every #'plusp (getf observation :worker-copied-counts))
               (= 3003 (getf observation :planned-files) (length copied)
                  (reduce #'+ (getf observation :worker-copied-counts)))))
  (let ((independent (getf observation :independent-closure)))
    (assert (and (eql 0 (getf independent :exit-code)) (null (getf independent :signal))
                 (equal (truename closure-path) (truename (getf independent :log))))))
  (assert (and (eq :ok (getf closure :status)) (getf closure :closed-inventory)
               (null (getf closure :origins-compared)) (null (getf closure :read-eval))
               (getf closure :eof-required)
               (string= (getf closure :archive) (namestring root))))
  (assert (and (eq :read-without-result-inference (getf index :metadata-policy))
               (equal '(:sha256-byte-copy-check :raw-originals-preserved
                        :fasl-excluded-from-published-mutation-trees :no-requirement-or-release-promotion)
                      (getf index :limits))
               (null (getf catalogue :pending)) (null (getf catalogue :formats))
               (equalp '((:kind :original-command-archive :artifact "archive-index.lisp"
                          :artifact-schema-version 1 :artifact-kind :original-command-archive))
                       (getf catalogue :entries))))
  (assert (equal (mapcar (lambda (row) (getf row :path)) files)
                 (sort (mapcar (lambda (row) (getf row :path)) files) #'string<)))
  (dolist (row copied)
    (assert (eq :ok (getf row :status)))
    (let ((entry (getf row :entry)))
      (assert (not (gethash (getf entry :path) copy-map)))
      (setf (gethash (getf entry :path) copy-map) entry)))
  (dolist (entry files)
    (let* ((relative (getf entry :path)) (bytes (getf entry :bytes))
           (gz (string= "gz" (or (pathname-type relative) ""))))
      (assert (and (integerp bytes) (not (minusp bytes)) (hex64-p (getf entry :sha256))
                   (not (gethash relative indexed))
                   (not (member relative '("archive-index.lisp" "catalogo.lisp") :test #'string=))
                   (eql bytes (gethash relative actual))
                   (<= bytes (if gz 8388608 1048576))
                   (equalp entry (gethash relative copy-map))))
      (mapped-origin entry manifest)
      (setf (gethash relative indexed) t) (incf sum bytes)
      (if gz (progn (incf gzip-count) (setf max-gzip (max max-gzip bytes)))
          (progn (incf plain-count) (setf max-plain (max max-plain bytes))))))
  (maphash (lambda (relative bytes) (declare (ignore bytes))
             (assert (or (gethash relative indexed)
                         (member relative '("archive-index.lisp" "catalogo.lisp") :test #'string=)))) actual)
  (assert (= 3003 (length files) (hash-table-count copy-map) (getf preflight :planned-files)
             (getf closure :indexed-files)))
  (assert (= 3005 (hash-table-count actual) (getf preflight :estimated-archive-files)
             (getf closure :actual-files)))
  (assert (= 30037030 sum (getf preflight :indexed-bytes) (getf closure :indexed-bytes)))
  (assert (and (= 3000 plain-count (getf preflight :plain-count))
               (= 3 gzip-count (getf preflight :gzip-count))
               (= max-plain (getf preflight :max-plain-bytes))
               (= max-gzip (getf preflight :max-gzip-bytes))
               (eql 0 (getf preflight :file-budget-violation-count))))
  (assert (= 1008588 (arcdocdb.evidence:file-bytes index-path) (getf preflight :estimated-index-bytes)))
  (assert (= 318 (arcdocdb.evidence:file-bytes catalogue-path) (getf preflight :estimated-catalogue-bytes)))
  (assert (= 31045936 (+ sum (arcdocdb.evidence:file-bytes index-path)
                            (arcdocdb.evidence:file-bytes catalogue-path))
             (getf preflight :estimated-archive-total-bytes)
             (loop for bytes being the hash-values of actual sum bytes)))
  (assert (string= (getf closure :index-sha256) (sixth metadata-shas)))
  (assert (string= (getf closure :catalogue-sha256) (seventh metadata-shas)))
  (format t "INNER COMPLETE/OK workers4 sha-per-copy3 counts~S errors~S; closure exit0/signalNIL, closed inventory.~%"
          (getf observation :worker-copied-counts) (getf observation :worker-errors))
  (format t "COUNTS indexed3003 actual3005 indexed-bytes~D index-bytes1008588 catalogue-bytes318 actual-total31045936; exact preflight match.~%" sum)
  (format t "SIZES plain~D max~D gzip~D max~D, all actual indexed sizes match metadata; no budget violation.~%"
          plain-count max-plain gzip-count max-gzip)
  (assert (= 14 (length processes) (length (getf manifest :processes))
             (length (getf closure :processes)) (getf preflight :process-count)))
  (loop for process in processes for pair in (getf manifest :processes)
        for closed in (getf closure :processes)
        for original = (data (second pair))
        for archived = (data (merge-pathnames (getf process :record-path) root))
        do (schema original :command-verification)
           (assert (and (string= (first pair) (getf process :label))
                        (string= (format nil "processes/~A/~A" (first pair) (file-namestring (second pair)))
                                 (getf process :record-path))
                        (metadata-equal process closed) (equalp original archived)
                        (equalp (getf original :command) (getf process :command))
                        (eq (getf original :status) (getf process :status))
                        (eql (getf original :exit-code) (getf process :exit-code))
                        (eq :stable (getf process :source-consistency))))
           (ecase (getf process :status)
             (:ok (assert (eql 0 (getf process :exit-code))) (incf ok))
             (:failed (assert (and (string= "failed-check-2" (getf process :label))
                                   (eql 2 (getf process :exit-code))
                                   (search "396 file, 2811 link controllati, 4 rotti" (getf original :stdout))))
                      (incf failed)))
           (format t "PROCESS ~A <- ~A => ~S/exit~D/STABLE decoded-original=archive, closure metadata equal.~%"
                   (getf process :label) (second pair) (getf process :status) (getf process :exit-code)))
  (assert (and (= 13 ok) (= 1 failed)))
  (let* ((descriptor (plain-data (merge-pathnames "raw/coverage/coverage-state.lisp" root)))
         (payload (merge-pathnames (getf descriptor :payload) (merge-pathnames "raw/coverage/" root))))
    (schema descriptor :compressed-evidence)
    (assert (and (eq :gzip (getf descriptor :codec))
                 (= 2195898 (getf descriptor :uncompressed-bytes))
                 (string= "1fe31c9fd8fa60689f910672a5c53cdcbabbd73da6d71f87209afdc3007a68ec"
                          (getf descriptor :uncompressed-sha256))
                 (= 311888 (getf descriptor :compressed-bytes) (arcdocdb.evidence:file-bytes payload))
                 (string= (getf descriptor :compressed-sha256)
                          (getf (find "raw/coverage/coverage-state.lisp.gz" files
                                      :key (lambda (entry) (getf entry :path)) :test #'string=) :sha256))))
    (format t "COVERAGE descriptor only: expanded2195898/known SHA, gzip311888/SHA matches indexed declaration; no expansion or coverage rereading.~%"))
  (assert (equal metadata-sizes (mapcar #'arcdocdb.evidence:file-bytes metadata-paths)))
  (assert (equal metadata-shas (mapcar #'arcdocdb.evidence:file-sha256 metadata-paths)))
  (format t "METADATA sizes outer/manifest/preflight/observation/closure/index/catalogue ~S; local metadata SHA stable before/after.~%" metadata-sizes)
  (format t "CLOSURE limits ~S~%" (getf closure :limits))
  (format t "DATA only. Full archived SHA sweep was performed by recorded validator, not rerun here; original decoded14 compared, actual path/size inventory and all copied-result metadata independently checked. No result promotion, authenticity, atomic publication, MC/DC or scaling claim.~%"))
