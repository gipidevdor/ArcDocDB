(defun check (truth reason)
  (incf *checks*)
  (unless truth (error "Data check failed: ~S" reason)))
(defun data-tree (root)
  "Only cons graphs plus flat strings/numbers/keywords/T/NIL; no general vector traversal."
  (let ((states (make-hash-table :test #'eq)) (pending (list (cons root nil))) (budget 1000000))
    (loop while pending for entry = (pop pending) for value = (car entry)
          do (check (plusp (decf budget)) :data-budget)
             (cond ((consp value)
                    (cond ((cdr entry) (setf (gethash value states) :done))
                          ((eq :active (gethash value states)) (error "Cyclic cons graph"))
                          ((eq :done (gethash value states)) nil)
                          (t (setf (gethash value states) :active)
                             (push (cons value t) pending)
                             (push (cons (cdr value) nil) pending)
                             (push (cons (car value) nil) pending))))
                   (t (check (or (null value) (eq t value) (keywordp value)
                                 (stringp value) (numberp value)) :flat-data-type)))))
  root)
(defun plist (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test #'eq)))
    (check (and size (evenp size)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-plist-key)
             (setf (gethash key seen) t)))
  data)
(defun read-one (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym "EOF")))
    (with-input-from-string (input text)
      (let ((data (read input nil eof)))
        (check (not (eq data eof)) :nonempty-data)
        (check (eq eof (read input nil eof)) :unique-form-eof)
        (plist (data-tree data))))))
(defun close-number (actual expected)
  (check (and (realp actual) (<= (abs (- actual expected)) (* 1d-10 (max 1d0 (abs expected)))))
         :number-coherence))
(defun observation (spec)
  (destructuring-bind (name path bytes hash) spec
    (let ((actual-bytes (arcdocdb.evidence:file-bytes path))
          (actual-hash (arcdocdb.evidence:file-sha256 path)))
      (check (= bytes actual-bytes) :record-bytes)
      (check (equal hash actual-hash) :record-sha256)
      (list :name name :path path :bytes actual-bytes :sha256 actual-hash))))
(defun inventory (entries path-key hash-key)
  (let ((seen (make-hash-table :test #'equal)))
    (check (and (listp entries) (list-length entries)) :proper-inventory)
    (dolist (entry entries)
      (plist entry)
      (let ((path (getf entry path-key)) (hash (getf entry hash-key)))
        (check (and (stringp path) (stringp hash) (not (gethash path seen))) :inventory-entry)
        (setf (gethash path seen) hash)))
    seen))
(defun wrapper (data)
  (plist (data-tree data))
  (check (eql 1 (getf data :schema-version)) :wrapper-schema)
  (check (eq :command-verification (getf data :kind)) :wrapper-kind)
  (check (eq :ok (getf data :status)) :wrapper-status)
  (check (eql 0 (getf data :exit-code)) :wrapper-exit)
  (check (eq :stable (getf data :source-consistency)) :wrapper-stable)
  (check (equal (getf data :source-blobs-before) (getf data :source-blobs-after)) :wrapper-inventory-stable)
  (let ((table (inventory (getf data :source-blobs-before) :path :git-blob))
        (env (plist (getf data :environment))))
    (dolist (pin *source-pins*) (check (equal (second pin) (gethash (first pin) table)) :frozen-pin))
    (check (equal "6cd17853eebce88e2ee6f5342041a2a2d8da32ab" (getf env :commit)) :frozen-head)
    (check (equal "" (getf env :working-tree)) :clean-working-tree)
    (check (eq :uncontrolled (getf env :external-load-status)) :load-limit)
    (check (stringp (getf data :stdout)) :stdout-string)
    (check (stringp (getf data :stderr)) :stderr-string)
    (let ((start (getf data :started-at-universal-time)) (finish (getf data :finished-at-universal-time))
          (wall (getf data :wall-seconds)))
      (check (and (integerp start) (integerp finish) (<= start finish) (realp wall) (<= 0 wall)
                  (<= (- finish start 1) wall (+ (- finish start) 1))) :wrapper-time))
    (list :source-count (hash-table-count table) :wall-seconds (getf data :wall-seconds)
          :started-at (getf data :started-at-universal-time) :finished-at (getf data :finished-at-universal-time))))
(defun header (count)
  (cond ((< count 24) (list (+ 128 count)))
        ((< count 256) (list 152 count))
        (t (list 153 (floor count 256) (mod count 256)))))
(defun sink (iterations token)
  (logand 4611686018427387903 (+ (* iterations token) (floor (* iterations (1- iterations)) 2))))
(defun sample (data iterations warmup token timer heap-mode)
  (plist data)
  (check (eql iterations (getf data :iterations)) :iterations)
  (check (eql warmup (getf data :warmup-iterations)) :warmup)
  (let ((heap (getf data :heap-bytes)) (ticks (getf data :raw-ticks)) (seconds (getf data :seconds)))
    (check (and (integerp heap) (if (eq heap-mode :zero) (zerop heap) (>= heap (* 16 1048576)))) :heap)
    (check (and (integerp ticks) (<= 0 ticks)) :ticks)
    (close-number seconds (/ ticks (float timer 1d0)))
    (check (eql token (getf data :expected-return-token)) :return-token)
    (check (eql (sink iterations token) (getf data :sink)) :sink)
    (check (eql (sink iterations token) (getf data :expected-sink)) :expected-sink)
    (if (zerop ticks) (check (null (getf data :calls-per-second)) :zero-clock)
        (close-number (getf data :calls-per-second) (/ iterations seconds)))
    seconds))
(defun cell (data spec timer)
  (plist data)
  (destructuring-bind (name count payload ends token) spec
    (let* ((source (if (eq :zeros payload) (make-list count :initial-element 0) payload))
           (stops (if (eq :ascending ends) (loop for i from 1 to count collect i) ends))
           (wire (append (header count) source)) (next (+ 2 (length wire)))
           (full (append '(165 165) wire '(165 165 165 165)))
           (source-full (append '(165 165) source '(165 165 165 165)))
           (table-full (append stops '(2779096485 2779096485)))
           (sum 0d0) (samples (getf data :samples)))
      (check (eq name (getf data :name)) :fixture-order)
      (check (eql count (getf data :count)) :fixture-count)
      (check (equal source (getf data :source-literal)) :source-literal)
      (check (equal stops (getf data :item-ends-literal)) :ends-literal)
      (check (equal source-full (getf data :source-full-buffer)) :source-full-buffer)
      (check (equal table-full (getf data :item-ends-full)) :table-full-buffer)
      (check (eql 2 (getf data :source-start)) :source-start)
      (check (eql (+ 2 (length source)) (getf data :source-end)) :source-end)
      (check (equal wire (getf data :expected-bytes)) :wire)
      (check (equal full (getf data :expected-full-buffer)) :output-full-buffer)
      (check (eql (length wire) (getf data :unit-bytes)) :unit-size)
      (check (eql next (getf data :expected-next)) :next)
      (check (eql token (+ next (loop for value in full for i from 1 sum (* i value)))) :cold-token-arithmetic)
      (check (eql token (getf data :expected-token)) :cold-token)
      (check (equal (list next) (getf data :cold-values)) :cold-values)
      (check (eql 1 (getf data :cold-value-count)) :cold-arity)
      (check (eql 2 (getf data :start)) :destination-start)
      (check (eql (+ next 2) (getf data :end)) :destination-end)
      (dolist (key '(:private-preallocated-buffer :private-preallocated-workspace
                     :complete-output-checked-per-call :source-and-table-checked-per-call))
        (check (eq t (getf data key)) :per-call-check-metadata))
      (check (eql 5 (list-length samples)) :replicas)
      (dolist (entry samples) (incf sum (sample entry 1024 64 token timer :zero)))
      (list :name name :count count :unit-bytes (length wire) :next next :token token
            :sink (sink 1024 token) :samples 5 :sample-seconds sum))))
(defun benchmark (data wrapper-data)
  (plist data)
  (check (and (eql 1 (getf data :schema-version)) (eq :cbor-array-write-benchmark (getf data :kind))
              (eq :ok (getf data :status)) (eql 1 (getf data :workers)) (eql 3 (getf data :safety))) :benchmark-schema)
  (check (eql 1000000 (getf data :timer-units-per-second)) :timer)
  (check (equal "a4fa768d64d7088eb69455f27bb3e80c76d1f6df" (getf data :fixture-catalogue-blob)) :fixture-catalogue)
  (let ((env (getf wrapper-data :environment)) (when-recorded (getf data :recorded-at)))
    (dolist (pair '((:sbcl . :version) (:machine . :machine) (:os . :os) (:os-version . :os-version)))
      (check (equal (getf data (car pair)) (getf env (cdr pair))) :inner-environment))
    (check (and (integerp when-recorded)
                (<= (getf wrapper-data :started-at-universal-time) when-recorded
                    (getf wrapper-data :finished-at-universal-time))) :inner-date))
  (dolist (limit '(:success-path-only :serial :preallocated-private-buffers
                   :source-table-readonly :preallocated-private-workspace
                   :counter-not-absolute-nonallocation-proof :external-load-uncontrolled
                   :output-check-cost-included :no-pool-or-device-throughput
                   :no-scaling-or-latency-threshold))
    (check (member limit (getf data :limits)) :benchmark-limit))
  (check (eq :stable (getf data :source-consistency)) :inner-stable)
  (check (equal (getf data :source-fingerprints-before) (getf data :source-fingerprints-after)) :inner-inventory-stable)
  (let ((table (inventory (getf data :source-fingerprints-before) :file :md5)))
    (check (= 185 (hash-table-count table)) :inner-source-count)
    (dolist (pin '(("src/codec/cbor-array-input.lisp" "560fa1b10432d16edb830014e95ea4dc")
                   ("src/codec/cbor-array-write.lisp" "0429206ab6069f053c66da4c56439cfb")
                   ("spikes/out/cbor-array-write-20261013/drivers/bench.lisp" "c38a3e0e2f0b4af26e3d3822aeb1dbfd")
                   ("spikes/out/cbor-array-write-20261013/drivers/fixtures-and-mutations.lisp" "1bd3dde86b277aa6e7a05ae82d56662f")))
      (check (equal (second pin) (gethash (first pin) table)) :inner-pin)))
  (let* ((controls (plist (getf data :self-test))) (timer (getf data :timer-units-per-second))
         (baseline (getf controls :baseline)) (positive (getf controls :positive-control))
         (seconds (+ (sample baseline 1024 64 0 timer :zero) (sample positive 16 0 1048576 timer :positive)))
         (cells (getf data :campaigns)) (result nil) (total 0d0))
    (check (eq :ok (getf controls :status)) :controls-ok)
    (dolist (key '(:output-checker :arity-checker :sensor-checker :immutable-checker))
      (check (eq :ok (getf (plist (getf controls key)) :status)) :checker-ok))
    (dolist (spec '((:output-checker (:expected-token 17476 :altered-next-and-length-rejected 2
                                     :altered-prefix-header-payload-residual-tail-rejected 6
                                     :reason-specific-rejection t))
                    (:arity-checker (:single-value-accepted t :wrong-arity-or-next-rejected 4))
                    (:sensor-checker (:wrong-sink-rejected t :nonzero-heap-rejected t :reason-specific-rejection t))
                    (:immutable-checker (:source-change-rejected t :unused-table-cell-change-rejected t
                                         :reason-specific-rejection t))))
      (loop for (key expected) on (second spec) by #'cddr
            do (check (eql expected (getf (getf controls (first spec)) key)) :negative-sensor-data)))
    (check (eql 6 (list-length cells)) :fixture-cells)
    (loop for entry in cells for spec in *fixture-specs*
          do (let ((summary (cell entry spec timer)))
               (incf total (getf summary :sample-seconds)) (push summary result)))
    (check (<= (+ total seconds) (+ (getf wrapper-data :wall-seconds) (/ 32d0 timer))) :measured-time-within-wall)
    (list :cells (nreverse result) :samples 30 :sample-seconds total :self-control-seconds seconds
          :baseline-heap (getf baseline :heap-bytes) :positive-heap (getf positive :heap-bytes)
          :inner-fingerprint-count (length (getf data :source-fingerprints-before)))))

(let* ((before (mapcar #'observation *records*))
       (records (loop for spec in *records* collect
                  (let ((*package* (find-package :cl-user)))
                    (arcdocdb.evidence:read-evidence (second spec) :max-expanded-bytes 67108864))))
       (metadata (mapcar #'wrapper records))
       (freeze (first records)) (build (second records)) (bench-wrapper (third records))
       (audit-wrapper (fourth records)) (bench (read-one (getf bench-wrapper :stdout)))
       (audit (read-one (getf audit-wrapper :stdout)))
       (summary (benchmark bench bench-wrapper))
       (audit-result (plist (getf audit :result))) (observed (plist (getf audit-result :result))))
  (check (search "Snapshot: 21 sorgenti con tre confronti per copia." (getf freeze :stdout)) :freeze-21)
  (check (equal '("make" "build" "lint" "trace" "links") (getf build :command)) :initial-command)
  (check (equal '("spikes/out/cbor-array-write-20261013/drivers/bench.lisp" "--bench")
                (last (getf bench-wrapper :command) 2)) :benchmark-command)
  (check (equal (list "spikes/out/cbor-array-write-20261013/drivers/audit.lisp" "--bench"
                     (second (third *records*)) (second (first *source-pins*)) (second (second *source-pins*)))
                (last (getf audit-wrapper :command) 5)) :audit-command)
  (let* ((output (getf build :stdout))
         (array-lines (remove-if-not (lambda (line) (search "ok    TEST-REQ-CBR-005-ARRAY-" line))
                                    (uiop:split-string output :separator '(#\Newline)))))
    (check (eql 20 (length array-lines)) :twenty-array-tests)
    (check (eql 20 (length (remove-duplicates array-lines :test #'equal))) :unique-array-test-lines)
    (dolist (text '("20 test della composizione degli array CBOR superati."
                    "seed41525235, 1024 casi, 512 successi e 64 ciascuno capacita/byte/entry/nodi/profondita/parse/source-range/count."
                    "onda0, 2 worker riusati, 4096 composizioni, sink 52178944/75218944, overlap 3939 tick (1000000 tick/s)"
                    "onda1, 2 worker riusati, 4096 composizioni, sink 52178944/75218944, overlap 3151 tick (1000000 tick/s)"
                    "build e test: nessun avviso, tutti i controlli superati"))
      (check (search text output) :initial-build-evidence)))
  (check (and (eq :ok (getf audit :status)) (eq :cbor-array-write-bench-audit (getf audit :kind))
              (eql 67470 (getf audit :checks))) :recorded-audit)
  (check (equal (getf audit-result :wrapper-before) (getf audit-result :wrapper-after)) :audit-byte-stable)
  (let ((physical (plist (getf audit-result :wrapper-before))))
    (check (eql 219937 (getf physical :bytes)) :audit-observed-bytes)
    (check (equal (fourth (third *records*)) (getf physical :sha256)) :audit-observed-sha))
  (dolist (pair '((:cells . 6) (:samples . 30) (:heap-bytes . 0) (:cold-arity . 1)
                  (:sink-mask . 4611686018427387903) (:baseline-heap-bytes . 0)
                  (:positive-control-heap-bytes . 16777472) (:timer-units-per-second . 1000000)
                  (:source-fingerprint-count . 185)))
    (check (eql (cdr pair) (getf observed (car pair))) :audit-summary-count))
  (close-number (getf observed :sample-seconds) (getf summary :sample-seconds))
  (close-number (getf observed :self-control-seconds) (getf summary :self-control-seconds))
  (check (equal (second (first *source-pins*)) (getf audit :input-blob)) :audit-input-blob)
  (check (equal (second (second *source-pins*)) (getf audit :write-blob)) :audit-write-blob)
  (check (equal "84f3589f17132e47afcfe13647bec17c5390ab5b" (getf audit :driver-blob)) :audit-driver-blob)
  (check (equal "2f257c9e8a56a5182142934dada3f3b38b5bef65" (getf audit :method-blob)) :audit-method-blob)
  (check (eql (getf bench :recorded-at) (getf observed :recorded-at)) :audit-benchmark-date)
  (check (eql (getf bench-wrapper :started-at-universal-time) (getf audit-result :wrapper-started-at)) :audit-start)
  (check (eql (getf bench-wrapper :finished-at-universal-time) (getf audit-result :wrapper-finished-at)) :audit-finish)
  (let ((after (mapcar #'observation *records*)))
    (check (equal before after) :records-immutable)
    (let ((*print-readably* t))
      (write (list :status :ok :checks *checks* :observations before :observations-after after
                   :wrappers metadata :array-tests 20 :fuzz-cases 1024 :fuzz-successes 512
                   :fuzz-reject-classes 8 :fuzz-cases-per-reject-class 64 :worker-calls 8192
                   :worker-sinks '(52178944 75218944) :wave-overlap-ticks '(3939 3151)
                   :benchmark summary :recorded-audit-checks 67470
                   :limits '(:data-consistency-only :no-product-or-driver-loaded
                             :metadata-not-authenticity-or-execution-proof :cons-and-flat-data-only
                             :no-new-test-or-benchmark :no-heap-scope-extension :no-scaling-inference))
             :pretty t)
      (terpri))))
