;;;; DATA only: finished coverage self-test wrapper, no product/driver load or call.
;;;; CLI: RECORD HEAD BYTES SHA256.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:cbor-array-coverage-integration-data-reader (:use #:cl))
(in-package #:cbor-array-coverage-integration-data-reader)
(defvar *checks* 0)
(defun check (truth reason)
  (incf *checks*)
  (unless truth (error "Coverage integration data check failed: ~S" reason)))
(defun plist (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test #'eq)))
    (check (and size (evenp size)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-key)
             (setf (gethash key seen) t)))
  data)
(defun inventory (entries)
  (check (and (consp entries) (list-length entries)) :proper-inventory)
  (let ((seen (make-hash-table :test #'equal)))
    (dolist (entry entries)
      (plist entry)
      (let ((path (getf entry :path)) (hash (getf entry :git-blob)))
        (check (and (stringp path) (stringp hash) (= 40 (length hash)) (not (gethash path seen))) :unique-source)
        (setf (gethash path seen) hash)))
    seen))
(let ((args (uiop:command-line-arguments)))
  (check (= 4 (length args)) :cli-four)
  (destructuring-bind (path head bytes sha) args
    (let* ((before-bytes (arcdocdb.evidence:file-bytes path))
           (before-sha (arcdocdb.evidence:file-sha256 path))
           (data (plist (arcdocdb.evidence:read-evidence path)))
           (env (plist (getf data :environment)))
           (table (inventory (getf data :source-blobs-before)))
           (command (getf data :command)))
      (check (and (= (parse-integer bytes) before-bytes) (equal sha before-sha)) :explicit-physical-observation)
      (check (and (eql 1 (getf data :schema-version)) (eq :command-verification (getf data :kind))
                  (eq :ok (getf data :status)) (eql 0 (getf data :exit-code))
                  (eq :stable (getf data :source-consistency))) :completed-wrapper)
      (check (and (equal head (getf env :commit)) (equal "" (getf env :working-tree))) :commit-and-working-tree)
      (check (equal (getf data :source-blobs-before) (getf data :source-blobs-after)) :source-inventories-identical)
      (check (= 822 (hash-table-count table)) :source-count)
      (check (and (member "--self-test" command :test #'equal)
                  (find "foundation-coverage.lisp" command :test #'equal :key #'file-namestring)) :selftest-command)
      (check (equal (format nil "Copertura: self-test del ramo mancante superato.~%") (getf data :stdout)) :exact-selftest-stdout)
      (check (equal "" (getf data :stderr)) :empty-stderr)
      (check (and (= before-bytes (arcdocdb.evidence:file-bytes path))
                  (equal before-sha (arcdocdb.evidence:file-sha256 path))) :physical-input-unchanged)
      (let ((*print-readably* t))
        (write (list :status :ok :checks *checks* :record path :head head :wrapper-status (getf data :status)
                     :exit-code (getf data :exit-code) :source-consistency (getf data :source-consistency)
                     :source-count (hash-table-count table) :foundation-coverage-blob (gethash "tools/foundation-coverage.lisp" table)
                     :command command :wall-seconds (getf data :wall-seconds)
                     :stdout (getf data :stdout) :stderr (getf data :stderr)
                     :physical-observation (list :bytes before-bytes :sha256 before-sha)
                     :limits '(:data-only :metadata-coherence :no-authentication :no-product-or-driver-load
                               :no-new-coverage-campaign :no-coverage-or-mcdc-qualification-claim)) :pretty t)
        (terpri)))))
