;;;; Independent DATA reader. Loads only the trusted evidence storage reader.
;;;; CLI: repeated groups RECORD COMMIT NOMINAL BYTES SHA256 (all explicit).
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:cbor-array-integrated-data-reader (:use #:cl))
(in-package #:cbor-array-integrated-data-reader)
(defvar *checks* 0)
(defvar *observations* nil)
(defun check (truth reason)
  (incf *checks*)
  (unless truth (error "Integrated data check failed: ~S" reason)))
(defun data-tree (root)
  "Cons graph only; general vectors/objects are rejected, flat strings accepted."
  (let ((states (make-hash-table :test #'eq)) (pending (list (cons root nil))) (budget 3000000))
    (loop while pending for entry = (pop pending) for value = (car entry)
          do (check (plusp (decf budget)) :data-budget)
             (cond ((consp value)
                    (cond ((cdr entry) (setf (gethash value states) :done))
                          ((eq :active (gethash value states)) (error "Cyclic cons graph"))
                          ((eq :done (gethash value states)) nil)
                          (t (setf (gethash value states) :active)
                             (push (cons value t) pending)
                             (push (cons (cdr value) nil) pending)
                             (push (cons (car value) nil) pending))))
                   (t (check (or (null value) (eq t value) (keywordp value)
                                 (stringp value) (numberp value))
                             (list :flat-data-type (type-of value) (and (symbolp value) value)))))))
  root)
(defun plist (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test #'eq)))
    (check (and size (evenp size)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-plist-key)
             (setf (gethash key seen) t)))
  data)
(defun read-one (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym "EOF")))
    (with-input-from-string (input text)
      (let ((data (read input nil eof)))
        (check (not (eq data eof)) :nonempty-data)
        (check (eq eof (read input nil eof)) :one-form-eof)
        (plist (data-tree data))))))
(defun observe (path)
  (let ((entry (list :path (namestring (pathname path))
                     :bytes (arcdocdb.evidence:file-bytes path)
                     :sha256 (arcdocdb.evidence:file-sha256 path))))
    (unless (find (getf entry :path) *observations* :key (lambda (x) (getf x :path)) :test #'equal)
      (push entry *observations*))
    entry))
(defun evidence (path)
  (let ((physical (observe path)))
    (when (< (getf physical :bytes) 4096)
      (let ((descriptor (read-one (uiop:read-file-string path :external-format :utf-8))))
        (when (eq :compressed-evidence (getf descriptor :kind))
          (let ((payload (getf descriptor :payload)))
            (check (and (stringp payload) (not (find #\/ payload)) (not (find #\\ payload))) :payload-leaf)
            (observe (merge-pathnames payload (uiop:pathname-directory-pathname path)))))))
    (plist (data-tree (arcdocdb.evidence:read-evidence path)))))
(defun inventory (entries path-key hash-key)
  (let ((seen (make-hash-table :test #'equal)))
    (check (and (listp entries) (list-length entries)) :proper-inventory)
    (dolist (entry entries)
      (plist entry)
      (let ((path (getf entry path-key)) (hash (getf entry hash-key)))
        (check (and (stringp path) (stringp hash) (not (gethash path seen))) :unique-inventory)
        (setf (gethash path seen) hash)))
    seen))
(defun prefixp (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))
(defun lines (text)
  (loop for start = 0 then (1+ stop) for stop = (position #\Newline text :start start)
        collect (subseq text start stop) while stop))
(defun join-lines (items)
  (format nil "~{~A~%~}" items))
(defun section (items command next)
  (let ((begin (position command items :test #'equal)) (end (position next items :test #'equal)))
    (check (and begin end (< begin end) (= 1 (count command items :test #'equal))) :ordered-section)
    (subseq items (1+ begin) end)))
(defun source-stable (data before after path-key hash-key)
  (check (eq :stable (getf data :source-consistency)) :stable-source)
  (check (equal (getf data before) (getf data after)) :same-inventories)
  (inventory (getf data before) path-key hash-key))
(defun process-fixtures (path kind)
  (let* ((record (evidence path)) (entries (getf record :mutants)))
    (check (and (eql 1 (getf record :schema-version)) (eq kind (getf record :kind))
                (eq :passed (getf record :status)) (eql 2 (getf record :worker-errors))
                (null (getf record :baseline)) (= 2 (length entries))) :process-fixture-record)
    (loop for entry in entries for mode in '(:signal :completion-exit)
          for execution = (plist (getf (plist entry) :execution))
          do (check (and (eq mode (getf entry :name)) (eq :worker-error (getf entry :result))
                         (null (getf execution :timed-out))) :process-fixture-classification)
             (if (eq mode :signal) (check (eql 9 (getf execution :signal)) :signal-nine)
                 (check (and (null (getf execution :signal)) (eql 7 (getf execution :exit-code))) :completion-seven)))))
(defun mutation-selftest (items command next prefix kind process-kind targets)
  (let* ((body (section items command next)) (first (first body))
         (record (read-one (join-lines (rest body)))) (self (plist (getf record :self-test))))
    (check (prefixp prefix first) :fixture-path-prefix)
    (check (and (eql 1 (getf record :schema-version)) (eq kind (getf record :kind))
                (eq :ok (getf record :status)) (eql 0 (getf record :worker-errors))
                (null (getf record :baseline)) (null (getf record :mutants))) :mutation-selftest-record)
    (check (and (eq :ok (getf self :status)) (eql targets (getf self :unique-targets))
                (eq t (getf self :read-eval-disabled)) (eq t (getf self :only-named-runtime-detection))
                (= targets (length (getf record :targets)))) :mutation-selftest-controls)
    (let ((table (source-stable record :source-fingerprints-before :source-fingerprints-after :file :md5)))
      (process-fixtures (subseq first (length prefix)) process-kind)
      (list :kind kind :targets targets :sources (hash-table-count table) :process-fixtures 2))))
(defun case-selftest (items command next kind checks)
  (let* ((record (read-one (join-lines (section items command next)))) (cases (getf record :cases)))
    (check (and (eql 1 (getf record :schema-version)) (eq kind (getf record :kind))
                (eq :ok (getf record :status)) (eql checks (getf record :checks))) :evidence-selftest)
    (dolist (entry cases)
      (plist entry)
      (case kind
        (:evidence-storage-tests (check (eq :ok (getf entry :status)) :storage-case))
        (:evidence-publication-tests
         (check (and (eq :ok (getf entry :status)) (eql 1 (getf entry :observed-exit-code))) :expected-negative-publication))
        (:normalizer-compression-tests
         (check (and (eql 0 (getf entry :exit-code))
                     (eq :imported (getf (plist (getf entry :result)) :status))) :normalizer-case))))
    (list :kind kind :checks checks :cases (length cases))))
(defun spikes (path commit wrapper-table)
  (let* ((record (evidence path)) (env (plist (getf record :environment)))
         (runs (getf record :runs)) (artifacts (getf record :run-artifacts))
         (table (inventory (getf env :source-blobs) :path :git-blob)) (summaries nil))
    (check (and (eql 1 (getf record :schema-version)) (eq :complete (getf record :status))
                (equal "--check" (getf record :mode)) (= 10 (length runs)) (= 10 (length artifacts))
                (equal commit (getf env :commit)) (equal "" (getf env :working-tree))
                (= 62 (hash-table-count table))) :spike-aggregate)
    (maphash (lambda (key value) (check (equal value (gethash key wrapper-table)) :aggregate-source-pin)) table)
    (loop for run in runs for artifact in artifacts for n from 1
          for id = (format nil "SPK-~2,'0D" n)
          do (plist run)
             (check (equal (namestring (merge-pathnames (concatenate 'string id ".lisp")
                                                       (uiop:pathname-directory-pathname path))) artifact) :spike-artifact-path)
             (check (equal run (evidence artifact)) :aggregate-child-equality)
             (check (and (eql 1 (getf run :schema-version)) (equal id (getf run :id))
                         (eql 0 (getf run :exit-code)) (member "--check" (getf run :command) :test #'equal)) :spike-wrapper)
             (let* ((source-table (source-stable run :source-blobs-before :source-blobs-after :path :git-blob))
                    (parsed (read-one (getf run :stdout))) (result (plist (getf run :result)))
                    (payload (plist (or (getf result :benchmark) result))) (status (getf payload :status)))
               (check (and (equal parsed result) (eq status (getf run :status)) (member status '(:ok :pass))) :spike-result)
               (maphash (lambda (key value) (check (equal value (gethash key table)) :child-source-pin)) source-table)
               (push (list :id id :status status :sources (hash-table-count source-table)) summaries)))
    (list :aggregate path :source-count 62 :runs (nreverse summaries))))
(defun integrated (path commit nominal bytes sha)
  (let* ((physical (observe path)) (record (evidence path)) (env (plist (getf record :environment)))
         (items (lines (getf record :stdout)))
         (marker "build e test: nessun avviso, tutti i controlli superati")
         (stop (position marker items :test #'equal)) (functional (and stop (subseq items 0 stop)))
         (table (source-stable record :source-blobs-before :source-blobs-after :path :git-blob))
         (snapshot "sbcl --noinform --no-userinit --no-sysinit --script tools/snapshot-mutation.lisp --self-test")
         (reader "sbcl --noinform --no-userinit --no-sysinit --script tools/reader-mutation.lisp --self-test")
         (storage "sbcl --noinform --no-userinit --no-sysinit --script tools/check-evidence-storage.lisp")
         (publication "sbcl --noinform --no-userinit --no-sysinit --script tools/check-evidence-publication.lisp")
         (normalizer "sbcl --noinform --no-userinit --no-sysinit --script tools/check-evidence-normalize.lisp")
         (evidence-command "sbcl --dynamic-space-size 2048 --noinform --no-userinit --no-sysinit --script tools/check-evidence.lisp")
         (spike-command "sbcl --noinform --no-userinit --script tools/run-spikes.lisp --check"))
    (check (and (= bytes (getf physical :bytes)) (equal sha (getf physical :sha256))) :explicit-observation)
    (check (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
                (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
                (equal commit (getf env :commit)) (equal "" (getf env :working-tree))
                (equal '("check-core") (rest (getf record :command)))
                (equal "make" (file-namestring (first (getf record :command))))) :integrated-wrapper)
    (dolist (pin '(("src/codec/cbor-array-input.lisp" "d3b3d07fc18bd2a077c1a2d79020a76263b2779e")
                   ("src/codec/cbor-array-write.lisp" "a410297c29c5d043ad60d3804bd3711e22c2833b")))
      (check (equal (second pin) (gethash (first pin) table)) :array-pin))
    (check (and stop (= 1 (count marker items :test #'equal))) :build-completion)
    (check (= nominal (count-if (lambda (x) (prefixp "ok    TEST-" x)) functional)) :nominal-before-marker)
    (check (= (+ nominal 2) (count-if (lambda (x) (prefixp "ok    " x)) functional)) :nominal-plus-smoke)
    (dolist (smoke '("ok    package ARCDOCDB presente" "ok    ARCDOCDB:*VERSION* è una stringa"))
      (check (= 1 (count smoke functional :test #'equal)) :smoke))
    (let ((lint (section items "sbcl --script tools/lint.lisp --self-test" snapshot)))
      (check (equal lint '("ok    bad.lisp: COD-02 COD-03 COD-12 COD-20 COD-22 COD-34 COD-43 COD-50"
                          "ok    good.lisp: nessuna violazione"
                          "ok    keyword-barrier.lisp: nessuna violazione"
                          "ok    qualified-reader.lisp: COD-34")) :four-linter-selftests))
    (check (equal '("194 file, 0 violazioni")
                  (section items "sbcl --script tools/lint.lisp src" "sbcl --script tools/lint.lisp --self-test")) :lint)
    (check (equal '("119 requisiti, 65 invarianti, 13 scenari FI, 52 ADR: 0 errori")
                  (section items "sbcl --script tools/check-trace.lisp" "sbcl --script tools/check-links.lisp .")) :trace)
    (let ((link-lines (section items "sbcl --script tools/check-links.lisp ." storage)))
      (check (and (= 1 (length link-lines)) (search "link controllati, 0 rotti" (first link-lines))) :links))
    (dolist (needle '("WARNING:" "STYLE-WARNING:" "compilation aborted"))
      (check (not (search needle (getf record :stderr) :test #'char-equal)) :outer-compiler-warning))
    (let* ((mutations (list (mutation-selftest items snapshot reader "Snapshot: fixture processi conservate in "
                                              :snapshot-mutations :snapshot-process-self-test 10)
                            (mutation-selftest items reader "sbcl --script tools/check-trace.lisp" "Reader: fixture processi conservate in "
                                              :reader-mutations :reader-process-self-test 8)))
           (selftests (list (case-selftest items storage publication :evidence-storage-tests 123)
                           (case-selftest items publication normalizer :evidence-publication-tests 2)
                           (case-selftest items normalizer evidence-command :normalizer-compression-tests 6)))
           (evidence-data (read-one (join-lines (section items evidence-command spike-command))))
           (last-section (member spike-command items :test #'equal))
           (spike-line (second last-section)) (prefix "10 spike completati; risultati: "))
      (check (and (eq :ok (getf evidence-data :status))
                  (every (lambda (key) (let ((n (getf evidence-data key))) (and (integerp n) (plusp n))))
                         '(:catalogs :artifact-references :stored-files :stored-bytes))) :evidence-catalog)
      (check (and (prefixp prefix spike-line) (every (lambda (x) (equal "" x)) (cddr last-section))) :completed-spikes)
      (list :record path :commit commit :source-count (hash-table-count table) :wall-seconds (getf record :wall-seconds)
            :nominal-tests nominal :smoke 2 :linter-selftests 4 :lint "194/0" :trace "119/65/13/52/0"
            :links (first (section items "sbcl --script tools/check-links.lisp ." storage))
            :mutation-selftests mutations :evidence-selftests selftests :evidence-catalog evidence-data
            :spikes (spikes (merge-pathnames "report.lisp" (subseq spike-line (length prefix))) commit table)))))
(let ((args (uiop:command-line-arguments)) (results nil))
  (check (and args (zerop (mod (length args) 5))) :cli-five-tuples)
  (loop for (path commit nominal bytes sha) on args by (lambda (x) (nthcdr 5 x))
        do (push (integrated path commit (parse-integer nominal) (parse-integer bytes) sha) results))
  (dolist (before *observations*)
    (check (and (= (getf before :bytes) (arcdocdb.evidence:file-bytes (getf before :path)))
                (equal (getf before :sha256) (arcdocdb.evidence:file-sha256 (getf before :path)))) :physical-input-unchanged))
  (let ((*print-readably* t))
    (write (list :status :ok :checks *checks* :results (nreverse results) :physical-observations (reverse *observations*)
                 :limits '(:data-only :metadata-coherence :no-authentication :no-new-campaign :no-product-load
                           :flat-atoms-and-acyclic-cons-graphs :strict-success-records :explicit-nominal-count)) :pretty t)
    (terpri)))
