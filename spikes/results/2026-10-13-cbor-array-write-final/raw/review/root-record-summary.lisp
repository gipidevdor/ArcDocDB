;;;; Read-only coordinator summary of completed command evidence.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((path (second sb-ext:*posix-argv*)))
  (let ((data (arcdocdb.evidence:read-evidence path)))
    (write (list :path path :status (getf data :status)
                 :exit-code (getf data :exit-code)
                 :commit (getf (getf data :environment) :commit)
                 :source-consistency (getf data :source-consistency)
                 :source-count (length (getf data :source-blobs-before))
                 :bytes (arcdocdb.evidence:file-bytes path)
                 :sha256 (arcdocdb.evidence:file-sha256 path)))
    (terpri)
    (when (getf data :finished-at-universal-time)
      (let ((lines (uiop:split-string (or (getf data :stdout) "") :separator '(#\Newline))))
        (format t "Nominal rows: ~D~%"
                (count-if (lambda (line) (uiop:string-prefix-p "ok    TEST-" line)) lines)))
      (dolist (line (uiop:split-string (or (getf data :stdout) "") :separator '(#\Newline)))
        (when (or (search "test nominali" line) (search "Test nominali" line)
                  (search "violazioni" line) (search "REQ" line)
                  (search "collegamenti" line) (search " :STORED-FILES" line)
                  (search "check-" line) (search "snapshot-self-test-" line)
                  (search "reader-self-test-" line))
          (write-line line)))
      (unless (eql 0 (getf data :exit-code))
        (write-line (or (getf data :stderr) ""))))))
