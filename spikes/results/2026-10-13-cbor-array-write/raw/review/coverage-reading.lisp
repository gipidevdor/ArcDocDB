;;;; C4: lettura dei dati SB-COVER 2.6.9; nessun prodotto o dato caricato.
(load "tools/evidence-storage.lisp")
(defpackage #:array.coverage.reading (:use #:cl))
(in-package #:array.coverage.reading)
(unless (find-package "ARCDOCDB.CBOR") (make-package "ARCDOCDB.CBOR" :use '("CL")))
(unless (find-package "ARCDOCDB.CONDITIONS") (make-package "ARCDOCDB.CONDITIONS" :use '("CL")))
(export (intern "RESOURCE-EXHAUSTED" "ARCDOCDB.CONDITIONS") "ARCDOCDB.CONDITIONS")

(defun read-one-data (path)
  (arcdocdb.evidence:call-with-evidence-bytes
   path (lambda (plain)
          (assert (<= (arcdocdb.evidence:file-bytes plain) 134217728))
          (let ((*read-eval* nil) (*readtable* (copy-readtable nil))
                (*read-base* 10) (*read-suppress* nil) (eof (gensym)))
            (with-open-file (stream plain :external-format :utf-8)
              (let ((form (read stream nil eof)))
                (assert (not (eq form eof)))
                (assert (eq eof (read stream nil eof))) form))))))

(defun read-source-forms (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil))
        (*package* (find-package "ARCDOCDB.CBOR")) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (coerce (loop for form = (read stream nil eof)
                    until (eq form eof) collect form) 'vector))))

(defun path-form (path forms)
  (let* ((numeric (if (keywordp (car path)) (cdr path) path))
         (indices (reverse numeric)) (form (aref forms (first indices))))
    (dolist (index (rest indices) form)
      (assert (and (integerp index) (not (minusp index))))
      (setf form (nth index form)))))

(defun summary (entry)
  (let ((paths (cadr entry)) (bits (cddr entry)) (ec 0) (et 0) (bc 0) (bt 0)
        (sites (make-hash-table :test 'equal)))
    (assert (and (stringp (car entry)) (typep paths 'simple-vector)
                 (typep bits 'simple-bit-vector) (= (length paths) (length bits))))
    (dotimes (index (length paths))
      (let ((path (aref paths index)) (bit (sbit bits index)))
        (if (member (car path) '(:then :else))
            (progn (incf bt) (incf bc bit)
                   (push (car path) (gethash (cdr path) sites)))
            (progn (incf et) (incf ec bit)))))
    (maphash (lambda (path ways) (declare (ignore path))
               (assert (and (= 2 (length ways)) (member :then ways) (member :else ways)))) sites)
    (values ec et bc bt)))

(let* ((wrapper "spikes/out/4000913934-command-88141-0/report.lisp")
       (state "spikes/out/cbor-array-write-20261013/coverage/coverage-state.lisp")
       (record (arcdocdb.evidence:read-evidence wrapper))
       (raw (read-one-data state))
       (root (namestring (truename "./")))
       (sources '("src/codec/cbor-array-input.lisp" "src/codec/cbor-array-write.lisp"))
       (wanted-hashes '("d3b3d07fc18bd2a077c1a2d79020a76263b2779e"
                        "a410297c29c5d043ad60d3804bd3711e22c2833b"))
       (ec 0) (et 0) (bc 0) (bt 0) (gec 0) (getotal 0) (gbc 0) (gbt 0)
       (*print-pretty* nil) (*print-level* nil) (*print-length* nil)
       (*package* (find-package "ARCDOCDB.CBOR")))
  (assert (and (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
               (eq :stable (getf record :source-consistency))
               (equalp (getf record :source-blobs-before) (getf record :source-blobs-after))))
  (format t "wrapper schema~D kind~S status~S exit~D stable~S wall~S sources~D stderr-chars~D HEAD~A~%"
          (getf record :schema-version) (getf record :kind) (getf record :status)
          (getf record :exit-code) (getf record :source-consistency) (getf record :wall-seconds)
          (length (getf record :source-blobs-before)) (length (getf record :stderr))
          (getf (getf record :environment) :commit))
  (let ((ok-lines (with-input-from-string (stream (getf record :stdout))
                    (loop for line = (read-line stream nil) while line
                          when (and (>= (length line) 6) (string= "ok    " line :end2 6)) collect line))))
    (assert (= 20 (length ok-lines) (length (remove-duplicates ok-lines :test #'string=))))
    (format t "wrapper 20 unique OK; stdout~%~A~%" (getf record :stdout)))
  (dolist (entry raw)
    (multiple-value-bind (a b c d) (summary entry)
      (incf gec a) (incf getotal b) (incf gbc c) (incf gbt d)))
  (format t "GLOBAL RAW: ~D loaded file entries, expression ~D/~D, branch ~D/~D; not selected scope.~%"
          (length raw) gec getotal gbc gbt)
  (loop for source in sources for expected-hash in wanted-hashes
        for absolute = (concatenate 'string root source)
        for entries = (remove absolute raw :key #'car :test-not #'string=)
        do (assert (= 1 (length entries)))
           (let* ((entry (first entries)) (paths (cadr entry)) (bits (cddr entry))
                  (forms (read-source-forms source))
                  (before (find source (getf record :source-blobs-before)
                                :key (lambda (row) (getf row :path)) :test #'string=)))
             (assert (string= expected-hash (getf before :git-blob)))
             (multiple-value-bind (a b c d) (summary entry)
               (incf ec a) (incf et b) (incf bc c) (incf bt d)
               (format t "SELECTED ~A expression ~D/~D (~,6F percent), branch ~D/~D (~,6F percent), raw-records~D.~%"
                       source a b (* 100d0 (/ a b)) c d (* 100d0 (/ c d)) (length paths)))
             (dotimes (index (length paths))
               (when (zerop (sbit bits index))
                 (let ((path (aref paths index)))
                   (format t "UNCOVERED ~A record~D ~S path~S form~S~%" source index
                           (if (keywordp (car path)) :branch :expression)
                           path (path-form path forms)))))))
  (format t "SELECTED TOTAL expression ~D/~D (~,6F percent), branch ~D/~D (~,6F percent); no exclusions.~%"
          ec et (* 100d0 (/ ec et)) bc bt (* 100d0 (/ bc bt)))
  (format t "No source or data form evaluated; no product LOAD/compile/call; no campaign rerun. Raw interpretation specific to SBCL2.6.9; no MC/DC/C1 qualification.~%"))
