;;;; C4: cold reading of frozen mutation evidence; no product/driver evaluation.
(load "tools/evidence-storage.lisp")
(require :sb-md5)
(require :sb-posix)
(defpackage #:array.mutation.reading (:use #:cl))
(in-package #:array.mutation.reading)
(dolist (name '("ARCDOCDB.CBOR" "ARCDOCDB.CBOR.MINIMAL.SCAN.TESTS"
                "ARCDOCDB.CBOR.STRUCTURE.TESTS" "ARCDOCDB.CBOR.ARRAY.WRITE.TESTS"))
  (unless (find-package name) (make-package name :use '("CL"))))
(dolist (name '("CREA-SPAZIO-CBOR" "SCRIVI-ARRAY-CBOR-MINIMO"
                "VERIFICA-STRUTTURA-CBOR-MINIMA"))
  (export (intern name "ARCDOCDB.CBOR") "ARCDOCDB.CBOR"))

(defun text (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((result (make-string (file-length stream))))
      (subseq result 0 (read-sequence result stream)))))
(defun md5 (path)
  (format nil "~(~{~2,'0X~}~)" (coerce (sb-md5:md5sum-file path) 'list)))
(defun blob (path)
  (let ((output (make-string-output-stream)))
    (let ((process (sb-ext:run-program "/usr/bin/git" (list "hash-object" (namestring (pathname path)))
                                       :output output :error :stream :wait t)))
      (assert (zerop (sb-ext:process-exit-code process)))
      (unwind-protect (string-right-trim '(#\Newline #\Return) (get-output-stream-string output))
        (sb-ext:process-close process)))))
(defun lines (string)
  (with-input-from-string (stream string)
    (loop for line = (read-line stream nil) while line
          collect (string-right-trim '(#\Return) line))))
(defun prefixp (prefix string)
  (and (<= (length prefix) (length string)) (string= prefix string :end2 (length prefix))))
(defun data-from-string (string)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-input-from-string (stream string)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof))) (assert (eq eof (read stream nil eof))) form))))
(defun nominal-functions (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package "ARCDOCDB.CBOR.ARRAY.WRITE.TESTS"))
        (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (loop for form = (read stream nil eof) until (eq form eof)
            when (and (consp form) (symbolp (car form))
                      (string= "DEFTEST" (symbol-name (car form))))
              collect (concatenate 'string "ARCDOCDB.CBOR.ARRAY.WRITE.TESTS::"
                                   (symbol-name (second form)))))))
(defun whitespacep (character)
  (member character '(#\Space #\Tab #\Newline #\Return)))
(defun framep (line)
  (let ((colon (position #\: line)))
    (and colon (plusp colon) (every #'digit-char-p (subseq line 0 colon))
         (<= (+ colon 3) (length line))
         (string= ": (" line :start2 colon :end2 (+ colon 3)))))
(defun exact-nominal-frame (body whitelist)
  (when (framep body)
    (let* ((begin (+ 3 (position #\: body)))
           (end (position-if (lambda (ch) (or (whitespacep ch) (char= ch #\)))) body :start begin))
           (close (and end (position-if-not #'whitespacep body :start end))))
      (when (and close (char= #\) (char body close))
                 (every #'whitespacep (subseq body (1+ close)))
                 (member (subseq body begin end) whitelist :test #'string=))
        (subseq body begin end)))))
(defun backtrace-frame (all-lines unhandled whitelist)
  ;; Numeric frame boundaries are recognized only outside quoted strings.
  (let ((group nil) (group-line nil) (quoted nil) (escaped nil))
    (labels ((finish ()
               (when group
                 (let ((name (exact-nominal-frame
                              (format nil "~{~A~%~}" (reverse group)) whitelist)))
                   (when name (return-from backtrace-frame (values name group-line)))))))
      (loop for line in (nthcdr unhandled all-lines) for index from unhandled
            do (when (and (not quoted) (framep line))
                 (finish) (setf group nil group-line index escaped nil))
               (when (or group (framep line))
                 (push line group)
                 (loop for ch across line
                       do (cond (escaped (setf escaped nil))
                                ((and quoted (char= ch #\\)) (setf escaped t))
                                ((char= ch #\") (setf quoted (not quoted)))))))
      (finish)) nil))
(defun forbidden-diagnostic-p (string)
  (some (lambda (token) (search token string :test #'char-equal))
        '("compilation aborted" "COMPILE-FILE-ERROR" "COMPILE-FILE-WARNED"
          "WARNING:" "STYLE-WARNING:")))
(defun check-log (row whitelist baselinep)
  (let* ((string (text (getf row :log))) (all (lines string))
         (smoke (position "ok    ARCDOCDB:*VERSION* è una stringa" all :test #'string=))
         (completion (position "build e test: nessun avviso, tutti i controlli superati"
                               all :test #'string=))
         (unhandled (position-if (lambda (line) (prefixp "Unhandled " line)) all))
         (exit (getf row :exit-code)))
    (assert (null (getf row :signal))) (assert (null (getf row :diagnostic)))
    (assert (not (forbidden-diagnostic-p string))) (assert (integerp exit))
    (assert smoke)
    (if baselinep
        (let* ((ok (remove-if-not (lambda (line) (prefixp "ok    TEST-REQ-CBR-005-" line)) all))
               (actual (mapcar (lambda (line)
                                 (concatenate 'string "ARCDOCDB.CBOR.ARRAY.WRITE.TESTS::"
                                              (subseq line 6))) ok)))
          (assert (and (zerop exit) completion (< smoke completion) (not unhandled)))
          (assert (and (= 20 (length actual) (length (remove-duplicates actual :test #'string=)))
                       (null (set-exclusive-or actual whitelist :test #'string=))))
          (format t "BASELINE independently OK: smoke-line~D completion-line~D nominal20 unique; total-OK~D.~%"
                  (1+ smoke) (1+ completion)
                  (count-if (lambda (line) (prefixp "ok    " line)) all)))
        (multiple-value-bind (name frame-line) (and unhandled (backtrace-frame all unhandled whitelist))
          (assert (and (not (zerop exit)) (not completion) unhandled (< smoke unhandled) name))
          (assert (and (getf row :detected) (eq :detected (getf row :result))))
          (format t "DETECTED ~A: exit~D smoke-line~D Unhandled-line~D nominal-frame-line~D ~A~%"
                  (getf row :name) exit (1+ smoke) (1+ unhandled) (1+ frame-line) name)
          (format t "  origin ~{~A~^ ~}~%"
                  (subseq all (+ unhandled 2) (position "" all :start (+ unhandled 2) :test #'string=)))))
    (values (arcdocdb.evidence:file-sha256 (getf row :log)) (length all))))
(defun unique-replacement (original before after)
  (let ((position (search before original)))
    (assert position) (assert (null (search before original :start2 (1+ position))))
    (concatenate 'string (subseq original 0 position) after
                 (subseq original (+ position (length before))))))
(defun inode (path)
  (let ((stat (sb-posix:stat path))) (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat))))

(let* ((outer-path "spikes/out/4000913980-command-89061-0/report.lisp")
       (inner-path "spikes/out/cbor-array-write-20261013/mutations/report.lisp")
       (catalogue-path "spikes/out/cbor-array-write-20261013/drivers/catalogue-materialized.lisp")
       (outer (arcdocdb.evidence:read-evidence outer-path))
       (inner (arcdocdb.evidence:read-evidence inner-path))
       (catalogue (arcdocdb.evidence:read-evidence catalogue-path))
       (raw-paths (append (list outer-path inner-path catalogue-path (getf (getf inner :baseline) :log))
                          (mapcar (lambda (row) (getf row :log)) (getf inner :mutants))))
       (raw-pins (mapcar #'arcdocdb.evidence:file-sha256 raw-paths))
       (fingerprints (getf inner :source-fingerprints-before))
       (current-pins (mapcar (lambda (row) (list (getf row :file) (md5 (getf row :file)))) fingerprints))
       (copied (remove-if (lambda (row) (prefixp "spikes/out/" (getf row :file))) fingerprints))
       (targets (getf inner :targets)) (mutants (getf inner :mutants))
       (whitelist (append (nominal-functions "tests/codec/cbor-array-write.lisp")
                          (nominal-functions "tests/codec/cbor-array-write-threads.lisp")))
       (root (namestring (truename "spikes/out/cbor-array-write-20261013/mutations/")))
       (copies (mapcar (lambda (name) (concatenate 'string root name "/"))
                      '("baseline" "0" "1" "2" "3" "4" "5" "6" "7"))))
  (assert (and (eq :ok (getf outer :status)) (eql 0 (getf outer :exit-code))
               (eq :stable (getf outer :source-consistency))
               (equalp (getf outer :source-blobs-before) (getf outer :source-blobs-after))
               (zerop (length (getf outer :stderr)))))
  (assert (and (eql 1 (getf inner :schema-version)) (eq :cbor-array-write-mutations (getf inner :kind))
               (eq :ok (getf inner :status)) (eql 0 (getf inner :worker-errors))
               (eq :stable (getf inner :source-consistency))
               (equalp fingerprints (getf inner :source-fingerprints-after))
               (= 313 (length fingerprints)) (= 308 (length copied))
               (= 313 (length (remove-duplicates fingerprints :key (lambda (row) (getf row :file))
                                                 :test #'string=)))))
  (let* ((stdout (getf outer :stdout)) (begin (search "(:SOURCE-CONSISTENCY" stdout)))
    (assert begin) (assert (equalp inner (data-from-string (subseq stdout begin))))
    (assert (search "self-test worker superato" (subseq stdout 0 begin))))
  (format t "OUTER schema~D kind~S status~S exit~D stable~S wall~S source-blobs~D HEAD~A stderr0; embedded inner equal.~%"
          (getf outer :schema-version) (getf outer :kind) (getf outer :status) (getf outer :exit-code)
          (getf outer :source-consistency) (getf outer :wall-seconds)
          (length (getf outer :source-blobs-before)) (getf (getf outer :environment) :commit))
  (loop for row in fingerprints for current in current-pins
        unless (string= (getf row :md5) (second current))
          do (format t "POST-CAMPAIGN CURRENT DIFFERENCE ~A snapshot~A current~A; not used as frozen copy origin.~%"
                     (getf row :file) (getf row :md5) (second current)))
  (dolist (row (set-difference fingerprints copied))
    (assert (string= (getf row :md5) (md5 (getf row :file)))))
  (assert (equalp (getf inner :catalogue-source-files) (getf catalogue :source-blobs)))
  (assert (equalp (getf inner :catalogue-corpus-files) (getf catalogue :corpus-blobs)))
  (assert (string= (getf inner :catalogue-data-blob) (blob catalogue-path)))
  (assert (string= (getf catalogue :semantic-catalogue-blob) (getf inner :semantic-catalogue-blob)))
  (assert (string= "2f257c9e8a56a5182142934dada3f3b38b5bef65" (getf catalogue :method-blob)))
  (assert (string= (getf catalogue :method-blob) (blob "docs/implementazione/cbor-array-metodo.md")))
  (dolist (pair (append (getf catalogue :source-blobs) (getf catalogue :corpus-blobs)))
    (assert (string= (second pair) (blob (first pair)))))
  (dolist (pair (getf inner :catalogue-raw-fingerprints))
    (assert (string= (second pair) (md5 (first pair)))))
  (assert (and (= 20 (length whitelist) (length (remove-duplicates whitelist :test #'string=)))
               (equal whitelist (getf inner :corpus-frame-functions))
               (equal whitelist (getf catalogue :corpus-frame-function-whitelist))
               (= 8 (length targets) (length mutants) (length (getf catalogue :targets)))))
  (loop for target in targets for declared in (getf catalogue :targets) for mutant in mutants
        do (assert (and (string= (getf target :name) (getf declared :name))
                        (string= (getf target :name) (getf mutant :name))
                        (string= (getf target :source-file) (getf declared :path))
                        (string= (getf target :source-file) (getf mutant :source-file))
                        (string= (getf target :before) (getf declared :before))
                        (string= (getf target :after) (getf declared :after))
                        (eql 1 (getf declared :static-occurrences)))))
  (format t "INNER before/after stable313; copied308 + ignored5; ignored current5 MD5 and frozen method/source2/corpus3/catalogue targets8 coherent; nominal DEFTEST20 exact.~%")
  (check-log (getf inner :baseline) whitelist t)
  (dolist (mutant mutants) (check-log mutant whitelist nil))
  (assert (= 9 (length (remove-duplicates (mapcar #'truename copies) :test #'equal))))
  (dolist (row copied)
    (let* ((relative (getf row :file)) (baseline-path (merge-pathnames relative (first copies)))
           (original (text baseline-path))
           (outer-pin (find relative (getf outer :source-blobs-before)
                            :key (lambda (pin) (getf pin :path)) :test #'string=))
           (inodes (list (inode relative))))
      (assert outer-pin)
      (assert (string= (getf row :md5) (md5 baseline-path)))
      (assert (string= (getf outer-pin :git-blob) (blob baseline-path)))
      (loop for copy in copies for index from -1
            for path = (merge-pathnames relative copy)
            for target = (and (not (minusp index)) (nth index targets))
            for changed = (and target (string= relative (getf target :source-file)))
            do (push (inode path) inodes)
               (assert (prefixp copy (namestring (truename path))))
               (if changed
                   (let ((expected (unique-replacement original (getf target :before) (getf target :after))))
                     (assert (string= expected (text path)))
                     (assert (not (string= original expected)))
                     (format t "COPY ~D ~A exact unique replacement; target blob~A MD5~A.~%"
                             index (getf target :name) (blob path) (md5 path)))
                   (assert (string= (getf row :md5) (md5 path)))))
      (assert (= 10 (length (remove-duplicates inodes :test #'equal))))))
  (dolist (copy copies)
    (let ((runner (text (merge-pathnames "tools/cbor-array-write-isolated-build.lisp" copy))))
      (assert (equal (truename (concatenate 'string copy "fasl/"))
                     (pathname (concatenate 'string copy "fasl/"))))
      (assert (string= runner
                       (format nil ";;;; Runner della copia isolata; avvia la build rigorosa originale.~%(REQUIRE :ASDF)~%(ASDF/OUTPUT-TRANSLATIONS:INITIALIZE-OUTPUT-TRANSLATIONS~% '(:OUTPUT-TRANSLATIONS~%   (~S~%    ~S)~%   :IGNORE-INHERITED-CONFIGURATION))~%(LOAD ~S)~%"
                               copy (concatenate 'string copy "fasl/") "tools/build.lisp")))))
  (format t "COPIES nine distinct roots/local-FASL; all308 original paths checked in each: baseline308 unchanged; mutants307 unchanged+one exact target; per-path ten physical inodes distinct; runners exact frozen build invocation.~%")
  (assert (equal current-pins
                 (mapcar (lambda (row) (list (getf row :file) (md5 (getf row :file)))) fingerprints)))
  (assert (equal raw-pins (mapcar #'arcdocdb.evidence:file-sha256 raw-paths)))
  (format t "FINAL current313 stable during reading (post-campaign differences reported); raw outer/inner/materialization and all9 logs stable. Baseline308 matches frozen inner MD5 + outer Git blobs. DETECTED8/SURVIVED0/INVALID0/WORKER-ERROR0 verified on logs.~%")
  (format t "DATA only: trusted evidence reader and SBCL MD5/POSIX modules; READ-EVAL NIL/standard readtable/EOF for Lisp data; no product or driver LOAD/EVAL/compile/call, no campaign rerun. Hashes establish byte coherence, not authenticity/causality/C1 or release qualification.~%"))
