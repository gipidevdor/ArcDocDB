;;;; Helper C4 di conservazione: nessun caricamento dei registri come codice.
(require :asdf)
(load "tools/evidence-storage.lisp")
(declaim (optimize (safety 3) (debug 3)))
(let* ((root (truename "./"))
       (base (merge-pathnames "spikes/out/cbor-float-write-20261013/" root))
       (frozen (merge-pathnames "final-frozen/" base))
       (documents '("cbor-float-scrittura.md" "cbor-float-scrittura-risultati.md"
                    "cbor-float-scrittura-dati.md" "cbor-float-scrittura-copertura.md"))
       (processes '(("original-collection" "spikes/out/4000906916-command-50498-0/report.lisp")
                    ("integrated-check-core" "spikes/out/4000908032-command-75888-0/report.lisp")
                    ("integrated-check-wrapper" "spikes/out/4000908030-command-75831-0/report.lisp")
                    ("pool-integrated-check" "spikes/out/4000908322-command-83574-0/report.lisp")))
       (spikes (car (sort (directory (merge-pathnames "spikes/out/*-check-*/" root))
                          #'string> :key #'namestring)))
       (self-trees (loop for pattern in '("spikes/out/*-snapshot-self-test-*/"
                                         "spikes/out/*-reader-self-test-*/")
                         for latest = (car (sort (directory (merge-pathnames pattern root))
                                                 #'string> :key #'namestring))
                         unless latest do (error "Albero self-test finale assente: ~A" pattern)
                         collect (list (car (last (pathname-directory latest)))
                                       (namestring latest) :lisp-and-log)))
       (files nil))
  (unless spikes (error "Albero spike finale assente"))
  (dolist (process processes)
    (let ((data (arcdocdb.evidence:read-evidence (merge-pathnames (second process) root))))
      (unless (and (eq :ok (getf data :status)) (eql 0 (getf data :exit-code))
                   (eq :stable (getf data :source-consistency))
                   (equal (getf data :source-blobs-before) (getf data :source-blobs-after)))
        (error "Registro finale non OK/0/STABLE: ~A" (first process)))))
  (ensure-directories-exist (merge-pathnames "placeholder" frozen))
  (dolist (document documents)
    (let* ((source (merge-pathnames (concatenate 'string "docs/implementazione/" document) root))
           (target (merge-pathnames (concatenate 'string document ".txt") frozen))
           (before (arcdocdb.evidence:file-sha256 source)))
      (when (probe-file target) (error "Snapshot gia presente: ~A" target))
      (uiop:copy-file source target)
      (unless (and (equal before (arcdocdb.evidence:file-sha256 target))
                   (equal before (arcdocdb.evidence:file-sha256 source)))
        (error "Snapshot documento alterato: ~A" source))
      (push (list (concatenate 'string "final-documents/" document ".txt")
                  (namestring target)) files)))
  (dolist (item '(("original-collection-observation.lisp" "parallel-collection/collection-observation-4000906918-50528-0.lisp")
                  ("original-closed-check.log" "parallel-collection/closed-check-4000907333-50528-0.log")
                  ("collection-review-final.md.txt" "collection-review-final.md")
                  ("integration-review-final.md.txt" "integration-review-final.md")
                  ("pool-integration-review-final.md.txt" "pool-integration-review-final.md")
                  ("root-count-reading-note.md.txt" "root-count-reading-note.md")
                  ("build-final-manifest.lisp" "build-final-manifest.lisp")
                  ("append-source.lisp" "append-source.lisp")))
    (push (list (first item) (namestring (truename (merge-pathnames (second item) base)))) files))
  (let ((path (merge-pathnames "final-manifest.lisp" base)))
    (with-open-file (stream path :direction :output :if-exists :error :external-format :utf-8)
      (let ((*print-readably* t))
        (write (list :schema-version 1 :processes processes
                     :trees (cons (list "integrated-spikes" (namestring spikes) :lisp-and-log)
                                  self-trees)
                     :files (nreverse files)) :stream stream :pretty t)
        (terpri stream)))
    (format t "Manifest finale: ~A; spike: ~A~%" path spikes)))
