(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((root (truename "spikes/out/cbor-float-write-20261013/"))
       (processes nil) (trees nil) (files nil) (number 0))
  (dolist (path (sort (directory "spikes/out/*-command-*/report.lisp") #'string< :key #'namestring))
    (let ((record (arcdocdb.evidence:read-evidence path)))
      (unless (and (eq :command-verification (getf record :kind))
                   (member (getf record :status) '(:ok :failed))
                   (eq :stable (getf record :source-consistency)))
        (error "Registro non concluso e stabile: ~A" path))
      (push (list (format nil "process-~2,'0D" (incf number)) (namestring path)) processes)))
  (dolist (spec '(("frozen" "frozen/" :all)
                  ("mutations" "mutations/" :lisp-and-log)
                  ("coverage" "coverage/" :all)
                  ("coverage-self-test" "coverage-self-test/" :lisp-and-log)
                  ("precompile-quotient-guard" "precompile-quotient-guard/" :all)
                  ("parallel-collection" "parallel-collection/" :all)))
    (destructuring-bind (label sub mode) spec
      (push (list label (namestring (truename (merge-pathnames sub root))) mode) trees)))
  (dolist (dir (uiop:subdirectories "spikes/out/"))
    (when (or (search "cbor-float-write-worker-self-test" (namestring dir))
              (search "-snapshot-self-test-" (namestring dir))
              (search "-reader-self-test-" (namestring dir))
              (search "-check-" (namestring dir)))
      (push (list (car (last (pathname-directory dir))) (namestring dir) :lisp-and-log) trees)))
  (dolist (path (directory (merge-pathnames "coverage-self-test/*.html" root)))
    (push (list (concatenate 'string "coverage-self-test-html/" (file-namestring path))
                (namestring path)) files))
  (dolist (path (uiop:directory-files root))
    (unless (or (search "draft" (file-namestring path))
                (string= "manifest.lisp" (file-namestring path)))
      (push (list (concatenate 'string "helpers/" (file-namestring path)) (namestring path)) files)))
  (dolist (name '("runtime-review-draft.md" "coverage-review-draft.md"))
    (let* ((source (merge-pathnames name root))
           (target (merge-pathnames (concatenate 'string name ".txt") root)))
      (when (probe-file target) (error "Snapshot lettura esistente: ~A" target))
      (uiop:copy-file source target)
      (push (list (concatenate 'string "readings/" name ".txt") (namestring target)) files)))
  (setf processes (nreverse processes) trees (nreverse trees) files (nreverse files))
  (with-open-file (stream (merge-pathnames "manifest.lisp" root)
                         :direction :output :if-exists :error)
    (let ((*print-readably* t))
      (write (list :schema-version 1 :processes processes :trees trees :files files)
             :stream stream :pretty t) (terpri stream)))
  (format t "Manifest: ~D processi, ~D alberi, ~D file espliciti.~%"
          (length processes) (length trees) (length files)))
