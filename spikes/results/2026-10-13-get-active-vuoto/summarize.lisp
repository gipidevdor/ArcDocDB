;;;; Derivazione C4 da record chiusi; nessuna esecuzione del prodotto.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun aev-require (test detail)
  (unless test (error "AEV summary COD-61: ~A" detail)))
(defun aev-median (numbers)
  (aev-require (and numbers (oddp (length numbers))) "mediana richiede campioni dispari")
  (nth (floor (length numbers) 2) (sort (copy-list numbers) #'<)))
(defun aev-closed (path)
  (let ((data (arcdocdb.evidence:read-evidence path)))
    (aev-require (eq :ok (getf data :status)) "produttore non riuscito")
    data))
(defun aev-row (windows n stage execution readers)
  (let* ((selected (remove-if-not
                    (lambda (w) (and (= n (getf w :n)) (eq stage (getf w :stage))
                                     (eq execution (getf w :execution)) (= readers (getf w :readers))))
                    windows))
         (rates (mapcar (lambda (w)
                          (aev-require (plusp (getf w :seconds)) "clock senza progresso")
                          (/ (getf w :completed) (getf w :seconds))) selected))
         (heaps (mapcar (lambda (w) (getf w :heap-bytes)) selected)))
    (aev-require (= 5 (length selected)) "cinque repliche richieste")
    (list :n n :stage stage :execution execution :readers readers :replicas 5
          :cycles-per-second-min (reduce #'min rates) :cycles-per-second-median (aev-median rates)
          :cycles-per-second-max (reduce #'max rates)
          :heap-bytes-min (reduce #'min heaps) :heap-bytes-median (aev-median heaps)
          :heap-bytes-max (reduce #'max heaps))))
(defun aev-summary (bench mutations check)
  (let ((windows (getf bench :windows)))
    (aev-require (= 120 (length windows)) "matrice finestre incompleta")
    (aev-require (every (lambda (w) (and (eq :ok (getf w :status))
                                        (= (getf w :requested) (getf w :completed))
                                        (= (getf w :checksum) (getf w :expected-checksum)))) windows)
                 "oracolo finestra")
    (aev-require (and (eq :baseline-passed (getf (getf mutations :baseline) :result))
                      (= 4 (length (getf mutations :mutants)))
                      (every (lambda (m) (eq :detected (getf m :result))) (getf mutations :mutants)))
                 "baseline/mutanti")
    (aev-require (eq :stable (getf check :source-consistency)) "sorgenti verifica non stabili")
    (list :schema-version 1 :kind :active-empty-derived-results :status :ok
          :named-test-lines
          (count-if (lambda (line) (uiop:string-prefix-p "ok    TEST-" line))
                    (uiop:split-string (getf check :stdout) :separator '(#\Newline)))
          :mutation-tests (length (getf mutations :expected-tests)) :mutants-detected 4 :mutants-total 4
          :windows 120 :measured-cycles (reduce #'+ windows :key (lambda (w) (getf w :completed)))
          :warmup-cycles (loop for w in windows sum (* (getf w :readers) (getf w :warmup-per-reader)))
          :serial-windows (count :serial windows :key (lambda (w) (getf w :execution)))
          :serial-zero-heap-windows (count-if (lambda (w) (and (eq :serial (getf w :execution))
                                                               (zerop (getf w :heap-bytes)))) windows)
          :rows (loop for n in '(1 8 64) append
                  (loop for stage in '(:empty-active :first-active-publish) append
                    (loop for config in '((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4))
                          collect (aev-row windows n stage (first config) (second config)))))
          :limits '(:local-machine :whole-process-heap :checks-inside-clock
                    :parallel-startup-gate-join-inside-clock :no-storage-throughput
                    :no-engine-or-mcdc-qualification))))
(let ((args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (progn
        (aev-require (= 3 (aev-median '(5 1 3))) "mediana")
        (aev-require (= 1 (aev-median '(1))) "campione singolo")
        (let ((caught nil))
          (handler-case (aev-median nil) (error () (setf caught t)))
          (aev-require caught "mediana vuota non rifiutata"))
        (write '(:schema-version 1 :kind :active-empty-summary-self-test :status :ok :checks 3) :pretty t))
      (progn
        (aev-require (= 4 (length args)) "uso: benchmark mutation check output")
        (let* ((report (aev-summary (aev-closed (first args)) (aev-closed (second args))
                                    (aev-closed (third args))))
               (*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil))
          (setf (getf report :inputs)
                (mapcar (lambda (path) (list :file path :sha256 (arcdocdb.evidence:file-sha256 path)))
                        (subseq args 0 3)))
          (with-open-file (out (fourth args) :direction :output :if-exists :error)
            (write report :stream out :pretty t) (terpri out))
          (write report :pretty t))))
  (terpri))
