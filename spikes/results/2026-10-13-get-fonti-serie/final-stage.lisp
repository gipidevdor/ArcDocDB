;;;; Ultima integrazione e raw nuovi; riusa il collector immutabile già revisionato.
(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(let ((source "spikes/results/2026-10-13-get-fonti-serie/collect.lisp")
      (preserved "spikes/results/2026-10-13-get-fonti-serie/publication-tool-source.txt"))
  (unless (string= (arcdocdb.evidence:file-sha256 source) (arcdocdb.evidence:file-sha256 preserved))
    (error "Collector invocato non corrisponde al sorgente conservato."))
  ;; Solo DEFUN del sorgente locale fidato, senza il dispatcher finale del collector.
  (with-open-file (in source)
    (let ((*read-eval* nil))
      (loop for form = (read in nil :end) until (eq form :end)
            when (and (consp form) (eq 'defun (first form))) do (eval form)))))
(defun stable-command (name)
  (let ((r (arcdocdb.evidence:read-evidence (format nil "spikes/out/~A/report.lisp" name))))
    (unless (and (terminal-producer-p r) (eq :ok (getf r :status)) (eql 0 (getf r :exit-code))
                 (eq :stable (getf r :source-consistency))
                 (equal (getf r :source-blobs-before) (getf r :source-blobs-after)))
      (error "Comando non chiuso/stabile/positivo: ~A" name))
    r))
(defun blob-for (path sources)
  (getf (find path sources :key (lambda (s) (getf s :path)) :test #'string=) :git-blob :absent))
(let* ((args (uiop:command-line-arguments)) (check-name (first args)) (self-name (second args))
       (base (truename "spikes/results/2026-10-13-get-fonti-serie/"))
       (old (stable-command "4000908905-command-89604-0")) (check (stable-command check-name))
       (self (stable-command self-name)) (changes nil)
       (before (getf old :source-blobs-before)) (after (getf check :source-blobs-before))
       (paths (remove-duplicates (mapcar (lambda (s) (getf s :path)) (append before after)) :test #'string=))
       (tests (remove-if-not (lambda (line) (uiop:string-prefix-p "ok    TEST-" line))
                             (uiop:split-string (getf check :stdout) :separator '(#\Newline))))
       (catalog-path (merge-pathnames "catalogo.lisp" base))
       (catalog (arcdocdb.evidence:read-evidence catalog-path)))
  (declare (ignore self))
  (unless (= 2 (length args)) (error "Servono i due produttori finali."))
  (dolist (path paths)
    (when (and (uiop:string-prefix-p "src/" path) (not (equal (blob-for path before) (blob-for path after))))
      (unless (uiop:string-prefix-p "src/codec/" path) (error "Delta oltre writer float CBOR: ~A" path))
      (push (list :file path :before (blob-for path before) :after (blob-for path after)) changes))
    (when (and (or (uiop:string-prefix-p "tests/get-directory/" path)
                   (uiop:string-prefix-p "tools/get-series-" path))
               (not (equal (blob-for path before) (blob-for path after))))
      (error "Fixture/tool GET cambiato: ~A" path)))
  (unless (and (= 3 (length changes)) (> (length tests) 1061)
               (search "build e test: nessun avviso, tutti i controlli superati" (getf check :stdout)))
    (error "Integrazione finale incompleta."))
  (dolist (name (list check-name self-name))
    (copy-record (format nil "spikes/out/~A/report.lisp" name)
                 (merge-pathnames (format nil "~A-report.lisp" name) base)))
  (let* ((spec (list :directory "get-series-coverage-self-j" :producer-directory self-name))
         (metadata (raw-root-metadata spec))
         (raw (collect-raw "spikes/out/get-series-coverage-self-j/" "get-series-coverage-self-j/" base)))
    (setf (getf catalog :associated-raw-files)
          (append (getf catalog :associated-raw-files) (mapcar (lambda (entry) (append entry metadata)) raw))))
  (save-data (list :schema-version 1 :kind :get-series-latest-main-integration :status :ok
                   :check-producer check-name :coverage-selector-producer self-name
                   :previous-integration-freeze (getf (getf old :environment) :commit)
                   :integration-freeze (getf (getf check :environment) :commit)
                   :named-tests (length tests) :product-source-deltas (nreverse changes)
                   :get-product-fixture-and-tools-unchanged t
                   :collector-library-sha256 (arcdocdb.evidence:file-sha256
                                             (merge-pathnames "collect.lisp" base))
                   :limits '(:only-local-collector-definitions-evaluated :no-transitive-authentication
                             :benchmark-remains-at-h-freeze :new-scope-selector-self-test-captured))
             (merge-pathnames "latest-integration.lisp" base))
  (with-open-file (out (merge-pathnames "report.md" base) :direction :output :if-exists :append)
    (format out "~%## Ultima integrazione con main~%~%")
    (format out "La [verifica finale](latest-integration.lisp) passa **~D test nominati**~%" (length tests))
    (format out "al freeze `~A`. Dopo l'integrazione pool cambiano~%" (getf (getf check :environment) :commit))
    (format out "soltanto tre sorgenti codec per il writer float CBOR; prodotto, fixture e~%strumenti GET sono identici. Il selettore coverage conserva entrambi gli~%scope GET Serie e writer float e passa il suo self-test. Le misure GET~%restano esplicitamente quelle della campagna H.~%"))
  (dolist (name (list (format nil "~A-report.lisp" check-name) (format nil "~A-report.lisp" self-name)
                     "latest-integration.lisp"))
    (let* ((path (merge-pathnames name base)) (r (arcdocdb.evidence:read-evidence path)))
      (push (list :artifact name :kind (getf r :kind) :status (getf r :status)
                  :scope :latest-main-integration :sha256 (arcdocdb.evidence:file-sha256 path))
            (getf catalog :entries))))
  (dolist (name '("report.md" "final-stage.lisp" "final-stage-source.txt"))
    (let* ((path (merge-pathnames name base)) (entry (raw-entry path path base)))
      (setf (getf catalog :associated-raw-files)
            (cons entry (remove name (getf catalog :associated-raw-files)
                                :key (lambda (e) (getf e :file)) :test #'string=)))))
  (save-data catalog catalog-path)
  (format t "~S~%" (list :status :ok :kind :get-series-latest-main-publication :named-tests (length tests))))
