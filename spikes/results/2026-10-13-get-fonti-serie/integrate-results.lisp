;;;; Verifica il raccordo fra la campagna mirata e la suite del nuovo main.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun command-data (name)
  (let ((data (arcdocdb.evidence:read-evidence (format nil "spikes/out/~A/report.lisp" name))))
    (unless (and (eq :command-verification (getf data :kind)) (eq :ok (getf data :status))
                 (eql 0 (getf data :exit-code)) (eq :stable (getf data :source-consistency))
                 (equal (getf data :source-blobs-before) (getf data :source-blobs-after)))
      (error "Controllo incompleto o instabile."))
    data))
(defun path-hash (path sources)
  (getf (find path sources :key (lambda (entry) (getf entry :path)) :test #'string=) :git-blob :absent))
(let* ((args (uiop:command-line-arguments)) (before (command-data (first args))) (after (command-data (second args)))
       (failed (arcdocdb.evidence:read-evidence (format nil "spikes/out/~A/report.lisp" (fourth args))))
       (old (getf before :source-blobs-before)) (new (getf after :source-blobs-before)) (changes nil)
       (paths (remove-duplicates (mapcar (lambda (entry) (getf entry :path)) (append old new)) :test #'string=))
       (tests (remove-if-not (lambda (line) (uiop:string-prefix-p "ok    TEST-" line))
                             (uiop:split-string (getf after :stdout) :separator '(#\Newline)))))
  (unless (and (= 4 (length args)) (eq :failed (getf failed :status)) (eql 2 (getf failed :exit-code))
               (eq :stable (getf failed :source-consistency))
               (equal (getf failed :source-blobs-before) (getf after :source-blobs-before))
               (search "build e test: nessun avviso, tutti i controlli superati" (getf failed :stdout))
               (search "ROTTO  spikes/results/2026-10-13-get-fonti-serie/report.md" (getf failed :stdout)))
    (error "Il fallimento precedente non corrisponde al controllo dei link."))
  (dolist (path paths)
    (when (and (uiop:string-prefix-p "src/" path) (not (equal (path-hash path old) (path-hash path new))))
      (unless (uiop:string-prefix-p "src/scheduler/" path)
        (error "Modifica di prodotto oltre il controller pool: ~A" path))
      (push (list :file path :before (path-hash path old) :after (path-hash path new)) changes))
    (when (and (or (uiop:string-prefix-p "tests/get-directory/" path)
                   (uiop:string-prefix-p "tools/get-series-" path))
               (not (equal (path-hash path old) (path-hash path new))))
      (error "Fixture/tool GET cambiato: ~A" path)))
  (unless (and (= 6 (length changes)) (> (length tests) 1038)
               (search "build e test: nessun avviso, tutti i controlli superati" (getf after :stdout)))
    (error "Integrazione incompleta."))
  (let ((data (list :schema-version 1 :kind :get-series-main-integration :status :ok
                    :component-check-producer (first args) :integration-check-producer (second args)
                    :component-freeze (getf (getf before :environment) :commit)
                    :integration-freeze (getf (getf after :environment) :commit)
                    :named-tests (length tests) :product-source-changes (nreverse changes)
                    :get-product-fixture-and-tools-unchanged t
                    :earlier-attempt (list :producer (fourth args) :status :failed :exit-code 2
                                          :cause :report-references-not-yet-published
                                          :product-tools-and-tests-identical-to-accepted-integration
                                          :raw-output-retained t)
                    :limits '(:benchmark-remains-at-component-freeze :not-a-repeated-integrated-benchmark
                              :all-product-source-differences-confined-to-scheduler
                              :new-module-and-test-registration-verified-by-full-check))))
    (with-open-file (s (third args) :direction :output :if-exists :error)
      (let ((*print-readably* nil) (*print-escape* t)) (write data :stream s :pretty t) (terpri s)))
    (format t "~S~%" (list :status :ok :named-tests (length tests) :new-product-files (length changes)))))
