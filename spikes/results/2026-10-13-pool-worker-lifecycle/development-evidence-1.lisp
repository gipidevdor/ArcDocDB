                (list :name \"symlink\" :source (namestring (merge-pathnames \"bad-symlink/\" scratch)))
                scratch (merge-pathnames \"must-not-create-campaign-symlink/\" scratch)))
             :recursive-campaign-source-symlink-rejected)
            (rejects
             (lambda ()
