  (check (search ";   printed 1446 notes" stderr) :recorded-compiler-note-summary)
  (let* ((tail (subseq all (1+ end))) (lint (summary-line tail "violazioni" 2))
         (trace (summary-line tail "requisiti," 5)) (links (summary-line tail "link controllati," 3)))
    (check (and (not (search "tools/run-spikes.lisp --check" stdout))
