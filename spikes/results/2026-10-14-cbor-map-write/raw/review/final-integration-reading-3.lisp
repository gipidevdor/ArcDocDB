    (check (and (string= trusted-before "fa2b5d36dca0837e2ed5e49b282887b2e110b2b7")
                (string= trusted-before (git-blob "tools/evidence-storage.lisp"))) :trusted-reader-stable)
    (check (equal current-pins (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*)) :map-current-pins-after)
    (check (equal module-pins (mapcar (lambda (path) (list path (git-blob path))) *integration-paths*)) :module-current-pins-after)
    (let ((*print-readably* t))
      (write (list :status :ok :checks *checks* :head *head* :record *record*
                   :wrapper-status (getf data :status) :exit-code (getf data :exit-code)
                   :source-consistency (getf data :source-consistency) :sources (hash-table-count before)
                   :nominal-tests (length nominal) :smoke 2 :map-tests 20 :new-recycle-tests 13
                   :lint lint :trace trace :links links :wall-seconds (getf data :wall-seconds)
                   :stderr-chars (length stderr)
                   :compiler-note-summaries (remove-if-not (lambda (line) (and (prefixp ";   printed " line)
                                                                             (search " notes" line))) (lines stderr))
                   :five-map-pins *pins* :integrated-source-pins module-pins
                   :descriptor-observation descriptor-before :payload-observation payload-before :descriptor descriptor
                   :limits '(:data-only :no-product-or-driver-load-compile-call :build-lint-trace-links-only
                             :new-module-loading-inferred-from-asdf-build-contract-and-completed-build
                             :new-recycle-nominals-observed :no-coverage-spikes-evidence-or-c1-qualification
