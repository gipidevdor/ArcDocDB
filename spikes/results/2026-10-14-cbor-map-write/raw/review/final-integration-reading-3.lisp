       (module-pins (mapcar (lambda (path) (list path (git-blob path))) *integration-paths*)))
  (check (equal descriptor-before (list *record* 317 "bf74f5952898a69e4a964a1d61ad7d2d9d3e0e3be11f7883b8dbfbcb501f3ef6")) :explicit-descriptor)
  (check (and (eql 1 (getf descriptor :schema-version)) (eq :compressed-evidence (getf descriptor :kind))
              (eq :gzip (getf descriptor :codec)) (string= "report.lisp.gz" (getf descriptor :payload))
              (eql 1108645 (getf descriptor :uncompressed-bytes))
              (string= "078cec8b82800583c4ad35908b3b0e3f42674dac0035dee38d8cafd24dd315b0" (getf descriptor :uncompressed-sha256))
              (eql 138750 (getf descriptor :compressed-bytes))
              (string= "1e383482c9124a160f8105faf2530fdfea346ed944612439c22312c4c5b0b496" (getf descriptor :compressed-sha256))) :explicit-compressed-contract)
  (check (equal payload-before (list payload 138750 "1e383482c9124a160f8105faf2530fdfea346ed944612439c22312c4c5b0b496")) :physical-payload)
  (check (and (eql 1 (getf data :schema-version)) (eq :command-verification (getf data :kind))
              (eq :ok (getf data :status)) (eql 0 (getf data :exit-code)) (eq :stable (getf data :source-consistency))
              (string= *head* (getf env :commit)) (string= "" (getf env :working-tree))) :completed-head)
  (check (and (equal (getf data :source-blobs-before) (getf data :source-blobs-after))
              (= (hash-table-count before) (hash-table-count after))) :stable-inventories)
  (check (equal '("make" "build" "lint" "trace" "links") (getf data :command)) :exact-command-profile)
  (check (and end (= 1 (count completion all :test #'string=)) (plusp (length nominal))
              (= (+ 2 (length nominal)) (length ok))
              (= 20 (length map-tests) (length (remove-duplicates map-tests :test #'string=)))) :nominal-smoke-and-map-counts)
  (dolist (smoke '("ok    package ARCDOCDB presente" "ok    ARCDOCDB:*VERSION* è una stringa"))
    (check (= 1 (count smoke functional :test #'string=)) :two-smoke))
  (check (equal current-pins *pins*) :current-five-pins)
  (dolist (pin (append *pins* module-pins))
    (check (and (equal (second pin) (gethash (first pin) before))
                (equal (second pin) (gethash (first pin) after))) :module-and-map-record-pins))
  (check (and (= 13 (length recycle-tests) (length (remove-duplicates recycle-tests :test #'string=)))
              (every (lambda (test) (= 1 (count test functional :test #'string=))) recycle-tests)) :thirteen-new-recycle-tests)
  (let ((asd (uiop:read-file-string "arcdocdb.asd" :external-format :utf-8))
        (build (uiop:read-file-string "tools/build.lisp" :external-format :utf-8)))
