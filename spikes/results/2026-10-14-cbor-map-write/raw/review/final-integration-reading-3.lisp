(defun check (truth reason)
  (incf *checks*) (unless truth (error "Final integration DATA: ~S" reason)))
(defun prefixp (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))
(defun lines (text)
  (loop for start = 0 then (1+ stop) for stop = (position #\Newline text :start start)
        collect (string-right-trim '(#\Return) (subseq text start stop)) while stop))
(defun plist-check (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test 'eq)))
    (check (and size (evenp size)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-key)
             (setf (gethash key seen) t)))
  data)
(defun inventory (entries)
  (check (and (consp entries) (list-length entries)) :proper-inventory)
  (let ((table (make-hash-table :test 'equal)))
    (dolist (entry entries)
      (plist-check entry)
      (let ((path (getf entry :path)) (hash (getf entry :git-blob)))
        (check (and (stringp path) (stringp hash) (= 40 (length hash))
                    (not (gethash path table))) :inventory-entry)
        (setf (gethash path table) hash)))
    table))
(defun observation (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun git-blob (path)
  (string-trim '(#\Space #\Return #\Newline) (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun literal-descriptor (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym "EOF")))
    (with-open-file (input path :external-format :utf-8)
      (let ((data (read input nil eof)))
        (check (not (eq data eof)) :descriptor-present)
        (check (eq eof (read input nil eof)) :descriptor-eof)
        (plist-check data)))))
(defun numbers (line)
  (loop with size = (length line) with position = 0 while (< position size)
        if (digit-char-p (char line position))
          collect (multiple-value-bind (value end) (parse-integer line :start position :junk-allowed t)
                    (setf position end) value)
        else do (incf position)))
(defun summary-line (all suffix count)
  (let ((matches (remove-if-not (lambda (line) (and (plusp (length line))
                                                  (digit-char-p (char line 0)) (search suffix line))) all)))
    (check (= 1 (length matches)) :unique-summary)
    (let ((counts (numbers (first matches))))
      (check (and (= count (length counts)) (zerop (car (last counts)))) :zero-summary-errors)
      (list :line (first matches) :counts counts))))
(defun frozen-recycle-tests ()
  (loop for line in (lines (uiop:read-file-string "tests/scheduler/pool-recycle.lisp" :external-format :utf-8))
        when (and (>= (length line) 9) (string-equal "(deftest " line :end2 9))
          collect (concatenate 'string "ok    " (string-upcase (subseq line 9 (position #\Space line :start 9))))))
(let* ((descriptor-before (observation *record*))
       (descriptor (literal-descriptor *record*))
       (payload (merge-pathnames "report.lisp.gz" *record*))
       (payload-before (observation payload))
       (trusted-before (git-blob "tools/evidence-storage.lisp"))
       (data (plist-check (arcdocdb.evidence:read-evidence *record*)))
       (env (plist-check (getf data :environment)))
       (before (inventory (getf data :source-blobs-before)))
       (after (inventory (getf data :source-blobs-after)))
       (stdout (getf data :stdout)) (stderr (getf data :stderr)) (all (lines stdout))
       (completion "build e test: nessun avviso, tutti i controlli superati")
       (end (position completion all :test #'string=))
       (functional (and end (subseq all 0 end)))
       (nominal (remove-if-not (lambda (line) (prefixp "ok    TEST-" line)) functional))
       (ok (remove-if-not (lambda (line) (prefixp "ok    " line)) functional))
       (map-tests (remove-if-not (lambda (line) (prefixp "ok    TEST-REQ-CBR-006-MAP-" line)) nominal))
