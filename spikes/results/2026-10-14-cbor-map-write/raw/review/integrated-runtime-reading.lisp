;;;; C4: completed check-core and referenced child DATA only; no product or driver call.
(load "tools/evidence-storage.lisp")
(defpackage #:cbor.map.integrated.reading (:use #:cl))
(in-package #:cbor.map.integrated.reading)

(defun lines (string)
  (with-input-from-string (stream string)
    (loop for line = (read-line stream nil) while line
          collect (string-right-trim '(#\Return) line))))
(defun prefixp (prefix string)
  (and (<= (length prefix) (length string)) (string= prefix string :end2 (length prefix))))
(defun number-after (line label)
  (let ((position (search label line)))
    (assert position)
    (multiple-value-bind (value end)
        (parse-integer line :start (+ position (length label)) :junk-allowed t)
      (assert value) (values value end))))
(defun literal-descriptor (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof))) (assert (eq eof (read stream nil eof))) form))))

(defun raw-data (string &key (start 0) eof-required)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-input-from-string (stream string :start start)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof)))
        (when eof-required (assert (eq eof (read stream nil eof)))) form))))
(defun text (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((string (make-string (file-length stream))))
      (subseq string 0 (read-sequence string stream)))))
(defun embedded-selftest (stdout marker)
  (let* ((begin (search marker stdout))
         (line-end (and begin (position #\Newline stdout :start begin)))
         (start (and line-end (search "(:" stdout :start2 line-end))))
    (assert start) (raw-data stdout :start start)))
(defun pin-path (path pins)
  (pushnew (cons (namestring (pathname path)) (arcdocdb.evidence:file-sha256 path)) pins :test #'equal)
  (when (string= "gz" (or (pathname-type path) "")) (error "Descriptor expected."))
  (unless (zerop (arcdocdb.evidence:file-bytes path))
    (let ((descriptor (literal-descriptor path)))
      (when (eq :compressed-evidence (getf descriptor :kind))
        (let ((payload (merge-pathnames (getf descriptor :payload) path)))
          (pushnew (cons (namestring payload) (arcdocdb.evidence:file-sha256 payload)) pins :test #'equal)))))
  pins)

(defun check-selftest (stdout path marker kind child-kind count sources pins)
  (let* ((metadata (embedded-selftest stdout marker))
         (fixture (arcdocdb.evidence:read-evidence path))
         (expected-kind (if (eq kind :snapshot-mutations) :snapshot-process-self-test :reader-process-self-test)))
    (setf pins (pin-path path pins))
    (assert (and (eql 1 (getf metadata :schema-version)) (eq kind (getf metadata :kind))
                 (eq :ok (getf metadata :status)) (eq :stable (getf metadata :source-consistency))
                 (= sources (length (getf metadata :source-fingerprints-before)))
                 (equalp (getf metadata :source-fingerprints-before) (getf metadata :source-fingerprints-after))
                 (eql 0 (getf metadata :worker-errors)) (null (getf metadata :baseline))
                 (null (getf metadata :mutants)) (= count (length (getf metadata :targets)))
                 (eq :ok (getf (getf metadata :self-test) :status))
                 (= count (getf (getf metadata :self-test) :unique-targets))
                 (equal (truename path) (truename (getf metadata :process-fixtures)))))
    (assert (and (eql 1 (getf fixture :schema-version)) (eq expected-kind (getf fixture :kind))
                 (eq :passed (getf fixture :status)) (eql 2 (getf fixture :worker-errors))
                 (= 2 (length (getf fixture :mutants))) (null (getf fixture :baseline))))
    (loop for row in (getf fixture :mutants) for name in '(:signal :completion-exit)
          for execution = (getf row :execution) for reported = (getf execution :report)
          for raw-path = (getf execution :stdout-log) for stderr-path = (getf execution :stderr-log)
          for raw = (raw-data (text raw-path) :eof-required t)
          do (setf pins (pin-path raw-path pins))
             (setf pins (pin-path stderr-path pins))
             (assert (and (eq name (getf row :name)) (eq :worker-error (getf row :result))
                          (null (getf execution :timed-out))
                          (= 0 (arcdocdb.evidence:file-bytes stderr-path))
                          (equalp raw reported) (eql 1 (getf raw :schema-version))
                          (eq child-kind (getf raw :kind))))
             (if (eq name :signal)
                 (assert (and (eql 137 (getf execution :exit-code)) (eql 9 (getf execution :signal))
                              (eq :failed (getf raw :status)) (eq :tests (getf raw :phase))
                              (eq :runtime (getf raw :failure-kind)) (string= "fixture" (getf raw :failed-test))))
                 (assert (and (eql 7 (getf execution :exit-code)) (null (getf execution :signal))
                              (eq :ok (getf raw :status)) (eq :complete (getf raw :phase))
                              (equal '("fixture") (getf raw :passed-tests)))))
             (format t "SELF ~S negative~S => WORKER-ERROR exit~D signal~S; raw EOF matches metadata, stderr0.~%"
                     kind name (getf execution :exit-code) (getf execution :signal)))
    (format t "SELF ~S outerOK/worker-errors0 source~D STABLE; direct PASSED/expected-worker-errors2; catalogue~D not executed as mutation campaign.~%LIMITS ~S~%"
            kind sources count (getf metadata :limits)) pins))

(defun check-spikes (stdout outer pins)
  (let* ((path "spikes/out/4000986301-check-78781-0/report.lisp")
         (aggregate (arcdocdb.evidence:read-evidence path)) (runs (getf aggregate :runs))
         (artifacts (getf aggregate :run-artifacts)))
    (assert (search "10 spike completati; risultati:" stdout))
    (setf pins (pin-path path pins))
    (assert (and (eql 1 (getf aggregate :schema-version)) (eq :complete (getf aggregate :status))
                 (string= "--check" (getf aggregate :mode)) (= 10 (length runs) (length artifacts))))
    (loop for run in runs for artifact in artifacts for number from 1
          for id = (format nil "SPK-~2,'0D" number)
          for stored = (arcdocdb.evidence:read-evidence artifact)
          for raw = (raw-data (getf stored :stdout) :eof-required t)
          do (setf pins (pin-path artifact pins))
             (assert (and (equalp run stored) (string= id (getf stored :id))
                          (eql 1 (getf stored :schema-version)) (eql 0 (getf stored :exit-code))
                          (member (getf stored :status) '(:ok :pass))
                          (eq :stable (getf stored :source-consistency))
                          (equalp (getf stored :source-blobs-before) (getf stored :source-blobs-after))
                          (equalp raw (getf stored :result))
                          (eq (getf raw :status) (getf stored :status))
                          (plusp (getf stored :wall-seconds))
                          (<= (getf outer :started-at-universal-time) (getf stored :started-at-universal-time)
                              (getf stored :finished-at-universal-time) (getf outer :finished-at-universal-time))
                          (zerop (length (getf stored :stderr)))))
             (format t "CHILD ~A schema1 exit0/~S source~D STABLE wall~S; aggregate=artifact, raw single-form EOF=RESULT (structural arrays), within parent, stderr0.~%"
                     id (getf stored :status) (length (getf stored :source-blobs-before))
                     (getf stored :wall-seconds))) pins))

(let* ((path "spikes/out/4000986074-command-71976-0/report.lisp")
       (self "spikes/out/cbor-map-write-20261014/review/integrated-runtime-reading.lisp")
       (self-sha (arcdocdb.evidence:file-sha256 self))
       (descriptor-sha (arcdocdb.evidence:file-sha256 path))
       (descriptor (literal-descriptor path))
       (payload (merge-pathnames (getf descriptor :payload) path))
       (payload-sha (arcdocdb.evidence:file-sha256 payload))
       (record (arcdocdb.evidence:read-evidence path))
       (before (getf record :source-blobs-before)) (after (getf record :source-blobs-after))
       (stdout (getf record :stdout)) (stderr (getf record :stderr)) (all (lines stdout))
       (ok (remove-if-not (lambda (line) (prefixp "ok    " line)) all))
       (nominal (remove-if-not (lambda (line) (prefixp "ok    TEST-" line)) ok))
       (linter (remove-if-not (lambda (line)
                               (some (lambda (prefix) (prefixp prefix line))
                                     '("ok    bad.lisp:" "ok    good.lisp:" "ok    keyword-barrier.lisp:"
                                       "ok    qualified-reader.lisp:"))) ok))
       (smoke (set-difference (set-difference ok nominal :test #'string=) linter :test #'string=))
       (map-ok (remove-if-not (lambda (line) (prefixp "ok    TEST-REQ-CBR-006-MAP-" line)) nominal))
       (expected
         (mapcar (lambda (suffix) (concatenate 'string "ok    TEST-REQ-CBR-006-MAP-" suffix))
                 '("EMPTY-SCALAR-PAIR-AND-TWO-LITERAL-PAIRS"
                   "PAIR-COUNT-WIDTH-BOUNDARIES-AND-MINIMAL-HEADER"
                   "NESTED-UTF8-FLOATS-OPAQUE-BYTES-AND-PRESERVED-PAIR-ORDER"
                   "CONCATENATION-NEXT-AND-REUSED-SPACE"
                   "DESTINATION-TYPE-AND-RANGE-PRECEDES-EVERYTHING"
                   "SOURCE-TYPE-RANGE-AND-BACKING-ARRAY-INTACT"
                   "TABLE-TYPE-COUNT-DOMAINS-AND-HALF-LENGTH-BEFORE-MULTIPLICATION"
                   "WORKSPACE-TYPE-AND-ALL-SCRATCH-ALIASES-EVEN-EMPTY"
                   "CONFIGURED-LIMITS-AND-EMPTY-ROOT-MINIMUM"
                   "STRICT-ACTIVE-ENDS-LAST-AND-UNREAD-EVEN-OR-ODD-TAIL"
                   "ALL-PREFLIGHT-PHASE-PRECEDENCES"
                   "OVERLAP-ENTIRE-FOOTPRINT-TOUCHING-AND-EMPTY"
                   "FULL-BYTE-BUDGET-KEY-PLUS-VALUE-EXACT-16MIB-AND-OVER"
                   "ROOT-KEY-VALUE-TAG-NODES-AND-ZERO-RESIDUE-BEFORE-RESET"
                   "ROOT-DEPTH-SCALARS-TAGS-AND-99-100-CHILD-CONTAINERS"
                   "KEY-AND-VALUE-PARSER-ERRORS-ABSOLUTE-AND-LEFT-TO-RIGHT"
                   "REUSE-AFTER-VALUE-PARSER-AND-PREFLIGHT-ERRORS"
                   "SCRATCH-LAST-VALUE-AND-ZERO-PAIRS-NO-RESET"
                   "FIXED-SEED-1024-FUZZ-AND-FROZEN-CLASS-COUNTS"
                   "TWO-REUSED-WORKERS-PRIVATE-SCRATCH-AND-READONLY-INPUTS")))
       (pins '(("src/codec/cbor-map-input.lisp" "d7a593badeb6e6b71f28dc4e80c641b07189d0b8")
               ("src/codec/cbor-map-write.lisp" "22e814ea68e606c5bc58033c2a31e945303a9d65")
               ("tests/codec/cbor-map-write-support.lisp" "a389e51f2416437d608c4f7745b9680eca27bc60")
               ("tests/codec/cbor-map-write.lisp" "6ad0e9b5a48ba9c32c46d720f2f7f1821368d6c8")
               ("tests/codec/cbor-map-write-threads.lisp" "6a65b58ce236b92b33772e1861dbd8c1257bee13"))))
  (assert (and (eql 1 (getf descriptor :schema-version)) (eq :compressed-evidence (getf descriptor :kind))
               (eq :gzip (getf descriptor :codec)) (= 317 (arcdocdb.evidence:file-bytes path))
               (string= "7456d4826398615c278eabcdee760ef508e33a5604b4cd72accd8356c9198240" descriptor-sha)
               (= 144099 (getf descriptor :compressed-bytes) (arcdocdb.evidence:file-bytes payload))
               (= 1143722 (getf descriptor :uncompressed-bytes))
               (string= payload-sha (getf descriptor :compressed-sha256))))
  (assert (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
               (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
               (eq :stable (getf record :source-consistency)) (equalp before after)
               (= 860 (length before) (length (remove-duplicates before :test #'string=
                                                        :key (lambda (row) (getf row :path)))))
               (string= "15c458eff76896f3fc83ad7756ae922f64eb22d7" (getf (getf record :environment) :commit))
               (string= "" (getf (getf record :environment) :working-tree))
               (= 260.414101d0 (getf record :wall-seconds))))
  (dolist (pin pins)
    (let ((row (find (first pin) before :key (lambda (entry) (getf entry :path)) :test #'string=)))
      (assert row) (assert (string= (second pin) (getf row :git-blob)))))
  (assert (and (= 1290 (length ok) (length (remove-duplicates ok :test #'string=)))
               (= 1284 (length nominal)) (= 2 (length smoke)) (= 4 (length linter))
               (= 20 (length map-ok) (length (remove-duplicates map-ok :test #'string=)))
               (null (set-exclusive-or map-ok expected :test #'string=))))
  (assert (member "build e test: nessun avviso, tutti i controlli superati" all :test #'string=))
  (dolist (line '("207 file, 0 violazioni"
                  "120 requisiti, 65 invarianti, 13 scenari FI, 52 ADR: 0 errori"
                  "440 file, 2914 link controllati, 0 rotti"))
    (assert (member line all :test #'string=)))
  (assert (not (some (lambda (marker)
                      (or (search marker stdout :test #'char-equal) (search marker stderr :test #'char-equal)))
                    '("WARNING:" "STYLE-WARNING:" "COMPILE-FILE-ERROR"))))
  (assert (not (search "Unhandled " stderr :test #'char-equal)))
  (assert (not (some (lambda (line) (prefixp "Unhandled " line)) all)))
  (format t "INPUT descriptor317 bytes SHA~A; gzip144099 SHA~A; trusted-expanded1143722 SHA~A/EOF/READ-EVAL NIL.~%"
          descriptor-sha payload-sha (getf descriptor :uncompressed-sha256))
  (format t "COMMAND ~S~%OUTER schema1/COMMAND-VERIFICATION OK/exit0/STABLE wall~S HEAD~A clean; sources860 unique before=after; frozen5pins matched.~%"
          (getf record :command) (getf record :wall-seconds) (getf (getf record :environment) :commit))
  (format t "OUTPUT stdout~D chars stderr~D chars; warning/compile markers0 and no unquoted line-start Unhandled; stderr optimization-note lines~D.~%"
          (length stdout) (length stderr)
          (count-if (lambda (line) (search "note:" line :test #'char-equal)) (lines stderr)))
  (format t "OK1290 unique = nominal1284 + smoke2 + linter-selftest4; map20 exact frozen functions.~%SMOKE ~S~%LINTER ~S~%" smoke linter)
  (dolist (line map-ok) (write-line line))
  (dolist (line all)
    (when (or (string= line "207 file, 0 violazioni")
              (string= line "120 requisiti, 65 invarianti, 13 scenari FI, 52 ADR: 0 errori")
              (string= line "440 file, 2914 link controllati, 0 rotti")) (write-line line)))
  (let ((fuzz "  CBOR map fuzz: seed4D415035, 1024 casi, 512 successi e 64 ciascuno capacita/byte/entry/nodi/profondita/parse/source-range/count.")
        (state #x4d415035) (counts (make-array 9 :initial-element 0)))
    (assert (member fuzz all :test #'string=))
    (dotimes (iteration 1024)
      (setf state (logand #xffffffff (+ (* state 1664525) 1013904223)))
      (incf (aref counts (if (< (mod iteration 16) 8) 0 (- (mod iteration 16) 7)))))
    (assert (= state #x0d123435)) (assert (equalp counts #(512 64 64 64 64 64 64 64 64)))
    (write-line fuzz)
    (format t "COLD LCG final0D123435 counts~S. Final state is asserted in frozen test, not printed in stdout.~%" counts))
  (let ((waves (remove-if-not (lambda (line) (prefixp "  CBOR map: onda" line)) all)))
    (assert (= 2 (length waves)))
    (loop for line in waves for wave from 0
          do (assert (= wave (number-after line "onda")))
             (assert (search ", 2 worker riusati, 4096 composizioni, sink 54677504/77537280," line))
             (let ((overlap (number-after line "overlap ")) (rate (number-after line "tick (")))
               (assert (plusp overlap)) (assert (= 1000000 rate))
               (write-line line)
               (format t "WAVE~D observed overlap ~,6F seconds; individual start/finish intervals not printed.~%"
                       wave (/ overlap (float rate 1d0))))))
  (format t "ARITHMETIC planned calls: serial283+fuzz1024+parallel8192=9499; success84+512+8192=8788, rejection199+512=711. Not instrumented API counters.~%")
  (let* ((start (search "(:STATUS :OK :CATALOGS" stdout))
         (evidence (progn (assert start) (raw-data stdout :start start))))
    (assert (and (eq :ok (getf evidence :status)) (= 98 (getf evidence :catalogs))
                 (= 3136 (getf evidence :artifact-references)) (= 25236 (getf evidence :stored-files))))
    (format t "EVIDENCE DATA statusOK catalogs98 references3136 stored-files25236; no archive rescan; limits~S.~%" (getf evidence :limits)))
  (let* ((start (search "(:SCHEMA-VERSION 1 :KIND :EVIDENCE-PUBLICATION-TESTS" stdout))
         (publication (progn (assert start) (raw-data stdout :start start))))
    (assert (and (eql 1 (getf publication :schema-version)) (eq :evidence-publication-tests (getf publication :kind))
                 (eq :ok (getf publication :status)) (= 2 (getf publication :checks))
                 (= 2 (length (getf publication :cases)))))
    (loop for row in (getf publication :cases)
          for fixture in '("fuori-catalogo.lisp" "fuori-catalogo.gz")
          for bytes in '(1048577 8388609)
          do (assert (and (string= fixture (getf row :fixture)) (eql bytes (getf row :bytes))
                          (eq :ok (getf row :status)) (eql 1 (getf row :observed-exit-code))
                          (string= "" (getf row :stdout))
                          (search "Unhandled SIMPLE-ERROR" (getf row :stderr))))
             (format t "PUBLICATION negative ~A bytes~D: statusOK observed-exit1; expected Unhandled retained inside quoted DATA stderr.~%"
                     fixture bytes)))
  (let ((data-pins nil))
    (setf data-pins (check-selftest stdout "spikes/out/4000986108-snapshot-self-test-72655-0/report.lisp"
                                   "Snapshot: fixture processi conservate in " :snapshot-mutations :snapshot-mutation-child 10 21 data-pins))
    (setf data-pins (check-selftest stdout "spikes/out/4000986108-reader-self-test-72670-0/report.lisp"
                                   "Reader: fixture processi conservate in " :reader-mutations :reader-mutation-child 8 34 data-pins))
    (setf data-pins (check-spikes stdout record data-pins))
    (dolist (pin data-pins) (assert (string= (cdr pin) (arcdocdb.evidence:file-sha256 (car pin)))))
    (format t "REFERENCED metadata/raw/descriptor files~D SHA stable during DATA reading; not a source or archive SHA sweep.~%" (length data-pins)))
  (assert (string= descriptor-sha (arcdocdb.evidence:file-sha256 path)))
  (assert (string= payload-sha (arcdocdb.evidence:file-sha256 payload)))
  (assert (string= self-sha (arcdocdb.evidence:file-sha256 self)))
  (format t "FINAL descriptor/payload/reader stable; reader SHA~A. DATA only; no product/suite/driver LOAD/EVAL/compile/call or campaign rerun; recorded check/spike/evidence results, no authenticity/MC/DC/scaling/engine qualification.~%" self-sha))
