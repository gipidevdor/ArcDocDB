(defun check (truth reason)
  (incf *checks*) (unless truth (error "Mutation DATA: ~S" reason)))
(defun prefixp (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))
(defun plist-check (data)
  (let ((size (and (consp data) (list-length data))) (seen (make-hash-table :test 'eq)))
    (check (and size (evenp size)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-key)
             (setf (gethash key seen) t)))
  data)
(defun inventory (entries path-key hash-key)
  (check (and (consp entries) (list-length entries)) :proper-inventory)
  (let ((table (make-hash-table :test 'equal)))
    (dolist (entry entries)
      (plist-check entry)
      (let ((path (getf entry path-key)) (hash (getf entry hash-key)))
        (check (and (stringp path) (stringp hash) (not (gethash path table))) :inventory-entry)
        (setf (gethash path table) hash)))
    table))
(defun git-blob (path)
  (string-trim '(#\Space #\Return #\Newline) (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun observation (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun read-one-string (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym "EOF")))
    (with-input-from-string (input text)
      (let ((data (read input nil eof)))
        (check (not (eq data eof)) :nonempty-data)
        (check (eq eof (read input nil eof)) :one-form-eof)
        (plist-check data)))))
(defun read-text (path) (uiop:read-file-string path :external-format :utf-8))
(defun bytes (path)
  (with-open-file (input path :element-type '(unsigned-byte 8))
    (let ((data (make-array (file-length input) :element-type '(unsigned-byte 8))))
      (check (= (length data) (read-sequence data input)) :complete-byte-read) data)))
(defun line-rows (text)
  (loop for start = 0 then (1+ stop) for stop = (position #\Newline text :start start)
        collect (list start (string-right-trim '(#\Return) (subseq text start stop))) while stop))
(defun marker (rows text)
  (let ((row (find text rows :key #'second :test #'string=))) (and row (first row))))
(defun warning-free (text)
  (every (lambda (needle) (not (search needle text :test #'char-equal)))
         '("WARNING:" "STYLE-WARNING:" "compilation aborted" "COMPILE-FILE-ERROR" "COMPILE-FILE-WARNED")))
(defun numbered-frame-p (line)
  (let ((colon (position #\: line)))
    (and colon (plusp colon) (< (+ colon 2) (length line))
         (every #'digit-char-p (subseq line 0 colon))
         (string= ": (" line :start2 colon :end2 (+ colon 3)))))
(defun whitespace-p (c) (member c '(#\Space #\Tab #\Return #\Newline)))
(defun exact-origin (block names)
  (let* ((newline (position #\Newline block)) (head (subseq block 0 newline)))
    (when (numbered-frame-p head)
      (let* ((start (+ 3 (position #\: head)))
             (end (position-if (lambda (c) (or (whitespace-p c) (char= c #\)))) block :start start))
             (close (and end (position-if-not #'whitespace-p block :start end))))
        (when (and end close (char= #\) (char block close))
                   (member (subseq block start end) names :test #'string=)
                   (every #'whitespace-p (subseq block (1+ close))))
          (list :function (subseq block start end) :frame head))))))
(defun strict-origins (rows names)
  "Recheck actual numbered blocks, excluding marker-looking lines inside quoted strings."
  (let ((blocks nil) (block nil) (quoted nil) (escaped nil) (start nil))
    (labels ((finish ()
               (when block
                 (let* ((text (format nil "~{~A~%~}" (reverse block))) (origin (exact-origin text names)))
                   (when origin (push (append (list :offset start) origin) blocks))))))
      (dolist (row rows)
        (let ((line (second row)))
          (when (and (not quoted) (numbered-frame-p line))
            (finish) (setf block nil start (first row) escaped nil quoted nil))
          (when (or block (numbered-frame-p line))
            (push line block)
            (loop for c across line
                  do (cond (escaped (setf escaped nil))
                           ((and quoted (char= c #\\)) (setf escaped t))
                           ((char= c #\") (setf quoted (not quoted))))))))
      (finish))
    (nreverse blocks)))
(defun nominal-functions ()
  (loop for path in '("tests/codec/cbor-map-write.lisp" "tests/codec/cbor-map-write-threads.lisp")
        append (loop for row in (line-rows (read-text path)) for line = (second row)
                     when (and (>= (length line) 9) (string-equal "(deftest " line :end2 9))
                       collect (concatenate 'string "ARCDOCDB.CBOR.MAP.WRITE.TESTS::"
                                            (string-upcase (subseq line 9 (position-if #'whitespace-p line :start 9)))))))
(defun patched-text (source before after)
  (let ((position (search before source)))
    (check (and position (not (search before source :start2 (1+ position)))) :unique-exact-before)
    (concatenate 'string (subseq source 0 position) after (subseq source (+ position (length before))))))
(defun copied-source-names (root)
  (append '("arcdocdb.asd" "tools/build.lisp")
          (sort (mapcar (lambda (path) (enough-namestring path root))
                        (append (directory (merge-pathnames "src/**/*.lisp" root))
                                (directory (merge-pathnames "tests/**/*.lisp" root)))) #'string<)))
(defun check-private-copy (child source-names originals target)
  (let* ((root (truename child)) (root-name (namestring root))
         (cache (truename (merge-pathnames "fasl/" root)))
         (runner (merge-pathnames "tools/cbor-map-write-isolated-build.lisp" root))
         (text (read-text runner)) (changed 0))
    (check (equal source-names (copied-source-names root)) :exact-copy-source-inventory)
    (check (prefixp root-name (namestring cache)) :private-cache-root)
    (check (and (search root-name text) (search (namestring cache) text)
                (search ":IGNORE-INHERITED-CONFIGURATION" text)
                (search "(LOAD \"tools/build.lisp\")" text)) :private-runner-translations)
    (dolist (source source-names)
      (let* ((path (merge-pathnames source root)) (actual (bytes path))
             (original (gethash source originals)))
        (check (prefixp root-name (namestring (truename path))) :source-within-copy)
        (if (and target (string= source (getf target :source-file)))
            (let ((expected (sb-ext:string-to-octets
                             (patched-text (read-text source) (getf target :before) (getf target :after))
                             :external-format :utf-8 :null-terminate nil)))
              (check (not (equalp actual original)) :mutant-changed)
              (check (equalp actual expected) :only-exact-patch)
              (incf changed))
            (check (equalp actual original) :unmodified-copy-source))))
    (check (= changed (if target 1 0)) :one-or-zero-copy-differences)
    (list :copy root-name :source-count (length source-names) :byte-compared-all t
          :modified-files changed :cache (namestring cache) :runner (namestring runner))))
(let* ((report-path (concatenate 'string *base* "report.lisp"))
       (wrapper (plist-check (arcdocdb.evidence:read-evidence *wrapper*)))
       (data (plist-check (arcdocdb.evidence:read-evidence report-path)))
       (catalogue (plist-check (arcdocdb.evidence:read-evidence *catalogue*)))
       (env (plist-check (getf wrapper :environment)))
       (outer-before (inventory (getf wrapper :source-blobs-before) :path :git-blob))
       (outer-after (inventory (getf wrapper :source-blobs-after) :path :git-blob))
       (inner-before (inventory (getf data :source-fingerprints-before) :file :md5))
       (inner-after (inventory (getf data :source-fingerprints-after) :file :md5))
       (targets (getf catalogue :targets)) (mutants (getf data :mutants))
       (names (nominal-functions)) (baseline (plist-check (getf data :baseline)))
       (baseline-log (getf baseline :log)) (baseline-text (read-text baseline-log))
       (baseline-rows (line-rows baseline-text))
       (source-names (append '("arcdocdb.asd" "tools/build.lisp")
                             (sort (loop for path being the hash-keys of inner-before
                                         when (or (prefixp "src/" path) (prefixp "tests/" path)) collect path) #'string<)))
       (originals (make-hash-table :test 'equal))
       (copy-observations nil) (log-observations nil)
       (paths (append (list *wrapper* report-path *catalogue* *driver* "tools/evidence-storage.lisp" baseline-log)
                      (mapcar (lambda (entry) (getf entry :log)) mutants)
                      (loop for id from 0 below 8
                            collect (concatenate 'string *base* (write-to-string id) "/tools/cbor-map-write-isolated-build.lisp"))
                      (list (concatenate 'string *base* "baseline/tools/cbor-map-write-isolated-build.lisp"))
                      (loop for target in targets for id from 0
                            collect (concatenate 'string *base* (write-to-string id) "/" (getf target :source-file)))))
       (physical-before (mapcar #'observation paths))
       (source-pins-before (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*)))
  (check (and (eql 1 (getf wrapper :schema-version)) (eq :command-verification (getf wrapper :kind))
              (eq :ok (getf wrapper :status)) (eql 0 (getf wrapper :exit-code))
              (eq :stable (getf wrapper :source-consistency)) (zerop (length (getf wrapper :stderr)))
              (equal (getf wrapper :source-blobs-before) (getf wrapper :source-blobs-after))
              (= 860 (hash-table-count outer-before) (hash-table-count outer-after))) :outer-completed)
  (check (and (string= "15c458eff76896f3fc83ad7756ae922f64eb22d7" (getf env :commit))
              (string= "" (getf env :working-tree))) :head-clean)
  (check (equal '("sbcl" "--noinform" "--no-userinit" "--no-sysinit" "--script"
                 "spikes/out/cbor-map-write-20261014/drivers/mutation.lisp" "--run" "spikes/out/cbor-map-write-20261014/mutations/")
                (getf wrapper :command)) :exact-mutation-command)
  (check (equal (first physical-before) (list *wrapper* 271126 "e34228e309d3c9a84783463aa7dc52d434d6f14c275e683e4cc8efacd3ea6df7")) :explicit-wrapper-bytes)
  (check (equal (second physical-before) (list report-path 89577 "ef351ac47b9db191ad526695c30f7b46a716207290aeafd7093811b2852c588c")) :explicit-inner-bytes)
  (check (string= "1a6dca65f9136e082eb9d621305da4fad324534e" (git-blob *catalogue*)) :catalogue-pin)
  (check (string= "3cf825435c4a5b0bd30b235a236b05d610a2302f" (git-blob *driver*)) :driver-pin)
  (check (string= "fa2b5d36dca0837e2ed5e49b282887b2e110b2b7" (git-blob "tools/evidence-storage.lisp")) :trusted-reader-pin)
  (check (equal source-pins-before *pins*) :physical-five-pins)
  (dolist (pin *pins*)
    (check (and (equal (second pin) (gethash (first pin) outer-before))
                (equal (second pin) (gethash (first pin) outer-after))) :outer-five-pins))
  (check (and (eql 1 (getf data :schema-version)) (eq :cbor-map-write-mutations (getf data :kind))
              (eq :ok (getf data :status)) (zerop (getf data :worker-errors))
              (eq :stable (getf data :source-consistency))
              (equal (getf data :source-fingerprints-before) (getf data :source-fingerprints-after))
              (= (hash-table-count inner-before) (hash-table-count inner-after))) :inner-completed)
  (let* ((stdout (getf wrapper :stdout)) (start (search "(:SOURCE-CONSISTENCY" stdout)))
    (check (and start (equal data (read-one-string (subseq stdout start)))) :embedded-and-saved-inner-agree))
  (check (and (= 20 (length names) (length (remove-duplicates names :test #'string=)))
              (equal names (getf catalogue :frozen-def-test-functions))
              (equal names (getf data :corpus-frame-functions))) :twenty-real-corpus-names)
  (check (and (= 8 (length mutants) (length targets))
              (equal *names* (mapcar (lambda (target) (getf target :name)) targets))
              (equal *names* (mapcar (lambda (entry) (getf entry :name)) mutants))
              (equal (getf data :targets)
                     (mapcar (lambda (target) (list :source-file (getf target :source-file) :name (getf target :name)
                                                  :before (getf target :before) :after (getf target :after))) targets))) :exact-eight-targets)
  (check (and (eq :ok (getf baseline :status)) (eq :ok (getf baseline :result))
              (eql 0 (getf baseline :exit-code)) (null (getf baseline :signal))
              (null (getf baseline :diagnostic)) (warning-free baseline-text)) :baseline-metadata)
  (let ((smoke (marker baseline-rows "ok    ARCDOCDB:*VERSION* è una stringa"))
        (completion (marker baseline-rows "build e test: nessun avviso, tutti i controlli superati")))
    (check (and smoke completion (< smoke completion)
                (= 1 (count "build e test: nessun avviso, tutti i controlli superati" baseline-rows :key #'second :test #'string=))
                (= 1284 (count-if (lambda (row) (prefixp "ok    TEST-" (second row))) baseline-rows))
                (= 1286 (count-if (lambda (row) (prefixp "ok    " (second row))) baseline-rows))
                (= 1 (count "ok    package ARCDOCDB presente" baseline-rows :key #'second :test #'string=))
                (not (find-if (lambda (row) (prefixp "Unhandled " (second row))) baseline-rows))) :full-baseline-log))
  (format t "WRAPPER OK exit0 STABLE sources860 HEAD~A wall~S; inner OK worker0 before/after-files~D; baseline1284+2 complete.~%"
          (getf env :commit) (getf wrapper :wall-seconds) (hash-table-count inner-before))
  (loop for entry in mutants for id from 0
        do (plist-check entry)
           (let* ((text (read-text (getf entry :log))) (rows (line-rows text))
                  (smoke (marker rows "ok    ARCDOCDB:*VERSION* è una stringa"))
                  (unhandled (find-if (lambda (row) (prefixp "Unhandled " (second row))) rows))
                  (completion (marker rows "build e test: nessun avviso, tutti i controlli superati"))
                  (origins (and unhandled (strict-origins (remove-if (lambda (row) (< (first row) (first unhandled))) rows) names))))
             (check (and (eq :detected (getf entry :result)) (eq t (getf entry :detected))
                         (eql 1 (getf entry :exit-code)) (null (getf entry :signal)) (null (getf entry :diagnostic))) :detected-metadata)
             (check (string= (namestring (truename (concatenate 'string *base* (write-to-string id) "/test.log")))
                            (getf entry :log)) :expected-child-log)
             (check (and (warning-free text) smoke unhandled (< smoke (first unhandled))
                         (null completion) origins
                         (every (lambda (origin) (< (first unhandled) (getf origin :offset))) origins)) :strict-detected-log)
             (let ((observation (list :name (getf entry :name) :exit-code 1 :signal nil
                                      :smoke smoke :unhandled (first unhandled) :exact-origins origins)))
               (push observation log-observations) (format t "DETECTED ~S~%" observation))))
  (dolist (source source-names) (setf (gethash source originals) (bytes source)))
  (push (check-private-copy (concatenate 'string *base* "baseline/") source-names originals nil) copy-observations)
  (loop for target in targets for id from 0
        do (push (check-private-copy (concatenate 'string *base* (write-to-string id) "/") source-names originals target)
                 copy-observations))
  (setf copy-observations (nreverse copy-observations))
  (check (= 9 (length (remove-duplicates (mapcar (lambda (entry) (getf entry :cache)) copy-observations) :test #'string=))) :nine-private-caches)
  (let ((extra (read-text (concatenate 'string *base* "7/src/codec/cbor-map-write.lisp"))))
    (check (and (search "(values index null &optional)) scrivi-mappa-cbor-minima" extra)
                (search "(values result nil)" extra)
                (not (search "(values index &optional)) scrivi-mappa-cbor-minima" extra))) :extra-nil-ftype-and-body-coherent))
  (dolist (source source-names) (check (equalp (gethash source originals) (bytes source)) :all-original-sources-unchanged))
  (check (equal source-pins-before (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*)) :five-pins-after)
  (check (equal physical-before (mapcar #'observation paths)) :selected-inputs-physical-before-after)
  (format t "COPIES ~S~%FIVE-PINS ~S~%PHYSICAL-OBSERVATIONS ~S~%DATA READING PASS checks~D;8 strict detected,9 private copies, all~D copied files compared per copy, exact8patches. No SHA sweep of all copies; no product/driver run, LOAD or compile; no authenticity or exclusive-cause proof.~%"
          copy-observations *pins* physical-before *checks* (length source-names)))
