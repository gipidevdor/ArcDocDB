(require :asdf)
(let ((old "spikes/out/cbor-map-write-20261014/")
      (new "spikes/out/cbor-tag-write-20261014/"))
  (flet ((replace-all (text old new)
           (with-output-to-string (out)
             (loop with start = 0 for at = (search old text :start2 start)
                   do (if at (progn (write-string text out :start start :end at)
                                    (write-string new out) (setf start (+ at (length old))))
                          (progn (write-string text out :start start) (return)))))))
    (dolist (name '("freeze-sources.lisp" "collection/collect.lisp"
                    "collection/preflight-archive.lisp" "collection/append.lisp"
                    "collection/read-collection.lisp" "collection/build-manifest.lisp"))
      (let* ((source (concatenate 'string old name))
             (target (concatenate 'string new name))
             (text (uiop:read-file-string source :external-format :utf-8))
             (adapted (if (member name '("freeze-sources.lisp" "collection/build-manifest.lisp")
                                :test #'equal)
                          (replace-all (replace-all text "cbor-map" "cbor-tag")
                                       "CBOR-MAP" "CBOR-TAG") text)))
        (assert (not (probe-file target)))
        (ensure-directories-exist target)
        (with-open-file (out target :direction :output :if-exists :error :external-format :utf-8)
          (write-string adapted out))
        (format t "~A~%" target))))))
