(require :asdf)
(defparameter *base* "spikes/out/cbor-tag-write-20261014/drivers/")
(defun blob (path)
  (string-trim '(#\Newline #\Return)
    (uiop:run-program (list "git" "hash-object" path) :output :string)))
(let* ((*read-eval* nil) (*readtable* (copy-readtable nil)) (eof (gensym "EOF"))
       (data (with-open-file (in (concatenate 'string *base* "catalogue-materialized.lisp"))
               (let ((form (read in t nil))) (assert (eq eof (read in nil eof))) form)))
       (pins (getf data :source-files)) (entries nil))
  (dolist (pin pins) (assert (string= (second pin) (blob (first pin)))))
  (dolist (mutation (getf data :unique-source-substitutions))
    (destructuring-bind (source name before after) mutation
      (let* ((text (uiop:read-file-string source :external-format :utf-8))
             (pos (search before text))
             (target (concatenate 'string *base* "target-diffs/" name ".after.lisp.txt"))
             (patch (concatenate 'string *base* "target-diffs/" name ".patch")))
        (assert (and pos (not (search before text :start2 (1+ pos)))))
        (ensure-directories-exist target)
        (with-open-file (out target :direction :output :if-exists :error :if-does-not-exist :create
                                    :external-format :utf-8)
          (write-string text out :end pos) (write-string after out)
          (write-string text out :start (+ pos (length before))))
        (multiple-value-bind (stdout stderr exit)
            (uiop:run-program (list "git" "diff" "--no-index" "--" source target)
                              :output :string :error-output :string :ignore-error-status t)
          (assert (and (= 1 exit) (zerop (length stderr)) (plusp (length stdout))))
          (with-open-file (out patch :direction :output :if-exists :error :if-does-not-exist :create)
            (write-string stdout out)))
        (push (list :name name :original source :source-blob (blob source)
                    :after target :after-blob (blob target) :patch patch :patch-blob (blob patch)
                    :replacement-count 1 :compiled nil :loaded nil) entries))))
  (dolist (pin pins) (assert (string= (second pin) (blob (first pin)))))
  (let ((*print-readably* t))
    (write (list :schema-version 1 :kind :cbor-tag-static-target-diffs :status :ok
                 :source-files pins :materialized-catalogue-blob
                 (blob (concatenate 'string *base* "catalogue-materialized.lisp"))
                 :mutants (nreverse entries) :product-files-written nil
                 :no-corpus-bodies-read t :campaign-executed nil) :pretty t) (terpri)))
