;;;; Read helper syntax and completed records as DATA; never run the helper or builder.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((helper "spikes/out/cbor-tag-write-20261014/collection/prepare-archive.lisp")
       (base "spikes/out/cbor-tag-write-20261014/")
       (*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
       (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym "EOF"))
       (before (list (arcdocdb.evidence:file-bytes helper) (arcdocdb.evidence:file-sha256 helper)))
       (forms (with-open-file (in helper :external-format :utf-8)
                (loop for form = (read in nil eof) until (eq form eof) collect form)))
       (bindings (second (car (last forms))))
       (processes (second (second (assoc 'processes bindings))))
       (trees (second (second (assoc 'trees bindings))))
       (external-trees '(("integrated-spikes" "spikes/out/4000997101-check-82864-0/" "lisp-and-log")
                         ("snapshot-self-test" "spikes/out/4000996874-snapshot-self-test-69641-0/" "all")
                         ("reader-self-test" "spikes/out/4000996874-reader-self-test-69697-0/" "all")))
       (tree-paths (append (mapcar (lambda (entry) (concatenate 'string base (second entry))) trees)
                           (mapcar #'second external-trees)))
       (all-references nil) (missing-references nil) (records nil) (failed-count 0)
       (mutation-files nil))
  (assert (= 2 (length forms)))
  (assert (= 14 (length processes)))
  (assert (= 5 (length trees)))
  (labels ((references (text)
             ;; Same literal selection rule as the separately reviewed builder, not its code.
             (let ((cursor 0) (result nil) (prefix "spikes/out/")
                   (worker-prefix "spikes/out/cbor-tag-write-20261014/drivers/selftests/"))
               (loop for start = (search prefix text :start2 cursor) while start
                     for stem-start = (+ start (length prefix))
                     for slash = (position #\/ text :start stem-start)
                     do (setf cursor (+ start (length prefix)))
                        (when slash
                          (let* ((stem (subseq text stem-start slash))
                                 (worker-p (and (<= (+ start (length worker-prefix)) (length text))
                                                (string= worker-prefix text :start2 start
                                                         :end2 (+ start (length worker-prefix)))))
                                 (end (if worker-p (position #\/ text :start (+ start (length worker-prefix))) slash)))
                            (when (and end (or worker-p (search "-snapshot-self-test-" stem)
                                               (search "-reader-self-test-" stem)
                                               (search "-cbor-tag-write-worker-self-test-" stem)))
                              (pushnew (subseq text start (1+ end)) result :test #'string=)))))
               (sort result #'string<))))
    (dolist (entry processes)
      (let* ((path (concatenate 'string "spikes/out/" (second entry) "/report.lisp"))
             (bytes (arcdocdb.evidence:file-bytes path))
             (sha (arcdocdb.evidence:file-sha256 path))
             (data (arcdocdb.evidence:read-evidence path :max-expanded-bytes 67108864))
             (refs (references (getf data :stdout))))
        (assert (and (eq :command-verification (getf data :kind))
                     (member (getf data :status) '(:ok :failed))
                     (integerp (getf data :exit-code)) (integerp (getf data :finished-at-universal-time))))
        (when (eq :failed (getf data :status)) (incf failed-count))
        (dolist (ref refs)
          (pushnew ref all-references :test #'string=)
          (unless (and (probe-file ref)
                       (some (lambda (tree) (uiop:subpathp (truename ref) (truename tree))) tree-paths))
            (pushnew ref missing-references :test #'string=)))
        (assert (= bytes (arcdocdb.evidence:file-bytes path)))
        (assert (equal sha (arcdocdb.evidence:file-sha256 path)))
        (push (list :label (first entry) :path path :status (getf data :status)
                    :exit-code (getf data :exit-code) :source-consistency (getf data :source-consistency)
                    :bytes bytes :sha256 sha :references refs) records)))
    (dolist (tree tree-paths) (assert (probe-file tree)))
    (dolist (copy '("baseline" "0" "1" "2" "3" "4" "5" "6" "7"))
      (dolist (relative '("test.log" "arcdocdb.asd" "tools/build.lisp"
                          "tools/cbor-tag-write-isolated-build.lisp"
                          "src/codec/cbor-tag-input.lisp" "src/codec/cbor-tag-write.lisp"
                          "tests/codec/cbor-tag-write-support.lisp"
                          "tests/codec/cbor-tag-write.lisp" "tests/codec/cbor-tag-write-threads.lisp"))
        (let ((path (concatenate 'string base "mutations/" copy "/" relative)))
          (assert (probe-file path))
          (push (list :path path :bytes (arcdocdb.evidence:file-bytes path)) mutation-files))))
    (assert (= 81 (length mutation-files)))
    (assert (probe-file (concatenate 'string base "mutations/report.lisp")))
    (assert (= 1 failed-count))
    (assert (not missing-references))
    (assert (equal before (list (arcdocdb.evidence:file-bytes helper) (arcdocdb.evidence:file-sha256 helper))))
    (let ((*print-readably* t))
      (write (list :schema-version 1 :kind :archive-selection-data-reading :status :ok
                   :helper-observation before :helper-forms (length forms)
                   :fixed-process-count (length processes) :fixed-processes (nreverse records)
                   :failed-preserved failed-count :integration-process-from-cli :pending-final-input
                   :tree-paths tree-paths :selftest-directories (sort all-references #'string<)
                   :missing-selftest-directories missing-references
                   :selected-mutation-files 81 :plus-mutation-report 1
                   :max-selected-mutation-plain-bytes (reduce #'max mutation-files :key (lambda (x) (getf x :bytes)))
             :pretty t)
      (terpri))))
