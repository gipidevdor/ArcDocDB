;;;; DATA-only extension: classify every missed point and enumerate all guards.
(load "spikes/out/cbor-tag-write-20261014/review/coverage-reading.lisp")
(in-package #:tag.coverage.reading)
(defun source-ancestors (path forms)
  (let* ((indices (reverse (if (keywordp (car path)) (cdr path) path)))
         (form (aref forms (first indices))) (ancestors (list form)))
    (dolist (index (rest indices) (nreverse ancestors))
      (check (and (listp form) (< index (length form))) :classification-source-bound)
      (setf form (nth index form)) (push form ancestors))))
(defun guard-p (form)
  (and (consp form) (member (car form) '(when unless))))
(defun error-p (form)
  (and (consp form) (eq (car form) 'error)))
(defun invariant-error-p (form)
  (and (error-p form) (equal (second form) '(quote arcdocdb.cbor::invariant-violation))))
(defun error-reason (form)
  (check (error-p form) :error-form)
  (getf (cddr form) :reason))
(defun path-prefix-p (prefix path)
  (and (<= (length prefix) (length path))
       (equal prefix (subseq path 0 (length prefix)))))
(defun guard-inventory (forms paths bits)
  (let ((guards nil))
    (labels ((walk (form indices owner)
               (when (consp form)
                 (when (eq (car form) 'defun) (setf owner (second form)))
                 (when (guard-p form)
                   (check (and (= 3 (length form)) (error-p (third form))) :single-error-guard)
                   (let ((direct nil) (nested nil) (predicate-path (append indices '(1))))
                     (dotimes (i (length paths))
                       (let ((path (aref paths i)))
                         (when (member (car path) '(:then :else))
                           (let ((normal (reverse (cdr path)))
                                 (entry (list i (car path) (sbit bits i))))
                             (cond ((equal normal predicate-path) (push entry direct))
                                   ((path-prefix-p predicate-path normal) (push entry nested)))))))
                     (push (list :owner owner :operator (car form) :predicate (second form)
                                 :reason (error-reason (third form)) :source-path indices
                                 :direct-branches (nreverse direct) :nested-branches (nreverse nested)) guards)))
                 (loop for child in form for index from 0 when (consp child)
                         do (walk child (append indices (list index)) owner)))))
      (loop for form across forms for top from 0 do (walk form (list top) nil)))
    (nreverse guards)))
(let* ((observations (mapcar (lambda (pin) (observation (first pin))) *physical-pins*))
       (source-blobs (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*))
       (raw (read-one-data (concatenate 'string *base* "coverage-state.lisp")))
       (rows (html-summary-rows (uiop:read-file-string (concatenate 'string *base* "cover-index.html")
                                                     :external-format :utf-8)))
       (all-counts (make-hash-table :test #'eq)) (guard-count 0) (missed-total 0)
       (*print-pretty* nil) (*print-level* nil) (*print-length* nil)
       (*package* (find-package "ARCDOCDB.CBOR")))
  (check (= 2 (count-if (lambda (row) (and (first row) (search "<a href=" (first row)))) rows))
         :exactly-two-html-source-links)
  (loop for pin in (subseq *pins* 0 2) for expected-guards in '(14 9)
        for source = (first pin)
        for entry = (assoc (namestring (truename source)) raw :test #'string=)
        for forms = (read-source-forms source)
        for paths = (cadr entry) for bits = (cddr entry)
        for guards = (guard-inventory forms paths bits)
        do (check (= expected-guards (length guards)) :all-source-guards)
           (incf guard-count (length guards))
           (dolist (guard guards) (format t "GUARD ~A ~S~%" source guard))
           (let ((counts (make-hash-table :test #'eq)) (reasons (make-hash-table :test #'eq)))
             (dotimes (index (length paths))
               (when (zerop (sbit bits index))
                 (let* ((path (aref paths index)) (ancestors (source-ancestors path forms))
                        (top (first ancestors)) (form (car (last ancestors)))
                        (branch (member (car path) '(:then :else)))
                        (guard (find-if #'guard-p (reverse ancestors)))
                        (error-form (find-if #'error-p (reverse ancestors)))
                        (category
                          (cond ((member (car top) '(in-package declaim)) :declaration)
                                ((and (not branch) (invariant-error-p error-form)) :invariant-error-expression)
                                ((and branch guard (invariant-error-p (third guard))) :invariant-branch)
                                ((and (not branch) (eq (car top) 'defun) (consp form)
                                      (member (car form) '(arcdocdb.cbor::max-bytes arcdocdb.cbor::max-nodes arcdocdb.cbor::max-depth))
                                      (= 2 (length form))) :keyword-default)
                                (t :other))))
                   (incf missed-total) (incf (gethash category counts 0)) (incf (gethash category all-counts 0))
                   (when (member category '(:invariant-error-expression :invariant-branch))
                     (push (list index (if branch :branch :expression) path form)
                           (gethash (error-reason (or error-form (third guard))) reasons)))
                   (format t "CLASSIFIED ~A record~D ~S category~S~%" source index
                           (if branch :branch :expression) category))))
             (let ((classes (sort (loop for key being the hash-keys of counts using (hash-value value)
                                       collect (list key value)) #'string< :key (lambda (entry) (symbol-name (first entry))))))
               (format t "FILE-CLASSIFICATION ~A ~S~%" source classes))
             (loop for reason being the hash-keys of reasons using (hash-value points)
                   do (format t "MISSING-REASON ~A ~S records~S~%" source reason (nreverse points)))))
  (check (= 23 guard-count) :twenty-three-guards)
  (check (= missed-total (loop for value being the hash-values of all-counts sum value)) :all-missed-classified)
  (check (equal observations (mapcar (lambda (pin) (observation (first pin))) *physical-pins*)) :classification-inputs-unchanged)
  (check (equal source-blobs (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*)) :classification-sources-unchanged)
  (format t "CLASSIFICATION TOTAL guards~D missed~D categories~S; no exclusions, other~D; no MC/DC or qualification claim.~%"
          guard-count missed-total
          (sort (loop for key being the hash-keys of all-counts using (hash-value value) collect (list key value))
                #'string< :key (lambda (entry) (symbol-name (first entry))))
          (gethash :other all-counts 0)))
