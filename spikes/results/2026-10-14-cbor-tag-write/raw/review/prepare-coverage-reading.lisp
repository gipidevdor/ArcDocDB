;;;; Prepare a DATA-only tag reader from the frozen corrected map reader.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((old "spikes/out/cbor-map-write-20261014/review/coverage-reading-2.lisp")
       (new "spikes/out/cbor-tag-write-20261014/review/coverage-reading.lisp")
       (wrapper "spikes/out/4000996908-command-74254-0/report.lisp")
       (base "spikes/out/cbor-tag-write-20261014/coverage/")
       (record (arcdocdb.evidence:read-evidence wrapper))
       (text (uiop:read-file-string old :external-format :utf-8)))
  (labels ((replace-all (source before after)
             (with-output-to-string (out)
               (loop with start = 0 for at = (search before source :start2 start)
                     do (if at (progn (write-string source out :start start :end at)
                                      (write-string after out) (setf start (+ at (length before))))
                            (progn (write-string source out :start start) (return))))))
           (change (before after)
             (assert (search before text))
             (setf text (replace-all text before after))))
    (change "cbor-map" "cbor-tag")
    (change "map.coverage.reading" "tag.coverage.reading")
    (change "Map coverage DATA" "Tag coverage DATA")
    (change "4000986074-command-71952-0" "4000996908-command-74254-0")
    (dolist (pair '(("d7a593badeb6e6b71f28dc4e80c641b07189d0b8" "6dfad07035ac8040b2aec0a455c175ea15dfd9ad")
                    ("22e814ea68e606c5bc58033c2a31e945303a9d65" "16b91fc27eabafd7ff12bfb0a56ed34208c2bd4b")
                    ("a389e51f2416437d608c4f7745b9680eca27bc60" "15978d05251705387205d6468031a701ad95ec85")
                    ("6ad0e9b5a48ba9c32c46d720f2f7f1821368d6c8" "df97950ec8d24157bb6566c7995262f7beea7742")
                    ("6a65b58ce236b92b33772e1861dbd8c1257bee13" "def870295400af2c84ca00e7a9b5cd5b747ec315")
                    ("2fb515269f85c825099af6b098f75c7e.html" "b83b0aaf801333ff25f7cd44ddf0dad7.html")
                    ("c791897292bea4a710625f49c927786c.html" "bc91342dc28410d2e55758fcb7cc59fa.html")))
      (change (first pair) (second pair)))
    (change "15c458eff76896f3fc83ad7756ae922f64eb22d7" (getf (getf record :environment) :commit))
    (let* ((start (search "(defparameter *physical-pins*" text))
           (end (search "(defun check" text :start2 start))
           (paths (cons wrapper (mapcar (lambda (leaf) (concatenate 'string base leaf))
                                       '("coverage-state.lisp" "cover-index.html"
                                         "b83b0aaf801333ff25f7cd44ddf0dad7.html"
                                         "bc91342dc28410d2e55758fcb7cc59fa.html"))))
           (observations (mapcar (lambda (path)
                                  (list path (arcdocdb.evidence:file-bytes path)
                                        (arcdocdb.evidence:file-sha256 path))) paths))
           (replacement (with-output-to-string (out)
                          (let ((*print-readably* t))
                            (write `(defparameter *physical-pins* ',observations) :stream out :pretty t)
                            (terpri out)))))
      (assert (and start end))
      (setf text (concatenate 'string (subseq text 0 start) replacement (subseq text end))))
    (change "(check (and (= (hash-table-count before) (hash-table-count after)) (zerop (length (getf record :stderr)))) :inventory-and-stderr)"
            "(check (= (hash-table-count before) (hash-table-count after)) :inventory-count)
  (check (stringp (getf record :stderr)) :stderr-string)
  (dolist (marker '(\"WARNING:\" \"STYLE-WARNING:\" \"Unhandled \" \"compilation aborted\" \"COMPILE-FILE-ERROR\"))
    (check (not (search marker (getf record :stderr) :test #'char-equal)) :no-warning-or-compile-failure))")
    (change "wall~S stderr0 scope" "wall~S stderr-chars~D scope")
    (change "(hash-table-count before) (getf record :wall-seconds) (getf record :stdout))"
            "(hash-table-count before) (getf record :wall-seconds) (length (getf record :stderr)) (getf record :stdout))")
    (change "Derived from frozen array coverage reader 3f1828f9f240424ac87e3d9b220acdc93ff61c8b."
            "Derived from corrected map DATA reader b737d1220b84f125cf54b7f199762b60322d4bcf; paths/pins and stderr policy adapted.")
    (assert (not (probe-file new)))
    (with-open-file (out new :direction :output :if-exists :error :external-format :utf-8)
      (write-string text out))
    (format t "Prepared DATA-only reader ~A, HEAD ~A, stderr characters ~D.~%"
            new (getf (getf record :environment) :commit) (length (getf record :stderr)))))
