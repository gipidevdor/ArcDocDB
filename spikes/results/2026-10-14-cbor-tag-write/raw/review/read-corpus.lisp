;;;; Lettura delle nuove forme solo come DATA; nessun LOAD, EVAL o COMPILE.
(dolist (name '("ARCDOCDB.CBOR" "ARCDOCDB.CBOR.MINIMAL.SCAN.TESTS"))
  (unless (find-package name) (make-package name :use '("CL"))))
(dolist (name '("SCRIVI-TAG-CBOR-MINIMO" "CREA-SPAZIO-CBOR" "VERIFICA-STRUTTURA-CBOR-MINIMA"))
  (export (intern name "ARCDOCDB.CBOR") "ARCDOCDB.CBOR"))
(let ((*read-eval* nil) (names nil) (counts nil))
  (dolist (path '("tests/codec/cbor-tag-write-support.lisp"
                  "tests/codec/cbor-tag-write.lisp" "tests/codec/cbor-tag-write-threads.lisp"))
    (with-open-file (in path)
      (let ((sentinel (list :eof)) (forms 0))
        (loop for form = (read in nil sentinel) until (eq form sentinel)
              do (incf forms)
                 (when (and (consp form) (symbolp (first form))
                            (string= "DEFTEST" (symbol-name (first form))))
                   (assert (not (member (second form) names)))
                   (push (second form) names)))
        (push (list path forms :eof t) counts))))
  (assert (= 20 (length names)))
  (format t "~S~%" (list :status :ok :read-eval nil :files (reverse counts)
                         :nominals (length names) :unique t :names (reverse names))))
(let ((state #x54414737))
  (dotimes (i 1024) (setf state (logand #xffffffff (+ (* state 1664525) 1013904223))))
  (assert (= state #xf8004b37))
  (format t "SEED-FINAL ~X~%" state))
(dolist (prefix '(3 7))
  (let* ((end (+ prefix 10)) (b (make-array (+ end 7) :element-type '(unsigned-byte 8))))
    (dotimes (i (length b)) (setf (aref b i) (mod (+ #xa7 (* i 37)) 256)))
    (replace b '(#xd9 #xd9 #xf7 #xc0 #xa1 #x61 #x61 #x82 #xf4 #xf5) :start1 prefix)
    (let ((token (+ end (loop for i below (length b) sum (* (1+ i) (aref b i))))))
      (assert (= token (if (= prefix 3) 32601 47515)))
      (format t "PREFIX ~D NEXT ~D LENGTH ~D TOKEN ~D SINK ~D~%"
              prefix end (length b) token (* 2048 token)))))
