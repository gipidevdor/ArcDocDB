;;;; Le nuove forme restano DATA: nessun LOAD, EVAL o COMPILE del prodotto.
(unless (find-package "ARCDOCDB.CONDITIONS")
  (make-package "ARCDOCDB.CONDITIONS" :use '("CL")))
(export (intern "RESOURCE-EXHAUSTED" "ARCDOCDB.CONDITIONS") "ARCDOCDB.CONDITIONS")
(defun review-node-name-p (form names)
  (and (consp form) (symbolp (car form))
       (member (symbol-name (car form)) names :test #'string=)))
(defun review-count (form names)
  (if (atom form) 0
      (+ (if (review-node-name-p form names) 1 0)
         (reduce #'+ form :key (lambda (item) (review-count item names)) :initial-value 0))))
(defun review-extra-operands (form)
  (if (atom form) 0
      (+ (if (review-node-name-p form '("AND" "OR")) (- (length form) 2) 0)
         (reduce #'+ form :key #'review-extra-operands :initial-value 0))))
(defun review-chains (form)
  (if (atom form) nil
      (append (when (and (review-node-name-p form '("<=" "<" "=" ">=" ">"))
                         (> (length form) 3)) (list form))
              (mapcan #'review-chains form))))
(let ((*read-eval* nil) (functions 0) (guards 0) (compound 0) (operands 0)
      (numeric-chains 0) (relations 0))
  (dolist (path '("src/codec/cbor-tag-input.lisp" "src/codec/cbor-tag-write.lisp"))
    (with-open-file (in path)
      (let ((sentinel (list :eof)) (forms 0))
        (loop for form = (read in nil sentinel) until (eq form sentinel)
              do (incf forms)
                 (when (review-node-name-p form '("DEFUN"))
                   (let* ((g (review-count form '("WHEN" "UNLESS")))
                          (c (review-count form '("AND" "OR")))
                          (extra (review-extra-operands form)) (chains (review-chains form))
                          (errors (review-count form '("ERROR"))))
                     (assert (= g errors))
                     (assert (zerop (review-count form '("LOOP" "DOTIMES" "DOLIST" "IF" "COND" "CASE"))))
                     (incf functions) (incf guards g) (incf compound c) (incf operands (+ c extra))
                     (incf numeric-chains (length chains))
                     (incf relations (reduce #'+ chains :key (lambda (chain) (- (length chain) 2))
                                             :initial-value 0))
                     (format t "~S~%" (list :function (second form) :guards g :errors errors
                                            :compound c :operands (+ c extra)
                                            :paths (+ 1 g extra) :numeric-chains chains)))))
        (format t "FILE ~A FORMS ~D EOF T~%" path forms))))
  (assert (= functions 6)) (assert (= guards 23)) (assert (= compound 5))
  (assert (= operands 11)) (assert (= numeric-chains 2)) (assert (= relations 4))
  (format t "~S~%" (list :status :ok :read-eval nil :functions functions :guards guards
                         :and-or compound :operands operands :numeric-chains numeric-chains
                         :chain-relations relations :new-loops 0)))
