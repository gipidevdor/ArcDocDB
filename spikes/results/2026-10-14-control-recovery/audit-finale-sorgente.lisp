(:SCHEMA-VERSION 1 :KIND :SOURCE-SUPPORT :LANGUAGE :COMMON-LISP :TEXT
 "(require :asdf)
(defun read-data (path)
  (let ((*read-eval* nil)) (with-open-file (stream path) (read stream))))
(defun save-data (path data)
  (with-open-file (stream path :direction :output :if-exists :error)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream))))
(defun digest (path)
  (subseq (uiop:run-program (list \"shasum\" \"-a\" \"256\" (namestring path)) :output :string) 0 64))
(defun bytes (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8)) (file-length stream)))
(let* ((root (truename \"./\")) (base (merge-pathnames \"spikes/results/2026-10-14-control-recovery/\" root))
       (catalog (merge-pathnames \"catalogo.lisp\" base)) (data (read-data catalog)) (pairs nil)
       (expected (* 2 (count-if (lambda (entry) (getf entry :process-artifact)) (getf data :entries)))))
  (unless (plusp expected) (error \"Nessun record da conservare\"))
  (dolist (entry (getf data :entries))
    (when (getf entry :process-artifact)
      (let* ((sidecar (read-data (merge-pathnames (getf entry :process-artifact) base)))
             (source (pathname (second (member \"--root\" (getf sidecar :command) :test #'equal)))))
        (unless (uiop:string-prefix-p (namestring (merge-pathnames \"spikes/out/\" root)) (namestring source))
          (error \"Origine fuori dall'ambito della conservazione\"))
        (dolist (spec (list (list \"report.lisp\" (getf entry :artifact))
                           (list \"conservazione.lisp\" (getf entry :process-artifact))))
          (let* ((original (merge-pathnames (first spec) source))
                 (retained (merge-pathnames (second spec) base)) (hash (digest original)))
            (unless (and (= (bytes original) (bytes retained)) (equal hash (digest retained)))
              (error \"Byte discordi: ~A\" retained))
            (push (list :source (enough-namestring original root) :retained (second spec)
                        :bytes (bytes retained) :sha256 hash) pairs))))))
  (setf pairs (nreverse pairs))
  (unless (= (length pairs) expected) (error \"Conteggio della conservazione incompleto\"))
  (save-data (merge-pathnames \"audit-finale-byte.lisp\" base)
             (list :schema-version 1 :kind :byte-retention-audit :date \"2026-10-14\"
                   :status :ok :checked-files (length pairs) :entries pairs
                   :qualification nil :limits '(:byte-retention-only :no-product-function-execution)))
  (save-data (merge-pathnames \"audit-finale-sorgente.lisp\" base)
             (list :schema-version 1 :kind :source-support :language :common-lisp
                   :text (uiop:read-file-string *load-truename*)
                   :limits '(:filesystem-only :no-product-function-execution)))
  (setf (getf data :entries)
        (append (getf data :entries)
                '((:kind :byte-retention-audit :artifact \"audit-finale-byte.lisp\" :variant :original-byte-comparison)
                  (:kind :source-support :artifact \"audit-finale-sorgente.lisp\" :variant :verbatim-source-text))))
  (with-open-file (stream catalog :direction :output :if-exists :supersede)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream)))
  (format t \"~D file originali e copie: stessi byte e SHA256.~%\" (length pairs)))
"
 :LIMITS (:FILESYSTEM-ONLY :NO-PRODUCT-FUNCTION-EXECUTION))
