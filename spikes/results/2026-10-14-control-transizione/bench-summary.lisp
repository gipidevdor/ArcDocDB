;;;; C4: conteggi e mediane dalle 216 finestre complete; nessun prodotto eseguito.
;;; REQ: REQ-VAL-001 REQ-AFF-012
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun demand (truth detail) (unless truth (error "bench-summary COD-61: ~A" detail)))
(defun median (values)
  (demand (and values (oddp (length values))) "campione dispari non vuoto")
  (nth (floor (length values) 2) (sort (copy-list values) #'<)))
(defun cells ()
  (loop for v in '(1 2) append (loop for c in '(0 16 256) append
    (loop for o in '(0 4) append (loop for regime in '(:fixnum :high-u64) append
      (loop for w in '(1 2 4) collect (list v c o (if (zerop c) 0 4) regime w)))))))
(defun units (cell) (+ 2 (* (second cell) (1+ (third cell))) (fourth cell)))
(defun complete-producer-p (r)
  (and (eq :command-verification (getf r :kind)) (eq :ok (getf r :status))
       (eql 0 (getf r :exit-code)) (eq :stable (getf r :source-consistency))
       (integerp (getf r :finished-at-universal-time))))
(defun check-window (window cell)
  (let* ((workers (sixth cell)) (records (getf window :workers))
         (n (ceiling 10000 (* workers (units cell))))
         (guards (* workers n)) (ops (getf window :operation-counts)))
    (demand (and (eq :ok (getf window :status)) (eq t (getf window :quiescent))
                 (eq :ok (getf window :oracle)) (null (getf window :error-kind))
                 (= workers (length records)) (= n (getf window :repetitions))
                 (= guards (getf ops :guards)) (= (* guards (units cell)) (getf ops :logical-lookups))
                 (<= 0 (getf window :wall-ns)) (<= 0 (getf window :bytes-consed))) "finestra completa")
    (demand (= workers (length (remove-duplicates records :key (lambda (r) (getf r :series)))))
            "identita worker uniche")
    (loop for r in records for id from 0 do
      (demand (and (= id (getf r :id)) (eq t (getf r :done)) (null (getf r :error-kind))
                   (= 32 (getf r :warmup)) (= n (getf r :attempted) (getf r :completed) (getf r :verify0))
                   (zerop (getf r :nonempty)) (= (/ (* n (1+ n)) 2) (getf r :sink))
                   (<= 0 (getf r :cpu-ns)) (<= 0 (getf r :wall-ns))) "contatori worker"))
    guards))
(defun summarize (bench producer inputs)
  (demand (complete-producer-p producer) "produttore stabile riuscito concluso")
  (demand (and (eq :control-transition-c4 (getf bench :kind)) (eq :ok (getf bench :status))
               (eq t (getf bench :quiescent)) (null (getf bench :deadline-expired))
               (= 216 (getf bench :expected-windows))
               (eq :stable (getf bench :source-consistency))
               (getf bench :source-sha256-before)
               (equal (getf bench :source-sha256-before) (getf bench :source-sha256-after))
               (getf (getf bench :helper-snapshot) :copy-before-load)
               (getf (getf bench :helper-snapshot) :source-loaded-once)
               (equal (getf (getf bench :helper-snapshot) :sha256-before)
                      (getf (getf bench :helper-snapshot) :sha256-after))) "campagna completa e helper attestato")
  (let ((windows (getf bench :windows)) (rows nil) (total 0) (logical 0))
    (demand (= 216 (length windows)) "216 finestre")
    (demand (= 216 (length (remove-duplicates windows :key (lambda (w) (getf w :case)) :test #'equal)))
            "nessuna cella/replica duplicata")
    (dolist (cell (cells))
      (let* ((chosen (remove-if-not (lambda (w) (equal cell (subseq (getf w :case) 0 6))) windows))
             (rates nil) (costs nil) (heaps nil) (counts nil))
        (demand (equal '(1 2 3) (sort (mapcar (lambda (w) (seventh (getf w :case))) chosen) #'<))
                "tre repliche esatte")
        (dolist (w chosen)
          (let* ((guards (check-window w cell)) (wall (getf w :wall-ns))
                 (cpu (reduce #'+ (getf w :workers) :key (lambda (r) (getf r :cpu-ns)))))
            (incf total guards) (incf logical (* guards (units cell)))
            (push guards counts) (push (/ (float cpu 1d0) guards) costs)
            (push (getf w :bytes-consed) heaps)
            (push (when (plusp wall) (/ (* 1d9 guards) wall)) rates)))
        (push (list :cell cell :replicas 3 :guards-per-window counts
                    :guards-per-second-min (when (every #'numberp rates) (reduce #'min rates))
                    :guards-per-second-median (when (every #'numberp rates) (median rates))
                    :guards-per-second-max (when (every #'numberp rates) (reduce #'max rates))
                    :worker-cpu-ns-per-guard-median (median costs)
                    :heap-bytes-min (reduce #'min heaps) :heap-bytes-median (median heaps)
                    :heap-bytes-max (reduce #'max heaps)) rows)))
    (list :schema-version 1 :kind :control-transition-derived-results :status :ok
          :windows 216 :cells 72 :worker-records 504 :guards total :logical-lookups logical
          :rows (nreverse rows) :inputs inputs
          :limits '(:local-machine :whole-process-window-heap :cpu-includes-loop-controls
                    :aggregate-wall-includes-start-and-joins :logical-lookup-counts
                    :no-zero-heap-db-throughput-power-loss-or-mcdc-claim))))
(defun rejected (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))
(defun fixture ()
  (let ((windows nil))
    (dolist (cell (cells))
      (dotimes (replica 3)
        (let* ((workers (sixth cell)) (n (ceiling 10000 (* workers (units cell))))
               (rows (loop for id below workers collect
                         (list :id id :series (1+ id) :done t :error-kind nil :warmup 32
                               :attempted n :completed n :verify0 n :nonempty 0
                               :sink (/ (* n (1+ n)) 2) :cpu-ns (* n 5) :wall-ns (* n 6)))))
          (push (list :case (append cell (list (1+ replica))) :status :ok :quiescent t :oracle :ok
                      :error-kind nil :repetitions n :workers rows :wall-ns 1000000 :bytes-consed 16
                      :operation-counts (list :guards (* workers n)
                                             :logical-lookups (* workers n (units cell)))) windows))))
    (list :kind :control-transition-c4 :status :ok :quiescent t :deadline-expired nil
          :expected-windows 216 :source-consistency :stable
          :source-sha256-before '(frozen) :source-sha256-after '(frozen)
          :helper-snapshot '(:copy-before-load t :source-loaded-once t :sha256-before "same" :sha256-after "same")
          :windows (nreverse windows))))
(defun self-test ()
  (let* ((b (fixture)) (p '(:kind :command-verification :status :ok :exit-code 0
                           :source-consistency :stable :finished-at-universal-time 1))
         (result (summarize b p nil)))
    (demand (= 3 (median '(5 1 3))) "mediana")
    (demand (rejected (lambda () (median nil))) "vuoto")
    (demand (= 72 (length (getf result :rows))) "72 celle")
    (dolist (key '(:status :quiescent :source-consistency))
      (let ((bad (copy-tree b))) (setf (getf bad key) :bad)
        (demand (rejected (lambda () (summarize bad p nil))) "campagna non valida")))
    (let ((bad (copy-tree b))) (setf (getf bad :windows) (rest (getf bad :windows)))
      (demand (rejected (lambda () (summarize bad p nil))) "finestra mancante"))
    (let ((bad (copy-tree b))) (setf (getf (first (getf bad :windows)) :repetitions) 0)
      (demand (rejected (lambda () (summarize bad p nil))) "contatore falso"))
    (let ((bad (copy-tree p))) (setf (getf bad :source-consistency) :changed)
      (demand (rejected (lambda () (summarize b bad nil))) "produttore cambiato"))
    (write '(:schema-version 1 :kind :control-transition-summary-self-test :status :ok :checks 9)) (terpri)))
(let ((args (uiop:command-line-arguments)))
  (if (equal args '("--self-test")) (self-test)
      (progn
        (demand (= 3 (length args)) "bench producer output")
        (let* ((paths (subseq args 0 2)) (data (mapcar #'arcdocdb.evidence:read-evidence paths))
               (inputs (loop for path in paths collect
                             (list :file path :sha256 (arcdocdb.evidence:file-sha256 path))))
               (summary (summarize (first data) (second data) inputs)))
          (with-open-file (out (third args) :direction :output :if-exists :error)
            (write summary :stream out :pretty t) (terpri out))
          (write summary :pretty t) (terpri)))))
