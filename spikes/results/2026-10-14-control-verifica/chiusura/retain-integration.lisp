;;;; Conserva separatamente la verifica del grafo con mappe CBOR, senza autocertificazione.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((args (uiop:command-line-arguments))
       (base "spikes/results/2026-10-14-control-verifica/chiusura/")
       (name (first args)) (files nil))
  (unless (and (= 1 (length args)) (stringp name) (<= 1 (length name) 96)
               (every (lambda (c) (or (char<= #\0 c #\9) (char<= #\a c #\z) (char= c #\-))) name))
    (error "Integrazione COD-61: nome non locale."))
  (let* ((source (format nil "spikes/out/~A/" name))
         (target (concatenate 'string base "map-integration-check/"))
         (record (arcdocdb.evidence:read-evidence (merge-pathnames "report.lisp" source))))
    (unless (and (eq :command-verification (getf record :kind)) (eq :ok (getf record :status))
                 (eq :stable (getf record :source-consistency)) (eql 0 (getf record :exit-code))
                 (integerp (getf record :finished-at-universal-time)))
      (error "Integrazione COD-61: produttore non concluso/stabile."))
    (ensure-directories-exist (merge-pathnames "report.lisp" target))
    (dolist (leaf '("report.lisp" "report.lisp.gz" "conservazione.lisp"))
      (let ((src (merge-pathnames leaf source)) (dst (merge-pathnames leaf target)))
        (when (probe-file src)
          (unless (probe-file dst) (uiop:copy-file src dst))
          (unless (equal (arcdocdb.evidence:file-sha256 src) (arcdocdb.evidence:file-sha256 dst))
            (error "Integrazione COD-61: copia diversa."))
          (push (list :file (enough-namestring (truename dst) (truename base))
                      :bytes (arcdocdb.evidence:file-bytes dst)
                      :sha256 (arcdocdb.evidence:file-sha256 dst)) files))))
    (unless (equalp record (arcdocdb.evidence:read-evidence (merge-pathnames "report.lisp" target)))
      (error "Integrazione COD-61: record espanso diverso.")))
  (dolist (leaf '("integrazione-mappe.json" "retain-integration.lisp" "retain-integration-source.txt"))
    (let ((f (merge-pathnames leaf base)))
      (push (list :file leaf :bytes (arcdocdb.evidence:file-bytes f)
                  :sha256 (arcdocdb.evidence:file-sha256 f)) files)))
  (let ((manifest (list :schema-version 1 :kind :control-map-integration-retention :status :ok
                       :integration-head "972a963a6f33217ee921ad9f92606e89bb6b7909"
                       :producer-directory name :files (nreverse files)
                       :limits '(:local-integrity :original-context-preserved :producer-stored-separately))))
    (with-open-file (out (merge-pathnames "integrazione-mappe.lisp" base)
                        :direction :output :if-exists :error)
      (write manifest :stream out :pretty t) (terpri out))
    (write (list :schema-version 1 :kind :control-map-integration-retention :status :ok
                 :files (length files)) :pretty t) (terpri)))
