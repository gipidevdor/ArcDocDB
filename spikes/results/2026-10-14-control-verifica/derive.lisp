;;;; C4: derivazione da tre produttori chiusi e da esiti locali, nessun prodotto eseguito.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun proof-require (truth detail) (unless truth (error "derive COD-61: ~A" detail)))
(defun proof-median (values)
  (proof-require (and values (oddp (length values))) "campione dispari non vuoto")
  (nth (floor (length values) 2) (sort (copy-list values) #'<)))
(defun proof-row (windows version readers)
  (let* ((chosen (remove-if-not (lambda (w) (and (= version (getf w :version))
                                                 (= readers (getf w :readers)))) windows))
         (rates (mapcar (lambda (w) (when (plusp (getf w :seconds))
                                     (/ (getf w :count) (getf w :seconds)))) chosen))
         (heaps (mapcar (lambda (w) (getf w :heap-bytes)) chosen)))
    (proof-require (= 5 (length chosen)) "cinque repliche")
    (list :version version :readers readers :replicas 5
          :publications-per-second-min (when (every #'numberp rates) (reduce #'min rates))
          :publications-per-second-median (when (every #'numberp rates) (proof-median rates))
          :publications-per-second-max (when (every #'numberp rates) (reduce #'max rates))
          :heap-bytes-min (reduce #'min heaps) :heap-bytes-median (proof-median heaps)
          :heap-bytes-max (reduce #'max heaps))))
(defun proof-derive (bench mutations producers inputs)
  (proof-require (and (= 3 (length producers))
                       (every (lambda (r) (and (eq :command-verification (getf r :kind))
                         (eq :ok (getf r :status)) (eq :stable (getf r :source-consistency))
                         (eql 0 (getf r :exit-code)) (integerp (getf r :finished-at-universal-time)))) producers))
                 "produttori riusciti, chiusi e stabili")
  (proof-require (and (eq :ok (getf bench :status))
                      (eq :control-checkpoint-benchmark (getf bench :kind)) (= 560 (getf bench :count)))
                 "benchmark locale completo")
  (let ((windows (getf bench :windows)))
    (proof-require (and (= 30 (length windows))
                        (= 30 (length (remove-duplicates windows :test #'equal
                          :key (lambda (w) (list (getf w :version) (getf w :readers) (getf w :replica))))))
                        (every (lambda (w) (and (eq :ok (getf w :status))
                          (member (getf w :version) '(1 2)) (member (getf w :readers) '(1 2 4))
                          (<= 1 (getf w :replica) 5) (= (* 8 (getf w :readers)) (getf w :count))
                          (eq :ok (getf (getf w :readback) :status)))) windows)
                        (= 560 (reduce #'+ windows :key (lambda (w) (getf w :count)))))
                   "matrice e readback del benchmark")
    (proof-require (and (eq :ok (getf mutations :status)) (= 21 (getf mutations :test-count))
                        (eq :baseline-passed (getf (getf mutations :baseline) :result))
                        (= 4 (length (getf mutations :mutants)))
                        (every (lambda (m) (eq :detected (getf m :result))) (getf mutations :mutants)))
                   "baseline e quattro mutanti I/O rilevati")
    (list :schema-version 1 :kind :control-verifica-derived-results :status :ok
          :publications 560 :windows 30 :io-baseline-tests 21 :io-mutants-detected 4 :io-mutants-total 4
          :rows (loop for version in '(1 2) append
                      (loop for readers in '(1 2 4) collect (proof-row windows version readers)))
          :inputs inputs :limits '(:local-machine :whole-process-heap :no-db-throughput
                                   :io-mutations-only :no-zero-heap-or-power-loss-or-mcdc-qualification))))
(defun proof-rejected-p (thunk)
  (let ((rejected nil)) (handler-case (funcall thunk) (error () (setf rejected t))) rejected))
(defun proof-self-test ()
  (let* ((windows (loop for version in '(1 2) append (loop for readers in '(1 2 4) append
                    (loop for replica from 1 to 5 collect
                      (list :version version :readers readers :replica replica :status :ok
                            :count (* 8 readers) :seconds 1d0 :heap-bytes 16 :readback '(:status :ok))))))
         (bench (list :kind :control-checkpoint-benchmark :status :ok :count 560 :windows windows))
         (mutations '(:status :ok :test-count 21 :baseline (:result :baseline-passed)
                      :mutants ((:result :detected) (:result :detected) (:result :detected) (:result :detected))))
         (producers (loop repeat 3 collect '(:kind :command-verification :status :ok :source-consistency :stable
                                             :exit-code 0 :finished-at-universal-time 1)))
         (derived (proof-derive bench mutations producers nil)))
    (proof-require (= 3 (proof-median '(1 5 3))) "mediana")
    (proof-require (proof-rejected-p (lambda () (proof-median nil))) "vuoto")
    (proof-require (= 6 (length (getf derived :rows))) "sei righe")
    (let ((bad (copy-list bench))) (setf (getf bad :windows) (cons (first windows) (rest (butlast windows))))
      (proof-require (proof-rejected-p (lambda () (proof-derive bad mutations producers nil))) "duplicati"))
    (let ((bad (copy-list mutations))) (setf (getf bad :status) :failed)
      (proof-require (proof-rejected-p (lambda () (proof-derive bench bad producers nil))) "mutazioni fallite"))
    (let ((changed (copy-tree producers))) (setf (getf (first changed) :source-consistency) :changed)
      (proof-require (proof-rejected-p (lambda () (proof-derive bench mutations changed nil))) "sorgenti cambiate"))
    (let ((zero (copy-tree windows))) (setf (getf (first zero) :seconds) 0d0)
      (proof-require (null (getf (proof-row zero 1 1) :publications-per-second-median)) "clock zero"))
    (write '(:schema-version 1 :kind :control-verifica-summary-self-test :status :ok :checks 7)) (terpri)))
(defun proof-main (args)
  (proof-require (= 6 (length args)) "bench mutations bench-producer mutations-producer check output")
  (let* ((data (mapcar #'arcdocdb.evidence:read-evidence (subseq args 0 5)))
         (inputs (mapcar (lambda (f) (list :file f :sha256 (arcdocdb.evidence:file-sha256 f))) (subseq args 0 5)))
         (derived (proof-derive (first data) (second data) (subseq data 2 5) inputs)))
    (with-open-file (out (sixth args) :direction :output :if-exists :error)
      (write derived :stream out :pretty t) (terpri out))
    (write derived :pretty t) (terpri)))
(let ((args (uiop:command-line-arguments)))
  (if (equal args '("--self-test")) (proof-self-test) (proof-main args)))
