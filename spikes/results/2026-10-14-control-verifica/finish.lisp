;;;; Integra soltanto foglie esplicite della campagna; il catalogo resta auditabile.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *aev-base* "spikes/results/2026-10-14-control-verifica/")
(defparameter *aev-raw*
  '("README.md" "report.md" "revisione.json" "provenienza.json"
    "collect.lisp" "collect-source.txt" "supervise.lisp" "supervise-source.txt"
    "finish.lisp" "finish-source.txt" "derive.lisp" "derive-source.txt" "bench-attempt-A-source.txt"))
(defun aev-safe-name (name)
  (and (stringp name) (plusp (length name)) (not (find #\/ name))
       (not (find #\\ name)) (not (member name '("." "..") :test #'string=))))
(defun aev-save (record path)
  (with-open-file (out path :direction :output :if-exists :supersede)
    (let ((*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil))
      (write record :stream out :pretty t) (terpri out))))
(defun aev-integrate ()
  (let* ((path (merge-pathnames "catalogo.lisp" *aev-base*))
         (catalog (arcdocdb.evidence:read-evidence path))
         (derived (merge-pathnames "derived.lisp" *aev-base*))
         (record (arcdocdb.evidence:read-evidence derived)))
    (unless (and (eq :evidence-catalog (getf catalog :kind)) (eq :ok (getf record :status)))
      (error "AEV finish COD-61: catalogo/risultati non validi."))
    (dolist (name *aev-raw*)
      (unless (aev-safe-name name) (error "AEV finish COD-61: nome non locale."))
      (let* ((file (merge-pathnames name *aev-base*))
             (entry (list :file name :bytes (arcdocdb.evidence:file-bytes file)
                          :sha256 (arcdocdb.evidence:file-sha256 file)
                          :source (namestring (truename file)))))
        (setf (getf catalog :associated-raw-files)
              (cons entry (remove name (getf catalog :associated-raw-files)
                                  :key (lambda (e) (getf e :file)) :test #'string=)))))
    (setf (getf catalog :entries)
          (cons (list :artifact "derived.lisp" :kind (getf record :kind) :status :ok :scope :control-verifica
                      :sha256 (arcdocdb.evidence:file-sha256 derived))
                (remove "derived.lisp" (getf catalog :entries) :key (lambda (e) (getf e :artifact))
                        :test #'string=)))
    (aev-save catalog path)
    (write (list :schema-version 1 :kind :control-verifica-publication-completion :status :ok
                 :records (length (getf catalog :entries))
                 :raw-files (length (getf catalog :associated-raw-files))
                 :catalog-sha256 (arcdocdb.evidence:file-sha256 path)
                 :limits '(:local-integrity :no-catalog-authentication :explicit-leaves)) :pretty t)
    (terpri)))
(let ((args (uiop:command-line-arguments)))
  (cond ((equal args '("--self-test"))
         (unless (and (every #'aev-safe-name *aev-raw*)
                      (= (length *aev-raw*) (length (remove-duplicates *aev-raw* :test #'string=)))
                      (not (aev-safe-name "../a")) (not (aev-safe-name "a/b"))
                      (not (aev-safe-name "..")) (not (aev-safe-name "")))
           (error "AEV finish COD-60: selector errato."))
         (write '(:schema-version 1 :kind :control-verifica-publication-self-test :status :ok :checks 6)
                :pretty t) (terpri))
        ((equal args '("--finish")) (aev-integrate))
        (t (error "AEV finish COD-61: usare --self-test o --finish."))))
