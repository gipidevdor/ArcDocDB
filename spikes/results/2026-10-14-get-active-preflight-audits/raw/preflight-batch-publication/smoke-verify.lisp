(require :asdf)
(let ((expected (string-trim '(#\Newline #\Return) (uiop:run-program '("git" "rev-parse" "HEAD:tools/evidence-storage.lisp") :output :string)))
      (actual (string-trim '(#\Newline #\Return) (uiop:run-program '("git" "hash-object" "--" "tools/evidence-storage.lisp") :output :string))))
  (assert (equal expected actual))
  (load "tools/evidence-storage.lisp" :verbose nil :print nil))
(defun fp (path) (list :bytes (arcdocdb.evidence:file-bytes path) :sha256 (arcdocdb.evidence:file-sha256 path)))
(defun files-in (root)
  (labels ((walk (base)
             (loop for path in (directory (make-pathname :name :wild :type :wild :defaults base) :resolve-symlinks nil)
                   append (let ((mode (sb-posix:stat-mode (sb-posix:lstat (string-right-trim "/" (namestring path))))))
                            (cond ((sb-posix:s-isreg mode) (list (enough-namestring path root)))
                                  ((sb-posix:s-isdir mode) (walk path))
                                  (t (error "Special smoke file: ~A" path)))))))
    (sort (walk root) #'string<)))
(let* ((base (truename "spikes/out/preflight-batch-publication/"))
       (root (truename (merge-pathnames "smoke-archive-R1/" base)))
       (inputs (truename (merge-pathnames "smoke-input/" base)))
       (index (arcdocdb.evidence:read-evidence (merge-pathnames "archive-index.lisp" root)))
       (entries (getf index :files))
       (expected '(("empty.fasl" 0 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") ("large.bin" 1048593 "6e5a1570179d5f81eb048173b6abbb5d182d11867f2c406f74f41099921d246c") ("text spaced.txt" 30 "39682b30283950b8ae670136c7128faadc4549baba112773c337726b25d9c054"))))
  (assert (and (eql 1 (getf index :schema-version)) (eq :original-command-archive (getf index :kind))
               (null (getf index :processes)) (= 6 (length entries))
               (equal (sort (append '("archive-index.lisp" "catalogo.lisp")
                                    (mapcar (lambda (entry) (getf entry :path)) entries)) #'string<)
                      (files-in root))))
  (assert (equal (arcdocdb.evidence:read-evidence (merge-pathnames "smoke-manifest.lisp" base))
                 (arcdocdb.evidence:read-evidence (merge-pathnames "collection-manifest.lisp" root))))
  (dolist (entry entries)
    (assert (equal (fp (merge-pathnames (getf entry :path) root))
                   (list :bytes (getf entry :bytes) :sha256 (getf entry :sha256)))))
  (dolist (row expected)
    (destructuring-bind (name bytes sha) row
      (let* ((source (merge-pathnames name inputs))
             (entry (find (namestring source) entries :test #'equal :key (lambda (entry) (getf entry :source))))
             (compressed (eq :gzip (getf entry :codec)))
             (copy (merge-pathnames (getf entry :path) root))
             (plain (if compressed (merge-pathnames "smoke-expanded-R1.tmp" base) copy)))
        (assert entry)
        (assert (equal (fp source) (list :bytes bytes :sha256 sha)))
        (unwind-protect
             (progn
               (when compressed (uiop:run-program (list "gzip" "-d" "-c" (namestring copy)) :output plain))
               (assert (equal (fp plain) (list :bytes bytes :sha256 sha)))
               (when compressed
                 (assert (and (= bytes (getf entry :uncompressed-bytes))
                              (equal sha (getf entry :uncompressed-sha256))))))
          (when (and compressed (probe-file plain)) (delete-file plain))))))
  (format t "(:schema-version 1 :kind :three-file-batch-collector-smoke :status :ok :input-files 3 :archive-entries 6 :physical-files 8 :normal-empty-fasl-and-utf8 t :gzip-expanded-native-sha t :all-raw-copy-bytes-sha-and-exact-inventory t)~%"))
