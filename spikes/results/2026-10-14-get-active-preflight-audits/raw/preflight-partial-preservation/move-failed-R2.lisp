(require :asdf)
(require :sb-posix)
(let* ((reader "tools/evidence-storage.lisp") (library "spikes/out/preflight-batch-publication/batch-sha.lisp")
       (source "spikes/out/preflight-partial-preservation/payloads-R1/mutation-partial-unqualified.tar.gz")
       (target "spikes/out/preflight-partial-preservation-staging-R1/mutation/failed-mutation-partial-unqualified.tar.gz"))
  (flet ((git (&rest a) (string-trim '(#\Newline #\Return) (uiop:run-program (cons "git" a) :output :string))))
    (assert (equal (git "rev-parse" "8c0866711c50d047f87b9c484ce56d42a87ba19c:tools/evidence-storage.lisp")
                   (git "hash-object" reader))))
  (load reader :verbose nil :print nil)
  (assert (equal "130f428551e1aa17a946c2614db5dc14adf9ae35309ec2b21c3be5b2d59be1da"
                 (uiop:symbol-call :arcdocdb.evidence :file-sha256 library)))
  (load library :verbose nil :print nil)
  (let* ((before (first (uiop:symbol-call :preflight.batch.sha :snapshot (list source))))
         (stat-before (sb-posix:lstat source)))
    (assert (not (probe-file target)))
    (rename-file (merge-pathnames source (truename "./")) (merge-pathnames target (truename "./")))
    (let* ((after (first (uiop:symbol-call :preflight.batch.sha :snapshot (list target))))
           (stat-after (sb-posix:lstat target)))
      (assert (and (equal (getf before :sha256) (getf after :sha256))
                   (= (getf before :bytes) (getf after :bytes))
                   (= (sb-posix:stat-dev stat-before) (sb-posix:stat-dev stat-after))
                   (= (sb-posix:stat-ino stat-before) (sb-posix:stat-ino stat-after))))
      (write (list :status :ok :action :atomic-move-of-oversized-failed-payload
                   :before before :after after :dev (sb-posix:stat-dev stat-after) :ino (sb-posix:stat-ino stat-after)
                   :outside-publication-group t :qualification :failed-attempt-only) :pretty t) (terpri))))
