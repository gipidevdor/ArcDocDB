(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((root #P"spikes/out/preflight-publication-plan/"))
  (dolist (name '("core" "mutation" "bootstrap"))
    (let ((manifest (arcdocdb.evidence:read-evidence (merge-pathnames (format nil "~A-manifest.lisp" name) root)))
          (contract (arcdocdb.evidence:read-evidence (merge-pathnames (format nil "~A-contract.lisp" name) root))))
      (setf (getf manifest :files)
            (list (list "README.md" (namestring (merge-pathnames (format nil "~A-README.txt" name) root)))
                  (list "archive-contract.lisp" (namestring (merge-pathnames (format nil "~A-contract-R2.lisp" name) root)))
                  (list "publication-auditor.txt" "spikes/out/preflight-parallel-publication/audit-R3.lisp")))
      (loop for data in (list manifest contract)
            for part in '("manifest" "contract")
            for path = (merge-pathnames (format nil "~A-~A-R2.lisp" name part) root)
            do (with-open-file (stream path :direction :output :if-exists :error)
                 (with-standard-io-syntax (write data :stream stream :pretty t) (terpri stream))))
      (format t "~A: stessi gruppi completi, manifesto/contratto R2.~%" name))))
