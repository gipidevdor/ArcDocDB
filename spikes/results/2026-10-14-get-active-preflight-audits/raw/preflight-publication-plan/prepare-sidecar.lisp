;;;; Prepare publication-only sidecar metadata. Execute only after all source groups close.
(require :asdf)
(let* ((commit "8c0866711c50d047f87b9c484ce56d42a87ba19c")
       (head (string-trim '(#\Newline #\Return) (uiop:run-program '("git" "rev-parse" "HEAD") :output :string)))
       (expected (string-trim '(#\Newline #\Return)
                   (uiop:run-program (list "git" "rev-parse" (concatenate 'string commit ":tools/evidence-storage.lisp")) :output :string)))
       (actual (string-trim '(#\Newline #\Return)
                 (uiop:run-program '("git" "hash-object" "--" "tools/evidence-storage.lisp") :output :string))))
  (assert (and (equal commit head) (equal expected actual)))
  (load "tools/evidence-storage.lisp" :verbose nil :print nil))
(defpackage #:preflight.sidecar.plan (:use #:cl))
(in-package #:preflight.sidecar.plan)
(declaim (optimize (safety 3) (debug 3)))
(defparameter *root* (truename "./"))
(defparameter *plan* (truename "spikes/out/preflight-publication-plan/"))
(defparameter *commit* "8c0866711c50d047f87b9c484ce56d42a87ba19c")
(defparameter *runtime* (merge-pathnames "spikes/out/preflight-sidecar-runtime/" *root*))
(defparameter *group-names*
  '("preflight-publication-plan" "preflight-publication-runtime" "preflight-batch-publication"
    "preflight-publication-audit" "preflight-partial-preservation"))
(defun require-check (condition control &rest args)
  (unless condition (error (apply #'format nil control args))) t)
(defun fp (path)
  (list :bytes (arcdocdb.evidence:file-bytes path) :sha256 (arcdocdb.evidence:file-sha256 path)))
(defun save-new (name data)
  (with-open-file (stream (merge-pathnames name *plan*) :direction :output :if-exists :error
                                                         :if-does-not-exist :create :external-format :utf-8)
    (with-standard-io-syntax (write data :stream stream :pretty t) (terpri stream))))
(defun files-in (root)
  (labels ((walk (base depth)
             (require-check (<= depth 64) "Group too deep.")
             (loop for path in (directory (make-pathname :name :wild :type :wild :defaults base) :resolve-symlinks nil)
                   append (let ((mode (sb-posix:stat-mode (sb-posix:lstat (string-right-trim "/" (namestring path))))))
                            (cond ((sb-posix:s-isreg mode) (list path))
                                  ((sb-posix:s-isdir mode) (walk path (1+ depth)))
                                  (t (error "Symlink/special file: ~A." path)))))))
    (sort (walk root 0) #'string< :key #'namestring)))
(defun records-from-log (path)
  "Only explicit recorder outputs from closed publication logs select command groups."
  (let ((text (uiop:read-file-string path :external-format :utf-8)) (records nil))
    (dolist (line (uiop:split-string text :separator '(#\Newline)))
      (let ((position (search "; record: " line)))
        (when position
          (let* ((name (string-trim '(#\Space #\Tab #\Return) (subseq line (+ position 10))))
                 (report (truename name)) (directory (uiop:pathname-directory-pathname report)))
            (require-check (and (equal "report.lisp" (file-namestring report))
                                (uiop:subpathp directory (merge-pathnames "spikes/out/" *root*)))
                           "Recorder path outside native output: ~A." name)
            (push report records)))))
    records))
(defun native-terminal (path)
  (let* ((data (arcdocdb.evidence:read-evidence path)) (status (getf data :status))
         (environment (getf data :environment)) (code (getf data :exit-code))
         (consistency (getf data :source-consistency)))
    (require-check (and (eql 1 (getf data :schema-version)) (eq :command-verification (getf data :kind))
                        (member status '(:ok :failed :source-changed))
                        (member consistency '(:stable :changed))
                        (or (integerp code) (and (null code) (stringp (getf data :diagnostic))))
                        (or (not (eq status :ok)) (eql 0 code))
                        (equal *commit* (getf environment :commit))
                        (equal (namestring *root*) (getf environment :cwd))
                        (stringp (getf environment :working-tree))
                        (every (lambda (line) (or (equal line "")
                                  (member line '("?? spikes/results/2026-10-14-get-active-preflight-core/"
                                                 "?? spikes/results/2026-10-14-get-active-preflight-mutation/"
                                                 "?? spikes/results/2026-10-14-get-active-preflight-bootstrap/"
                                                 "?? spikes/results/2026-10-14-get-active-preflight-audits/") :test #'equal)))
                               (uiop:split-string (getf environment :working-tree) :separator '(#\Newline)))
                        (listp (getf data :command)) (getf data :command)
                        (stringp (getf data :stdout)) (stringp (getf data :stderr))
                        (typep (getf data :started-at-universal-time) '(integer 1))
                        (typep (getf data :finished-at-universal-time) '(integer 1))
                        (<= (getf data :started-at-universal-time) (getf data :finished-at-universal-time))
                        (or (not (eq consistency :stable))
                            (equal (getf data :source-blobs-before) (getf data :source-blobs-after))))
                   "Native record is not terminal or differs from HEAD8c: ~A." path)
    (list :report (namestring path) :label (car (last (pathname-directory (uiop:pathname-directory-pathname path))))
          :status status :exit-code code :source-consistency consistency :command (getf data :command)
          :working-tree (getf environment :working-tree) :working-tree-policy :generated-publication-outputs-only)))
(defun copy-helper (name expected)
  (let* ((source (merge-pathnames (format nil "spikes/out/preflight-batch-publication/~A" name) *root*))
         (target (merge-pathnames name *runtime*)))
    (require-check (equal expected (getf (fp source) :sha256)) "Frozen helper SHA differs: ~A." source)
    (require-check (not (probe-file target)) "Sidecar helper already exists: ~A." target)
    (uiop:copy-file source target)
    (require-check (equal (fp source) (fp target)) "Sidecar helper copy differs: ~A." name)))
(defun prepare ()
  (require-check (null (uiop:command-line-arguments)) "No command arguments supported.")
  (let* ((groups (mapcar (lambda (name)
                           (list name (namestring (truename (merge-pathnames (format nil "spikes/out/~A/" name) *root*)))))
                         *group-names*))
         (publication-runtime (pathname (second (second groups))))
         (partial (pathname (second (fifth groups))))
         (logs (sort (append (directory (merge-pathnames "*.stdout.log" publication-runtime))
                             (directory (merge-pathnames "*.stdout.log" partial))
                             (list (merge-pathnames "spikes/out/preflight-batch-publication/smoke-wrapper-stdout-R1.txt" *root*)))
                     #'string< :key #'namestring))
         (log-before (mapcar (lambda (path) (list (namestring path) (fp path))) logs))
         (records (sort (remove-duplicates (loop for log in logs append (records-from-log log)) :test #'equal)
                        #'string< :key #'namestring))
         (native (mapcar #'native-terminal records))
         (native-groups (mapcar (lambda (row)
                                  (list (getf row :label)
                                        (namestring (uiop:pathname-directory-pathname (pathname (getf row :report)))) t)) native))
         (all-groups (append groups native-groups))
         (domain-audits nil))
    (require-check (and native (= (length all-groups) (length (remove-duplicates all-groups :key #'first :test #'equal))))
                   "Empty recorder discovery or duplicate groups.")
    (dolist (label '("4000988352-command-26972-0" "4000988495-command-30795-0"
                     "4000988575-command-31943-0" "4000988594-command-32457-0"))
      (require-check (find label native :test #'equal :key (lambda (row) (getf row :label)))
                     "Required partial-preservation record absent: ~A." label))
    (dolist (group all-groups)
      (require-check (not (uiop:subpathp *runtime* (pathname (second group)))) "Sidecar runtime is a source group.")
      (dolist (file (files-in (pathname (second group))))
        (require-check (<= (arcdocdb.evidence:file-bytes file) 16777216) "Source exceeds batch limit16MiB: ~A." file)))
    ;; Failed oversized R1 payload lives in staging outside these five explicit groups.
    (dolist (file (files-in partial))
      (require-check (<= (arcdocdb.evidence:file-bytes file) 8388608) "Opaque/helper file exceeds8MiB: ~A." file))
    (require-check (directory (merge-pathnames "payloads-R2/*.tar.part-*.gz" partial)) "Final chunked partial payload is absent.")
    (dolist (name '("core-audit-R1.lisp" "mutation-audit-R1.lisp" "bootstrap-audit-R1.lisp"))
      (let* ((path (merge-pathnames (format nil "spikes/out/preflight-publication-audit/~A" name) *root*))
             (data (arcdocdb.evidence:read-evidence path)))
        (require-check (and (eql 1 (getf data :schema-version))
                            (eq :independent-active-archive-audit (getf data :kind))
                            (eq :ok (getf data :status)) (equal *commit* (getf data :source-commit)))
                       "Domain byte audit is not terminal: ~A." name)
        (push (list :source (namestring path) :kind (getf data :kind) :status (getf data :status)
                    :source-commit (getf data :source-commit) :source-fingerprint (fp path)) domain-audits)))
    (require-check (equal log-before (mapcar (lambda (path) (list (namestring path) (fp path))) logs))
                   "Publication logs changed during native discovery.")
    (ensure-directories-exist (merge-pathnames "seed" *runtime*))
    (copy-helper "collector-batch.lisp" "e6b2cdecbe1bf1602109161b07c7ce51c6716323238dea10e8f9cb7a96a4facf")
    (copy-helper "audit-batch.lisp" "d17564b38f51cd54e7ae86241c82c0eaa81a41bc9a29ecc70a6f937d59d59173")
    (copy-helper "batch-sha.lisp" "130f428551e1aa17a946c2614db5dc14adf9ae35309ec2b21c3be5b2d59be1da")
    (save-new "sidecar-discovered-records.lisp" (list :schema-version 1 :kind :publication-native-record-discovery
                                                    :status :ok :source-commit *commit* :logs log-before :records native
                                                    :domain-audits (reverse domain-audits)))
    (save-new "sidecar-contract.lisp"
              (list :schema-version 1 :kind :archive-audit-contract :source-commit *commit*
                    :expected-groups (mapcar #'first all-groups)
                    :expected-processes (mapcar (lambda (row) (list (getf row :label) (getf row :status)
                                                                   (getf row :exit-code) (getf row :source-consistency))) native)
                    :required-fasl-groups nil :native-reports nil))
    (save-new "sidecar-manifest.lisp"
              (list :schema-version 1 :groups all-groups
                    :files (list (list "README.txt" (namestring (merge-pathnames "sidecar-README.txt" *plan*)))
                                 (list "sidecar-contract.lisp" (namestring (merge-pathnames "sidecar-contract.lisp" *plan*)))
                                 (list "sidecar-auditor-source.txt" (namestring (merge-pathnames "audit-batch.lisp" *runtime*)))
                                 (list "sidecar-batch-source.txt" (namestring (merge-pathnames "batch-sha.lisp" *runtime*))))))
    (with-open-file (stream (merge-pathnames "sidecar-README.txt" *plan*) :direction :output :if-exists :error :external-format :utf-8)
      (format stream "Publication-only sidecar; source freeze ~A.~%~D complete source groups; ~D native command records.~%"
              *commit* (length all-groups) (length native))
      (write-string "Includes all publication plan/runtime/batch/audit/partial-preservation bytes and terminal native command records, including failures. Expected statuses derive from the original reports read as DATA. The failed oversized R1 opaque tar is preserved outside these groups; final chunked R2 payloads and all preservation logs are included. Partial archives remain unqualified bytes. No product result, performance, C1 or MC/DC claim is inferred. Sidecar runtime, its own future collector/auditor outputs and the sidecar archive itself are outside these source groups. Helpers are copied flat into the external sidecar runtime. All sources must stay closed through collection and audit." stream)
      (terpri stream))
    (format t "Prepared sidecar: ~D groups, ~D terminal commands. Close plan before collect; stdout/runtime must remain external.~%"
            (length all-groups) (length native))))
(prepare)
