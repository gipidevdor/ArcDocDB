(require :asdf)
(load "tools/evidence-storage.lisp")
(dolist (path (uiop:command-line-arguments))
  (let ((data (arcdocdb.evidence:read-evidence path)))
    (write (list :path path :kind (getf data :kind) :status (getf data :status)
                 :command (getf data :command) :exit-code (getf data :exit-code)
                 :source-consistency (getf data :source-consistency)
                 :source-count (length (getf data :source-blobs-before))
                 :diagnostic (getf data :diagnostic)
                 :stderr-length (length (getf data :stderr))
                 :counters (getf data :counters)
                 :baseline (let ((entry (getf data :baseline)))
                             (list (getf entry :result) (getf entry :diagnostic)))
                 :mutants (loop for entry in (getf data :mutants)
                                collect (list (getf entry :name) (getf entry :result)
                                              (getf entry :diagnostic)))) :pretty t)
    (terpri)))
