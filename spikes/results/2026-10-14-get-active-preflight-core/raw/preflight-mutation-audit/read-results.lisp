(require :asdf)
(let* ((workspace (truename "./"))
       (reader (merge-pathnames "tools/evidence-storage.lisp" workspace))
       (expected (string-trim '(#\Newline #\Return)
                 (uiop:run-program '("git" "rev-parse" "8c0866711c50d047f87b9c484ce56d42a87ba19c:tools/evidence-storage.lisp") :output :string)))
       (actual (string-trim '(#\Newline #\Return)
                 (uiop:run-program (list "git" "hash-object" (namestring reader)) :output :string))))
  (assert (equal expected actual)) (load reader :verbose nil :print nil))
(defun data (p) (uiop:symbol-call :arcdocdb.evidence :read-evidence p))
(let* ((base "spikes/out/preflight-mutation-audit/")
       (report (data (concatenate 'string base "full-audit-R2.lisp")))
       (native (data "spikes/out/4000986225-command-76301-0/report.lisp"))
       (before (data (concatenate 'string base "full-audit-R2.lisp.before.lisp")))
       (after (data (concatenate 'string base "full-audit-R2.lisp.after.lisp")))
       (preflight (getf report :preflight)) (bootstrap (getf report :bootstrap)))
  (assert (and (eq :ok (getf report :status)) (eq :ok (getf native :status))
               (eql 0 (getf native :exit-code)) (eq :stable (getf native :source-consistency))
               (equal (getf native :source-blobs-before) (getf native :source-blobs-after))
               (equal before after)))
  (with-standard-io-syntax
    (let ((*read-eval* nil) (eof (gensym)))
      (with-input-from-string (s (getf native :stdout))
        (assert (equal report (read s))) (assert (eq eof (read s nil eof))))))
  (write (list :status :ok :commit (getf report :commit) :source-files (getf report :full-source-files)
               :auditor-sha256 (getf report :auditor-sha256)
               :preflight (list :baseline (getf preflight :baseline) :detected (getf preflight :detected)
                                :compiled-per-child (getf preflight :compiled-per-child) :operations (getf preflight :operations)
                                :children (getf preflight :children))
               :bootstrap (list :baseline (getf bootstrap :baseline) :detected (getf bootstrap :detected)
                                :compiled-per-child (getf bootstrap :compiled-per-child) :children (getf bootstrap :children))
               :negative (getf report :negative) :self-tests (getf report :self-tests)
               :two-pass (getf report :two-pass) :inventory-files (getf report :byte-inventory-files)
               :inventory-bytes (getf report :byte-inventory-bytes)
               :native-stdout-equal t :inventory-equal t :stderr-bytes (length (getf native :stderr))) :pretty t)
  (terpri))
