;;;; Conserva stdout/stderr e runner delle fixture negative dei due controlli completi.
;;; OWNER: namespace privato della campagna, produttori già conclusi; 4x2x3 file espliciti.
;;; REQ: REQ-VAL-001 REQ-AFF-012
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *base* "spikes/results/2026-10-15-active-integrazione/")
(defparameter *roots*
  '("4001073580-snapshot-self-test-72542-0" "4001073580-reader-self-test-72566-0"
    "4001074948-snapshot-self-test-63779-0" "4001074949-reader-self-test-63816-0"))
(defun leaf-p (s) (member s '("stdout.log" "stderr.log" "isolated-build.lisp") :test #'equal))
(defun variant-p (s) (member s '("signal" "completion-exit") :test #'equal))
(defun self-test ()
  (unless (and (= 4 (length (remove-duplicates *roots* :test #'equal)))
               (leaf-p "stdout.log") (leaf-p "stderr.log") (leaf-p "isolated-build.lisp")
               (not (leaf-p "../stdout.log")) (variant-p "signal") (variant-p "completion-exit")
               (not (variant-p "../signal")))
    (error "Fixture conservation COD-60: selezione."))
  8)
(defun copy-file-checked (source target)
  (let ((bytes (arcdocdb.evidence:file-bytes source)) (sha (arcdocdb.evidence:file-sha256 source)))
    (unless (<= bytes 1048576) (error "Fixture conservation COD-61: oltre 1 MiB."))
    (ensure-directories-exist target)
    (unless (probe-file target) (uiop:copy-file source target))
    (unless (and (= bytes (arcdocdb.evidence:file-bytes target))
                 (equal sha (arcdocdb.evidence:file-sha256 target))
                 (equal sha (arcdocdb.evidence:file-sha256 source)))
      (error "Fixture conservation COD-61: copia diversa."))
    (list :file (enough-namestring target *base*) :bytes bytes :sha256 sha
          :source (namestring (truename source)))))
(defun collect-fixtures ()
  (let ((checks (self-test)) (files nil))
    (dolist (root *roots*)
      (let* ((directory (format nil "spikes/out/~A/" root))
             (record (arcdocdb.evidence:read-evidence (merge-pathnames "report.lisp" directory))))
        (unless (and (eql 1 (getf record :schema-version)) (eq :passed (getf record :status))
                     (member (getf record :kind) '(:snapshot-process-self-test :reader-process-self-test)))
          (error "Fixture conservation COD-61: produttore non concluso."))
        (dolist (variant '("signal" "completion-exit"))
          (dolist (leaf '("stdout.log" "stderr.log" "isolated-build.lisp"))
            (unless (and (variant-p variant) (leaf-p leaf)) (error "Fixture conservation COD-61: nome."))
            (let ((name (format nil "fixture-output/~A/~A/~A~A" root variant leaf
                                (if (equal leaf "isolated-build.lisp") ".txt" ""))))
              (push (copy-file-checked (merge-pathnames (format nil "~A/~A" variant leaf) directory)
                                       (merge-pathnames name *base*)) files))))))
    (push (copy-file-checked *load-truename* (merge-pathnames "fixtures-source.txt" *base*)) files)
    (let ((data (list :schema-version 1 :kind :fixture-output-conservation :status :ok
                      :checks checks :roots *roots* :files (nreverse files)
                      :limits '(:local-copy-integrity :closed-fixtures-only :no-self-certification))))
      (with-open-file (s (merge-pathnames "fixture-output/manifesto.lisp" *base*)
                         :direction :output :if-exists :error)
        (write data :stream s :pretty t) (terpri s))
      (format t "~S~%" (list :schema-version 1 :kind :fixture-output-conservation :status :ok
                             :self-test-checks checks :files (length files))))))
(let ((args (uiop:command-line-arguments)))
  (cond ((equal args '("--collect")) (collect-fixtures))
        ((equal args '("--self-test")) (format t "~S~%" (list :status :ok :checks (self-test))))
        (t (error "Fixture conservation COD-61: --collect o --self-test."))))
