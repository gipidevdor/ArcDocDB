;;;; Conserva produttori di chiusura espliciti con nomi relativi invariati.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *closing-base* "spikes/results/2026-10-15-active-verifica/")
(defun closing-name-p (name)
  (and (stringp name) (<= 1 (length name) 96)
       (every (lambda (c) (or (and (char<= #\a c #\z))
                             (and (char<= #\0 c #\9)) (char= c #\-))) name)))
(defun retain-closed ()
  (let* ((base *closing-base*)
         (selection (arcdocdb.evidence:read-evidence (merge-pathnames "closing-roots.lisp" base)))
         (specs (getf selection :records)) (files nil) (records nil))
    (unless (and (eq :active-verifica-closing-roots (getf selection :kind))
                 (eql 1 (getf selection :schema-version)) (listp specs) (<= (length specs) 32)
                 (= (length specs) (length (remove-duplicates specs :key #'first :test #'equal)))
                 (every (lambda (spec) (and (= 3 (length spec))
                         (closing-name-p (first spec)) (closing-name-p (second spec))
                         (member (third spec) '(:ok :failed)))) specs))
      (error "Chiusura COD-61: selezione invalida."))
    (dolist (spec specs)
      (let* ((phase (first spec)) (source (format nil "spikes/out/~A/" (second spec)))
             (target (format nil "~Achiusura/~A/" base phase))
             (record (arcdocdb.evidence:read-evidence (merge-pathnames "report.lisp" source))))
        (unless (and (eq :command-verification (getf record :kind))
                     (eq (third spec) (getf record :status))
                     (eq :stable (getf record :source-consistency))
                     (integerp (getf record :exit-code))
                     (if (eq :ok (third spec)) (zerop (getf record :exit-code))
                         (not (zerop (getf record :exit-code))))
                     (integerp (getf record :finished-at-universal-time)))
          (error "Chiusura COD-61: produttore aperto/diverso: ~A" source))
        (push (list :phase phase :directory (second spec) :status (getf record :status)
                    :finished-at-universal-time (getf record :finished-at-universal-time)) records)
        (ensure-directories-exist (merge-pathnames "report.lisp" target))
        (dolist (leaf '("report.lisp" "report.lisp.gz" "conservazione.lisp"))
          (let ((src (merge-pathnames leaf source)) (dst (merge-pathnames leaf target)))
            (when (probe-file src)
              (unless (probe-file dst) (uiop:copy-file src dst))
              (unless (equal (arcdocdb.evidence:file-sha256 src)
                             (arcdocdb.evidence:file-sha256 dst))
                (error "Chiusura COD-61: copia diversa: ~A" dst))
              (push (list :file (enough-namestring (truename dst) (truename base))
                          :bytes (arcdocdb.evidence:file-bytes dst)
                          :sha256 (arcdocdb.evidence:file-sha256 dst)
                          :source (namestring (truename src))) files))))
        (unless (equalp record (arcdocdb.evidence:read-evidence (merge-pathnames "report.lisp" target)))
          (error "Chiusura COD-61: record espanso diverso."))))
    (dolist (leaf '("closing-roots.lisp" "retention.lisp" "retention-source.txt"))
      (let ((f (merge-pathnames leaf base)))
        (push (list :file leaf :bytes (arcdocdb.evidence:file-bytes f)
                    :sha256 (arcdocdb.evidence:file-sha256 f)) files)))
    (let ((manifest (list :schema-version 1 :kind :active-verifica-closing-retention :status :ok
                         :integration-head (string-trim '(#\Newline #\Return)
                                          (uiop:run-program '("git" "rev-parse" "HEAD") :output :string))
                         :catalog-sha256 (arcdocdb.evidence:file-sha256
                                          (merge-pathnames "catalogo.lisp" base))
                         :records (nreverse records) :files (nreverse files)
                         :limits '(:local-copy-integrity :no-host-authentication
                                   :closing-producer-stored-separately :no-self-certification
                                   :failed-record-not-accepted-proof))))
      (with-open-file (out (merge-pathnames "chiusura/manifesto.lisp" base)
                          :direction :output :if-exists :error)
        (write manifest :stream out :pretty t) (terpri out))
      (write (list :schema-version 1 :kind :active-verifica-closing-retention :status :ok
                   :records (length records) :files (length files)) :pretty t) (terpri))))
(let ((args (uiop:command-line-arguments)))
  (cond ((equal args '("--self-test"))
         (unless (and (closing-name-p "4000922580-command-18971-0")
                      (not (closing-name-p "../a")) (not (closing-name-p "a/b"))
                      (not (closing-name-p "")) (not (closing-name-p "UPPER")))
           (error "Chiusura COD-60: nomi."))
         (write '(:schema-version 1 :kind :active-verifica-closing-self-test :status :ok :checks 5)) (terpri))
        ((equal args '("--retain")) (retain-closed))
        (t (error "Chiusura COD-61: usare --self-test o --retain."))))
