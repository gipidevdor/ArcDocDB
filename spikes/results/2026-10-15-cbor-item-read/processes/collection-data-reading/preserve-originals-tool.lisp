;;;; C4: preserve two completed original files beside the completed DATA-reader record.
(require :asdf)
(load "tools/evidence-storage.lisp")
(destructuring-bind (observation closure target-record) (uiop:command-line-arguments)
  (let* ((target (uiop:pathname-directory-pathname (truename target-record)))
         (record (arcdocdb.evidence:read-evidence target-record))
         (copies nil))
    (assert (and (eq :command-verification (getf record :kind))
                 (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))))
    (loop for source in (list observation closure *load-truename*)
          for leaf in '("collection-observation-original.lisp" "closed-check-original.log"
                        "preserve-originals-tool.lisp")
          for origin = (truename source)
          for copy = (merge-pathnames leaf target)
          for bytes = (arcdocdb.evidence:file-bytes origin)
          for sha = (arcdocdb.evidence:file-sha256 origin)
          do (assert (and (not (probe-file copy)) (<= bytes 1048576)))
             (uiop:copy-file origin copy)
             (assert (= bytes (arcdocdb.evidence:file-bytes origin)
                        (arcdocdb.evidence:file-bytes copy)))
             (assert (equal sha (arcdocdb.evidence:file-sha256 origin)))
             (assert (equal sha (arcdocdb.evidence:file-sha256 copy)))
             (push (list :source (namestring origin) :copy (namestring copy)
                         :bytes bytes :sha256 sha :comparisons 3) copies))
    (let ((result (list :schema-version 1 :kind :preserved-collection-originals
                        :status :ok :files (nreverse copies)
                        :limits '(:completed-originals-only :no-source-mutation
                                  :no-product-load :local-byte-consistency))))
      (with-open-file (out (merge-pathnames "preserved-collection-originals.lisp" target)
                           :direction :output :if-exists :error)
        (let ((*print-readably* t)) (write result :stream out :pretty t) (terpri out)))
      (let ((*print-readably* t)) (write result :pretty t) (terpri)))))
