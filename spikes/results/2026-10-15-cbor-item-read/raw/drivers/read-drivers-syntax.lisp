(require :asdf)
(require :sb-md5)
(require :sb-posix)
(let ((package (or (find-package "ARCDOCDB.CBOR") (make-package "ARCDOCDB.CBOR" :use '("CL")))))
  (dolist (name '("LEGGl-ITEM-CBOR-MINIMO" "LEGGI-ITEM-CBOR-MINIMO" "CREA-SPAZIO-CBOR"))
    (export (intern name package) package)))
(let ((package (or (find-package "ARCDOCDB.EVIDENCE") (make-package "ARCDOCDB.EVIDENCE" :use '("CL")))))
  (dolist (name '("FILE-BYTES" "FILE-SHA256" "READ-EVIDENCE")) (export (intern name package) package)))
(defun forms-from-text (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*package* (find-package :cl-user))
        (eof (gensym "EOF")))
    (with-input-from-string (in text)
      (loop for form = (read in nil eof) until (eq form eof) collect form))))
(defun git-blob (path)
  (string-trim '(#\Newline #\Return) (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun unique-replacement (text old new)
  (let ((pos (search old text)))
    (assert (and pos (not (search old text :start2 (1+ pos)))))
    (concatenate 'string (subseq text 0 pos) new (subseq text (+ pos (length old))))))
(let* ((base "spikes/out/cbor-item-read-20261015/drivers/")
       (names '("bench.lisp" "audit.lisp" "mutation.lisp" "catalogue-materialized.lisp" "nominal-whitelist.lisp"))
       (observations
         (loop for name in names for path = (concatenate 'string base name)
               collect (list :path path :blob (git-blob path)
                             :forms (length (forms-from-text (uiop:read-file-string path :external-format :utf-8))))))
       (catalogue-forms (forms-from-text (uiop:read-file-string (concatenate 'string base "catalogue-materialized.lisp"))))
       (catalogue (first catalogue-forms))
       (source (uiop:read-file-string "src/codec/cbor-item-read.lisp" :external-format :utf-8))
       (images nil))
  (assert (= 1 (length catalogue-forms)))
  (assert (= 8 (length (getf catalogue :unique-source-substitutions))))
  (dolist (entry (getf catalogue :unique-source-substitutions))
    (destructuring-bind (path name old new) entry
      (assert (string= path "src/codec/cbor-item-read.lisp"))
      (let* ((image (unique-replacement source old new)) (forms (forms-from-text image)))
        (assert (= 4 (length forms)))
        (when (string= name "extra-return-value")
          (assert (search "(values index (integer 0 100) index null &optional)" image))
          (assert (search "(values nodes peak position nil)" image)))
        (push (list :name name :forms (length forms) :unique-source-substitution t
                    :only-local-new-kernel-changed t :extra-arity-ftype-coherent (string= name "extra-return-value")) images))))
  (write (list :schema-version 1 :kind :cbor-item-drivers-static-reading :status :ok
               :read-eval nil :eof-required t :product-loaded nil :drivers-executed nil
               :dummy-packages-for-reader-only t :observations observations :mutant-images (nreverse images)
               :baseline-source-forms (length (forms-from-text source))) :pretty t)
  (terpri))
