;;;; Independent C4 DATA reading only; no benchmark/audit/product driver loaded.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:item.benchmark.reading (:use #:cl))
(in-package #:item.benchmark.reading)
(defvar *checks* 0)
(defparameter *bench* "spikes/out/4001074008-command-2418-0/report.lisp")
(defparameter *audit* "spikes/out/4001074123-command-8636-0/report.lisp")
(defparameter *cold* "spikes/out/cbor-item-read-20261015/drivers/fixtures-and-mutations.lisp")
(defparameter *pins*
  '(("src/codec/cbor-item-read.lisp" "b9099dc8a8c96281063811e686deb4dcb2b1d39b")
    ("tests/codec/cbor-item-read-support.lisp" "0326100362a1c4b24d2c7e511e45357f09a56d33")
    ("tests/codec/cbor-item-read.lisp" "b2cbdcb4255c51d9da4fe73b28939c1cb923fefe")
    ("tests/codec/cbor-item-read-threads.lisp" "a0da65545ed80ede0a967cadbb337731f6fe1ce9")))
(defun check (truth reason) (incf *checks*) (unless truth (error "Benchmark DATA: ~S" reason)))
(defun blob (path)
  (string-trim '(#\Newline #\Return) (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun observe (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun plist-check (data)
  (check (and (consp data) (list-length data) (evenp (length data))) :proper-plist)
  (let ((seen nil)) (loop for key in data by #'cddr do
    (check (and (keywordp key) (not (member key seen))) :unique-key) (push key seen))) data)
(defun read-text (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym)))
    (with-input-from-string (stream text)
      (let ((data (read stream nil eof)))
        (check (not (eq data eof)) :data-present)
        (check (eq eof (read stream nil eof)) :single-form-eof) (plist-check data)))))
(defun read-file (path)
  (check (< (arcdocdb.evidence:file-bytes path) 1048576) :data-budget)
  (read-text (uiop:read-file-string path :external-format :utf-8)))
(defun wrapper (data)
  (check (and (eql 1 (getf data :schema-version)) (eq :command-verification (getf data :kind))
              (eq :ok (getf data :status)) (eql 0 (getf data :exit-code))
              (eq :stable (getf data :source-consistency))
              (equal (getf data :source-blobs-before) (getf data :source-blobs-after))) :wrapper-status)
  (check (and (stringp (getf data :stdout)) (stringp (getf data :stderr))) :wrapper-streams)
  (dolist (marker '("WARNING:" "STYLE-WARNING:" "Unhandled " "compilation aborted" "COMPILE-FILE-ERROR"))
    (check (not (search marker (getf data :stderr) :test #'char-equal)) :no-compiler-failure))
  (let ((env (plist-check (getf data :environment))) (table (make-hash-table :test 'equal)))
    (check (and (equal "46aee8b920d447aafae4a4e47a44d13631c47cb1" (getf env :commit))
                (equal "" (getf env :working-tree))) :wrapper-head)
    (dolist (entry (getf data :source-blobs-before))
      (plist-check entry)
      (check (not (nth-value 1 (gethash (getf entry :path) table))) :unique-source)
      (setf (gethash (getf entry :path) table) (getf entry :git-blob)))
    (check (= 931 (hash-table-count table)) :source-count)
    (dolist (pin *pins*) (check (equal (second pin) (gethash (first pin) table)) :wrapper-four-pins)))
  (read-text (getf data :stdout)))
(defun close-number (actual expected)
  (and (realp actual) (<= (abs (- actual expected)) (* 1d-9 (max 1d0 (abs expected))))))
(defun sample (data iterations warmup token heap timer)
  (plist-check data)
  (check (and (eql iterations (getf data :iterations)) (eql warmup (getf data :warmup-iterations))
              (eql token (getf data :expected-return-token))) :sample-parameters)
  (let* ((observed (getf data :heap-bytes :absent)) (ticks (getf data :raw-ticks))
         (sink (mod (+ (* iterations token) (floor (* iterations (1- iterations)) 2))
                    (1+ most-positive-fixnum))))
    (check (and (integerp observed) (<= 0 observed) (= heap observed)) :present-exact-heap)
    (check (and (eql sink (getf data :sink)) (eql sink (getf data :expected-sink))) :sample-sink)
    (check (and (integerp ticks) (<= 0 ticks)) :sample-ticks)
    (let ((seconds (/ ticks (float timer 1d0))))
      (check (close-number (getf data :seconds) seconds) :sample-time)
      (check (if (zerop ticks) (null (getf data :calls-per-second))
                 (close-number (getf data :calls-per-second) (/ iterations seconds))) :sample-rate))
    ticks))
(let* ((paths (list *bench* *audit* *cold*)) (physical (mapcar #'observe paths))
       (source-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*))
       (bw (read-file *bench*)) (aw (read-file *audit*)) (bench (wrapper bw)) (audit (wrapper aw))
       (cold (read-file *cold*)) (cells (getf bench :campaigns)) (specs (getf cold :fixtures))
       (timer (getf bench :timer-units-per-second)) (ticks-total 0) (samples-total 0)
       (controls (plist-check (getf bench :self-test)))
       (audit-data (plist-check (getf audit :result))) (audit-result (plist-check (getf audit-data :result)))
       (*print-pretty* nil))
  (check (equal source-pins *pins*) :current-four-pins)
  (check (and (equal (third (first physical)) "6f6e5658f9d29568dc59cb407bcbb4b4711f3d48e7f74127df29d7c26c9a8655")
              (equal (third (second physical)) "c5a14ee6974ca54db3c2c2f0f04bdb5d7a6bf1ff138e82f09ffbd4d53152555e")) :fixed-wrapper-hashes)
  (check (and (string= "c6a22e6751cab0eff88dd1173ed81543d595a659" (blob *cold*))
              (string= "118c779ca567411675e5dfbb0866b5b17e77c7f0" (blob "spikes/out/cbor-item-read-20261015/drivers/bench.lisp"))
              (string= "b6fcd88b73f31c5a9109dc83c8f311cf5b47082e" (blob "spikes/out/cbor-item-read-20261015/drivers/audit.lisp"))
              (string= "fa2b5d36dca0837e2ed5e49b282887b2e110b2b7" (blob "tools/evidence-storage.lisp"))) :cold-and-drivers-pins)
  (check (equal '("--script" "spikes/out/cbor-item-read-20261015/drivers/bench.lisp" "--bench")
                (last (getf bw :command) 3)) :bench-command)
  (check (equal (list "--script" "spikes/out/cbor-item-read-20261015/drivers/audit.lisp" "--bench"
                     (namestring (truename *bench*)) "b9099dc8a8c96281063811e686deb4dcb2b1d39b")
                (last (getf aw :command) 5)) :audit-command)
  (check (and (eq :ok (getf bench :status)) (eq :cbor-item-read-benchmark (getf bench :kind))
              (eq :stable (getf bench :source-consistency))
              (equal (getf bench :source-fingerprints-before) (getf bench :source-fingerprints-after))
              (= 228 (length (getf bench :source-fingerprints-before)))
              (integerp timer) (plusp timer) (eql 3 (getf bench :safety)) (eql 1 (getf bench :workers))) :bench-status)
  (check (and (eql 1 (getf cold :schema-version)) (= 6 (length cells) (length specs))
              (equal (getf bench :fixture-catalogue-blob) "c6a22e6751cab0eff88dd1173ed81543d595a659")) :six-cold-fixtures)
  (loop for cell in cells for spec in specs do
    (plist-check cell) (plist-check spec)
    (let* ((name (getf spec :name)) (nodes (getf spec :nodes)) (peak (getf spec :peak))
           (next (getf spec :next)) (full (getf spec :full-buffer-literal))
           (token (+ (* nodes 17) (* peak 257) (* next 65537)
                     (loop for byte in full for weight from 1 sum (* byte weight))))
           (samples (getf cell :samples))
           (workspace (list :cursor next :top 0 :nodes nodes :depth 0 :peak-depth peak :pending-tag nil)))
      (check (and (= token (getf spec :token) (getf cell :expected-token))
                  (equal name (getf cell :name)) (equal (getf spec :item-literal) (getf cell :item-literal))
                  (equal (getf spec :tail-literal) (getf cell :tail-literal))
                  (eql nodes (getf cell :expected-nodes)) (eql peak (getf cell :expected-peak))
                  (eql next (getf cell :expected-next)) (eql (getf spec :start) (getf cell :start))
                  (eql (getf spec :end) (getf cell :end))
                  (equal full (getf cell :expected-full-buffer)) (equal full (getf cell :observed-full-buffer))
                  (equal (list nodes peak next) (getf cell :cold-values))
                  (eql 3 (getf cell :cold-value-count)) (equal workspace (getf cell :cold-workspace))) :cold-cell-values-buffer-six-scalars)
      (dolist (key '(:preallocated-readonly-source :private-preallocated-workspace :complete-source-checked-per-call
                     :exact-three-values-checked-per-call :complete-scalar-workspace-checked-per-call))
        (check (eq t (getf cell key)) :per-call-check-declarations))
      (check (= 5 (length samples)) :five-replicas)
      (dolist (entry samples) (incf samples-total) (incf ticks-total (sample entry 1024 64 token 0 timer)))
      (format t "CELL ~S cold~S token~D replicas5 heap-present-zero5 ticks~S sinks~S.~%"
              name (getf cell :cold-values) token (mapcar (lambda (s) (getf s :raw-ticks)) samples)
              (mapcar (lambda (s) (getf s :sink)) samples))))
  (check (eq :ok (getf controls :status)) :self-controls-status)
  (let ((baseline (sample (getf controls :baseline) 1024 64 0 0 timer))
        (positive (sample (getf controls :positive-control) 16 0 1048576 16777472 timer)))
    (format t "CONTROLS baseline0 positive16777472 bytes ticks~D/~D.~%" baseline positive))
  (check (and (eq :ok (getf audit :status)) (eq :cbor-item-read-bench-audit (getf audit :kind))
              (eql 71252 (getf audit :checks)) (eql 6 (getf audit-result :cells))
              (eql 30 (getf audit-result :samples)) (eql 0 (getf audit-result :heap-bytes))
              (eql 3 (getf audit-result :cold-arity)) (eql 0 (getf audit-result :baseline-heap-bytes))
              (eql 16777472 (getf audit-result :positive-control-heap-bytes))
              (eql 228 (getf audit-result :source-fingerprint-count))
              (close-number (getf audit-result :sample-seconds) (/ ticks-total (float timer 1d0)))) :audit-actual-result)
  (let ((before (plist-check (getf audit-data :wrapper-before))) (after (plist-check (getf audit-data :wrapper-after))))
    (check (and (equal before after) (= 254464 (getf before :bytes))
                (equal (namestring (truename *bench*)) (getf before :path))
                (equal (third (first physical)) (getf before :sha256))) :audit-observed-same-original-wrapper))
  (check (= 30 samples-total) :all-thirty-samples)
  (check (equal physical (mapcar #'observe paths)) :physical-inputs-unchanged)
  (check (equal source-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*)) :four-sources-unchanged)
  (format t "SUMMARY samples~D heap-present-zero~D sample-ticks~D sample-seconds~,6F auditchecks~D bench-wall~S audit-wall~S outer-sources931 stable.~%"
          samples-total samples-total ticks-total (/ ticks-total (float timer 1d0)) (getf audit :checks)
          (getf bw :wall-seconds) (getf aw :wall-seconds))
  (format t "STDERR bench-chars~D audit-chars~D.~%PHYSICAL ~S~%SOURCE-PINS ~S~%DATA PASS checks~D; no product/driver load, compilation or measurements.~%"
          (length (getf bw :stderr)) (length (getf aw :stderr)) physical source-pins *checks*))
