(defun check (truth reason)
  (incf *checks*) (unless truth (error "Item coverage DATA: ~S" reason)))
(defun blob (path)
  (string-trim '(#\Space #\Newline #\Return)
               (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun observation (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun read-data (path)
  (check (<= (arcdocdb.evidence:file-bytes path) 134217728) :data-byte-budget)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((form (read stream nil eof)))
        (check (not (eq form eof)) :data-present)
        (check (eq eof (read stream nil eof)) :one-data-form-eof) form))))
(defun source-forms ()
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package "ARCDOCDB.CBOR")) (eof (gensym)))
    (with-open-file (stream *source* :external-format :utf-8)
      (coerce (loop for form = (read stream nil eof) until (eq form eof) collect form) 'vector))))
(defun plist-check (data)
  (let ((size (and (consp data) (list-length data))) (seen nil))
    (check (and size (evenp size)) :plist-shape)
    (loop for key in data by #'cddr do
      (check (and (keywordp key) (not (member key seen))) :unique-plist-key) (push key seen))) data)
(defun inventory (entries)
  (check (and (consp entries) (list-length entries)) :inventory-shape)
  (let ((table (make-hash-table :test 'equal)))
    (dolist (entry entries table)
      (plist-check entry)
      (let ((path (getf entry :path)) (hash (getf entry :git-blob)))
        (check (and (stringp path) (stringp hash) (= 40 (length hash))
                    (not (nth-value 1 (gethash path table)))) :unique-inventory-source)
        (setf (gethash path table) hash)))))
(defun ancestors (path forms)
  (let* ((indices (reverse (if (keywordp (car path)) (cdr path) path)))
         (form (aref forms (first indices))) (result (list form)))
    (dolist (index (rest indices) (nreverse result))
      (check (and (integerp index) (<= 0 index) (listp form) (< index (length form))) :path-bound)
      (setf form (nth index form)) (push form result))))
(defun summary (entry)
  (let ((paths (cadr entry)) (bits (cddr entry)) (counts (list 0 0 0 0))
        (sites (make-hash-table :test 'equal)))
    (check (and (stringp (car entry)) (typep paths 'simple-vector)
                (typep bits 'simple-bit-vector) (= (length paths) (length bits))) :raw-entry-shape)
    (dotimes (i (length paths))
      (let ((path (aref paths i)) (bit (sbit bits i)))
        (check (consp path) :raw-path)
        (if (member (car path) '(:then :else))
            (progn (incf (third counts) bit) (incf (fourth counts))
                   (push (car path) (gethash (cdr path) sites)))
            (progn (incf (first counts) bit) (incf (second counts))))))
    (maphash (lambda (path ways) (declare (ignore path))
               (check (and (= 2 (length ways)) (member :then ways) (member :else ways)) :paired-branches)) sites)
    counts))
(defun html-rows (text)
  (let* ((begin (search "<table class='summary'>" text))
         (end (and begin (search "</table>" text :start2 begin))) (rows nil))
    (check (and begin end) :html-summary)
    (loop for start = (search "<tr " text :start2 begin) then (search "<tr " text :start2 (1+ start))
          while (and start (< start end)) do
      (let* ((next (search "<tr " text :start2 (1+ start))) (stop (min end (or next end))) (cells nil))
        (loop for cell = (search "<td" text :start2 start) then (search "<td" text :start2 (1+ cell))
              while (and cell (< cell stop)) do
          (let ((open (position #\> text :start cell :end stop))
                (close (search "</td>" text :start2 cell :end2 stop)))
            (check (and open close (< open close)) :html-cell)
            (push (string-trim '(#\Space #\Newline #\Return) (subseq text (1+ open) close)) cells)))
        (push (nreverse cells) rows))) (nreverse rows)))
(defun html-counts (rows label)
  (let ((row (find label rows :key #'first :test #'string=)))
    (check (and row (= 4 (length row))) :html-count-row)
    (list (parse-integer (second row)) (parse-integer (third row)) (fourth row))))
(defun percent (covered total) (string-trim '(#\Space) (format nil "~5,1F" (* 100d0 (/ covered total)))))
(defun plain-code (text)
  (with-output-to-string (out)
    (loop with index = 0 while (< index (length text)) do
      (cond ((char= #\< (char text index))
             (setf index (1+ (or (position #\> text :start index) (error "HTML tag incomplete")))))
            ((char= #\& (char text index))
             (let* ((end (position #\; text :start index))
                    (code (and end (string= "&#" text :start2 index :end2 (+ index 2))
                               (parse-integer text :start (+ index 2) :end end))))
               (check code :numeric-html-entity)
               (write-char (if (= code 160) #\Space (code-char code)) out) (setf index (1+ end))))
            (t (write-char (char text index) out) (incf index))))))
(defun verify-html-source (html)
  (let ((lines (uiop:split-string (uiop:read-file-string *source*) :separator '(#\Newline))) (count 0))
    (dolist (row (uiop:split-string html :separator '(#\Newline)))
      (when (search "<div class='source'>" row)
        (let* ((number-start (+ 31 (search "<div class='line-number'><code>" row)))
               (number (parse-integer row :start number-start :junk-allowed t))
               (start (+ 12 (search "</div><code>" row :start2 number-start)))
               (end (search "</code></div>" row :start2 start))
               (code (plain-code (subseq row start end))))
          (incf count) (check (= count number) :html-line-order)
          (check (and (plusp (length code)) (char= #\Space (char code 0))
                      (string= (nth (1- number) lines) (subseq code 1))) :html-source-line))))
    (check (= 44 count) :all-source-html-lines) count))
(let* ((physical (mapcar (lambda (pin) (observation (first pin))) *physical*))
       (source-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*))
       (record (plist-check (read-data *wrapper*))) (env (plist-check (getf record :environment)))
       (before (inventory (getf record :source-blobs-before))) (after (inventory (getf record :source-blobs-after)))
       (raw (read-data (concatenate 'string *base* "coverage-state.lisp")))
       (forms (source-forms)) (absolute (namestring (truename *source*)))
       (selected (remove-if-not (lambda (entry) (string= absolute (car entry))) raw))
       (index (html-rows (uiop:read-file-string (concatenate 'string *base* "cover-index.html"))))
       (page (uiop:read-file-string (concatenate 'string *base* *leaf*)))
       (classes (make-hash-table :test 'eq)) (errors nil) (and-or 0) (global '(0 0 0 0))
