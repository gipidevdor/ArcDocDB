  (check (equal physical *physical*) :fixed-physical-inputs)
  (check (equal source-pins *pins*) :four-current-pins)
  (check (string= "fa2b5d36dca0837e2ed5e49b282887b2e110b2b7" (blob "tools/evidence-storage.lisp")) :trusted-tool-pin)
  (check (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
              (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
              (eq :stable (getf record :source-consistency))
              (equal (getf record :source-blobs-before) (getf record :source-blobs-after))) :stable-wrapper)
  (check (and (= 931 (hash-table-count before) (hash-table-count after))
              (string= "46aee8b920d447aafae4a4e47a44d13631c47cb1" (getf env :commit))
              (string= "" (getf env :working-tree)) (string= "2.6.9" (getf env :version))) :wrapper-inventory-head-version)
  (check (equal '("sbcl" "--noinform" "--no-userinit" "--no-sysinit" "--script"
                 "tools/foundation-coverage.lisp" "--report" "spikes/out/cbor-item-read-20261015/coverage/" "cbor-item-read")
                (getf record :command)) :exact-scope-command)
  (dolist (pin *pins*) (check (equal (second pin) (gethash (first pin) before)) :before-pin)
                       (check (equal (second pin) (gethash (first pin) after)) :after-pin))
  (check (stringp (getf record :stderr)) :stderr-string)
  (dolist (marker '("WARNING:" "STYLE-WARNING:" "Unhandled " "compilation aborted" "COMPILE-FILE-ERROR"))
    (check (not (search marker (getf record :stderr) :test #'char-equal)) :no-warning-or-failure))
  (let ((ok (remove-if-not (lambda (line) (and (<= 6 (length line)) (string= "ok    " line :end2 6)))
                           (uiop:split-string (getf record :stdout) :separator '(#\Newline)))))
    (check (= 17 (length ok) (length (remove-duplicates ok :test #'string=))) :seventeen-nominals))
  (check (and (list-length raw) (= 1 (length selected))) :one-selected-raw-source)
  (check (= 1 (count-if (lambda (row) (search "<a href=" (first row))) index)) :one-html-source-link)
  (let ((seen (make-hash-table :test 'equal)))
    (dolist (entry raw) (check (not (gethash (car entry) seen)) :unique-global-source)
      (setf (gethash (car entry) seen) t global (mapcar #'+ global (summary entry)))))
  (labels ((walk (form path)
             (when (consp form)
               (when (member (car form) '(and or)) (incf and-or))
               (when (eq (car form) 'error) (push (list :path path :reason (getf (cddr form) :reason)) errors))
               (loop for child in form for i from 0 when (consp child) do (walk child (append path (list i)))))))
    (loop for form across forms for top from 0 do (walk form (list top))))
  (check (and (= 4 (length forms)) (= 5 (length errors)) (zerop and-or)) :forms-errors-and-or)
  (let* ((entry (first selected)) (paths (cadr entry)) (bits (cddr entry)) (counts (summary entry))
         (expected-e (list (first counts) (second counts) (percent (first counts) (second counts))))
         (expected-b (list (third counts) (fourth counts) (percent (third counts) (fourth counts))))
         (row (find-if (lambda (row) (search *leaf* (first row))) index)))
    (check (equal counts '(64 90 8 12)) :full-integer-denominators)
    (check (equal expected-e (html-counts (html-rows page) "expression")) :html-expressions)
    (check (equal expected-b (html-counts (html-rows page) "branch")) :html-branches)
    (check (and row (= 7 (length row)) (search "cbor-item-read.lisp" (first row))
                (equal (append expected-e expected-b)
                       (list (parse-integer (second row)) (parse-integer (third row)) (fourth row)
                             (parse-integer (fifth row)) (parse-integer (sixth row)) (seventh row)))) :index-counts)
    (check (search absolute page) :html-source-header)
    (format t "WRAPPER status~S exit~D sources~D HEAD~A wall~S stderr-chars~D nominal17.~%"
            (getf record :status) (getf record :exit-code) (hash-table-count before)
            (getf env :commit) (getf record :wall-seconds) (length (getf record :stderr)))
    (format t "GLOBAL files~D expression~D/~D branch~D/~D; global is NOT selected scope.~%" (length raw)
            (first global) (second global) (third global) (fourth global))
    (format t "SELECTED one file ~A expression64/90 branch8/12 raw-records~D; HTML/index agree; HTML source lines~D.~%"
            *source* (length paths) (verify-html-source page))
    (dotimes (i (length paths))
      (let* ((path (aref paths i)) (anc (ancestors path forms)) (top (first anc))
             (form (car (last anc))) (branch (member (car path) '(:then :else)))
             (error-form (find-if (lambda (x) (and (consp x) (eq (car x) 'error))) (reverse anc))))
        (when branch (format t "BRANCH record~D ~S hit~D predicate~S~%" i path (sbit bits i) form))
        (when (zerop (sbit bits i))
          (let ((class (cond ((member (car top) '(in-package declaim)) :declaration)
                             ((and (not branch) error-form) :invariant-error-expression)
                             (branch :else-guard-branch)
                             ((and (consp form) (= 2 (length form))
                                   (member (symbol-name (car form)) '("MAX-BYTES" "MAX-NODES" "MAX-DEPTH") :test #'string=)) :keyword-default)
                             (t :other))))
            (check (not (eq class :other)) :every-missed-classified)
            (when branch (check (eq (car path) :else) :only-else-missed))
            (incf (gethash class classes 0))
            (format t "MISSED record~D ~S ~S path~S form~S reason~S~%" i
                    (if branch :branch :expression) class path form (and error-form (getf (cddr error-form) :reason)))))))
    (dolist (item (reverse errors))
      (let ((points nil))
        (dotimes (i (length paths))
          (let ((error-form (find-if (lambda (x) (and (consp x) (eq (car x) 'error)))
                                     (reverse (ancestors (aref paths i) forms)))))
            (when (and error-form (eq (getf item :reason) (getf (cddr error-form) :reason)))
              (push (list i (sbit bits i)) points))))
        (check (and (= 4 (length points)) (every (lambda (pair) (zerop (second pair))) points)) :all-five-error-records)
        (format t "ERROR ~S records~S~%" item (reverse points)))))
  (check (and (= 3 (gethash :declaration classes 0)) (= 20 (gethash :invariant-error-expression classes 0))
              (= 4 (gethash :else-guard-branch classes 0)) (= 3 (gethash :keyword-default classes 0))) :all-thirty-missed)
  (check (equal physical (mapcar (lambda (pin) (observation (first pin))) *physical*)) :physical-inputs-unchanged)
  (check (equal source-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*)) :four-sources-unchanged)
  (format t "CLASSIFICATION declarations3 invariant-error-expressions20 keyword-defaults3 ELSE-branches4 =30; exclusions0; AND/OR0; no MC/DC claim.~%PHYSICAL ~S~%SOURCE-PINS ~S~%DATA READING PASS checks~D.~%" physical source-pins *checks*))
