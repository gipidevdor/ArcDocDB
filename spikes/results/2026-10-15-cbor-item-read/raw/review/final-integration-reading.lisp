                     (merge-pathnames (getf descriptor :payload) path)))
       (inputs (mapcar #'fingerprint (append (list path self whitelist-path) (when payload (list payload)))))
       (record (arcdocdb.evidence:read-evidence path))
       (whitelist (arcdocdb.evidence:read-evidence whitelist-path))
       (before (getf record :source-blobs-before)) (after (getf record :source-blobs-after))
