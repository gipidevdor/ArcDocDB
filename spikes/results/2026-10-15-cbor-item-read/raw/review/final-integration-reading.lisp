(load "tools/evidence-storage.lisp")
(defpackage #:cbor.item.final.reading (:use #:cl))
(in-package #:cbor.item.final.reading)
(defun lines (text)
  (with-input-from-string (stream text)
    (loop for line = (read-line stream nil) while line collect (string-right-trim '(#\Return) line))))
(defun prefixp (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))
(defun literal (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((form (read stream nil eof)))
        (assert (not (eq eof form))) (assert (eq eof (read stream nil eof))) form))))
(defun fingerprint (path)
  (list (namestring (pathname path)) (arcdocdb.evidence:file-bytes path)
        (arcdocdb.evidence:file-sha256 path)))
(defun git-blob (path)
  (let ((process (sb-ext:run-program "git" (list "hash-object" path) :search t :wait nil
                                   :output :stream :error :stream)))
    (unwind-protect
         (let ((blob (read-line (sb-ext:process-output process) nil)))
           (assert (eq :eof (read-line (sb-ext:process-output process) nil :eof)))
           (assert (eq :eof (read-line (sb-ext:process-error process) nil :eof)))
           (sb-ext:process-wait process)
           (assert (eq :exited (sb-ext:process-status process)))
           (assert (eql 0 (sb-ext:process-exit-code process)))
           (assert (and (stringp blob) (= 40 (length blob)))) blob)
      (sb-ext:process-close process))))
(defun integers-in (text &optional from until)
  (let ((cursor (if from (+ (or (search from text) (error "Marker assente ~S" from)) (length from)) 0))
        (values nil))
    (let ((end (or (and until (search until text :start2 cursor)) (length text))))
      (loop while (< cursor end)
            do (if (digit-char-p (char text cursor))
                   (multiple-value-bind (number next) (parse-integer text :start cursor :end end :junk-allowed t)
                     (push number values) (setf cursor next))
                   (incf cursor))))
    (nreverse values)))
(let* ((path "spikes/out/4001074655-command-41141-0/report.lisp")
       (self "spikes/out/cbor-item-read-20261015/review/final-integration-reading.lisp")
       (whitelist-path "spikes/out/cbor-item-read-20261015/drivers/nominal-whitelist.lisp")
