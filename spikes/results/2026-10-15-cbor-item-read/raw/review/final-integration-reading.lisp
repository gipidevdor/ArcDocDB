               ("tests/codec/cbor-item-read-support.lisp" "0326100362a1c4b24d2c7e511e45357f09a56d33")
               ("tests/codec/cbor-item-read.lisp" "b2cbdcb4255c51d9da4fe73b28939c1cb923fefe")
               ("tests/codec/cbor-item-read-threads.lisp" "a0da65545ed80ede0a967cadbb337731f6fe1ce9"))))
  (assert (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
               (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
               (eq :stable (getf record :source-consistency)) (equalp before after)
               (string= "203e3c719f6b5cd9c74a5dcd7fae2f1f1cfb45ed" (getf (getf record :environment) :commit))
               (string= "" (getf (getf record :environment) :working-tree))
               (equal '("make" "build" "lint" "trace" "links") (getf record :command))
               (plusp (getf record :wall-seconds))))
  (assert (= (length before) (length after)
             (length (remove-duplicates before :test #'string= :key (lambda (row) (getf row :path))))))
  (assert (>= (length before) 931))
  (dolist (pin pins)
    (dolist (inventory (list before after))
      (let ((row (find (first pin) inventory :test #'string= :key (lambda (row) (getf row :path)))))
        (assert row) (assert (string= (second pin) (getf row :git-blob)))))
    (assert (string= (second pin) (git-blob (first pin)))))
  (assert (string= "8cb9ddf8b7ceb454600e64093640679d854be039" (git-blob whitelist-path)))
  (assert (= 17 (getf whitelist :count) (length expected) (length item)))
  (assert (= (length ok) (length (remove-duplicates ok :test #'string=))))
  (assert (= 2 (length smoke)))
  (assert (null (set-exclusive-or smoke '("ok    ARCDOCDB:*VERSION* è una stringa"
                                         "ok    package ARCDOCDB presente") :test #'string=)))
  (assert (null (set-exclusive-or item expected :test #'string=)))
  (assert (>= (length nominal) 1545))
  (assert (= (length ok) (+ 2 (length nominal))))
  (assert (member "build e test: nessun avviso, tutti i controlli superati" all :test #'string=))
  (dolist (marker '("WARNING:" "STYLE-WARNING:" "Unhandled " "COMPILE-FILE-ERROR"))
    (assert (not (search marker stdout :test #'char-equal)))
    (assert (not (search marker stderr :test #'char-equal))))
  (format t "INTEGRATION schema1/OK/exit0/STABLE HEAD203e3c719f6b5cd9c74a5dcd7fae2f1f1cfb45ed clean;~D unique sources before=after;4 frozen pins before/after/current;wall~S s.~%"
          (length before) (getf record :wall-seconds))
  (format t "OK~D unique = nominal~D+smoke2;item17 exact frozen names.~%STDOUT~Dchars STDERR~Dchars ~D optimization-note lines,0 forbidden warning/style/Unhandled/compilefail markers.~%"
          (length ok) (length nominal) (length stdout) (length stderr)
          (count-if (lambda (line) (search "note:" line :test #'char-equal)) (lines stderr)))
  (format t "SMOKE ~S~%" smoke)
  (dolist (line item) (write-line line))
  (dolist (entry '((" file, " " violazioni" 2) (" requisiti," " errori" 5)
                    (" file, " " rotti" 3)))
    (let ((selected (remove-if-not
                     (lambda (line)
                       (and (plusp (length line)) (digit-char-p (char line 0))
                            (search (first entry) line) (search (second entry) line))) all)))
      (assert (= 1 (length selected)))
      (let ((counts (integers-in (first selected))))
        (assert (= (third entry) (length counts)))
        (assert (zerop (car (last counts))))
        (assert (every #'plusp (butlast counts))))
      (write-line (first selected))))
  (let ((waves (remove-if-not (lambda (line) (prefixp "  CBOR item: onda " line)) all)))
    (assert (= 2 (length waves)))
    (loop for line in waves for wave from 0
          do (assert (equal (list wave 2 4096) (integers-in line "onda " "; WALL")))
             (let* ((left (integers-in line "worker 0 start/first/end " "; worker 1"))
                    (right (integers-in line "worker 1 start/first/end " "; overlap"))
                    (overlap-data (integers-in line "; overlap " "; nessuna")))
               (assert (= 2 (length overlap-data)))
               (assert (= 1000000 (second overlap-data)))
               (dolist (tuple (list left right))
                 (assert (= 4 (length tuple))) (assert (<= (first tuple) (second tuple) (third tuple)))
                 (assert (< (first tuple) (third tuple))) (assert (= 74129408 (fourth tuple))))
               (assert (<= (max (second left) (second right)) (min (third left) (third right))))
               (assert (= (first overlap-data) (- (min (third left) (third right)) (max (first left) (first right)))))
               (assert (plusp (first overlap-data))))
