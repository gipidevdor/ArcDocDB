  (assert (member "  CBOR item fuzz: seed49544538, 1024 casi, 512 successi e 64 ciascuno byte/nodi/depth/nonminimal/range/workspace/byte-limit/truncated."
                  all :test #'string=))
  (dolist (pin pins) (assert (string= (second pin) (git-blob (first pin)))))
  (dolist (input inputs) (assert (equal input (fingerprint (first input)))))
