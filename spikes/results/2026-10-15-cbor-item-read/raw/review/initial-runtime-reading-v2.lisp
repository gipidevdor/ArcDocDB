(defun lines (string)
  (with-input-from-string (stream string)
    (loop for line = (read-line stream nil) while line
          collect (string-right-trim '(#\Return) line))))
(defun prefixp (prefix string)
  (and (<= (length prefix) (length string))
       (string= prefix string :end2 (length prefix))))
(defun literal (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof))) (assert (eq eof (read stream nil eof))) form))))
(defun fingerprint (path)
  (list (namestring (pathname path)) (arcdocdb.evidence:file-bytes path)
        (arcdocdb.evidence:file-sha256 path)))
(defun git-blob (path)
  (let ((process (sb-ext:run-program "git" (list "hash-object" path)
                                   :search t :wait nil :output :stream :error :stream)))
    (unwind-protect
         (let ((blob (read-line (sb-ext:process-output process) nil)))
           (assert (eq :eof (read-line (sb-ext:process-output process) nil :eof)))
           (assert (eq :eof (read-line (sb-ext:process-error process) nil :eof)))
           (sb-ext:process-wait process)
           (assert (eq :exited (sb-ext:process-status process)))
           (assert (eql 0 (sb-ext:process-exit-code process)))
           (assert (and (stringp blob) (= 40 (length blob)))) blob)
      (sb-ext:process-close process))))
(defun integers-in (line from until)
  (let ((start (search from line)) (values nil))
    (assert start)
    (incf start (length from))
    (let ((end (or (and until (search until line :start2 start)) (length line))))
      (loop while (< start end)
            do (if (digit-char-p (char line start))
                   (multiple-value-bind (value next)
                       (parse-integer line :start start :end end :junk-allowed t)
                     (push value values) (setf start next))
                   (incf start))))
    (nreverse values)))

