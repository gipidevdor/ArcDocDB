    (dotimes (i 23) (setf (aref buffer i) (mod (+ #xa7 (* i 37)) 256)))
    (replace buffer contents :start1 7) (replace buffer tail :start1 14)
    (let ((token (+ (* 17 6) (* 31 2) 14
