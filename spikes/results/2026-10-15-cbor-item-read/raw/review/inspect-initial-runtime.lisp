(load "tools/evidence-storage.lisp")
(defun data-lines (text)
  (with-input-from-string (stream text)
    (loop for line = (read-line stream nil) while line collect line)))
(dolist (path '("spikes/out/4001073649-command-78906-0/report.lisp"
                "spikes/out/4001073636-command-77979-0/report.lisp"))
  (let* ((record (arcdocdb.evidence:read-evidence path))
         (stdout (getf record :stdout)) (stderr (getf record :stderr)))
    (format t "~&PATH ~A~%KEYS ~S~%" path (loop for (key value) on record by #'cddr collect key))
    (dolist (key '(:kind :status :exit-code :command :wall-seconds :source-consistency :environment))
      (format t "~S ~S~%" key (getf record key)))
    (format t "SOURCES ~D before/~D after OUTPUT ~D/~Dchars~%"
            (length (getf record :source-blobs-before)) (length (getf record :source-blobs-after))
            (length stdout) (length stderr))
    (if (search "78906" path)
        (let* ((all (data-lines stdout))
               (ok (remove-if-not (lambda (line) (and (<= 6 (length line)) (string= "ok    " line :end2 6))) all))
               (nominal (remove-if-not (lambda (line) (search "ok    TEST-" line)) ok)))
          (format t "OK ~D NOMINAL ~D UNIQUE ~D~%" (length ok) (length nominal) (length (remove-duplicates ok :test #'string=)))
          (dolist (line all)
            (when (or (search "CBOR item" line) (search "CBR-008" line)
                      (search " file, " line) (search "requisiti," line) (search "build e test:" line))
              (write-line line)))
          (format t "STDERR notes ~D~%" (count-if (lambda (line) (search "note:" line)) (data-lines stderr))))
        (with-input-from-string (stream stdout)
          (let ((inner (arcdocdb.evidence::%read-plist-stream stream path)))
            (format t "INNER KEYS ~S~%" (loop for (key value) on inner by #'cddr collect key))
            (dolist (key '(:kind :status :files :snapshot :source-count :files-count :entries))
              (let ((value (getf inner key :absent)))
                (format t "INNER ~S ~S~%" key (if (listp value) (list :list-length (length value) :first (first value)) value)))))))))
