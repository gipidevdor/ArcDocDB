         (mapcar (lambda (suffix) (concatenate 'string "ok    TEST-REQ-CBR-008-ITEM-" suffix))
                 '("LITERAL-ALL-MAJORS-AND-UNREAD-POISON-TAIL"
                   "INTEGER-TAG-AND-STRING-WIDTH-BOUNDARIES"
                   "CONCATENATED-FRONTIERS-AND-EXACT-SCANNERS-STILL-TRAILING"
                   "AUTHORIZED-END-PHYSICAL-SENTINELS-AND-NONZERO-START"
                   "BUFFER-TYPE-RANGE-AND-WHOLE-BACKING-ARRAY-PRESERVATION"
                   "WORKSPACE-TYPE-ALIAS-AND-PREFLIGHT-BEFORE-RESET"
                   "CONFIGURED-LIMITS-AND-ALL-PREFLIGHT-PRECEDENCES"
                   "BYTE-BUDGET-INCLUDES-ENTIRE-WINDOW-AND-UNREAD-TAIL"
                   "ROOT-AND-TAG-CHAIN-NODE-BUDGET-WITHOUT-TAIL-NODES"
                   "DEPTH-ZERO-AND-100-101-WITHOUT-TAIL-DEPTH"
                   "MALFORMED-FIRST-ITEM-ABSOLUTE-ERRORS-AND-MINIMALITY"
                   "EVERY-TRUNCATION-IS-BOUNDED-BY-AUTHORIZED-END"
                   "HEADER-PREFERENCE-BEFORE-NODES-DEPTH-AND-PAYLOAD"
                   "SCRATCH-REUSE-AND-CONTENT-STATISTICS-WITHOUT-TAIL"
                   "FULL-16MIB-WINDOW-TAIL-AND-COMPLETE-PAYLOAD-BOUNDARY"
                   "FIXED-SEED-1024-FUZZ-AND-FROZEN-CLASS-COUNTS"
                   "TWO-REUSED-WORKERS-PRIVATE-SCRATCH-AND-READONLY-BUFFER")))
       (pins '(("src/codec/cbor-item-read.lisp" "b9099dc8a8c96281063811e686deb4dcb2b1d39b")
               ("tests/codec/cbor-item-read-support.lisp" "0326100362a1c4b24d2c7e511e45357f09a56d33")
               ("tests/codec/cbor-item-read.lisp" "b2cbdcb4255c51d9da4fe73b28939c1cb923fefe")
               ("tests/codec/cbor-item-read-threads.lisp" "a0da65545ed80ede0a967cadbb337731f6fe1ce9"))))
  (assert (and (eql 1 (getf descriptor :schema-version)) (eq :compressed-evidence (getf descriptor :kind))
               (eq :gzip (getf descriptor :codec))
               (plusp (getf descriptor :compressed-bytes)) (plusp (getf descriptor :uncompressed-bytes))))
  (assert (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
               (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
               (eq :stable (getf record :source-consistency)) (equalp before after)
               (= 931 (length before) (length (remove-duplicates before :test #'string=
                                                        :key (lambda (row) (getf row :path)))))
               (string= "46aee8b920d447aafae4a4e47a44d13631c47cb1" (getf (getf record :environment) :commit))
               (string= "" (getf (getf record :environment) :working-tree))
               (plusp (getf record :wall-seconds))
               (equal '("check-core") (last (getf record :command)))))
  (dolist (pin pins)
    (let ((row (find (first pin) before :key (lambda (entry) (getf entry :path)) :test #'string=)))
      (assert row) (assert (string= (second pin) (getf row :git-blob)))))
  (assert (and (= 1551 (length ok) (length (remove-duplicates ok :test #'string=)))
               (= 1545 (length nominal)) (= 2 (length smoke)) (= 4 (length linter))
               (= 17 (length item-ok) (length (remove-duplicates item-ok :test #'string=)))
               (null (set-exclusive-or item-ok expected :test #'string=))))
  (assert (member "build e test: nessun avviso, tutti i controlli superati" all :test #'string=))
  (dolist (line '("225 file, 0 violazioni"
                  "122 requisiti, 65 invarianti, 13 scenari FI, 52 ADR: 0 errori"))
    (assert (member line all :test #'string=)))
  (let* ((line (find-if (lambda (line) (search " link controllati, " line)) all))
         (values (progn (assert line) (integers-in line "" nil))))
    (assert (and (= 3 (length values)) (plusp (first values)) (plusp (second values)) (zerop (third values))))
    (format t "LINKS actual-record ~A~%" line))
  ;; I negativi attesi sono serializzati dopo il marker esatto di completamento build.
  (let* ((complete (search "build e test: nessun avviso, tutti i controlli superati" stdout))
         (build-stdout (progn (assert complete) (subseq stdout 0 complete))))
    (assert (not (some (lambda (marker)
                        (or (search marker build-stdout :test #'char-equal)
                            (search marker stderr :test #'char-equal)))
                      '("WARNING:" "STYLE-WARNING:" "COMPILE-FILE-ERROR" "Unhandled ")))))
  (format t "INPUT descriptor~D bytes SHA~A; gzip~D SHA~A; expanded-raw~D SHA~A verified by trusted reader/EOF/READ-EVAL NIL.~%"
          (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)
          (getf descriptor :compressed-bytes) (getf descriptor :compressed-sha256)
          (getf descriptor :uncompressed-bytes) (getf descriptor :uncompressed-sha256))
  (format t "COMMAND ~S~%OUTER schema1/COMMAND-VERIFICATION OK/exit0/STABLE wall~S HEAD~A clean; sources931 unique before=after; frozen4pins matched.~%"
          (getf record :command) (getf record :wall-seconds) (getf (getf record :environment) :commit))
  (format t "OUTPUT stdout~D chars stderr~D chars; warning/compile/Unhandled markers0 in compiler-build phase and main STDERR; stderr optimization-note lines~D.~%"
          (length stdout) (length stderr)
          (count-if (lambda (line) (search "note:" line :test #'char-equal)) (lines stderr)))
  (format t "OK1551 unique = nominal1545 + smoke2 + linter-selftest4; item17 exact frozen functions.~%SMOKE ~S~%LINTER ~S~%" smoke linter)
  (dolist (line item-ok) (write-line line))
  (write-line "225 file, 0 violazioni")
  (write-line "122 requisiti, 65 invarianti, 13 scenari FI, 52 ADR: 0 errori")
  (let ((fuzz (find-if (lambda (line) (search "seed49544538" line)) all))
        (state #x49544538) (counts (make-array 9 :initial-element 0)))
    (assert (and fuzz (search "1024" fuzz) (search "512" fuzz) (search "64" fuzz)))
    (dotimes (iteration 1024)
      (setf state (logand #xffffffff (+ (* state 1664525) 1013904223)))
      (incf (aref counts (if (< (mod iteration 16) 8) 0 (- (mod iteration 16) 7)))))
    (assert (= state #x6cb25938)) (assert (equalp counts #(512 64 64 64 64 64 64 64 64)))
    (write-line fuzz) (format t "COLD LCG final6CB25938 counts~S; final state asserted by frozen test, not printed in raw.~%" counts))
  (let ((waves (remove-if-not (lambda (line) (prefixp "  CBOR item: onda " line)) all)))
    (assert (= 2 (length waves)))
    (loop for line in waves for wave from 0
          do (assert (equal (list wave 2 4096) (integers-in line "onda " "; WALL")))
             (assert (search "2 worker riusati, 4096 letture; WALL fixture con rendezvous/controlli" line))
             (let* ((left (integers-in line "worker 0 start/first/end " "; worker 1"))
                    (right (integers-in line "worker 1 start/first/end " "; overlap"))
                    (overlap-data (integers-in line "; overlap " "; nessuna"))
                    (overlap (first overlap-data)) (rate (second overlap-data)))
               (assert (= 2 (length overlap-data))) (assert (= 1000000 rate))
               (dolist (tuple (list left right))
                 (assert (= 4 (length tuple))) (assert (<= (first tuple) (second tuple) (third tuple)))
                 (assert (< (first tuple) (third tuple))) (assert (= 74129408 (fourth tuple))))
               (assert (<= (max (second left) (second right)) (min (third left) (third right))))
               (assert (= overlap (- (min (third left) (third right)) (max (first left) (first right)))))
               (assert (plusp overlap)) (write-line line)
               (format t "WAVE~D overlap~,6Fs; raw timeline and sinks consistent, WALL includes rendezvous/checks.~%"
                       wave (/ overlap (float rate 1d0))))))
  (format t "ARITHMETIC planned APIcalls685+1024+8192=9901; success9255/reject646; not instrumented APIcounters. Secondary scanners520+390+2 separate.~%")
  (let* ((start (search "(:STATUS :OK :CATALOGS" stdout))
         (evidence (progn (assert start) (raw-data stdout :start start))))
    (assert (and (eq :ok (getf evidence :status))
                 (plusp (getf evidence :catalogs)) (plusp (getf evidence :artifact-references))
                 (plusp (getf evidence :stored-files))))
    (format t "EVIDENCE actual-record statusOK catalogs~D references~D stored-files~D; no archive rescan; limits~S.~%"
            (getf evidence :catalogs) (getf evidence :artifact-references) (getf evidence :stored-files) (getf evidence :limits)))
  (let* ((start (search "(:SCHEMA-VERSION 1 :KIND :EVIDENCE-PUBLICATION-TESTS" stdout))
         (publication (progn (assert start) (raw-data stdout :start start))))
    (assert (and (eql 1 (getf publication :schema-version)) (eq :evidence-publication-tests (getf publication :kind))
