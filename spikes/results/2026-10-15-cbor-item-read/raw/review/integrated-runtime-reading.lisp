(in-package #:cbor.item.integrated.reading)

(defun lines (string)
  (with-input-from-string (stream string)
    (loop for line = (read-line stream nil) while line
          collect (string-right-trim '(#\Return) line))))
(defun prefixp (prefix string)
  (and (<= (length prefix) (length string)) (string= prefix string :end2 (length prefix))))
(defun number-after (line label)
  (let ((position (search label line)))
    (assert position)
    (multiple-value-bind (value end)
        (parse-integer line :start (+ position (length label)) :junk-allowed t)
      (assert value) (values value end))))
(defun literal-descriptor (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof))) (assert (eq eof (read stream nil eof))) form))))

(defun raw-data (string &key (start 0) eof-required)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (eof (gensym)))
    (with-input-from-string (stream string :start start)
      (let ((form (read stream nil eof)))
        (assert (not (eq form eof)))
        (when eof-required (assert (eq eof (read stream nil eof)))) form))))
(defun text (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((string (make-string (file-length stream))))
      (subseq string 0 (read-sequence string stream)))))
(defun embedded-selftest (stdout marker)
  (let* ((begin (search marker stdout))
         (line-end (and begin (position #\Newline stdout :start begin)))
         (start (and line-end (search "(:" stdout :start2 line-end))))
    (assert start) (raw-data stdout :start start)))
(defun pin-path (path pins)
  (pushnew (cons (namestring (pathname path)) (arcdocdb.evidence:file-sha256 path)) pins :test #'equal)
  (when (string= "gz" (or (pathname-type path) "")) (error "Descriptor expected."))
  (unless (zerop (arcdocdb.evidence:file-bytes path))
    (let ((descriptor (literal-descriptor path)))
      (when (eq :compressed-evidence (getf descriptor :kind))
        (let ((payload (merge-pathnames (getf descriptor :payload) path)))
          (pushnew (cons (namestring payload) (arcdocdb.evidence:file-sha256 payload)) pins :test #'equal)))))
  pins)

(defun reference-path (stdout marker)
  (let* ((start (search marker stdout))
         (a (and start (+ start (length marker))))
         (b (and a (position #\Newline stdout :start a))))
    (assert a)
    (let ((path (string-trim '(#\Space #\Tab #\Return #\.) (subseq stdout a b))))
      (assert (probe-file path)) path)))

(defun check-selftest (stdout path marker kind child-kind count sources pins)
  (let* ((metadata (embedded-selftest stdout marker))
         (fixture (arcdocdb.evidence:read-evidence path))
         (expected-kind (if (eq kind :snapshot-mutations) :snapshot-process-self-test :reader-process-self-test)))
    (setf pins (pin-path path pins))
    (assert (and (eql 1 (getf metadata :schema-version)) (eq kind (getf metadata :kind))
                 (eq :ok (getf metadata :status)) (eq :stable (getf metadata :source-consistency))
                 (let ((actual (length (getf metadata :source-fingerprints-before)))) (and (plusp actual) (or (null sources) (= sources actual))))
                 (equalp (getf metadata :source-fingerprints-before) (getf metadata :source-fingerprints-after))
                 (eql 0 (getf metadata :worker-errors)) (null (getf metadata :baseline))
                 (null (getf metadata :mutants)) (= count (length (getf metadata :targets)))
                 (eq :ok (getf (getf metadata :self-test) :status))
                 (= count (getf (getf metadata :self-test) :unique-targets))
                 (equal (truename path) (truename (getf metadata :process-fixtures)))))
    (assert (and (eql 1 (getf fixture :schema-version)) (eq expected-kind (getf fixture :kind))
                 (eq :passed (getf fixture :status)) (eql 2 (getf fixture :worker-errors))
                 (= 2 (length (getf fixture :mutants))) (null (getf fixture :baseline))))
    (loop for row in (getf fixture :mutants) for name in '(:signal :completion-exit)
          for execution = (getf row :execution) for reported = (getf execution :report)
          for raw-path = (getf execution :stdout-log) for stderr-path = (getf execution :stderr-log)
          for raw = (raw-data (text raw-path) :eof-required t)
          do (setf pins (pin-path raw-path pins))
             (setf pins (pin-path stderr-path pins))
             (assert (and (eq name (getf row :name)) (eq :worker-error (getf row :result))
                          (null (getf execution :timed-out))
                          (= 0 (arcdocdb.evidence:file-bytes stderr-path))
                          (equalp raw reported) (eql 1 (getf raw :schema-version))
                          (eq child-kind (getf raw :kind))))
             (if (eq name :signal)
                 (assert (and (eql 137 (getf execution :exit-code)) (eql 9 (getf execution :signal))
                              (eq :failed (getf raw :status)) (eq :tests (getf raw :phase))
                              (eq :runtime (getf raw :failure-kind)) (string= "fixture" (getf raw :failed-test))))
                 (assert (and (eql 7 (getf execution :exit-code)) (null (getf execution :signal))
                              (eq :ok (getf raw :status)) (eq :complete (getf raw :phase))
                              (equal '("fixture") (getf raw :passed-tests)))))
             (format t "SELF ~S negative~S => WORKER-ERROR exit~D signal~S; raw EOF matches metadata, stderr0.~%"
                     kind name (getf execution :exit-code) (getf execution :signal)))
    (format t "SELF ~S outerOK/worker-errors0 source~D STABLE; direct PASSED/expected-worker-errors2; catalogue~D not executed as mutation campaign.~%LIMITS ~S~%"
            kind (length (getf metadata :source-fingerprints-before)) count (getf metadata :limits)) pins))

(defun check-spikes (stdout outer pins)
  (let* ((path (reference-path stdout "10 spike completati; risultati: "))
         (aggregate (arcdocdb.evidence:read-evidence path)) (runs (getf aggregate :runs))
         (artifacts (getf aggregate :run-artifacts)))
    (assert (search "10 spike completati; risultati:" stdout))
    (setf pins (pin-path path pins))
    (assert (and (eql 1 (getf aggregate :schema-version)) (eq :complete (getf aggregate :status))
                 (string= "--check" (getf aggregate :mode)) (= 10 (length runs) (length artifacts))))
    (loop for run in runs for artifact in artifacts for number from 1
          for id = (format nil "SPK-~2,'0D" number)
          for stored = (arcdocdb.evidence:read-evidence artifact)
          for raw = (raw-data (getf stored :stdout) :eof-required t)
          do (setf pins (pin-path artifact pins))
             (assert (and (equalp run stored) (string= id (getf stored :id))
                          (eql 1 (getf stored :schema-version)) (eql 0 (getf stored :exit-code))
                          (member (getf stored :status) '(:ok :pass))
                          (eq :stable (getf stored :source-consistency))
                          (equalp (getf stored :source-blobs-before) (getf stored :source-blobs-after))
                          (equalp raw (getf stored :result))
                          (eq (getf raw :status) (getf stored :status))
                          (plusp (getf stored :wall-seconds))
                          (<= (getf outer :started-at-universal-time) (getf stored :started-at-universal-time)
                              (getf stored :finished-at-universal-time) (getf outer :finished-at-universal-time))
                          (zerop (length (getf stored :stderr)))))
             (format t "CHILD ~A schema1 exit0/~S source~D STABLE wall~S; aggregate=artifact, raw single-form EOF=RESULT (structural arrays), within parent, stderr0.~%"
                     id (getf stored :status) (length (getf stored :source-blobs-before))
                     (getf stored :wall-seconds))) pins))

(defun integers-in (line from until)
  (let ((start (search from line)) (values nil))
    (assert start) (incf start (length from))
    (let ((end (or (and until (search until line :start2 start)) (length line))))
      (loop while (< start end)
            do (if (digit-char-p (char line start))
                   (multiple-value-bind (value next) (parse-integer line :start start :end end :junk-allowed t)
                     (push value values) (setf start next)) (incf start))))
    (nreverse values)))

(let* ((args (rest sb-ext:*posix-argv*))
       (path (progn (assert (= 1 (length args))) (first args)))
       (self "spikes/out/cbor-item-read-20261015/review/integrated-runtime-reading.lisp")
       (self-sha (arcdocdb.evidence:file-sha256 self))
       (physical-pins (pin-path path nil))
       (descriptor (literal-descriptor path))
       (record (arcdocdb.evidence:read-evidence path))
       (before (getf record :source-blobs-before)) (after (getf record :source-blobs-after))
       (stdout (getf record :stdout)) (stderr (getf record :stderr)) (all (lines stdout))
       (ok (remove-if-not (lambda (line) (prefixp "ok    " line)) all))
       (nominal (remove-if-not (lambda (line) (prefixp "ok    TEST-" line)) ok))
       (linter (remove-if-not (lambda (line)
                               (some (lambda (prefix) (prefixp prefix line))
