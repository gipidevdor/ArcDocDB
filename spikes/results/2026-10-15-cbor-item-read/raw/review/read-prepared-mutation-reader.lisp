;;;; Soltanto READ del nuovo lettore e cataloghi gia congelati; nessuna campagna aperta.
(require :asdf)
(require :sb-md5)
(let ((package (or (find-package "ARCDOCDB.EVIDENCE")
                   (make-package "ARCDOCDB.EVIDENCE" :use '("CL")))))
  (dolist (name '("READ-EVIDENCE" "FILE-BYTES" "FILE-SHA256"))
    (export (intern name package) package)))
(let ((*read-eval* nil) (forms 0))
  (with-open-file (stream "spikes/out/cbor-item-read-20261015/review/mutation-reading.lisp")
    (loop for form = (read stream nil :eof) until (eq form :eof) do (incf forms)))
  (format t "Lettore preparato DATA-EOF,~Dforme READ-EVAL NIL; nessuna forma valutata/caricata.~%" forms))
(flet ((one (path)
         (let ((*read-eval* nil) (eof (gensym)))
           (with-open-file (stream path)
             (let ((data (read stream nil eof)))
               (assert (not (eq data eof))) (assert (eq eof (read stream nil eof))) data)))))
  (let* ((catalogue (one "spikes/out/cbor-item-read-20261015/drivers/catalogue-materialized.lisp"))
         (whitelist (one "spikes/out/cbor-item-read-20261015/drivers/nominal-whitelist.lisp"))
         (targets (getf catalogue :unique-source-substitutions)))
    (assert (eq :cbor-item-materialized-catalogue (getf catalogue :kind)))
    (assert (= 8 (length targets)))
    (dolist (target targets)
      (assert (= 4 (list-length target))) (assert (every #'stringp target))
      (assert (string= "src/codec/cbor-item-read.lisp" (first target))))
    (assert (= 17 (getf whitelist :count) (length (getf whitelist :functions))))
    (format t "Catalogo DATA-EOF: :UNIQUE-SOURCE-SUBSTITUTIONS8tuple da4stringhe,1source; whitelist17funzioni. Nessun report/log/copia corrente letto.~%")))
