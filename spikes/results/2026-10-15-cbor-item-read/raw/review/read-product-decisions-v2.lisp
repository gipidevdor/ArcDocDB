(let ((*read-eval* nil) (forms 0) (functions 0) (unlesses 0) (whens 0)
      (loops 0) (errors 0) (compounds 0) (operands 0) (comparisons 0) (chains 0))
  (labels ((walk (form)
             (when (consp form)
               (let ((head (first form)))
                 (when (symbolp head)
                   (case head
                     (defun (incf functions)) (unless (incf unlesses))
                     (when (incf whens)) (loop (incf loops)) (error (incf errors))
                     ((and or) (incf compounds) (incf operands (length (rest form))))
                     ((< <= = /= > >=)
                      (incf comparisons)
                      (when (> (length (rest form)) 2) (incf chains)))))
               (unless (eq (first form) 'quote) (mapc #'walk form))))))
    (with-open-file (stream "src/codec/cbor-item-read.lisp")
      (loop for form = (read stream nil :eof) until (eq form :eof)
            do (incf forms) (walk form))))
  (assert (= forms 4)) (assert (= functions 1))
  (assert (= unlesses 5)) (assert (= whens 1)) (assert (= loops 1))
  (assert (= errors 5)) (assert (zerop compounds)) (assert (zerop operands))
  (assert (= comparisons 4)) (assert (zerop chains))
  (format t "~&DATA-EOF READ-EVAL NIL: ~D forme, ~D DEFUN, ~D UNLESS/~D WHEN, ~D LOOP, ~D ERROR, ~D AND/OR (~D operandi), ~D confronti numerici (~D catene).~%"
          forms functions unlesses whens loops errors compounds operands comparisons chains)
  (format t "Percorsi sintattici: base1+5UNLESS+1WHEN+1LOOP=8; DEFUN righe10-43=34 (conteggio manuale).~%")
  (format t "Nessun LOAD/EVAL/COMPILE del prodotto; nessuna misura runtime o attestazione MC/DC.~%"))
