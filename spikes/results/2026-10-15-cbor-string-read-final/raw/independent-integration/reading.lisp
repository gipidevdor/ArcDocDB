;;;; C4 DATA: integrazione fallita al gate links e successiva sola verifica links.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:string.integration.reading (:use #:cl))
(in-package #:string.integration.reading)
(unless (find-package "ARCDOCDB.CBOR") (make-package "ARCDOCDB.CBOR" :use '("CL")))
(export (intern "LEGGI-STRINGA-CBOR-MINIMA" "ARCDOCDB.CBOR") "ARCDOCDB.CBOR")
(defvar *checks* 0)
(defun ck (value reason) (incf *checks*) (unless value (error "Integration DATA ~S" reason)))
(defparameter *pins*
  '(("src/codec/cbor-string-read.lisp" "d4a4f774c2264c46349e7eda61ee4a2a3118d742")
    ("tests/codec/cbor-string-read-support.lisp" "cfd55cd47d782673113e67af625c1360195a345c")
    ("tests/codec/cbor-string-read.lisp" "8437bdcaa4cf308dbf4614e748cdab4be2ae6d62")
    ("tests/codec/cbor-string-read-threads.lisp" "8fc4ae5d9214108a6ae6bf26e644db1a42733cdd")))
(defparameter *paths*
  '("spikes/out/4001085841-command-55587-0/report.lisp"
    "spikes/out/4001085841-command-55587-0/report.lisp.gz"
    "spikes/out/4001086070-command-61411-0/report.lisp"
    "spikes/out/4001086038-command-60740-0/report.lisp"
    "spikes/out/4001085907-command-57424-0/report.lisp"
    "spikes/out/cbor-string-read-20261015/coverage/coverage-state.lisp"
    "spikes/out/cbor-string-read-20261015/coverage/coverage-state.lisp.gz"
    "spikes/out/cbor-string-read-20261015/independent-integration/reading.lisp"))
(defun observation (path) (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun blob (path)
  (string-trim '(#\Space #\Newline #\Return) (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun pl (value)
  (ck (and (consp value) (list-length value) (evenp (length value))) :plist)
  (let ((seen nil))
    (loop for key in value by #'cddr do (ck (and (keywordp key) (not (member key seen))) :unique-key) (push key seen))) value)
(defun one-data (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*package* (find-package :cl-user)) (eof (gensym)))
    (with-input-from-string (stream text)
      (let ((data (read stream nil eof))) (ck (not (eq data eof)) :present-data) (ck (eq eof (read stream nil eof)) :single-data-eof) (pl data)))))
(defun record-check (record status exit)
  (pl record)
  (ck (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
           (eq status (getf record :status)) (eql exit (getf record :exit-code)) (null (getf record :signal))
           (eq :stable (getf record :source-consistency)) (integerp (getf record :finished-at-universal-time))
           (<= (getf record :started-at-universal-time) (getf record :finished-at-universal-time))
           (equal (getf record :source-blobs-before) (getf record :source-blobs-after))) :completed-status-stable)
  (let ((env (pl (getf record :environment))) (before (getf record :source-blobs-before)))
    (ck (and (string= (getf env :commit) "e1bffcae6ee38fb87c079a480fede1513d1a3389") (string= (getf env :working-tree) "")) :head-clean)
    (ck (= 1019 (length before) (length (remove-duplicates before :key (lambda (entry) (getf entry :path)) :test #'string=))) :inventory1019)
    (dolist (pin *pins*)
      (ck (string= (second pin) (getf (find (first pin) before :key (lambda (entry) (getf entry :path)) :test #'string=) :git-blob)) :record-pin))))
(defun names-from-corpus ()
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*package* (find-package :cl-user)) (eof (gensym)) (names nil) (forms 0))
    (dolist (path '("tests/codec/cbor-string-read-support.lisp" "tests/codec/cbor-string-read.lisp" "tests/codec/cbor-string-read-threads.lisp"))
      (with-open-file (stream path :external-format :utf-8)
        (loop for form = (read stream nil eof) until (eq form eof) do (incf forms)
              (when (and (consp form) (symbolp (car form)) (string= "DEFTEST" (symbol-name (car form))))
                (push (format nil "ok    ~A" (symbol-name (second form))) names)))))
    (ck (= 31 forms) :corpus31forms) (ck (= 17 (length names)) :corpus17) names))
(defun occurrences (needle haystack)
  (loop with start = 0 for pos = (search needle haystack :start2 start :test #'char-equal)
        while pos count pos do (setf start (+ pos (length needle)))))
(let* ((observations (mapcar #'observation *paths*))
       (pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*))
       (failed (arcdocdb.evidence:read-evidence (first *paths*)))
       (links (arcdocdb.evidence:read-evidence (third *paths*)))
       (rename (arcdocdb.evidence:read-evidence (fourth *paths*)))
       (compact (arcdocdb.evidence:read-evidence (fifth *paths*)))
       (lines (uiop:split-string (getf failed :stdout) :separator '(#\Newline)))
       (marker "build e test: nessun avviso, tutti i controlli superati")
       (boundary (position marker lines :test #'string=))
       (product-lines (subseq lines 0 boundary))
       (oks (remove-if-not (lambda (line) (uiop:string-prefix-p "ok    " line)) product-lines))
       (smoke '("ok    package ARCDOCDB presente" "ok    ARCDOCDB:*VERSION* è una stringa"))
       (nominals (set-difference oks smoke :test #'string=))
       (fresh (remove-if-not (lambda (line) (search "TEST-REQ-CBR-009-STRING-" line :test #'char-equal)) nominals))
       (expected (names-from-corpus))
       (broken (remove-if-not (lambda (line) (uiop:string-prefix-p "ROTTO  " line)) lines)))
  (ck (equal pins *pins*) :current-pins)
  (record-check failed :failed 2) (record-check links :ok 0) (record-check rename :ok 0) (record-check compact :ok 0)
  (ck (equal (getf failed :command) '("make" "test" "lint" "trace" "links")) :combined-command)
  (ck (equal (getf links :command) '("make" "links")) :links-only-command)
  (ck (= 1 (count marker lines :test #'string=)) :one-build-marker)
  (ck (every (lambda (line) (= 1 (count line oks :test #'string=))) smoke) :two-smokes-once)
  (ck (= 1745 (length oks)) :all-product-oks)
  (ck (= 1743 (length nominals) (length (remove-duplicates nominals :test #'string-equal))) :unique1743)
  (ck (every (lambda (line) (string-equal "TEST-" line :start2 6 :end2 11)) nominals) :test-names-only)
  (ck (= 17 (length fresh) (length (remove-duplicates fresh :test #'string-equal))) :new17)
  (ck (and (null (set-difference fresh expected :test #'string-equal)) (null (set-difference expected fresh :test #'string-equal))) :corpus-exact-names)
  (ck (member "249 file, 0 violazioni" lines :test #'string=) :lint-pass)
  (ck (member "127 requisiti, 66 invarianti, 13 scenari FI, 53 ADR: 0 errori" lines :test #'string=) :trace-pass)
  (ck (member "517 file, 3718 link controllati, 282 rotti" lines :test #'string=) :failed-links-summary)
  (ck (= 282 (length broken)) :all282-broken)
  (ck (every (lambda (line) (uiop:string-prefix-p "ROTTO  spikes/out/cbor-string-read-20261015/frozen-qualification/" line)) broken) :only-frozen-copies-broken)
  (ck (search "make: *** [links] Error 1" (getf failed :stderr)) :make-links-failure)
  (ck (string= (getf links :stdout) (format nil "sbcl --script tools/check-links.lisp .~%511 file, 3430 link controllati, 0 rotti~%")) :fixed-links-exact-output)
  (ck (string= (getf links :stderr) "") :fixed-links-stderr0)
  (let* ((data (one-data (getf rename :stdout))) (moves (getf data :moves))
         (target-observations (mapcar (lambda (move) (observation (getf move :target))) moves)))
    (ck (and (eq :ok (getf data :status)) (eq t (getf data :bytes-preserved)) (= 6 (getf data :renamed-raw-documents) (length moves))) :six-renamed-raw-documents)
    (dolist (move moves)
      (pl move)
      (let ((source (getf move :source)) (target (getf move :target)))
        (ck (and (search "/frozen-qualification/" source) (string= target (concatenate 'string source ".txt"))
                 (not (probe-file source)) (probe-file target)
                 (string= (getf move :sha256) (arcdocdb.evidence:file-sha256 target))) :renamed-target-hash)))
    (format t "RENAME six historical raw .md to .md.txt; target SHA256 matches saved pre-rename hash; current observations~S~%" target-observations)
    (ck (equal target-observations (mapcar (lambda (move) (observation (getf move :target))) moves)) :renamed-inputs-stable))
  (arcdocdb.evidence:call-with-evidence-bytes
   (sixth *paths*) (lambda (plain)
                    (ck (= 3374141 (arcdocdb.evidence:file-bytes plain)) :raw-coverage-byte-count)
                    (ck (string= "2def05b7cc27de690b6a26bc16a02a3dac6d610c0ba024eddeb38bca27a9e298" (arcdocdb.evidence:file-sha256 plain)) :raw-coverage-preserved)))
  (format t "COMBINED FAILED exit2, completed/STABLE1019/e1bff; product nominal~D unique~D +2smoke=1745 before marker-line~D. New17exact/31corpusDATAforms. Build/test marker/lint249:0/trace127:0 pass; links282broken/allhistorical-frozen-copies fail. No combined PASS claim.~%"
          (length nominals) (length (remove-duplicates nominals :test #'string-equal)) (1+ boundary))
  (dolist (line (sort (copy-list fresh) #'string-lessp)) (write-line line))
  (format t "LINKS-ONLY PASS exit0/STABLE1019/e1bff:511files/3430links/0broken/stderr0. Compact wrapper PASS, decoded original coverage3374141/SHA256unchanged.~%FAILED-STDERR chars~D NOTE-markers~D WARNING-markers~D STYLE-WARNING-markers~D, make-links error preserved.~%"
          (length (getf failed :stderr)) (occurrences "note:" (getf failed :stderr))
          (occurrences "WARNING:" (getf failed :stderr)) (occurrences "STYLE-WARNING:" (getf failed :stderr)))
  (ck (equal observations (mapcar #'observation *paths*)) :physical-inputs-stable)
  (ck (equal pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*)) :sources-stable)
  (format t "OBSERVATIONS~S~%INTEGRATION DATA READING PASS checks~D; no source/index/HEAD edits or product/corpus/driver LOAD/compile/call.~%" observations *checks*))
