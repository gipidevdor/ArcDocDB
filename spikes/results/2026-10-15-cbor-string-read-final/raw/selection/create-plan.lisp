(require :asdf)
(let* ((base (merge-pathnames "spikes/out/cbor-string-read-20261015/" (truename "./")))
       (argument (first (uiop:command-line-arguments)))
       (records (list (list "integration-before-raw-doc-rename" "4001085841-command-55587-0")
                      (list "raw-doc-rename" "4001086038-command-60740-0")
                      (list "links-after-raw-doc-rename" "4001086070-command-61411-0")
                      (list "compact-coverage" "4001085907-command-57424-0")
                      (list "selection-plan-initial" "4001085963-command-59411-0")
                      (list "selection-plan-corrected" "4001086070-command-61410-0")
                      (list "selection-main" "4001086087-command-61648-0")
                      (list "independent-integration" "4001086202-command-65022-0")))
       (plan-file (merge-pathnames "final-selection/plan.lisp" base))
       (main-archive "spikes/results/2026-10-15-cbor-string-read/"))
  (assert (and argument (= 1 (length (uiop:command-line-arguments)))))
  (let ((plan
          (list :destination (namestring (merge-pathnames "spikes/out/cbor-string-read-manifests/final.lisp" (truename "./")))
                :records (append
                          (loop for (label directory) in records collect
                                (list label (namestring (truename (merge-pathnames (format nil "spikes/out/~A/report.lisp" directory) (truename "./"))))))
                          (list (list "main-collection" (namestring (truename argument)))))
                :roots (list (list "independent-integration" (namestring (truename (merge-pathnames "independent-integration/" base))))
                             (list "selection" (namestring (truename (merge-pathnames "final-selection/" base))))
                             (list "main-collection-observations" (namestring (truename "spikes/out/cbor-string-read-collection-main/"))))
                :frozen (list (concatenate 'string main-archive "archive-index.lisp")
                              (concatenate 'string main-archive "catalogo.lisp")))))
    (assert (not (probe-file plan-file)))
    (with-open-file (out plan-file :direction :output :if-exists :error)
      (let ((*print-readably* t)) (write plan :stream out :pretty t) (terpri out)))
    (format t "~S~%" (list :status :ok :records (length (getf plan :records))
                           :plan (namestring plan-file) :roots (length (getf plan :roots))))))
