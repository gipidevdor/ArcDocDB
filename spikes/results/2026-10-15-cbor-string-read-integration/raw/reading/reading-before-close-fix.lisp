(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((record (arcdocdb.evidence:read-evidence "spikes/out/4001086588-command-70257-0/report.lisp" :max-expanded-bytes 134217728))
       (lines (uiop:split-string (getf record :stdout) :separator '(#\Newline)))
       (marker "build e test: nessun avviso, tutti i controlli superati")
       (stop (position marker lines :test #'string=))
       (names (loop for line in (subseq lines 0 stop)
                    when (uiop:string-prefix-p "ok    " line) collect (subseq line 6)))
       (tests (remove-if-not (lambda (x) (uiop:string-prefix-p "TEST-" (string-upcase x))) names))
       (smokes (set-difference names tests :test #'string=)))
  (assert (and (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
               (eq :stable (getf record :source-consistency))))
  (assert (equal '("make" "test" "lint" "trace" "links") (getf record :command)))
  (assert (= 1 (count marker lines :test #'string=)))
  (assert (= 1751 (length tests) (length (remove-duplicates tests :test #'string-equal))))
  (assert (= 2 (length smokes)))
  (assert (= 17 (count-if (lambda (x) (uiop:string-prefix-p "TEST-REQ-CBR-009-" (string-upcase x))) tests)))
  (format t "~S~%" (list :status :ok :head (getf (getf record :environment) :commit)
                         :nominal-tests (length tests) :smoke-tests (length smokes)
                         :new-cbor-tests 17 :source-consistency :stable
                         :combined-command-exit 0 :build-markers 1))))
