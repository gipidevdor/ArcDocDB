;;;; Copia i due flussi del lettore concluso e conserva i metadata reali.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((base "spikes/out/cbor-string-read-20261015/independent-mutations/")
       (record-path "spikes/out/4001085732-command-52866-0/report.lisp")
       (record (arcdocdb.evidence:read-evidence record-path))
       (stdout (concatenate 'string base "stdout.lisp"))
       (stderr (concatenate 'string base "stderr.log"))
       (status (list :record record-path :status (getf record :status)
                     :exit-code (getf record :exit-code)
                     :source-consistency (getf record :source-consistency)
                     :source-count (length (getf record :source-blobs-before))
                     :wall-seconds (getf record :wall-seconds)
                     :stderr-bytes (length (getf record :stderr)))))
  (dolist (pair (list (cons stdout (getf record :stdout)) (cons stderr (getf record :stderr))))
    (with-open-file (stream (car pair) :direction :output :if-exists :error)
      (write-string (cdr pair) stream)))
  (with-open-file (stream (concatenate 'string base "status.lisp") :direction :output :if-exists :error)
    (write status :stream stream :pretty t) (terpri stream))
  (write status :pretty t) (terpri)
  (let ((data (arcdocdb.evidence:read-evidence stdout)))
    (remf data :observations)
    (write data :pretty t) (terpri)))
