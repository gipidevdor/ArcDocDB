;;;; Lettura DATA indipendente R1; nessun LOAD/compile/esecuzione del prodotto.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:arcdocdb.string.mutation.reading (:use #:cl))
(in-package #:arcdocdb.string.mutation.reading)
(defparameter *root* (truename "./"))
(defparameter *base* (merge-pathnames "spikes/out/cbor-string-read-20261015/" *root*))
(defparameter *campaign* (merge-pathnames "mutations-R1/" *base*))
(defparameter *driver* (merge-pathnames "mutation-driver/" *base*))
(defparameter *wrapper* (merge-pathnames "spikes/out/4001085241-command-38293-0/report.lisp" *root*))
(defparameter *product* "src/codec/cbor-string-read.lisp")
(defparameter *observed* (make-hash-table :test 'equal))
(defvar *checks* 0)

(defun ck (truth control &rest arguments)
  (unless truth (error (apply #'format nil control arguments))) (incf *checks*) t)

(defun digest (path)
  (arcdocdb.evidence:file-sha256 path))

(defun blob (path)
  (string-trim '(#\Space #\Return #\Newline)
               (uiop:run-program (list "git" "hash-object" "--" (namestring path)) :output :string)))

(defun record-observation (path sha)
  (let* ((physical (truename path)) (key (namestring physical))
         (value (list :path key :bytes (arcdocdb.evidence:file-bytes physical)
                      :sha256 sha :write-date (file-write-date physical)))
         (old (gethash key *observed*)))
    (if old (ck (equal old value) "Prova cambiata durante lettura: ~A" key)
        (setf (gethash key *observed*) value))
    physical))

(defun observe (path) (record-observation path (digest path)))

(defun batch-observe (paths)
  ;; Argomenti espliciti, in gruppi finiti; nessuna shell o autodiscovery.
  (let ((remaining (remove-duplicates (mapcar (lambda (p) (namestring (truename p))) paths) :test #'string=)))
    (loop while remaining do
      (let* ((count (min 64 (length remaining))) (group (subseq remaining 0 count))
             (stdout (uiop:run-program (append '("shasum" "-a" "256" "--") group)
                                      :output :string :error-output :string))
             (lines (remove "" (uiop:split-string stdout :separator '(#\Newline)) :test #'string=)))
        (ck (= count (length lines)) "SHA batch incompleto")
        (loop for path in group for line in lines do
          (ck (and (not (find #\Newline path)) (>= (length line) 66)
                   (every (lambda (c) (digit-char-p c 16)) (subseq line 0 64))) "SHA batch malformato")
          (record-observation path (subseq line 0 64)))
        (setf remaining (nthcdr count remaining))))))

(defun raw-one (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*package* (find-package :cl-user)) (end (gensym "EOF")))
    (with-open-file (stream path)
      (let ((data (read stream nil end)))
        (ck (not (eq data end)) "DATA vuoto: ~A" path)
        (ck (eq end (read stream nil end)) "DATA oltre EOF: ~A" path) data))))

(defun evidence (path)
  (let* ((physical (observe path)) (container (raw-one physical)))
    (when (eq :compressed-evidence (getf container :kind))
      (let ((payload (getf container :payload)))
        (ck (and (stringp payload) (not (find #\/ payload)) (not (find #\\ payload))) "Payload non sibling")
        (observe (merge-pathnames payload physical))))
    (arcdocdb.evidence:read-evidence physical :max-expanded-bytes 134217728)))

(defun data-text (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*package* (find-package :cl-user)) (end (gensym "EOF")))
    (with-input-from-string (stream text)
      (let ((data (read stream nil end)))
        (ck (and (not (eq data end)) (eq end (read stream nil end))) "Wrapper stdout non DATA/EOF") data))))

(defun octets (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((data (make-array (file-length stream) :element-type '(unsigned-byte 8))))
      (ck (= (length data) (read-sequence data stream)) "Lettura binaria incompleta") data)))

(defun current-sha (path)
  (let ((row (gethash (namestring (truename path)) *observed*)))
    (ck row "SHA non osservato: ~A" path) (getf row :sha256)))

(defun check-pins (root pins paths)
  (ck (equal paths (mapcar (lambda (p) (getf p :path)) pins)) "Inventario SHA diverso")
  (dolist (pin pins)
    (ck (string= (getf pin :sha256) (current-sha (merge-pathnames (getf pin :path) root)))
        "SHA diverso: ~A" (getf pin :path))))

(defun substitute-fragment (text before after)
  (let ((position (search before text)))
    (ck position "Frammento originale assente")
    (ck (not (search before text :start2 (1+ position))) "Frammento originale ambiguo")
    (values (concatenate 'string (subseq text 0 position) after (subseq text (+ position (length before))))
            (list :position position :before before :after after))))

(defun validate-copy (copy declaration catalog originals baseline)
  (let* ((name (getf copy :name)) (expected-root (merge-pathnames (format nil "~A/" name) *campaign*))
         (directory (pathname (getf copy :directory)))
         (paths (getf catalog :sources)) (tests (getf catalog :tests))
         (plan (evidence (merge-pathnames "plan.lisp" directory)))
         (raw (evidence (getf copy :stdout)))
         (expected-text (uiop:read-file-string (merge-pathnames *product* *root*) :external-format :utf-8))
         (edits nil) (changed nil))
    (ck (equal (truename expected-root) (truename directory)) "Root copia inattesa")
    (ck (equalp declaration (getf copy :mutant)) "Dichiarazione mutante diversa")
    (ck (equal originals (getf copy :original-source-pins)) "Pin originali copia diversi")
    (ck (and (eql 1 (getf plan :schema-version)) (equal tests (getf plan :tests))
             (equal (getf catalog :test-package) (getf plan :test-package))
             (equal (getf copy :copied-source-pins) (getf plan :files))) "Piano copia diverso")
    (check-pins directory (getf plan :files) paths)
    (ck (string= (getf copy :child-sha256) (current-sha (merge-pathnames "child.lisp" directory))) "Pin child copiato diverso")
    (ck (equalp (octets (merge-pathnames "child.lisp" directory)) (octets (merge-pathnames "child.lisp" *driver*)))
        "Child copiato diverso dal congelato")
    (when declaration
      (ck (= 1 (getf declaration :semantic-substitutions)) "Sostituzioni semantiche non unitarie")
      (ck (= (length (getf declaration :fragments)) (getf declaration :text-fragments)) "Numero frammenti diverso")
      (dolist (fragment (getf declaration :fragments))
        (multiple-value-bind (new edit) (substitute-fragment expected-text (getf fragment :before) (getf fragment :after))
          (setf expected-text new) (push edit edits))))
    (ck (equal (nreverse edits) (getf copy :edits)) "Posizioni/frammenti diversi dal parent")
    (dolist (relative paths)
      (let ((source (merge-pathnames relative *root*)) (target (merge-pathnames relative directory)))
        (if (and declaration (string= *product* relative))
            (ck (equalp (sb-ext:string-to-octets expected-text :external-format :utf-8) (octets target))
                "Prodotto mutato non coincide con i soli frammenti dichiarati")
            (ck (equalp (octets source) (octets target)) "Copia estranea alterata: ~A" relative))
        (unless (string= (current-sha source) (current-sha target)) (push relative changed))
        (let ((fasl (merge-pathnames (make-pathname :type "fasl" :defaults (pathname relative))
                                    (merge-pathnames "fasl/" directory))))
          (ck (probe-file fasl) "FASL compilato assente: ~A" relative)
          (ck (uiop:subpathp (truename fasl) (merge-pathnames "fasl/" directory)) "Cache fuori dalla copia"))))
    (ck (equal (nreverse changed) (getf copy :changed-files)) "Footprint dichiarato diverso")
    (ck (equal (getf copy :changed-files) (unless baseline (list *product*))) "Footprint non esclusivo")
    (ck (equalp raw (getf copy :child-report)) "Raw child/parent diversi")
    (ck (and (eql 1 (getf raw :schema-version)) (eq :cbor-string-read-mutation-child (getf raw :kind))
             (eq t (getf raw :compilation-completed)) (= 38 (getf raw :compiled-count) (getf raw :expected-compiled-count))
             (= 17 (getf raw :expected-test-count)) (equal paths (getf raw :compiled-files))) "Compilazione incompleta")
    (ck (and (null (getf copy :signal)) (null (getf copy :timed-out))
             (null (getf copy :parse-error)) (null (getf copy :reason))) "Errore worker/trasporto")
    (if baseline
        (ck (and (eq :ok (getf raw :phase)) (eq :ok (getf copy :classification))
                 (null (getf copy :detected)) (eql 0 (getf copy :exit-code))
                 (eq t (getf raw :tests-completed)) (null (getf raw :failed-test))
                 (equal tests (getf raw :tests-passed))) "Baseline non completa")
        (let* ((expected (getf declaration :expected-first-test))
               (position (position expected tests :test #'string=)))
          (ck position "Atteso fuori dall'inventario nominale")
          (ck (and (eq :test-failed (getf raw :phase)) (eq :detected (getf copy :classification))
                   (eq t (getf copy :detected)) (eql 1 (getf copy :exit-code))
                   (null (getf raw :tests-completed)) (equal expected (getf raw :failed-test))
                   (equal (subseq tests 0 position) (getf raw :tests-passed))
                   (stringp (getf raw :diagnostic)) (plusp (length (getf raw :diagnostic)))
                   (stringp (getf raw :condition-type))) "Rilevamento non nominale o prefisso diverso")))
    (list :name name :compiled 38 :classification (getf copy :classification)
          :exit-code (getf copy :exit-code) :signal (getf copy :signal)
          :tests-passed (length (getf raw :tests-passed)) :failed-test (getf raw :failed-test)
          :changed-files (getf copy :changed-files) :text-fragments (length (getf copy :edits))
          :stderr-bytes (arcdocdb.evidence:file-bytes (getf copy :stderr)))))

(defun main ()
  (let* ((catalog (evidence (merge-pathnames "catalog.lisp" *driver*)))
         (report (evidence (merge-pathnames "report.lisp" *campaign*)))
         (wrapper (evidence *wrapper*))
         (paths (getf catalog :sources)) (tests (getf catalog :tests))
         (copies (cons (getf report :baseline) (getf report :mutations)))
         (originals (getf report :source-pins-before)) (all-paths nil) (results nil))
    (ck (and (eq :cbor-string-read-mutation-catalog (getf catalog :kind))
             (eq :cbor-string-read-mutations (getf report :kind)) (eq :ok (getf report :status))
             (= 38 (length paths)) (= 17 (length tests)) (= 9 (length copies) (length (getf report :copies)))
             (= 8 (length (getf catalog :mutants)))) "Inventario campagna diverso")
    (ck (equalp catalog (getf report :catalog)) "Catalogo parent diverso")
    (ck (and (eq :command-verification (getf wrapper :kind)) (eq :ok (getf wrapper :status))
             (eql 0 (getf wrapper :exit-code)) (eq :stable (getf wrapper :source-consistency))
             (equal (getf wrapper :source-blobs-before) (getf wrapper :source-blobs-after))
             (equal "f7c9e0503577b45e2bd20de66c72b6e7232a8c76" (getf (getf wrapper :environment) :commit)))
        "Wrapper non OK/STABLE sul commit congelato")
    (ck (equalp report (data-text (getf wrapper :stdout))) "Wrapper stdout/report fisico diversi")
    (ck (and (equal originals (getf report :source-pins-after))
             (equal (getf report :driver-pins-before) (getf report :driver-pins-after))) "Pin before/after diversi")
    (let ((self (getf report :self-test)))
      (ck (and (eq :ok (getf self :status)) (= 12 (getf self :classification-cases))
               (= 2 (getf self :target-rejections)) (= 0 (getf self :product-executions))) "Selftest detector non conforme"))
    (dolist (relative paths) (push (merge-pathnames relative *root*) all-paths))
    (dolist (leaf '("run.lisp" "catalog.lisp" "child.lisp"))
      (push (merge-pathnames leaf *driver*) all-paths) (push (merge-pathnames leaf *campaign*) all-paths))
    (dolist (copy copies)
      (let ((directory (pathname (getf copy :directory))))
        (dolist (relative paths) (push (merge-pathnames relative directory) all-paths))
        (push (merge-pathnames "child.lisp" directory) all-paths)
        (push (merge-pathnames "plan.lisp" directory) all-paths)
        (push (pathname (getf copy :stdout)) all-paths) (push (pathname (getf copy :stderr)) all-paths)))
    (batch-observe all-paths)
    (check-pins *root* originals paths)
    (check-pins *driver* (getf report :driver-pins-before) '("run.lisp" "catalog.lisp" "child.lisp"))
    (dolist (pin (getf catalog :frozen-blobs))
      (ck (string= (second pin) (blob (merge-pathnames (first pin) *root*))) "Blob fonte congelata diverso"))
    (loop for leaf in '("run.lisp" "catalog.lisp" "child.lisp")
          for expected in '("867843182ed779ce3e69447d30c31e2108355a22" "df01668036d0b9fcd9825bb87b8830c621f86a3b" "62d888ba880578cd047d594c47e358bc74c7645e") do
      (ck (string= expected (blob (merge-pathnames leaf *driver*))) "Blob driver inatteso")
      (ck (equalp (octets (merge-pathnames leaf *driver*)) (octets (merge-pathnames leaf *campaign*)))
          "Driver archiviato diverso"))
    (loop for copy in copies for prior in (getf report :copies) do
      (dolist (key '(:name :directory :mutant :original-source-pins :copied-source-pins :changed-files :edits :child-sha256))
        (ck (equalp (getf copy key) (getf prior key)) "Preparazione/esecuzione copia diverse")))
    (ck (equal (cons "baseline" (mapcar (lambda (m) (getf m :id)) (getf catalog :mutants)))
               (mapcar (lambda (m) (getf m :name)) copies)) "Ordine/nomi copie diversi")
    (push (validate-copy (first copies) nil catalog originals t) results)
    (loop for copy in (rest copies) for declaration in (getf catalog :mutants) do
      (push (validate-copy copy declaration catalog originals nil) results))
    (batch-observe (loop for key being the hash-keys of *observed* collect key))
    (ck (string= "f7c9e0503577b45e2bd20de66c72b6e7232a8c76"
                 (string-trim '(#\Space #\Newline #\Return) (uiop:run-program '("git" "rev-parse" "HEAD") :output :string)))
        "HEAD cambiato")
    (list :schema-version 1 :kind :independent-string-mutation-reading :status :ok
          :checks *checks* :source-pins 38 :copies 9 :whole-source-comparisons 342
          :baseline-tests 17 :mutations-detected 8 :results (nreverse results)
          :physical-files-observed (hash-table-count *observed*) :sha256-and-metadata-before-after :stable
          :wrapper-sources (length (getf wrapper :source-blobs-before))
          :wrapper-stderr-bytes (length (getf wrapper :stderr))
          :observations (sort (loop for value being the hash-values of *observed* collect value) #'string< :key (lambda (r) (getf r :path)))
          :limits '(:data-only :read-eval-nil :eof :no-product-load-compile-or-execution
                    :no-new-mutation-run :all-38-files-compiled-per-child
                    :nominal-failure-and-exact-prefix-not-diagnostic-substrings
                    :one-semantic-change-per-mutant :extra-arity-has-two-declared-text-fragments
                    :compiler-notes-allowed-and-preserved :private-fasl-presence-without-loading
                    :no-c1-or-mcdc-promotion))))

(handler-case
    (let ((*print-readably* t) (*print-circle* t)) (write (main) :pretty t) (terpri))
  (error (condition)
    (write (list :schema-version 1 :kind :independent-string-mutation-reading :status :failed
                 :checks *checks* :diagnostic (princ-to-string condition)) :pretty t)
    (terpri) (sb-ext:exit :code 1)))
