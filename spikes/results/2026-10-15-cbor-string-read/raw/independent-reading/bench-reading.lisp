;;;; C4 indipendente: dati conclusi, nessun driver/corpus/prodotto caricato come codice.
(require :asdf)
(require :sb-md5)
(load "tools/evidence-storage.lisp")
(defpackage #:cbor.string.bench.reading (:use #:cl))
(in-package #:cbor.string.bench.reading)
(defvar *checks* 0)
(defun check (value label)
  (unless value (error "C4 ~A" label)) (incf *checks*) t)
(defun file-state (path)
  (list (namestring (pathname path)) (arcdocdb.evidence:file-bytes path)
        (arcdocdb.evidence:file-sha256 path)))
(defun git-blob (path)
  (string-trim '(#\Newline #\Return)
               (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun plain-data (path)
  (let ((*read-eval* nil) (eof (gensym)))
    (with-open-file (stream path)
      (let ((form (read stream nil eof)))
        (check (not (eq eof form)) :nonempty) (check (eq eof (read stream nil eof)) :eof) form))))
(defun at (plist key)
  (let* ((absent (gensym)) (value (getf plist key absent)))
    (check (not (eq value absent)) key) value))
(defun md5-unchanged (entries)
  (check (= (length entries) (length (remove-duplicates entries :key (lambda (row) (at row :file)) :test #'string=)))
         :unique-md5-scope)
  (dolist (row entries)
    (check (string= (at row :md5)
                    (format nil "~(~{~2,'0X~}~)" (coerce (sb-md5:md5sum-file (at row :file)) 'list)))
           :actual-md5)))
(defparameter *specs*
  '((:bytes-empty 2 :bytes 0 (64)) (:bytes-23 2 :bytes 23 (87))
    (:bytes-24 2 :bytes 24 (88 24)) (:bytes-256 2 :bytes 256 (89 1 0))
    (:bytes-65536 2 :bytes 65536 (90 0 1 0 0)) (:text-empty 3 :ascii 0 (96))
    (:text-23 3 :ascii 23 (119)) (:text-24 3 :ascii 24 (120 24))
    (:text-256 3 :ascii 256 (121 1 0)) (:text-65536 3 :ascii 65536 (122 0 1 0 0))
    (:raw-256 2 :raw 256 (89 1 0)) (:unicode-16 3 :unicode 16 (112))))
(defun cold (spec)
  (destructuring-bind (name major kind size header) spec
    (let* ((payload (+ 3 (length header))) (next (+ payload size)) (end (+ next 4))
           (buffer (make-array (+ end 3) :element-type '(unsigned-byte 8) :initial-element 165)))
      (replace buffer header :start1 3)
      (dotimes (i size)
        (setf (aref buffer (+ payload i))
              (ecase kind (:bytes 255) (:ascii 97) (:raw (mod i 256))
                (:unicode (nth i '(0 195 169 226 130 172 240 159 153 130 239 187 191 239 191 190))))))
      (replace buffer '(255 127 97 192) :start1 next)
      (list :name name :major major :start 3 :end end :expected-values (list major payload next)
            :header-bytes (length header) :payload-bytes size :item-bytes (- next 3)
            :authorized-window-bytes (- end 3) :expected-token (+ major (* 17 payload) (* 31 next))
            :physical-checksum (loop for i below (length buffer) sum (* (1+ i) (aref buffer i)))))))
(defun fixture-fields (actual expected)
  (dolist (key '(:name :major :start :end :expected-values :header-bytes :payload-bytes
                 :item-bytes :authorized-window-bytes :expected-token))
    (check (equal (at actual key) (at expected key)) key)))
(defun sample-check (sample count warmup token rate heap-kind)
  (let* ((heap (at sample :heap-bytes)) (ticks (at sample :raw-ticks))
         (expected (+ (* count token) (/ (* count (1- count)) 2))))
    (check (and (integerp heap) (<= 0 heap)) :heap-present-nonnegative)
    (check (if (eq heap-kind :zero) (zerop heap) (>= heap 16777216)) :heap-sensor)
    (check (and (integerp ticks) (<= 0 ticks)) :ticks)
    (check (= (/ ticks (float rate 1d0)) (at sample :seconds)) :seconds)
    (check (= count (at sample :iterations)) :iterations)
    (check (= warmup (at sample :warmup-iterations)) :warmup)
    (check (= token (at sample :expected-return-token)) :return-token)
    (check (= expected (at sample :sink) (at sample :expected-sink)) :independent-sink)))
(defparameter *rejects*
  '((:empty-window :corruption-detected :cbor-truncated 2)
    (:integer :corruption-detected :cbor-string-type 2) (:array :corruption-detected :cbor-string-type 2)
    (:tag :corruption-detected :cbor-string-type 2) (:simple :corruption-detected :cbor-string-type 2)
    (:reserved-wrong-major :corruption-detected :cbor-reserved 2)
    (:nonminimal-wrong-major :corruption-detected :cbor-nonminimal 2)
    (:indefinite :corruption-detected :cbor-nonminimal 2) (:break :corruption-detected :cbor-nonminimal 2)
    (:header-cut :corruption-detected :cbor-truncated 4) (:high-length :corruption-detected :cbor-truncated 11)
    (:bytes-cut :corruption-detected :cbor-truncated 4) (:text-cut-before-utf8 :corruption-detected :cbor-truncated 4)
    (:utf8-leading :corruption-detected :utf8-leading 3) (:utf8-continuation :corruption-detected :utf8-continuation 4)
    (:utf8-scalar :corruption-detected :utf8-scalar 4) (:utf8-cut :corruption-detected :utf8-truncated 4)
    (:budget-tail :resource-exhausted :cbor-byte-budget nil)
    (:budget-nil-before-syntax :invalid-argument :cbor-byte-limit nil)
    (:budget-too-large :invalid-argument :cbor-byte-limit nil) (:budget-negative :invalid-argument :cbor-byte-limit nil)
    (:range-before-budget :invalid-argument :cbor-range nil) (:buffer-type :invalid-argument :cbor-range nil)
    (:range-end :invalid-argument :cbor-range nil)))
(defun audit (path)
  (let* ((self "spikes/out/cbor-string-read-20261015/independent-reading/bench-reading.lisp")
         (descriptor (plain-data path)) (payload (merge-pathnames (getf descriptor :payload) path))
         (inputs (mapcar #'file-state (list path payload self "tools/cbor-string-read-driver.lisp")))
         (wrapper (arcdocdb.evidence:read-evidence path))
         (data (with-input-from-string (stream (at wrapper :stdout))
                 (arcdocdb.evidence::%read-plist-stream stream path)))
         (rate (at data :timer-units-per-second))
         (cold (mapcar #'cold *specs*)) (sensor (at data :self-test))
         (diff (at data :differential)) (fuzz (at data :fuzz)) (bench (at data :benchmark))
         (pins '(("src/codec/cbor-string-read.lisp" "d4a4f774c2264c46349e7eda61ee4a2a3118d742")
                 ("tests/codec/cbor-string-read-support.lisp" "cfd55cd47d782673113e67af625c1360195a345c")
                 ("tests/codec/cbor-string-read.lisp" "8437bdcaa4cf308dbf4614e748cdab4be2ae6d62")
                 ("tests/codec/cbor-string-read-threads.lisp" "8fc4ae5d9214108a6ae6bf26e644db1a42733cdd"))))
    (check (and (eq :command-verification (at wrapper :kind)) (eql 1 (at wrapper :schema-version))
                 (eq :ok (at wrapper :status)) (eql 0 (at wrapper :exit-code))
                 (eq :stable (at wrapper :source-consistency))
                 (equal (at wrapper :source-blobs-before) (at wrapper :source-blobs-after))) :outer)
    (check (search "f7c9e050" (at (at wrapper :environment) :commit)) :head)
    (check (equal '("--all") (last (at wrapper :command))) :command)
    (dolist (marker '("WARNING:" "STYLE-WARNING:" "Unhandled " "COMPILE-FILE-ERROR"))
      (check (not (search marker (at wrapper :stderr) :test #'char-equal)) :no-warning))
    (check (string= "a6b65bd233dba2a2eec941d96a75b9db948d19f8" (git-blob "tools/cbor-string-read-driver.lisp")) :driver)
    (dolist (pin pins)
      (dolist (rows (list (at wrapper :source-blobs-before) (at wrapper :source-blobs-after)))
        (check (string= (second pin) (at (find (first pin) rows :key (lambda (row) (at row :path)) :test #'string=) :git-blob)) :pin))
      (check (string= (second pin) (git-blob (first pin))) :current-pin))
    (check (and (eql 1 (at data :schema-version)) (eq :cbor-string-read-driver (at data :kind))
                 (eq :ok (at data :status)) (eq :complete (at data :phase))
                 (equal '("--all") (at data :mode)) (eq :stable (at data :source-consistency))
                 (equal (at data :source-fingerprints-before) (at data :source-fingerprints-after))
                 (= 1 (at data :workers)) (= 3 (at data :safety)) (plusp rate)) :inner)
    (md5-unchanged (at data :source-fingerprints-before))
    (check (and (eq :ok (at sensor :status)) (= 0 (at sensor :declared-product-calls))
                 (eq t (at sensor :exact-three-fixnum-values-accepted))
                 (= 8 (at sensor :altered-or-wrong-arity-rejected))
                 (eq t (at sensor :physical-suffix-mutation-rejected))) :sensor-controls)
    (sample-check (at sensor :baseline) 1024 64 0 rate :zero)
    (sample-check (at sensor :positive-control) 16 0 1048576 rate :positive)
    (check (and (eq :ok (at diff :status)) (= 36 (at diff :declared-product-calls))
                 (= 12 (at diff :declared-successes) (length (at diff :successes)))
                 (= 24 (at diff :declared-rejections) (length (at diff :rejections)))) :diff-denominator)
    (loop for actual in (at diff :successes) for expected in cold
          do (fixture-fields actual expected)
             (check (= (at actual :observed-token) (at expected :expected-token)) :diff-token)
             (check (= (at expected :physical-checksum) (at actual :buffer-checksum-before) (at actual :buffer-checksum-after)) :diff-physical)
             (check (eq t (at actual :input-unchanged)) :diff-input))
    (loop for actual in (at diff :rejections) for expected in *rejects*
          do (check (equal expected (mapcar (lambda (key) (at actual key)) '(:name :class :reason :offset))) :diff-error)
             (check (eq t (at actual :input-unchanged)) :rejected-input))
    (let ((state #x43535239) (tokens 0) (items 0))
      (dotimes (i 1024)
        (setf state (mod (+ (* state 1664525) 1013904223) 4294967296))
        (let* ((major (+ 2 (ldb (byte 1 7) state)))
               (unicode (and (= major 3) (zerop (mod i 4))))
               (size (if unicode (* 16 (1+ (mod state 16))) (1+ (mod state 257))))
               (start (1+ (mod (floor state 256) 7)))
               (header (cond ((< size 24) 1) ((< size 256) 2) (t 3)))
               (payload (+ start header)) (next (+ payload size)))
          (incf items (+ header size)) (incf tokens (+ major (* 17 payload) (* 31 next)))))
      (check (and (eq :ok (at fuzz :status)) (= #x43535239 (at fuzz :seed))
                   (= state (at fuzz :final-state)) (= 1024 (at fuzz :iterations))
                   (= 2048 (at fuzz :declared-product-calls) (at fuzz :physical-input-checks))
                   (= 1024 (at fuzz :declared-successes) (at fuzz :declared-rejections))
                   (= items (at fuzz :successful-item-bytes))
                   (= tokens (at fuzz :observed-token-sum) (at fuzz :expected-token-sum))
                   (equal '(128 128 128 128 128 128 128 128) (at fuzz :negative-family-counts))
                   (eq t (at fuzz :invalid-tail-ignored-on-all-successes))) :fuzz-independent)
      (format t "FUZZ independent seed43535239 final~8,'0X,1024pairs/2048declaredcalls,items~D,tokens~D;8families128.~%" state items tokens))
    (check (and (eq :ok (at bench :status)) (= 12 (at bench :fixture-count) (length (at bench :campaigns)))
                 (= 5 (at bench :replicas)) (= 60 (at bench :samples))
                 (= 1024 (at bench :iterations)) (= 64 (at bench :warmup-iterations))
                 (= 61440 (at bench :declared-timed-product-calls) (at bench :declared-timed-nodes))
                 (= 3840 (at bench :declared-warmup-product-calls))
                 (= 12 (at bench :declared-cold-product-calls)) (= 65292 (at bench :declared-total-product-calls))) :bench-denominators)
    (let ((samples 0) (seconds 0d0) (items 0) (windows 0))
      (loop for actual in (at bench :campaigns) for expected in cold
            do (fixture-fields actual expected)
               (check (= (at actual :cold-token) (at expected :expected-token)) :cold-token)
               (check (= 5 (length (at actual :samples))) :replicas)
               (incf items (* 5120 (at expected :item-bytes)))
               (incf windows (* 5120 (at expected :authorized-window-bytes)))
               (loop for sample in (at actual :samples) for replica from 0
                     do (incf samples) (sample-check sample 1024 64 (at expected :expected-token) rate :zero)
                        (check (= replica (at sample :replica)) :replica-id)
                        (check (= 1024 (at sample :declared-product-calls) (at sample :declared-nodes)) :sample-denominator)
                        (check (= (* 1024 (at expected :item-bytes)) (at sample :declared-item-bytes)) :item-bytes)
                        (check (= (at expected :physical-checksum) (at sample :buffer-checksum-before)
                                  (at sample :buffer-checksum-after)) :physical-checksum)
                        (check (eq t (at sample :input-unchanged)) :sample-input)
                        (incf seconds (at sample :seconds)))
               (format t "FIXTURE ~S values~S token~D checksum~D;5samplesheap0.~%"
                       (at expected :name) (at expected :expected-values) (at expected :expected-token)
                       (at expected :physical-checksum)))
      (check (= 60 samples) :all-samples)
      (check (= 675727360 items (at bench :declared-timed-item-bytes)) :all-item-bytes)
      (check (= 675973120 windows (at bench :declared-timed-authorized-window-bytes)) :all-window-bytes)
      (format t "BENCH60heap-present0 samples;timed61440/warm3840/cold12/total65292;items~D/windows~D;sample-seconds~,6F.~%" items windows seconds))
    (md5-unchanged (at data :source-fingerprints-after))
    (dolist (input inputs) (check (equal input (file-state (first input))) :physical-input-stable))
    (dolist (pin pins) (check (string= (second pin) (git-blob (first pin))) :final-pin))
    (format t "OUTERHEAD~A sources~D wall~S,innerMD5files~D;positiveheap~D/nullheap0;C4checks~D.~%"
            (at (at wrapper :environment) :commit) (length (at wrapper :source-blobs-before))
            (at wrapper :wall-seconds) (length (at data :source-fingerprints-before))
            (at (at sensor :positive-control) :heap-bytes) *checks*)
    (format t "PHYSICAL~S~%DATAonly no product/corpus/driver LOAD/compile/call;denominators arithmetic/declared,not instrumentedcalls;no absolute-nonallocation/throughput/scaling/MC-DC claim.~%" inputs)))
(handler-case
    (audit "spikes/out/4001085071-command-33054-0/report.lisp")
  (error (condition) (format *error-output* "C4 BENCH FAILED:~A~%" condition) (sb-ext:exit :code 1)))
