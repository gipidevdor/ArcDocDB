;;;; C4: sola lettura DATA di dettagli concorrenti, scope selftest e missed.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:string.coverage.details (:use #:cl))
(in-package #:string.coverage.details)
(defvar *checks* 0)
(defun ck (value reason) (incf *checks*) (unless value (error "C4 details ~S" reason)))
(defparameter *pins*
  '(("src/codec/cbor-string-read.lisp" "d4a4f774c2264c46349e7eda61ee4a2a3118d742")
    ("tests/codec/cbor-string-read-support.lisp" "cfd55cd47d782673113e67af625c1360195a345c")
    ("tests/codec/cbor-string-read.lisp" "8437bdcaa4cf308dbf4614e748cdab4be2ae6d62")
    ("tests/codec/cbor-string-read-threads.lisp" "8fc4ae5d9214108a6ae6bf26e644db1a42733cdd")))
(defparameter *paths*
  '("spikes/out/4001085107-command-33695-0/report.lisp"
    "spikes/out/4001085107-command-33696-0/report.lisp"
    "spikes/out/cbor-string-read-20261015/coverage/coverage-state.lisp"
    "spikes/out/cbor-string-read-20261015/independent-reading/coverage-details-v2.lisp"))
(defun observation (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun blob (path)
  (string-trim '(#\Space #\Newline #\Return)
    (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun pl (data)
  (ck (and (consp data) (list-length data) (evenp (length data))) :plist)
  (let ((seen nil))
    (loop for key in data by #'cddr do (ck (and (keywordp key) (not (member key seen))) :unique-key) (push key seen))) data)
(defun record-check (record)
  (pl record)
  (ck (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
           (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
           (null (getf record :signal)) (eq :stable (getf record :source-consistency))
           (integerp (getf record :finished-at-universal-time))
           (<= (getf record :started-at-universal-time) (getf record :finished-at-universal-time))
           (equal (getf record :source-blobs-before) (getf record :source-blobs-after))) :stable-completed)
  (let ((env (pl (getf record :environment))) (before (getf record :source-blobs-before)))
    (ck (and (string= (getf env :commit) "f7c9e0503577b45e2bd20de66c72b6e7232a8c76")
             (string= (getf env :working-tree) "")) :head-clean)
    (ck (= 1015 (length before) (length (remove-duplicates before :key (lambda (x) (getf x :path)) :test #'string=))) :inventory1015)
    (dolist (pin *pins*)
      (ck (string= (second pin) (getf (find (first pin) before :key (lambda (x) (getf x :path)) :test #'string=) :git-blob)) :record-pin)))
  (ck (stringp (getf record :stderr)) :stderr)
  (dolist (marker '("WARNING:" "STYLE-WARNING:" "Unhandled " "COMPILE-FILE-ERROR" "compilation aborted"))
    (ck (not (search marker (getf record :stderr) :test #'char-equal)) :no-warning)))
(defun integer-after (text marker &optional (start 0))
  (let ((pos (search marker text :start2 start)))
    (ck pos :present-field)
    (let ((begin (+ pos (length marker)))) (parse-integer text :start begin :junk-allowed t))))
(defun triplet (line worker)
  (let* ((marker (format nil "worker ~D start/first/end " worker))
         (start (search marker line)) (begin (+ start (length marker)))
         (end (position #\, line :start begin)))
    (ck start :worker)
    (mapcar #'parse-integer (uiop:split-string (subseq line begin end) :separator '(#\/)))))
(let* ((observations (mapcar #'observation *paths*))
       (source-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*))
       (coverage (arcdocdb.evidence:read-evidence (first *paths*)))
       (selftest (arcdocdb.evidence:read-evidence (second *paths*)))
       (lines (uiop:split-string (getf coverage :stdout) :separator '(#\Newline)))
       (workers (remove-if-not (lambda (line) (search "CBOR string read: onda " line)) lines))
       (previous-ends (vector 0 0)))
  (ck (equal source-pins *pins*) :current-pins)
  (record-check coverage) (record-check selftest)
  (ck (equal (getf selftest :command)
             '("sbcl" "--noinform" "--no-userinit" "--no-sysinit" "--script" "tools/foundation-coverage.lisp" "--self-test"
               "spikes/out/cbor-string-read-20261015/coverage-selftest/")) :selftest-cli)
  (ck (string= (getf selftest :stdout) (format nil "Copertura: self-test del ramo mancante superato.~%")) :selftest-output)
  (ck (string= (getf selftest :stderr) "") :selftest-empty-stderr)
  (ck (= 2 (length workers)) :two-waves)
  (loop for line in workers for wave from 0
        for a = (triplet line 0) for b = (triplet line 1)
        do (ck (= wave (integer-after line "onda ")) :wave-number)
           (ck (search ", 2 worker riusati, 4096 letture;" line) :two-workers4096)
           (loop for stamps in (list a b) for worker from 0
                 do (ck (and (= 3 (length stamps)) (every #'integerp stamps)
                             (<= (aref previous-ends worker) (first stamps) (second stamps) (third stamps))
                             (< (first stamps) (third stamps))) :stamp-order)
                    (setf (aref previous-ends worker) (third stamps)))
           (ck (<= (max (second a) (second b)) (min (third a) (third b))) :first-before-other-end)
           (let* ((second-worker (search "worker 1 start" line))
                  (sink0 (integer-after line ", sink "))
                  (sink1 (integer-after line ", sink " second-worker))
                  (overlap (integer-after line "overlap ")))
             (ck (= 84649984 sink0) :sink0) (ck (= 85010432 sink1) :sink1)
             (ck (= overlap (- (min (third a) (third b)) (max (first a) (first b)))) :overlap-arithmetic)
             (ck (plusp overlap) :overlap-positive)
             (ck (search "tick (1000000 tick/s)" line) :tick-unit)
             (format t "WAVE ~D stamps~S/~S sinks~D/~D overlap~D fixture-wall ticks, 4096 declared calls.~%"
                     wave a b sink0 sink1 overlap)))
  (arcdocdb.evidence:call-with-evidence-bytes
   (third *paths*)
   (lambda (plain)
     (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*package* (find-package :cl-user)) (eof (gensym)))
       (with-open-file (stream plain :external-format :utf-8)
         (let* ((raw (read stream nil eof))
                (entry (find (namestring (truename "src/codec/cbor-string-read.lisp")) raw :key #'car :test #'string=))
                (paths (cadr entry)) (bits (cddr entry))
                (expected-expr '(0 1 2 37 38 39 40 47 62 63 64 65 66 67 117 118 119 120 121 122
                                 136 137 138 139 140 141 148 149 150 151 152 153 160 161 162 163 164 165 180))
                (expected-branches '(36 61 116 135 147 159)) (expr nil) (branches nil))
           (ck (eq eof (read stream nil eof)) :raw-one-form-eof)
           (ck (= 181 (length paths) (length bits)) :all181-records)
           (dotimes (index (length paths))
             (when (zerop (sbit bits index))
               (if (member (car (svref paths index)) '(:then :else)) (push index branches) (push index expr))))
           (ck (equal (reverse expr) expected-expr) :all39-missed-expressions)
           (ck (equal (reverse branches) expected-branches) :all6-missed-branches)
           (format t "CLASSIFICATION all45missed: top-level IN-PACKAGE0/DECLAIM1,2,47=4expr; default MAX-BYTES180=1expr; internal SPAN37..40=4expr+branch36; FORM62..67,COUNT117..122,PROGRESS136..141,PAYLOAD148..153,RANGE160..165=30expr+branches61,116,135,147,159. No exclusions.~%"))))))
  (ck (equal observations (mapcar #'observation *paths*)) :physical-inputs-unchanged)
  (ck (equal source-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*)) :sources-unchanged)
  (format t "SELFTEST wrapper schema1/ok/exit0/signalNIL/completed/STABLE1015/HEADf7c9/4pins, exact CLI/stdout; stderr0.~%OBSERVATIONS ~S~%C4 DETAILS PASS checks~D; DATA only, no product/test/driver LOAD/compile/call.~%" observations *checks*))
