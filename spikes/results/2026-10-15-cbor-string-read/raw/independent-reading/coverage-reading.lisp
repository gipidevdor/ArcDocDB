(unless (find-package "ARCDOCDB.CBOR") (make-package "ARCDOCDB.CBOR" :use '("CL")))
(unless (find-package "ARCDOCDB.CONDITIONS") (make-package "ARCDOCDB.CONDITIONS" :use '("CL")))
(export (intern "RESOURCE-EXHAUSTED" "ARCDOCDB.CONDITIONS") "ARCDOCDB.CONDITIONS")
(defvar *checks* 0)
(defparameter *base* "spikes/out/cbor-string-read-20261015/coverage/")
(defparameter *wrapper* "spikes/out/4001085107-command-33695-0/report.lisp")
(defparameter *pins*
  '(("src/codec/cbor-string-read.lisp" "d4a4f774c2264c46349e7eda61ee4a2a3118d742")
    ("tests/codec/cbor-string-read-support.lisp" "cfd55cd47d782673113e67af625c1360195a345c")
    ("tests/codec/cbor-string-read.lisp" "8437bdcaa4cf308dbf4614e748cdab4be2ae6d62")
    ("tests/codec/cbor-string-read-threads.lisp" "8fc4ae5d9214108a6ae6bf26e644db1a42733cdd")))
(defparameter *physical-pins*
  '(("spikes/out/4001085107-command-33695-0/report.lisp")
    ("spikes/out/cbor-string-read-20261015/coverage/coverage-state.lisp")
    ("spikes/out/cbor-string-read-20261015/coverage/cover-index.html")
    ("spikes/out/cbor-string-read-20261015/coverage/f23b78e5d15c717c2a8dbd67d393e70d.html")
    ("spikes/out/cbor-string-read-20261015/independent-reading/coverage-reading.lisp")))
(unless (find-package "ARCDOCDB.UTF8") (make-package "ARCDOCDB.UTF8" :use '("CL")))
(export (intern "VERIFICA-UTF8" "ARCDOCDB.UTF8") "ARCDOCDB.UTF8")
(defun check (truth reason)
  (incf *checks*) (unless truth (error "Tag coverage DATA: ~S" reason)))
(defun observation (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun git-blob (path)
  (string-trim '(#\Space #\Newline #\Return)
               (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun plist-check (data)
  (let ((length (and (consp data) (list-length data))) (seen (make-hash-table :test 'eq)))
    (check (and length (evenp length)) :proper-plist)
    (loop for key in data by #'cddr
          do (check (and (keywordp key) (not (gethash key seen))) :unique-key)
             (setf (gethash key seen) t)))
  data)
(defun inventory (entries)
  (check (and (consp entries) (list-length entries)) :proper-inventory)
  (let ((seen (make-hash-table :test 'equal)))
    (dolist (entry entries)
      (plist-check entry)
      (let ((path (getf entry :path)) (hash (getf entry :git-blob)))
        (check (and (stringp path) (stringp hash) (= 40 (length hash))
                    (not (gethash path seen))) :unique-source)
        (setf (gethash path seen) hash)))
    seen))
(defun read-one-data (path)
  (arcdocdb.evidence:call-with-evidence-bytes
   path (lambda (plain)
          (check (<= (arcdocdb.evidence:file-bytes plain) 134217728) :data-byte-limit)
          (let ((*read-eval* nil) (*readtable* (copy-readtable nil))
                (*read-base* 10) (*read-suppress* nil) (*package* (find-package :cl-user))
                (eof (gensym "EOF")))
            (with-open-file (stream plain :external-format :utf-8)
              (let ((form (read stream nil eof)))
                (check (not (eq form eof)) :present-form)
                (check (eq eof (read stream nil eof)) :one-form-eof) form))))))
(defun read-source-forms (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package "ARCDOCDB.CBOR")) (eof (gensym "EOF")))
    (with-open-file (stream path :external-format :utf-8)
      (coerce (loop for form = (read stream nil eof) until (eq form eof) collect form) 'vector))))
(defun path-form (path forms)
  (let* ((numeric (if (keywordp (car path)) (cdr path) path))
         (indices (reverse numeric)))
    (check (and (consp indices) (every (lambda (x) (and (integerp x) (not (minusp x)))) indices)
                (< (first indices) (length forms))) :numeric-source-path)
    (let ((form (aref forms (first indices))))
      (dolist (index (rest indices) form)
        (check (and (listp form) (< index (length form))) :source-child-bound)
        (setf form (nth index form))))))
(defun summary (entry)
  (let ((paths (cadr entry)) (bits (cddr entry)) (ec 0) (et 0) (bc 0) (bt 0)
        (sites (make-hash-table :test 'equal)))
    (check (and (stringp (car entry)) (typep paths 'simple-vector)
                (typep bits 'simple-bit-vector) (= (length paths) (length bits))) :raw-entry-shape)
    (dotimes (index (length paths))
      (let ((path (aref paths index)) (bit (sbit bits index)))
        (check (consp path) :nonempty-raw-path)
        (if (member (car path) '(:then :else))
            (progn (incf bt) (incf bc bit) (push (car path) (gethash (cdr path) sites)))
            (progn (incf et) (incf ec bit)))))
    (maphash (lambda (path ways) (declare (ignore path))
               (check (and (= 2 (length ways)) (member :then ways) (member :else ways))
                      :complete-then-else-site)) sites)
    (list ec et bc bt)))
(defun html-summary-rows (text)
  "SB-COVER generated summary only; TR ends at next TR even with implicit end tag."
  (let* ((begin (search "<table class='summary'>" text))
         (end (and begin (search "</table>" text :start2 begin))) (rows nil))
    (check (and begin end) :html-summary-table)
    (loop for start = (search "<tr " text :start2 begin)
          then (search "<tr " text :start2 (1+ start))
          while (and start (< start end))
          do (let* ((next (search "<tr " text :start2 (1+ start)))
                    (stop (min end (or next end))) (cells nil))
               (loop for cell = (search "<td" text :start2 start)
                     then (search "<td" text :start2 (1+ cell))
                     while (and cell (< cell stop))
                     do (let ((open (position #\> text :start cell :end stop))
                              (close (search "</td>" text :start2 cell :end2 stop)))
                          (check (and open close (< open close)) :html-cell)
                          (push (string-trim '(#\Space #\Newline #\Return) (subseq text (1+ open) close)) cells)))
               (push (nreverse cells) rows)))
    (nreverse rows)))
(defun html-counts (rows first-cell)
  (let ((row (find first-cell rows :key #'first :test #'string=)))
    (check (and row (= 4 (length row))) :html-kind-row)
    (list (parse-integer (second row)) (parse-integer (third row)) (fourth row))))
(defun rounded-percent (covered total)
  (string-trim '(#\Space) (format nil "~5,1F" (* 100d0 (/ covered total)))))
(defun verify-html (source leaf counts index-rows)
  (let* ((page (uiop:read-file-string (concatenate 'string *base* leaf) :external-format :utf-8))
         (rows (html-summary-rows page))
         (ec (first counts)) (et (second counts)) (bc (third counts)) (bt (fourth counts))
         (expected-e (list ec et (rounded-percent ec et)))
         (expected-b (list bc bt (rounded-percent bc bt)))
         (index-row (find-if (lambda (row) (and (first row) (search (file-namestring source) (first row)))) index-rows)))
    (check (search (namestring (truename source)) page) :html-source-header)
    (check (equal expected-e (html-counts rows "expression")) :html-expression-summary)
    (check (equal expected-b (html-counts rows "branch")) :html-branch-summary)
    (check (and index-row (= 7 (length index-row)) (search leaf (first index-row))) :index-source-link)
    (check (equal (append expected-e expected-b)
                  (list (parse-integer (second index-row)) (parse-integer (third index-row)) (fourth index-row)
                        (parse-integer (fifth index-row)) (parse-integer (sixth index-row)) (seventh index-row)))
           :index-summary)))
(let* ((observations (mapcar (lambda (pin) (observation (first pin))) *physical-pins*))
       (source-blobs (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*))
       (trusted-blob (git-blob "tools/evidence-storage.lisp"))
       (record (plist-check (arcdocdb.evidence:read-evidence *wrapper*)))
       (env (plist-check (getf record :environment)))
       (before (inventory (getf record :source-blobs-before)))
       (after (inventory (getf record :source-blobs-after)))
       (raw (read-one-data (concatenate 'string *base* "coverage-state.lisp")))
       (root (namestring (truename "./")))
       (index-rows (html-summary-rows (uiop:read-file-string (concatenate 'string *base* "cover-index.html") :external-format :utf-8)))
       (total '(0 0 0 0)) (global '(0 0 0 0))
       (*print-pretty* nil) (*print-level* nil) (*print-length* nil)
       (*package* (find-package "ARCDOCDB.CBOR")))
  (check (= 5 (length observations)) :five-physical-inputs)
  (check (equal source-blobs *pins*) :physical-four-source-pins)
  (check (string= trusted-blob "fa2b5d36dca0837e2ed5e49b282887b2e110b2b7") :trusted-reader-pin)
  (check (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
              (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
              (eq :stable (getf record :source-consistency))
              (equal (getf record :source-blobs-before) (getf record :source-blobs-after))) :completed-stable-wrapper)
  (check (and (string= "f7c9e0503577b45e2bd20de66c72b6e7232a8c76" (getf env :commit))
              (string= "" (getf env :working-tree)) (string= "2.6.9" (getf env :version))) :head-clean-and-format-version)
  (check (equal '("sbcl" "--noinform" "--no-userinit" "--no-sysinit" "--script"
                 "tools/foundation-coverage.lisp" "--report" "spikes/out/cbor-string-read-20261015/coverage/" "cbor-string-read")
                (getf record :command)) :exact-map-scope)
  (dolist (pin *pins*)
    (check (equal (second pin) (gethash (first pin) before)) :four-record-pins-before)
    (check (equal (second pin) (gethash (first pin) after)) :four-record-pins-after))
  (check (= (hash-table-count before) (hash-table-count after)) :inventory-count)
  (check (stringp (getf record :stderr)) :stderr-string)
  (dolist (marker '("WARNING:" "STYLE-WARNING:" "Unhandled " "compilation aborted" "COMPILE-FILE-ERROR"))
    (check (not (search marker (getf record :stderr) :test #'char-equal)) :no-warning-or-compile-failure))
  (let ((ok-lines (remove-if-not (lambda (line) (and (>= (length line) 6) (string= "ok    " line :end2 6)))
                                 (uiop:split-string (getf record :stdout) :separator '(#\Newline)))))
    (check (= 17 (length ok-lines) (length (remove-duplicates ok-lines :test #'string=))) :seventeen-unique-nominals)
    (check (every (lambda (line) (search "TEST-REQ-CBR-009-STRING-" line)) ok-lines) :only-string-read-nominals))
  (format t "WRAPPER status~S exit~D stable~S HEAD~A sources~D wall~S stderr-chars~D scope cbor-string-read~%~A~%"
          (getf record :status) (getf record :exit-code) (getf record :source-consistency)
          (getf env :commit) (hash-table-count before) (getf record :wall-seconds) (length (getf record :stderr)) (getf record :stdout))
  (check (and (consp raw) (list-length raw)) :raw-proper-list)
  (let ((seen (make-hash-table :test 'equal)))
    (dolist (entry raw)
      (check (not (gethash (car entry) seen)) :unique-global-source)
      (setf (gethash (car entry) seen) t)
      (setf global (mapcar #'+ global (summary entry)))))
  (format t "GLOBAL RAW files~D expression~D/~D branch~D/~D; not selected scope.~%" (length raw)
          (first global) (second global) (third global) (fourth global))
  (loop for pin in (subseq *pins* 0 1)
        for leaf in '("f23b78e5d15c717c2a8dbd67d393e70d.html")
        for source = (first pin) for absolute = (concatenate 'string root source)
        for entries = (remove absolute raw :key #'car :test-not #'string=)
        do (check (= 1 (length entries)) :one-selected-entry)
           (let* ((entry (first entries)) (paths (cadr entry)) (bits (cddr entry))
                  (forms (read-source-forms source)) (counts (summary entry)))
             (setf total (mapcar #'+ total counts))
             (verify-html source leaf counts index-rows)
             (format t "SELECTED ~A expression~D/~D (~,6F percent) branch~D/~D (~,6F percent) raw-records~D HTML/index coherent.~%"
                     source (first counts) (second counts) (* 100d0 (/ (first counts) (second counts)))
                     (third counts) (fourth counts) (* 100d0 (/ (third counts) (fourth counts))) (length paths))
             (dotimes (index (length paths))
               (when (zerop (sbit bits index))
                 (let* ((path (aref paths index)) (form (path-form path forms))
                        (numeric (if (keywordp (car path)) (cdr path) path))
                        (top (aref forms (car (last numeric)))))
                   (format t "UNCOVERED ~A record~D ~S path~S form~S owner~S~%" source index
                           (if (member (car path) '(:then :else)) :branch :expression) path form
                           (if (eq (car top) 'defun) (second top) (car top))))))))
  (format t "SELECTED TOTAL expression~D/~D (~,6F percent) branch~D/~D (~,6F percent); all uncovered, no exclusions.~%"
          (first total) (second total) (* 100d0 (/ (first total) (second total)))
          (third total) (fourth total) (* 100d0 (/ (third total) (fourth total))))
  (check (equal observations (mapcar (lambda (pin) (observation (first pin))) *physical-pins*)) :physical-inputs-unchanged)
  (check (equal source-blobs (mapcar (lambda (pin) (list (first pin) (git-blob (first pin)))) *pins*)) :four-sources-unchanged)
  (check (string= trusted-blob (git-blob "tools/evidence-storage.lisp")) :trusted-reader-unchanged)
  (format t "OBSERVATIONS ~S~%FOUR-SOURCE-PINS ~S~%TRUSTED-READER ~A~%DATA READING PASS checks~D; physical before/after stable. No evaluated source/data, product/driver load, compile or call; no campaign rerun, MC/DC/C1 or authenticity claim.~%"
          observations source-blobs trusted-blob *checks*))
