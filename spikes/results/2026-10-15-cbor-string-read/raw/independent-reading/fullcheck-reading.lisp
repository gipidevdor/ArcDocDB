;;;; C4 DATA: conteggio limitato al segmento prodotto prima del marker build.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:string.fullcheck.reading (:use #:cl))
(in-package #:string.fullcheck.reading)
(unless (find-package "ARCDOCDB.CBOR") (make-package "ARCDOCDB.CBOR" :use '("CL")))
(export (intern "LEGGI-STRINGA-CBOR-MINIMA" "ARCDOCDB.CBOR") "ARCDOCDB.CBOR")
(defvar *checks* 0)
(defun ck (value reason) (incf *checks*) (unless value (error "Fullcheck DATA ~S" reason)))
(defparameter *pins*
  '(("src/codec/cbor-string-read.lisp" "d4a4f774c2264c46349e7eda61ee4a2a3118d742")
    ("tests/codec/cbor-string-read-support.lisp" "cfd55cd47d782673113e67af625c1360195a345c")
    ("tests/codec/cbor-string-read.lisp" "8437bdcaa4cf308dbf4614e748cdab4be2ae6d62")
    ("tests/codec/cbor-string-read-threads.lisp" "8fc4ae5d9214108a6ae6bf26e644db1a42733cdd")))
(defparameter *paths*
  '("spikes/out/4001085107-command-33694-0/report.lisp"
    "spikes/out/4001085107-command-33694-0/report.lisp.gz"
    "spikes/out/cbor-string-read-20261015/independent-reading/fullcheck-reading.lisp"))
(defun observation (path)
  (list path (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)))
(defun blob (path)
  (string-trim '(#\Space #\Newline #\Return) (uiop:run-program (list "git" "hash-object" path) :output :string)))
(defun pl (value)
  (ck (and (consp value) (list-length value) (evenp (length value))) :plist)
  (let ((seen nil))
    (loop for key in value by #'cddr do (ck (and (keywordp key) (not (member key seen))) :unique-key) (push key seen))) value)
(defun names-from-corpus ()
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*package* (find-package :cl-user)) (eof (gensym)) (names nil) (forms 0))
    (dolist (path '("tests/codec/cbor-string-read-support.lisp" "tests/codec/cbor-string-read.lisp" "tests/codec/cbor-string-read-threads.lisp"))
      (with-open-file (stream path :external-format :utf-8)
        (loop for form = (read stream nil eof) until (eq form eof)
              do (incf forms)
                 (when (and (consp form) (symbolp (car form)) (string= "DEFTEST" (symbol-name (car form))))
                   (push (format nil "ok    ~A" (symbol-name (second form))) names)))))
    (ck (= 31 forms) :corpus31-data-forms) (ck (= 17 (length names)) :corpus17-names) names))
(defun occurrences (needle haystack)
  (loop with start = 0 for pos = (search needle haystack :start2 start :test #'char-equal)
        while pos count pos do (setf start (+ pos (length needle)))))
(let* ((observations (mapcar #'observation *paths*))
       (physical-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*))
       (record (pl (arcdocdb.evidence:read-evidence (first *paths*))))
       (before (getf record :source-blobs-before)) (after (getf record :source-blobs-after))
       (env (pl (getf record :environment)))
       (stdout (getf record :stdout)) (stderr (getf record :stderr))
       (lines (uiop:split-string stdout :separator '(#\Newline)))
       (marker "build e test: nessun avviso, tutti i controlli superati")
       (boundary (position marker lines :test #'string=))
       (product-lines (subseq lines 0 boundary))
       (ok-lines (remove-if-not (lambda (line) (uiop:string-prefix-p "ok    " line)) product-lines))
       (smoke '("ok    package ARCDOCDB presente" "ok    ARCDOCDB:*VERSION* è una stringa"))
       (nominals (set-difference ok-lines smoke :test #'string=))
       (fresh (remove-if-not (lambda (line) (search "TEST-REQ-CBR-009-STRING-" line :test #'char-equal)) nominals))
       (expected (names-from-corpus)))
  (ck (and (eql 1 (getf record :schema-version)) (eq :command-verification (getf record :kind))
           (eq :ok (getf record :status)) (eql 0 (getf record :exit-code)) (null (getf record :signal))
           (integerp (getf record :finished-at-universal-time))
           (<= (getf record :started-at-universal-time) (getf record :finished-at-universal-time))
           (eq :stable (getf record :source-consistency)) (equal before after)) :completed-stable)
  (ck (equal (getf record :command) '("make" "check-core")) :exact-command)
  (ck (and (string= (getf env :commit) "f7c9e0503577b45e2bd20de66c72b6e7232a8c76") (string= (getf env :working-tree) "")) :head-clean)
  (ck (= 1015 (length before) (length (remove-duplicates before :key (lambda (entry) (getf entry :path)) :test #'string=))) :inventory1015)
  (ck (equal physical-pins *pins*) :physical-pins)
  (dolist (pin *pins*)
    (ck (string= (second pin) (getf (find (first pin) before :key (lambda (entry) (getf entry :path)) :test #'string=) :git-blob)) :record-pin))
  (ck (= 1 (count marker lines :test #'string=)) :single-marker)
  (ck (every (lambda (line) (= 1 (count line ok-lines :test #'string=))) smoke) :two-smokes-once)
  (ck (= 1745 (length ok-lines)) :all-product-ok1745)
  (ck (= 1743 (length nominals) (length (remove-duplicates nominals :test #'string-equal))) :1743-unique-nominals)
  (ck (every (lambda (line) (and (> (length line) 11) (string-equal "TEST-" line :start2 6 :end2 11))) nominals) :only-test-nominals)
  (ck (= 17 (length fresh) (length (remove-duplicates fresh :test #'string-equal))) :new17-unique)
  (ck (and (null (set-difference expected fresh :test #'string-equal)) (null (set-difference fresh expected :test #'string-equal))) :corpus-exact-names)
  (ck (and (member "246 file, 0 violazioni" lines :test #'string=)
           (member "506 file, 3419 link controllati, 0 rotti" lines :test #'string=)) :lint-links-lines)
  (format t "FULLCHECK DATA PASS: nominal~D unique-case-insensitive~D +smoke~D =ok~D before marker-line~D(one-based), lines-total~D; new17 exact corpus names/31DATAforms.~%"
          (length nominals) (length (remove-duplicates nominals :test #'string-equal)) (length smoke) (length ok-lines) (1+ boundary) (length lines))
  (dolist (line (sort (copy-list fresh) #'string-lessp)) (write-line line))
  (format t "CASE DETAIL uppercase-prefix~D/lowercase-prefix~D. Later lint/selftest/mutation/evidence output excluded from product count.~%"
          (count-if (lambda (line) (uiop:string-prefix-p "ok    TEST-" line)) nominals)
          (count-if (lambda (line) (uiop:string-prefix-p "ok    test-" line)) nominals))
  (format t "STDERR chars~D NOTE-markers~D WARNING-markers~D STYLE-WARNING-markers~D; warnings literal counts, raw retained. HEAD~A/STABLE~D/4pins/exit0/signalNIL.~%"
          (length stderr) (occurrences "note:" stderr) (occurrences "WARNING:" stderr) (occurrences "STYLE-WARNING:" stderr) (getf env :commit) (length before))
  (ck (equal observations (mapcar #'observation *paths*)) :physical-unchanged)
  (ck (equal physical-pins (mapcar (lambda (pin) (list (first pin) (blob (first pin)))) *pins*)) :sources-unchanged)
  (format t "OBSERVATIONS ~S~%DATA ONLY checks~D; no product/test/driver LOAD, compile or call. No rerun or promotion.~%" observations *checks*))
