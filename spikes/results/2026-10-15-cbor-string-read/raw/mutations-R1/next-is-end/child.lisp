;;;; Child narrow: nessun ASDF/full-engine; cache esclusiva nella copia.
(require :asdf)
(defpackage #:arcdocdb.cbor-string-read.mutation-child (:use #:cl))
(in-package #:arcdocdb.cbor-string-read.mutation-child)
(declaim (optimize (safety 3) (debug 2)))

(defun read-one (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (eof (gensym)))
    (with-open-file (stream path)
      (let ((data (read stream nil eof)))
        (unless (and (not (eq data eof)) (eq eof (read stream nil eof))) (error "Plan DATA invalido."))
        data))))

(defun sha256 (path)
  (let* ((text (uiop:run-program (list "shasum" "-a" "256" (namestring path)) :output :string))
         (end (position #\Space text)))
    (unless (and end (= end 64)) (error "SHA256 indisponibile."))
    (subseq text 0 end)))

(defun verify-files (root entries)
  (dolist (entry entries)
    (unless (string= (getf entry :sha256) (sha256 (merge-pathnames (getf entry :path) root)))
      (error "Snapshot modificato: ~A." (getf entry :path)))))

(defun compile-one (root relative)
  (let* ((source (merge-pathnames relative root))
         (output (merge-pathnames (make-pathname :type "fasl" :defaults (pathname relative))
                                  (merge-pathnames "fasl/" root))))
    (ensure-directories-exist output)
    (let ((*compile-verbose* nil) (*compile-print* nil) (*load-verbose* nil) (*load-print* nil))
      (handler-bind ((warning (lambda (condition) (error condition))))
        (multiple-value-bind (fasl warned failed) (compile-file source :output-file output)
          (unless (and fasl (not warned) (not failed)) (error "Compilazione non rigorosa: ~A." relative))
          (load fasl :verbose nil :print nil))))))

(defun main ()
  (let* ((root (uiop:pathname-directory-pathname *load-truename*))
         (report (list :schema-version 1 :kind :cbor-string-read-mutation-child
                       :phase :compile-failed :compilation-completed nil :tests-completed nil
                       :compiled-files nil :tests-passed nil :failed-test nil))
         (plan nil) (current-test nil))
    (handler-case
        (let ((*standard-output* *error-output*))
          (setf plan (read-one (merge-pathnames "plan.lisp" root)))
          (setf (getf report :expected-compiled-count) (length (getf plan :files))
                (getf report :expected-test-count) (length (getf plan :tests)))
          (verify-files root (getf plan :files))
          (dolist (entry (getf plan :files))
            (compile-one root (getf entry :path))
            (push (getf entry :path) (getf report :compiled-files)))
          (setf (getf report :compiled-files) (nreverse (getf report :compiled-files))
                (getf report :compilation-completed) t (getf report :phase) :test-failed)
          (let* ((package (find-package (getf plan :test-package)))
                 (registered (symbol-value (find-symbol "*TESTS*" package))))
            (unless (equal (getf plan :tests) (mapcar #'symbol-name (reverse registered)))
              (setf (getf report :phase) :inventory-failed)
              (error "Inventario nominale diverso dai diciassette nomi congelati."))
            (dolist (name (getf plan :tests))
              (setf current-test name)
              (let ((symbol (find-symbol name package)))
                (unless (and symbol (fboundp symbol)) (error "Test nominale assente: ~A." name))
                (funcall (symbol-function symbol)))
              (push name (getf report :tests-passed))))
          (setf current-test nil (getf report :tests-completed) t)
          (verify-files root (getf plan :files))
          (setf (getf report :phase) :ok))
      (error (condition)
        (setf (getf report :failed-test) current-test
              (getf report :diagnostic) (princ-to-string condition)
              (getf report :condition-type) (symbol-name (class-name (class-of condition))))))
    (setf (getf report :tests-passed) (nreverse (getf report :tests-passed))
          (getf report :compiled-count) (length (getf report :compiled-files)))
    (let ((*print-readably* t)) (write report :pretty t) (terpri) (force-output))
    (sb-ext:exit :code (if (eq :ok (getf report :phase)) 0 1))))

(main)
