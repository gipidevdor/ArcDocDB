;;;; Mutazioni C4 della lettura stringhe: copie/cache private, DATA rigorosi.
;;;; Uso: --self-test | --run NEWDIRECTORY. Non carica il prodotto nel parent.
;;;; REQ: REQ-CBR-009 REQ-VAL-001 REQ-AFF-008
(require :asdf)
(require :sb-posix)
(defpackage #:arcdocdb.cbor-string-read.mutation (:use #:cl))
(in-package #:arcdocdb.cbor-string-read.mutation)
(declaim (optimize (safety 3) (debug 2)))

(defparameter *driver-source* *load-truename*)
(defparameter *driver-directory* (uiop:pathname-directory-pathname *load-truename*))
(defparameter *source-root* (truename (merge-pathnames "../../../../" *driver-directory*)))
(defconstant +catalog-sha256+ "be1c765c4bc76b9655afa04320313d92dc7c804abc91f9177698468b29069c27")
(defconstant +child-sha256+ "4d4d4c8aadc2eb177a129c93c369506afae9e29666eed68e8998974947a92973")
(defconstant +timeout-seconds+ 180)

(define-condition invalid-mutation (error)
  ((reason :initarg :reason :reader rejection-reason))
  (:report (lambda (condition stream) (format stream "Mutazione invalida: ~S." (rejection-reason condition)))))

(defun require-that (predicate reason)
  (unless predicate (error 'invalid-mutation :reason reason)))

(defun read-one (path)
  (with-open-file (stream path)
    (require-that (<= (file-length stream) 1048576) :data-budget)
    (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (eof (gensym)))
      (let ((data (read stream nil eof)))
        (require-that (and (not (eq data eof)) (eq eof (read stream nil eof))) :data-eof)
        data))))

(defun write-one-new (path data)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error :external-format :utf-8)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream))))

(defun digest (command path size)
  (let* ((text (uiop:run-program (append command (list (namestring path))) :output :string))
         (hash (subseq text 0 (min size (length text)))))
    (require-that (and (= (length hash) size) (every (lambda (c) (digit-char-p c 16)) hash)) :digest)
    hash))

(defun sha256 (path) (digest '("shasum" "-a" "256") path 64))
(defun blob (path) (digest '("git" "hash-object") path 40))

(defun unique-position (text before)
  (let ((position (search before text)))
    (require-that position :target-missing)
    (require-that (not (search before text :start2 (1+ position))) :target-ambiguous)
    position))

(defun substitute-unique (text before after)
  (let ((position (unique-position text before)))
    (values (concatenate 'string (subseq text 0 position) after (subseq text (+ position (length before)))) position)))

(defun proper-list-p (value maximum)
  (let ((length (handler-case (list-length value) (type-error () nil))))
    (and length (<= length maximum))))

(defun plist-p (value)
  (and (consp value) (proper-list-p value 100) (evenp (length value))
       (let ((seen nil))
         (loop for key in value by #'cddr always
               (and (keywordp key) (not (member key seen)) (progn (push key seen) t))))))

(defun classify (data exit signal expected catalog)
  "Sei precondizioni: processo, DATA, compilazione completa, inventario, nome nominale, atteso."
  (let ((tests (getf catalog :tests)) (sources (getf catalog :sources)))
    (cond
      (signal (values :worker-error :process-signal))
      ((not (integerp exit)) (values :worker-error :missing-exit))
      ((not (and (plist-p data) (eql 1 (getf data :schema-version))
                 (eq :cbor-string-read-mutation-child (getf data :kind))))
       (values :invalid :child-data))
      ((and (eq :ok (getf data :phase)) (not (zerop exit)))
       (values :worker-error :after-completion))
      ((eq :compile-failed (getf data :phase)) (values :invalid :compile-failed))
      ((not (and (eq t (getf data :compilation-completed))
                 (eql (length sources) (getf data :compiled-count))
                 (eql (length sources) (getf data :expected-compiled-count))
                 (eql (length tests) (getf data :expected-test-count))
                 (proper-list-p (getf data :compiled-files) 38)
                 (equal sources (getf data :compiled-files))
                 (proper-list-p (getf data :tests-passed) 17)
                 (every #'stringp (getf data :tests-passed))))
       (values :invalid :incomplete-compilation-or-inventory))
      ((eq :ok (getf data :phase))
       (if (and (zerop exit) (eq t (getf data :tests-completed))
                (null (getf data :failed-test)) (equal tests (getf data :tests-passed)))
           (values (if expected :survived :ok) nil)
           (values :invalid :missing-completion)))
      ((eq :test-failed (getf data :phase))
       (let* ((failed (getf data :failed-test))
              (index (and (stringp failed) (position failed tests :test #'string=))))
         (cond ((getf data :tests-completed) (values :worker-error :after-completion))
               ((not (and (eql exit 1) index (equal (subseq tests 0 index) (getf data :tests-passed))
                          (stringp (getf data :diagnostic)) (plusp (length (getf data :diagnostic)))
                          (stringp (getf data :condition-type))))
                (values :invalid :non-nominal-test-or-exit))
               ((null expected) (values :invalid :baseline-nominal-failure))
               ((not (string= expected failed)) (values :invalid :unexpected-nominal-test))
               (t (values :detected nil)))))
      (t (values :invalid :child-phase)))))

(defun verified-catalog ()
  (require-that (string= +catalog-sha256+ (sha256 (merge-pathnames "catalog.lisp" *driver-directory*))) :catalog-pin)
  (require-that (string= +child-sha256+ (sha256 (merge-pathnames "child.lisp" *driver-directory*))) :child-pin)
  (let* ((catalog (read-one (merge-pathnames "catalog.lisp" *driver-directory*)))
         (text (uiop:read-file-string (merge-pathnames (getf catalog :product) *source-root*) :external-format :utf-8)))
    (require-that (and (eql 1 (getf catalog :schema-version))
                       (eq :cbor-string-read-mutation-catalog (getf catalog :kind))
                       (= 38 (length (getf catalog :sources))) (= 17 (length (getf catalog :tests)))
                       (= 8 (length (getf catalog :mutants)))
                       (= 6 (count t (getf catalog :mutants) :key (lambda (m) (getf m :preregistered))))) :catalog-shape)
    (dolist (pin (getf catalog :frozen-blobs))
      (require-that (string= (second pin) (blob (merge-pathnames (first pin) *source-root*))) :frozen-source-pin))
    (dolist (mutant (getf catalog :mutants))
      (require-that (and (member (getf mutant :expected-first-test) (getf catalog :tests) :test #'string=)
                         (= 1 (getf mutant :semantic-substitutions))
                         (= (length (getf mutant :fragments)) (getf mutant :text-fragments))) :mutant-shape)
      (dolist (fragment (getf mutant :fragments)) (unique-position text (getf fragment :before))))
    catalog))

(defun expect-rejection (function reason)
  (let ((caught nil))
    (handler-case (funcall function)
      (invalid-mutation (condition)
        (require-that (eq reason (rejection-reason condition)) :self-test-reason) (setf caught t)))
    (require-that caught :self-test-missing-rejection)))

(defun synthetic-child (catalog &key (phase :ok) failed)
  (let ((position (and failed (position failed (getf catalog :tests) :test #'string=))))
    (list :schema-version 1 :kind :cbor-string-read-mutation-child :phase phase
          :compilation-completed t :tests-completed (eq phase :ok)
          :compiled-count 38 :expected-compiled-count 38 :compiled-files (getf catalog :sources)
          :expected-test-count 17 :tests-passed (if (eq phase :ok) (getf catalog :tests)
                                                  (subseq (getf catalog :tests) 0 (or position 0)))
          :failed-test failed :diagnostic "Synthetic assertion" :condition-type "SIMPLE-ERROR")))

(defun self-test (catalog)
  "Bersagli assenti/ambigui e classificazioni fredde; nessun LOAD/compile del prodotto."
  (expect-rejection (lambda () (unique-position "abc" "missing")) :target-missing)
  (expect-rejection (lambda () (unique-position "xx" "x")) :target-ambiguous)
  (require-that (string= "aZc" (substitute-unique "abc" "b" "Z")) :self-test-substitution)
  (let* ((expected (getf (first (getf catalog :mutants)) :expected-first-test))
         (ok (synthetic-child catalog)) (failure (synthetic-child catalog :phase :test-failed :failed expected))
         (compile-failure (list :schema-version 1 :kind :cbor-string-read-mutation-child :phase :compile-failed))
         (unknown (synthetic-child catalog :phase :test-failed :failed "TEST-SYNTHETIC-NAME")))
    (dolist (case (list (list ok 0 nil nil :ok) (list ok 0 nil expected :survived)
                        (list failure 1 nil expected :detected) (list compile-failure 1 nil expected :invalid)
                        (list failure 1 9 expected :worker-error) (list ok 1 nil expected :worker-error)
                        (list unknown 1 nil expected :invalid) (list failure 7 nil expected :invalid)
                        (list failure 0 nil expected :invalid) (list nil 1 nil expected :invalid)
                        (list failure 1 nil (first (getf catalog :tests)) :invalid)))
      (destructuring-bind (data exit signal target expected-class) case
        (require-that (eq expected-class (classify data exit signal target catalog)) :self-test-classification)))
    (let ((late (copy-list failure)))
      (setf (getf late :tests-completed) t)
      (require-that (eq :worker-error (classify late 1 nil expected catalog)) :self-test-late-error))
    (list :status :ok :target-rejections 2 :exact-substitution 1 :classification-cases 12
          :frozen-mutants 8 :preregistered 6 :extensions 2 :product-executions 0)))

(defun file-pins (root paths)
  (loop for relative in paths collect (list :path relative :sha256 (sha256 (merge-pathnames relative root)))))

(defun files-match-p (root pins)
  (every (lambda (entry) (string= (getf entry :sha256) (sha256 (merge-pathnames (getf entry :path) root)))) pins))

(defun new-directory (path)
  (let* ((directory (uiop:ensure-directory-pathname (merge-pathnames path *source-root*)))
         (name (string-right-trim "/" (namestring directory))))
    (handler-case (progn (sb-posix:lstat name) (error 'invalid-mutation :reason :existing-destination))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:enoent (sb-posix:syscall-errno condition)) (error condition))))
    (ensure-directories-exist (merge-pathnames "placeholder" (uiop:pathname-parent-directory-pathname directory)))
    (sb-posix:mkdir name #o700)
    directory))

(defun copy-new (source target)
  (require-that (not (probe-file target)) :existing-copy)
  (ensure-directories-exist target)
  (uiop:copy-file source target))

(defun prepare-copy (campaign name mutant catalog original-pins)
  "Verifica ogni copia prima del ritocco; soltanto PRODUCT puo differire al termine."
  (let* ((root (new-directory (merge-pathnames (concatenate 'string name "/") campaign)))
         (product (getf catalog :product)) (edits nil))
    (dolist (relative (getf catalog :sources))
      (copy-new (merge-pathnames relative *source-root*) (merge-pathnames relative root)))
    (require-that (files-match-p root original-pins) :copied-source-pin)
    (when mutant
      (let* ((path (merge-pathnames product root))
             (text (uiop:read-file-string path :external-format :utf-8)))
        (dolist (fragment (getf mutant :fragments))
          (multiple-value-bind (changed position) (substitute-unique text (getf fragment :before) (getf fragment :after))
            (push (list :position position :before (getf fragment :before) :after (getf fragment :after)) edits)
            (setf text changed)))
        (with-open-file (stream path :direction :output :if-exists :supersede :external-format :utf-8)
          (write-string text stream))
        (require-that (string= text (uiop:read-file-string path :external-format :utf-8)) :written-mutation)))
    (let* ((pins (file-pins root (getf catalog :sources)))
           (different (loop for original in original-pins for actual in pins
                            unless (string= (getf original :sha256) (getf actual :sha256)) collect (getf actual :path))))
      (require-that (equal different (when mutant (list product))) :mutation-footprint)
      (copy-new (merge-pathnames "child.lisp" *driver-directory*) (merge-pathnames "child.lisp" root))
      (write-one-new (merge-pathnames "plan.lisp" root)
                     (list :schema-version 1 :files pins :test-package (getf catalog :test-package)
                           :tests (getf catalog :tests)))
      (list :name name :directory (namestring root) :mutant mutant :original-source-pins original-pins
            :copied-source-pins pins :changed-files different :edits (nreverse edits)
            :child-sha256 (sha256 (merge-pathnames "child.lisp" root))))))

(defun wait-bounded (process seconds)
  (let ((deadline (+ (get-internal-real-time) (* seconds internal-time-units-per-second))))
    (loop while (and (member (sb-ext:process-status process) '(:running :stopped))
                     (< (get-internal-real-time) deadline)) do (sleep 0.05))
    (not (member (sb-ext:process-status process) '(:running :stopped)))))

(defun execute-copy (copy catalog)
  "Conserva due flussi fisici, exit e signal; timeout e trasporto non rilevano mutazioni."
  (let* ((root (pathname (getf copy :directory))) (stdout (merge-pathnames "stdout.lisp" root))
         (stderr (merge-pathnames "stderr.log" root)) (process nil) (timed-out nil)
         (data nil) (parse-error nil) (exit nil) (signal nil))
    (with-open-file (out stdout :direction :output :if-exists :error)
      (with-open-file (err stderr :direction :output :if-exists :error)
        (setf process (sb-ext:run-program "sbcl" '("--noinform" "--no-userinit" "--no-sysinit"
                                                   "--disable-debugger" "--script" "child.lisp")
                                          :search t :directory root :output out :error err :wait nil))
        (unless (wait-bounded process +timeout-seconds+)
          (setf timed-out t)
          (sb-ext:process-kill process sb-posix:sigkill)
          (require-that (wait-bounded process 5) :child-would-not-stop))
        (case (sb-ext:process-status process)
          (:exited (setf exit (sb-ext:process-exit-code process)))
          (:signaled (setf signal (sb-ext:process-exit-code process))))))
    (handler-case (setf data (read-one stdout)) (error (condition) (setf parse-error (princ-to-string condition))))
    (multiple-value-bind (classification reason)
        (classify data exit signal (getf (getf copy :mutant) :expected-first-test) catalog)
      (when timed-out (setf classification :worker-error reason :timeout))
      (unless (files-match-p root (getf copy :copied-source-pins))
        (setf classification :invalid reason :copied-source-changed))
      (append copy (list :classification classification :reason reason :detected (eq classification :detected)
                         :stdout (namestring stdout) :stderr (namestring stderr) :exit-code exit :signal signal
                         :timed-out timed-out :parse-error parse-error :child-report data)))))

(defun run-campaign (destination catalog)
  (let* ((root (new-directory destination))
         (source-pins (file-pins *source-root* (getf catalog :sources)))
         (support-pins (file-pins *driver-directory* '("run.lisp" "catalog.lisp" "child.lisp")))
         (report (list :schema-version 1 :kind :cbor-string-read-mutations :status :running
                       :recorded-at (get-universal-time) :self-test (self-test catalog)
                       :source-pins-before source-pins :driver-pins-before support-pins
                       :catalog catalog :copies nil :baseline nil :mutations nil)))
    (handler-case
        (progn
          (dolist (relative '("run.lisp" "catalog.lisp" "child.lisp"))
            (copy-new (merge-pathnames relative *driver-directory*) (merge-pathnames relative root)))
          (setf (getf report :copies) (list (prepare-copy root "baseline" nil catalog source-pins)))
          (dolist (mutant (getf catalog :mutants))
            (setf (getf report :copies)
                  (append (getf report :copies) (list (prepare-copy root (getf mutant :id) mutant catalog source-pins)))))
          (require-that (and (files-match-p *source-root* source-pins)
                             (files-match-p *driver-directory* support-pins)) :source-changed-before-run)
          (setf (getf report :baseline) (execute-copy (first (getf report :copies)) catalog))
          (require-that (eq :ok (getf (getf report :baseline) :classification)) :invalid-baseline)
          (dolist (copy (rest (getf report :copies)))
            (setf (getf report :mutations) (append (getf report :mutations) (list (execute-copy copy catalog)))))
          (require-that (and (= 8 (length (getf report :mutations)))
                             (every (lambda (row) (eq :detected (getf row :classification))) (getf report :mutations)))
                        :mutation-not-detected)
          (setf (getf report :status) :ok))
      (error (condition)
        (setf (getf report :status) :failed (getf report :diagnostic) (princ-to-string condition))))
    (setf (getf report :source-pins-after) (file-pins *source-root* (getf catalog :sources))
          (getf report :driver-pins-after) (file-pins *driver-directory* '("run.lisp" "catalog.lisp" "child.lisp")))
    (unless (and (equal source-pins (getf report :source-pins-after))
                 (equal support-pins (getf report :driver-pins-after)))
      (setf (getf report :status) :source-changed))
    (write-one-new (merge-pathnames "report.lisp" root) report)
    report))

(defun main ()
  (let ((report nil))
    (handler-case
        (let ((args (rest sb-ext:*posix-argv*)) (catalog (verified-catalog)))
          (setf report (cond ((equal args '("--self-test")) (self-test catalog))
                             ((and (= 2 (length args)) (string= "--run" (first args)))
                              (run-campaign (second args) catalog))
                             (t (error 'invalid-mutation :reason :arguments)))))
      (error (condition)
        (setf report (list :status :failed :phase :parent-preflight :diagnostic (princ-to-string condition)))))
    (let ((*print-readably* t)) (write report :pretty t) (terpri))
    (unless (eq :ok (getf report :status)) (sb-ext:exit :code 1))))

(main)
