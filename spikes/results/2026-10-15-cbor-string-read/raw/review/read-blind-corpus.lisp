(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((package (make-package "ARCDOCDB.CBOR" :use '("CL"))))
  (export (intern "LEGGI-STRINGA-CBOR-MINIMA" package) package))
(let ((*read-eval* nil) (total 0) (names nil))
  (assert (not (probe-file "src/codec/cbor-string-read.lisp")))
  (dolist (path '("tests/codec/cbor-string-read-support.lisp"
                  "tests/codec/cbor-string-read.lisp" "tests/codec/cbor-string-read-threads.lisp"))
    (let ((forms 0) (tests 0))
      (with-open-file (stream path)
        (loop for form = (read stream nil :eof) until (eq form :eof)
              do (incf forms)
                 (when (and (consp form) (eq 'deftest (first form)))
                   (incf tests) (assert (not (member (second form) names))) (push (second form) names))))
      (incf total forms)
      (format t "~A DATA-EOF ~Dforme/~Dnominali,bytes~D SHA256~A BLOB~A~%"
              path forms tests (arcdocdb.evidence:file-bytes path) (arcdocdb.evidence:file-sha256 path)
              (string-trim '(#\Newline #\Return)
                           (uiop:run-program (list "git" "hash-object" path) :output :string)))))
  (assert (= 31 total)) (assert (= 17 (length names)))
  (format t "TOTAL31forme,17nominali unici;READ-EVAL NIL/EOF;BODYprodotto assente;nessun LOAD/compile corpus/prodotto.~%"))
(let ((state #x53545239))
  (dotimes (i 1024) (setf state (logand #xffffffff (+ (* state 1664525) 1013904223))))
  (assert (= state #xf8417639)) (format t "LCG seed53545239 final~8,'0X.~%" state))
(let ((buffer (make-array 25 :element-type '(unsigned-byte 8))))
  (dotimes (i 25) (setf (aref buffer i) (mod (+ #xa7 (* i 37)) 256)))
  (replace buffer '(#x44 0 #xff #x1c #x80 #x63 #xe2 #x82 #xac #xff #x1c #x18 0) :start1 7)
  (loop for entry in '((2 8 12) (3 13 16)) for expected-token in '(41333 41509)
        for expected-sink in '(84649984 85010432)
        for token = (+ (* 17 (first entry)) (* 31 (second entry)) (third entry)
                        (loop for i below 25 sum (* (1+ i) (aref buffer i))))
        do (assert (= token expected-token)) (assert (= (* 2048 token) expected-sink))
           (format t "WORKERcold ~S token~D sink~D.~%" entry token expected-sink)))
(let ((accepted '(112 128 72 5 0 0 2 0 0 0 0 6 0 8 3))
      (rejected '(0 0 0 1 16 10 4 30 76 32 16 114 36 16 3)))
  (assert (= 336 (reduce #'+ accepted))) (assert (= 354 (reduce #'+ rejected)))
  (assert (= 9906 (+ 336 354 1024 8192)))
  (format t "PLAN arithmetic:690nonfuzz336/354 +1024fuzz512/512 +8192parallel=9906calls,9040success/866reject;not runtimecounters.~%"))
