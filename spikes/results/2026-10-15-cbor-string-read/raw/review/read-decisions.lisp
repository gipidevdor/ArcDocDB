(require :asdf)
(defpackage #:arcdocdb.conditions (:export #:resource-exhausted))
(defpackage #:arcdocdb.utf8 (:export #:verifica-utf8))
(let ((*read-eval* nil) (forms nil))
  (with-open-file (in "src/codec/cbor-string-read.lisp")
    (loop for form = (read in nil :eof) until (eq form :eof) do (push form forms)))
  (setf forms (nreverse forms))
  (let ((controls 0) (ands 0) (operands 0) (errors 0) (comparisons 0) (chains 0))
    (labels ((walk (node)
               (when (consp node)
                 (unless (member (car node) '(quote function))
                   (when (member (car node) '(if when unless cond case loop dotimes)) (incf controls))
                   (when (member (car node) '(and or)) (incf ands) (incf operands (length (cdr node))))
                   (when (eq (car node) 'error) (incf errors))
                   (when (member (car node) '(< <= = > >=))
                     (incf comparisons) (when (> (length node) 3) (incf chains)))
                   (mapc #'walk node)))))
      (mapc #'walk forms))
    (assert (= (length forms) 6)) (assert (= controls 12)) (assert (= ands 1))
    (assert (= operands 2)) (assert (= errors 11)) (assert (= comparisons 9)) (assert (zerop chains))
    (format t "~S~%" (list :status :ok :data-forms (length forms) :control-sites controls
                          :and-or-sites ands :and-or-operands operands :error-sites errors
                          :numeric-comparisons comparisons :numeric-chains chains
                          :product-loaded nil :product-compiled nil))))
