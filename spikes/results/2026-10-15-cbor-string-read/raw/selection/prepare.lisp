(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(defun data-file (path)
  (let ((*read-eval* nil))
    (with-open-file (in path)
      (let ((x (read in nil :eof)))
        (assert (not (eq x :eof))) (assert (eq :eof (read in nil :eof))) x))))
(defun save-data (path value)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :error)
    (let ((*print-readably* t)) (write value :stream out :pretty t) (terpri out))))
(defun archive-selection (plan)
  (let ((files nil) (processes nil) (seen (make-hash-table :test 'equal)) (excluded nil)
        (directories 0))
    (labels ((add-file (source relative)
               (when (equal "md" (pathname-type relative))
                 (setf relative (concatenate 'string relative ".txt")))
               (assert (not (gethash relative seen)))
               (assert (sb-posix:s-isreg (sb-posix:stat-mode (sb-posix:lstat source))))
               (assert (< (hash-table-count seen) 10000))
               (setf (gethash relative seen) t)
               (push (list :source (namestring (truename source)) :path relative) files))
             (walk (root directory prefix depth)
               (assert (<= depth 32)) (assert (<= (incf directories) 10000))
               (assert (sb-posix:s-isdir
                        (sb-posix:stat-mode
                         (sb-posix:lstat (string-right-trim "/" (namestring directory))))))
               (dolist (path (uiop:directory-files directory))
                 (if (string-equal "fasl" (or (pathname-type path) ""))
                     (push (namestring path) excluded)
                     (add-file path (concatenate 'string prefix (enough-namestring path root)))))
               (dolist (sub (uiop:subdirectories directory))
                 (if (string-equal "fasl" (car (last (pathname-directory sub))))
                     (push (namestring sub) excluded) (walk root sub prefix (1+ depth))))))
      (dolist (entry (getf plan :records))
        (destructuring-bind (label source) entry
          (let* ((record (arcdocdb.evidence:read-evidence source :max-expanded-bytes 134217728))
                 (directory (uiop:pathname-directory-pathname (truename source)))
                 (relative (format nil "processes/~A/report.lisp" label)))
            (assert (eq :command-verification (getf record :kind)))
            (assert (member (getf record :status) '(:ok :failed :source-changed)))
            (assert (getf record :finished-at-universal-time))
            (dolist (file (uiop:directory-files directory))
              (add-file file (format nil "processes/~A/~A" label (file-namestring file))))
            (push (list :label label :record-path relative) processes))))
      (dolist (entry (getf plan :roots))
        (destructuring-bind (label source) entry
          (let ((root (uiop:ensure-directory-pathname (truename source))))
            (walk root root (format nil "raw/~A/" label) 0))))
      (dolist (source (getf plan :frozen))
        (add-file source (concatenate 'string "raw/frozen/" source))))
    (let* ((sorted (sort (copy-list files) #'string< :key (lambda (x) (getf x :path))))
           (manifest (list :schema-version 1 :kind :command-archive-manifest
                           :date "2026-10-15" :files sorted :processes (nreverse processes))))
      (save-data (getf plan :destination) manifest)
      (format t "~S~%" (list :status :ok :explicit-files (length files)
                            :explicit-processes (length (getf plan :records))
                            :indexed-before-automatic-files (length sorted)
                            :explicit-bytes (loop for entry in sorted sum
                                             (arcdocdb.evidence:file-bytes (getf entry :source)))
                            :excluded-compiled-cache (sort excluded #'string<))))))
(let ((args (uiop:command-line-arguments)))
  (assert (= 1 (length args)))
  (archive-selection (data-file (first args))))
