(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((rows nil))
  (dolist (source (directory "spikes/out/cbor-string-read-20261015/frozen-qualification/**/*.md"))
    (let* ((target (pathname (concatenate 'string (namestring source) ".txt")))
           (hash (arcdocdb.evidence:file-sha256 source)))
      (assert (not (probe-file target)))
      (rename-file source target)
      (assert (string= hash (arcdocdb.evidence:file-sha256 target)))
      (push (list :source (namestring source) :target (namestring target) :sha256 hash) rows)))
  (format t "~S~%" (list :status :ok :renamed-raw-documents (length rows)
                         :bytes-preserved t :moves (nreverse rows))))
