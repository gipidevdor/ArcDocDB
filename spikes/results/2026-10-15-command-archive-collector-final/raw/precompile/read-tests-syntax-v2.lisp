(require :asdf)
(require :sb-posix)
(make-package "ARCDOCDB.COMMAND-ARCHIVE.COLLECT" :use '("CL"))
(let ((package (make-package "ARCDOCDB.EVIDENCE" :use '("CL"))))
  (dolist (name '("FILE-SHA256" "READ-EVIDENCE")) (export (intern name package) package)))
(defun write-read-status (code)
  (with-open-file (stream "spikes/out/command-archive-collector-20261015/precompile/read-tests-syntax-v2.status.txt"
                          :direction :output :if-exists :error)
    (format stream "~D~%" code)))
(defun planned-cases (form)
  (cond ((atom form) 0)
        ((eq 'quote (first form)) 0)
        ((eq 'ct-case (first form)) 1)
        ((eq 'dolist (first form))
         (let ((values (second (second form))))
           (assert (eq 'quote (first values)))
           (* (length (second values)) (reduce #'+ (mapcar #'planned-cases (cddr form)) :initial-value 0))))
        (t (reduce #'+ (mapcar #'planned-cases form) :initial-value 0))))
(handler-case
    (let ((*read-eval* nil) (forms nil))
      (with-open-file (stream "tools/collect-command-archive-tests.lisp")
        (loop for form = (read stream nil :eof) until (eq form :eof) do (push form forms)))
      (let* ((suite (find 'self-test forms :key (lambda (form) (and (consp form) (eq 'defun (first form)) (second form))))))
        (assert suite) (assert (= 30 (length forms))) (assert (= 59 (planned-cases suite)))
        (format t "DATA-EOF READ-EVAL NIL:30forme,59casipianificatiperespansione aritmetica dei DOLIST letterali. Nessun LOAD/EVAL/compile del filetest o collector.~%"))
      (write-read-status 0))
  (error (condition)
    (format *error-output* "Lettura DATA fallita:~A~%" condition)
    (write-read-status 1) (sb-ext:exit :code 1)))
