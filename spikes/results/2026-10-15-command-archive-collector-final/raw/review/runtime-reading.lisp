;;;; Lettore DATA indipendente; PREPARATO, non eseguito alla consegna.
;;;; Nessun LOAD del collector, dei suoi test o del prodotto; nessuna campagna.
;;;; Uso: SELFTEST-WRAPPER FULLCHECK-WRAPPER SELFTEST-ROOT COMMIT COLLECTOR-BLOB TESTS-BLOB
;;;;      [--failed WRAPPER SELFTEST-ROOT-OPPURE--]...
;;;; I pin dei tentativi corretti vengono passati esplicitamente dopo il freeze.
;;;; Gli originali falliti sono osservazioni separate, mai promossi a PASS.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:archive-runtime-reading (:use #:cl))
(in-package #:archive-runtime-reading)
(declaim (optimize (safety 3) (debug 3)))
(defvar *checks* 0)
(defvar *observed* (make-hash-table :test 'equal))
(defvar *commit*)
(defvar *pins*)
(defparameter *historical-pins*
  '(("tools/collect-command-archive.lisp" . "48c4e1a23390a43767a3630d66514d9c03a79159")
    ("tools/collect-command-archive-tests.lisp" . "49da390b7e170acc9ffdafa78285f215aec75f44")))
(defparameter *expanded-limit* 134217728)

(defun demand (truth control &rest arguments)
  (unless truth (error (apply #'format nil control arguments)))
  (incf *checks*) t)

(defun plist-p (object)
  (and (listp object) (let ((n (list-length object))) (and n (evenp n)))))

(defun fingerprint (path)
  (let ((physical (truename path)))
    (list :path (namestring physical)
          :bytes (arcdocdb.evidence:file-bytes physical)
          :sha256 (arcdocdb.evidence:file-sha256 physical)
          :write-date (file-write-date physical))))

(defun observe (path)
  (let* ((now (fingerprint path)) (key (getf now :path))
         (before (gethash key *observed*)))
    (if before (demand (equal before now) "File cambiato durante lettura: ~A" key)
        (setf (gethash key *observed*) now))
    (pathname key)))

(defun raw-one (path)
  (demand (<= (arcdocdb.evidence:file-bytes path) *expanded-limit*) "DATA troppo grande: ~A" path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*package* (find-package :cl-user)) (end (gensym "EOF")))
    (with-open-file (stream path)
      (let ((value (read stream nil end)))
        (demand (not (eq end value)) "DATA vuoto: ~A" path)
        (demand (eq end (read stream nil end)) "DATA oltre EOF: ~A" path)
        value))))

(defun evidence (path)
  ;; Prima si fissano descriptor e payload fisici; poi l'API pubblica autentica gzip.
  (let* ((physical (observe path)) (container (raw-one physical)))
    (when (and (plist-p container) (eq :compressed-evidence (getf container :kind)))
      (let ((payload (getf container :payload)))
        (demand (and (stringp payload) (plusp (length payload))
                     (not (find #\/ payload)) (not (find #\\ payload))
                     (not (member payload '("." "..") :test #'string=)))
                "Payload non sibling: ~S" payload)
        (observe (merge-pathnames payload physical))))
    (arcdocdb.evidence:read-evidence physical :max-expanded-bytes *expanded-limit*)))

(defun bytes (path)
  (let ((physical (observe path)))
    (demand (<= (arcdocdb.evidence:file-bytes physical) 8388609) "Fixture bytes troppo grande")
    (with-open-file (stream physical :element-type '(unsigned-byte 8))
      (let ((data (make-array (file-length stream) :element-type '(unsigned-byte 8))))
        (demand (= (length data) (read-sequence data stream)) "Lettura bytes incompleta") data))))

(defun same-bytes (left right)
  (demand (equalp (bytes left) (bytes right)) "Byte completi diversi: ~A / ~A" left right))

(defun data-text (text)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*package* (find-package :cl-user)) (end (gensym "EOF")))
    (with-input-from-string (stream text)
      (let ((value (read stream nil end)))
        (demand (and (not (eq value end)) (eq end (read stream nil end))) "Output DATA/EOF invalido")
        value))))

(defun lines (text)
  (with-input-from-string (stream text)
    (loop for line = (read-line stream nil nil) while line collect line)))

(defun prefix-p (prefix text)
  (and (stringp text) (<= (length prefix) (length text))
       (string= prefix text :end2 (length prefix))))

(defun hash-command (&rest args)
  (string-trim '(#\Space #\Newline #\Return)
               (uiop:run-program (cons "git" args) :output :string :error-output :string)))

(defun metadata-pin (record path side)
  (let ((rows (remove-if-not (lambda (row) (equal path (getf row :path))) (getf record side))))
    (demand (= 1 (length rows)) "Pin assente/duplicato: ~A ~S" path side)
    (getf (first rows) :git-blob)))

(defun command-record (path &key (pass t) (current t))
  (let ((record (evidence path)))
    (demand (and (plist-p record) (eql 1 (getf record :schema-version))
                 (eq :command-verification (getf record :kind))) "Wrapper invalido: ~A" path)
    (demand (integerp (getf record :finished-at-universal-time)) "Wrapper ancora incompleto: ~A" path)
    (demand (and (eq :stable (getf record :source-consistency))
                 (equal (getf record :source-blobs-before) (getf record :source-blobs-after)))
            "Snapshot non stabile: ~A" path)
    (if pass
        (demand (and (eq :ok (getf record :status)) (eql 0 (getf record :exit-code)))
                "Wrapper atteso PASS: ~A" path)
        (demand (and (eq :failed (getf record :status))
                     (integerp (getf record :exit-code)) (plusp (getf record :exit-code)))
                "Tentativo storico non FAILED: ~A" path))
    (let ((environment (getf record :environment)))
      (when (and current (plist-p environment) (getf environment :commit))
        (demand (prefix-p *commit* (getf environment :commit)) "Commit wrapper differente")))
    (demand (and (stringp (getf record :stdout)) (stringp (getf record :stderr))) "Output wrapper assenti")
    (dolist (pin (if current *pins* *historical-pins*))
      (let ((before (metadata-pin record (car pin) :source-blobs-before))
            (after (metadata-pin record (car pin) :source-blobs-after)))
        (demand (equal before after) "Due pin wrapper differenti")
        (demand (equal (cdr pin) before) "Pin wrapper inatteso: ~A" (car pin))))
    record))

(defun self-summary (summary &key (pass t) root)
  (demand (and (plist-p summary) (eql 1 (getf summary :schema-version))
               (eq :command-archive-collector-self-test (getf summary :kind))
               (= 59 (getf summary :case-count)) (= 59 (length (getf summary :cases)))
               (integerp (getf summary :checks)) (plusp (getf summary :checks))
               (eq t (getf summary :fixtures-preserved))) "Schema selftest invalido")
  (demand (eq (if pass :ok :failed) (getf summary :status)) "Esito selftest inatteso")
  (let ((cases (getf summary :cases)))
    (loop for item in cases for serial from 1 do
      (demand (and (= serial (getf item :case-id)) (stringp (getf item :name))
                   (integerp (getf item :checks))
                   (if pass (and (eq :ok (getf item :status)) (plusp (getf item :checks)))
                       (member (getf item :status) '(:ok :failed)))) "Caso selftest invalido: ~D" serial)
      (when root
        (let* ((directory (merge-pathnames (format nil "case-~2,'0D-~A/" serial (getf item :name)) root))
               (stored (evidence (merge-pathnames "case-result.lisp" directory))))
          (demand (equalp stored item) "Summary/case fisico diversi: ~D" serial))))
    (unless pass (demand (find :failed cases :key (lambda (item) (getf item :status))) "Storico senza casi falliti"))
    (demand (= (getf summary :checks) (reduce #'+ cases :key (lambda (item) (getf item :checks))))
            "Checks selftest non sommabili")
    (list :status (getf summary :status) :cases 59 :checks (getf summary :checks)
          :failed-cases (count :failed cases :key (lambda (item) (getf item :status))))))

(defun case-directory (summary name)
  (let ((item (find name (getf summary :cases) :key (lambda (row) (getf row :name)) :test #'string=)))
    (demand item "Caso mancante: ~A" name)
    (values (uiop:ensure-directory-pathname (getf item :directory)) item)))

(defun closed-result (audit indexed actual)
  (demand (and (eq :command-archive-audit (getf audit :kind)) (eq :ok (getf audit :status))
               (eq t (getf audit :closed-inventory)) (= indexed (getf audit :indexed-files))
               (= actual (getf audit :actual-files)) (null (getf audit :read-eval))
               (eq t (getf audit :eof-required))) "Strict checker non conforme"))

(defun archive-positive (summary name processes)
  (multiple-value-bind (directory item) (case-directory summary name)
    (declare (ignore item))
    (let* ((root (merge-pathnames "archive/" directory))
           (report (evidence (merge-pathnames "observations/report.lisp" directory)))
           (index (evidence (merge-pathnames "archive-index.lisp" root)))
           (rows (getf index :files)) (closure (getf report :independent-closure))
           (log (evidence (getf closure :log))))
      (demand (and (eq :command-archive-collection (getf report :kind))
                   (eq :ok (getf report :status)) (eq :complete (getf report :phase))
                   (= 9 (getf report :planned-files) (length rows) (length (getf report :copy-results)))
                   (= 4 (getf report :workers)) (= 3 (getf report :sha-per-copy))) "Positivo incompleto")
      (let ((counts (getf report :worker-copied-counts)))
        (demand (and (= 4 (length counts)) (every (lambda (n) (and (integerp n) (plusp n))) counts)
                     (= 9 (reduce #'+ counts)) (equal '(nil nil nil nil) (getf report :worker-errors))
                     (null (getf report :cleanup-errors))) "Contatori/join worker invalidi"))
      (demand (every (lambda (copy) (eq :ok (getf copy :status))) (getf report :copy-results)) "Copia fallita")
      (demand (and (= processes (length (getf index :processes)))
                   (equal (getf index :processes) (getf report :processes))) "Processi promossi/persi")
      (demand (and (eql 0 (getf closure :exit-code)) (null (getf closure :signal))
                   (equalp log (getf closure :result))) "Log/closure differenti")
      (closed-result log 9 11)
      ;; Tutte le nove copie, non un campione, vengono confrontate byte per byte.
      (dolist (row rows)
        (let ((target (merge-pathnames (getf row :path) root)) (source (getf row :source)))
          (same-bytes source target)
          (demand (= (getf row :bytes) (arcdocdb.evidence:file-bytes target)) "Bytes indice diversi")
          (demand (string= (getf row :sha256) (arcdocdb.evidence:file-sha256 target)) "SHA indice diverso")))
      (let ((original (evidence (merge-pathnames "inputs/records/gzip/report.lisp" directory)))
            (copied (evidence (merge-pathnames "processes/gzip/report.lisp" root))))
        (demand (equalp original copied) "Record gzip modificato"))
      (when (= processes 4)
        (let ((expected '((:ok 0 :stable) (:failed nil :stable) (:source-changed 0 :changed) (:failed 7 :stable))))
          (loop for row in (getf index :processes) for history in expected do
            (let* ((relative (getf row :record-path)) (entry (find relative rows :test #'string= :key (lambda (r) (getf r :path))))
                   (source (evidence (getf entry :source))) (copy (evidence (merge-pathnames relative root))))
              (demand (equalp source copy) "Record storico alterato")
              (demand (equal history (list (getf copy :status) (getf copy :exit-code) (getf copy :source-consistency)))
                      "Esito storico promosso")
              (dolist (key '(:command :status :exit-code :source-consistency))
                (demand (equal (getf source key) (getf row key)) "Metadato storico differente")))))
        (closed-result (evidence (merge-pathnames "independent-recheck.stdout.lisp" directory)) 9 11)
        (demand (zerop (length (bytes (merge-pathnames "independent-recheck.stderr.log" directory))))
                "Diagnostico recheck inatteso"))
      (list :case name :indexed-files 9 :actual-files 11 :workers 4
            :worker-counts (getf report :worker-copied-counts) :processes processes
            :whole-byte-comparisons 9 :closed-inventory t))))

(defun special-cases (summary)
  (dolist (name '("explicit-gzip-payload-required" "accessory-descriptor-also-needs-explicit-payload"
                  "gzip-target-must-match-descriptor" "descriptor-hash-mismatch"))
    (multiple-value-bind (directory item) (case-directory summary name)
      (declare (ignore directory))
      (demand (and (eq :decoded-record (getf (getf item :detail) :expected-reason))
                   (eq :decoded-record (getf (getf item :detail) :observed-reason))) "Rifiuto payload errato")))
  (dolist (name '("manifest-read-eval-disabled" "manifest-eof-required" "record-read-eval-disabled" "record-eof-required"))
    (multiple-value-bind (directory item) (case-directory summary name)
      (demand (eq :data-shape (getf (getf item :detail) :observed-reason)) "READ/EOF non rifiutato")
      (demand (not (probe-file (merge-pathnames "read-eval-ran.txt" directory))) "#. eseguito")))
  (dolist (pair '(("corrupt-copy-retains-failure" :copied-bytes)
                  ("source-change-retains-failure" :source-changed)
                  ("unindexed-extra-rejected-by-final-checker" :closed-check)))
    (multiple-value-bind (directory item) (case-directory summary (first pair))
      (let ((report (evidence (merge-pathnames "observations/report.lisp" directory))))
        (demand (and (eq :failed (getf report :status))
                     (eq (second pair) (getf report :reason))
                     (eq (second pair) (getf (getf item :detail) :observed-reason))) "Fallimento conservato errato"))))
  (multiple-value-bind (directory item) (case-directory summary "unindexed-extra-rejected-by-final-checker")
    (let ((log (evidence (getf (getf item :detail) :checker-log))))
      (demand (and (eq :command-archive-audit (getf log :kind)) (eq :failed (getf log :status))
                   (eq :inventory (getf log :reason))) "Checker hidden-extra: motivo errato")
      (demand (equalp #(23 45) (bytes (merge-pathnames "archive/.unindexed-extra.bin" directory))) "Extra non conservato")))
  (dolist (pair '(("plain-budget-exact-boundary" "raw/data.bin" 1048576)
                  ("gzip-budget-exact-boundary" "raw/data.gz" 8388608)))
    (multiple-value-bind (directory item) (case-directory summary (first pair))
      (declare (ignore item))
      (let ((source (merge-pathnames "inputs/raw/data.bin" directory))
            (target (merge-pathnames (concatenate 'string "archive/" (second pair)) directory)))
        (same-bytes source target)
        (demand (= (third pair) (arcdocdb.evidence:file-bytes target)) "Limite esatto non preservato"))))
  t)

(defun embedded-summaries (text)
  ;; Solo forme a inizio riga. READ-EVAL NIL; nessun frammento viene valutato.
  (let ((results nil) (offset 0) (*read-eval* nil) (*readtable* (copy-readtable nil))
        (*read-base* 10) (*package* (find-package :cl-user)))
    (dolist (line (lines text))
      (when (and (plusp (length line)) (char= #\( (char line 0)))
        (let ((value (handler-case (read-from-string text nil nil :start offset) (reader-error () nil))))
          (when (plist-p value) (push value results))))
      (incf offset (1+ (length line))))
    (nreverse results)))

(defun integers-in (text)
  (loop with start = nil for i from 0 to (length text)
        for digit = (and (< i (length text)) (digit-char-p (char text i)))
        when (and digit (null start)) do (setf start i)
        when (and start (not digit)) collect (prog1 (parse-integer text :start start :end i) (setf start nil))))

(defun numeric-summary (all-lines needle count)
  (let ((found (remove-if-not (lambda (line) (search needle line)) all-lines)))
    (demand (= 1 (length found)) "Summary assente/duplicato: ~A" needle)
    (let ((numbers (integers-in (first found))))
      (demand (and (= count (length numbers)) (zerop (car (last numbers)))) "Summary fallito: ~S" found)
      (first found))))

(defun full-check (record)
  (let ((output (getf record :stdout)) (nested-path nil))
    (unless (search "build e test: nessun avviso, tutti i controlli superati" output)
      (let ((pointers (remove-if-not (lambda (line) (search "; record: " line)) (lines output))))
        (demand (= 1 (length pointers)) "Atteso un solo wrapper check-core esplicito")
        (let* ((line (first pointers)) (at (search "; record: " line)))
          (setf nested-path (string-trim '(#\Space #\Return) (subseq line (+ at 10)))))
        (let ((inner (command-record nested-path)))
          (demand (member "check-core" (getf inner :command) :test #'string=) "Nested command non check-core")
          (setf output (getf inner :stdout)))))
    (demand (search "build e test: nessun avviso, tutti i controlli superati" output) "Build non concluso")
    (let* ((all-lines (lines output))
           (ok-lines (remove-if-not (lambda (line) (prefix-p "ok    " line)) all-lines))
           (smoke '("ok    package ARCDOCDB presente" "ok    ARCDOCDB:*VERSION* è una stringa"))
           (nominal (remove-if-not (lambda (line) (and (search "::" line) (not (member line smoke :test #'string=)))) ok-lines))
           (summaries (embedded-summaries output))
           (evidence-summary (remove-if-not (lambda (row) (and (eq :ok (getf row :status)) (getf row :catalogs))) summaries))
           (spike-line (remove-if-not (lambda (line) (search " spike completati; risultati: " line)) all-lines)))
      (dolist (line smoke) (demand (= 1 (count line ok-lines :test #'string=)) "Smoke assente/duplicato: ~A" line))
      (demand (and nominal (= (length nominal) (length (remove-duplicates nominal :test #'string=)))) "Nominali assenti/duplicati")
      (dolist (kind '(:evidence-storage-tests :evidence-publication-tests :normalizer-compression-tests :command-archive-collector-self-test))
        (let ((rows (remove-if-not (lambda (row) (eq kind (getf row :kind))) summaries)))
          (demand (= 1 (length rows)) "Summary tool assente/duplicato: ~S" kind)
          (demand (and (eq :ok (getf (first rows) :status)) (plusp (getf (first rows) :checks))) "Summary tool fallito")
          (when (eq kind :command-archive-collector-self-test) (self-summary (first rows)))))
      (demand (= 1 (length evidence-summary)) "Summary evidence assente/duplicato")
      (demand (= 1 (length spike-line)) "Summary spike assente/duplicato")
      (let* ((line (first spike-line)) (marker " spike completati; risultati: ") (at (search marker line))
             (count (parse-integer line :end at))
             (directory (uiop:ensure-directory-pathname (string-trim '(#\Space #\Return) (subseq line (+ at (length marker))))))
             (spikes (evidence (merge-pathnames "report.lisp" directory))))
        (demand (and (= 10 count (length (getf spikes :runs)) (length (getf spikes :run-artifacts)))
                     (eq :complete (getf spikes :status)) (equal "--check" (getf spikes :mode))) "Spike non completi/check")
        (loop for run in (getf spikes :runs) for path in (getf spikes :run-artifacts) for n from 1 do
          (demand (equal (format nil "SPK-~2,'0D" n) (getf run :id)) "Spike ID inatteso")
          (demand (and (eql 0 (getf run :exit-code)) (eq :stable (getf run :source-consistency))
                       (member (getf run :status) '(:ok :pass))
                       (member "--check" (getf run :command) :test #'string=)
                       (not (member "--bench" (getf run :command) :test #'string=))) "Spike limitato/fallito")
          (demand (equalp run (evidence path)) "Spike raw/summary differenti")))
      (list :nested-wrapper nested-path :nominal-count (length nominal) :nominal-unique t :smoke-count 2
            :lint (numeric-summary all-lines " violazioni" 2)
            :trace (numeric-summary all-lines " scenari FI, " 5)
            :links (numeric-summary all-lines " link controllati, " 3)
            :evidence (first evidence-summary) :spikes 10 :spike-mode :check-only))))

(defun main ()
  (let* ((args (uiop:command-line-arguments))
         (self-path (first args)) (full-path (second args))
         (root (and (third args) (uiop:ensure-directory-pathname (third args)))))
    (demand (>= (length args) 6) "Uso: SELF FULL ROOT COMMIT COLLECTOR-BLOB TESTS-BLOB [--failed WRAPPER ROOT-OPPURE--]...")
    (setf *commit* (fourth args)
          *pins* (list (cons "tools/collect-command-archive.lisp" (fifth args))
                       (cons "tools/collect-command-archive-tests.lisp" (sixth args))))
    (demand (prefix-p *commit* (hash-command "rev-parse" "HEAD")) "HEAD corrente differente")
    (dolist (pin *pins*) (demand (string= (cdr pin) (hash-command "hash-object" "--" (car pin))) "Pin corrente differente"))
    (let ((self (command-record self-path)) (full (command-record full-path)) (historical nil))
      (loop for tail on (nthcdr 6 args) by #'cdddr do
        (demand (and (equal "--failed" (first tail)) (second tail) (third tail)) "Argomento storico invalido")
        (let* ((record (command-record (second tail) :pass nil :current nil))
               (old-root (unless (string= "-" (third tail)) (uiop:ensure-directory-pathname (third tail))))
               (summary (and old-root (evidence (merge-pathnames "self-test-report.lisp" old-root)))))
          (push (list :wrapper (second tail) :status (getf record :status) :exit-code (getf record :exit-code)
                      :diagnostic (getf record :diagnostic)
                      :summary (when summary (self-summary summary :pass nil :root old-root))) historical)))
      (let* ((summary (evidence (merge-pathnames "self-test-report.lisp" root)))
             (self-result (self-summary summary :root root))
             (stdout-summary (data-text (getf self :stdout)))
             (positive (archive-positive summary "explicit-closed-parallel-history" 4))
             (accessory (archive-positive summary "accessory-compressed-record-retained-with-payload" 3))
             (full-result (full-check full)))
        (demand (equalp summary stdout-summary) "Selftest stdout/fisico differenti")
        (demand (equal (truename root) (truename (getf summary :root))) "Selftest root differente")
        (special-cases summary)
        (maphash (lambda (path old) (demand (equal old (fingerprint path)) "SHA/metadata cambiati dopo lettura: ~A" path)) *observed*)
        (demand (prefix-p *commit* (hash-command "rev-parse" "HEAD")) "HEAD cambiato dopo lettura")
        (dolist (pin *pins*) (demand (string= (cdr pin) (hash-command "hash-object" "--" (car pin))) "Pin cambiato dopo lettura"))
        (list :schema-version 1 :kind :independent-command-archive-runtime-reading :status :ok
              :checks *checks* :self-test self-result :positive positive :accessory accessory
              :full-check full-result :historical-attempts (nreverse historical)
              :physical-files-observed (hash-table-count *observed*) :sha-and-metadata-before-after :stable
              :observations (sort (loop for row being the hash-values of *observed* collect row) #'string< :key (lambda (r) (getf r :path)))
              :limits '(:data-only :read-eval-nil :eof-for-records :no-runtime-repetition
                        :fixture-assertions-plus-four-positive-worker-counters
                        :no-core-parallelism-claim :no-throughput-claim :no-c1-coverage-claim
                        :lint-trace-links-structural-evidence-checks :spikes-check-not-benchmark
                        :historical-failures-preserved :one-explicit-nested-command-wrapper))))))

(handler-case
    (let ((*print-readably* t) (*print-circle* t) (*print-length* nil) (*print-level* nil))
      (write (main) :pretty t) (terpri))
  (error (condition)
    (write (list :schema-version 1 :kind :independent-command-archive-runtime-reading
                 :status :failed :checks *checks* :diagnostic (princ-to-string condition)) :pretty t)
    (terpri) (sb-ext:exit :code 1)))
