(require :asdf)
(require :sb-posix)
(let ((package (make-package "ARCDOCDB.EVIDENCE" :use '("CL"))))
  (dolist (name '("READ-EVIDENCE" "FILE-BYTES" "FILE-SHA256" "CALL-WITH-EVIDENCE-BYTES"))
    (export (intern name package) package)))
(let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (eof (gensym "EOF")) (count 0))
  (with-open-file (stream "tools/collect-command-archive.lisp" :external-format :utf-8)
    (loop for form = (read stream nil eof) until (eq form eof) do (incf count)))
  (format t "~D forms READ/EOF; no LOAD or collector execution.~%" count))
