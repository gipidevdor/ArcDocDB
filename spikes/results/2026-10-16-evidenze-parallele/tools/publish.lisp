(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(defun save-new (path data)
  (with-open-file (out path :direction :output :if-exists :error)
    (let ((*print-readably* t)) (write data :stream out :pretty t) (terpri out))))
(let* ((campaign (truename "spikes/out/evidence-parallel-20261016/"))
       (tar-path (merge-pathnames "raw.tar.gz" campaign))
       (manifest-path (merge-pathnames "manifest.lisp" campaign))
       (args (uiop:command-line-arguments))
       (records (loop for path in args for index from 0
                      collect (list :path (truename path) :label (format nil "run-~D" index))))
       (raw-names
         (loop for path in (uiop:subdirectories "spikes/out/")
               for name = (car (last (pathname-directory path)))
               when (or (uiop:string-prefix-p "evidence-check-" name)
                        (uiop:string-prefix-p "evidence-parallel-self-test-" name)
                        (uiop:string-prefix-p "evidence-propagation-probe-" name)
                        (uiop:string-prefix-p "evidence-cleanup-probe-" name)
                        (equal "parallel-evidence-tests-before-session-20261016" name))
                 collect name))
       (files nil))
  (dolist (record records)
    (let* ((path (getf record :path)) (data (arcdocdb.evidence:read-evidence path))
           (base (uiop:pathname-directory-pathname path)) (label (getf record :label)))
      (unless (and (member (getf data :status) '(:ok :failed :source-changed))
                   (getf data :finished-at-universal-time))
        (error "Record non concluso: ~A." path))
      (dolist (source (uiop:directory-files base))
        (push (list :source (namestring source)
                    :path (format nil "processes/~A/~A" label (file-namestring source))) files))))
  ;; TAR conserva anche i symlink e i file sparsi intenzionalmente invalidi delle
  ;; fixture; il contenitore gzip resta entro il budget fisico della pubblicazione.
  (when (or (probe-file tar-path) (probe-file manifest-path))
    (error "Output di pubblicazione già presente; nessuna sovrascrittura."))
  (uiop:run-program (append (list "tar" "-czf" (namestring tar-path) "-C" "spikes/out/") raw-names)
                    :output :string :error-output :string)
  (uiop:run-program (list "gzip" "-t" (namestring tar-path)) :output :string :error-output :string)
  (unless (<= (arcdocdb.evidence:file-bytes tar-path) (* 8 1024 1024))
    (error "Bundle raw oltre budget."))
  (push (list :source (namestring tar-path) :path "raw.tar.gz") files)
  (dolist (name '("compare.lisp" "publish.lisp" "results.lisp" "results-report.lisp"
                 "propagation-probe.lisp" "cleanup-probe.lisp" "final-checks.lisp"))
    (let ((path (merge-pathnames name campaign)))
      (when (probe-file path) (push (list :source (namestring path) :path (concatenate 'string "tools/" name)) files))))
  (save-new manifest-path
            (list :schema-version 1 :kind :command-archive-manifest :date "2026-10-16"
                  :files (nreverse files)
                  :processes (loop for record in records for label = (getf record :label)
                                   collect (list :label label
                                                 :record-path (format nil "processes/~A/report.lisp" label)))))
  (write (list :schema-version 1 :kind :parallel-evidence-publication-input :status :ok
               :manifest (namestring manifest-path) :records (length records)
               :raw-directories (length raw-names) :raw-bytes (arcdocdb.evidence:file-bytes tar-path)
               :raw-sha256 (arcdocdb.evidence:file-sha256 tar-path)))
  (terpri))
