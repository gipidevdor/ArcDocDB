;;;; Preparazione C4 di un manifest esplicito; il collector verifica tutte le copie.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((reports (uiop:command-line-arguments)) (files nil) (processes nil))
  (assert reports)
  (loop for report in reports for ordinal from 0 do
    (let* ((data (arcdocdb.evidence:read-evidence report))
           (prefix (format nil "processes/run-~D/" ordinal))
           (directory (uiop:pathname-directory-pathname (truename report))))
      (assert (eq :command-verification (getf data :kind)))
      (assert (member (getf data :status) '(:ok :failed :source-changed)))
      (assert (eq :stable (getf data :source-consistency)))
      (format t "~A: ~S, exit ~S, ~,3F s, ~S~%" report (getf data :status)
              (getf data :exit-code) (getf data :wall-seconds) (getf data :source-consistency))
      (dolist (line (uiop:split-string (or (getf data :stdout) "") :separator '(#\Newline)))
        (when (or (search "Cache v" line) (search "pubblicazione cache superati" line)
                  (search "nessun avviso" line))
          (write-line line)))
      (dolist (path (uiop:directory-files directory))
        (push (list :source (namestring path) :path (concatenate 'string prefix (file-namestring path))) files))
      (push (list :label (format nil "run-~D" ordinal)
                  :record-path (concatenate 'string prefix "report.lisp")) processes)))
  (dolist (source '("tests/cache/support.lisp" "tests/cache/guards.lisp" "tests/cache/threads.lisp"
                    "arcdocdb.asd" "spikes/out/cache-concurrency-20261017/prepare-archive.lisp"))
    (push (list :source (namestring (truename source))
                :path (if (uiop:string-prefix-p "spikes/out/" source)
                          "sources/prepare-archive.lisp" (concatenate 'string "sources/" source))) files))
  (with-open-file (stream "spikes/out/cache-concurrency-20261017/collection-manifest.lisp"
                          :direction :output :if-exists :error)
    (let ((*print-readably* t))
      (write (list :schema-version 1 :kind :command-archive-manifest :date "2026-10-17"
                   :files (nreverse files) :processes (nreverse processes))
             :stream stream :pretty t)
      (terpri stream))))
