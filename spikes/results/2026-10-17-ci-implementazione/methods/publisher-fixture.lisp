;;; Fixture locale: Git remoto privato, nessuna richiesta o scrittura GitHub.
(require :asdf)
(require :sb-posix)
(defpackage :arcdocdb.ci (:use :cl))
(in-package :arcdocdb.ci)
(defparameter *ci-root* (truename "./"))
(defparameter *ci-entry* (merge-pathnames "tools/ci.lisp" *ci-root*))
(defparameter *ci-sbcl* (namestring sb-ext:*runtime-pathname*))
(load "tools/evidence-storage.lisp")
(load "tests/ci-catalog.lisp")
(dolist (m '("data" "identity" "support" "tests" "coverage" "measure" "archive" "producer" "github" "publish"))
  (load (format nil "tools/ci/~A.lisp" m)))
(let* ((owner *ci-root*) (root (ci-mkdir "spikes/out/ci/publisher-fixture/"))
       (repository (ci-mkdir (merge-pathnames "repo/" root)))
       (remote (merge-pathnames "remote.git/" root)) (cases nil))
  (labels ((check (id thunk)
             (handler-case (push (list :id id :status (if (funcall thunk) :passed :failed)) cases)
               (error (c) (push (list :id id :status :failed :reason (princ-to-string c)) cases))))
           (rejects (thunk) (handler-case (progn (funcall thunk) nil) (error () t))))
    (ci-git (list "init" "--quiet" "--bare" (namestring remote)))
    (ci-git '("init" "--quiet" "-b" "main") repository)
    (ci-git '("config" "user.name" "CI fixture") repository)
    (ci-git '("config" "user.email" "ci-fixture@example.invalid") repository)
    (with-open-file (s (merge-pathnames "input.lisp" repository) :direction :output :if-exists :error)
      (write-line ";; fixture, not executed" s))
    (ci-git '("add" "input.lisp") repository)
    (ci-git '("commit" "--quiet" "-m" "fixture input") repository)
    (ci-git (list "remote" "add" "origin" (namestring remote)) repository)
    (ci-git '("push" "--quiet" "-u" "origin" "main") repository)
    (let* ((*ci-root* repository) (identity (ci-identity-summary (ci-source)))
           (server (list :run-id "101" :attempt "1" :event "push" :ref "refs/heads/main"
                         :head-sha (getf identity :tested-sha) :conclusion "success"
                         :repository "gpicchiarelli/ArcDocDB" :created-at "2026-10-17T00:00:00Z"))
           (partial (ci-mkdir (merge-pathnames "partial/" root)))
           (full (ci-mkdir (merge-pathnames "full/" root)))
           (collision (ci-mkdir (merge-pathnames "collision/" root))))
      (sb-posix:setenv "GITHUB_RUN_ID" "101" 1)
      (sb-posix:setenv "GITHUB_RUN_ATTEMPT" "1" 1)
      (sb-posix:setenv "GITHUB_EVENT_NAME" "push" 1)
      (sb-posix:setenv "GITHUB_REF" "refs/heads/main" 1)
      (sb-posix:setenv "GITHUB_REPOSITORY" "gpicchiarelli/ArcDocDB" 1)
      (labels ((payload (dir job &optional changed)
                 (let* ((out (ci-mkdir (merge-pathnames (format nil "~A/" job) dir)))
                        (work (ci-mkdir (merge-pathnames "work/" out)))
                        (metrics
                          (cond ((equal job "plan") '(:source-files 1))
                                ((member job '("verify-linux" "verify-macos") :test #'equal)
                                 (list :planned 1 :passed (if changed 0 1) :failed 0 :not-run 0 :skipped 0))
                                ((equal job "coverage")
                                 '(:totals (:status :measured :lines-covered 0 :lines-total 0)
                                   :expected-files ((:path "input.lisp")) :missing-files nil :excluded-tests nil))
                                ((equal job "audit")
                                 '(:checks ((:name "lint" :metrics (:kind :ci-check))
                                            (:name "trace" :metrics (:kind :ci-check))
                                            (:name "links" :metrics (:kind :ci-check)) (:name "c4"))))
                                (t '(:metrics ((:status :measured :operations 1))))))
                        (result (list :schema-version 1 :kind :ci-job-result :job job :status :passed
                                      :identity identity :context (ci-context) :metrics metrics :reason nil)))
                   (when (equal job "plan") (setf (getf result :expected-jobs) (ci-expected-jobs)))
                   (ci-pack-job out work job identity result)))
               (remote-index ()
                 (let ((parent (ci-git-fetch-main)))
                   (%ci-parse-wire (ci-git (list "show" (concatenate 'string parent ":spikes/results/ci/index.lisp")))))))
        (dolist (job '("plan" "verify-linux")) (payload partial job))
        (dolist (job (cons "plan" *ci-jobs*)) (payload full job))
        (payload collision "verify-linux" t)
        (check :publish-partial
          (lambda () (and (eq :published (nth-value 0 (ci-publish-data partial server identity)))
                         (not (getf (first (getf (remote-index) :runs)) :verification-passed)))))
        (check :dedup-identical
          (lambda () (eq :unchanged (nth-value 0 (ci-publish-data partial server identity)))))
        (check :recover-missing-jobs
          (lambda () (and (eq :published (nth-value 0 (ci-publish-data full server identity)))
                         (getf (first (getf (remote-index) :runs)) :verification-passed))))
        (check :old-subset-does-not-regress
          (lambda () (and (eq :unchanged (nth-value 0 (ci-publish-data partial server identity)))
                         (getf (first (getf (remote-index) :runs)) :verification-passed))))
        (check :same-job-different-bytes-rejected
          (lambda () (rejects (lambda () (ci-publish-data collision server identity)))))
        (check :wrong-source-id-rejected
          (lambda () (let ((bad (copy-list identity)))
                       (setf (getf bad :source-id) (make-string 64 :initial-element #\a))
                       (rejects (lambda () (ci-validate-provenance
                                            (list :identity bad :packets nil) server))))))
        (check :parent-is-not-run-anchor
          (lambda ()
            (let ((bad (copy-list server)))
              (setf (getf bad :head-sha) (make-string 40 :initial-element #\a)
                    (getf bad :event) "pull_request")
              (rejects (lambda () (ci-validate-provenance
                                   (list :identity identity :packets nil) bad))))))))
    (let* ((failed (count :failed cases :key (lambda (r) (getf r :status))))
           (report (list :schema-version 1 :kind :ci-publisher-fixture :status (if (zerop failed) :passed :failed)
                         :planned (length cases) :passed (- (length cases) failed) :failed failed
                         :cases (nreverse cases)
                         :limits '(:private-bare-git-remote :synthetic-run-metadata :not-a-github-publication))))
      (ci-save (merge-pathnames "report.lisp" root) report)
      (write-line (ci-wire-string report))
      (sb-ext:exit :code (if (zerop failed) 0 1)))))
