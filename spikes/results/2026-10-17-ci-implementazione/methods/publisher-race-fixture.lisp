;;; Conflitto deterministico su remoto bare privato; nessuna scrittura GitHub.
(require :asdf)
(require :sb-posix)
(defpackage :arcdocdb.ci (:use :cl))
(in-package :arcdocdb.ci)
(defparameter *ci-root* (truename "./"))
(defparameter *ci-entry* (merge-pathnames "tools/ci.lisp" *ci-root*))
(defparameter *ci-sbcl* (namestring sb-ext:*runtime-pathname*))
(load "tools/evidence-storage.lisp")
(load "tests/ci-catalog.lisp")
(dolist (m '("data" "identity" "support" "tests" "coverage" "measure" "archive" "producer" "github" "publish"))
  (load (format nil "tools/ci/~A.lisp" m)))
(let* ((root (ci-directory "spikes/out/ci/publisher-fixture/"))
       (*ci-root* (ci-directory "spikes/out/ci/publisher-fixture/repo/"))
       (identity (ci-identity-summary (ci-source)))
       (server (list :run-id "103" :attempt "1" :event "push" :ref "refs/heads/main"
                     :head-sha (getf identity :tested-sha) :conclusion "success"
                     :repository "gpicchiarelli/ArcDocDB" :created-at "2026-10-17T00:00:00Z"))
       (input (ci-mkdir (merge-pathnames "race-input/" root)))
       (competitor (merge-pathnames "competitor/" root))
       (old-git (symbol-function 'ci-git)) (injected nil) (state nil) (record nil))
  (sb-posix:setenv "GITHUB_RUN_ID" "103" 1)
  (sb-posix:setenv "GITHUB_RUN_ATTEMPT" "1" 1)
  (sb-posix:setenv "GITHUB_EVENT_NAME" "push" 1)
  (sb-posix:setenv "GITHUB_REF" "refs/heads/main" 1)
  (sb-posix:setenv "GITHUB_REPOSITORY" "gpicchiarelli/ArcDocDB" 1)
  (dolist (job '("plan" "verify-linux"))
    (let* ((out (ci-mkdir (merge-pathnames (format nil "~A/" job) input)))
           (work (ci-mkdir (merge-pathnames "work/" out)))
           (result (list :schema-version 1 :kind :ci-job-result :job job :status :passed
                         :identity identity :context (ci-context)
                         :metrics '(:planned 1 :passed 1 :failed 0 :not-run 0 :skipped 0) :reason nil)))
      (when (equal job "plan") (setf (getf result :expected-jobs) (ci-expected-jobs)))
      (ci-pack-job out work job identity result)))
  (ci-git (list "clone" "--quiet" "--no-hardlinks" "--branch" "main"
                (namestring (merge-pathnames "remote.git/" root)) (namestring competitor)))
  (ci-git '("config" "user.name" "CI competitor") competitor)
  (ci-git '("config" "user.email" "ci-competitor@example.invalid") competitor)
  (unwind-protect
       (progn
         (setf (symbol-function 'ci-git)
               (lambda (argv &optional (directory *ci-root*))
                 (when (and (not injected) (member "push" argv :test #'equal))
                   (setf injected t)
                   (with-open-file (s (merge-pathnames "concurrent-note.md" competitor)
                                      :direction :output :if-exists :error)
                     (write-line "preserve concurrent source" s))
                   (funcall old-git '("add" "concurrent-note.md") competitor)
                   (funcall old-git '("commit" "--quiet" "-m" "concurrent source advance") competitor)
                   (funcall old-git '("push" "--quiet" "origin" "HEAD:main") competitor))
                 (funcall old-git argv directory)))
         (multiple-value-setq (state record) (ci-publish-data input server identity)))
    (setf (symbol-function 'ci-git) old-git))
  (let* ((parent (ci-git-fetch-main))
         (note (ci-git (list "show" (concatenate 'string parent ":concurrent-note.md"))))
         (first-round (merge-pathnames "../round-1/push-failure.lisp" record))
         (passed (and injected (eq state :published) (equal (file-namestring (directory-namestring record)) "")
                      (search "round-2/" (namestring record)) (probe-file first-round)
                      (equal note (format nil "preserve concurrent source~%"))))
         (report (list :schema-version 1 :kind :ci-publisher-race-fixture
                       :status (if passed :passed :failed) :planned 1 :passed (if passed 1 0)
                       :failed (if passed 0 1) :conflict-injected injected
                       :normal-push-retry state :record (namestring record)
                       :concurrent-source-preserved (equal note (format nil "preserve concurrent source~%"))
                       :limits '(:private-bare-git-remote :synthetic-run-metadata :not-a-github-publication))))
    (ci-save (merge-pathnames "race-report.lisp" root) report)
    (ci-git (list "bundle" "create" (namestring (merge-pathnames "fixture.bundle" root)) "--all"))
    (write-line (ci-wire-string report))
    (sb-ext:exit :code (if passed 0 1))))
