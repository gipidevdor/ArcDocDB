(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.index.page.tests)
(defun misura-hit-cache ()
  (multiple-value-bind (raw start end id) (raw-page 4096 :chiave #(1) 1 0)
    (let* ((target (bytes 4096))
           (cache (p:crea-cache-pagine 4096 1
                    (lambda (identity frame) (declare (ignore identity))
                      (replace frame raw :start2 start :end2 end) 4096))))
      (p:copia-pagina-cache cache id target)
      (dotimes (i 1000) (p:copia-pagina-cache cache id target))
      (let ((before (sb-ext:get-bytes-consed)) (hits 0))
        (dotimes (i 10000)
          (when (eq :hit (nth-value 1 (p:copia-pagina-cache cache id target))) (incf hits)))
        (let ((allocated (- (sb-ext:get-bytes-consed) before)))
          (format t "~&CACHE-HIT hits=~D bytes-consed=~D~%" hits allocated)
          (assert (= hits 10000)) (assert (zerop allocated)))))))
(misura-hit-cache)
