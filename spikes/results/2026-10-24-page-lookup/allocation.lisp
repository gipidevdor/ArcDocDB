(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.index.page.tests)
(defun misura-lookup (label reader key words count)
  (dotimes (i 100) (lookup-candidate reader key words))
  (let ((before (sb-ext:get-bytes-consed)) (found 0))
    (dotimes (i count) (when (eq :live (lookup-candidate reader key words)) (incf found)))
    (let ((allocated (- (sb-ext:get-bytes-consed) before)))
      (format t "~&LOOKUP ~A calls=~D found=~D bytes-consed=~D~%" label count found allocated)
      (assert (= found count)) (assert (zerop allocated)))))
(let* ((size 4096) (key (lookup-key 1))
       (page (lookup-page size :bucket (bucket-body size (list key) :collision t) 1 32 (* size 10)))
       (root (lookup-directory size (* size 20) 0 (* size 10) 63)) (words (lookup-words)))
  (misura-lookup :inline-hit (lookup-reader size (* size 10) (list page)) key words 10000)
  (misura-lookup :directory-miss-un-frame (lookup-reader size (* size 20) (list page root)) key words 1000))
(let* ((size 4096) (key (bytes 65535 127)) (chunk (- size 96)) (parts (ceiling 65535 chunk)) (pages nil))
  (dotimes (i parts)
    (let* ((start (* i chunk)) (end (min 65535 (+ start chunk))) (page (* size (- 100 i))))
      (push (lookup-page size :chiave (subseq key start end) 65535 start page
                         :next (if (= end 65535) 0 (- page size))) pages)))
  (push (lookup-page size :bucket (bucket-body size (list key) :collision t :external t) 1 32 (* size 200)) pages)
  (misura-lookup :chiave-65535-un-frame (lookup-reader size (* size 200) pages) key (lookup-words) 100))
