;;;; Finestra C4 della vista verificata; fuori da SB-COVER, nessuna misura RSS o throughput.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.index.page.tests)
(defun misura-vista-verificata ()
  (arcdocdb.io.tests::with-directory (directory)
    (let* ((key (lookup-key 1)) (keys (list key)) (source (image-source 1)) (words (lookup-words)))
      (write-image-fixture directory 4096 keys :source source)
      (with-image-input (input eof directory)
        (let* ((image (p:recupera-immagine-pagine input eof 4096 source 0 0 (image-validator keys)))
               (view (p:crea-vista-indice-paginato source)))
          (p:pubblica-immagine-verificata view image)
          (dotimes (i 1000) (p:leggi-vista-indice-paginato view key 0 1 words))
          (let ((before (sb-ext:get-bytes-consed)) (found 0))
            (dotimes (i 10000)
              (when (eq :live (p:leggi-vista-indice-paginato view key 0 1 words)) (incf found)))
            (let ((allocated (- (sb-ext:get-bytes-consed) before)))
              (format t "~&VERIFIED-VIEW calls=10000 found=~D bytes-consed=~D~%" found allocated)
              (assert (= found 10000)) (assert (zerop allocated)))))))))
(misura-vista-verificata)
