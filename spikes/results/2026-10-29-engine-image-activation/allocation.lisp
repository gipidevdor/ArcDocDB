;;;; C4: finestre GET e ritiro normali, fuori da SB-COVER; nessuna misura RSS/latency.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(defun misura-get-attivato (engine label)
  (let ((key (key 1)) (target (bytes 64)))
    (dotimes (i 1000) (e:leggi-documento engine key target))
    (let ((before (sb-ext:get-bytes-consed)) (found 0))
      (dotimes (i 10000)
        (multiple-value-bind (status size) (e:leggi-documento engine key target)
          (when (and (eq status :found) (= size 23)) (incf found))))
      (let ((allocated (- (sb-ext:get-bytes-consed) before)))
        (format t "~&ACTIVE-GET ~A calls=10000 found=~D bytes-consed=~D~%" label found allocated)
        (assert (= found 10000)) (assert (zerop allocated))))))
(defun misura-ritiro-attivo (engine)
  (setf (e::motore-busy engine) t)
  (unwind-protect
       (let ((before (sb-ext:get-bytes-consed)))
         (e::ritira-indice-paginato-motore engine)
         (let ((allocated (- (sb-ext:get-bytes-consed) before)))
           (format t "~&ACTIVE-RETIRE calls=1 bytes-consed=~D~%" allocated)
           (assert (zerop allocated))))
    (setf (e::motore-busy engine) nil)))
(with-root (root)
  (with-engine (engine (open-build-engine root :create t))
    (let ((first (build-option 1 :frames 1)) (second (build-option 2 :frames 1)))
      (initial-workload engine)
      (e:costruisci-indice-paginato-motore engine first)
      (e:costruisci-indice-paginato-motore engine second)
      (e:attiva-indice-paginato-motore engine first)
      (misura-get-attivato engine :first)
      (dotimes (i 16) (e:attiva-indice-paginato-motore engine second))
      (misura-get-attivato engine :replaced)
      (misura-ritiro-attivo engine)
      (misura-get-attivato engine :resident-after-retire)
      (e:attiva-indice-paginato-motore engine first)
      (e:scrivi-documento engine (key 1) (value 9))
      (misura-get-attivato engine :resident-after-write))))
