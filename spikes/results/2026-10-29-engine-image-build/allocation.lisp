;;;; C4: GET completi su immagini prodotte dal motore; preparazione fuori misura.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(defun misura-get-costruzione (engine label)
  (let ((key (key 1)) (target (bytes 64)))
    (dotimes (i 1000) (e:leggi-documento engine key target))
    (let ((before (sb-ext:get-bytes-consed)) (found 0))
      (dotimes (i 10000)
        (multiple-value-bind (status size) (e:leggi-documento engine key target)
          (when (and (eq status :found) (= size 23)) (incf found))))
      (let ((allocated (- (sb-ext:get-bytes-consed) before)))
        (format t "~&ENGINE-BUILD-GET ~A calls=10000 found=~D bytes-consed=~D~%" label found allocated)
        (assert (= found 10000)) (assert (zerop allocated))))))
(with-root (root)
  (let ((option (build-option 1)))
    (with-engine (engine (open-build-engine root :create t))
      (initial-workload engine)
      (e:costruisci-indice-paginato-motore engine option)
      (misura-get-costruzione engine :resident-after-build))
    (with-engine (engine (open-build-engine root :option option))
      (misura-get-costruzione engine :paged-after-restart))))
