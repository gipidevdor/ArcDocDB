;;;; C4: finestre seriali isolate, nessuna misura di RSS, latenza o throughput.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(defun delta-measure-get (engine id expected)
  (let ((key (key id)) (target (bytes 64)))
    (dotimes (i 1000) (e:leggi-documento engine key target))
    (let ((before (sb-ext:get-bytes-consed)) (matched 0))
      (dotimes (i 10000)
        (multiple-value-bind (status size) (e:leggi-documento engine key target)
          (when (if expected (and (eq status :found) (= size 23))
                    (and (eq status :absent) (zerop size))) (incf matched))))
      (let ((allocated (- (sb-ext:get-bytes-consed) before)))
        (format t "~&DELTA-GET id=~D found=~S calls=10000 matched=~D bytes-consed=~D~%"
                id expected matched allocated)
        (assert (= matched 10000)) (assert (zerop allocated))))))
(defun delta-measure-membership (engine)
  (let ((key (key 8)))
    (setf (e::motore-busy engine) t)
    (unwind-protect
         (let ((before (sb-ext:get-bytes-consed)))
           (e::registra-chiave-delta-motore engine key t)
           (dotimes (i 10000) (e::registra-chiave-delta-motore engine key t))
           (let ((allocated (- (sb-ext:get-bytes-consed) before)))
             (format t "~&DELTA-MEMBERSHIP new=1 existing=10000 bytes-consed=~D~%" allocated)
             (assert (zerop allocated))))
      (setf (e::motore-busy engine) nil))))
(with-root (root)
  (with-engine (engine (open-build-engine root :create t))
    (let ((option (build-option 1)))
      (initial-workload engine) (e:costruisci-indice-paginato-motore engine option)
      (activate-delta engine option)
      (e:scrivi-documento engine (key 1) (value 9))
      (e:cancella-documento engine (key 3))
      (delta-measure-get engine 1 t)
      (delta-measure-get engine 3 nil)
      ;; Chiave originariamente assente: attraversa il reader paginato.
      (delta-measure-get engine 99 nil)
      ;; Nuova immagine con una chiave intatta viva.
      (e:scrivi-documento engine (key 4) (value 4))
      (let ((next (build-option 2)))
        (e:costruisci-indice-paginato-motore engine next) (activate-delta engine next)
        (delta-measure-get engine 4 t)
        (delta-measure-membership engine)))))
