;;;; C4: GET corrente completo M1, dopo warmup; nessuna misura RSS/throughput.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(defun misura-get-immagine (engine label)
  (let ((key (key 1)) (target (bytes 64)))
    (dotimes (i 1000) (e:leggi-documento engine key target))
    (let ((before (sb-ext:get-bytes-consed)) (found 0))
      (dotimes (i 10000)
        (multiple-value-bind (status size) (e:leggi-documento engine key target)
          (when (and (eq status :found) (= size 23)) (incf found))))
      (let ((allocated (- (sb-ext:get-bytes-consed) before)))
        (format t "~&ENGINE-GET ~A calls=10000 found=~D bytes-consed=~D~%" label found allocated)
        (assert (= found 10000)) (assert (zerop allocated))))))
(with-root (root)
  (with-engine (engine (open-engine root :create t))
    (initial-workload engine) (write-engine-image root engine '(1 3)))
  (with-engine (engine (open-engine root :index-image (image-option)))
    (misura-get-immagine engine :paged)
    (e:scrivi-documento engine (key 1) (value 2))
    (misura-get-immagine engine :resident-after-write)))
