;;;; C4: decisioni/no-op e GET normali, nessuna misura del rinnovo o RSS.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(with-root (root)
  (with-engine (engine (open-build-engine root :create t))
    (let ((policy (e:crea-politica-rinnovo-indice)) (next (build-option 2)))
      (initial-workload engine) (renew-image engine (build-option 1) :keys 4 :bytes 128)
      (dotimes (i 1000) (e:rinnovo-indice-richiesto-p engine policy))
      (let ((before (sb-ext:get-bytes-consed)) (kept 0))
        (dotimes (i 10000) (unless (e:rinnovo-indice-richiesto-p engine policy) (incf kept)))
        (let ((allocated (- (sb-ext:get-bytes-consed) before)))
          (format t "~&MAINTENANCE-PROBE calls=10000 kept=~D bytes-consed=~D~%" kept allocated)
          (assert (= kept 10000)) (assert (zerop allocated))))
      (dotimes (i 1000) (e:mantieni-indice-paginato-motore engine policy next))
      (let ((before (sb-ext:get-bytes-consed)) (kept 0))
        (dotimes (i 10000)
          (when (eq :mantieni (e:mantieni-indice-paginato-motore engine policy next)) (incf kept)))
        (let ((allocated (- (sb-ext:get-bytes-consed) before)))
          (format t "~&MAINTENANCE-NOOP calls=10000 kept=~D bytes-consed=~D~%" kept allocated)
          (assert (= kept 10000)) (assert (zerop allocated))))
      (assert (not (probe-file (build-path root next))))
      (dolist (id '(1 3 7)) (e:cancella-documento engine (key id)))
      (assert (eq :rinnovato (e:mantieni-indice-paginato-motore engine policy next)))
      (check-get engine 1 nil) (check-get engine 3 nil)
      (let ((key (key 1)) (target (bytes 64)))
        (dotimes (i 1000) (e:leggi-documento engine key target))
        (let ((before (sb-ext:get-bytes-consed)) (absent 0))
          (dotimes (i 10000)
            (multiple-value-bind (status size) (e:leggi-documento engine key target)
              (when (and (eq status :absent) (zerop size)) (incf absent))))
          (let ((allocated (- (sb-ext:get-bytes-consed) before)))
            (format t "~&MAINTENANCE-GET calls=10000 absent=~D bytes-consed=~D~%" absent allocated)
            (assert (= absent 10000)) (assert (zerop allocated))))))))
