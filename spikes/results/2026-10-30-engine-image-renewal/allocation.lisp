;;;; C4: GET normali dopo il rinnovo, fuori da SB-COVER; nessuna misura RSS o throughput.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(defun renewal-measure-get (engine id expected label)
  (check-get engine id expected)
  (let ((key (key id)) (target (bytes 64)))
    (dotimes (i 1000) (e:leggi-documento engine key target))
    (let ((before (sb-ext:get-bytes-consed)) (matched 0))
      (dotimes (i 10000)
        (multiple-value-bind (status size) (e:leggi-documento engine key target)
          (when (if expected (and (eq status :found) (= size 23))
                    (and (eq status :absent) (zerop size))) (incf matched))))
      (let ((allocated (- (sb-ext:get-bytes-consed) before)))
        (format t "~&RENEWAL-GET ~S calls=10000 matched=~D bytes-consed=~D~%" label matched allocated)
        (assert (= matched 10000)) (assert (zerop allocated)))))
  (check-get engine id expected))
(with-root (root)
  (with-engine (engine (open-build-engine root :create t))
    (initial-workload engine)
    (renew-image engine (build-option 1) :keys 2 :bytes 32)
    (renewal-measure-get engine 1 (value 3) :first-image)
    (e:scrivi-documento engine (key 1) (value 9)) (e:cancella-documento engine (key 3))
    (renewal-measure-get engine 1 (value 9) :full-delta-live)
    (renewal-measure-get engine 3 nil :full-delta-absent)
    (renew-image engine (build-option 2) :keys 2 :bytes 32)
    (renewal-measure-get engine 1 (value 9) :renewed-live)
    (renewal-measure-get engine 3 nil :renewed-absent)))
