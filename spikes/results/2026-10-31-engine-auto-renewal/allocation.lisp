;;;; C4: serial no-renewal preflight allocation, not GET throughput or maintenance latency.
(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)

(defun automatic-preflight-cycle (engine key count)
  (declare (type fixnum count))
  (dotimes (i count)
    (unless (null (e::preflight-rinnovo-scrittura engine key)) (error "Unexpected renewal proposal.")))
  count)

(sb-ext:with-timeout 120
  (dolist (version '(1 2))
    (with-root (root)
      (with-engine (engine (open-build-engine root :create t :version version))
        (renew-image engine (build-option 1) :keys 4 :bytes 128)
        (e:scrivi-documento engine (key 1) (value 1))
        (install-auto engine 2 :policy (e:crea-politica-rinnovo-indice :soglia-percentuale 100))
        (let ((known (key 1)) (new (key 3)) (images (images root)) (delta (e::motore-delta engine)))
          (dolist (case '(:tracked :untracked))
            (let ((input (if (eq case :tracked) known new)))
              (dotimes (window 5)
                (automatic-preflight-cycle engine input 1000)
                (sb-ext:gc :full t)
                (sb-ext:get-bytes-consed)
                (let* ((before (sb-ext:get-bytes-consed))
                       (calls (automatic-preflight-cycle engine input 100000))
                       (allocated (- (sb-ext:get-bytes-consed) before)))
                  (format t "~&~S~%" (list :kind :automatic-preflight-allocation :format version
                                           :case case :window window :calls calls :bytes-consed allocated))
                  (assert (= 100000 calls)) (assert (zerop allocated))))))
          (is (eq delta (e::motore-delta engine)))
          (is (= 1 (e::delta-indice-motore-count delta)))
          (is (zerop (e::motore-auto-renewals-used engine)))
          (check-frontier engine 1) (check-images root images)
          (is (= (length images) (length (images root)))))))))
(format t "~&~S~%" '(:kind :automatic-preflight-allocation :status :passed :windows 20
                      :calls-per-window 100000 :measured-preflights 2000000 :rss-qualified nil :benchmark nil))
