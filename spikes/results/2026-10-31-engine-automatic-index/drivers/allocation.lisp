(require :asdf)
(require :sb-posix)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (c) (unless (typep c 'sb-kernel:redefinition-warning) (error c)))))
  (asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/tests"))
(declaim (optimize (safety 3) (speed 3) (debug 1)))
(defun measured-index-lookups (engine key output count)
  (declare (type arcdocdb.engine:motore engine) (type arcdocdb.binary:octets key)
           (type (simple-array (unsigned-byte 64) (5)) output) (type fixnum count))
  (dotimes (i count)
    (unless (and (eq :live (arcdocdb.engine::probe-automatic-index engine key 0 (length key)
                            (arcdocdb.engine::motore-index-context engine) output))
                 (= 180 (aref output 0))) (error "Lookup oracle."))))
(arcdocdb.engine.tests::with-root (root)
  (let* ((engine (arcdocdb.engine:apri-motore root (arcdocdb.engine.tests::archive-id) (arcdocdb.engine.tests::series-id)
                   :create t :clock (lambda () 10) :index-capacity 16 :key-arena-bytes 128
                   :max-file-bytes 4194304 :max-record-bytes 131072 :max-records 2048 :max-segments 64
                   :index-policy (arcdocdb.engine:crea-politica-indice-automatico :budget 8388608 :frames 64)))
         (key (arcdocdb.engine.tests::automatic-key 179))
         (output (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0)))
    (unwind-protect
         (progn
           (arcdocdb.engine.tests::automatic-write engine 180)
           (dolist (mode '(:resident :paged))
             (when (eq mode :paged)
               ;; Explicit benchmark geometry: 64 frames; production default is 16.
               (arcdocdb.engine.tests::automatic-page engine))
             (setf (arcdocdb.engine::motore-busy engine) t)
             (let ((read-count 0) (original (symbol-function 'arcdocdb.io:leggi-esatto)))
               (measured-index-lookups engine key output 1000)
               (setf (symbol-function 'arcdocdb.io:leggi-esatto)
                     (lambda (file bytes start end offset) (incf read-count) (funcall original file bytes start end offset)))
               (unwind-protect (progn
               (dotimes (window 5)
                 (sb-ext:gc :full t)
                 (let* ((before (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
                   (measured-index-lookups engine key output 100000)
                   (let ((elapsed (- (get-internal-real-time) start)) (consed (- (sb-ext:get-bytes-consed) before)))
                     (format t "~&ALLOCATION ~S~%" (list :mode mode :window window :operations 100000 :bytes-consed consed
                                       :elapsed-ticks elapsed :ticks-per-second internal-time-units-per-second))
                     (assert (zerop consed)))))
               (assert (zerop read-count)))
                 (setf (symbol-function 'arcdocdb.io:leggi-esatto) original)))
             (setf (arcdocdb.engine::motore-busy engine) nil)))
      (setf (arcdocdb.engine::motore-busy engine) nil) (arcdocdb.engine:chiudi-motore engine))))
