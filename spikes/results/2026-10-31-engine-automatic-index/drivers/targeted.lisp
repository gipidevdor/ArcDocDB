(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (condition)
                          (unless (typep condition 'sb-kernel:redefinition-warning)
                            (error "Strict compilation: ~A" condition)))))
  (asdf:load-asd (truename "arcdocdb.asd"))
  (asdf:load-system "arcdocdb/tests")
  (let ((count 0))
    (dolist (test (reverse (symbol-value (find-symbol "*TESTS*" "ARCDOCDB.ENGINE.TESTS"))))
      (when (search "REQ-IDX-013" (symbol-name test))
        (funcall test) (incf count) (format t "~&PASS ~A~%" test) (finish-output)))
    (format t "~&~S~%" (list :kind :m1-automatic-completion :status :passed :tests count :benchmark nil))))
