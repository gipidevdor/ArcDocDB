(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb")
(defpackage #:compaction.bench (:use #:cl) (:local-nicknames (#:e #:arcdocdb.engine)))
(in-package #:compaction.bench)
(declaim (optimize (safety 3) (speed 2) (debug 1)))
(defun ensure (value) (unless value (error "Compaction benchmark oracle failed")) value)
(defun octets (n &optional (value 0)) (make-array n :element-type '(unsigned-byte 8) :initial-element value))
(defun make-key (n) (let ((key (octets 16 17))) (arcdocdb.binary:scrivi-u32 key 12 n) key))
(defun fresh-root ()
  (loop for serial below 1000
        for root = (merge-pathnames (format nil "arcdocdb-compaction-bench-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
                                    (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition) (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Fixture namespace exhausted"))
(defun checked-get (engine keys target id writes)
  (multiple-value-bind (status size) (e:leggi-documento engine (aref keys id) target)
    (ensure (and (eq status :found) (= size (length target))
                 (= (aref target 0) (mod (+ (- writes (length keys)) id) 251))
                 (= (aref target 0) (aref target (1- size)))))
    (aref target 0)))
(defun percentile (sorted percent)
  (aref sorted (max 0 (1- (ceiling (* (length sorted) percent) 100)))))
(defun reads (engine keys bytes writes phase samples repetitions)
  (let ((target (octets bytes)))
    (dotimes (n (length keys)) (checked-get engine keys target n writes))
    (sb-ext:gc :full t)
    (format t "~&~S~%" (list :kind :retained-driver-heap :phase phase :bytes (sb-kernel:dynamic-usage)))
    (dotimes (repetition repetitions)
      (let* ((latencies (make-array samples :element-type '(unsigned-byte 64)))
             (allocation (sb-ext:get-bytes-consed)) (start (get-internal-real-time)) (sink 0))
        (dotimes (n samples)
          (let ((tick (get-internal-real-time)))
            (incf sink (checked-get engine keys target (mod (* n 73) (length keys)) writes))
            (setf (aref latencies n) (- (get-internal-real-time) tick))))
        (let* ((ticks (- (get-internal-real-time) start)) (allocated (- (sb-ext:get-bytes-consed) allocation))
               (sorted (sort (copy-seq latencies) #'<)) (seconds (/ ticks (float internal-time-units-per-second 1d0))))
          (format t "~&~S~%" (list :kind :engine-get-sample :phase phase :repetition repetition :operations samples
             :wall-seconds seconds :ops-per-second (/ samples seconds) :allocated-bytes allocated :sink sink
             :p50-us (/ (* 1000000d0 (percentile sorted 50)) internal-time-units-per-second)
             :p99-us (/ (* 1000000d0 (percentile sorted 99)) internal-time-units-per-second)
             :max-us (/ (* 1000000d0 (aref sorted (1- samples))) internal-time-units-per-second)
             :latency-ticks latencies)))))) nil)
(defun measured-compaction (engine)
  (let ((read-original (symbol-function 'arcdocdb.io:leggi-esatto))
        (append-original (symbol-function 'arcdocdb.io:append-esatto))
        (flush-original (symbol-function 'arcdocdb.io:durable-flush))
        (reads 0) (read-bytes 0) (appends 0) (append-bytes 0) (flushes 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'arcdocdb.io:leggi-esatto)
                 (lambda (file buffer start end offset) (incf reads) (incf read-bytes (- end start))
                   (funcall read-original file buffer start end offset))
                 (symbol-function 'arcdocdb.io:append-esatto)
                 (lambda (file buffer start end) (incf appends) (incf append-bytes (- end start))
                   (funcall append-original file buffer start end))
                 (symbol-function 'arcdocdb.io:durable-flush)
                 (lambda (file) (incf flushes) (funcall flush-original file)))
           (let* ((allocation (sb-ext:get-bytes-consed)) (start (get-internal-real-time))
                  (result (e:compatta-motore engine :force t)) (ticks (- (get-internal-real-time) start)))
             (ensure (eq :compacted (getf result :status)))
             (format t "~&~S~%" (list :kind :engine-compaction-sample :result result
                     :wall-seconds (/ ticks (float internal-time-units-per-second 1d0))
                     :allocated-bytes (- (sb-ext:get-bytes-consed) allocation)
                     :read-calls reads :read-bytes read-bytes :append-calls appends :append-bytes append-bytes :flush-calls flushes))))
      (setf (symbol-function 'arcdocdb.io:leggi-esatto) read-original
            (symbol-function 'arcdocdb.io:append-esatto) append-original
            (symbol-function 'arcdocdb.io:durable-flush) flush-original))) nil)
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (self-test (equal args '("--self-test")))
         (mode (if self-test :resident (intern (string-upcase (or (first args) "resident")) :keyword)))
         (version (if self-test 2 (parse-integer (or (second args) "2"))))
         (writes (if self-test 64 4096)) (key-count (if self-test 8 128)) (bytes (if self-test 128 4096))
         (samples (if self-test 32 2048)) (repetitions (if self-test 1 5))
         (keys (map 'simple-vector #'make-key (loop for n below key-count collect n)))
         (value (octets bytes)) (root (fresh-root)) (engine nil) (success nil))
    (ensure (member mode '(:resident :paged))) (ensure (member version '(1 2)))
    (format t "~&~S~%" (list :kind :engine-compaction-benchmark :self-test self-test :sbcl (lisp-implementation-version)
       :machine (machine-type) :mode mode :version version :writes writes :keys key-count :document-bytes bytes
       :samples samples :repetitions repetitions :clock-units internal-time-units-per-second
       :driver-git-blob (string-trim '(#\Newline #\Space) (uiop:run-program (list "git" "hash-object" (namestring *load-truename*)) :output :string))))
    (unwind-protect
         (progn
           (setf engine (e:apri-motore root (octets 16 73) (octets 16 41) :create t :version version :clock #'get-internal-real-time
                         :max-file-bytes 67108864 :max-record-bytes 8192 :max-records 8192 :max-segments 16
                         :index-capacity 256 :key-arena-bytes 65536
                         :index-policy (e:crea-politica-indice-automatico :budget 8388608 :frames 1)))
           (when (eq mode :paged) (e:configura-budget-indice-motore engine (getf (e:statistiche-indice-motore engine) :reserved-fixed)))
           (dotimes (n writes) (fill value (mod n 251)) (ensure (= (1+ n) (e:scrivi-documento engine (aref keys (mod n key-count)) value))))
           (ensure (eq mode (e:modo-indice-motore engine)))
           (reads engine keys bytes writes :before samples repetitions)
           (sb-ext:gc :full t) (measured-compaction engine)
           (ensure (equal (list 0 writes 0 writes) (multiple-value-list (e:frontiere-motore engine))))
           (ensure (eq mode (e:modo-indice-motore engine)))
           (reads engine keys bytes writes :after samples repetitions)
           (e:chiudi-motore engine) (setf engine nil)
           (setf engine (e:apri-motore root (octets 16 73) (octets 16 41) :version version :clock #'get-internal-real-time
                         :max-file-bytes 67108864 :max-record-bytes 8192 :max-records 8192 :max-segments 16
                         :index-capacity 256 :key-arena-bytes 65536 :index-policy (e:crea-politica-indice-automatico :budget 8388608 :frames 1)))
           (ensure (equal (list 0 writes 0 writes) (multiple-value-list (e:frontiere-motore engine))))
           (let ((target (octets bytes))) (dotimes (n key-count) (checked-get engine keys target n writes)))
           (setf success t) (format t "~&~S~%" '(:kind :engine-compaction-benchmark :status :passed :reopen-oracle :passed)))
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t) (format *error-output* "~&RETAINED ~A~%" root)))))
(main)
