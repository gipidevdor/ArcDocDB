(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(dolist (version '(1 2))
  (dolist (mode '(:legacy :resident :paged))
    (with-root (root)
      (with-engine (engine (rotation-open root :create t :version version :mode mode :records 16))
        (rotation-force-paged engine mode)
        (dotimes (n 24) (is (= (1+ n) (e:scrivi-documento engine (key (mod n 3)) (value n)))))
        (is (= 25 (e:cancella-documento engine (key 1))))
        (let ((registry (e::motore-registry engine)))
          (format t "~&RESULT ~D ~A ~S~%" version mode (e:compatta-motore engine :force t))
          (is (eq registry (e::motore-registry engine)))
          (is (null (e::motore-busy engine)))
          (check-get engine 0 (value 21)) (check-get engine 1 nil) (check-get engine 2 (value 23))
          (check-frontier engine 25)))
      (with-engine (engine (rotation-open root :version version :mode mode :records 16))
        (check-get engine 0 (value 21)) (check-get engine 1 nil) (check-get engine 2 (value 23))
        (check-frontier engine 25) (is (= 26 (e:scrivi-documento engine (key 1) (value 26))))))))
(format t "~&~S~%" '(:status :passed :tests 6 :scope :compaction-smoke))
