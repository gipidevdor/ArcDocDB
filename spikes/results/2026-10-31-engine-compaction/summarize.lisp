(require :asdf)
(load "tools/evidence-storage.lisp")
(defun bench-forms (record)
  (let ((text (getf (arcdocdb.evidence:read-evidence record) :stdout)) (position 0) (forms nil))
    (loop for start = (search "(:KIND " text :start2 position) while start do
      (let ((*read-eval* nil))
        (multiple-value-bind (form end) (read-from-string text nil :eof :start start)
          (unless (and (listp form) (> end start)) (error "Malformed benchmark output"))
          (push form forms) (setf position end))))
    (nreverse forms)))
(defun median (values)
  (let ((ordered (sort (copy-seq values) #'<))) (elt ordered (floor (length ordered) 2))))
(defun summarize (path)
  (let* ((forms (bench-forms path))
         (metadata (find :engine-compaction-benchmark forms :key (lambda (x) (getf x :kind))))
         (compact (find :engine-compaction-sample forms :key (lambda (x) (getf x :kind))))
         (passed (find-if (lambda (x) (eq :passed (getf x :status))) forms)))
    (unless (and metadata compact passed (not (getf metadata :self-test))) (error "Incomplete benchmark ~A" path))
    (list :record path :sbcl (getf metadata :sbcl) :mode (getf metadata :mode) :version (getf metadata :version)
          :compaction compact
          :gets (loop for phase in '(:before :after)
                      for samples = (remove-if-not (lambda (x) (and (eq :engine-get-sample (getf x :kind))
                                                                     (eq phase (getf x :phase)))) forms)
                      collect (progn
                                (unless (= 5 (length samples)) (error "Missing samples ~A" path))
                                (list :phase phase
                                      :median-ops-per-second (median (mapcar (lambda (x) (getf x :ops-per-second)) samples))
                                      :median-p50-us (median (mapcar (lambda (x) (getf x :p50-us)) samples))
                                      :median-p99-us (median (mapcar (lambda (x) (getf x :p99-us)) samples))
                                      :worst-max-us (reduce #'max samples :key (lambda (x) (getf x :max-us)))
                                      :allocated-bytes (reduce #'+ samples :key (lambda (x) (getf x :allocated-bytes)))))))))
(let ((*print-readably* t))
  (write (list :kind :compaction-benchmark-summary :status :passed
               :results (mapcar #'summarize (uiop:command-line-arguments))) :pretty t)
  (terpri))
