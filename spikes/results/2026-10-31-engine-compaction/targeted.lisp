(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(let ((count 0))
  (dolist (test (reverse arcdocdb.engine.tests::*tests*))
    (when (search "TEST-REQ-CMP-001-PRODUCTION-" (symbol-name test))
      (funcall test) (incf count) (format t "~&PASS ~A~%" test)))
  (assert (= count 12))
  (format t "~&~S~%" (list :status :passed :tests count :scope :engine-compaction)))
