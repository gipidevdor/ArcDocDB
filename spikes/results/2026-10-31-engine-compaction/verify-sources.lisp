(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((paths (uiop:command-line-arguments)) (baseline nil) (checks nil))
  (dolist (path paths)
    (let* ((record (arcdocdb.evidence:read-evidence path))
           (before (getf record :source-blobs-before)) (after (getf record :source-blobs-after)))
      (unless (and (eq :ok (getf record :status)) before (equal before after))
        (error "Qualification failed or sources changed: ~A" path))
      (if baseline (unless (equal baseline before) (error "Different qualified source inventory: ~A" path))
          (setf baseline before))
      (push (list :record path :status :passed :source-files (length before)) checks)))
  (let* ((names (mapcar (lambda (entry) (getf entry :path)) baseline))
         (hashes (uiop:split-string (uiop:run-program (append '("git" "hash-object" "--") names) :output :string)
                                   :separator '(#\Newline))))
    (loop for entry in baseline for actual in hashes do
      (unless (string= actual (getf entry :git-blob)) (error "Current source differs: ~A" (getf entry :path)))))
  (let ((*print-readably* t))
    (write (list :kind :compaction-qualified-source-identity :status :passed :current-sources-match t
                 :checks (nreverse checks)) :pretty t) (terpri)))
