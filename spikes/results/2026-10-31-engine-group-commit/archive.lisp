;;;; C4: explicit completed command roots, byte-identical copy with a closed manifest.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Group archive byte oracle failed")) truth)
(defun same-bytes (left right)
  (ensure (and (= (arcdocdb.evidence:file-bytes left) (arcdocdb.evidence:file-bytes right))
               (string= (arcdocdb.evidence:file-sha256 left) (arcdocdb.evidence:file-sha256 right)))))
(defun copy-one (source target)
  (ensure (probe-file source))
  (unless (probe-file target) (ensure-directories-exist target) (uiop:copy-file source target))
  (same-bytes source target)
  (list :source (namestring source) :target (namestring target)
        :bytes (arcdocdb.evidence:file-bytes target) :sha256 (arcdocdb.evidence:file-sha256 target)))
(let ((args (uiop:command-line-arguments)) (*read-eval* nil))
  (if (equal args '("--self-test"))
      (let ((source (uiop:with-temporary-file (:pathname path :stream stream :keep t)
                      (write-string "Original raw diagnostic, including trailing spaces.  " stream) path))
            (target nil))
        (unwind-protect
             (progn
               (setf target (pathname (concatenate 'string (namestring source) ".copy")))
               (copy-one source target)
               (with-open-file (stream target :direction :output :if-exists :supersede) (write-string "altered" stream))
               (ensure (handler-case (progn (same-bytes source target) nil) (error () t)))
               (format t "~S~%" '(:kind :group-archive-self-test :status :passed :altered-copy :detected)))
          (when (probe-file source) (delete-file source)) (when (and target (probe-file target)) (delete-file target))))
      (progn
        (ensure (= 2 (length args)))
        (let* ((root (uiop:pathname-directory-pathname *load-truename*))
               (entries (with-open-file (stream (first args)) (read stream))) (copies nil))
          (dolist (entry entries)
            (let* ((source (pathname (first entry))) (target (merge-pathnames (second entry) root))
                   (record (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "report.lisp" source)
                             (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
              (ensure (not (member (getf record :status) '(:running :pending))))
              (dolist (file (uiop:directory-files source))
                (push (copy-one file (merge-pathnames (file-namestring file) target)) copies))))
          (with-open-file (stream (second args) :direction :output :if-exists :error)
            (write (list :kind :group-command-archive :status :passed :copies (reverse copies)) :stream stream :pretty t)
            (terpri stream))
          (format t "~S~%" (list :kind :group-command-archive :status :passed :files (length copies)))))))
