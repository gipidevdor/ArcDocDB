(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(in-package #:arcdocdb.engine.tests)
(dolist (stage '("paged:partial-seal" "resident:published-3" "legacy:prepared"))
  (with-root (root)
    (child root 2 "group-crash" stage :signaled sb-posix:sigkill)
    (child root 2 "group-resume" stage :signaled sb-posix:sigkill)
    (child root 2 "group-verify" stage :exited 0)))
(format t "~S~%" '(:kind :group-crash-smoke :status :passed :scenarios 3 :children 9 :sigkills 6))
