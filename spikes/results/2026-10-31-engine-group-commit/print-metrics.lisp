(require :asdf)
(let* ((*read-eval* nil)
       (data (with-open-file (stream (merge-pathnames "metrics.lisp" *load-truename*)) (read stream))))
  (labels ((row (key unix) (or (find key (getf data (if unix :unix :engine))
                                   :key (lambda (item) (getf item :case)) :test #'equal) (error "Missing metric")))
           (bounds (pairs)
             (format t "~&ratios ~,4F .. ~,4F~%"
               (reduce #'min pairs :key (lambda (p) (getf p :throughput-ratio)))
               (reduce #'max pairs :key (lambda (p) (getf p :throughput-ratio))))))
    (format t "~&| Profile | v | Bytes | Single op/s | Group 8 op/s | Gain | Group-call P50 ms |~%|---|---:|---:|---:|---:|---:|---:|~%")
    (let ((pairs (remove-if-not (lambda (p) (= 8 (fourth (getf p :case)))) (getf data :engine-comparisons))))
      (dolist (pair pairs)
        (destructuring-bind (mode version size width) (getf pair :case)
          (declare (ignore width))
          (format t "| ~A | ~D | ~D | ~,1F | ~,1F | ~,2Fx | ~,3F |~%" mode version size
            (getf pair :baseline-ops-per-second) (getf pair :group-ops-per-second) (getf pair :throughput-ratio)
            (/ (getf (row (getf pair :case) nil) :median-call-p50-us) 1000d0))))
      (bounds pairs))
    (format t "~&| Profile | v | Limit 1 op/s | Limit 8 op/s | Gain | P99 ms 1 | P99 ms 8 | Mean group size |~%|---|---:|---:|---:|---:|---:|---:|---:|~%")
    (dolist (pair (getf data :unix-comparisons))
      (let* ((key (getf pair :case)) (base (row (append (subseq key 0 3) '(1)) t)) (group (row key t))
             (hist (getf group :flushes)) (count (reduce #'+ hist)))
        (format t "| ~A | ~D | ~,1F | ~,1F | ~,2Fx | ~,3F | ~,3F | ~,2F |~%"
          (first key) (second key) (getf pair :baseline-ops-per-second) (getf pair :group-ops-per-second)
          (getf pair :throughput-ratio) (/ (getf base :median-call-p99-us) 1000d0)
          (/ (getf group :median-call-p99-us) 1000d0) (/ 640d0 count))))
    (bounds (getf data :unix-comparisons))
    (dolist (mode '(:legacy :resident :paged))
      (let ((values (mapcar (lambda (row) (getf row :median-allocated-bytes-per-operation))
                            (remove-if-not (lambda (r) (eq mode (first (getf r :case)))) (getf data :engine)))))
        (format t "~&~A engine allocation bytes/op: ~,2F .. ~,2F~%" mode (reduce #'min values) (reduce #'max values))))))
