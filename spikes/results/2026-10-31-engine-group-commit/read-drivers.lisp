(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:group.bench (:use #:cl) (:local-nicknames (#:e #:arcdocdb.engine)))
(defpackage #:group.local-bench (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:p #:arcdocdb.local.process.tests)))
(dolist (name '("bench.lisp" "local-bench.lisp"))
  (let ((*package* (find-package :cl-user)) (*read-eval* nil) (forms 0))
    (with-open-file (stream (merge-pathnames name *load-truename*))
      (loop for form = (read stream nil :eof) until (eq form :eof) do
        (incf forms)
        (when (and (consp form) (eq 'in-package (first form)))
          (setf *package* (find-package (second form))))))
    (format t "~&~S~%" (list :driver name :forms forms :status :readable))))
