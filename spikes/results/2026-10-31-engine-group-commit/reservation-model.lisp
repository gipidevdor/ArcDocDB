;;;; SPK-07 variant: finite independent slot-selection model, no production code loaded.
(defpackage #:group.reservation.model (:use #:cl))
(in-package #:group.reservation.model)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (value) (unless value (error "Unreserved mutation target in finite group model")) value)
(defun base (key) (if (< key 8) (* 4 (floor key 4)) (* 4 (mod key 2))))
(defun probe (state key)
  ;; Full-group equality precedes EMPTY; any earlier DELETED wins an insertion.
  (let ((deleted -1) (start (base key)))
    (dotimes (g 2)
      (let ((empty -1))
        (dotimes (i 4)
          (let* ((slot (+ start i)) (value (aref state slot)))
            (when (= key value) (return-from probe (values slot t)))
            (when (and (= value -1) (minusp empty)) (setf empty slot))
            (when (and (= value -2) (minusp deleted)) (setf deleted slot))))
        (when (>= empty 0) (return-from probe (values (if (>= deleted 0) deleted empty) nil))))
      (setf start (mod (+ start 4) 8)))
    (values deleted nil)))
(defun mark-free-prefix (initial checked key)
  (let ((free 0) (start (base key)))
    (dotimes (g 2)
      (dotimes (i 4)
        (let ((slot (+ start i)))
          (when (minusp (aref initial slot)) (incf free) (setf (aref checked slot) 1))))
      (when (>= free 2) (return))
      (setf start (mod (+ start 4) 8)))))
(defun checked-plan (initial checked first second)
  (fill checked 0)
  (dotimes (i 2)
    (let* ((op (if (zerop i) first second)) (key (mod op 10)) (put (< op 10))
           (slot (position key initial))
           (present (if (and (= i 1) (= (mod first 10) key)) (< first 10) (not (null slot)))))
      (when slot (setf (aref checked slot) 1))
      (when (and put (not present)) (mark-free-prefix initial checked key)))))
(defun execute-plan (state checked first second corrupt)
  (dotimes (i 2 t)
    (let* ((op (if (zerop i) first second)) (key (mod op 10)) (put (< op 10)))
      (multiple-value-bind (slot present) (probe state key)
        (when (and put (minusp slot)) (return-from execute-plan nil))
        (when (or put present)
          (when corrupt (fill checked 0))
          (ensure (= 1 (aref checked slot)))
          (setf (aref state slot) (if put key -2)))))))
(defun run-model ()
  (let ((initial (make-array 8 :element-type 'fixnum)) (state (make-array 8 :element-type 'fixnum))
        (checked (make-array 8 :element-type '(unsigned-byte 8))) (cases 0) (admitted 0))
    (dotimes (configuration (expt 3 8))
      (let ((number configuration))
        (dotimes (i 8)
          (setf (aref initial i) (case (mod number 3) (0 -1) (1 -2) (otherwise i))
                number (floor number 3))))
      (dotimes (first 20)
        (dotimes (second 20)
          (checked-plan initial checked first second) (replace state initial)
          (when (execute-plan state checked first second nil) (incf admitted))
          (incf cases))))
    (ensure (= cases 2624400))
    (fill initial -1) (checked-plan initial checked 8 9) (replace state initial)
    (ensure (handler-case (progn (execute-plan state checked 8 9 t) nil) (error () t)))
    ;; A naive independent probe checks slot zero twice; the second distinct PUT actually uses slot one.
    (fill checked 0) (replace state initial)
    (setf (aref checked (probe initial 8)) 1 (aref checked (probe initial 0)) 1)
    (ensure (handler-case (progn (execute-plan state checked 8 0 nil) nil) (error () t)))
    (format t "~S~%" (list :kind :group-reservation-finite-model :status :passed :configurations 6561
       :sequences cases :admitted admitted :negative-control :detected
       :naive-independent-probe-negative :detected
       :limits '(:two-four-slot-groups :two-operations :not-full-width-proof :no-weak-memory-claim)))))
(run-model)
