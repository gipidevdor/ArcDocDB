(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(setf asdf:*compile-file-warnings-behaviour* :error asdf:*compile-file-failure-behaviour* :error)
(asdf:load-system "arcdocdb")
(defpackage #:group.smoke (:use #:cl) (:local-nicknames (#:e #:arcdocdb.engine)))
(in-package #:group.smoke)
(defun bytes (count &optional (byte 0)) (make-array count :element-type '(unsigned-byte 8) :initial-element byte))
(let ((root (merge-pathnames (format nil "arcdocdb-group-smoke-~D/" (sb-posix:getpid)) (uiop:temporary-directory))))
  (sb-posix:mkdir (namestring root) #o700)
  (let ((engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :create t :clock (lambda () 10)
                  :max-file-bytes 8192 :max-record-bytes 256 :max-records 32 :max-segments 16
                  :index-capacity 32 :key-arena-bytes 4096)))
    (unwind-protect
         (let ((operations (make-array 8)) (output (make-array 8 :element-type '(unsigned-byte 64) :initial-element 999))
               (target (bytes 64)))
           (dotimes (i 8) (setf (svref operations i) (e:crea-operazione-scrittura :put (bytes 16 (mod i 3)) (bytes 23 i))))
           (assert (= 8 (e:scrivi-gruppo-documenti engine operations output)))
           (assert (equalp output #(1 2 3 4 5 6 7 8)))
           (dotimes (i 3)
             (assert (equal (list :found 23) (multiple-value-list (e:leggi-documento engine (bytes 16 i) target))))
             (assert (= (aref target 0) (if (= i 2) 5 (+ i 6)))))
           (assert (= 9 (e:scrivi-documento engine (bytes 16 4) (bytes 23 9))))
           (format t "~S~%" '(:kind :group-smoke :status :passed)))
      (e:chiudi-motore engine)))
  (uiop:delete-directory-tree root :validate t))
