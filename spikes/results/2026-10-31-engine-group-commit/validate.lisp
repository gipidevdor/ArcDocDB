;;;; C4: completion markers, exact qualified source equality, final driver identity and metric cardinality.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Group qualification identity oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path
      (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun require-record (path marker)
  (let ((record (read-data path)))
    (ensure (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
                 (eql 0 (getf record :exit-code)) (search marker (getf record :stdout))))
    record))
(let* ((args (uiop:command-line-arguments)) (root (uiop:pathname-directory-pathname *load-truename*)))
  (if (equal args '("--self-test"))
      (progn
        (ensure (handler-case (progn (ensure nil) nil) (error () t)))
        ;; This deliberately interrupted SBCL process exited zero; the missing completion marker must reject it.
        (ensure (handler-case
          (progn (require-record (merge-pathnames "interrupted-pre-merge-2.6.10/report.lisp" root)
                                 "build e test: nessun avviso, tutti i controlli superati") nil)
          (error () t)))
        (format t "~S~%" '(:kind :group-identity-self-test :status :passed :interrupted-zero-exit :rejected)))
      (progn
        (ensure (equal args '("--run")))
        (let ((identity nil) (records nil) (drivers nil))
          (dolist (entry '(("full-check-2.6.9" "build e test: nessun avviso, tutti i controlli superati")
                           ("strict-2.6.10" "build e test: nessun avviso, tutti i controlli superati")
                           ("documentation" "Public Lisp example passed:")
                           ("engine-benchmark" ":GROUP-ENGINE-BENCHMARK :STATUS :PASSED")
                           ("unix-benchmark" ":GROUP-UNIX-BENCHMARK :STATUS :PASSED")))
            (let* ((record (require-record (merge-pathnames (format nil "~A/report.lisp" (first entry)) root) (second entry)))
                   (source (getf record :source-blobs-after)))
              (ensure (= 1630 (length source)))
              (if identity (ensure (equal identity source)) (setf identity source))
              (push (list :name (first entry) :status :passed) records)))
          (dolist (entry '(("bench.lisp" "engine-benchmark") ("local-bench.lisp" "unix-benchmark")))
            (let* ((path (merge-pathnames (first entry) root)) (hash (arcdocdb.evidence:file-sha256 path))
                   (record (read-data (merge-pathnames (format nil "~A/report.lisp" (second entry)) root))))
              (ensure (search hash (getf record :stdout)))
              (push (list :path (first entry) :sha256 hash) drivers)))
          (dolist (name '("summarize.lisp" "archive.lisp" "validate.lisp" "reservation-model.lisp"))
            (push (list :path name :sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames name root))) drivers))
          (let ((metrics (read-data (merge-pathnames "metrics.lisp" root))))
            (ensure (and (= 240 (getf metrics :engine-samples)) (= 40 (getf metrics :unix-samples))
                         (= 48 (length (getf metrics :engine))) (= 8 (length (getf metrics :unix)))
                         (= 36 (length (getf metrics :engine-comparisons))) (= 4 (length (getf metrics :unix-comparisons))))))
          (with-open-file (stream (merge-pathnames "source-identity.lisp" root) :direction :output :if-exists :error)
            (write (list :kind :group-qualified-source-identity :status :passed :source-files (length identity)
                         :campaigns (reverse records) :drivers (reverse drivers) :sources identity) :stream stream :pretty t)
            (terpri stream))
          (format t "~S~%" (list :kind :group-identity-validation :status :passed
                                 :source-files (length identity) :campaigns (length records)))))))
