(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (c) (unless (typep c 'sb-kernel:redefinition-warning) (error "Strict compile: ~A" c)))))
  (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
  (asdf:load-system "arcdocdb/tests")
  (let ((count 0))
    (dolist (test (reverse (symbol-value (find-symbol "*TESTS*" "ARCDOCDB.ENGINE.TESTS"))))
      (when (or (search "REQ-IDX-011" (symbol-name test))
                (search "REQ-IDX-010-DELTA-" (symbol-name test))
                (search "REQ-IDX-010-RENEW-" (symbol-name test))
                (search "REQ-IDX-010-MAINTAIN-" (symbol-name test)))
        (funcall test) (incf count) (format t "~&PASS ~A~%" test) (finish-output)))
    (format t "~&~S~%" (list :kind :m1-location-delta :status :passed :tests count :benchmark nil))))
