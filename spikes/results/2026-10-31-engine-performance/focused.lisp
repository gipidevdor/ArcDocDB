(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(let ((count 0))
  (dolist (test (reverse arcdocdb.engine.tests::*tests*))
    (when (or (search "TEST-REQ-CMP-001-PERFORMANCE-" (symbol-name test))
              (search "TEST-REQ-IDX-013-DISK-CACHE-COMPLETE-" (symbol-name test)))
      (funcall test) (incf count) (format t "~&PASS ~A~%" test)))
  (assert (= count 8)))
(format t "~&~S~%" '(:status :passed :scope :engine-performance-focused))
