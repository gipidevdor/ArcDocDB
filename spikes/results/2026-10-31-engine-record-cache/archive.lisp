;;;; C4: archive this campaign's exact command roots and selected top-level support reports only.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((target #p"spikes/results/2026-10-31-engine-record-cache/")
       (commands '(("4002460281-command-26406-0" "development-load")
                   ("4002460382-command-27804-0" "development-unmatched-test-parenthesis")
                   ("4002460456-command-28618-0" "development-incomplete-selector")
                   ("4002460532-command-29660-0" "focused-nine")
                   ("4002460639-command-31998-0" "lint-trace-links")
                   ("4002460662-command-32461-0" "development-engine-bench-self-test")
                   ("4002460721-command-33511-0" "full-check-2.6.9")
                   ("4002460722-command-33588-0" "strict-2.6.10")
                   ("4002460750-command-34216-0" "documentation")
                   ("4002460970-command-40845-0" "development-unix-bench-self-test")
                   ("4002461707-command-71803-0" "unix-bench-self-test")
                   ("4002461742-check-72932-0" "spikes-check")
                   ("4002461791-command-73648-0" "ci-self-test-command")
                   ("4002461798-command-73752-0" "engine-bench-self-test")
                   ("4002461830-command-74570-0" "engine-benchmark")
                   ("4002461877-command-75089-0" "unix-benchmark")
                   ("4002461952-command-78884-0" "development-plain-only-summarizer")))
       (copies nil))
  (flet ((copy-one (source destination)
           (when (probe-file destination) (error "Archive target already exists: ~A" destination))
           (ensure-directories-exist destination) (uiop:copy-file source destination)
           (unless (string= (arcdocdb.evidence:file-sha256 source) (arcdocdb.evidence:file-sha256 destination))
             (error "Archive byte mismatch: ~A" source))
           (push (list :source (namestring source) :target (namestring destination)
                       :sha256 (arcdocdb.evidence:file-sha256 destination)) copies)))
    (dolist (entry commands)
      (let* ((source (merge-pathnames (format nil "spikes/out/~A/" (first entry))))
             (destination (merge-pathnames (format nil "~A/" (second entry)) target)))
        (unless (probe-file source) (error "Missing owned command root: ~A" source))
        (dolist (path (uiop:directory-files source))
          (copy-one path (merge-pathnames (file-namestring path) destination)))))
    ;; Full fixture trees include intentionally malformed records/Git repositories; keep their top results only.
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((leaf (car (last (pathname-directory directory)))))
        (unless (or (find leaf commands :key #'first :test #'string=) (string= leaf "ci"))
          (dolist (file (uiop:directory-files directory))
            (when (string-equal (or (pathname-type file) "") "lisp")
              (copy-one file (merge-pathnames (format nil "support/~A/~A" leaf (file-namestring file)) target)))))))
    (dolist (file (uiop:directory-files #p"spikes/out/ci/selftest-1793472991-73647/"))
      (when (string-equal (or (pathname-type file) "") "lisp")
        (copy-one file (merge-pathnames (format nil "ci-self-test-data/~A" (file-namestring file)) target)))))
  (with-open-file (stream (merge-pathnames "archive-copies.lisp" target) :direction :output :if-exists :error)
    (write (list :kind :record-cache-archive :copies (reverse copies)) :stream stream :pretty t) (terpri stream))
  (format t "~S~%" (list :kind :record-cache-archive :status :passed :copied-files (length copies))))
