;;;; C4: lossless compaction limited to this completed campaign, including smaller command records.
(require :asdf)
(load "tools/compact-evidence.lisp") ; CLI --root is explicitly this campaign; default scope is never used.
(let ((root #p"spikes/results/2026-10-31-engine-record-cache/") (paths nil))
  (unless (equal (uiop:command-line-arguments)
                 '("--root" "spikes/results/2026-10-31-engine-record-cache/" "--jobs" "4"))
    (error "Unexpected archive scope"))
  (labels ((walk (directory)
             (dolist (path (uiop:directory-files directory))
               (when (and (string= (or (pathname-type path) "") "lisp")
                          (> (arcdocdb.evidence:file-bytes path) 65536)) (push path paths)))
             (dolist (child (uiop:subdirectories directory)) (walk child))))
    (walk root))
  (let ((results (compact-many paths 4)))
    (unless (every (lambda (row) (eq :ok (getf row :status))) results) (error "Lossless compaction failed"))
    (with-open-file (stream (merge-pathnames "lossless-compaction.lisp" root) :direction :output :if-exists :error)
      (write (list :kind :record-cache-lossless-compaction :status :passed :results results)
             :stream stream :pretty t) (terpri stream))
    (format t "~S~%" (list :kind :record-cache-lossless-compaction :status :passed :files (length results)))))
