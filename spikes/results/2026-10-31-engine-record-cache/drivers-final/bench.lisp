;;;; C4: paired engine cache experiment; only trusted command tokens, no external reader/eval.
(require :asdf)
(require :sb-posix)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb")
(defpackage #:record-cache.bench (:use #:cl) (:local-nicknames (#:e #:arcdocdb.engine)))
(in-package #:record-cache.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (value) (unless value (error "Record-cache benchmark oracle failed")) value)
(defun octets (n &optional (value 0)) (make-array n :element-type '(unsigned-byte 8) :initial-element value))
(defun fresh-root ()
  (loop for serial below 1000 for root = (merge-pathnames
        (format nil "arcdocdb-record-cache-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
        (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition) (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Fixture namespace exhausted"))
(defun open-engine (root mode version budget create)
  (let ((engine (e:apri-motore root (octets 16 73) (octets 16 41) :create create :version version :clock (lambda () 10)
                  :record-cache-budget budget :index-capacity 32 :key-arena-bytes 4096
                  :max-file-bytes 16777216 :max-record-bytes 65536 :max-records 1024
                  :index-policy (if (eq mode :legacy) :legacy (e:crea-politica-indice-automatico :budget 8388608 :frames 1)))))
    (when (eq mode :paged)
      (e:configura-budget-indice-motore engine (getf (e:statistiche-indice-motore engine) :reserved-fixed))
      (ensure (eq :paged (e:modo-indice-motore engine))))
    engine))
(defun checked-get (engine keys target id writes)
  (multiple-value-bind (status size) (e:leggi-documento engine (svref keys id) target)
    (ensure (and (eq status :found) (= size (length target))
                 (= (aref target 0) (+ (- writes (length keys)) id))
                 (= (aref target 0) (aref target (1- size)))))
    (aref target 0)))
(defun sample (engine keys bytes writes phase repetitions operations)
  (let ((target (octets bytes)))
    (dotimes (n (length keys)) (checked-get engine keys target n writes))
    (dotimes (rep repetitions)
      (let ((ticks (make-array operations :element-type '(unsigned-byte 64))) (calls 0) (read-bytes 0)
            (original (symbol-function 'arcdocdb.io:leggi-esatto)) (sink 0))
        (sb-ext:gc :full t)
        (unwind-protect
             (progn
               (setf (symbol-function 'arcdocdb.io:leggi-esatto)
                     (lambda (file buffer start end offset) (incf calls) (incf read-bytes (- end start))
                       (funcall original file buffer start end offset)))
               (let ((allocation (sb-ext:get-bytes-consed)) (begin (get-internal-real-time)))
                 (dotimes (n operations)
                   (let ((start (get-internal-real-time)))
                     (incf sink (checked-get engine keys target (mod (* n 5) (length keys)) writes))
                     (setf (aref ticks n) (- (get-internal-real-time) start))))
                 (let ((elapsed (- (get-internal-real-time) begin)) (allocated (- (sb-ext:get-bytes-consed) allocation))
                       (sorted (sort (copy-seq ticks) #'<)))
                   (ensure (plusp elapsed))
                   (format t "~&~S~%"
                     (list :kind :cache-get-sample :phase phase :repetition rep :operations operations :sink sink
                       :wall-ticks elapsed :ticks-per-second internal-time-units-per-second :allocated-bytes allocated
                       :read-calls calls :read-bytes read-bytes :statistics (e:statistiche-cache-motore engine)
                       :p50-ticks (aref sorted (1- (ceiling operations 2)))
                       :p99-ticks (aref sorted (1- (ceiling (* operations 99) 100))) :latency-ticks ticks)))))
          (setf (symbol-function 'arcdocdb.io:leggi-esatto) original))))) nil)
(defun one-case (mode version bytes budget repetitions operations writes)
  (let ((root (fresh-root)) (success nil) (engine nil) (keys (make-array 8)) (value (octets bytes)))
    (dotimes (n 8) (setf (svref keys n) (octets 16 n)))
    (unwind-protect
         (progn
           (format t "~&~S~%" (list :kind :cache-case :mode mode :version version :value-bytes bytes :budget budget :writes writes))
           (setf engine (open-engine root mode version budget t))
           (dotimes (n writes)
             (fill value n) (ensure (= (1+ n) (e:scrivi-documento engine (svref keys (mod n 8)) value))))
           (ensure (handler-case
                       (progn (checked-get engine keys (octets bytes) 0 (1+ writes)) nil)
                     (error () t)))
           (sample engine keys bytes writes :active repetitions operations)
           (ensure (eq :compacted (getf (e:compatta-motore engine :force t) :status)))
           (sample engine keys bytes writes :compacted repetitions operations)
           (e:chiudi-motore engine) (setf engine nil)
           (setf engine (open-engine root mode version budget nil))
           (sample engine keys bytes writes :reopened repetitions operations)
           (ensure (equal (list 0 writes 0 writes) (multiple-value-list (e:frontiere-motore engine))))
           (setf success t))
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t) (format *error-output* "~&CACHE-BENCH-RETAINED ~A~%" root)))))
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (self (equal args '("--self-test"))))
    (unless (or self (equal args '("--run"))) (error "Expected --run or --self-test"))
    (if self
        (progn
          (one-case :resident 2 2048 0 1 32 16)
          (one-case :paged 2 2048 4194304 1 32 16))
        (dolist (version '(1 2))
          (dolist (mode '(:legacy :resident :paged))
            (dolist (size '(2048 60000))
              ;; AB/BA alternating order reduces a systematic always-warm/always-late bias.
              (dolist (budget (if (evenp (+ version size)) '(0 4194304) '(4194304 0)))
                (one-case mode version size budget 5 4096 128))))))
    (format t "~&~S~%" (list :kind :record-cache-benchmark :status :passed :self-test self
       :platform (list (software-type) (machine-type) (lisp-implementation-version))
       :limits '(:local-C4 :warm-page-cache :eight-hot-keys :synchronous-actor :not-RSS :not-physical-device-IO)))))
(main)
