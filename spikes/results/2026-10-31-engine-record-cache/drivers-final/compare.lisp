(require :asdf)
(defun ensure (value) (unless value (error "Cache comparison oracle failed")) value)
(defun median (numbers) (nth (floor (length numbers) 2) (sort (copy-list numbers) #'<)))
(let ((*read-eval* nil) (args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (progn (ensure (= 2 (median '(3 1 2))))
             (format t "~S~%" '(:kind :cache-comparison-self-test :status :passed)))
      (let* ((input (with-open-file (stream (first args)) (read stream))) (rows (getf input :rows)) (comparisons nil))
        (ensure (= 72 (length rows)))
        (dolist (row rows)
          (destructuring-bind (mode version bytes budget phase) (getf row :case)
            (when (zerop budget)
              (let* ((other (find (list mode version bytes 4194304 phase) rows :key (lambda (r) (getf r :case)) :test #'equal))
                     (speed (and other (/ (getf other :median-ops-per-second) (getf row :median-ops-per-second)))))
                (ensure other)
                (push (list :mode mode :version version :bytes bytes :phase phase
                            :throughput-ratio speed :baseline-p99-us (getf row :median-p99-us)
                            :cache-p99-us (getf other :median-p99-us)
                            :baseline-reads (getf row :read-calls) :cache-reads (getf other :read-calls)
                            :baseline-allocations (getf row :allocated-bytes) :cache-allocations (getf other :allocated-bytes)) comparisons)))))
        (ensure (= 36 (length comparisons)))
        (with-open-file (stream (second args) :direction :output :if-exists :error)
          (let ((*print-pretty* t)) (write (list :kind :cache-comparison :pairs (nreverse comparisons)) :stream stream) (terpri stream)))
        (format t "~S~%" (list :kind :cache-comparison-summary :pairs 36
                              :minimum-ratio (apply #'min (mapcar (lambda (p) (getf p :throughput-ratio)) comparisons))
                              :median-ratio (median (mapcar (lambda (p) (getf p :throughput-ratio)) comparisons))
                              :maximum-ratio (apply #'max (mapcar (lambda (p) (getf p :throughput-ratio)) comparisons)))))))
