(require :asdf)
(defun ensure (value) (unless value (error "Unix cache metric oracle failed")) value)
(defun median (numbers) (nth (floor (length numbers) 2) (sort (copy-list numbers) #'<)))
(defun read-forms (text)
  (let ((*read-eval* nil))
    (with-input-from-string (stream text)
      (loop for form = (read stream nil :eof) until (eq form :eof) collect form))))
(let ((*read-eval* nil) (args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (progn (ensure (= 2 (median '(3 1 2))))
             (ensure (handler-case (progn (read-forms "#.(error :unsafe)") nil) (error () t)))
             (format t "~S~%" '(:kind :unix-cache-summary-self-test :status :passed)))
      (let* ((record (with-open-file (stream (first args)) (read stream)))
             (forms (read-forms (getf record :stdout)))
             (rows (remove-if-not (lambda (form) (eq :cache-unix-sample (getf form :kind))) forms))
             (groups nil) (results nil) (pairs nil))
        (ensure (eq :ok (getf record :status))) (ensure (eq :stable (getf record :source-consistency)))
        (ensure (= 40 (length rows)))
        (ensure (find-if (lambda (form) (and (eq :cache-unix-benchmark (getf form :kind))
                                            (eq :passed (getf form :status)) (null (getf form :self-test)))) forms))
        (dolist (row rows)
          (let* ((key (list (getf row :mode) (getf row :version) (getf row :budget)))
                 (group (assoc key groups :test #'equal)))
            (unless group (setf group (cons key nil)) (push group groups))
            (push row (cdr group))))
        (ensure (= 8 (length groups)))
        (dolist (group groups)
          (ensure (= 5 (length (cdr group))))
          (push (list :case (car group)
                      :median-ops-per-second (median (mapcar (lambda (row) (/ (* (getf row :operations)
                      (float (getf row :ticks-per-second) 1d0)) (getf row :wall-ticks))) (cdr group)))
                      :median-p50-us (median (mapcar (lambda (row) (/ (* 1000000d0 (getf row :p50-ticks))
                      (getf row :ticks-per-second))) (cdr group)))
                      :median-p99-us (median (mapcar (lambda (row) (/ (* 1000000d0 (getf row :p99-ticks))
                      (getf row :ticks-per-second))) (cdr group)))
                      :client-allocated-bytes (mapcar (lambda (row) (getf row :client-allocated-bytes)) (cdr group))) results))
        (dolist (row results)
          (destructuring-bind (mode version budget) (getf row :case)
            (when (zerop budget)
              (let ((other (find (list mode version 4194304) results :key (lambda (r) (getf r :case)) :test #'equal)))
                (ensure other)
                (push (list :mode mode :version version
                            :throughput-ratio (/ (getf other :median-ops-per-second) (getf row :median-ops-per-second))
                            :baseline-p50-us (getf row :median-p50-us) :cache-p50-us (getf other :median-p50-us)
                            :baseline-p99-us (getf row :median-p99-us) :cache-p99-us (getf other :median-p99-us)) pairs)))))
        (with-open-file (stream (second args) :direction :output :if-exists :error)
          (let ((*print-pretty* t)) (write (list :kind :unix-cache-metrics :rows results :pairs pairs) :stream stream) (terpri stream)))
        (format t "~S~%" (list :kind :unix-cache-metrics-summary :status :passed :pairs pairs)))))
