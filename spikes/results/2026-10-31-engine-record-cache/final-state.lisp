(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (value) (unless value (error "Final integration/retention identity failed")) value)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path
      (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun prefix-p (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))
(let* ((root #p"spikes/results/2026-10-31-engine-record-cache/")
       (identity (read-data (merge-pathnames "source-identity.lisp" root)))
       (sources (getf identity :sources))
       (paths (mapcar (lambda (row) (getf row :path)) sources))
       (changes (remove "" (uiop:split-string
         (uiop:run-program '("git" "diff" "--name-only" "e00df2c" "HEAD") :output :string)
         :separator '(#\Newline)) :test #'string=))
       (copies (getf (read-data (merge-pathnames "archive-copies.lisp" root)) :copies)))
  (ensure (= 1602 (length sources)))
  (ensure (every (lambda (path) (not (find #\Newline path))) paths))
  (let* ((input (format nil "~{~A~%~}" paths))
         (hashes (with-input-from-string (stream input)
                   (remove "" (uiop:split-string
                     (uiop:run-program '("git" "hash-object" "--stdin-paths") :input stream :output :string)
                     :separator '(#\Newline)) :test #'string=))))
    (ensure (= (length hashes) (length sources)))
    (loop for hash in hashes for row in sources do (ensure (string= hash (getf row :git-blob)))))
  (ensure (= 27 (length changes)))
  (ensure (every (lambda (path)
                   (or (string= path "spikes/core-code-review.lisp")
                       (prefix-p "spikes/results/2026-10-31-core-code-review/" path)
                       (prefix-p "spikes/results/2026-10-31-core-code-review-originals/" path))) changes))
  (ensure (> (length copies) 30))
  (dolist (entry copies)
    (let* ((path (pathname (getf entry :target))) (expected (getf entry :sha256))
           (current (arcdocdb.evidence:file-sha256 path)))
      (unless (string= expected current)
        (arcdocdb.evidence:call-with-evidence-bytes path
          (lambda (expanded) (ensure (string= expected (arcdocdb.evidence:file-sha256 expanded))))))))
  (dolist (path (uiop:directory-files root))
    (when (string= (or (pathname-type path) "") "lisp")
      (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (ensure (probe-file expanded))))))
  (let ((result (list :kind :cache-final-integration :status :passed :qualified-source-files (length sources)
                      :preserved-archive-copies (length copies) :merge-only-paths changes
                      :runtime-test-build-and-doc-tool-bytes :unchanged
                      :head (string-trim '(#\Newline) (uiop:run-program '("git" "rev-parse" "HEAD") :output :string)))))
    (with-open-file (stream (merge-pathnames "final-integration.lisp" root) :direction :output :if-exists :error)
      (write result :stream stream :pretty t) (terpri stream))
    (format t "~S~%" result)))
