(require :asdf)
(unless (equal (uiop:command-line-arguments)
               '("--root" "spikes/results/2026-10-31-engine-record-cache/" "--jobs" "4"))
  (error "Unexpected archive scope"))
(load "tools/compact-evidence.lisp")
(let ((root #p"spikes/results/2026-10-31-engine-record-cache/") (results nil))
  (dolist (entry '(("4002462213-command-85651-0" "development-compaction-option")
                   ("4002462232-command-88493-0" "compaction-command")
                   ("4002462252-command-91055-0" "small-compaction-command")))
    (dolist (source (uiop:directory-files (merge-pathnames (format nil "spikes/out/~A/" (first entry)))))
      (let ((target (merge-pathnames (format nil "~A/~A" (second entry) (file-namestring source)) root)))
        (unless (probe-file target) (uiop:copy-file source target))
        (unless (string= (arcdocdb.evidence:file-sha256 source) (arcdocdb.evidence:file-sha256 target))
          (error "Late copy mismatch"))))
    (let ((target (merge-pathnames (format nil "~A/report.lisp" (second entry)) root)))
      (when (> (arcdocdb.evidence:file-bytes target) 65536) (push (compact-one target) results))))
  (with-open-file (stream (merge-pathnames "late-archive.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :record-cache-late-archive :status :passed :results results) :stream stream :pretty t)
    (terpri stream)))
