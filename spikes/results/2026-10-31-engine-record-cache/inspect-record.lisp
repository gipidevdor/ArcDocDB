(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((*read-eval* nil) (args (uiop:command-line-arguments)))
  (arcdocdb.evidence:call-with-evidence-bytes
    (pathname (first args))
    (lambda (path)
      (let ((report (with-open-file (stream path) (read stream))))
        (if (second args)
            (let ((value (getf report (if (string= (second args) "stderr") :stderr :stdout))))
              (unless (stringp value) (error "Record stream not a string")) (write-string value))
            (format t "~S~%" (list :path (first args) :status (getf report :status)
              :source-consistency (getf report :source-consistency) :exit-code (getf report :exit-code)
              :source-count (length (getf report :source-blobs-after))
              :stdout-tail (let ((value (getf report :stdout)))
                             (and (stringp value) (subseq value (max 0 (- (length value) 1800)))))
              :stderr-tail (let ((value (getf report :stderr)))
                             (and (stringp value) (subseq value (max 0 (- (length value) 1800))))))))))))
