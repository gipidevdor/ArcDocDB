(require :asdf)
(let* ((*read-eval* nil)
       (root #p"spikes/results/2026-10-31-engine-record-cache/")
       (pairs (getf (with-open-file (stream (merge-pathnames "comparison.lisp" root)) (read stream)) :pairs))
       (metrics (with-open-file (stream (merge-pathnames "metrics.lisp" root)) (read stream)))
       (groups nil))
  (dolist (mode '(:legacy :resident :paged))
    (dolist (bytes '(2048 60000))
      (let* ((group (remove-if-not (lambda (row) (and (eq mode (getf row :mode)) (= bytes (getf row :bytes)))) pairs))
             (ratios (mapcar (lambda (row) (getf row :throughput-ratio)) group))
             (row (list :mode mode :value-bytes bytes :pairs (length group)
                        :minimum-improvement-percent (* 100 (- (apply #'min ratios) 1))
                        :maximum-improvement-percent (* 100 (- (apply #'max ratios) 1))
                        :baseline-p99-us (mapcar (lambda (row) (getf row :baseline-p99-us)) group)
                        :cache-p99-us (mapcar (lambda (row) (getf row :cache-p99-us)) group))))
        (unless (= 6 (length group)) (error "Missing comparison pair"))
        (push row groups) (format t "~S~%" row))))
  (unless (every (lambda (row) (every #'zerop (getf row :allocated-bytes))) (getf metrics :rows))
    (error "Unexpected allocation"))
  (with-open-file (stream (merge-pathnames "ranges.lisp-data" root) :direction :output :if-exists :error)
    (write (list :kind :cache-result-ranges :groups (nreverse groups) :sample-allocation-bytes 0
                 :engine-timed-gets (* 360 4096) :unix-timed-gets (* 40 1024)) :stream stream :pretty t)
    (terpri stream)))
