(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (value) (unless value (error "Cache metric oracle failed")) value)
(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<)) (n (length sorted)))
    (ensure (oddp n)) (nth (floor n 2) sorted)))
(defun decode-stream (text)
  (let ((*read-eval* nil) (forms nil))
    (with-input-from-string (stream text)
      (loop for form = (read stream nil :eof) until (eq form :eof) do (push form forms)))
    (nreverse forms)))
(defun aggregate (forms)
  (let ((case nil) (rows nil) (buckets nil) (cases 0) (samples 0))
    (dolist (form forms)
      (case (getf form :kind)
        (:cache-case (setf case form) (incf cases))
        (:cache-get-sample
         (ensure case) (incf samples)
         (let* ((key (list (getf case :mode) (getf case :version) (getf case :value-bytes)
                           (getf case :budget) (getf form :phase)))
                (bucket (assoc key buckets :test #'equal)))
           (unless bucket (setf bucket (cons key nil)) (push bucket buckets))
           (push form (cdr bucket))))
        (otherwise nil)))
    (ensure (= cases 24)) (ensure (= samples 360))
    (dolist (bucket (reverse buckets))
      (ensure (= 5 (length (cdr bucket))))
      (let* ((items (cdr bucket)) (operations (getf (first items) :operations))
             (rate (getf (first items) :ticks-per-second)))
        (ensure (every (lambda (row) (= operations (getf row :operations))) items))
        (push (list :case (car bucket) :repetitions 5 :operations operations
                    :median-ops-per-second (median (mapcar (lambda (row) (/ (* operations (float rate 1d0)) (getf row :wall-ticks))) items))
                    :median-p50-us (median (mapcar (lambda (row) (/ (* 1000000d0 (getf row :p50-ticks)) rate)) items))
                    :median-p99-us (median (mapcar (lambda (row) (/ (* 1000000d0 (getf row :p99-ticks)) rate)) items))
                    :read-calls (mapcar (lambda (row) (getf row :read-calls)) items)
                    :read-bytes (mapcar (lambda (row) (getf row :read-bytes)) items)
                    :allocated-bytes (mapcar (lambda (row) (getf row :allocated-bytes)) items)) rows)))
    (list :kind :record-cache-metrics :cases cases :samples samples :rows (nreverse rows))))
(let ((*read-eval* nil) (args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (progn
        (ensure (= 3 (median '(9 3 1 5 2))))
        (ensure (handler-case (progn (median '(1 2)) nil) (error () t)))
        (ensure (handler-case (progn (decode-stream "#.(error :unsafe)") nil) (error () t)))
        (ensure (handler-case (progn (aggregate nil) nil) (error () t)))
        (format t "~S~%" '(:kind :cache-metrics-self-test :status :passed)))
      (arcdocdb.evidence:call-with-evidence-bytes (pathname (first args))
       (lambda (path)
        (let* ((report (with-open-file (stream path) (read stream)))
             (stdout (getf report :stdout)))
        (ensure (eq :ok (getf report :status)))
        (ensure (eq :stable (getf report :source-consistency)))
        (ensure (search ":RECORD-CACHE-BENCHMARK :STATUS :PASSED" stdout))
        (let ((result (aggregate (decode-stream stdout))))
          (with-open-file (stream (second args) :direction :output :if-exists :error)
            (let ((*print-pretty* t)) (write result :stream stream) (terpri stream)))
          (format t "~S~%" (list :kind :cache-metrics-summary :status :passed :rows (length (getf result :rows))))))))))
