;;;; C4: source/evidence consistency and independent metric range checks.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (value) (unless value (error "Final cache evidence validation failed")) value)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path
      (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(let* ((root #p"spikes/results/2026-10-31-engine-record-cache/")
       (args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (progn (ensure (handler-case (progn (ensure nil) nil) (error () t)))
             (format t "~S~%" '(:kind :cache-evidence-validator-self-test :status :passed)))
      (let ((source nil) (commands '("full-check-2.6.9" "strict-2.6.10" "documentation" "engine-benchmark" "unix-benchmark"))
            (drivers '("bench.lisp" "local-bench.lisp" "focused.lisp" "summarize.lisp" "summarize-local.lisp" "compare.lisp" "ranges.lisp" "validate.lisp"))
            (hashes nil))
        (dolist (name commands)
          (let* ((report (read-data (merge-pathnames (format nil "~A/report.lisp" name) root)))
                 (after (getf report :source-blobs-after)))
            (ensure (eq :ok (getf report :status))) (ensure (zerop (getf report :exit-code)))
            (ensure (eq :stable (getf report :source-consistency))) (ensure (= 1602 (length after)))
            (if source (ensure (equal source after)) (setf source after))))
        (dolist (name '("bench.lisp" "local-bench.lisp" "focused.lisp"))
          (ensure (string= (arcdocdb.evidence:file-sha256 (merge-pathnames name root))
                           (arcdocdb.evidence:file-sha256 (merge-pathnames (format nil "drivers-final/~A" name) root)))))
        (let* ((metrics (read-data (merge-pathnames "metrics.lisp" root)))
               (pairs (getf (read-data (merge-pathnames "comparison.lisp" root)) :pairs))
               (unix (read-data (merge-pathnames "unix-metrics.lisp" root))))
          (ensure (= 24 (getf metrics :cases))) (ensure (= 360 (getf metrics :samples)))
          (ensure (= 72 (length (getf metrics :rows)))) (ensure (= 36 (length pairs)))
          (ensure (= 8 (length (getf unix :rows)))) (ensure (= 4 (length (getf unix :pairs))))
          (dolist (row (getf metrics :rows))
            (ensure (= 5 (length (getf row :allocated-bytes))))
            (ensure (every #'zerop (getf row :allocated-bytes))))
          (ensure (> (apply #'max (mapcar (lambda (p) (getf p :throughput-ratio)) pairs)) 1.4d0))
          (ensure (< (apply #'min (mapcar (lambda (p) (getf p :throughput-ratio)) pairs)) 1.02d0)))
        (dolist (name drivers)
          (push (list :path name :sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames name root))) hashes))
        (with-open-file (stream (merge-pathnames "source-identity.lisp" root) :direction :output :if-exists :error)
          (write (list :kind :cache-qualified-identity :status :passed :sources source :drivers (nreverse hashes))
                 :stream stream :pretty t) (terpri stream))
        (format t "~S~%" (list :kind :cache-evidence-validation :status :passed :source-files (length source)
                               :campaigns (length commands) :engine-samples 360 :unix-samples 40)))))
