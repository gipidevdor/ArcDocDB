(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(let ((count 0))
  (dolist (package '("ARCDOCDB.ENGINE.TESTS" "ARCDOCDB.LOCAL.PROCESS.TESTS"))
    (dolist (test (reverse (symbol-value (find-symbol "*TESTS*" package))))
      (when (search "TEST-REQ-STO-003-LIVE-ROTATION-" (symbol-name test))
        (funcall test) (incf count) (format t "~&PASS ~A~%" test))))
  (assert (= count 9))
  (format t "~&~S~%" (list :status :passed :tests count)))
