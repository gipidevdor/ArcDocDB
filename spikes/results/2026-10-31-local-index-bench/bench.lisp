;;; C4, owned fixtures only. See method.md; no product edits or remote writes.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:arcdocdb.local.index.bench
  (:use #:cl)
  (:local-nicknames (#:e #:arcdocdb.engine) (#:l #:arcdocdb.local)
                    (#:p #:arcdocdb.local.process.tests)))
(in-package #:arcdocdb.local.index.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defvar *report*)
(defvar *out*)
(defvar *keys*)
(defvar *misses*)
(defvar *document*)
(defvar *count*)
(defvar *warm*)
(defvar *engine-count*)
(defvar *writes*)
(defun save-result ()
  (with-open-file (s (merge-pathnames "result.lisp" *out*) :direction :output :if-exists :supersede)
    (write *report* :stream s :readably t :pretty t) (terpri s)))
(defun add-row (row)
  (push row (getf *report* :rows)) (save-result)
  (format t "~&BENCH ~S~%" (subseq row 0 (min 10 (length row)))) (finish-output))
(defun seconds (ticks) (/ ticks (float internal-time-units-per-second 1d0)))
(defun percentile (samples percent)
  (aref samples (max 0 (1- (ceiling (* (length samples) percent) 100)))))
(defun bytes (size &optional (byte 0))
  (make-array size :element-type '(unsigned-byte 8) :initial-element byte))
(defun make-key (i)
  (let ((key (bytes 16))) (arcdocdb.binary:scrivi-u32 key 0 i) key))
(defun make-document (payload)
  (let ((doc (bytes (+ 3 payload) 117)))
    (setf (aref doc 0) #x59 (aref doc 1) (ldb (byte 8 8) payload)
          (aref doc 2) (ldb (byte 8 0) payload)) doc))
(defun check-get (status document found)
  (assert (eq status (if found :found :absent)))
  (assert (if found (equalp document *document*) (null document))))
(defun sample-window (kind n warm thunk)
  (dotimes (i warm) (funcall thunk i))
  (let ((samples (make-array n :element-type 'fixnum))
        (wall (get-internal-real-time)) (cpu (get-internal-run-time))
        (consed (sb-ext:get-bytes-consed)) (gc sb-ext:*gc-run-time*))
    (dotimes (i n)
      (let ((start (get-internal-real-time)))
        (funcall thunk i)
        (setf (aref samples i) (- (get-internal-real-time) start))))
    (let* ((elapsed (seconds (- (get-internal-real-time) wall)))
           (cpu-seconds (seconds (- (get-internal-run-time) cpu)))
           (allocated (- (sb-ext:get-bytes-consed) consed))
           (gc-seconds (seconds (- sb-ext:*gc-run-time* gc)))
           (ordered (sort (copy-seq samples) #'<)))
      (list :operation kind :calls n :warmup warm :wall-seconds elapsed :cpu-seconds cpu-seconds
            :ops-per-second (if (plusp elapsed) (/ n elapsed) 0d0) :lisp-bytes allocated
            :gc-seconds gc-seconds :p50-us (* 1d6 (seconds (percentile ordered 50)))
            :p95-us (* 1d6 (seconds (percentile ordered 95)))
            :p99-us (* 1d6 (seconds (percentile ordered 99))) :ticks samples))))
(defun option (page)
  (e:crea-opzione-indice-paginato (format nil "primary-~16,'0x.idx.tmp" page) :page-size page))
(defun seed (data version)
  (let ((engine (e:apri-motore data (p::decode-hex p::*archive-hex*) (p::decode-hex p::*series-hex*)
                  :create t :version version :clock #'get-internal-real-time)))
    (unwind-protect
         (progn
           (loop for key across *keys* for i from 1 do
             (assert (= i (e:scrivi-documento engine key *document*))))
           (dolist (page '(4096 16384 65536))
             (e:costruisci-indice-paginato-motore engine (option page))))
      (e:chiudi-motore engine))))
(defun copy-data (source name mode version)
  (let ((dest (p::subdirectory name)))
    (dolist (file (uiop:directory-files source))
      (unless (and (eq mode :empty) (search ".idx.tmp" (file-namestring file)))
        (uiop:copy-file file (merge-pathnames (file-namestring file) dest))))
    (when (eq mode :stale)
      (let ((engine (e:apri-motore dest (p::decode-hex p::*archive-hex*) (p::decode-hex p::*series-hex*)
                       :clock #'get-internal-real-time :version version)))
        (unwind-protect (e:scrivi-documento engine (aref *keys* 0) *document*)
          (e:chiudi-motore engine)))) dest))
(defun engine-case (data version size replica mode page)
  (let* ((wall (get-internal-real-time)) (cpu (get-internal-run-time)) (alloc (sb-ext:get-bytes-consed))
         (engine (e:apri-motore data (p::decode-hex p::*archive-hex*) (p::decode-hex p::*series-hex*)
                   :clock #'get-internal-real-time :version version
                   :index-discovery (unless (eq mode :resident) (e:crea-opzione-scoperta-indice :page-size page))))
         (elapsed (seconds (- (get-internal-real-time) wall)))
         (cpu-seconds (seconds (- (get-internal-run-time) cpu)))
         (allocated (- (sb-ext:get-bytes-consed) alloc)) (actual (e:modo-indice-motore engine))
         (output (bytes (length *document*))))
    (unwind-protect
         (let ((windows nil))
           (assert (eq actual (if (eq mode :current) :paged :resident)))
           (dolist (found '(t nil))
             (let ((keys (if found *keys* *misses*)))
               (multiple-value-bind (status n) (e:leggi-documento engine (aref keys 0) output)
                 (assert (eq status (if found :found :absent)))
                 (assert (= n (if found (length *document*) 0)))
                 (when found (assert (equalp output *document*))))
               (push (sample-window (if found :hit :miss) *engine-count* *warm*
                       (lambda (i)
                         (multiple-value-bind (status n)
                             (e:leggi-documento engine (aref keys (mod (* i 73) (length keys))) output)
                           (assert (eq status (if found :found :absent)))
                           (assert (= n (if found (length *document*) 0)))))) windows)
               (when found (assert (equalp output *document*)))))
           (add-row (list :layer :engine :version version :payload-bytes size :replica replica
                          :mode mode :page-bytes page :observed-mode actual :startup-seconds elapsed
                          :startup-cpu-seconds cpu-seconds :startup-lisp-bytes allocated :windows (nreverse windows))))
      (e:chiudi-motore engine))))
(defun os-snapshot (pid)
  (string-trim '(#\Space #\Newline)
    (uiop:run-program (list "ps" "-p" (write-to-string pid) "-o" "time=,rss=") :output :string)))
(defun service-case (data runtime version size replica mode stage)
  (let ((start (get-internal-real-time)) (clients nil) (windows nil) (next-csn (length *keys*)))
    (when (eq mode :stale) (incf next-csn))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version stage :discovery (not (eq mode :resident)))
      (let ((startup (seconds (- (get-internal-real-time) start))) (before (os-snapshot (p::child-pid server))))
        (unwind-protect
             (progn
               (dolist (connections '(1 4 8))
                 (loop while (< (length clients) connections) do
                   (push (l:connect-local (namestring socket)) clients))
                 (let ((pool (coerce clients 'simple-vector)))
                   (dolist (op '(:ping :hit :miss))
                     (push (append (list :connections connections)
                             (sample-window op *count* (min 50 *warm*)
                               (lambda (i)
                                 (let ((client (svref pool (mod i connections))))
                                   (case op
                                     (:ping (assert (null (l:client-ping client))))
                                     (otherwise
                                      (let* ((found (eq op :hit)) (keys (if found *keys* *misses*)))
                                        (multiple-value-bind (status doc)
                                            (l:client-get client (aref keys (mod (* i 73) (length keys))))
                                          (check-get status doc found))))))))) windows))))
               (let ((client (first clients)))
                 (dolist (op '(:put :delete))
                   (push (append (list :connections 8)
                           (sample-window op *writes* 0
                             (lambda (i)
                               (let ((key (aref *keys* (mod i (length *keys*)))))
                                 (assert (= (incf next-csn)
                                            (if (eq op :put) (l:client-put client key *document*)
                                                (l:client-delete client key)))))))) windows)))
               (add-row (list :layer :service :version version :payload-bytes size :replica replica
                              :mode mode :page-bytes 4096 :spawn-to-ready-seconds startup
                              :server-cpu-rss-before before :server-cpu-rss-after (os-snapshot (p::child-pid server))
                              :windows (nreverse windows))))
          (dolist (client clients) (l:close-local client))
          (p::stop-server server sb-posix:sigterm :benchmark-completed))))))
(defun campaign (small)
  (let* ((p::*root* (p::fresh-root)) (p::*children* nil) (p::*scenarios* nil) (p::*cleanup-errors* nil)
         (*keys* (map 'simple-vector #'make-key (loop for i below (if small 8 512) collect i)))
         (*misses* (map 'simple-vector #'make-key (loop for i from 10000 below (+ 10000 (length *keys*)) collect i)))
         (*count* (if small 3 300)) (*warm* (if small 2 1000))
         (*engine-count* (if small 8 10000)) (*writes* (if small 2 25)) (passed nil) (stage 0))
    (unwind-protect
         (progn
           (dotimes (replica (if small 1 3))
             (dolist (version '(1 2))
               (dolist (size (if small '(1024) '(1024 4096)))
                 (let* ((*document* (make-document size))
                        (source (p::subdirectory (format nil "seed-~D-~D-~D/" replica version size)))
                        (runtime (p::subdirectory (format nil "rt-~D-~D-~D/" replica version size)))
                        (modes (if (evenp replica) '(:resident :empty :current :stale) '(:stale :current :empty :resident))))
                   (seed source version)
                   (dolist (mode modes)
                     (dolist (page (if (eq mode :current) '(4096 16384 65536) '(4096)))
                       (engine-case (copy-data source (format nil "engine-~D/" (incf stage)) mode version)
                                    version size replica mode page))
                     (service-case (copy-data source (format nil "service-~D/" (incf stage)) mode version)
                                   runtime version size replica mode stage))))))
           (setf passed t))
      (p::finish-children)
      (setf (getf *report* :fixture-root) (namestring p::*root*)
            (getf *report* :fixture-removed) passed)
      (if passed (uiop:delete-directory-tree p::*root* :validate t)
          (format *error-output* "BENCH-ROOT-RETAINED ~A~%" p::*root*)))))
(defun self-check ()
  (assert (= 3 (percentile #(1 2 3 4 5) 50)))
  (assert (= 5 (percentile #(1 2 3 4 5) 99)))
  (let ((*document* (bytes 1 7)) (caught nil))
    (handler-case (check-get :found (bytes 1 8) t) (error () (setf caught t)))
    (assert caught))
  (setf (getf *report* :oracle-negative-control) :detected))
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (mode (first args))
         (*out* (uiop:ensure-directory-pathname (second args)))
         (*report* (list :kind :local-index-benchmark :status :running :rows nil
                        :lisp (lisp-implementation-version) :tick-hz internal-time-units-per-second
                        :method "method.md" :external-load :uncontrolled)))
    (assert (and (= (length args) 2) (member mode '("--self-test" "--bench") :test #'string=)))
    (assert (not (probe-file *out*))) (ensure-directories-exist (merge-pathnames "result.lisp" *out*))
    (handler-case
        (sb-ext:with-timeout 900
          (self-check) (campaign (string= mode "--self-test"))
          (setf (getf *report* :status) :ok) (save-result))
      (error (c) (setf (getf *report* :status) :failed (getf *report* :diagnostic) (princ-to-string c))
        (save-result) (error c)))
    (format t "~&RESULT ~A ~D rows~%" (getf *report* :status) (length (getf *report* :rows)))))
(main)
