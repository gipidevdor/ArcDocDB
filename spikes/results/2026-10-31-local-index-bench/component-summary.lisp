(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((root "spikes/results/2026-10-31-local-index-bench/") (rows nil) (inventory nil))
  (dolist (runtime '("2.6.10" "2.6.9"))
    (dolist (kind '(:throughput :performance))
      (let* ((name (if (eq kind :throughput) "component-throughput" "component-performance"))
             (folder (format nil "~A~A-run/" name (if (string= runtime "2.6.9") "-2.6.9" "")))
             (report (arcdocdb.evidence:read-evidence (concatenate 'string root folder "report.lisp")))
             (windows (if (eq kind :throughput) (getf report :windows)
                          (append (getf report :serial) (getf report :parallel))))
             (groups (make-hash-table :test #'equal)))
        (assert (eq :ok (getf report :status)))
        (assert (= (length windows) (if (eq kind :throughput) 432 360)))
        (push (list :runtime runtime :kind kind :status :ok :windows (length windows)
                    :selected-backend (getf report :selected-backend)
                    :self-test (if (eq kind :performance) (getf (getf report :self-test) :status) :embedded-72-windows)) inventory)
        (dolist (w windows)
          (when (or (eq kind :performance) (eq :bench (getf w :suite)))
            (assert (eq :ok (getf w :status)))
            (let ((key (if (eq kind :throughput)
                           (list runtime kind (getf w :size) (getf w :csn) (getf w :scenario)
                                 (getf w :variant) (getf w :kernel) 1)
                           (list runtime kind (getf w :value-bytes) (getf w :csn) (getf w :scenario)
                                 (getf w :execution) :selected (getf w :worker-count)))))
              (push w (gethash key groups)))))
        (maphash
         (lambda (key windows)
           (assert (= 5 (length windows)))
           (let* ((completed (reduce #'+ windows :key (lambda (w) (getf w :completed))))
                  (seconds (if (eq kind :throughput)
                               (/ (reduce #'+ windows :key (lambda (w) (getf w :ticks)))
                                  (float (getf report :timer-units) 1d0))
                               (reduce #'+ windows :key (lambda (w) (getf w :seconds)))))
                  (heap (reduce #'+ windows :key (lambda (w) (or (getf w :heap-bytes) 0)))))
             (push (list :key key :calls completed :seconds seconds :ops-s (/ completed seconds)
                         :lisp-bytes-per-call (/ (float heap 1d0) completed)) rows))) groups))))
  (setf rows (sort rows #'string< :key (lambda (r) (format nil "~S" (getf r :key)))))
  (with-open-file (s (concatenate 'string root "component-metrics.csv") :direction :output :if-exists :supersede)
    (format s "runtime,campaign,value_bytes,csn,scenario,variant,kernel,workers,calls,ops_s,lisp_bytes_call~%")
    (dolist (r rows)
      (format s "~{~A~^,~},~D,~,3F,~,3F~%" (getf r :key) (getf r :calls)
              (getf r :ops-s) (getf r :lisp-bytes-per-call))))
  (with-open-file (s (concatenate 'string root "component-inventory.lisp") :direction :output :if-exists :supersede)
    (write (list :kind :component-campaign-inventory :status :ok :campaigns (nreverse inventory)
                 :groups (length rows)) :stream s :pretty t :readably t) (terpri s))
  (format t "Component groups: ~D~%" (length rows)))
