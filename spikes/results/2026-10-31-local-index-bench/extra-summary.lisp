(require :asdf)
(load "tools/evidence-storage.lisp")
(defun clock-seconds (text)
  (let ((value 0d0))
    (dolist (piece (uiop:split-string text :separator '(#\:)) value)
      (let ((*read-eval* nil))
        (let ((number (read-from-string piece)))
          (assert (and (realp number) (not (minusp number))))
          (setf value (+ (* 60 value) number)))))))
(defun cpu-rss (text)
  (let ((parts (remove "" (uiop:split-string text :separator '(#\Space #\Tab)) :test #'string=)))
    (assert (= 2 (length parts)))
    (values (clock-seconds (first parts)) (parse-integer (second parts)))))
(assert (< (abs (- (clock-seconds "1:00.10") 60.1d0)) 0.001d0))
(let* ((args (uiop:command-line-arguments)) (input (first args)) (output (second args))
       (data (arcdocdb.evidence:read-evidence input)))
  (with-open-file (s output :direction :output :if-exists :supersede)
    (format s "layer,format,payload_bytes,replica,mode,page_bytes,startup_cpu_ms,startup_lisp_bytes,server_cpu_delta_s,server_rss_before_kib,server_rss_after_kib~%")
    (dolist (r (reverse (getf data :rows)))
      (format s "~A,~D,~D,~D,~A,~D," (getf r :layer) (getf r :version) (getf r :payload-bytes)
              (getf r :replica) (getf r :mode) (getf r :page-bytes))
      (if (eq :engine (getf r :layer))
          (format s "~,3F,~D,,,~%" (* 1000d0 (getf r :startup-cpu-seconds)) (getf r :startup-lisp-bytes))
          (multiple-value-bind (before-cpu before-rss) (cpu-rss (getf r :server-cpu-rss-before))
            (multiple-value-bind (after-cpu after-rss) (cpu-rss (getf r :server-cpu-rss-after))
              (assert (>= after-cpu before-cpu))
              (format s ",,~,3F,~D,~D~%" (- after-cpu before-cpu) before-rss after-rss)))))))
