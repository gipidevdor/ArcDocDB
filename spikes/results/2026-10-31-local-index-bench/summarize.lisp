;;; C4: reduce owned benchmark evidence; no evaluation of report contents.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun read-result (path) (arcdocdb.evidence:read-evidence path))
(defun median (values)
  (let ((sorted (sort (copy-seq values) #'<)))
    (elt sorted (floor (length sorted) 2))))
(defun qtile (values p)
  (aref values (max 0 (1- (ceiling (* (length values) p) 100)))))
(assert (= 3 (median '(5 1 3))))
(assert (= 5 (qtile #(1 2 3 4 5) 99)))
(let* ((args (uiop:command-line-arguments)) (input (first args)) (out (second args))
       (data (read-result input)) (groups (make-hash-table :test #'equal))
       (starts (make-hash-table :test #'equal)) (summaries nil) (start-rows nil)
       (hz (getf data :tick-hz)))
  (assert (and (= (length args) 2) (eq :ok (getf data :status))))
  (assert (= 120 (length (getf data :rows))))
  (dolist (row (getf data :rows))
    (let ((key (list (getf row :layer) (getf row :version) (getf row :payload-bytes)
                     (getf row :mode) (getf row :page-bytes))))
      (push row (gethash key starts))
      (dolist (window (getf row :windows))
        (push window (gethash (append key (list (or (getf window :connections) 0)
                                               (getf window :operation))) groups)))))
  (maphash
   (lambda (key rows)
     (assert (= 3 (length rows)))
     (let ((ms (mapcar (lambda (r) (* 1000d0 (or (getf r :startup-seconds)
                                               (getf r :spawn-to-ready-seconds)))) rows)))
       (push (list :key key :replicas 3 :median-ms (median ms) :min-ms (apply #'min ms)
                   :max-ms (apply #'max ms)) start-rows))) starts)
  (maphash
   (lambda (key windows)
     (assert (= 3 (length windows)))
     (let* ((calls (reduce #'+ windows :key (lambda (w) (getf w :calls))))
            (wall (reduce #'+ windows :key (lambda (w) (getf w :wall-seconds))))
            (samples (make-array calls :element-type 'fixnum)) (offset 0)
            (alloc (reduce #'+ windows :key (lambda (w) (getf w :lisp-bytes))))
            (cpu (reduce #'+ windows :key (lambda (w) (getf w :cpu-seconds))))
            (gc (reduce #'+ windows :key (lambda (w) (getf w :gc-seconds)))))
       (dolist (window windows)
         (let ((ticks (getf window :ticks)))
           (assert (= (length ticks) (getf window :calls)))
           (replace samples ticks :start1 offset) (incf offset (length ticks))))
       (setf samples (sort samples #'<))
       (push (list :key key :calls calls :replicas 3 :wall-seconds wall
                   :ops-per-second (/ calls wall) :cpu-us-per-call (/ (* 1d6 cpu) calls)
                   :lisp-bytes-per-call (/ (float alloc 1d0) calls) :gc-seconds gc
                   :p50-us (/ (* 1d6 (qtile samples 50)) hz)
                   :p95-us (/ (* 1d6 (qtile samples 95)) hz)
                   :p99-us (/ (* 1d6 (qtile samples 99)) hz)) summaries))) groups)
  (flet ((key-text (r) (format nil "~S" (getf r :key))))
    (setf summaries (sort summaries #'string< :key #'key-text)
          start-rows (sort start-rows #'string< :key #'key-text)))
  (with-open-file (s (merge-pathnames "summary.lisp" out) :direction :output :if-exists :supersede)
    (write (list :kind :local-index-benchmark-summary :status :ok :source input
                 :row-count 120 :metric-groups (length summaries) :latency-method :pooled-raw-ticks
                 :engine-tick-us (/ 1d6 hz) :startup start-rows :metrics summaries)
           :stream s :pretty t :readably t) (terpri s))
  (with-open-file (s (merge-pathnames "metrics.csv" out) :direction :output :if-exists :supersede)
    (format s "layer,format,payload_bytes,mode,page_bytes,connections,operation,calls,ops_s,p50_us,p95_us,p99_us,cpu_us_call,lisp_bytes_call,gc_s~%")
    (dolist (row summaries)
      (format s "~{~A~^,~},~D,~,3F,~,3F,~,3F,~,3F,~,3F,~,3F,~,6F~%"
              (getf row :key) (getf row :calls) (getf row :ops-per-second) (getf row :p50-us)
              (getf row :p95-us) (getf row :p99-us) (getf row :cpu-us-per-call)
              (getf row :lisp-bytes-per-call) (getf row :gc-seconds))))
  (with-open-file (s (merge-pathnames "startup.csv" out) :direction :output :if-exists :supersede)
    (format s "layer,format,payload_bytes,mode,page_bytes,replicas,median_ms,min_ms,max_ms~%")
    (dolist (row start-rows)
      (format s "~{~A~^,~},3,~,3F,~,3F,~,3F~%" (getf row :key) (getf row :median-ms)
              (getf row :min-ms) (getf row :max-ms))))
  (format t "Summarized ~D metrics, ~D startup groups.~%" (length summaries) (length start-rows)))
