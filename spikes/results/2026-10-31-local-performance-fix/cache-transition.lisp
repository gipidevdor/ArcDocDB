(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/local")
(let* ((software (equal (first (uiop:command-line-arguments)) "--software"))
       (expected (if software :lisp :arm64-crc32c))
       (buffer (make-array 4097 :element-type '(unsigned-byte 8) :initial-element 171)))
  (assert (eq expected (arcdocdb.binary:backend-crc32c)))
  (assert (eq (not software) (not (null (fboundp (find-symbol "CRC32C-ARM64" "ARCDOCDB.BINARY"))))))
  (when software (assert (not (find-package "SB-SIMD-NEON"))))
  (assert (= (arcdocdb.binary::crc32c-lisp buffer 1 4097 #xffffffff)
             (arcdocdb.binary:crc32c buffer 1 4097 #xffffffff)))
  (format t "~&~S~%" (list :kind :native-cache-transition :status :ok :runtime (lisp-implementation-version)
                            :backend expected :force nil :native-present (not software))))
