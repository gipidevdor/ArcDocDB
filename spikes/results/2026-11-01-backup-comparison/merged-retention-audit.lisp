 :HELPER "(require :asdf)
(load \"tools/evidence-storage.lisp\")
(defun merged-copy-bytes (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (unless (= (length bytes) (read-sequence bytes in)) (error \"Short retention read: ~A\" path)) bytes)))
(let ((root (truename \"spikes/results/2026-11-01-backup-comparison/\")) (copies nil))
  (labels ((retain (source name)
             (let* ((source (truename source)) (target (merge-pathnames name root))
                    (bytes (merged-copy-bytes source)) (hash (arcdocdb.evidence:file-sha256 source)))
               (with-open-file (out target :direction :output :if-exists :error :element-type '(unsigned-byte 8))
                 (write-sequence bytes out))
               (unless (and (equalp bytes (merged-copy-bytes target)) (equalp bytes (merged-copy-bytes source))
                            (string= hash (arcdocdb.evidence:file-sha256 target))
                            (string= hash (arcdocdb.evidence:file-sha256 source)))
                 (error \"Merged retention mismatch: ~A\" source))
               (push (list :source (namestring source) :target name :bytes (length bytes)
                           :sha256-before hash :sha256-after (arcdocdb.evidence:file-sha256 source)
                           :target-sha256 (arcdocdb.evidence:file-sha256 target) :byte-comparison :equal) copies)
               (unless (equal \"gz\" (pathname-type source))
                 (let ((*read-eval* nil))
                   (with-open-file (in source)
                     (let ((data (read in)))
                       (when (eq :compressed-evidence (getf data :kind))
                         (retain (merge-pathnames (getf data :payload) source)
                                 (namestring (merge-pathnames (getf data :payload) name)))))))))))
    (dolist (label (uiop:command-line-arguments))
      (retain (format nil \"spikes/out/backup-compare-20261101/~A/report.lisp\" label)
              (format nil \"~A-process.lisp\" label))
      (retain (format nil \"spikes/out/backup-compare-20261101/~A/conservazione.lisp\" label)
              (format nil \"~A-retention.lisp\" label)))
    (retain \"spikes/out/4002534332-command-152-0/report.lisp\" \"merged-ci-child-process.lisp\")
    (retain \"spikes/out/4002534332-command-152-0/conservazione.lisp\" \"merged-ci-child-retention.lisp\")
    (retain \"spikes/out/ci/selftest-1793545532-148/report.lisp\" \"merged-ci-summary.lisp\")
    (retain \"spikes/out/ci/selftest-1793545532-148/tests.lisp\" \"merged-ci-tests.lisp\"))
  (with-open-file (out (merge-pathnames \"merged-retention-audit.lisp\" root) :direction :output :if-exists :error)
    (write (list :schema-version 1 :kind :retention-audit :status :ok :copies (nreverse copies)
                 :helper (uiop:read-file-string *load-truename*)
                 :limits '(:completed-file-snapshots :not-atomic-filesystem-proof :post-merge-records-outside-closed-originals))
           :stream out :readably t :pretty t) (terpri out)))
(format t \"Post-merge records retained with byte and SHA256 comparison.~%\")
"
 :LIMITS
 (:COMPLETED-FILE-SNAPSHOTS :NOT-ATOMIC-FILESYSTEM-PROOF
  :POST-MERGE-RECORDS-OUTSIDE-CLOSED-ORIGINALS))
