;;;; C4: same-process CPU/allocation isolation, prepared immutable frame; excludes transport and whole-byte comparison.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/local")
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(dolist (size '(1024 60000))
  (let* ((doc (make-array size :element-type '(unsigned-byte 8) :initial-element 117))
         (buffer (make-array 65540 :element-type '(unsigned-byte 8)))
         (target (make-array 60000 :element-type '(unsigned-byte 8))) (space (arcdocdb.cbor:crea-spazio-cbor)))
    (setf (aref doc 0) #x59 (aref doc 1) (ldb (byte 8 8) (- size 3)) (aref doc 2) (ldb (byte 8 0) (- size 3)))
    (let* ((end (arcdocdb.local:encode-local-response buffer 1 0 :found t :document doc))
           (env (arcdocdb.local:decode-local-envelope buffer 4 end :space space)))
      (dolist (api '(:copy :into))
        (sb-ext:gc :full t)
        (let ((cpu (get-internal-run-time)) (wall (get-internal-real-time))
              (before (sb-ext:get-bytes-consed)) (gc sb-ext:*gc-run-time*))
          (dotimes (i 2000)
            (if (eq api :copy)
                (multiple-value-bind (status value) (arcdocdb.local:decode-local-response buffer env space 2)
                  (assert (eq status :found)) (assert (= size (length value)))
                  (assert (= (aref doc (1- size)) (aref value (1- size)))))
                (multiple-value-bind (status count) (arcdocdb.local::decode-local-get-into buffer env space target 0)
                  (assert (eq status :found)) (assert (= size count))
                  (assert (= (aref doc (1- size)) (aref target (1- size)))))))
          (format t "~S~%" (list :kind :buffered-codec-cost :api api :document-bytes size :operations 2000
            :cpu-ticks (- (get-internal-run-time) cpu) :wall-ticks (- (get-internal-real-time) wall)
            :allocated-bytes (- (sb-ext:get-bytes-consed) before) :gc-cpu-ticks (- sb-ext:*gc-run-time* gc)
            :ticks-per-second internal-time-units-per-second)))))))
