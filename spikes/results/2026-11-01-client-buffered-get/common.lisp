;;;; C4 only: bounded histogram adapter and exact nearest-rank oracle.
(defpackage #:unix-latency
  (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:e #:arcdocdb.engine) (#:m #:arcdocdb.metrics)
                    (#:io #:arcdocdb.io)))
(in-package #:unix-latency)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth &optional (reason :oracle))
  (unless truth (error "Unix latency oracle failed: ~S" reason)) truth)
(defun histogram (domain)
  (m:crea-istogramma
    (m:crea-configurazione-istogramma :bit-precisione 7 :massimo (* 60 internal-time-units-per-second)
      :limite-campioni 10000000 :unita :tick :tick-al-secondo internal-time-units-per-second :dominio domain)))
(defun record-ticks (hist ticks)
  (ensure (eq :recorded (m:registra-latenza hist ticks)) :histogram-range))
(defun histogram-row (hist &optional raw)
  (let* ((snapshot (m:istantanea-istogramma hist)) (count (m:istantanea-latenze-campioni snapshot))
         (sorted (when raw (sort (copy-seq raw) #'<))))
    (ensure (not (m:istantanea-latenze-saturata-p snapshot)))
    (when raw (ensure (= count (length raw))))
    (list :count count :max (m:istantanea-latenze-massimo-osservato snapshot)
          :unit :tick :ticks-per-second internal-time-units-per-second
          :quantiles (loop for rank in '(500 950 990 999) collect
            (multiple-value-bind (lo hi status complete) (m:percentile-latenza snapshot rank)
              (ensure complete)
              (ensure (eq status (if (zerop count) :empty :ok)))
              (let ((exact (when sorted (aref sorted (1- (ceiling (* count rank) 1000))))))
                (when exact (ensure (<= lo exact hi) :quantile))
                (list :per-thousand rank :lower lo :upper hi :exact exact :status status :complete complete)))))))
(defun save-new (path form)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :error)
    (with-standard-io-syntax (write form :stream out :readably t :pretty nil) (terpri out))) form)
(defun emit-row (form &optional (stream *standard-output*))
  (with-standard-io-syntax (write form :stream stream :readably t :pretty nil) (terpri stream) (finish-output stream)))
