;;;; C4: independent paired windows and same-thread allocation ledgers; no product library loaded.
(with-open-file (in (merge-pathnames "analyze.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing analysis entry"))
    (when (and (consp form) (eq (first form) 'let)) (return)) (eval form)))
(in-package #:buffered-get-analysis)
(defun checked-copies (copies)
  (dolist (copy copies)
    (ensure (arcdocdb.evidence:call-with-evidence-bytes (getf copy :target)
              (lambda (file) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 file)))) :copied-bytes)))
(defun paired-campaign (name)
  (let* ((root (merge-pathnames (uiop:ensure-directory-pathname name) *here*))
         (start (data (merge-pathnames "started.lisp" root))) (done (data (merge-pathnames "completed.lisp" root)))
         (small (equal "--self-test" (first (getf done :command)))) (cases (if small 2 8))
         (repeats (if small 2 5)) (rounds (if small 20 500)) (all nil) (seen nil) (operations 0))
    (ensure (and (eq :passed (getf done :status)) (= cases (getf done :cases)) (= (* cases repeats 2) (getf done :windows))))
    (loop for file in '("paired.lisp" "bench.lisp" "server.lisp" "common.lisp")
          for field in '(:paired-sha256 :driver-sha256 :server-sha256 :common-sha256) do
      (ensure (string= (getf start field) (arcdocdb.evidence:file-sha256 (merge-pathnames file *here*))) :paired-driver))
    (checked-copies (getf done :copies))
    (loop for stage from 1 to cases do
      (let ((left nil) (right nil) (pairs nil) (case-key nil))
        (dotimes (rep repeats)
          (let* ((copy (data (merge-pathnames (format nil "windows/~D-~D-COPY.lisp" stage rep) root)))
                 (into (data (merge-pathnames (format nil "windows/~D-~D-INTO.lisp" stage rep) root))))
            (dolist (row (list copy into))
              (ensure (and (valid-row row rounds) (= rep (getf row :window)) (eq :api (getf row :latency-scope))) :paired-row)
              (incf operations (getf row :operations)))
            (ensure (and (eq :copy (getf copy :api)) (eq :into (getf into :api)) (equal (key copy) (key into))) :pair)
            (if case-key (ensure (equal case-key (key copy))) (setf case-key (key copy)))
            (let ((a (summary copy)) (b (summary into)))
              (push a left) (push b right)
              (push (list :window rep :gain (/ (getf b :ops-per-second) (getf a :ops-per-second))
                          :allocation-ratio (when (plusp (getf a :bytes-per-op)) (/ (getf b :bytes-per-op) (getf a :bytes-per-op)))) pairs))))
        (ensure (not (member case-key seen :test #'equal))) (push case-key seen)
        (push (list :key case-key :copy (reverse left) :into (reverse right) :pairs (reverse pairs)
                    :paired-median-gain (median (mapcar (lambda (r) (getf r :gain)) pairs))
                    :copy-median-MB-per-second (median (mapcar (lambda (r) (getf r :MB-per-second)) left))
                    :into-median-MB-per-second (median (mapcar (lambda (r) (getf r :MB-per-second)) right))
                    :copy-median-bytes-per-op (median (mapcar (lambda (r) (getf r :bytes-per-op)) left))
                    :into-median-bytes-per-op (median (mapcar (lambda (r) (getf r :bytes-per-op)) right))
                    :copy-gc-cpu-ms (reduce #'+ left :key (lambda (r) (getf r :gc-cpu-ms)))
                    :into-gc-cpu-ms (reduce #'+ right :key (lambda (r) (getf r :gc-cpu-ms)))) all)))
    (ensure (= operations (getf done :operations) (if small 240 180000)))
    (list :kind :buffered-paired-analysis :status :passed :operations operations :cases (reverse all))))
(defun allocation-campaign ()
  (let* ((root (merge-pathnames "allocation/" *here*)) (start (data (merge-pathnames "started.lisp" root)))
         (done (data (merge-pathnames "completed.lisp" root))) (rows (getf done :rows)) (all nil) (seen nil))
    (ensure (and (eq :passed (getf done :status)) (= 4 (getf done :cases)) (= 40 (getf done :windows) (length rows))
                 (= 20000 (getf done :operations))
                 (string= (getf start :driver-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "allocation.lisp" *here*)))))
    (checked-copies (getf done :copies))
    (dolist (row rows)
      (let ((id (mapcar (lambda (field) (getf row field)) '(:mode :document-bytes :api :window))))
        (ensure (not (member id seen :test #'equal))) (push id seen))
      (ensure (and (= 500 (getf row :operations)) (member (getf row :document-bytes) '(1024 60000))
                   (member (getf row :api) '(:copy :into)) (member (getf row :mode) '(:resident :paged))
                   (<= 0 (getf row :window) 4) (not (minusp (getf row :allocated-bytes))) (not (minusp (getf row :gc-cpu-ticks))))))
    (dolist (mode '(:resident :paged)) (dolist (bytes '(1024 60000))
      (let* ((selected (remove-if-not (lambda (row) (and (eq mode (getf row :mode)) (= bytes (getf row :document-bytes)))) rows))
             (copy (remove-if-not (lambda (row) (eq :copy (getf row :api))) selected))
             (into (remove-if-not (lambda (row) (eq :into (getf row :api))) selected))
             (a (median (mapcar (lambda (row) (/ (getf row :allocated-bytes) 500d0)) copy)))
             (b (median (mapcar (lambda (row) (/ (getf row :allocated-bytes) 500d0)) into))))
        (ensure (and (= 5 (length copy) (length into)) (< b 4096) (>= (- a b) (* bytes 0.9d0))) :allocation-slope)
        (push (list :mode mode :document-bytes bytes :copy-bytes-per-op a :into-bytes-per-op b :remaining-ratio (/ b a)) all))))
    (list :kind :buffered-allocation-analysis :status :passed :cases (reverse all))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((and (= 2 (length args)) (equal (first args) "--paired"))
      (let ((result (paired-campaign (second args))))
        (save-new (format nil "~A-analysis.lisp" (string-right-trim "/" (second args))) result)
        (dolist (case (getf result :cases))
          (format t "~S: paired ~,3Fx, ~,2F -> ~,2F MB/s, ~,1F -> ~,1F B/op, GC CPU ~,2F -> ~,2F ms~%"
                  (getf case :key) (getf case :paired-median-gain) (getf case :copy-median-MB-per-second)
                  (getf case :into-median-MB-per-second) (getf case :copy-median-bytes-per-op) (getf case :into-median-bytes-per-op)
                  (getf case :copy-gc-cpu-ms) (getf case :into-gc-cpu-ms)))
        (format t "~S~%" '(:kind :buffered-paired-analysis :status :passed))))
    ((equal args '("--allocation"))
      (let ((result (allocation-campaign)))
        (save-new "allocation-analysis.lisp" result)
        (dolist (case (getf result :cases))
          (format t "~S/~D: ~,2F -> ~,2F B/op, remaining ~,3F%~%" (getf case :mode) (getf case :document-bytes)
                  (getf case :copy-bytes-per-op) (getf case :into-bytes-per-op) (* 100 (getf case :remaining-ratio))))
        (format t "~S~%" '(:kind :buffered-allocation-analysis :status :passed))))
    (t (error "Use --paired campaign/ or --allocation"))))
