;;;; C4: exact base/current inventories, immutable runtime comparison and terminal qualification.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:buffered-get-verification (:use #:cl))
(in-package #:buffered-get-verification)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :identity)) (unless truth (error "Buffered qualification: ~S" reason)) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun qualified (record marker)
  (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
       (eql 0 (getf record :exit-code)) (consp (getf record :source-blobs-after))
       (equal (getf record :source-blobs-before) (getf record :source-blobs-after))
       (search marker (getf record :stdout))))
(defun current ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                       (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                           :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-trim '(#\Newline #\Return)
                    (uiop:run-program (append '("git" "hash-object" "--") paths) :output :string)) :separator '(#\Newline))))
    (ensure (= (length paths) (length hashes)))
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(defun base ()
  (sort (loop for line in (uiop:split-string
           (uiop:run-program '("git" "ls-tree" "-r" "--full-tree" "--format=%(objectname)%x09%(path)"
                               "d8b976ba9e5cddaad39dace43f5a4618abcf3300") :output :string) :separator '(#\Newline))
         when (plusp (length line))
         unless (uiop:string-prefix-p "spikes/results/" (subseq line 41))
         collect (list :path (subseq line 41) :git-blob (subseq line 0 40))) #'string< :key (lambda (r) (getf r :path))))
(defun runtime (sources)
  (remove-if-not (lambda (r) (or (equal (getf r :path) "arcdocdb.asd") (uiop:string-prefix-p "src/" (getf r :path)))) sources))
(defun command (name marker)
  (let ((record (data (merge-pathnames (format nil "commands/~A/report.lisp" name) *here*))))
    (ensure (qualified record marker) name) record))
(defun core (sources)
  (remove-if-not (lambda (row) (let ((path (getf row :path)))
                    (and (uiop:string-prefix-p "src/" path) (not (uiop:string-prefix-p "src/local/" path))))) sources))
(defun changed-runtime (before after)
  (let ((paths (sort (remove-duplicates (mapcar (lambda (r) (getf r :path)) (append (runtime before) (runtime after))) :test #'equal) #'string<)))
    (loop for path in paths
          for a = (find path before :key (lambda (r) (getf r :path)) :test #'equal)
          for b = (find path after :key (lambda (r) (getf r :path)) :test #'equal)
          unless (equal a b) collect path)))
(defun selected-coverage (name)
  (let* ((root (merge-pathnames (uiop:ensure-directory-pathname name) *here*))
         (start (data (merge-pathnames "started.lisp" root))) (done (data (merge-pathnames "completed.lisp" root))) (seen nil))
    (ensure (and (eq :passed (getf done :status)) (= 8 (getf done :suites)) (= 267 (getf done :cases))
                 (equal (getf start :planned) (getf done :passed))))
    (with-open-file (in (merge-pathnames "events.lisp" root))
      (let ((*read-eval* nil))
        (dotimes (i (getf done :cases))
          (let ((begin (read in nil :eof)) (end (read in nil :eof)))
            (ensure (and (eq :started (getf begin :kind)) (eq :passed (getf end :kind))
                         (equal (getf begin :id) (getf end :id))))
            (push (getf end :id) seen)))
        (ensure (eq :eof (read in nil :eof)))))
    (ensure (equal (sort seen #'string<) (getf done :passed))) done))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let ((record '(:status :ok :source-consistency :stable :exit-code 0 :source-blobs-before (one) :source-blobs-after (one) :stdout "DONE")))
        (ensure (qualified record "DONE"))
        (dolist (change '((:status :running) (:source-consistency :changed) (:exit-code 1) (:source-blobs-after (two)) (:stdout "unfinished")))
          (let ((bad (copy-list record))) (setf (getf bad (first change)) (second change)) (ensure (not (qualified bad "DONE"))))))
      (ensure (equal '((:path "src/engine/read.lisp" :git-blob "x"))
                     (core '((:path "src/engine/read.lisp" :git-blob "x") (:path "src/local/client.lisp" :git-blob "y")))))
      (format t "~S~%" '(:kind :buffered-identity-self-test :status :passed :negatives 5 :core-fixture :passed)))
    ((equal args '("--run"))
      (let* ((sources (current)) (original (base))
             (inherited (data #p"spikes/results/2026-11-01-disjoint-read-groups/source-identity.lisp")) (receipts nil))
        (ensure (and (eq :passed (getf inherited :status)) (equal original (getf inherited :sources))) :inherited-base)
        (ensure (equal (core original) (core sources)) :unchanged-engine-io-wal-index)
        (ensure (equal (changed-runtime original sources)
                       '("arcdocdb.asd" "src/local/client-get-into.lisp" "src/local/client.lisp" "src/local/package.lisp" "src/local/wire.lisp")) :declared-runtime-delta)
        (ensure (equal original (getf (command "buffered-baseline-final" ":BUFFERED-GET-CAMPAIGN :STATUS :PASSED") :source-blobs-after)) :pre-edit-baseline)
        (dolist (entry '(("buffered-copy-control" ":BUFFERED-GET-CAMPAIGN :STATUS :PASSED")
                         ("buffered-into" ":BUFFERED-GET-CAMPAIGN :STATUS :PASSED")
                         ("buffered-allocation" ":BUFFERED-ALLOCATION-CAMPAIGN :STATUS :PASSED")
                         ("buffered-codec-cost" ":BUFFERED-CODEC-COST")
                         ("buffered-paired-final" ":BUFFERED-PAIRED-CAMPAIGN :STATUS :PASSED")
                         ("buffered-paired-repeat" ":BUFFERED-PAIRED-CAMPAIGN :STATUS :PASSED")
                         ("buffered-qualification-2.6.9" ":BUFFERED-QUALIFICATION :STATUS :PASSED")
                         ("buffered-qualification-2.6.10" ":BUFFERED-QUALIFICATION :STATUS :PASSED")
                         ("buffered-checks" "11 spike completati")
                         ("buffered-documentation" "Public Lisp example passed:")))
          (let ((record (command (first entry) (second entry))))
            (ensure (equal sources (getf record :source-blobs-after)) (first entry))
            (push (list :name (first entry) :status :passed :source-files (length sources) :wall-seconds (getf record :wall-seconds)) receipts)))
        (ensure (equal (getf (selected-coverage "qualification-2.6.9/") :passed)
                       (getf (selected-coverage "qualification-2.6.10/") :passed)) :same-two-runtime-coverage)
        (let ((ci nil))
          (dolist (dir (uiop:subdirectories (merge-pathnames "commands/" *here*)))
            (let ((record (data (merge-pathnames "report.lisp" dir))))
              (when (and (member "tools/ci.lisp" (getf record :command) :test #'equal) (member "self-test" (getf record :command) :test #'equal))
                (ensure (and (qualified record "PASSED") (equal sources (getf record :source-blobs-after))))
                (push (namestring dir) ci))))
          (ensure ci :nested-CI)
          (with-open-file (out (merge-pathnames "source-identity.lisp" *here*) :direction :output :if-exists :error)
            (write (list :kind :buffered-source-identity :status :passed :source-files (length sources) :base-files (length original)
                         :sources sources :receipts (reverse receipts) :nested-ci ci :selected-suites 8 :selected-cases 267
                         :inherited-proof "../2026-11-01-disjoint-read-groups/source-identity.lisp"
                         :limits '(:unchanged-core-inherits-base-qualification :no-new-full-engine-run :local-serial-M1 :not-power-loss)) :stream out :pretty t)
            (terpri out)))
        (format t "~S~%" (list :kind :buffered-source-identity :status :passed :source-files (length sources) :selected-cases 267))))
    (t (error "Use --self-test or --run"))))
