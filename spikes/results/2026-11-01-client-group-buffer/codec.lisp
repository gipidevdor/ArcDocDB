;;;; C4: isolated complete group decoder; immutable prepared frame, no transport/server/envelope allocation.
(require :asdf)
(with-open-file (in (merge-pathnames "bench.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing group benchmark entry"))
    (when (and (consp form) (eq (first form) 'let*)) (return)) (eval form)))
(in-package #:buffered-get-bench)
(dolist (members '(1 8))
  (dolist (size (if (= members 1) '(1024 60000) '(1024 8184)))
    (let* ((docs (group-documents members size)) (total (* members size))
           (buffer (arcdocdb.local.server.tests::rg-into-reply docs)) (space (arcdocdb.cbor:crea-spazio-cbor))
           (env (l:decode-local-envelope buffer 4 (length buffer) :space space))
           (spans (make-array 8 :element-type '(unsigned-byte 64) :initial-element 0))
           (arena (make-array 65536 :element-type '(unsigned-byte 8) :initial-element #xa5))
           (lengths (make-array 8 :element-type '(unsigned-byte 64) :initial-element 999)))
      (dolist (api '(:copy :into))
        (sb-ext:gc :full t)
        (let ((allocated (sb-ext:get-bytes-consed)) (cpu (get-internal-run-time)) (wall (get-internal-real-time))
              (gc sb-ext:*gc-run-time*) (last nil))
          (dotimes (i 5000)
            (if (eq api :copy)
                (progn (setf last (l::decode-local-read-group-response buffer env space spans members)) (ensure (= members (length last))))
                (multiple-value-bind (count used) (l::decode-local-read-group-into buffer env space spans members arena 0 lengths)
                  (ensure (and (= count members) (= used total))))))
          (let ((bytes (- (sb-ext:get-bytes-consed) allocated)) (ticks (- (get-internal-run-time) cpu))
                (elapsed (- (get-internal-real-time) wall)) (gc-ticks (- sb-ext:*gc-run-time* gc)))
            (if (eq api :copy) (check-copy last docs) (check-arena members total arena lengths docs total))
            (u::emit-row (list :kind :group-buffer-codec :status :passed :api api :members members :member-bytes size
                              :operations 5000 :allocated-bytes bytes :cpu-ticks ticks :wall-ticks elapsed :gc-cpu-ticks gc-ticks
                              :ticks-per-second internal-time-units-per-second :scope :isolated-decoder))))))))
