;;;; C4: retain only the completed terminal receipts, without recopying already closed fixture trees.
(require :asdf)
(with-open-file (in (merge-pathnames "archive.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing archive entry"))
    (when (and (consp form) (eq (first form) 'let)) (return)) (eval form)))
(in-package #:cl-user)
(with-open-file (in "tools/compact-evidence.lisp")
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing compaction entry"))
    (when (equal form '(main)) (return))
    (let ((*load-truename* (truename "tools/compact-evidence.lisp"))) (eval form))))
(in-package #:group-buffer-archive)
(let ((args (uiop:command-line-arguments)) (commands nil) (copies nil) (compactions nil))
  (ensure (and (= 1 (length args)) (member (first args) '("closing-archive-data.lisp" "tail-archive-data.lisp") :test #'equal)))
  (ensure (not (probe-file (merge-pathnames (first args) *here*))))
  (dolist (name '("group-buffer-close" "group-buffer-final-archive" "group-buffer-identity-final" "group-buffer-closing-archive"))
    (let* ((source (merge-pathnames (format nil "spikes/out/~A/" name) (truename "./")))
           (record (data (merge-pathnames "report.lisp" source))))
      (unless (eq :running (getf record :status))
        (ensure (and (eq :ok (getf record :status))
                     (eq :stable (getf record :source-consistency))))
        (push (list :name name :status (getf record :status) :source-consistency :stable) commands)
        (setf copies (append copies (copy-directory-tree source (merge-pathnames (format nil "commands/~A/" name) *here*)))))))
  (dolist (copy copies)
    (let ((target (pathname (getf copy :target))))
      (when (and (equal "lisp" (pathname-type target)) (> (arcdocdb.evidence:file-bytes target) 4096)
                 (not (probe-file (pathname (concatenate 'string (namestring target) ".gz")))))
        (push (cl-user::compact-one target) compactions))
      (ensure (hash-matches target (getf copy :sha256)))))
  (let ((target (merge-pathnames (first args) *here*)))
    (with-open-file (out target :direction :output :if-exists :error)
      (write (list :kind :group-buffer-tail-archive :status :passed :commands (reverse commands) :copies copies
                   :compactions compactions :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)) :stream out :pretty t)
      (terpri out))
    (when (> (arcdocdb.evidence:file-bytes target) 4096) (cl-user::compact-one target)))
  (format t "~S~%" (list :kind :group-buffer-tail-archive :status :passed :commands (length commands) :copies (length copies))))
