;;;; C4: independent checked-window and exact-quantile ledger; no product code is loaded.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:buffered-get-analysis (:use #:cl))
(in-package #:buffered-get-analysis)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :ledger)) (unless truth (error "Buffered GET analysis: ~S" reason)) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun save-new (name value)
  (let ((path (merge-pathnames name *here*)))
    (if (probe-file path) (ensure (equalp value (data path)) :repeat-analysis)
        (with-open-file (out path :direction :output :if-exists :error) (write value :stream out :pretty t) (terpri out)))))
(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<)) (n (length sorted)))
    (ensure (plusp n)) (if (oddp n) (nth (floor n 2) sorted) (/ (+ (nth (1- (/ n 2)) sorted) (nth (/ n 2) sorted)) 2d0))))
(defun valid-row (row rounds)
  (handler-case
      (let* ((ticks (getf row :latencies)) (count (getf row :operations)) (wall (getf row :wall-ticks))
             (hist (getf row :histogram)) (sorted (sort (copy-seq ticks) #'<)))
        (and (eq :buffered-get-window (getf row :kind)) (member (getf row :api) '(:copy :into :baseline :candidate))
             (member (getf row :mode) '(:resident :paged)) (member (getf row :document-bytes) '(1024 60000))
             (member (getf row :connections) '(1 2 8)) (= rounds (getf row :rounds))
             (= count (length ticks) (* rounds (getf row :connections))) (plusp wall)
             (= (getf row :returned-bytes) (* count (getf row :document-bytes)))
             (every (lambda (field) (and (integerp (getf row field)) (not (minusp (getf row field)))))
                    '(:cpu-ticks :allocated-bytes :gc-cpu-ticks))
             (plusp (getf row :ticks-per-second)) (every (lambda (n) (and (integerp n) (<= 0 n wall))) ticks)
             (<= (reduce #'+ ticks) (* wall (getf row :connections)))
             (= count (getf hist :count)) (= (reduce #'max ticks) (getf hist :max))
             (eq :tick (getf hist :unit)) (= (getf row :ticks-per-second) (getf hist :ticks-per-second))
             (= 4 (length (getf hist :quantiles)))
             (loop for q in (getf hist :quantiles) for rank in '(500 950 990 999) always
               (let ((exact (aref sorted (1- (ceiling (* count rank) 1000)))))
                 (and (= rank (getf q :per-thousand)) (eq :ok (getf q :status)) (getf q :complete)
                      (= exact (getf q :exact)) (<= (getf q :lower) exact (getf q :upper)))))))
    (error () nil)))
(defun key (row) (mapcar (lambda (field) (getf row field)) '(:mode :document-bytes :connections)))
(defun summary (row)
  (let ((scale (getf row :ticks-per-second)) (ops (getf row :operations)) (wall (getf row :wall-ticks))
        (quantiles (getf (getf row :histogram) :quantiles)))
    (list :window (getf row :window) :ops-per-second (/ (* ops 1d0 scale) wall)
          :MB-per-second (/ (* (getf row :returned-bytes) 1d0 scale) wall 1000000)
          :bytes-per-op (/ (* 1d0 (getf row :allocated-bytes)) ops)
          :cpu-us-per-op (/ (* 1d6 (getf row :cpu-ticks)) ops scale)
          :gc-cpu-ms (/ (* 1000d0 (getf row :gc-cpu-ticks)) scale)
          :p50-us (/ (* 1d6 (getf (first quantiles) :exact)) scale)
          :p99-us (/ (* 1d6 (getf (third quantiles) :exact)) scale))))
(defun campaign (name)
  (let* ((root (merge-pathnames (uiop:ensure-directory-pathname name) *here*))
         (start (data (merge-pathnames "started.lisp" root))) (done (data (merge-pathnames "completed.lisp" root)))
         (small (equal "--self-test" (first (getf done :command)))) (cases (if small 2 8))
         (repeats (if small 2 5)) (rounds (if small 20 500)) (rows nil) (seen nil) (operations 0))
    (ensure (and (eq :passed (getf done :status)) (= cases (getf done :cases)) (= (* cases repeats) (getf done :windows))))
    (let ((drivers (if (probe-file (merge-pathnames "driver-variant/" root)) (merge-pathnames "driver-variant/" root) *here*)))
      (loop for file in '("bench.lisp" "server.lisp" "common.lisp") for field in '(:driver-sha256 :server-sha256 :common-sha256) do
        (ensure (string= (getf start field) (arcdocdb.evidence:file-sha256 (merge-pathnames file drivers))) :driver-identity)))
    (dolist (copy (getf done :copies))
      (ensure (arcdocdb.evidence:call-with-evidence-bytes (getf copy :target)
                (lambda (file) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 file)))) :child-copy))
    (loop for stage from 1 to cases do
      (let* ((raw (loop for rep below repeats collect (data (merge-pathnames (format nil "windows/~D-~D.lisp" stage rep) root))))
             (case-key (key (first raw))) (windows nil))
        (ensure (not (member case-key seen :test #'equal)) :unique-case) (push case-key seen)
        (loop for row in raw for rep from 0 do
          (ensure (and (valid-row row rounds) (= rep (getf row :window))
                       (eq (getf done :api) (getf row :api)) (equal case-key (key row))) :raw-window)
          (incf operations (getf row :operations)) (push (summary row) windows))
        (setf windows (reverse windows))
        (push (list :key case-key :windows windows :median-ops-per-second (median (mapcar (lambda (r) (getf r :ops-per-second)) windows))
                    :median-MB-per-second (median (mapcar (lambda (r) (getf r :MB-per-second)) windows))
                    :median-bytes-per-op (median (mapcar (lambda (r) (getf r :bytes-per-op)) windows))
                    :median-p50-us (median (mapcar (lambda (r) (getf r :p50-us)) windows))
                    :median-p99-us (median (mapcar (lambda (r) (getf r :p99-us)) windows))
                    :total-gc-cpu-ms (reduce #'+ windows :key (lambda (r) (getf r :gc-cpu-ms)))) rows)))
    (ensure (= operations (getf done :operations) (if small 120 90000)) :operation-total)
    (list :kind :buffered-get-analysis :status :passed :api (getf done :api) :runtime (getf done :runtime) :operations operations
          :cases (reverse rows))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let ((row (data (merge-pathnames "baseline/windows/1-0.lisp" *here*))))
        (ensure (valid-row row 500))
        (dolist (field '(:operations :returned-bytes :document-bytes))
          (let ((bad (copy-list row))) (incf (getf bad field)) (ensure (not (valid-row bad 500)))))
        (dolist (field '(:allocated-bytes :cpu-ticks :gc-cpu-ticks))
          (let ((bad (copy-list row))) (setf (getf bad field) -1) (ensure (not (valid-row bad 500)))))
        (let ((bad (copy-list row)) (ticks (copy-seq (getf row :latencies))))
          (incf (aref ticks 0) (1+ (getf row :wall-ticks))) (setf (getf bad :latencies) ticks)
          (ensure (not (valid-row bad 500)))))
      (format t "~S~%" '(:kind :buffered-analysis-self-test :status :passed :negatives 7)))
    ((and (= 2 (length args)) (equal (first args) "--check"))
      (let ((result (campaign (second args))))
        (save-new (format nil "~A-analysis.lisp" (string-right-trim "/" (second args))) result)
        (dolist (case (getf result :cases))
          (format t "~S: ~,1F ops/s, ~,2F MB/s, ~,1F B/op, P50 ~,1F us, P99 ~,1F us, GC CPU ~,2F ms~%"
                  (getf case :key) (getf case :median-ops-per-second) (getf case :median-MB-per-second)
                  (getf case :median-bytes-per-op) (getf case :median-p50-us) (getf case :median-p99-us) (getf case :total-gc-cpu-ms)))
        (format t "~S~%" '(:kind :buffered-get-analysis :status :passed))))
    ((and (= 3 (length args)) (equal (first args) "--compare"))
      (let ((before (campaign (second args))) (after (campaign (third args))) (rows nil))
        (ensure (equal (getf before :runtime) (getf after :runtime)))
        (let ((left (data (merge-pathnames (concatenate 'string (second args) "started.lisp") *here*)))
              (right (data (merge-pathnames (concatenate 'string (third args) "started.lisp") *here*))))
          (dolist (field '(:driver-sha256 :server-sha256 :common-sha256))
            (ensure (equal (getf left field) (getf right field)) :same-comparison-drivers)))
        (loop for left in (getf before :cases) for right in (getf after :cases) do
          (ensure (equal (getf left :key) (getf right :key)))
          (let ((gain (/ (getf right :median-ops-per-second) (getf left :median-ops-per-second)))
                (ratio (/ (getf right :median-bytes-per-op) (getf left :median-bytes-per-op))))
            (push (list :key (getf left :key) :throughput-gain gain :allocation-ratio ratio :before left :after right) rows)
            (format t "~S: ~,3Fx, allocation ~,1F -> ~,1F B/op (~,2F%)~%" (getf left :key) gain
                    (getf left :median-bytes-per-op) (getf right :median-bytes-per-op) (* 100 ratio))))
        (save-new (format nil "comparison-~A.lisp" (string-right-trim "/" (third args)))
                  (list :kind :buffered-get-comparison :status :passed :cases (reverse rows)))
        (format t "~S~%" '(:kind :buffered-get-comparison :status :passed))))
    (t (error "Use --self-test, --check campaign/ or --compare before/ after/"))))
