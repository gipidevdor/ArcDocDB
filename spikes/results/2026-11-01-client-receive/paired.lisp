;;;; C4: immutable base receiver versus product receiver, same parked clients/server and public GET-INTO API.
(require :asdf)
(with-open-file (in (merge-pathnames "bench.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing benchmark entry"))
    (when (and (consp form) (eq (first form) 'let*)) (return)) (eval form)))
(in-package #:buffered-get-bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun immutable-base-receiver ()
  (let ((text (uiop:run-program '("git" "show" "68b79c69a6d8a7df92f2005132b5c24d377af1e7:src/local/client.lisp") :output :string)))
    (with-input-from-string (in text)
      (let ((*read-eval* nil) (*package* (find-package "ARCDOCDB.LOCAL")))
        (loop for form = (read in nil :eof) do
          (when (eq form :eof) (error "Missing immutable base receiver"))
          (when (and (consp form) (eq (first form) 'defun) (eq (second form) 'l::receive-local-client))
            (setf (second form) 'baseline-receive) (eval form) (return (symbol-function 'baseline-receive))))))))
(defun receiver-dispatcher (baseline candidate)
  (let ((selected :warm))
    (values (lambda (client limit until)
              ;; A normal one-credit service never sends the next response early. Both cases pay this calibration guard.
              (ensure (= (l::local-client-input-consumed client) (l::local-client-input-received client)) :unexpected-network-suffix)
              (funcall (case selected
                         (:warm (if (oddp (l::local-client-next-id client)) baseline candidate))
                         (:baseline baseline) (:candidate candidate) (otherwise (error "Invalid parked receiver selector")))
                       client limit until))
            (lambda (receiver) (setf selected receiver)))))
(defun receiver-case (runtime mode bytes width stage small select)
  (funcall select :warm)
  (multiple-value-bind (server socket) (launch-server runtime mode stage)
    (let ((key (make-array 1 :element-type '(unsigned-byte 8) :initial-element 42)) (doc (document bytes))
          (workers nil) (rounds (if small 20 500)) (repeats (if small 2 5)) (function (read-adapter :into)))
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect (ensure (= 1 (l:client-put client key doc))) (l:close-local client)))
      (unwind-protect
           (progn
             (setf workers (start-workers socket function key doc width rounds (* 2 repeats))) (ready-workers workers)
             (dotimes (rep repeats)
               (dolist (receiver (if (evenp rep) '(:baseline :candidate) '(:candidate :baseline)))
                 (funcall select receiver)
                 (let ((row (sample workers receiver mode bytes rounds rep)))
                   (u::save-new (merge-pathnames (format nil "windows/~D-~D-~A.lisp" stage rep receiver) *output*) row)
                   (push (list :stage stage :window rep :receiver receiver :operations (getf row :operations)) *rows*)))))
        (when workers (stop-workers workers)))
      (loop for worker across workers do (ensure (not (worker-error worker)) (worker-error worker)))
      (ensure (every (lambda (worker) (eql 1 (worker-token worker))) workers) :receiver-versions)
      (p::stop-server server sb-posix:sigterm :receiver-completed))))
(let* ((args (uiop:command-line-arguments)) (small (equal (first args) "--self-test"))
       (*output* (merge-pathnames (uiop:ensure-directory-pathname (second args)) *here*))
       (*copies* nil) (*rows* nil) (stage 0) (finish (symbol-function 'p::finish-children))
       (original (symbol-function 'l::receive-local-client)) (baseline (immutable-base-receiver)))
  (ensure (and (= 2 (length args)) (member (first args) '("--self-test" "--run") :test #'equal) (not (probe-file *output*))))
  (check-validator)
  (u::save-new (merge-pathnames "started.lisp" *output*)
    (list :kind :client-receivers-started :runtime (lisp-implementation-version) :command args
          :public-API :client-get-into :receiver-labels '(:baseline :candidate) :base-commit "68b79c69a6d8a7df92f2005132b5c24d377af1e7"
          :base-client-blob (string-trim '(#\Newline) (uiop:run-program '("git" "rev-parse" "68b79c69:src/local/client.lisp") :output :string))
          :paired-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
          :driver-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" *here*))
          :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "server.lisp" *here*))
          :common-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "common.lisp" *here*))))
  (multiple-value-bind (dispatcher select) (receiver-dispatcher baseline original)
    (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
    (unwind-protect
         (progn
           (setf (symbol-function 'l::receive-local-client) dispatcher)
           (p::call-with-run
            (lambda ()
              (let ((runtime (p::subdirectory "runtime/")))
                (if small
                    (progn (receiver-case runtime :resident 1024 1 (incf stage) t select)
                           (receiver-case runtime :paged 60000 2 (incf stage) t select))
                    (dolist (mode '(:resident :paged)) (dolist (bytes '(1024 60000)) (dolist (width '(1 8))
                      (receiver-case runtime mode bytes width (incf stage) nil select)))))))))
      (setf (symbol-function 'l::receive-local-client) original (symbol-function 'p::finish-children) finish)))
  (u::save-new (merge-pathnames "completed.lisp" *output*)
    (list :kind :client-receivers-campaign :status :passed :cases stage :windows (length *rows*)
          :runtime (lisp-implementation-version) :command args :operations (loop for row in *rows* sum (getf row :operations))
          :copies (reverse *copies*)))
  (u::emit-row (list :kind :client-receivers-campaign :status :passed :cases stage :windows (length *rows*))))
