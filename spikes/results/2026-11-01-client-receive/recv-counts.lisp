;;;; C4: native-call diagnostic outside timing, exact full-byte checks on public calls.
(require :asdf)
(with-open-file (in (merge-pathnames "bench.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing benchmark entry"))
    (when (and (consp form) (eq (first form) 'let*)) (return)) (eval form)))
(in-package #:buffered-get-bench)
(let* ((args (uiop:command-line-arguments))
       (*output* (merge-pathnames (uiop:ensure-directory-pathname (first args)) *here*))
       (*copies* nil) (finish (symbol-function 'p::finish-children)) (stage 0) (rows nil))
  (ensure (and (= 1 (length args)) (not (probe-file *output*))))
  (check-validator)
  (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
  (unwind-protect
       (p::call-with-run
        (lambda ()
          (let ((runtime (p::subdirectory "runtime/")))
            (dolist (mode '(:resident :paged)) (dolist (size '(1024 60000))
              (multiple-value-bind (server socket) (launch-server runtime mode (incf stage))
                (let* ((calls 0) (progress 0) (waits 0) (received 0)
                       (backend (l::make-native-backend :recv
                         (lambda (fd buffer start count)
                           (incf calls)
                           (multiple-value-bind (n errno) (l::%native-recv-span fd buffer start count)
                             (cond ((plusp n) (incf progress) (incf received n))
                                   ((and (= n -1) (member errno (list sb-posix:eagain sb-posix:ewouldblock sb-posix:eintr))) (incf waits))
                                   (t (error "Unexpected native result ~S/~S" n errno)))
                             (values n errno)))))
                       (client (l:connect-local (namestring socket) :io-backend backend :versions t))
                       (key (make-array 1 :element-type '(unsigned-byte 8) :initial-element 42))
                       (target (make-array 60000 :element-type '(unsigned-byte 8))) (doc (document size))
                       (function (read-adapter :into)))
                  (unwind-protect
                       (progn
                         (ensure (= 1 (l:client-put client key doc)))
                         (dotimes (i 100) (checked-read function client key target doc))
                         (setf calls 0 progress 0 waits 0 received 0)
                         (dotimes (i 500) (checked-read function client key target doc))
                         (push (list :mode mode :document-bytes size :operations 500 :recv-calls calls
                                     :progress-calls progress :wait-calls waits :received-bytes received) rows)
                         (ensure (= 602 (l::local-client-next-id client)))
                         (multiple-value-bind (status value token) (l:client-get-version client key)
                           (ensure (and (eq status :found) (equalp value doc) (= 1 token)))))
                    (l:close-local client)))
                (p::stop-server server sb-posix:sigterm :recv-counts-completed)))))))
    (setf (symbol-function 'p::finish-children) finish))
  (let ((record (list :kind :client-recv-counts :status :passed :rows (reverse rows)
                      :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                      :limits '(:diagnostic-not-timing :native-injection :local-hot-key))))
    (u::save-new (merge-pathnames "completed.lisp" *output*) record)
    (u::emit-row record)))
