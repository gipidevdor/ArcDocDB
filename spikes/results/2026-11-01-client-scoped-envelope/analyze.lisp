;;;; C4: independent raw-ledger, driver, byte-copy and exact nearest-rank verification. No product loaded.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:scoped-envelope-analysis (:use #:cl))
(in-package #:scoped-envelope-analysis)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :ledger)) (unless truth (error "Group buffer ledger: ~S" reason)) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun save-new (name form)
  (let ((path (merge-pathnames name *here*)))
    (if (probe-file path) (ensure (equalp form (data path)))
        (with-open-file (out path :direction :output :if-exists :error) (write form :stream out :pretty t) (terpri out)))))
(defun median (numbers)
  (let* ((sorted (sort (copy-list numbers) #'<)) (n (length sorted)))
    (ensure (plusp n)) (if (oddp n) (nth (floor n 2) sorted) (/ (+ (nth (1- (/ n 2)) sorted) (nth (/ n 2) sorted)) 2d0))))
(defun case-key (row) (mapcar (lambda (field) (getf row field)) '(:mode :members :member-bytes :connections)))
(defun valid-row (row rounds small)
  (handler-case
      (let* ((members (getf row :members)) (bytes (getf row :member-bytes)) (ops (getf row :operations))
             (width (getf row :connections)) (wall (getf row :wall-ticks)) (ticks (getf row :latencies))
             (hist (getf row :histogram)) (sorted (sort (copy-seq ticks) #'<)))
        (and (eq :scoped-envelope-window (getf row :kind)) (eq :public-call-adapter (getf row :latency-scope))
             (member (getf row :api) '(:heap :scoped)) (member (getf row :mode) '(:resident :paged))
             (member members '(1 8)) (member width (if small '(1 2 8) '(1 8)))
             (or (= bytes 1024) (= (* members bytes) 60000))
             (= rounds (getf row :rounds)) (= ops (* width rounds) (length ticks))
             (= (getf row :payload-bytes) (* members bytes)) (= (getf row :documents) (* members ops))
             (= (getf row :returned-bytes) (* members bytes ops)) (plusp wall)
             (every (lambda (field) (and (integerp (getf row field)) (not (minusp (getf row field)))))
                    '(:cpu-ticks :allocated-bytes :gc-cpu-ticks))
             (plusp (getf row :ticks-per-second)) (every (lambda (n) (and (integerp n) (<= 0 n wall))) ticks)
             (<= (reduce #'+ ticks) (* wall width))
             (= ops (getf hist :count)) (= (reduce #'max ticks) (getf hist :max))
             (eq :tick (getf hist :unit)) (= (getf row :ticks-per-second) (getf hist :ticks-per-second))
             (= 4 (length (getf hist :quantiles)))
             (loop for q in (getf hist :quantiles) for rank in '(500 950 990 999) always
               (let ((exact (aref sorted (1- (ceiling (* ops rank) 1000)))))
                 (and (= rank (getf q :per-thousand)) (eq :ok (getf q :status)) (getf q :complete)
                      (= exact (getf q :exact)) (<= (getf q :lower) exact (getf q :upper)))))))
    (error () nil)))
(defun summary (row)
  (let* ((scale (getf row :ticks-per-second)) (ops (getf row :operations))
         (throughput (/ (* ops 1d0 scale) (getf row :wall-ticks))) (quants (getf (getf row :histogram) :quantiles)))
    (list :window (getf row :window) :groups-per-second throughput :documents-per-second (* (getf row :members) throughput)
          :MB-per-second (/ (* (getf row :payload-bytes) throughput) 1d6)
          :bytes-per-group (/ (getf row :allocated-bytes) (* 1d0 ops))
          :cpu-us-per-group (/ (* (getf row :cpu-ticks) 1d6) ops scale)
          :gc-cpu-ms (/ (* 1000d0 (getf row :gc-cpu-ticks)) scale)
          :p50-us (/ (* 1d6 (getf (first quants) :exact)) scale) :p99-us (/ (* 1d6 (getf (third quants) :exact)) scale))))
(defun campaign (name)
  (let* ((root (merge-pathnames (uiop:ensure-directory-pathname name) *here*))
         (started (data (merge-pathnames "started.lisp" root))) (done (data (merge-pathnames "completed.lisp" root)))
         (small (equal "--self-test" (first (getf done :command)))) (paired (equal "paired" (second (getf done :command))))
         (rounds (if small 20 5000)) (reps (if small 2 5)) (cases (if small 2 16)) (APIs (if paired '(:heap :scoped) '(:heap)))
         (seen nil) (rows nil) (operations 0) (documents 0))
    (ensure (and (eq :passed (getf done :status)) (= cases (getf done :cases)) (= rounds (getf started :rounds))
                 (= (* cases reps (length APIs)) (getf done :windows))))
    (loop for file in '("bench.lisp" "transport.lisp" "server.lisp" "common.lisp" "base-client.lisp.source")
          for key in '(:driver-sha256 :transport-sha256 :server-sha256 :common-sha256 :base-finisher-sha256) do
      (ensure (string= (getf started key) (arcdocdb.evidence:file-sha256 (merge-pathnames file *here*))) :driver))
    (dolist (copy (getf done :copies))
      (ensure (arcdocdb.evidence:call-with-evidence-bytes (getf copy :target)
                (lambda (file) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 file)))) :child-copy))
    (loop for stage from 1 to cases do
      (let ((key nil) (a nil) (b nil) (pairs nil))
        (dotimes (rep reps)
          (let ((pair nil))
            (dolist (api APIs)
              (let ((row (data (merge-pathnames (format nil "windows/~D-~D-~A.lisp" stage rep api) root))))
                (ensure (and (valid-row row rounds small) (= rep (getf row :window)) (eq api (getf row :api))) :window)
                (if key (ensure (equal key (case-key row))) (setf key (case-key row)))
                (incf operations (getf row :operations)) (incf documents (getf row :documents))
                (let ((one (summary row))) (push one pair) (if (eq api :heap) (push one a) (push one b)))))
            (when paired
              (let ((left (second pair)) (right (first pair)))
                (push (list :window rep :throughput-ratio (/ (getf right :groups-per-second) (getf left :groups-per-second))
                            :allocation-ratio (when (plusp (getf left :bytes-per-group))
                                                (/ (getf right :bytes-per-group) (getf left :bytes-per-group)))) pairs)))))
        (ensure (not (member key seen :test #'equal)) :unique-case) (push key seen)
        (push (list :key key :heap (reverse a) :scoped (reverse b) :pairs (reverse pairs)
                    :median-throughput-ratio (when paired (median (mapcar (lambda (p) (getf p :throughput-ratio)) pairs)))
                    :heap-MB-per-second (if small nil (median (mapcar (lambda (r) (getf r :MB-per-second)) a)))
                    :scoped-MB-per-second (when (and paired (not small)) (median (mapcar (lambda (r) (getf r :MB-per-second)) b)))
                    :heap-bytes-per-group (if small nil (median (mapcar (lambda (r) (getf r :bytes-per-group)) a)))
                    :scoped-bytes-per-group (when (and paired (not small)) (median (mapcar (lambda (r) (getf r :bytes-per-group)) b)))) rows)))
    (ensure (= operations (getf done :operations) (* (if small 120 1800000) (if paired 2 1))) :operations)
    (ensure (= documents (* (if small 680 8100000) (if paired 2 1))) :document-total)
    (list :kind :scoped-envelope-analysis :status :passed :groups operations :documents documents :paired paired :cases (reverse rows))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let ((row (data (merge-pathnames "smoke-before/windows/1-0-HEAP.lisp" *here*))))
        (ensure (valid-row row 20 t))
        (dolist (field '(:operations :returned-bytes :documents :payload-bytes))
          (let ((bad (copy-list row))) (incf (getf bad field)) (ensure (not (valid-row bad 20 t)))))
        (dolist (field '(:cpu-ticks :allocated-bytes :gc-cpu-ticks))
          (let ((bad (copy-list row))) (setf (getf bad field) -1) (ensure (not (valid-row bad 20 t)))))
        (let ((bad (copy-list row)) (ticks (copy-seq (getf row :latencies))))
          (incf (aref ticks 0) (1+ (getf row :wall-ticks))) (setf (getf bad :latencies) ticks)
          (ensure (not (valid-row bad 20 t)))))
      (format t "~S~%" '(:kind :scoped-envelope-analysis-self-test :status :passed :negatives 8)))
    ((and (= 2 (length args)) (equal (first args) "--check"))
      (let ((result (campaign (second args))))
        (save-new (format nil "~A-analysis.lisp" (string-right-trim "/" (second args))) result)
        (dolist (row (getf result :cases))
          (format t "~S: gain ~S, MB/s ~S -> ~S, bytes/group ~S -> ~S~%" (getf row :key) (getf row :median-throughput-ratio)
                  (getf row :heap-MB-per-second) (getf row :scoped-MB-per-second) (getf row :heap-bytes-per-group) (getf row :scoped-bytes-per-group)))
        (format t "~S~%" (list :kind :scoped-envelope-analysis :status :passed :groups (getf result :groups)))))
    (t (error "Use --self-test or --check campaign/"))))
