;;;; C4: grouped public-client output, immutable data, parked owners, complete byte and numeric checks.
(require :asdf)
(with-open-file (in (merge-pathnames "transport.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing transport entry"))
    (when (and (consp form) (eq (first form) 'let*)) (return)) (eval form)))
(in-package #:buffered-get-bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defstruct (group-worker (:include worker)) (api :heap))
(defun group-documents (members size)
  (let ((docs (make-array members)))
    (dotimes (i members) (let ((doc (document size))) (fill doc (+ 65 i) :start 3) (setf (svref docs i) doc))) docs))
(defun group-keys (members)
  (let ((keys (make-array members)))
    (dotimes (i members) (setf (svref keys i) (make-array 1 :element-type '(unsigned-byte 8) :initial-element (1+ i)))) keys))
(defun exact-range-p (expected target start)
  (declare (type (simple-array (unsigned-byte 8) (*)) expected target) (type fixnum start))
  (and (<= 0 start (+ start (length expected)) (length target))
       (dotimes (i (length expected) t) (unless (= (aref expected i) (aref target (+ start i))) (return nil)))))
(defun check-copy (result docs)
  (ensure (and (typep result 'simple-vector) (= (length result) (length docs))) :heap-count)
  (dotimes (i (length docs)) (let ((value (svref result i)))
    (ensure (and (typep value '(simple-array (unsigned-byte 8) (*)))
                 (= (length value) (length (svref docs i))) (exact-range-p (svref docs i) value 0)) :heap-bytes))))
(defun check-arena (count total arena lengths docs expected-total)
  (ensure (and (eql count (length docs)) (eql total expected-total)) :arena-count)
  (let ((cursor 0))
    (dotimes (i (length docs))
      (ensure (= (aref lengths i) (length (svref docs i))) :arena-length)
      (ensure (exact-range-p (svref docs i) arena cursor) :arena-bytes)
      (incf cursor (length (svref docs i)))) (ensure (= cursor expected-total))))
(defun group-canaries (arena lengths docs total)
  (loop for i from total below (length arena) do (ensure (= #xa5 (aref arena i)) :arena-tail))
  (loop for i from (length docs) below (length lengths) do (ensure (= 999 (aref lengths i)) :length-tail)))
(defun group-validator-fixture ()
  (let* ((docs (group-documents 2 16)) (arena (make-array 128 :element-type '(unsigned-byte 8) :initial-element #xa5))
         (lengths (make-array 8 :element-type '(unsigned-byte 64) :initial-element 999)))
    (replace arena (svref docs 0)) (replace arena (svref docs 1) :start1 16)
    (setf (aref lengths 0) 16 (aref lengths 1) 16)
    (check-arena 2 32 arena lengths docs 32) (check-copy docs docs) (group-canaries arena lengths docs 32)
    (flet ((rejects (function) (ensure (handler-case (progn (funcall function) nil) (error () t)))))
      (rejects (lambda () (check-arena 2 31 arena lengths docs 32)))
      (setf (aref lengths 1) 15) (rejects (lambda () (check-arena 2 32 arena lengths docs 32))) (setf (aref lengths 1) 16)
      (incf (aref arena 31)) (rejects (lambda () (check-arena 2 32 arena lengths docs 32))) (decf (aref arena 31))
      (rejects (lambda () (check-copy (vector (svref docs 1) (svref docs 0)) docs))))))
(defparameter *candidate-finish* (symbol-function 'l::finish-local-client-response))
(defun base-finisher ()
  (with-open-file (in (merge-pathnames "base-client.lisp.source" *here*))
    (let ((*read-eval* nil) (*package* (find-package :arcdocdb.local)) (signature nil))
      (loop for form = (read in nil :eof) do
        (when (eq form :eof) (error "Missing immutable base finisher"))
        (when (and (consp form) (eq (first form) 'declaim))
          (dolist (declaration (rest form))
            (when (and (consp declaration) (eq (first declaration) 'ftype)
                       (member 'l::finish-local-client-response (cddr declaration)))
              (setf signature (second declaration)))))
        (when (and (consp form) (eq (first form) 'defun) (eq (second form) 'l::finish-local-client-response))
          (ensure signature :base-function-type)
          (let ((name 'l::%c4-heap-client-response))
            (eval `(declaim (ftype ,signature ,name)))
            (compile name (cons 'lambda (cddr form))) (return (symbol-function name))))))))
(defparameter *heap-finish*
  (if (fboundp 'l::finish-decoded-local-client-response) (base-finisher) *candidate-finish*))
(defun group-call (paired)
  (declare (ignore paired))
  (let ((selected :heap))
    (values (lambda (client keys arena lengths)
              (multiple-value-bind (count total) (l:client-get-group-into client keys arena lengths)
                (values count total selected)))
            (lambda (api)
              ;; All owners are parked at every switch. No live process other than this fixture is changed.
              (setf selected (if (eq api :warm) :heap api)
                    (symbol-function 'l::finish-local-client-response)
                    (ecase selected (:heap *heap-finish*) (:scoped *candidate-finish*)))))))
(defun group-worker-main (worker socket function keys docs total rounds repeats paired)
  (let ((client nil) (arena (make-array 65536 :element-type '(unsigned-byte 8) :initial-element #xa5))
        (lengths (make-array 8 :element-type '(unsigned-byte 64) :initial-element 999)))
    (flet ((validate (first second tag)
             (ensure (or (eq :warm (group-worker-api worker)) (eq tag (group-worker-api worker))) :selected-API)
             (case tag ((:heap :scoped) (check-arena first second arena lengths docs total))
                   (otherwise (error "Invalid group result tag")))))
      (handler-case
          (unwind-protect
               (progn
                 (setf client (l:connect-local (namestring socket) :read-groups t :versions t))
                 (dotimes (i 100) (multiple-value-bind (a b tag) (funcall function client keys arena lengths) (validate a b tag)))
                 (group-canaries arena lengths docs total) (sb-thread:signal-semaphore (worker-done worker))
                 (dotimes (phase (+ 1 repeats (if paired 2 0)))
                   (wait-worker (worker-go worker)) (when (worker-stop worker) (return))
                   (dotimes (i (if (eq :warm (group-worker-api worker)) 100 rounds))
                     (let ((begin (get-internal-real-time)))
                       (multiple-value-bind (a b tag) (funcall function client keys arena lengths)
                         (unless (eq :warm (group-worker-api worker))
                           (setf (aref (worker-ticks worker) i) (- (get-internal-real-time) begin))) (validate a b tag))))
                   (group-canaries arena lengths docs total) (sb-thread:signal-semaphore (worker-done worker)))
                 (ensure (worker-stop worker) :group-window-ceiling)
                 (ensure (= (+ 101 (* rounds repeats) (if paired 200 0)) (l::local-client-next-id client)) :group-ID-count)
                 (dotimes (i (length keys))
                   (multiple-value-bind (status value token) (l:client-get-version client (svref keys i))
                     (ensure (and (eq status :found) (= token (1+ i)) (equalp value (svref docs i))) :group-version)))
                 (setf (worker-token worker) (length keys)))
            (when client (l:close-local client)))
        (error (cause) (setf (worker-error worker) (princ-to-string cause)) (sb-thread:signal-semaphore (worker-done worker)))))))
(defun start-group-workers (socket function keys docs total width rounds repeats paired)
  (let ((workers (make-array width)))
    (dotimes (i width)
      (let ((worker (make-group-worker :api (if paired :warm :heap)
                      :ticks (make-array rounds :element-type '(unsigned-byte 64) :initial-element 0))))
        (setf (aref workers i) worker (worker-thread worker)
              (sb-thread:make-thread (lambda () (group-worker-main worker socket function keys docs total rounds repeats paired)))))) workers))
(defun sample-group (workers api mode members size total rounds rep)
  (loop for worker across workers do (setf (group-worker-api worker) api))
  (sb-ext:gc :full t)
  (let ((wall (get-internal-real-time)) (cpu (get-internal-run-time)) (before (sb-ext:get-bytes-consed)) (gc sb-ext:*gc-run-time*))
    (loop for worker across workers do (sb-thread:signal-semaphore (worker-go worker))) (ready-workers workers)
    (let* ((end (get-internal-real-time)) (cpu-end (get-internal-run-time))
           (allocated (- (sb-ext:get-bytes-consed) before)) (gc-ticks (- sb-ext:*gc-run-time* gc))
           (ticks (make-array (* rounds (length workers)) :element-type '(unsigned-byte 64))) (hist (u::histogram :public-group-get)))
      (loop for worker across workers for start from 0 by rounds do (replace ticks (worker-ticks worker) :start1 start))
      (loop for tick across ticks do (u::record-ticks hist tick))
      (list :kind :scoped-envelope-window :latency-scope :public-call-adapter :api api :mode mode :members members :member-bytes size
            :payload-bytes total :connections (length workers) :window rep :rounds rounds :operations (length ticks)
            :documents (* members (length ticks)) :returned-bytes (* total (length ticks)) :wall-ticks (- end wall)
            :cpu-ticks (- cpu-end cpu) :allocated-bytes allocated :gc-cpu-ticks gc-ticks :ticks-per-second internal-time-units-per-second
            :latencies ticks :histogram (u::histogram-row hist ticks)))))
(defun group-case (runtime mode members size width stage small paired)
  (multiple-value-bind (server socket) (launch-server runtime mode stage)
    (let* ((keys (group-keys members)) (docs (group-documents members size)) (total (* members size))
           (rounds (if small 20 5000)) (repeats (if small 2 5)) (workers nil))
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect (dotimes (i members) (ensure (= (1+ i) (l:client-put client (svref keys i) (svref docs i))))) (l:close-local client)))
      (multiple-value-bind (function select) (group-call paired)
        (funcall select (if paired :warm :heap))
        (unwind-protect
             (progn
               (setf workers (start-group-workers socket function keys docs total width rounds (* repeats (if paired 2 1)) paired))
               (ready-workers workers)
               (when paired
                 (dolist (api '(:heap :scoped))
                   (funcall select api)
                   (loop for worker across workers do (setf (group-worker-api worker) :warm)
                         do (sb-thread:signal-semaphore (worker-go worker)))
                   (ready-workers workers)))
               (dotimes (rep repeats)
                 (dolist (api (if paired (if (evenp rep) '(:heap :scoped) '(:scoped :heap)) '(:heap)))
                   (funcall select api)
                   (let ((row (sample-group workers api mode members size total rounds rep)))
                     (u::save-new (merge-pathnames (format nil "windows/~D-~D-~A.lisp" stage rep api) *output*) row)
                     (push (list :stage stage :window rep :api api :operations (getf row :operations)) *rows*)))))
          (when workers (stop-workers workers))))
      (loop for worker across workers do (ensure (not (worker-error worker)) (worker-error worker)))
      (ensure (every (lambda (worker) (eql members (worker-token worker))) workers) :group-final-CSNs)
      (p::stop-server server sb-posix:sigterm :group-buffer-completed))))
(let* ((args (uiop:command-line-arguments)) (small (equal (first args) "--self-test")) (paired (equal (second args) "paired"))
       (*output* (merge-pathnames (uiop:ensure-directory-pathname (third args)) *here*))
       (*copies* nil) (*rows* nil) (stage 0) (finish (symbol-function 'p::finish-children)))
  (ensure (and (= 3 (length args)) (member (first args) '("--run" "--self-test") :test #'equal)
               (member (second args) '("heap" "paired") :test #'equal) (not (probe-file *output*))))
  (group-validator-fixture)
  (u::save-new (merge-pathnames "started.lisp" *output*)
    (list :kind :scoped-envelope-started :command args :runtime (lisp-implementation-version) :rounds (if small 20 5000)
          :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
          :transport-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "transport.lisp" *here*))
          :base-finisher-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "base-client.lisp.source" *here*))
          :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "server.lisp" *here*))
          :common-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "common.lisp" *here*))))
  (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
  (unwind-protect
       (p::call-with-run (lambda () (let ((runtime (p::subdirectory "runtime/")))
         (if small (progn (group-case runtime :resident 1 1024 1 (incf stage) t paired)
                          (group-case runtime :paged 8 7500 2 (incf stage) t paired))
             (dolist (mode '(:resident :paged)) (dolist (members '(1 8)) (dolist (large '(nil t)) (dolist (width '(1 8))
               (group-case runtime mode members (if large (/ 60000 members) 1024) width (incf stage) nil paired)))))))))
    (setf (symbol-function 'p::finish-children) finish (symbol-function 'l::finish-local-client-response) *candidate-finish*))
  (u::save-new (merge-pathnames "completed.lisp" *output*)
    (list :kind :scoped-envelope-campaign :status :passed :command args :cases stage :windows (length *rows*)
          :operations (loop for row in *rows* sum (getf row :operations)) :copies (reverse *copies*)))
  (u::emit-row (list :kind :scoped-envelope-campaign :status :passed :cases stage :windows (length *rows*))))
