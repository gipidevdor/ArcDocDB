;;;; C4: verified lossless closure, scoped to this one completed campaign.
(require :asdf)
(let ((args (uiop:command-line-arguments)) (here (uiop:pathname-directory-pathname *load-truename*)))
  (flet ((valid (values)
           (handler-case
             (and (= 4 (length values)) (equal (first values) "--root")
                  (equal (nthcdr 2 values) '("--jobs" "1")) (equal (truename (second values)) here))
             (error () nil))))
    (when (equal args '("--self-test"))
      (unless (and (valid (list "--root" (namestring here) "--jobs" "1"))
                   (not (valid '("--root" "/" "--jobs" "1")))
                   (not (valid (list "--root" (namestring here) "--jobs" "4")))
                   (not (valid (list "--root" (namestring here)))))
        (error "Closure scope self-test"))
      (format t "~S~%" '(:kind :scoped-envelope-closure-self-test :status :passed :negatives 3))
      (sb-ext:exit :code 0))
    (unless (valid args) (error "Explicit own result root and one compaction worker required"))))
(load "tools/compact-evidence.lisp")
(defpackage #:scoped-envelope-closure (:use #:cl))
(in-package #:scoped-envelope-closure)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth) (unless truth (error "Grouped buffer evidence closure failed")) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun hash-matches (path hash)
  (or (string= hash (arcdocdb.evidence:file-sha256 path))
      (arcdocdb.evidence:call-with-evidence-bytes path
        (lambda (file) (string= hash (arcdocdb.evidence:file-sha256 file))))))
(defun compact-tree (directory nested)
  (let ((rows nil))
    (dolist (file (uiop:directory-files directory))
      (let ((type (pathname-type file)) (name (file-namestring file)))
        (when (and (not (equal type "gz")) (not (probe-file (pathname (concatenate 'string (namestring file) ".gz"))))
                   (or (and nested (search "/failed-fixtures/" (namestring directory)) (> (arcdocdb.evidence:file-bytes file) 1024))
                       (and (member type '("stdout" "stderr") :test #'equal) (> (arcdocdb.evidence:file-bytes file) 1024))
                       (and (equal type "lisp") (> (arcdocdb.evidence:file-bytes file) 4096)
                            (or nested (member name '("final-archive.lisp" "variant-uninlined.lisp" "source-identity.lisp" "baseline-analysis.lisp"
                               "smoke-before-analysis.lisp" "smoke-final-analysis.lisp" "paired-analysis.lisp" "paired-repeat-analysis.lisp" "paired-final-analysis.lisp") :test #'equal)))))
          (push (cl-user::compact-one file) rows))))
    (dolist (child (uiop:subdirectories directory)) (setf rows (append rows (compact-tree child t)))) rows))
(let ((verified 0) (compactions nil))
  (ensure (eq :passed (getf (data (merge-pathnames "source-identity.lisp" *here*)) :status)))
  (setf compactions (compact-tree *here* nil))
  (dolist (name '("final-archive.lisp" "variant-uninlined.lisp"))
    (let ((record (data (merge-pathnames name *here*))))
      (ensure (eq :passed (getf record :status)))
      (dolist (copy (getf record :copies))
        (ensure (hash-matches (getf copy :target) (getf copy :sha256))) (incf verified))))
  (dolist (directory (uiop:subdirectories *here*))
    (let ((manifest (merge-pathnames "child-copies.lisp" directory)))
      (when (probe-file manifest)
        (dolist (copy (data manifest))
          (ensure (hash-matches (getf copy :target) (getf copy :sha256))) (incf verified)))))
  (let ((record (list :kind :scoped-envelope-evidence-closure :status :passed :universal-time (get-universal-time)
                      :verified-files verified :compactions compactions :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                      :limits '(:own-result-root-only :raw-byte-hashes :verified-lossless-expansion :special-IPC-node-metadata-only
                                :no-negative-fixture-qualification))))
    (with-open-file (out (merge-pathnames "closure.lisp" *here*) :direction :output :if-exists :error)
      (write record :stream out :pretty t) (terpri out))
    (when (> (arcdocdb.evidence:file-bytes (merge-pathnames "closure.lisp" *here*)) 4096)
      (cl-user::compact-one (merge-pathnames "closure.lisp" *here*))))
  (format t "~S~%" (list :kind :scoped-envelope-evidence-closure :status :passed :verified-files verified :compactions (length compactions))))
