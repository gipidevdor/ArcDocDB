;;;; C4: actual complete product envelope validator, persistent negative control and scoped scalar consumer.
(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (c) (unless (typep c 'sb-kernel:redefinition-warning) (error "COD-01: ~A" c)))))
  (asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/tests"))
(load (merge-pathnames "common.lisp" *load-truename*))
(defpackage #:scoped-envelope-codec (:use #:cl) (:local-nicknames (#:l #:arcdocdb.local) (#:u #:unix-latency)))
(in-package #:scoped-envelope-codec)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "Product scoped envelope codec oracle")) truth)
(defun heap-id (buffer space)
  (l:envelope-id (l:decode-local-envelope buffer 4 (length buffer) :space space)))
(defun scoped-id (buffer space)
  (flet ((consume (view) (l:envelope-id view)))
    (declare (dynamic-extent #'consume))
    (l::call-with-local-response-envelope buffer 4 (length buffer) space #'consume)))
(let ((windows 0))
  (dolist (members '(1 8))
    (dolist (size (if (= members 1) '(1024 60000) '(1024 8184)))
      (let* ((docs (make-array members :initial-contents
                    (loop repeat members collect (arcdocdb.local.wire.tests::get-document size))))
             (buffer (arcdocdb.local.server.tests::rg-into-reply docs)) (space (arcdocdb.cbor:crea-spazio-cbor)))
        (dolist (fn (list #'heap-id #'scoped-id)) (dotimes (i 100) (ensure (= 1 (funcall fn buffer space)))))
        (dotimes (rep 5)
          (dolist (mode (if (evenp rep) '(:heap :scoped) '(:scoped :heap)))
            (let ((fn (if (eq mode :heap) #'heap-id #'scoped-id)))
              (sb-ext:gc :full t)
              (let ((before (sb-ext:get-bytes-consed)) (cpu (get-internal-run-time)) (wall (get-internal-real-time))
                    (gc sb-ext:*gc-run-time*) (sum 0))
                (dotimes (i 50000) (incf sum (funcall fn buffer space)))
                (let ((bytes (- (sb-ext:get-bytes-consed) before)) (ticks (- (get-internal-run-time) cpu))
                      (elapsed (- (get-internal-real-time) wall)) (gc-ticks (- sb-ext:*gc-run-time* gc)))
                  (u::emit-row (list :kind :scoped-envelope-codec-window :status :measured :mode mode :members members
                                    :member-bytes size :operations 50000 :window rep :allocated-bytes bytes :cpu-ticks ticks
                                    :wall-ticks elapsed :gc-cpu-ticks gc-ticks :ticks-per-second internal-time-units-per-second))
                  (ensure (= sum 50000)) (ensure (if (eq mode :heap) (plusp bytes) (zerop bytes))) (incf windows)))))))))
  (ensure (= windows 40))
  (u::emit-row (list :kind :scoped-envelope-codec :status :passed :cases 4 :windows windows :operations 2000000)))
