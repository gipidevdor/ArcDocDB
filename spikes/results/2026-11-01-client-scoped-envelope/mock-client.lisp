;;;; C4 allocation diagnostic: complete public PING with prebuilt responses and nonallocating injected I/O.
(with-open-file (in (merge-pathnames "bench.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing benchmark entry"))
    (when (and (consp form) (eq (first form) 'let*)) (return)) (eval form)))
(in-package #:buffered-get-bench)
(defun mock-client (calls)
  (let ((stream (make-array (* calls 16) :element-type '(unsigned-byte 8)))
        (ends (make-array calls :element-type '(unsigned-byte 32))) (out (l::local-buffer))
        (end 0) (cursor 0) (sends 0) (reads 0))
    (dotimes (i calls)
      (let ((size (l:encode-local-response out (1+ i) 0)))
        (replace stream out :start1 end :end1 (+ end size) :end2 size)
        (incf end size) (setf (aref ends i) end)))
    (let* ((backend (l::make-native-backend
                      :send (lambda (fd buffer start count) (declare (ignore fd buffer start))
                              (incf sends) (ensure (<= sends calls)) (values count 0))
                      :recv (lambda (fd buffer start count)
                              (declare (ignore fd)) (ensure (<= 1 sends calls))
                              (let ((n (min count (- (aref ends (1- sends)) cursor))))
                                (ensure (plusp n)) (incf reads)
                                (replace buffer stream :start1 start :end1 (+ start n) :start2 cursor :end2 (+ cursor n))
                                (incf cursor n) (values n 0)))
                      :control (lambda (op args) (declare (ignore op args)) (error "Unexpected mock poll"))))
           (client (l::make-local-client :socket (l::new-local-socket) :state :ready :clock (lambda () 0)
                                        :io-backend backend :waiter (l::make-local-waiter 1 backend))))
      (values client (lambda () (ensure (and (= sends reads calls) (= cursor end)))
                       (ensure (= (1+ calls) (l::local-client-next-id client))))))))
(unwind-protect
     (dolist (mode '(:heap :scoped))
       (setf (symbol-function 'l::finish-local-client-response) (if (eq mode :heap) *heap-finish* *candidate-finish*))
       (multiple-value-bind (client finish) (mock-client 50100)
         (unwind-protect
              (progn
                (dotimes (i 100) (ensure (null (l:client-ping client))))
                (sb-ext:gc :full t)
                (let ((before (sb-ext:get-bytes-consed)))
                  (dotimes (i 50000) (ensure (null (l:client-ping client))))
                  (let ((bytes (- (sb-ext:get-bytes-consed) before)))
                    (u::emit-row (list :kind :scoped-envelope-mock :status :measured :mode mode :operations 50000
                                      :allocated-bytes bytes :scope :injected-public-client-no-real-I/O))
                    (ensure (if (eq mode :heap) (plusp bytes) (zerop bytes)))))
                (funcall finish))
           (l:close-local client))))
  (setf (symbol-function 'l::finish-local-client-response) *candidate-finish*))
(u::emit-row '(:kind :scoped-envelope-mock :status :passed :cases 2))
