;;;; C4: test SAP boxing at the real poll boundary, with disabled private FDs and zero timeout only.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/local")
(defpackage #:scoped-poll-probe (:use #:cl))
(in-package #:scoped-poll-probe)
(declaim (optimize (safety 3) (speed 2) (debug 2)) (inline probe-poll))
(sb-alien:define-alien-routine ("poll" probe-poll) sb-alien:int
  (fds sb-alien:system-area-pointer)
  (count #+darwin sb-alien:unsigned-int #-darwin sb-alien:unsigned-long) (milliseconds sb-alien:int))
(defun inline-poll (buffer count milliseconds)
  (assert (= (length buffer) (* count 8)))
  (sb-sys:with-pinned-objects (buffer)
    (let ((n (probe-poll (sb-sys:vector-sap buffer) count milliseconds)))
      (values n (if (= n -1) (sb-alien:get-errno) 0)))))
(defun ensure (truth) (unless truth (error "Poll boxing probe oracle")) truth)
(dolist (capacity '(1 9))
  (let* ((wait (arcdocdb.io::crea-attesa-io capacity)) (buffer (arcdocdb.io::attesa-io-buffer wait)))
    (dolist (mode '(:original :inline))
      (let ((fn (if (eq mode :original) #'arcdocdb.io::sonde-attesa-native #'inline-poll)))
        (dotimes (i 100) (multiple-value-bind (count errno) (funcall fn buffer capacity 0)
                          (ensure (and (zerop count) (zerop errno)))))
        (sb-ext:gc :full t)
        (let ((before (sb-ext:get-bytes-consed)) (sum 0))
          (dotimes (i 50000)
            (multiple-value-bind (count errno) (funcall fn buffer capacity 0)
              (ensure (and (zerop count) (zerop errno))) (incf sum count)))
          (let ((bytes (- (sb-ext:get-bytes-consed) before)))
            (format t "~S~%" (list :kind :scoped-poll-probe :status :measured :capacity capacity :mode mode
                                  :operations 50000 :allocated-bytes bytes :timeout-ms 0)) (finish-output)
            (ensure (zerop sum)) (ensure (if (eq mode :original) (plusp bytes) (zerop bytes)))))))))
(format t "~S~%" '(:kind :scoped-poll-probe :status :passed :cases 4))
