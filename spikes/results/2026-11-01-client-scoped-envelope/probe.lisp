;;;; C4: controlled source transformation tests complete parser with a non-escaping immutable view.
(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (c) (unless (typep c 'sb-kernel:redefinition-warning) (error "Probe compiler warning: ~A" c)))))
  (asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/local"))
(defpackage #:scoped-envelope-probe (:use #:cl) (:local-nicknames (#:l #:arcdocdb.local)))
(in-package #:scoped-envelope-probe)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "Scoped envelope probe oracle")) truth)
(defun source-function ()
  (with-open-file (in (merge-pathnames "base-wire.lisp.source" *load-truename*))
    (let ((*package* (find-package :arcdocdb.local)) (*read-eval* nil))
      (loop for form = (read in nil :eof) do
        (when (eq form :eof) (error "Missing decoder source"))
        (when (and (consp form) (eq (first form) 'defun) (eq (second form) 'l:decode-local-envelope))
          (return form))))))
(declaim (inline make-boxed-envelope))
(defstruct (boxed-envelope
             (:constructor make-boxed-envelope
               (&key buffer (kind 0) (id 0) (code 0) (payload-start 0) (payload-end 0)
                     (max-frame 0) (max-inflight 0) (write-groups nil) (read-groups nil)
                     (versions nil) (conditional-groups nil) (frame-limit 65536)
                &aux (id-low (ldb (byte 32 0) id)) (id-high (ldb (byte 32 32) id))))
             (:copier nil))
  (buffer nil :type (or null arcdocdb.binary:octets) :read-only t)
  (kind 0 :type (integer 0 3) :read-only t)
  (id-low 0 :type (unsigned-byte 32) :read-only t)
  (id-high 0 :type (unsigned-byte 32) :read-only t)
  (code 0 :type (unsigned-byte 16) :read-only t)
  (payload-start 0 :type arcdocdb.binary:index :read-only t)
  (payload-end 0 :type arcdocdb.binary:index :read-only t)
  (max-frame 0 :type (integer 0 17825792) :read-only t)
  (max-inflight 0 :type (integer 0 16) :read-only t)
  (write-groups nil :type boolean :read-only t)
  (read-groups nil :type boolean :read-only t)
  (versions nil :type boolean :read-only t)
  (conditional-groups nil :type boolean :read-only t)
  (frame-limit 65536 :type (integer 4096 17825792) :read-only t))
(defun boxed-id (env) (logior (ash (boxed-envelope-id-high env) 32) (boxed-envelope-id-low env)))
(defun scoped-function ()
  (let* ((form (source-function)) (consumer (gensym "CONSUMER")) (view (gensym "VIEW")) (found 0))
    (labels ((rewrite (node)
               (cond ((atom node) node)
                     ((eq (first node) 'l::%make-envelope)
                      (incf found)
                      `(let ((,view (make-boxed-envelope ,@(rest node)))) (declare (dynamic-extent ,view)) (funcall ,consumer ,view)))
                     (t (mapcar #'rewrite node)))))
      (let ((body (mapcar #'rewrite (cdddr form))))
        (ensure (= 1 found))
        (compile nil `(lambda (,consumer ,@(third form)) ,@body))))))
(defun public-id (buffer space)
  (l:envelope-id (l:decode-local-envelope buffer 0 (length buffer) :space space)))
(let* ((scoped (scoped-function))
       (buffer (make-array 6 :element-type '(unsigned-byte 8) :initial-contents '(133 1 3 1 0 246)))
       (space (arcdocdb.cbor:crea-spazio-cbor)) (consumer #'boxed-id) (calls 0))
  (ensure (= 1 (funcall scoped consumer buffer 0 6 :space space)))
  (ensure (= 23 (catch 'stop (funcall scoped (lambda (env) (ensure (= 1 (boxed-id env))) (throw 'stop 23))
                                    buffer 0 6 :space space))))
  (setf (aref buffer 0) 132)
  (ensure (handler-case (progn (funcall scoped (lambda (env) (declare (ignore env)) (incf calls)) buffer 0 6 :space space) nil)
            (l:protocol-error () t)))
  (ensure (zerop calls)) (setf (aref buffer 0) 133)
  (dolist (mode '(:heap :scoped))
    (sb-ext:gc :full t)
    (let ((before (sb-ext:get-bytes-consed)) (cpu (get-internal-run-time)) (sum 0))
      (dotimes (i 50000) (incf sum (if (eq mode :heap) (public-id buffer space) (funcall scoped consumer buffer 0 6 :space space))))
      (let ((bytes (- (sb-ext:get-bytes-consed) before)) (ticks (- (get-internal-run-time) cpu)))
        (ensure (= sum 50000))
        
        (format t "~S~%" (list :kind :scoped-envelope-probe :status :measured :mode mode :operations 50000
                              :allocated-bytes bytes :cpu-ticks ticks :ticks-per-second internal-time-units-per-second))
        (finish-output)
        (when (eq mode :scoped) (ensure (zerop bytes)))))))
