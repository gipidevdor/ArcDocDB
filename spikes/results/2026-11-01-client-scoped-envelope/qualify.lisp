;;;; C4: warning-as-error forced local build, exact selected registries and append-only case events.
(require :asdf)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (cause) (unless (typep cause 'sb-kernel:redefinition-warning) (error "COD-01: ~A" cause)))))
  (asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/local" :force t)
  (asdf:load-system "arcdocdb/tests"))
(load (merge-pathnames "common.lisp" *load-truename*))
(let* ((args (uiop:command-line-arguments)) (here (uiop:pathname-directory-pathname *load-truename*))
       (packages '("ARCDOCDB.IO.TESTS" "ARCDOCDB.CBOR.TESTS" "ARCDOCDB.CBOR.MINIMAL.TESTS" "ARCDOCDB.CBOR.STRUCTURE.TESTS"
                   "ARCDOCDB.CBOR.MINIMAL.SCAN.TESTS" "ARCDOCDB.LOCAL.WIRE.TESTS" "ARCDOCDB.LOCAL.NATIVE.TESTS"
                   "ARCDOCDB.LOCAL.SERVER.TESTS" "ARCDOCDB.LOCAL.PROCESS.TESTS"))
       (specs (remove-if-not (lambda (s) (member (getf s :package) packages :test #'equal))
                            (arcdocdb.ci.tests:suite-specifications)))
       (inventory (arcdocdb.ci.tests:discover))
       (planned (sort (loop for row in (getf inventory :tests) when (member (getf row :suite) packages :test #'equal)
                            collect (getf row :id)) #'string<))
       (seen (make-hash-table :test #'equal)) (passed nil))
  (unless (and (= 1 (length args)) (= 9 (length specs)) (eq :ready (getf inventory :status))) (error "Incomplete selected inventory"))
  (let ((root (merge-pathnames (uiop:ensure-directory-pathname (first args)) here)))
    (unless (not (probe-file root)) (error "Qualification output already exists"))
    (unix-latency::save-new (merge-pathnames "started.lisp" root)
      (list :kind :buffered-qualification :status :started :runtime (lisp-implementation-version) :packages packages :planned planned))
    (with-open-file (events (merge-pathnames "events.lisp" root) :direction :output :if-exists :error)
      (flet ((event (kind id) (unix-latency::emit-row (list :kind kind :id id) events)))
        (let ((arcdocdb.ci.tests::*case-observer*
                (lambda (id thunk)
                  (unless (and (member id planned :test #'equal) (not (gethash id seen))) (error "Unexpected/duplicate case ~A" id))
                  (setf (gethash id seen) :started) (event :started id)
                  (multiple-value-prog1 (funcall thunk) (push id passed) (setf (gethash id seen) :passed) (event :passed id)))))
          (dolist (spec specs) (arcdocdb.ci.tests::invoke-suite spec nil)))))
    (unless (equal planned (sort (copy-list passed) #'string<)) (error "Selected case coverage gap"))
    (unix-latency::save-new (merge-pathnames "completed.lisp" root)
      (list :kind :buffered-qualification :status :passed :runtime (lisp-implementation-version) :suites 9 :cases (length passed)
            :passed (sort passed #'string<)))
    (format t "~S~%" (list :kind :buffered-qualification :status :passed :suites 9 :cases (length planned)))))
