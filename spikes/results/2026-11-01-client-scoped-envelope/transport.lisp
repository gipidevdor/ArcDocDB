;;;; C4: bounded public-client campaigns, private client owners and immutable raw windows.
(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(load "tools/evidence-storage.lisp")
(load (merge-pathnames "common.lisp" *load-truename*))
(defpackage #:buffered-get-bench (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:e #:arcdocdb.engine)
                    (#:p #:arcdocdb.local.process.tests) (#:u #:unix-latency)))
(in-package #:buffered-get-bench)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defvar *output*)
(defvar *copies* nil)
(defvar *rows* nil)
(defun ensure (truth &optional (reason :oracle)) (unless truth (error "Buffered GET: ~S" reason)) truth)
(defun document (size)
  (let ((value (make-array size :element-type '(unsigned-byte 8) :initial-element 117)))
    (setf (aref value 0) #x59 (aref value 1) (ldb (byte 8 8) (- size 3)) (aref value 2) (ldb (byte 8 0) (- size 3))) value))
(defun read-adapter (api)
  (if (eq api :copy)
      (lambda (client key target) (declare (ignore target))
        (multiple-value-bind (status value) (l:client-get client key) (values status value (if value (length value) 0))))
      (let ((symbol (find-symbol "CLIENT-GET-INTO" "ARCDOCDB.LOCAL")))
        (ensure (and symbol (fboundp symbol)) :missing-buffered-API)
        (let ((function (symbol-function symbol)))
          (lambda (client key target)
            (multiple-value-bind (status size) (funcall function client key target) (values status target size)))))))
(defun exact-prefix-p (expected value size)
  (declare (type (simple-array (unsigned-byte 8) (*)) expected value) (type fixnum size))
  (and (= (length expected) size) (<= size (length value))
       (dotimes (i size t) (unless (= (aref expected i) (aref value i)) (return nil)))))
(defun checked-value (status value size expected)
  (ensure (and (eq status :found) (= size (length expected)) (exact-prefix-p expected value size)) :checked-document))
(defun checked-read (function client key target expected)
  (multiple-value-bind (status value size) (funcall function client key target) (checked-value status value size expected)))
(defun check-validator ()
  (let ((expected (make-array 8 :element-type '(unsigned-byte 8) :initial-element 1))
        (value (make-array 16 :element-type '(unsigned-byte 8) :initial-element 1)))
    (ensure (exact-prefix-p expected value 8)) (setf (aref value 7) 2)
    (ensure (not (exact-prefix-p expected value 8))) (ensure (not (exact-prefix-p expected value 7)))
    (ensure (not (exact-prefix-p value expected 16)))))
(defstruct worker thread (go (sb-thread:make-semaphore)) (done (sb-thread:make-semaphore)) stop error ticks token)
(defun wait-worker (semaphore)
  (ensure (sb-thread:wait-on-semaphore semaphore :timeout 60) :worker-deadline))
(defun worker-main (worker socket function key expected rounds repeats)
  (let ((client nil) (target (make-array 60000 :element-type '(unsigned-byte 8) :initial-element 0)))
    (handler-case
        (unwind-protect
             (progn
               (setf client (l:connect-local (namestring socket) :versions t))
               (dotimes (i 100) (checked-read function client key target expected))
               (sb-thread:signal-semaphore (worker-done worker))
               (dotimes (phase (1+ repeats))
                 (wait-worker (worker-go worker))
                 (when (worker-stop worker) (return))
                 (dotimes (i rounds)
                   (let ((start (get-internal-real-time)))
                     (multiple-value-bind (status value size) (funcall function client key target)
                       (setf (aref (worker-ticks worker) i) (- (get-internal-real-time) start))
                       (checked-value status value size expected))))
                 (sb-thread:signal-semaphore (worker-done worker)))
               (ensure (worker-stop worker) :window-ceiling)
               (ensure (= (+ 101 (* repeats rounds)) (l::local-client-next-id client)) :client-ID-count)
               (multiple-value-bind (status value token) (l:client-get-version client key)
                 (ensure (and (eq status :found) (equalp value expected) (= 1 token)) :canonical-version)
                 (setf (worker-token worker) token)))
          (when client (l:close-local client)))
      (error (cause) (setf (worker-error worker) (princ-to-string cause))
        (sb-thread:signal-semaphore (worker-done worker)))))
  nil)
(defun start-workers (socket function key expected width rounds repeats)
  (let ((workers (make-array width)))
    (dotimes (i width)
      (let ((worker (make-worker :ticks (make-array rounds :element-type '(unsigned-byte 64) :initial-element 0))))
        (setf (aref workers i) worker (worker-thread worker)
              (sb-thread:make-thread (lambda () (worker-main worker socket function key expected rounds repeats)))))) workers))
(defun ready-workers (workers)
  (loop for worker across workers do (wait-worker (worker-done worker)))
  (loop for worker across workers do (ensure (not (worker-error worker)) (worker-error worker))))
(defun stop-workers (workers)
  (loop for worker across workers do (setf (worker-stop worker) t) (sb-thread:signal-semaphore (worker-go worker)))
  (loop for worker across workers do
    (when (eq :timeout (sb-thread:join-thread (worker-thread worker) :timeout 60 :default :timeout))
      (setf (worker-error worker) "Join deadline"))))
(defun launch-server (runtime mode stage)
  (let* ((data (p::subdirectory (format nil "data-~D/" stage))) (socket (p::socket-path runtime (format nil "s~D.sock" stage)))
         (child (p::launch (format nil "buffered-~D" stage) :server
                  (enough-namestring (merge-pathnames "server.lisp" *here*) (truename "./"))
                  (list (namestring data) (namestring socket) p::*archive-hex* p::*series-hex* "--create" "--version" "2"
                        (string-downcase (symbol-name mode)))))
         (until (p::deadline p::*process-timeout*)))
    (setf (p::child-socket child) socket)
    (loop
      (p::check-logs child)
      (multiple-value-bind (form end present) (p::first-form (uiop:read-file-string (p::child-stdout child)))
        (declare (ignore end))
        (when present
          (ensure (equal form (list :kind :local-server :state :ready :pid (p::child-pid child))))
          (setf (p::child-ready child) form) (return)))
      (ensure (and (p::running-p child) (< (get-internal-real-time) until)) :server-start) (sleep 0.01))
    (values child socket)))
(defun copy-logs ()
  (dolist (child (reverse p::*children*))
    (dolist (source (list (p::child-stdout child) (p::child-stderr child)))
      (let ((target (merge-pathnames (format nil "child-logs/~A" (file-namestring source)) *output*)))
        (ensure (not (probe-file target))) (ensure-directories-exist target) (uiop:copy-file source target)
        (let ((hash (arcdocdb.evidence:file-sha256 source)))
          (ensure (string= hash (arcdocdb.evidence:file-sha256 target)))
          (push (list :source (namestring source) :target (namestring target) :sha256 hash
                      :bytes (arcdocdb.evidence:file-bytes source)) *copies*)))))
  (u::save-new (merge-pathnames "child-copies.lisp" *output*) (reverse *copies*)))
(defun sample (workers api mode bytes rounds rep)
  (sb-ext:gc :full t)
  (let ((wall (get-internal-real-time)) (cpu (get-internal-run-time))
        (allocation (sb-ext:get-bytes-consed)) (gc sb-ext:*gc-run-time*))
    (loop for worker across workers do (sb-thread:signal-semaphore (worker-go worker)))
    (ready-workers workers)
    (let* ((end (get-internal-real-time)) (cpu-end (get-internal-run-time))
           (allocated (- (sb-ext:get-bytes-consed) allocation)) (gc-ticks (- sb-ext:*gc-run-time* gc))
           (ticks (make-array (* rounds (length workers)) :element-type '(unsigned-byte 64)))
           (hist (u::histogram :public-client-get)))
      (loop for worker across workers for start from 0 by rounds do (replace ticks (worker-ticks worker) :start1 start))
      (loop for tick across ticks do (u::record-ticks hist tick))
      (list :kind :buffered-get-window :latency-scope :api :api api :mode mode :document-bytes bytes :connections (length workers) :window rep
            :rounds rounds :operations (length ticks) :returned-bytes (* bytes (length ticks)) :wall-ticks (- end wall)
            :cpu-ticks (- cpu-end cpu) :allocated-bytes allocated :gc-cpu-ticks gc-ticks :ticks-per-second internal-time-units-per-second
            :latencies ticks :histogram (u::histogram-row hist ticks)))))
(defun one-case (runtime api function mode bytes width stage small)
  (multiple-value-bind (server socket) (launch-server runtime mode stage)
    (let ((key (make-array 1 :element-type '(unsigned-byte 8) :initial-element 42)) (doc (document bytes)) (workers nil)
          (rounds (if small 20 500)) (repeats (if small 2 5)))
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect (ensure (= 1 (l:client-put client key doc)) :seed-CSN) (l:close-local client)))
      (unwind-protect
           (progn
             (setf workers (start-workers socket function key doc width rounds repeats)) (ready-workers workers)
             (dotimes (rep repeats)
               (let ((row (sample workers api mode bytes rounds rep)))
                 (u::save-new (merge-pathnames (format nil "windows/~D-~D.lisp" stage rep) *output*) row)
                 (push (list :stage stage :window rep :operations (getf row :operations)) *rows*))))
        (when workers (stop-workers workers)))
      (loop for worker across workers do (ensure (not (worker-error worker)) (worker-error worker)))
      (ensure (every (lambda (worker) (eql 1 (worker-token worker))) workers) :final-versions)
      (p::stop-server server sb-posix:sigterm :buffered-get-completed)
      (let* ((text (uiop:read-file-string (p::child-stderr server)))
             (start (search "(:KIND :BUFFERED-SERVER" text)) (*read-eval* nil))
        (ensure start :server-mode-record)
        (ensure (eq mode (getf (read-from-string text nil nil :start start) :mode)) :actual-primary-mode)))))
(let* ((args (uiop:command-line-arguments)) (small (equal (first args) "--self-test"))
       (api (cond ((equal (second args) "copy") :copy) ((equal (second args) "into") :into) (t (error "Unknown API"))))
       (*output* (merge-pathnames (uiop:ensure-directory-pathname (third args)) *here*))
       (*copies* nil) (*rows* nil) (stage 0) (finish (symbol-function 'p::finish-children)) (function (read-adapter api)))
  (ensure (and (= 3 (length args)) (member (first args) '("--self-test" "--run") :test #'equal)))
  (check-validator)
  (ensure (not (probe-file *output*)))
  (u::save-new (merge-pathnames "started.lisp" *output*)
    (list :kind :buffered-get-started :command args :runtime (lisp-implementation-version)
          :driver-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" *here*))
          :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "server.lisp" *here*))
          :common-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "common.lisp" *here*))))
  (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
  (unwind-protect
       (p::call-with-run
        (lambda ()
          (let ((runtime (p::subdirectory "runtime/")))
            (if small
                (progn (one-case runtime api function :resident 1024 1 (incf stage) t)
                       (one-case runtime api function :paged 60000 2 (incf stage) t))
                (dolist (mode '(:resident :paged)) (dolist (bytes '(1024 60000)) (dolist (width '(1 8))
                  (one-case runtime api function mode bytes width (incf stage) nil))))))))
    (setf (symbol-function 'p::finish-children) finish))
  (u::save-new (merge-pathnames "completed.lisp" *output*)
    (list :kind :buffered-get-campaign :status :passed :cases stage :windows (length *rows*) :api api
          :runtime (lisp-implementation-version) :command args :operations (loop for row in *rows* sum (getf row :operations))
          :copies (reverse *copies*)))
  (u::emit-row (list :kind :buffered-get-campaign :status :passed :cases stage :windows (length *rows*))))
