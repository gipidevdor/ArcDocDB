;;;; C4 checked cohort counts, exact driver/log hashes and same-runtime before/after costs.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Conditional cohort measurement oracle failed")) truth)
(defun data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (with-open-file (in expanded) (read in))))))
(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<)) (count (length sorted)))
    (ensure (plusp count)) (if (oddp count) (nth (floor count 2) sorted) (/ (+ (nth (1- (/ count 2)) sorted) (nth (/ count 2) sorted)) 2))))
(defun row-key (row) (list (getf row :version) (getf row :mode) (getf row :width)))
(defun valid-row (row)
  (and (member (getf row :version) '(1 2)) (member (getf row :mode) '(:resident :paged))
       (member (getf row :width) '(1 2 4 8)) (typep (getf row :round) '(integer 0 4))
       (eql (* 8 (getf row :width)) (getf row :operations))
       (realp (getf row :microseconds-per-op)) (plusp (getf row :microseconds-per-op))))
(defun log-forms (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (expanded)
      (let ((text (uiop:read-file-string expanded)) (cursor 0) (out nil) (*read-eval* nil))
        (loop for start = (search "(:KIND :CONDITIONAL-COHORT" text :start2 cursor) while start do
          (multiple-value-bind (form end) (read-from-string text nil nil :start start)
            (ensure (< start end)) (push form out) (setf cursor end))) (reverse out)))))
(defun campaign (root name runtime baseline)
  (let* ((record (data (merge-pathnames name root))) (rows (getf record :rows)) (seen nil) (keys nil) (logs nil) (cases nil))
    (ensure (and (eq :passed (getf record :status)) (eq baseline (getf record :baseline))
                 (equal runtime (getf record :runtime)) (= 80 (length rows)) (= 32 (length (getf record :copies)))))
    (ensure (string= (getf record :driver-sha256)
                    (arcdocdb.evidence:file-sha256 (merge-pathnames (if baseline "baseline-driver.lisp" "bench.lisp") root))))
    (ensure (string= (getf record :server-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-server.lisp" root))))
    (dolist (copy (getf record :copies))
      (let ((path (pathname (getf copy :target))))
        (ensure (arcdocdb.evidence:call-with-evidence-bytes path
                  (lambda (expanded) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 expanded)))))
        (when (equal "stderr" (pathname-type path)) (setf logs (nconc logs (log-forms path))))))
    (ensure (= 640 (length logs)))
    (dolist (log logs)
      (ensure (member (getf log :requests) '(1 2 4 8)))
      (ensure (= (if baseline (getf log :requests) 1) (getf log :flushes))))
    (dolist (row rows)
      (ensure (valid-row row))
      (let ((key (append (row-key row) (list (getf row :round)))))
        (ensure (not (member key seen :test #'equal))) (push key seen) (pushnew (row-key row) keys :test #'equal)))
    (ensure (= 16 (length keys)))
    (dolist (version '(1 2)) (dolist (mode '(:resident :paged)) (dolist (width '(1 2 4 8))
      (ensure (= 160 (count width logs :key (lambda (log) (getf log :requests)))))
      (let* ((key (list version mode width)) (samples (remove-if-not (lambda (row) (equal key (row-key row))) rows)))
        (ensure (= 5 (length samples)))
        (push (list :key key :median-us-per-op (median (mapcar (lambda (row) (getf row :microseconds-per-op)) samples))) cases)))))
    (list :runtime runtime :baseline baseline :samples 80 :operations (loop for row in rows sum (getf row :operations))
          :cohorts (length logs) :flushes (loop for log in logs sum (getf log :flushes)) :cases (reverse cases))))
(let ((root (uiop:pathname-directory-pathname *load-truename*)))
  ;; The sole final-driver change is outside timing: namespacing copied logs by completed-window count.
  (let* ((before (uiop:read-file-string (merge-pathnames "baseline-driver.lisp" root)))
         (after (uiop:read-file-string (merge-pathnames "bench.lisp" root))))
    (labels ((definitions (text)
               (let ((masked (copy-seq text)) (*read-eval* nil))
                 (dotimes (i (length masked))
                   (when (and (char= #\: (char masked i)) (or (zerop i) (char/= #\# (char masked (1- i)))))
                     (setf (char masked i) #\_)))
                 (with-input-from-string (in masked)
                   (loop for form = (read in nil nil) while form
                         when (and (consp form) (eq 'defun (first form)) (member (second form) '(cohort run-case))) collect form)))))
      (ensure (= 2 (length (definitions before)))) (ensure (equal (definitions before) (definitions after)))))
  (when (equal (uiop:command-line-arguments) '("--baseline-check"))
    (campaign root "baseline-samples.lisp" "2.6.9" t)
    (format t "~S~%" '(:kind :conditional-cohort-baseline-integrity :status :passed)) (uiop:quit 0))
  (if (equal (uiop:command-line-arguments) '("--self-test"))
      (let ((row '(:version 2 :mode :paged :width 8 :round 0 :operations 64 :microseconds-per-op 500d0)))
        (ensure (valid-row row))
        (dolist (mutation '((:width 9) (:round 5) (:operations 8) (:microseconds-per-op 0) (:mode :unknown)))
          (let ((bad (copy-list row))) (setf (getf bad (first mutation)) (second mutation)) (ensure (not (valid-row bad)))))
        (format t "~S~%" '(:kind :conditional-cohort-analysis-self-test :status :passed :negatives 5)))
      (let* ((base (campaign root "baseline-samples.lisp" "2.6.9" t))
             (final (campaign root "final-samples-2.6.9.lisp" "2.6.9" nil))
             (next (campaign root "final-samples-2.6.10.lisp" "2.6.10" nil)) (ratios nil))
        (dolist (case (getf base :cases))
          (let* ((key (getf case :key)) (after (find key (getf final :cases) :key (lambda (r) (getf r :key)) :test #'equal))
                 (ratio (/ (getf case :median-us-per-op) (getf after :median-us-per-op))))
            (push (list :key key :before-us (getf case :median-us-per-op) :after-us (getf after :median-us-per-op) :gain ratio) ratios)
            (format t "v~D ~A width ~D: ~,3F -> ~,3F us/op; ~,4Fx~%" (first key) (second key) (third key)
                    (getf case :median-us-per-op) (getf after :median-us-per-op) ratio)))
        (let* ((summary (list :kind :conditional-cohort-metrics :status :passed :baseline base :final final :supplementary-runtime next
                              :same-runtime-gains (reverse ratios) :limits '(:controlled-ready-cohorts :no-2.6.10-baseline :not-p99 :not-power-loss)))
               (target (merge-pathnames "metrics.lisp" root)))
          (if (probe-file target) (ensure (equalp summary (data target)))
              (with-open-file (out target :direction :output :if-exists :error) (write summary :stream out :pretty t) (terpri out))))
        (format t "~S~%" '(:kind :conditional-cohort-analysis :status :passed)))))
