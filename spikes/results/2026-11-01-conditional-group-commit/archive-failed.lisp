;;;; Exact owned failed fixture bytes; input roots come only from this campaign's completed raw diagnostics.
(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (copies nil) (roots nil) (seen nil) (*read-eval* nil))
  (dolist (id '("4002513100-command-20205-0" "4002514008-command-28850-0" "4002514167-command-32841-0" "4002514270-command-33933-0"))
    (let* ((record (with-open-file (in (format nil "spikes/out/~A/report.lisp" id)) (read in)))
           (text (getf record :stderr)))
      (dolist (marker '("LOCAL-ROOT-RETAINED " "ENGINE-ROOT-RETAINED "))
        (let ((cursor 0))
          (loop for start = (search marker text :start2 cursor) while start do
            (let* ((from (+ start (length marker))) (end (or (position #\Newline text :start from) (length text)))
                   (source (pathname (subseq text from end))))
              (setf cursor end)
              (unless (member source seen :test #'equal)
                (push source seen)
                (unless (probe-file source) (error "Owned failed fixture missing"))
                (let ((files 0) (bytes 0) (leaf (car (last (pathname-directory source)))))
                  (dolist (name (uiop:split-string
                                 (uiop:run-program (list "rg" "--files" "--hidden" "--no-ignore" "-0" "--" (namestring source))
                                   :output :string :ignore-error-status t) :separator '(#\Null)))
                    (when (plusp (length name))
                      (let* ((path (pathname name)) (stat (sb-posix:lstat name))
                             (target (merge-pathnames (format nil "development-fixtures/~A/~A" leaf (enough-namestring path source)) root))
                             (hash (arcdocdb.evidence:file-sha256 path)))
                        (unless (and (sb-posix:s-isreg (sb-posix:stat-mode stat)) (= (sb-posix:getuid) (sb-posix:stat-uid stat)))
                          (error "Failed fixture entry is not owned regular data"))
                        (ensure-directories-exist target) (uiop:copy-file path target)
                        (unless (string= hash (arcdocdb.evidence:file-sha256 target)) (error "Failed fixture copy differs"))
                        (incf files) (incf bytes (sb-posix:stat-size stat))
                        (push (list :source name :target (namestring target) :sha256 hash) copies))))
                  (push (list :path (namestring source) :files files :bytes bytes :command id) roots)))))))))
  (with-open-file (out (merge-pathnames "failed-fixture-archive.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :conditional-cohort-failed-fixtures :status :passed :roots (reverse roots) :copies (reverse copies)) :stream out :pretty t)
    (terpri out))
  (format t "~S~%" (list :kind :conditional-cohort-failed-fixtures :status :passed :roots (length roots) :files (length copies))))
