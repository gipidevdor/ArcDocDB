;;;; C4 before/after pipeline, same native framing/CSN checks and exact server flush logs.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/tests"))
(load "tools/evidence-storage.lisp")
(defparameter *bench-root* (uiop:pathname-directory-pathname *load-truename*))
(defparameter *baseline* (equal (uiop:command-line-arguments) '("--baseline")))
(defparameter *rows* nil)
(defparameter *copies* nil)
(defun ensure (truth) (unless truth (error "Conditional cohort oracle failed")) truth)
(defun forms (path)
  (let ((*read-eval* nil) (text (uiop:read-file-string path)) (marker "(:KIND :CONDITIONAL-COHORT") (cursor 0) (found nil))
    (loop for start = (search marker text :start2 cursor) while start do
      (multiple-value-bind (form end) (read-from-string text nil nil :start start)
        (ensure (< start end)) (push form found) (setf cursor end))) (reverse found)))
(defun cohort (clients tokens key-base document frontier)
  (dotimes (i (length clients))
    (let* ((client (aref clients i)) (id (arcdocdb.local::local-client-next-id client))
           (out (arcdocdb.local::local-client-output client))
           (end (arcdocdb.local::encode-local-version out id 1 (arcdocdb.engine.tests::key (+ key-base i)) document (aref tokens i) 65536)))
      (setf (arcdocdb.local::local-client-state client) :busy (arcdocdb.local::local-client-next-id client) (1+ id))
      (arcdocdb.local::transfer-local-client client out 0 end :output (arcdocdb.local.process.tests::deadline 30))))
  (let ((observed nil))
    (dotimes (i (length clients))
      (let* ((client (aref clients i)) (id (1- (arcdocdb.local::local-client-next-id client)))
             (env (arcdocdb.local::receive-local-client client 65536 (arcdocdb.local.process.tests::deadline 30))))
        (ensure (= id (arcdocdb.local:envelope-id env)))
        (multiple-value-bind (status token)
            (arcdocdb.local::decode-local-version-response (arcdocdb.local::local-client-input client) env
              (arcdocdb.local::local-client-space client) 1)
          (ensure (eq status :applied)) (setf (aref tokens i) token) (push token observed))
        (setf (arcdocdb.local::local-client-state client) :ready)))
    (ensure (equal (sort observed #'<) (loop for n from (1+ frontier) to (+ frontier (length clients)) collect n))))
  (+ frontier (length clients)))
(defun run-case (version mode width)
  (sb-posix:setenv "ARCDOCDB_CONDITIONAL_COHORT" (write-to-string width) 1)
  (sb-posix:setenv "ARCDOCDB_CONDITIONAL_MODE" (string-downcase (symbol-name mode)) 1)
  (arcdocdb.local.process.tests::call-with-run
   (lambda ()
     (let ((runtime (arcdocdb.local.process.tests::subdirectory "runtime/"))
           (data (arcdocdb.local.process.tests::subdirectory "data/"))
           (clients (make-array width :initial-element nil))
           (tokens (make-array width :element-type '(unsigned-byte 64) :initial-element 0))
           (document (arcdocdb.local.wire.tests::get-document 128)) (frontier 0))
       (multiple-value-bind (server socket)
           (arcdocdb.local.process.tests::start-server data runtime version 610 :create t :index-budget 8388608
             :script (enough-namestring (merge-pathnames "bench-server.lisp" *bench-root*) (truename "./")))
         (unwind-protect
              (progn
                (dotimes (i width) (setf (aref clients i) (arcdocdb.local:connect-local (namestring socket) :versions t)))
                (dotimes (round 5)
                  (let ((start (get-internal-real-time)))
                    (dotimes (wave 8) (setf frontier (cohort clients tokens 1 document frontier)))
                    (let ((row (list :version version :mode mode :width width :round round :operations (* 8 width)
                                     :microseconds-per-op (/ (* 1000000d0 (- (get-internal-real-time) start)) internal-time-units-per-second 8 width))))
                      (push row *rows*) (format t "~S~%" row)))
                  (dotimes (i width)
                    (multiple-value-bind (status actual token)
                        (arcdocdb.local:client-get-version (aref clients i) (arcdocdb.engine.tests::key (+ 1 i)))
                      (ensure (and (eq status :found) (equalp document actual) (= token (aref tokens i))))))))
           (dotimes (i width) (when (aref clients i) (arcdocdb.local:close-local (aref clients i)))))
         (arcdocdb.local.process.tests::stop-server server sb-posix:sigterm :conditional-cohort-measured)
         (let ((records (remove-if-not (lambda (f) (eq :conditional-cohort (getf f :kind)))
                                      (forms (arcdocdb.local.process.tests::child-stderr server)))))
           (ensure (= 40 (length records)))
           (dolist (record records)
             (ensure (= width (getf record :requests))) (ensure (= (if *baseline* width 1) (getf record :flushes))))))))))
(let ((finish (symbol-function 'arcdocdb.local.process.tests::finish-children)))
  (unwind-protect
       (progn
         (setf (symbol-function 'arcdocdb.local.process.tests::finish-children)
               (lambda ()
                 (funcall finish)
                 (dolist (child arcdocdb.local.process.tests::*children*)
                   (dolist (source (list (arcdocdb.local.process.tests::child-stdout child) (arcdocdb.local.process.tests::child-stderr child)))
                     (let ((target (merge-pathnames (format nil "~A-logs/~A/~A/~A" (if *baseline* "baseline" "final")
                                      (lisp-implementation-version) (car (last (pathname-directory arcdocdb.local.process.tests::*root*)))
                                      (file-namestring source)) *bench-root*)))
                       (ensure-directories-exist target) (uiop:copy-file source target)
                       (let ((hash (arcdocdb.evidence:file-sha256 source)))
                         (ensure (string= hash (arcdocdb.evidence:file-sha256 target)))
                         (push (list :source (namestring source) :target (namestring target) :sha256 hash) *copies*)))))))
         (dolist (version '(1 2)) (dolist (mode '(:resident :paged)) (dolist (width '(1 2 4 8)) (run-case version mode width)))))
    (setf (symbol-function 'arcdocdb.local.process.tests::finish-children) finish)))
(ensure (= 80 (length *rows*)))
(with-open-file (out (merge-pathnames (if *baseline* "baseline-samples.lisp" (format nil "final-samples-~A.lisp" (lisp-implementation-version))) *bench-root*)
                     :direction :output :if-exists :error)
  (write (list :kind :conditional-cohort-measurements :status :passed :baseline *baseline* :runtime (lisp-implementation-version)
               :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
               :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-server.lisp" *bench-root*))
               :rows (reverse *rows*) :copies (reverse *copies*) :limits '(:controlled-cohort :not-natural-arrivals :not-tail-latency :not-power-loss))
         :stream out :pretty t) (terpri out))
(format t "~S~%" '(:kind :conditional-cohort-benchmark :status :passed))
