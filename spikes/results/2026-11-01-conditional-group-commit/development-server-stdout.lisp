;;;; C4-only finite cohort gate; actual product dispatch and strong I/O, no product batching wait.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(defun mutation-p (connection)
  (let ((env (arcdocdb.local::local-connection-pending connection)))
    (and env (= 6 (arcdocdb.local:envelope-code env))
         (multiple-value-bind (major count cursor)
             (arcdocdb.local::%wire-head (arcdocdb.local::local-connection-input connection)
               (arcdocdb.local::envelope-payload-start env) (arcdocdb.local::envelope-payload-end env))
           (declare (ignore count))
           (and (= major 4) (member (arcdocdb.local::%wire-uint (arcdocdb.local::local-connection-input connection)
                                           cursor (arcdocdb.local::envelope-payload-end env) 3) '(1 3)))))))
(let ((open (symbol-function 'arcdocdb.engine:apri-motore))
      (dispatch (symbol-function 'arcdocdb.local::dispatch-local-ready))
      (flush (symbol-function 'arcdocdb.io:durable-flush)) (flushes 0)
      (width (parse-integer (or (uiop:getenv "ARCDOCDB_CONDITIONAL_COHORT") "8")))
      (paged (equal "paged" (uiop:getenv "ARCDOCDB_CONDITIONAL_MODE"))))
  (unless (<= 1 width 8) (error "Invalid bounded cohort"))
  (setf (symbol-function 'arcdocdb.engine:apri-motore)
        (lambda (&rest args)
          (let ((engine (apply open args)))
            (when paged (arcdocdb.engine:configura-budget-indice-motore engine
                          (getf (arcdocdb.engine:statistiche-indice-motore engine) :reserved-fixed))) engine))
        (symbol-function 'arcdocdb.io:durable-flush)
        (lambda (file) (incf flushes) (funcall flush file))
        (symbol-function 'arcdocdb.local::dispatch-local-ready)
        (lambda (engine connections clock queue)
          (let* ((count (count-if #'mutation-p connections))
                 (barrier (some (lambda (c) (and (eq :pending (arcdocdb.local::local-connection-state c)) (not (mutation-p c)))) connections)))
            (when (or (zerop count) (= count width) barrier)
              (let ((before flushes))
                (funcall dispatch engine connections clock queue)
                (when (plusp count)
                  (format t "~S~%" (list :kind :conditional-cohort :requests count :flushes (- flushes before)))
                  (finish-output)))))))
  (arcdocdb.local::server-cli-main (uiop:command-line-arguments)))
