(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Singleton diagnostic oracle failed")) truth)
(defun data (path)
  (let ((*read-eval* nil)) (arcdocdb.evidence:call-with-evidence-bytes path (lambda (p) (with-open-file (in p) (read in))))))
(defun median (values) (let* ((s (sort (copy-list values) #'<)) (n (length s))) (/ (+ (nth (1- (/ n 2)) s) (nth (/ n 2) s)) 2)))
(defun records (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (p) (let ((text (uiop:read-file-string p)) (cursor 0) (out nil) (*read-eval* nil))
      (loop for start = (search "(:KIND :CONDITIONAL-COHORT" text :start2 cursor) while start do
        (multiple-value-bind (f end) (read-from-string text nil nil :start start) (push f out) (setf cursor end))) (reverse out)))))
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (input (data (merge-pathnames "samples.lisp" root)))
       (logs (remove-if-not (lambda (c) (equal "stderr" (pathname-type (pathname (getf c :target))))) (getf input :copies)))
       (cases '((1 :resident) (1 :paged) (2 :resident) (2 :paged))) (rows nil))
  (ensure (= 20 (length (getf input :rows)))) (ensure (= 160 (length (getf input :calls)))) (ensure (= 4 (length logs)))
  (dolist (copy (getf input :copies))
    (ensure (arcdocdb.evidence:call-with-evidence-bytes (pathname (getf copy :target))
              (lambda (p) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 p))))))
  (loop for file in logs for case in cases do
    (let ((measurements (records (pathname (getf file :target)))))
      (ensure (= 40 (length measurements)))
      (dolist (variant '(:old :new))
        (let ((selected (remove-if-not (lambda (m) (eq variant (getf m :variant))) measurements))
              (parent nil) (flush nil) (dispatch nil) (residual nil))
          (ensure (= 20 (length selected)))
          (dolist (m selected)
            (ensure (and (= 1 (getf m :requests)) (= 1 (getf m :flushes))))
            (let ((call (find-if (lambda (c) (and (= (first case) (getf c :version)) (eq (second case) (getf c :mode))
                                                 (= (getf m :sequence) (getf c :sequence)))) (getf input :calls))))
              (ensure call) (push (getf call :parent-us) parent) (push (getf m :flush-us) flush)
              (push (getf m :dispatch-us) dispatch) (push (- (getf call :parent-us) (getf m :flush-us)) residual)))
          (let ((row (list :case case :variant variant :samples 20 :parent-median-us (median parent)
                           :flush-median-us (median flush) :dispatch-median-us (median dispatch) :residual-median-us (median residual))))
            (push row rows)
            (format t "~S ~A: parent ~,2F, flush ~,2F, dispatch ~,2F, parent-minus-flush ~,2F us~%" case variant
                    (getf row :parent-median-us) (getf row :flush-median-us) (getf row :dispatch-median-us) (getf row :residual-median-us)))))))
  (with-open-file (out (merge-pathnames "summary.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :conditional-singleton-diagnostic :status :passed :rows (reverse rows)
                 :limits '(:runtime-function-replacement :same-process-alternation :not-product-qualification
                           :wall-time-inside-durable-flush :not-pure-device-time :not-a-regression-bound)) :stream out :pretty t) (terpri out))
  (format t "~S~%" '(:kind :conditional-singleton-diagnostic :status :passed)))
