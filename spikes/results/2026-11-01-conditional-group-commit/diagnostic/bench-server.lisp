;;;; C4-only finite cohort gate; actual product dispatch and strong I/O, no product batching wait.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(defun mutation-p (connection)
  (let ((env (arcdocdb.local::local-connection-pending connection)))
    (and env (= 6 (arcdocdb.local:envelope-code env))
         (multiple-value-bind (major count cursor)
             (arcdocdb.local::%wire-head (arcdocdb.local::local-connection-input connection)
               (arcdocdb.local::envelope-payload-start env) (arcdocdb.local::envelope-payload-end env))
           (declare (ignore count))
           (and (= major 4) (member (arcdocdb.local::%wire-uint (arcdocdb.local::local-connection-input connection)
                                           cursor (arcdocdb.local::envelope-payload-end env) 3) '(1 3)))))))
(defparameter *variant-symbols* '(arcdocdb.local::clear-local-write-queue arcdocdb.local::expire-local-write-queue
                                 arcdocdb.local::flush-local-write-queue arcdocdb.local::dispatch-local-pending
                                 arcdocdb.local::local-version-mutation arcdocdb.local::local-dispatch-version))
(defparameter *current-functions* (mapcar #'symbol-function *variant-symbols*))
(defparameter *current-dispatch* (symbol-function 'arcdocdb.local::dispatch-local-ready))
(defparameter *old-functions* nil)
(defparameter *old-dispatch* nil)
(let ((root (uiop:pathname-directory-pathname *load-truename*)))
  (dolist (name '("write-group" "version-dispatch"))
    (let ((path (merge-pathnames (format nil "old-~A.lisp" name) root)))
      (unless (string= (uiop:run-program (list "git" "hash-object" "--" (namestring path)) :output :string)
                       (uiop:run-program (list "git" "rev-parse" (format nil "4818552:src/local/~A.lisp" name)) :output :string))
        (error "Diagnostic old source differs from immutable commit"))
      (load path)))
  (setf *old-functions* (mapcar #'symbol-function *variant-symbols*)
        *old-dispatch* (symbol-function 'arcdocdb.local::dispatch-local-ready))
  (loop for symbol in *variant-symbols* for fn in *current-functions* do (setf (symbol-function symbol) fn))
  (setf (symbol-function 'arcdocdb.local::dispatch-local-ready) *current-dispatch*))
(let ((open (symbol-function 'arcdocdb.engine:apri-motore))
      (dispatch (symbol-function 'arcdocdb.local::dispatch-local-ready))
      (flush (symbol-function 'arcdocdb.io:durable-flush)) (flushes 0) (flush-us 0d0) (sequence 0)
      (width (parse-integer (or (uiop:getenv "ARCDOCDB_CONDITIONAL_COHORT") "8")))
      (paged (equal "paged" (uiop:getenv "ARCDOCDB_CONDITIONAL_MODE"))))
  (unless (<= 1 width 8) (error "Invalid bounded cohort"))
  (setf (symbol-function 'arcdocdb.engine:apri-motore)
        (lambda (&rest args)
          (let ((engine (apply open args)))
            (when paged (arcdocdb.engine:configura-budget-indice-motore engine
                          (getf (arcdocdb.engine:statistiche-indice-motore engine) :reserved-fixed))) engine))
        (symbol-function 'arcdocdb.io:durable-flush)
        (lambda (file)
          (let ((start (get-internal-real-time)))
            (multiple-value-prog1 (progn (incf flushes) (funcall flush file))
              (incf flush-us (/ (* 1000000d0 (- (get-internal-real-time) start)) internal-time-units-per-second)))))
        (symbol-function 'arcdocdb.local::dispatch-local-ready)
        (lambda (engine connections clock queue)
          (let* ((count (count-if #'mutation-p connections))
                 (barrier (some (lambda (c) (and (eq :pending (arcdocdb.local::local-connection-state c)) (not (mutation-p c)))) connections)))
            (when (or (zerop count) (= count width) barrier)
              (let* ((before flushes) (before-us flush-us) (start (get-internal-real-time))
                     (old (and (plusp count) (evenp (+ (incf sequence) (arcdocdb.engine::motore-version engine) (if paged 1 0))))))
                (unwind-protect
                     (progn
                       (loop for symbol in *variant-symbols* for fn in (if old *old-functions* *current-functions*)
                             do (setf (symbol-function symbol) fn))
                       (funcall (if old *old-dispatch* dispatch) engine connections clock queue))
                  (loop for symbol in *variant-symbols* for fn in *current-functions* do (setf (symbol-function symbol) fn)))
                (when (plusp count)
                  (format *error-output* "~S~%" (list :kind :conditional-cohort :requests count :flushes (- flushes before)
                    :sequence sequence :variant (if old :old :new) :flush-us (- flush-us before-us)
                    :dispatch-us (/ (* 1000000d0 (- (get-internal-real-time) start)) internal-time-units-per-second)))
                  (finish-output *error-output*)))))))
  (arcdocdb.local::server-cli-main (uiop:command-line-arguments)))
