(require :asdf)
(load "tools/evidence-storage.lisp")
(defun cost-data (path)
  (let ((*read-eval* nil)) (arcdocdb.evidence:call-with-evidence-bytes path (lambda (p) (with-open-file (in p) (read in))))))
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (metrics (cost-data (merge-pathnames "metrics.lisp" root))))
  (dolist (tag '(:baseline :final :supplementary-runtime))
    (let ((record (getf metrics tag)))
      (format t "~A ~A: ~D operations, ~D cohorts, ~D flushes~%" tag (getf record :runtime)
              (getf record :operations) (getf record :cohorts) (getf record :flushes))
      (dolist (entry (getf record :cases)) (format t "~S ~,3F us/op~%" (getf entry :key) (getf entry :median-us-per-op)))))
  (dolist (name '("baseline-samples.lisp" "final-samples-2.6.9.lisp" "final-samples-2.6.10.lisp"))
    (format t "Singleton windows ~A:~%" name)
    (let ((rows (getf (cost-data (merge-pathnames name root)) :rows)))
      (dolist (version '(1 2)) (dolist (mode '(:resident :paged))
        (format t "v~D ~A ~S~%" version mode
          (loop for row in rows when (and (= version (getf row :version)) (eq mode (getf row :mode)) (= 1 (getf row :width)))
                collect (getf row :microseconds-per-op))))))))
