;;;; C4 sample shape/flush/window validation and descriptive within-runtime paired costs.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Conditional measurement oracle failed")) truth)
(defun data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (with-open-file (in expanded) (read in))))))
(defun median (values)
  (let* ((ordered (sort (copy-list values) #'<)) (n (length ordered)))
    (ensure (plusp n)) (if (oddp n) (nth (floor n 2) ordered) (/ (+ (nth (1- (/ n 2)) ordered) (nth (/ n 2) ordered)) 2))))
(defun valid-row (row)
  (and (member (getf row :layer) '(:engine :unix)) (member (getf row :version) '(1 2))
       (member (getf row :mode) '(:legacy :resident :paged)) (member (getf row :document-bytes) '(128 4096))
       (typep (getf row :round) '(integer 0 4))
       (member (getf row :operation) '(:get :version-get :put :conditional-put :conflict))
       (= (getf row :operations) (if (member (getf row :operation) '(:put :conditional-put)) 16 256))
       (realp (getf row :microseconds-per-op)) (plusp (getf row :microseconds-per-op))
       (typep (getf row :allocated-bytes) '(integer 0)) (typep (getf row :flushes) '(integer 0))
       (or (eq :unix (getf row :layer))
           (= (getf row :flushes) (if (member (getf row :operation) '(:put :conditional-put)) (getf row :operations) 0)))))
(let ((root (uiop:pathname-directory-pathname *load-truename*)))
  (if (equal (uiop:command-line-arguments) '("--self-test"))
      (let ((row '(:layer :engine :version 2 :mode :resident :document-bytes 128 :round 0 :operation :conflict
                   :operations 256 :microseconds-per-op 1d0 :allocated-bytes 0 :flushes 0)))
        (ensure (valid-row row))
        (dolist (mutation '((:flushes 1) (:microseconds-per-op 0) (:allocated-bytes -1) (:operations 16) (:round 5)))
          (let ((bad (copy-list row))) (setf (getf bad (first mutation)) (second mutation)) (ensure (not (valid-row bad)))))
        (format t "~S~%" '(:kind :conditional-analysis-self-test :status :passed :negatives 5)))
      (let ((summaries nil))
        (dolist (name '("samples.lisp" "samples-2.6.10.lisp"))
          (let* ((record (data (merge-pathnames name root))) (rows (getf record :rows)) (cases nil) (seen nil))
            (ensure (and (eq :passed (getf record :status)) (= 400 (length rows))))
            (ensure (string= (getf record :driver-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" root))))
            (ensure (string= (getf record :server-driver-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-server.lisp" root))))
            (ensure (= 8 (length (getf record :log-copies))))
            (dolist (copy (getf record :log-copies))
              (ensure (arcdocdb.evidence:call-with-evidence-bytes (pathname (getf copy :target))
                        (lambda (expanded) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 expanded))))))
            (dolist (row rows)
              (ensure (valid-row row))
              (let ((key (list (getf row :layer) (getf row :version) (getf row :mode) (getf row :document-bytes)
                               (getf row :round) (getf row :operation))))
                (ensure (not (member key seen :test #'equal))) (push key seen)
                (pushnew (subseq key 0 4) cases :test #'equal)))
            (ensure (= 16 (length cases)))
            (let ((expected nil))
              (dolist (version '(1 2))
                (dolist (mode '(:legacy :resident :paged))
                  (dolist (size '(128 4096)) (push (list :engine version mode size) expected)))
                (dolist (mode '(:resident :paged)) (push (list :unix version mode 128) expected)))
              (ensure (null (set-exclusive-or expected cases :test #'equal))))
            (let ((costs nil))
              (dolist (case cases)
                (let ((medians nil))
                  (dolist (kind '(:get :version-get :put :conditional-put :conflict))
                    (let ((samples (remove-if-not (lambda (row) (and (eq kind (getf row :operation))
                                                                   (equal case (list (getf row :layer) (getf row :version)
                                                                                     (getf row :mode) (getf row :document-bytes))))) rows)))
                      (ensure (= 5 (length samples)))
                      (setf (getf medians kind) (median (mapcar (lambda (r) (getf r :microseconds-per-op)) samples)))))
                  (push (list :case case :median-microseconds medians
                              :version-get-over-get (/ (getf medians :version-get) (getf medians :get))
                              :conditional-put-over-put (/ (getf medians :conditional-put) (getf medians :put))) costs)))
              (let ((summary (list :runtime (getf record :runtime) :samples (length rows) :cases (nreverse costs)
                                   :operations (loop for row in rows sum (getf row :operations))
                                   :timed-engine-flushes (loop for row in rows when (eq :engine (getf row :layer)) sum (getf row :flushes)))))
                (push summary summaries) (format t "~S~%" summary)))))
        (let ((target (merge-pathnames "metrics.lisp" root))
              (summary (list :kind :conditional-cost-summary :status :passed :runtimes (nreverse summaries))))
          (if (probe-file target) (ensure (equalp summary (data target)))
              (with-open-file (out target :direction :output :if-exists :error)
                (write summary :stream out :pretty t) (terpri out))))
        (format t "~S~%" '(:kind :conditional-analysis :status :passed)))))
