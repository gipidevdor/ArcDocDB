;;;; C4 serial same-runtime comparison; same strong durability, independent flush and CSN oracles.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/tests"))
(load "tools/evidence-storage.lisp")
(defparameter *result-root* (uiop:pathname-directory-pathname *load-truename*))
(defparameter *rows* nil)
(defparameter *log-copies* nil)
(defvar *flushes* 0)
(defun ensure (truth) (unless truth (error "Conditional benchmark oracle failed")) truth)
(defun timed (count thunk)
  (let ((start (get-internal-real-time)) (consed (sb-ext:get-bytes-consed)) (flushes *flushes*))
    (dotimes (i count) (funcall thunk))
    (list :operations count :microseconds-per-op (/ (* 1000000d0 (- (get-internal-real-time) start)) internal-time-units-per-second count)
          :allocated-bytes (- (sb-ext:get-bytes-consed) consed) :flushes (- *flushes* flushes))))
(defun engine-case (version mode size)
  (arcdocdb.engine.tests::with-root (root)
    (let* ((engine (arcdocdb.engine:apri-motore root (arcdocdb.engine.tests::archive-id) (arcdocdb.engine.tests::series-id)
                     :create t :version version :clock (lambda () 10) :max-file-bytes 33554432 :max-records 32768
                     :max-segments 16 :index-capacity 32 :key-arena-bytes 4096 :record-cache-budget 1048576
                     :index-policy (if (eq mode :legacy) :legacy
                                       (arcdocdb.engine:crea-politica-indice-automatico :budget 8388608 :frames 1))))
           (key (arcdocdb.engine.tests::key 1)) (document (arcdocdb.local.wire.tests::get-document size))
           (out (make-array 60000 :element-type '(unsigned-byte 8))) (csn 0))
      (unwind-protect
           (progn
             (arcdocdb.engine.tests::rotation-force-paged engine mode)
             (setf csn (arcdocdb.engine:scrivi-documento engine key document))
             (labels ((call-kind (kind)
                        (case kind
                          (:get (multiple-value-bind (status bytes) (arcdocdb.engine:leggi-documento engine key out)
                                  (ensure (and (eq status :found) (= bytes size)))))
                          (:version-get (multiple-value-bind (status bytes token) (arcdocdb.engine:leggi-documento-con-versione engine key out)
                                          (ensure (and (eq status :found) (= bytes size) (= token csn)))))
                          (:conflict (multiple-value-bind (status token) (arcdocdb.engine:scrivi-documento-se-versione engine key document 0)
                                       (ensure (and (eq status :conflict) (= token csn)))))
                          (:put (let ((next (arcdocdb.engine:scrivi-documento engine key document)))
                                  (ensure (= next (1+ csn))) (setf csn next)))
                          (:conditional-put (multiple-value-bind (status next) (arcdocdb.engine:scrivi-documento-se-versione engine key document csn)
                                              (ensure (and (eq status :applied) (= next (1+ csn)))) (setf csn next))))))
               (dotimes (warm 16) (call-kind :get) (call-kind :version-get) (call-kind :conflict))
               (dotimes (round 5)
                 (dolist (kind (if (evenp round) '(:get :version-get :put :conditional-put :conflict)
                                  '(:conflict :conditional-put :put :version-get :get)))
                   (let* ((count (if (member kind '(:put :conditional-put)) 16 256))
                          (sample (timed count (lambda () (call-kind kind)))))
                     (ensure (= (getf sample :flushes) (if (member kind '(:put :conditional-put)) count 0)))
                     (let ((row (append (list :layer :engine :version version :mode mode :document-bytes size :round round :operation kind) sample)))
                       (push row *rows*) (format t "~S~%" row)))))
               (ensure (equalp document (subseq out 0 size)))
               (arcdocdb.engine.tests::check-frontier engine csn)))
        (arcdocdb.engine:chiudi-motore engine)))))
(defun unix-case (version paged)
  (arcdocdb.local.process.tests::call-with-run
   (lambda ()
     (let ((runtime (arcdocdb.local.process.tests::subdirectory "bench-runtime/"))
           (data (arcdocdb.local.process.tests::subdirectory "bench-data/"))
           (key (arcdocdb.local.process.tests::decode-hex "00FF0102"))
           (document (arcdocdb.local.wire.tests::get-document 128)))
       (multiple-value-bind (server socket)
           (arcdocdb.local.process.tests::start-server data runtime version 510 :create t
             :script (enough-namestring (merge-pathnames "bench-server.lisp" *result-root*) (truename "./"))
             :index-budget (if paged 3400000 8388608) :record-cache-budget 1048576)
         (let ((client (arcdocdb.local:connect-local (namestring socket) :versions t)) (csn 0))
           (unwind-protect
                (progn
                  (setf csn (arcdocdb.local:client-put client key document))
                  (labels ((call-kind (kind)
                             (case kind
                               (:get (multiple-value-bind (status doc) (arcdocdb.local:client-get client key)
                                       (ensure (and (eq status :found) (equalp document doc)))))
                               (:version-get (multiple-value-bind (status doc token) (arcdocdb.local:client-get-version client key)
                                               (ensure (and (eq status :found) (equalp document doc) (= token csn)))))
                               (:conflict (multiple-value-bind (status token) (arcdocdb.local:client-put-if client key document 0)
                                            (ensure (and (eq status :conflict) (= token csn)))))
                               (:put (let ((next (arcdocdb.local:client-put client key document))) (ensure (= next (1+ csn))) (setf csn next)))
                               (:conditional-put (multiple-value-bind (status next) (arcdocdb.local:client-put-if client key document csn)
                                                   (ensure (and (eq status :applied) (= next (1+ csn)))) (setf csn next))))))
                    (dotimes (warm 16) (call-kind :get) (call-kind :version-get) (call-kind :conflict))
                    (dotimes (round 5)
                      (dolist (kind (if (evenp round) '(:get :version-get :put :conditional-put :conflict)
                                       '(:conflict :conditional-put :put :version-get :get)))
                        (let ((row (append (list :layer :unix :version version :mode (if paged :paged :resident)
                                                :document-bytes 128 :round round :operation kind)
                                           (timed (if (member kind '(:put :conditional-put)) 16 256) (lambda () (call-kind kind))))))
                          (push row *rows*) (format t "~S~%" row))))))
             (arcdocdb.local:close-local client)))
         (arcdocdb.local.process.tests::stop-server server sb-posix:sigterm :conditional-benchmark-complete))))))
(let ((original (symbol-function 'arcdocdb.io:durable-flush))
      (finish (symbol-function 'arcdocdb.local.process.tests::finish-children)))
  (unwind-protect
       (progn
         (setf (symbol-function 'arcdocdb.io:durable-flush) (lambda (file) (incf *flushes*) (funcall original file)))
         (setf (symbol-function 'arcdocdb.local.process.tests::finish-children)
               (lambda ()
                 (funcall finish)
                 (dolist (child arcdocdb.local.process.tests::*children*)
                   (dolist (source (list (arcdocdb.local.process.tests::child-stdout child) (arcdocdb.local.process.tests::child-stderr child)))
                     (let* ((leaf (car (last (pathname-directory arcdocdb.local.process.tests::*root*))))
                            (target (merge-pathnames (format nil "unix-logs/~A/~A/~A" (lisp-implementation-version) leaf (file-namestring source)) *result-root*)))
                       (ensure-directories-exist target) (uiop:copy-file source target)
                       (let ((hash (arcdocdb.evidence:file-sha256 source)))
                         (ensure (string= hash (arcdocdb.evidence:file-sha256 target)))
                         (push (list :source (namestring source) :target (namestring target) :sha256 hash) *log-copies*)))))))
         (dolist (version '(1 2)) (dolist (mode '(:legacy :resident :paged)) (dolist (size '(128 4096)) (engine-case version mode size))))
         (dolist (version '(1 2)) (dolist (paged '(nil t)) (unix-case version paged))))
    (setf (symbol-function 'arcdocdb.io:durable-flush) original
          (symbol-function 'arcdocdb.local.process.tests::finish-children) finish)))
(ensure (= 400 (length *rows*)))
(with-open-file (out (merge-pathnames (if (equal (uiop:command-line-arguments) '("--runtime-2.6.10")) "samples-2.6.10.lisp" "samples.lisp")
                                    *result-root*) :direction :output :if-exists :error)
  (write (list :kind :conditional-measurements :status :passed :runtime (lisp-implementation-version)
               :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
               :server-driver-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-server.lisp" *result-root*))
               :log-copies (reverse *log-copies*)
               :machine (machine-type) :timer-units internal-time-units-per-second :rows (nreverse *rows*)
               :limits '(:local-microbenchmark :same-final-code-comparison :no-prior-revision-baseline
                         :engine-flush-counts-instrumented :unix-flushes-live-in-server :not-per-request-tail-latency
                         :not-power-loss-qualification)) :stream out :pretty t) (terpri out))
(format t "~S~%" '(:kind :conditional-benchmark :status :passed))
