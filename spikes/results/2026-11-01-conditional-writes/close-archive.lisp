;;;; C4 self-recording closure; a failed verification produces no cleanup authorization.
(require :asdf)
(let ((args (uiop:command-line-arguments)))
  (unless (and (= 4 (length args)) (equal (first args) "--root")
               (equal (nthcdr 2 args) '("--jobs" "1"))
               (equal (truename (second args)) (uiop:pathname-directory-pathname *load-truename*)))
    (error "Closure must explicitly scope compaction to its own result directory with one worker")))
(load "tools/compact-evidence.lisp")
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (copies nil) (compactions nil) (verified 0))
  (labels ((read-data (path)
             (let ((*read-eval* nil))
               (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (with-open-file (in expanded) (read in))))))
           (hash-matches (path hash)
             (or (string= hash (arcdocdb.evidence:file-sha256 path))
                 (arcdocdb.evidence:call-with-evidence-bytes path
                   (lambda (expanded) (string= hash (arcdocdb.evidence:file-sha256 expanded))))))
           (check-copy (entry)
             (unless (hash-matches (pathname (getf entry :target)) (getf entry :sha256))
               (error "Retained byte hash differs: ~A" (getf entry :target))) (incf verified))
           (copy-one (path target)
             (let ((hash (arcdocdb.evidence:file-sha256 path)))
               (ensure-directories-exist target)
               (unless (probe-file target) (uiop:copy-file path target))
               (unless (hash-matches target hash) (error "Final copy differs"))
               (push (list :source (namestring path) :target (namestring target) :sha256 hash) copies)))
           (compact-tree (directory)
             (dolist (path (uiop:directory-files directory))
               (when (or (and (equal "lisp" (pathname-type path)) (> (arcdocdb.evidence:file-bytes path) 65536))
                         (and (member (pathname-type path) '("stdout" "stderr") :test #'equal)
                              (> (arcdocdb.evidence:file-bytes path) 1024)))
                 (push (compact-one path) compactions)))
             (dolist (child (uiop:subdirectories directory)) (compact-tree child))))
    (let ((input (read-data (merge-pathnames "closing-archive-map.lisp" root))))
      (unless (and (eq :explicit-group-closing-input (getf input :kind)) (consp (getf input :commands)))
        (error "Incomplete closure input"))
      (dolist (entry (getf input :commands))
        (let* ((source (merge-pathnames (format nil "spikes/out/~A/" (first entry))))
               (target (merge-pathnames (format nil "~A/" (second entry)) root))
               (record (read-data (merge-pathnames "report.lisp" source))))
          (unless (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency)))
            (error "Closing command did not pass unchanged"))
          (dolist (path (uiop:directory-files source)) (copy-one path (merge-pathnames (file-namestring path) target)))))
      (dolist (worker-root (getf input :worker-roots))
        (dolist (worker (uiop:subdirectories (pathname worker-root)))
          (dolist (path (uiop:directory-files worker))
            (copy-one path (merge-pathnames (format nil "support/~A/~A/~A"
              (car (last (pathname-directory (pathname worker-root))))
              (car (last (pathname-directory worker))) (file-namestring path)) root))))))
    ;; Keep fixture-suite receipts, not intentionally corrupted nested fixture trees.
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((leaf (car (last (pathname-directory directory)))))
        (when (or (search "reader-self-test-" leaf) (search "snapshot-self-test-" leaf)
                  (search "command-archive-collector-self-test-" leaf) (search "evidence-parallel-self-test-" leaf)
                  (and (search "-command-" leaf) (not (probe-file (merge-pathnames "report.lisp" directory)))))
          (dolist (name '("self-test-report.lisp" "report.lisp"))
            (let ((path (merge-pathnames name directory)))
              (when (probe-file path) (copy-one path (merge-pathnames (format nil "support/~A/~A" leaf name) root))))))))
    (when (probe-file #p"spikes/out/ci/")
      (dolist (directory (uiop:subdirectories #p"spikes/out/ci/"))
        (let ((leaf (car (last (pathname-directory directory)))))
          (when (uiop:string-prefix-p "selftest-" leaf)
            (dolist (path (uiop:directory-files directory))
              (copy-one path (merge-pathnames (format nil "support/ci/~A/~A" leaf (file-namestring path)) root)))))))
    (compact-tree root)
    (dolist (name '("initial-archive.lisp" "final-archive.lisp" "benchmark-archive.lisp"
                   "failed-fixture-archive.lisp"))
      (dolist (entry (getf (read-data (merge-pathnames name root)) :copies)) (check-copy entry)))
    (dolist (entry copies) (check-copy entry))
    (with-open-file (out (merge-pathnames "closure.lisp" root) :direction :output :if-exists :error)
      (write (list :kind :conditional-evidence-closure :status :passed :universal-time (get-universal-time)
                   :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                   :input-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "closing-archive-map.lisp" root))
                   :copies (reverse copies) :compactions (reverse compactions) :verified-files verified
                   :hash-method :stored-bytes-or-verified-lossless-expansion
                   :limits '(:negative-self-test-fixture-trees-excluded :no-qualification-inference-from-exit-code-alone))
             :stream out :pretty t) (terpri out))
    (when (> (arcdocdb.evidence:file-bytes (merge-pathnames "closure.lisp" root)) 65536)
      (compact-one (merge-pathnames "closure.lisp" root)))
    (format t "~S~%" (list :kind :conditional-evidence-closure :status :passed :verified-files verified
                           :compacted-files (length compactions)))))
