;;;; C4: independent raw CSN/quantile/sync ledgers; no product library is loaded.
(require :asdf)
(with-open-file (in (merge-pathnames "analysis-definitions.lisp" *load-truename*))
  (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
    (when (eq form :eof) (error "Missing analysis entry point"))
    (if (and (consp form) (member (first form) '(let let*)))
        (progn (unless (eq :eof (read in nil :eof)) (error "Analysis definition boundary")) (return)) (eval form))))
(defpackage #:write-cost-analysis (:use #:cl) (:local-nicknames (#:b #:unix-latency-analysis)))
(in-package #:write-cost-analysis)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :ledger)) (unless truth (error "Write cost analysis: ~S" reason)) truth)
(defun data (path) (b::data path))
(defun key (row) (mapcar (lambda (field) (getf row field)) '(:mode :connections :write-twentieths :maintenance :group-limit)))
(defun valid-server (row state)
  (handler-case
    (let* ((groups (getf state :group-widths)) (count (getf state :sync-calls))
           (ticks (getf state :sync-ticks)) (kinds (getf state :sync-kinds)) (limit (getf row :group-limit))
           (sum (reduce #'+ ticks)))
      (and (= 8 (length groups)) (= count (length ticks) (length kinds))
           (= (getf row :window) (getf state :window)) (eq (getf row :profile) (getf state :profile))
           (= limit (getf state :group-limit)) (member limit '(1 8))
           (= (getf row :writes) (getf state :writes) (loop for n across groups for width from 1 sum (* width n)))
           (= (getf state :strong-groups) (reduce #'+ groups))
           (<= (ceiling (getf row :writes) limit) (getf state :strong-groups) (getf row :writes))
           (>= count (getf state :strong-groups))
           (every (lambda (n) (<= 0 n 2)) kinds) (every (lambda (n) (and (integerp n) (not (minusp n)))) ticks)
           (if (getf state :sync-timed) (and (plusp sum) (<= sum (getf state :wall-ticks))) (zerop sum))
           (equal (getf state :frontier) (list 0 (getf row :frontier-after) 0 (getf row :frontier-after)))
           (eq (getf row :mode) (getf (getf state :index) :mode))
           (or (= limit 8) (= (getf row :writes) (getf state :strong-groups)))))
    (error () nil)))
(defun window-summary (row state)
  (let* ((scale (getf row :ticks-per-second)) (wall (getf row :wall-ticks))
         (sum (reduce #'+ (getf state :sync-ticks))) (count (getf state :sync-calls)))
    (list :window (getf row :window) :operations (getf row :operations) :writes (getf row :writes)
      :ops-per-second (/ (* scale 1d0 (getf row :operations)) wall)
      :p50-us (* 1d6 (/ (b::q row 500) scale)) :p99-us (* 1d6 (/ (b::q row 990) scale))
      :strong-groups (getf state :strong-groups) :group-widths (getf state :group-widths)
      :sync-calls count :sync-timed (getf state :sync-timed) :sync-total-ticks sum
      :sync-us-per-call (when (getf state :sync-timed) (/ (* sum 1d6) count scale))
      :sync-server-wall-share (when (getf state :sync-timed) (/ (* sum 1d0) (getf state :wall-ticks)))
      :server-wall-us (* 1d6 (/ (getf state :wall-ticks) scale))
      :server-cpu-us (* 1d6 (/ (getf state :cpu-ticks) scale))
      :client-allocated (getf row :allocated-bytes) :server-allocated (getf state :allocated-bytes))))
(defun campaign (name)
  (let* ((root (merge-pathnames (uiop:ensure-directory-pathname name) *here*))
         (start (data (merge-pathnames "started.lisp" root))) (done (data (merge-pathnames "completed.lisp" root)))
         (command (first (getf done :command))) (small (equal command "--self-test"))
         (calibration (equal command "--calibrate")) (cases (if small 2 (if calibration 4 12)))
         (repeats (if small 2 (if calibration 6 5))) (rounds (if small 20 100)) (all nil) (operations 0) (seen nil))
    (ensure (and (eq :passed (getf done :status)) (= cases (getf done :cases)) (= (* cases repeats) (getf done :windows))))
    (loop for file in '("bench.lisp" "bench-definitions.lisp" "server.lisp" "common.lisp")
          for field in '(:driver-sha256 :definitions-sha256 :server-sha256 :common-sha256) do
      (ensure (string= (getf start field) (arcdocdb.evidence:file-sha256 (merge-pathnames file *here*))) :driver-identity))
    (dolist (copy (getf done :copies))
      (ensure (arcdocdb.evidence:call-with-evidence-bytes (getf copy :target)
        (lambda (path) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 path)))) :child-bytes))
    (loop for stage from 1 to cases do
      (let* ((states (getf (data (merge-pathnames (format nil "server-~D.lisp" stage) root)) :windows))
             (rows (loop for rep below repeats collect (data (merge-pathnames (format nil "windows/~D-~D.lisp" stage rep) root))))
             (frontier (* 8 (getf (first rows) :connections))) (windows nil) (case-key (key (first rows))))
        (ensure (not (member case-key seen :test #'equal)) :unique-case) (push case-key seen)
        (ensure (= repeats (length states)))
        (loop for row in rows for state in states for rep from 0 do
          (ensure (and (b::valid-row row rounds) (= 2 (getf row :version)) (= 1024 (getf row :document-bytes))
                       (member (getf row :connections) '(1 2 8)) (equal case-key (key row))) :client-row)
          (ensure (valid-server row state) :server-row)
          (ensure (and (= rep (getf row :window)) (= frontier (getf row :frontier-before))))
          (ensure (eq (getf state :sync-timed) (or (not (getf row :calibration)) (oddp rep))) :timing-schedule)
          (setf frontier (getf row :frontier-after)) (incf operations (getf row :operations))
          (push (window-summary row state) windows))
        (setf windows (reverse windows))
        (push (list :key case-key :windows windows
                :median-ops-per-second (b::median (mapcar (lambda (r) (getf r :ops-per-second)) windows))
                :median-p50-us (b::median (mapcar (lambda (r) (getf r :p50-us)) windows))
                :groups (reduce #'+ windows :key (lambda (r) (getf r :strong-groups)))
                :sync-calls (reduce #'+ windows :key (lambda (r) (getf r :sync-calls)))
                :writes (reduce #'+ windows :key (lambda (r) (getf r :writes)))
                :median-sync-wall-share (b::median (loop for r in windows when (getf r :sync-timed) collect (getf r :sync-server-wall-share)))) all)))
    (ensure (= operations (getf done :operations)))
    (list :kind :write-cost-analysis :status :passed :name name :runtime (getf done :runtime) :operations operations :cases (reverse all))))
(defun save-new (name result)
  (let ((path (merge-pathnames name *here*)))
    (if (probe-file path) (ensure (equalp result (data path)) :repeat-analysis)
        (with-open-file (out path :direction :output :if-exists :error) (write result :stream out :pretty t) (terpri out)))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let* ((row (data (merge-pathnames "smoke-02/windows/1-0.lisp" *here*)))
             (state (first (getf (data (merge-pathnames "smoke-02/server-1.lisp" *here*)) :windows))))
        (ensure (valid-server row state))
        (dolist (field '(:writes :strong-groups :sync-calls))
          (let ((bad (copy-list state))) (incf (getf bad field)) (ensure (not (valid-server row bad)))))
        (ensure (not (valid-server row (list :sync-calls 0))))
        (format t "~S~%" '(:kind :write-cost-analysis-self-test :status :passed :negatives 4))))
    ((and (= 2 (length args)) (equal (first args) "--check"))
      (let ((result (campaign (second args))))
        (save-new (format nil "~A-analysis.lisp" (string-right-trim "/" (second args))) result)
        (dolist (case (getf result :cases))
          (format t "~S: ~,1F ops/s, groups ~D writes ~D sync ~D, median sync share ~,3F~%"
            (getf case :key) (getf case :median-ops-per-second) (getf case :groups) (getf case :writes)
            (getf case :sync-calls) (getf case :median-sync-wall-share)))
        (format t "~S~%" '(:kind :write-cost-analysis :status :passed))))
    ((and (= 3 (length args)) (equal (first args) "--compare"))
      (let ((before (campaign (second args))) (after (campaign (third args))) (pairs nil))
        (ensure (equal (getf before :runtime) (getf after :runtime)))
        (loop for left in (getf before :cases) for right in (getf after :cases) do
          (ensure (equal (getf left :key) (getf right :key)))
          (let ((gain (/ (getf right :median-ops-per-second) (getf left :median-ops-per-second))))
            (push (list :key (getf left :key) :gain gain :before left :after right) pairs)
            (format t "~S: ~,3Fx, strong groups ~D -> ~D~%" (getf left :key) gain (getf left :groups) (getf right :groups))))
        (save-new (format nil "comparison-~A.lisp" (string-right-trim "/" (third args)))
          (list :kind :write-cost-comparison :status :passed :cases (reverse pairs)))
        (format t "~S~%" '(:kind :write-cost-comparison :status :passed))))
    (t (error "Use --self-test, --check name/ or --compare before/ after/"))))
