;;;; C4 only. One owner, bounded bursts, real independent service process; no cohort gate.
(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(load "tools/evidence-storage.lisp")
(load (merge-pathnames "common.lisp" *load-truename*))
(in-package #:unix-latency)
(sb-ext:add-package-local-nickname :p :arcdocdb.local.process.tests)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defvar *output*)
(defvar *rows* nil)
(defvar *copies* nil)
(defun document (size)
  (let* ((long (>= size 259)) (header (if long 3 2))
         (doc (make-array size :element-type '(unsigned-byte 8) :initial-element 117)))
    (setf (aref doc 0) (if long #x59 #x58))
    (if long (setf (aref doc 1) (ldb (byte 8 8) (- size header)) (aref doc 2) (ldb (byte 8 0) (- size header)))
        (setf (aref doc 1) (- size header))) doc))
(defun launch-server (runtime version mode maintenance calibration stage)
  (let* ((data (p::subdirectory (format nil "data-~D/" stage)))
         (socket (p::socket-path runtime (format nil "s~D.sock" stage)))
         (child (p::launch (format nil "latency-~D" stage) :server
                  (enough-namestring (merge-pathnames "server.lisp" *here*) (truename "./"))
                  (list (namestring data) (namestring socket) p::*archive-hex* p::*series-hex* (write-to-string version)
                    (if (eq mode :paged) "paged" "resident") (if maintenance "maintenance" "normal")
                    (if calibration "calibration" "plain"))))
         (until (p::deadline p::*process-timeout*)))
    (setf (p::child-socket child) socket)
    (loop
      (p::check-logs child)
      (multiple-value-bind (form end present) (p::first-form (uiop:read-file-string (p::child-stdout child)))
        (declare (ignore end))
        (when present
          (ensure (equal form (list :kind :local-server :state :ready :pid (p::child-pid child))))
          (ensure (p::running-p child)) (setf (p::child-ready child) form) (return)))
      (ensure (p::running-p child) :server-start) (ensure (< (get-internal-real-time) until) :ready-deadline)
      (sleep 0.01))
    (values child socket)))
(defun copy-logs ()
  (dolist (child (reverse p::*children*))
    (dolist (source (list (p::child-stdout child) (p::child-stderr child)))
      (when (probe-file source)
        (let ((target (merge-pathnames (format nil "child-logs/~A" (file-namestring source)) *output*)))
          (ensure (not (probe-file target))) (ensure-directories-exist target) (uiop:copy-file source target)
          (let ((hash (arcdocdb.evidence:file-sha256 source)))
            (ensure (string= hash (arcdocdb.evidence:file-sha256 target)))
            (push (list :source (namestring source) :target (namestring target) :sha256 hash
                    :bytes (arcdocdb.evidence:file-bytes source)) *copies*))))))
  (save-new (merge-pathnames "child-copies.lisp" *output*) (reverse *copies*)))
(defun server-rows (child)
  (let ((text (uiop:read-file-string (p::child-stderr child))) (cursor 0) (rows nil) (*read-eval* nil))
    (loop for start = (search "(:KIND :UNIX-SERVER-WINDOW" text :start2 cursor) while start do
      (multiple-value-bind (row end) (read-from-string text nil nil :start start)
        (push row rows) (setf cursor end))) (reverse rows)))
(defun send-request (client opcode key doc)
  (l::esigi-local-client client :ready)
  (let* ((id (l::local-client-next-id client))
         (until (l::local-until (l::local-now (l::local-client-clock client)) 30))
         (size (l::encode-local-request (l::local-client-output client) id opcode key (when (= opcode 1) doc))))
    (ensure (<= id #xffffffffffffffff)) (ensure (<= size (+ 4 (l::local-client-limit client))))
    (setf (l::local-client-state client) :busy (l::local-client-next-id client) (1+ id))
    (l::transfer-local-client client (l::local-client-output client) 0 size :output until)
    (values id until)))
(defun receive-response (client id until opcode doc)
  (multiple-value-bind (first second) (l::finish-local-client-response client id opcode 0 nil until)
    (setf (l::local-client-state client) :ready)
    (if (= opcode 1) (progn (ensure (typep first '(integer 1 #xffffffffffffffff)) :put-csn) first)
        (progn (ensure (and (eq first :found) (equalp second doc)) :get-value) 0))))
(defun version-oracle (clients keys expected doc)
  (dotimes (i (length clients)) (dotimes (k 8)
    (let ((index (+ (* i 8) k)))
      (multiple-value-bind (status result csn) (l:client-get-version (svref clients i) (svref keys index))
        (ensure (and (eq status :found) (equalp result doc) (= csn (aref expected index))) :per-key-version))))))
(defun csn-oracle (csns frontier)
  (let ((writes (sort (remove 0 csns) #'<)))
    (loop for csn across writes for n from (1+ frontier) do (ensure (= csn n) :consecutive-csn))
    (+ frontier (length writes))))
(defun sample (clients keys expected doc rate rounds rep frontier profile)
  (let* ((width (length clients)) (count (* width rounds))
         (ticks (make-array count :element-type '(unsigned-byte 64)))
         (csns (make-array count :element-type '(unsigned-byte 64) :initial-element 0))
         (begins (make-array width)) (ids (make-array width)) (deadlines (make-array width))
         (opcodes (make-array width)) (hist (histogram :client-runtime)) (writes 0) (bytes 0))
    (l:client-ping (svref clients 0))
    (let ((wall (get-internal-real-time)) (cpu (get-internal-run-time)) (allocated (sb-ext:get-bytes-consed)))
      (dotimes (round rounds)
        (dotimes (i width)
          (let* ((opcode (if (< (mod (+ (* round 7) (* i 7) (* rep 3)) 20) rate) 1 2))
                 (key (svref keys (+ (* i 8) (mod round 8)))))
            (setf (svref opcodes i) opcode (svref begins i) (get-internal-real-time))
            (multiple-value-bind (id until) (send-request (svref clients i) opcode key doc)
              (setf (svref ids i) id (svref deadlines i) until))))
        (dotimes (i width)
          (let* ((index (+ (* round width) i)) (opcode (svref opcodes i))
                 (csn (receive-response (svref clients i) (svref ids i) (svref deadlines i) opcode doc))
                 (duration (- (get-internal-real-time) (svref begins i))))
            (setf (aref ticks index) duration (aref csns index) csn)
            (if (plusp csn) (progn (incf writes) (setf (aref expected (+ (* i 8) (mod round 8))) csn))
                (incf bytes (length doc)))
            (record-ticks hist duration))))
      (let ((elapsed (- (get-internal-real-time) wall)) (used-cpu (- (get-internal-run-time) cpu))
            (consed (- (sb-ext:get-bytes-consed) allocated)))
        (l:client-ping (svref clients 0))
        (let ((next (csn-oracle csns frontier)))
          (ensure (plusp elapsed)) (ensure (= writes (count-if #'plusp csns)))
          (version-oracle clients keys expected doc)
          (values (list :kind :unix-client-window :window rep :profile profile :operations count :writes writes
                    :returned-document-bytes bytes :wall-ticks elapsed :cpu-ticks used-cpu :allocated-bytes consed
                    :ticks-per-second internal-time-units-per-second :frontier-before frontier :frontier-after next
                    :histogram (histogram-row hist ticks) :latency-ticks ticks :write-csns csns) next))))))
(defun verify-server (rows server mode)
  (ensure (= (length rows) (length server)) :window-count)
  (loop for row in rows for state in server do
    (ensure (and (= (getf row :window) (getf state :window)) (eq (getf row :profile) (getf state :profile))
                 (= (getf row :writes) (getf state :writes))
                 (<= (ceiling (getf row :writes) 8) (getf state :strong-groups) (getf row :writes))
                 (equal (getf state :frontier) (list 0 (getf row :frontier-after) 0 (getf row :frontier-after)))
                 (eq mode (getf (getf state :index) :mode))) :server-frontier)
    (when (getf state :profile)
      (ensure (= (getf row :operations) (getf state :responses)) :response-count)
      (ensure (= (getf row :operations)
                 (getf (second (assoc :queue-residence (getf state :phases))) :count)) :queue-count))))
(defun one-case (runtime version mode size width rate maintenance calibration stage smoke)
  (let* ((clients (make-array width :initial-element nil)) (keys (make-array (* width 8)))
         (expected (make-array (* width 8) :element-type '(unsigned-byte 64)))
         (doc (document size)) (frontier 0) (rows nil)
         (case-key (list :version version :mode mode :document-bytes size :connections width
                        :write-twentieths rate :maintenance maintenance :calibration calibration)))
    (multiple-value-bind (child socket) (launch-server runtime version mode maintenance calibration stage)
      (unwind-protect
        (progn
          (dotimes (i width) (setf (svref clients i) (l:connect-local (namestring socket) :versions t)))
          (dotimes (i (length keys))
            (setf (svref keys i) (p::automatic-local-key i)
                  (aref expected i) (l:client-put (svref clients (floor i 8)) (svref keys i) doc))
            (ensure (= (incf frontier) (aref expected i))))
          (version-oracle clients keys expected doc)
          (dotimes (rep (if smoke 2 (if calibration 6 5)))
            (multiple-value-bind (row next) (sample clients keys expected doc rate (if smoke 20 400) rep frontier
                                                   (and calibration (oddp rep)))
              (setf frontier next row (append case-key row)) (push row rows) (push row *rows*)
              (save-new (merge-pathnames (format nil "windows/~D-~D.lisp" stage rep) *output*) row)))
          (p::stop-server child sb-posix:sigterm :latency-benchmark-completed)
          (let ((server (server-rows child))) (verify-server (reverse rows) server mode)
            (save-new (merge-pathnames (format nil "server-~D.lisp" stage) *output*) (list :case case-key :windows server))))
        (loop for client across clients when client do (l:close-local client))))))
(defun self-test ()
  (let ((hist (histogram :client-runtime)) (raw #(0 1 15 256 1000 100000)))
    (loop for n across raw do (record-ticks hist n)) (histogram-row hist raw)
    (ensure (handler-case (progn (histogram-row hist #(1)) nil) (error () t)))
    (ensure (= 5 (csn-oracle #(5 0 4) 3)))
    (ensure (handler-case (progn (csn-oracle #(5 5) 3) nil) (error () t))))
  (dolist (size '(64 1024 60000))
    (arcdocdb.cbor:verifica-struttura-cbor-minima (document size) 0 size (arcdocdb.cbor:crea-spazio-cbor)
      :max-bytes 60000 :max-nodes 60000 :max-depth 100)))
(let* ((args (uiop:command-line-arguments)) (command (first args)) (stage 0)
       (*rows* nil) (*copies* nil) (*output* (merge-pathnames (uiop:ensure-directory-pathname (second args)) *here*))
       (smoke (equal command "--self-test")) (calibration (equal command "--calibrate"))
       (finish (symbol-function 'p::finish-children)))
  (ensure (and (= 2 (length args)) (member command '("--self-test" "--run" "--calibrate") :test #'equal)))
  (ensure (not (probe-file *output*))) (ensure-directories-exist (merge-pathnames ".keep" *output*))
  (save-new (merge-pathnames "started.lisp" *output*)
    (list :kind :unix-latency-started :runtime (lisp-implementation-version) :command args
          :driver-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" *here*))
          :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "server.lisp" *here*))
          :common-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "common.lisp" *here*))))
  (self-test)
  (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
  (unwind-protect
    (p::call-with-run (lambda ()
      (let ((runtime (p::subdirectory "runtime/")))
        (cond
          (smoke (one-case runtime 2 :resident 1024 2 0 nil t (incf stage) t)
                 (one-case runtime 2 :paged 1024 2 10 t t (incf stage) t))
          (calibration (dolist (mode '(:resident :paged)) (dolist (size '(1024 60000)) (dolist (width '(1 8))
            (one-case runtime 2 mode size width 0 nil t (incf stage) nil)))))
          (t (dolist (version '(1 2)) (dolist (mode '(:resident :paged)) (dolist (size '(64 1024 60000))
               (dolist (width '(1 2 4 8)) (one-case runtime version mode size width 0 nil nil (incf stage) nil)))))
             (dolist (mode '(:resident :paged)) (dolist (width '(1 2 4 8)) (dolist (rate '(1 10))
               (one-case runtime 2 mode 1024 width rate nil nil (incf stage) nil))))
             (dolist (mode '(:resident :paged)) (one-case runtime 2 mode 1024 8 10 t nil (incf stage) nil)))))))
    (setf (symbol-function 'p::finish-children) finish))
  (save-new (merge-pathnames "completed.lisp" *output*)
    (list :kind :unix-latency-campaign :status :passed :cases stage :windows (length *rows*)
          :runtime (lisp-implementation-version) :command args :copies (reverse *copies*)))
  (emit-row (list :kind :unix-latency-campaign :status :passed :cases stage :windows (length *rows*))))
