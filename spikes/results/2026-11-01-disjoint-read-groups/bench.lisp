;;;; C4: trusted reusable definitions, bounded mixed-write matrix and independent sync ledgers.
(require :asdf)
(defparameter *selection-file* *load-truename*)
(with-open-file (in (merge-pathnames "bench-definitions.lisp" *load-truename*))
  (let ((count 0))
    (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
      (when (eq form :eof) (error "Missing benchmark entry point"))
      (if (and (consp form) (eq (first form) 'let*))
          (progn (unless (and (> count 20) (eq :eof (read in nil :eof))) (error "Definition boundary")) (return))
          (progn (eval form) (incf count))))))
(in-package #:unix-latency)
(defvar *group-limit* 8)
(defun verify-server (rows server mode)
  (ensure (= (length rows) (length server)))
  (loop for row in rows for state in server do
    (let ((widths (getf state :group-widths)) (count (getf state :sync-calls))
          (ticks (getf state :sync-ticks)) (kinds (getf state :sync-kinds)))
      (ensure (and (= 8 (length widths)) (= count (length ticks) (length kinds))
                   (= (getf row :window) (getf state :window))
                   (eq (getf row :profile) (getf state :profile))
                   (= *group-limit* (getf state :group-limit))
                   (= (getf row :writes) (getf state :writes)
                      (loop for n across widths for width from 1 sum (* width n)))
                   (= (getf state :strong-groups) (reduce #'+ widths))
                   (<= (ceiling (getf row :writes) *group-limit*) (getf state :strong-groups) (getf row :writes))
                   (equal (getf state :frontier) (list 0 (getf row :frontier-after) 0 (getf row :frontier-after)))
                   (eq mode (getf (getf state :index) :mode))))
      (ensure (>= count (getf state :strong-groups)) :sync-covers-groups)
      (ensure (every (lambda (n) (<= 0 n 2)) kinds))
      (if (getf state :sync-timed)
          (ensure (and (every (lambda (tick) (not (minusp tick))) ticks)
                       (or (zerop count) (plusp (reduce #'+ ticks)))) :timed-sync-range)
          (ensure (every #'zerop ticks) :disabled-sync-clock))
      (when (= *group-limit* 1) (ensure (= (getf row :writes) (getf state :strong-groups)))))))
(let* ((args (uiop:command-line-arguments)) (command (first args)) (small (equal command "--self-test"))
       (calibration (equal command "--calibrate")) (*rows* nil) (*copies* nil) (stage 0)
       (*output* (merge-pathnames (uiop:ensure-directory-pathname (second args)) *here*))
       (finish (symbol-function 'p::finish-children)) (launch (symbol-function 'p::launch))
       (sampler (symbol-function 'sample)))
  (ensure (and (= 2 (length args)) (member command '("--self-test" "--run" "--calibrate") :test #'equal)))
  (ensure (not (probe-file *output*))) (ensure-directories-exist (merge-pathnames ".keep" *output*))
  (save-new (merge-pathnames "started.lisp" *output*)
    (list :kind :write-cost-start :command args :runtime (lisp-implementation-version)
      :driver-sha256 (arcdocdb.evidence:file-sha256 cl-user::*selection-file*)
      :definitions-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-definitions.lisp" *here*))
      :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "server.lisp" *here*))
      :common-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "common.lisp" *here*))))
  (self-test)
  (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
  (setf (symbol-function 'p::launch)
    (lambda (name role script arguments &key expected-failure)
      (funcall launch name role script (if (eq role :server) (append arguments (list (write-to-string *group-limit*))) arguments)
               :expected-failure expected-failure)))
  (setf (symbol-function 'sample)
    (lambda (clients keys expected doc rate rounds rep frontier profile)
      (multiple-value-bind (row next) (funcall sampler clients keys expected doc rate (min rounds 100) rep frontier profile)
        (values (append (list :group-limit *group-limit*) row) next))))
  (unwind-protect
    (p::call-with-run (lambda ()
      (let ((runtime (p::subdirectory "runtime/")))
        (cond
          (small (one-case runtime 2 :resident 1024 2 10 nil nil (incf stage) t)
                 (one-case runtime 2 :paged 1024 8 10 t t (incf stage) t))
          (calibration (dolist (mode '(:resident :paged)) (dolist (width '(1 8))
             (one-case runtime 2 mode 1024 width 10 nil t (incf stage) nil))))
          (t (dolist (mode '(:resident :paged)) (dolist (width '(1 8)) (dolist (rate '(1 10))
               (one-case runtime 2 mode 1024 width rate nil nil (incf stage) nil))))
             (dolist (mode '(:resident :paged)) (one-case runtime 2 mode 1024 8 10 t nil (incf stage) nil))
             (let ((*group-limit* 1)) (dolist (mode '(:resident :paged))
               (one-case runtime 2 mode 1024 8 10 nil nil (incf stage) nil))))))))
    (setf (symbol-function 'p::finish-children) finish (symbol-function 'p::launch) launch (symbol-function 'sample) sampler))
  (save-new (merge-pathnames "completed.lisp" *output*)
    (list :kind :write-cost-campaign :status :passed :runtime (lisp-implementation-version) :cases stage
      :windows (length *rows*) :operations (loop for row in *rows* sum (getf row :operations))
      :command args :copies (reverse *copies*)))
  (emit-row (list :kind :write-cost-campaign :status :passed :cases stage :windows (length *rows*))))
