;;;; C4: actual product startup/dispatch, verified primary mode, exact flush count and one lost complete response.
(require :asdf)
(asdf:load-asd (merge-pathnames "../arcdocdb.asd" *load-truename*))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(let ((open (symbol-function 'arcdocdb.engine:apri-motore))
      (dispatch (symbol-function 'arcdocdb.local::local-dispatch))
      (flush (symbol-function 'arcdocdb.io:durable-flush)) (flushes 0)
      (queue-output (symbol-function 'arcdocdb.local::queue-local-output)) (dropped nil)
      (paged (equal "paged" (uiop:getenv "ARCDOCDB_EXPLICIT_CONDITIONAL_MODE"))))
  (setf (symbol-function 'arcdocdb.engine:apri-motore)
        (lambda (&rest args)
          (let ((engine (apply open args)))
            (when paged (arcdocdb.engine:configura-budget-indice-motore engine
                          (getf (arcdocdb.engine:statistiche-indice-motore engine) :reserved-fixed)))
            (let ((mode (getf (arcdocdb.engine:statistiche-indice-motore engine) :mode)))
              (unless (eq mode (if paged :paged :resident)) (error "Wrong primary mode"))
              (format *error-output* "EXPLICIT-CONDITIONAL-MODE ~A~%" mode) (finish-output *error-output*)) engine))
        (symbol-function 'arcdocdb.io:durable-flush)
        (lambda (file) (incf flushes) (funcall flush file))
        (symbol-function 'arcdocdb.local::local-dispatch)
        (lambda (engine connection envelope &optional clock)
          (let ((before flushes))
            (multiple-value-prog1 (funcall dispatch engine connection envelope clock)
              (when (= 7 (arcdocdb.local:envelope-code envelope))
                (format *error-output* "~S~%" (list :kind :explicit-conditional-request :flushes (- flushes before)))
                (finish-output *error-output*))))))
  (when (equal "1" (uiop:getenv "ARCDOCDB_EXPLICIT_CONDITIONAL_DROP_REPLY"))
    (setf (symbol-function 'arcdocdb.local::queue-local-output)
          (lambda (connection size kind now)
            (let ((envelope (arcdocdb.local::local-connection-pending connection)))
              (if (and (not dropped) (eq kind :response) envelope (= 7 (arcdocdb.local:envelope-code envelope)))
                  (progn (setf dropped t) (arcdocdb.local::close-local-connection connection)
                         (format *error-output* "EXPLICIT-CONDITIONAL-RESPONSE-DROPPED~%") (finish-output *error-output*) nil)
                  (funcall queue-output connection size kind now))))))
  (arcdocdb.local::server-cli-main (uiop:command-line-arguments)))
