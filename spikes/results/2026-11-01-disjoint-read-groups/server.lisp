;;;; C4 only: actual production service, count-only groups and optional bounded sync timing.
(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(load (merge-pathnames "common.lisp" *load-truename*))
(in-package #:unix-latency)
(defvar *active* nil) (defvar *arm* nil) (defvar *engine* nil)
(defvar *calibration* nil) (defvar *timed* t) (defvar *window* 0) (defvar *limit* 8)
(defvar *begin* 0) (defvar *cpu* 0) (defvar *allocation* 0)
(defvar *groups* (make-array 8 :element-type '(unsigned-byte 64) :initial-element 0))
(defvar *ticks* (make-array 10000 :element-type '(unsigned-byte 64) :initial-element 0))
(defvar *kinds* (make-array 10000 :element-type '(unsigned-byte 8) :initial-element 0))
(defvar *count* 0)
(defun start-window ()
  (fill *groups* 0) (setf *count* 0 *timed* (or (not *calibration*) (oddp *window*)))
  (setf *begin* (get-internal-real-time) *cpu* (get-internal-run-time) *allocation* (sb-ext:get-bytes-consed) *active* t)
  (incf *window*))
(defun stop-window (engine)
  (let ((wall (- (get-internal-real-time) *begin*)) (cpu (- (get-internal-run-time) *cpu*))
        (allocation (- (sb-ext:get-bytes-consed) *allocation*)))
    (setf *active* nil)
    (emit-row (list :kind :unix-server-window :window (1- *window*) :profile (and *calibration* (oddp (1- *window*)))
      :sync-timed *timed* :group-limit *limit* :wall-ticks wall :cpu-ticks cpu :allocated-bytes allocation
      :ticks-per-second internal-time-units-per-second :strong-groups (reduce #'+ *groups*)
      :writes (loop for n across *groups* for width from 1 sum (* width n)) :group-widths (copy-seq *groups*)
      :sync-calls *count* :sync-ticks (subseq *ticks* 0 *count*) :sync-kinds (subseq *kinds* 0 *count*)
      :frontier (multiple-value-list (e:frontiere-motore engine)) :index (e:statistiche-indice-motore engine)) *error-output*)))
(let ((original (symbol-function 'io:durable-flush)))
  (setf (symbol-function 'io:durable-flush)
    (lambda (file)
      (if (not *active*) (funcall original file)
          (let ((tick (when *timed* (get-internal-real-time)))
                (kind (if (eq file (e::motore-append *engine*)) 0 (if (eq :append (io::file-mode file)) 1 2))))
            (ensure (< *count* (length *ticks*)) :sync-sample-budget)
            (multiple-value-prog1 (funcall original file)
              (setf (aref *ticks* *count*) (if tick (- (get-internal-real-time) tick) 0)
                    (aref *kinds* *count*) kind) (incf *count*)))))))
(let ((dispatch (symbol-function 'l::local-dispatch-command)) (reset (symbol-function 'l::reset-local-input)))
  (setf (symbol-function 'l::local-dispatch-command)
    (lambda (engine connection id opcode status key document)
      (when (= 0 opcode) (if *active* (stop-window engine) (setf *arm* connection)))
      (funcall dispatch engine connection id opcode status key document)))
  (setf (symbol-function 'l::reset-local-input)
    (lambda (connection now) (funcall reset connection now)
      (when (eq connection *arm*) (setf *arm* nil) (start-window)) nil)))
(handler-case
  (let* ((args (uiop:command-line-arguments)) (stopping nil) (open (symbol-function 'e:apri-motore))
         (paged (equal (sixth args) "paged")) (maintenance (equal (seventh args) "maintenance")))
    (ensure (= 9 (length args))) (setf *limit* (parse-integer (ninth args))) (ensure (member *limit* '(1 8)))
    (setf *calibration* (equal (eighth args) "calibration"))
    (setf (symbol-function 'e:apri-motore)
      (lambda (&rest values)
        (setf *engine* (apply open (append values (when maintenance '(:max-file-bytes 131072 :max-records 128)))))
        (when paged (e:configura-budget-indice-motore *engine* (getf (e:statistiche-indice-motore *engine*) :reserved-fixed)))
        (ensure (eq (if paged :paged :resident) (getf (e:statistiche-indice-motore *engine*) :mode))) *engine*))
    (flet ((stop-signal (signal info context) (declare (ignore signal info context)) (setf stopping t)))
      (sb-sys:enable-interrupt sb-posix:sigterm #'stop-signal) (sb-sys:enable-interrupt sb-posix:sigint #'stop-signal)
      (l:serve-local (first args) (l::local-unhex (third args) 16 16) (l::local-unhex (fourth args) 16 16)
        (second args) :create t :version (parse-integer (fifth args)) :max-write-group *limit* :stop (lambda () stopping)
        :observer (lambda (engine phase)
          (when (and *active* (eq phase :after-flush))
            (let ((width (arcdocdb.wal::gruppo-count (e::motore-group engine))))
              (ensure (<= 1 width *limit*)) (incf (aref *groups* (1- width))))) nil)
        :ready (lambda () (emit-row (list :kind :local-server :state :ready :pid (sb-posix:getpid))) nil))))
  (error (condition) (format *error-output* "~&WRITE-COST-SERVER-FAIL ~A: ~A~%" (type-of condition) condition)
    (sb-ext:exit :code 1)))
