;;;; C4: exact base/current inventories, immutable runtime comparison and terminal qualification.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:disjoint-verification (:use #:cl))
(in-package #:disjoint-verification)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :identity)) (unless truth (error "Disjoint qualification: ~S" reason)) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun qualified (record marker)
  (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
       (eql 0 (getf record :exit-code)) (consp (getf record :source-blobs-after))
       (equal (getf record :source-blobs-before) (getf record :source-blobs-after))
       (search marker (getf record :stdout))))
(defun current ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                       (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                           :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-trim '(#\Newline #\Return)
                    (uiop:run-program (append '("git" "hash-object" "--") paths) :output :string)) :separator '(#\Newline))))
    (ensure (= (length paths) (length hashes)))
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(defun base ()
  (sort (loop for line in (uiop:split-string
           (uiop:run-program '("git" "ls-tree" "-r" "--full-tree" "--format=%(objectname)%x09%(path)"
                               "0b81e0335c8f058a5c570db2612a8e64976b1fe5") :output :string) :separator '(#\Newline))
         when (plusp (length line))
         unless (uiop:string-prefix-p "spikes/results/" (subseq line 41))
         collect (list :path (subseq line 41) :git-blob (subseq line 0 40))) #'string< :key (lambda (r) (getf r :path))))
(defun runtime (sources)
  (remove-if-not (lambda (r) (or (equal (getf r :path) "arcdocdb.asd") (uiop:string-prefix-p "src/" (getf r :path)))) sources))
(defun command (name marker)
  (let ((record (data (merge-pathnames (format nil "commands/~A/report.lisp" name) *here*))))
    (ensure (qualified record marker) name) record))
(defparameter *fixture-paths* '("tools/local-conditional-group-server.lisp" "tools/local-conditional-request-server.lisp"
                                "tools/local-read-loss-server.lisp" "tools/local-version-loss-server.lisp"))
(defun without-fixtures (sources)
  (remove-if (lambda (r) (member (getf r :path) *fixture-paths* :test #'equal)) sources))
(defun ok-lines (record)
  (with-input-from-string (in (getf record :stdout))
    (loop for line = (read-line in nil nil) while line when (uiop:string-prefix-p "ok " line) collect line)))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let ((record '(:status :ok :source-consistency :stable :exit-code 0
                      :source-blobs-before (one) :source-blobs-after (one) :stdout "COMPLETE")))
        (ensure (qualified record "COMPLETE"))
        (dolist (change '((:status :running) (:source-consistency :changed) (:exit-code 1)
                           (:source-blobs-after (two)) (:stdout "unfinished")))
          (let ((bad (copy-list record))) (setf (getf bad (first change)) (second change))
            (ensure (not (qualified bad "COMPLETE"))))))
      (ensure (equal '("ok    ONE" "ok    TWO") (ok-lines (list :stdout (format nil "noise~%ok    ONE~%ok    TWO~%")))))
      (ensure (equal '((:path "src/example.lisp" :git-blob "x"))
                     (without-fixtures '((:path "src/example.lisp" :git-blob "x") (:path "tools/local-read-loss-server.lisp" :git-blob "y")))))
      (format t "~S~%" '(:kind :disjoint-identity-self-test :status :passed :negatives 5 :coverage-fixtures 2)))
    ((equal args '("--run"))
      (let ((sources (current)) (original (base)) (receipts nil) (ci nil))
        (dolist (name '("disjoint-baseline" "disjoint-baseline-calibration"))
          (ensure (equal original (getf (command name ":WRITE-COST-CAMPAIGN :STATUS :PASSED") :source-blobs-after)) :base-inventory))
        (dolist (entry '(("disjoint-candidate" ":WRITE-COST-CAMPAIGN :STATUS :PASSED")
                         ("disjoint-candidate-repeat" ":WRITE-COST-CAMPAIGN :STATUS :PASSED")
                         ("disjoint-candidate-calibration" ":WRITE-COST-CAMPAIGN :STATUS :PASSED")
                         ("disjoint-process-02" ":DISJOINT-PROCESS-FOCUSED :STATUS :PASSED")
                         ("disjoint-read-control" ":UNIX-LATENCY-CONTROL :STATUS :PASSED")))
          (let ((record (command (first entry) (second entry))))
            (ensure (equal (runtime sources) (runtime (getf record :source-blobs-after))) :runtime-identity)))
        (let* ((complete (command "disjoint-strict-2.6.10" "build e test: nessun avviso, tutti i controlli superati"))
               (old (getf complete :source-blobs-after))
               (partial (data (merge-pathnames "commands/disjoint-full-2.6.9/report.lisp" *here*)))
               (all (ok-lines complete)) (prefix (ok-lines partial)))
          (ensure (and (eq :failed (getf partial :status)) (eq :stable (getf partial :source-consistency))
                       (equal old (getf partial :source-blobs-before)) (equal old (getf partial :source-blobs-after))
                       (search "Missing exact loss injection" (getf partial :stderr))) :known-fixture-race)
          (ensure (and (> (length all) 1000) (< 0 (length prefix) (length all))
                       (equal prefix (subseq all 0 (length prefix)))) :passed-prefix-identity)
          (ensure (equal (without-fixtures old) (without-fixtures sources)) :only-C4-fixtures-changed)
          (ensure (equal (sort (loop for before in old for after in sources unless (equal before after) collect (getf before :path)) #'string<)
                         *fixture-paths*) :exact-four-fixtures)
          (dolist (name '("disjoint-unix-final-2.6.9" "disjoint-unix-final-2.6.10"))
            (let* ((record (command name ":DISJOINT-UNIX-FINAL :STATUS :PASSED")) (names (ok-lines record)))
              (ensure (equal sources (getf record :source-blobs-after)) :final-Unix-sources)
              (ensure (equal (last all 19) (last names 19)) :complete-Unix-replay)
              (push (list :name name :status :passed :process-cases 19 :source-files (length sources)) receipts)))
          (ensure (>= (+ (length prefix) 19) (length all)) :all-2.6.9-cases-covered)
          (push (list :name :two-runtime-test-coverage :status :passed :complete-2.6.10-cases (length all)
                      :passed-2.6.9-prefix (length prefix) :replayed-Unix-cases 19 :C4-only-delta *fixture-paths*) receipts)
          (dolist (entry '(("disjoint-documentation" "Public Lisp example passed:")
                           ("disjoint-allocation" ":DISJOINT-CLASSIFIER-ALLOCATION :STATUS :PASSED")))
            (let ((record (command (first entry) (second entry))))
              (ensure (equal old (getf record :source-blobs-after)) :unchanged-docs-product-tests)
              (push (list :name (first entry) :status :passed :scope :before-C4-fixture-publication-order-only) receipts))))
        (let ((record (command "disjoint-checks-2.6.9" "11 spike completati")))
          (ensure (equal sources (getf record :source-blobs-after)) :current-static-spike-sources)
          (push (list :name "disjoint-checks-2.6.9" :status :passed :source-files (length sources)) receipts))
        (dolist (directory (uiop:subdirectories (merge-pathnames "commands/" *here*)))
          (let ((record (data (merge-pathnames "report.lisp" directory))))
            (when (and (member "tools/ci.lisp" (getf record :command) :test #'equal)
                       (member "self-test" (getf record :command) :test #'equal))
              (ensure (and (qualified record "PASSED") (equal sources (getf record :source-blobs-after))) :nested-ci)
              (push (namestring directory) ci))))
        (ensure ci :missing-nested-ci)
        (with-open-file (out (merge-pathnames "source-identity.lisp" *here*) :direction :output :if-exists :error)
          (write (list :kind :disjoint-source-identity :status :passed :source-files (length sources)
                       :base-files (length original) :sources sources :receipts (reverse receipts) :nested-ci ci
                       :limits '(:recorded-before-after-identities :serial-local-M1 :not-power-loss)) :stream out :pretty t) (terpri out))
        (format t "~S~%" (list :kind :disjoint-source-identity :status :passed :source-files (length sources)))))
    (t (error "Use --self-test or --run"))))
