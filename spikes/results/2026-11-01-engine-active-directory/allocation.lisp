;;;; C4: large allocation windows and independent counts of directory path construction.
(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(setf asdf:*compile-file-warnings-behaviour* :error asdf:*compile-file-failure-behaviour* :error)
(asdf:load-system "arcdocdb")
(defpackage #:active-directory.allocation (:use #:cl)
  (:local-nicknames (#:e #:arcdocdb.engine) (#:r #:arcdocdb.get.resolver)))
(in-package #:active-directory.allocation)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "ACTIVE allocation oracle failed")) truth)
(defun bytes (n v) (make-array n :element-type '(unsigned-byte 8) :initial-element v))
(defun fresh-root ()
  (loop for serial below 1000 for root = (merge-pathnames
      (format nil "arcdocdb-active-allocation-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
      (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Allocation fixture namespace exhausted"))
(defun one-case (mode width count)
  (let* ((root (fresh-root)) (engine nil) (success nil) (keys (make-array 8)) (ops (make-array 8))
         (document (bytes 2048 117)) (out (make-array 8 :element-type '(unsigned-byte 64)))
         (calls 0) (original (symbol-function 'r::appendi-pagina-attiva)))
    (dotimes (i 8) (setf (svref keys i) (bytes 16 i)
                        (svref ops i) (e:crea-operazione-scrittura :put (svref keys i) document)))
    (unwind-protect
         (progn
           (setf engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :create t :version 2 :clock (lambda () 10)
               :max-file-bytes 67108864 :max-record-bytes 65536 :max-records 8192 :index-capacity 32 :key-arena-bytes 4096
               :index-policy (if (eq mode :legacy) :legacy (e:crea-politica-indice-automatico :budget 8388608 :frames 1))))
           (when (eq mode :paged)
             (e:configura-budget-indice-motore engine (getf (e:statistiche-indice-motore engine) :reserved-fixed))
             (ensure (eq :paged (e:modo-indice-motore engine))))
           (dotimes (i 8) (ensure (= (1+ i) (e:scrivi-documento engine (svref keys i) document))))
           (setf (symbol-function 'r::appendi-pagina-attiva)
                 (lambda (node rank page shift) (incf calls) (funcall original node rank page shift)))
           (sb-ext:gc :full t)
           (let ((allocated (sb-ext:get-bytes-consed)))
             (dotimes (n (/ count width))
               (if (= width 1)
                   (ensure (= (+ n 9) (e:scrivi-documento engine (svref keys (mod n 8)) document)))
                   (progn (e:scrivi-gruppo-documenti engine ops out)
                     (dotimes (i 8) (ensure (= (+ 9 (* n 8) i) (aref out i)))))))
             (let ((total (- (sb-ext:get-bytes-consed) allocated)))
               (format t "~S~%" (list :kind :active-allocation-sample :mode mode :group-size width
                   :operations count :allocated-bytes total :bytes-per-operation (/ total (float count 1d0))
                   :directory-builder-calls calls :builder-calls-per-operation (/ calls count)))))
           (dotimes (i 8)
             (let ((target (bytes 2048 0)))
               (multiple-value-bind (status size) (e:leggi-documento engine (svref keys i) target)
                 (ensure (and (eq :found status) (= size 2048) (equalp target document))))))
           (ensure (equal (list 0 (+ count 8) 0 (+ count 8)) (multiple-value-list (e:frontiere-motore engine))))
           (setf success t))
      (setf (symbol-function 'r::appendi-pagina-attiva) original)
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t)
          (format *error-output* "~&ALLOCATION-ROOT-RETAINED ~A~%" root)))))
(let* ((args (uiop:command-line-arguments)) (small (equal args '("--self-test"))))
  (unless (or small (equal args '("--run"))) (error "Expected --run or --self-test"))
  (format t "~S~%" (list :kind :allocation-driver :sha256-output
    (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
  (dolist (mode (if small '(:resident) '(:legacy :resident :paged)))
    (dolist (width '(1 8)) (one-case mode width (if small 16 4096))))
  (format t "~S~%" (list :kind :active-allocation-campaign :status :passed :self-test small
                         :limits '(:instrumented :TLAB-granularity :not-throughput :not-RSS))))
