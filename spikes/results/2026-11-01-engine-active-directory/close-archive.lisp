;;;; C4 self-recording closure: copy the final verification receipts, then verify every retained copy.
;;;; No recorder is nested around this closure: it writes its own complete copy/compaction/audit receipt.
(load "tools/compact-evidence.lisp")
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (copies nil) (compactions nil) (verified 0))
  (labels ((read-data (path)
             (let ((*read-eval* nil))
               (arcdocdb.evidence:call-with-evidence-bytes path
                 (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
           (hash-matches (target expected)
             (or (string= expected (arcdocdb.evidence:file-sha256 target))
                 (arcdocdb.evidence:call-with-evidence-bytes target
                   (lambda (expanded) (string= expected (arcdocdb.evidence:file-sha256 expanded))))))
           (check-copy (entry)
             (unless (hash-matches (pathname (getf entry :target)) (getf entry :sha256))
               (error "Retained byte hash differs: ~A" (getf entry :target)))
             (incf verified))
           (copy-retained (source destination)
             (let ((hash (arcdocdb.evidence:file-sha256 source)))
               (unless (probe-file destination) (ensure-directories-exist destination) (uiop:copy-file source destination))
               (unless (hash-matches destination hash) (error "Final command copy mismatch"))
               (push (list :source (namestring source) :target (namestring destination) :sha256 hash) copies)))
           (compact-tree (directory)
             (dolist (path (uiop:directory-files directory))
               (when (and (string-equal "lisp" (or (pathname-type path) ""))
                          (> (arcdocdb.evidence:file-bytes path) 65536))
                 (push (compact-one path) compactions)))
             (dolist (subdirectory (uiop:subdirectories directory)) (compact-tree subdirectory))))
    (dolist (entry '(("4002493177-command-61521-0" "late-archive-command" :ok)
                     ("4002493221-command-61590-0" "identity-command" :ok)
                     ("4002493221-command-61592-0" "printed-metrics-command" :ok)
                     ("4002493221-command-61591-0" "support-command" :ok)
                     ("4002493389-command-62100-0" "compaction-command" :ok)
                     ("4002493410-command-62342-0" "development-runtime-path" :failed)
                     ("4002493411-command-62376-0" "current-source-command" :ok)
                     ("4002493465-command-62465-0" "final-checks" :ok)))
      (let* ((source (merge-pathnames (format nil "spikes/out/~A/" (first entry))))
             (target (merge-pathnames (format nil "~A/" (second entry)) root))
             (record (read-data (merge-pathnames "report.lisp" source))))
        (unless (and (eq (third entry) (getf record :status)) (eq :stable (getf record :source-consistency)))
          (error "Final command differs from its expected status or is not source-stable"))
        (dolist (path (uiop:directory-files source))
          (copy-retained path (merge-pathnames (file-namestring path) target)))))
    ;; Preserve actual worker output from the last successful evidence pass.
    (dolist (worker (uiop:subdirectories #p"spikes/out/evidence-check-Y66g9U/"))
      (dolist (path (uiop:directory-files worker))
        (copy-retained path (merge-pathnames
          (format nil "support/evidence-check-closure/~A/~A"
            (car (last (pathname-directory worker))) (file-namestring path)) root))))
    (compact-tree root)
    (dolist (name '("initial-archive.lisp" "final-archive.lisp" "late-archive.lisp" "support-archive.lisp"))
      (dolist (entry (getf (read-data (merge-pathnames name root)) :copies)) (check-copy entry)))
    (dolist (entry copies) (check-copy entry))
    (with-open-file (stream (merge-pathnames "closure.lisp" root) :direction :output :if-exists :error)
      (write (list :kind :active-directory-evidence-closure :status :passed :universal-time (get-universal-time)
             :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
             :copies (reverse copies) :compactions (reverse compactions) :verified-files verified
             :hash-method :stored-bytes-or-verified-lossless-expansion
             :excluded :nested-intentionally-damaged-fixture-trees)
             :stream stream :pretty t) (terpri stream))
    (format t "~S~%" (list :kind :active-directory-evidence-closure :status :passed :verified-files verified
                           :final-command-files (length copies) :compacted-files (length compactions)))))
