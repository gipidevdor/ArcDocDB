;;;; The standard tool verifies gzip round trips; this owned-root pass also compacts smaller raw reports.
(load "tools/compact-evidence.lisp")
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (results nil))
  (labels ((walk (directory)
             (dolist (path (uiop:directory-files directory))
               (when (and (or (string= "report.lisp" (file-namestring path))
                              (string= "source-identity.lisp" (file-namestring path)))
                          (> (arcdocdb.evidence:file-bytes path) 65536))
                 (push (compact-one path) results)))
             (dolist (subdirectory (uiop:subdirectories directory)) (walk subdirectory))))
    (walk root))
  (with-open-file (stream (merge-pathnames "small-record-compaction.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :group-small-record-compaction :status :passed :results (reverse results)) :stream stream :pretty t)
    (terpri stream))
  (format t "~S~%" (list :kind :group-small-record-compaction :status :passed :files (length results)
    :original-bytes (loop for row in results sum (getf row :original-bytes))
    :stored-bytes (loop for row in results sum (getf row :stored-bytes)))))
