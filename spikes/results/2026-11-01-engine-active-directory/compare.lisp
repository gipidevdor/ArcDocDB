;;;; C4: independent before/after and same-code layout aggregation; original samples remain untouched.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "ACTIVE evidence comparison oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path
      (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun forms-of-kind (text kind)
  (let ((pattern (format nil "(:KIND ~S" kind)) (start 0) (forms nil) (*read-eval* nil))
    (loop repeat 10000 for position = (search pattern text :start2 start) while position do
      (multiple-value-bind (form end) (read-from-string text nil nil :start position)
        (ensure (and (listp form) (eq kind (getf form :kind)) (> end position)))
        (push form forms) (setf start end)))
    (reverse forms)))
(defun record (root directory marker sources)
  (let* ((data (read-data (merge-pathnames (format nil "~A/report.lisp" directory) root)))
         (stdout (getf data :stdout)))
    (ensure (and (eq :ok (getf data :status)) (eq :stable (getf data :source-consistency)) (eql 0 (getf data :exit-code))
                 (= sources (length (getf data :source-blobs-after))) (search marker stdout)))
    data))
(defun median (values)
  (let ((sorted (sort (copy-list values) #'<)))
    (ensure (and (plusp (length sorted)) (oddp (length sorted)))) (nth (floor (length sorted) 2) sorted)))
(defun percentile (array percent)
  (let ((sorted (sort (copy-seq array) #'<)))
    (ensure (plusp (length sorted))) (aref sorted (1- (ceiling (* percent (length sorted)) 100)))))
(defun allocation-pairs (before after)
  (let ((old (forms-of-kind (getf before :stdout) :active-allocation-sample))
        (new (forms-of-kind (getf after :stdout) :active-allocation-sample)) (pairs nil))
    (ensure (= 6 (length old) (length new)))
    (dolist (row new)
      (let* ((key (list (getf row :mode) (getf row :group-size)))
             (base (find key old :test #'equal :key (lambda (r) (list (getf r :mode) (getf r :group-size))))))
        (ensure (and base (= 4096 (getf row :operations) (getf base :operations))
                     (= 16384 (getf base :directory-builder-calls)) (zerop (getf row :directory-builder-calls))))
        (push (list :case key :operations 4096 :before-bytes (getf base :allocated-bytes) :after-bytes (getf row :allocated-bytes)
                :before-bytes-per-operation (getf base :bytes-per-operation) :after-bytes-per-operation (getf row :bytes-per-operation)
                :remaining-ratio (/ (float (getf row :allocated-bytes) 1d0) (getf base :allocated-bytes))) pairs)))
    (reverse pairs)))
(defun paired-rates (before after unix)
  (let ((old (getf before (if unix :unix :engine))) (new (getf after (if unix :unix :engine))) (pairs nil))
    (ensure (= (if unix 8 48) (length old) (length new)))
    (dolist (row new)
      (let* ((key (getf row :case)) (base (find key old :test #'equal :key (lambda (r) (getf r :case)))))
        (ensure base)
        (push (list :case key :before-ops-per-second (getf base :median-ops-per-second)
          :after-ops-per-second (getf row :median-ops-per-second)
          :throughput-ratio (/ (getf row :median-ops-per-second) (getf base :median-ops-per-second))
          :before-p99-us (when unix (getf base :median-call-p99-us)) :after-p99-us (when unix (getf row :median-call-p99-us))) pairs)))
    (reverse pairs)))
(defun read-metrics (record)
  (let ((samples (forms-of-kind (getf record :stdout) :active-layout-read-sample)) (buckets nil) (rows nil))
    (ensure (= 240 (length samples)))
    (dolist (sample samples)
      (ensure (and (= 2048 (getf sample :operations)) (= 2048 (length (getf sample :latency-ticks)))
                   (= 1000000 (getf sample :ticks-per-second)) (plusp (getf sample :wall-ticks))
                   (zerop (getf sample :allocated-bytes))))
      (let* ((key (list (getf sample :mode) (getf sample :version) (getf sample :value-bytes)
                        (getf sample :phase) (getf sample :layout)))
             (bucket (assoc key buckets :test #'equal)))
        (unless bucket (setf bucket (cons key nil)) (push bucket buckets)) (push sample (cdr bucket))))
    (ensure (= 48 (length buckets)))
    (dolist (bucket (reverse buckets))
      (let ((items (cdr bucket)))
        (ensure (equal '(0 1 2 3 4) (sort (mapcar (lambda (r) (getf r :repetition)) items) #'<)))
        (push (list :case (car bucket) :median-ops-per-second
            (median (mapcar (lambda (r) (/ 2048000000d0 (getf r :wall-ticks))) items))
            :median-p50-us (median (mapcar (lambda (r) (percentile (getf r :latency-ticks) 50)) items))
            :median-p99-us (median (mapcar (lambda (r) (percentile (getf r :latency-ticks) 99)) items))
            :allocated-bytes (mapcar (lambda (r) (getf r :allocated-bytes)) (reverse items))) rows)))
    (reverse rows)))
(defun read-pairs (rows)
  (let ((pairs nil))
    (dolist (row rows)
      (let ((key (getf row :case)))
        (when (eq (fifth key) :append-only)
          (let ((base (find (append (subseq key 0 4) '(:persistent)) rows :test #'equal :key (lambda (r) (getf r :case)))))
            (ensure base)
            (push (list :case (subseq key 0 4) :persistent-ops-per-second (getf base :median-ops-per-second)
                :append-ops-per-second (getf row :median-ops-per-second)
                :throughput-ratio (/ (getf row :median-ops-per-second) (getf base :median-ops-per-second))
                :persistent-p99-us (getf base :median-p99-us) :append-p99-us (getf row :median-p99-us)) pairs)))))
    (ensure (= 24 (length pairs))) (reverse pairs)))
(let* ((args (uiop:command-line-arguments)) (root (uiop:pathname-directory-pathname *load-truename*)))
  (if (equal args '("--self-test"))
      (progn
        (ensure (= 3 (median '(9 1 3 5 2)))) (ensure (= 8 (percentile #(9 2 8 1 3) 80)))
        (ensure (handler-case (progn (read-metrics (list :stdout "")) nil) (error () t)))
        (ensure (handler-case (progn (forms-of-kind "(:KIND :UNSAFE :X #.(ERROR :BAD))" :unsafe) nil) (error () t)))
        (format t "~S~%" '(:kind :active-comparison-self-test :status :passed)))
      (progn
        (ensure (equal args '("--run")))
        (let* ((before (read-data (merge-pathnames "baseline-metrics.lisp" root)))
               (after (read-data (merge-pathnames "metrics.lisp" root)))
               (old-allocation (record root "baseline-allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED" 1630))
               (allocation (record root "allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED" 1636))
               (read (record root "read-benchmark" ":ACTIVE-LAYOUT-READ-CAMPAIGN :STATUS :PASSED" 1636))
               (reads (read-metrics read))
               (result (list :kind :active-directory-metrics :status :passed
                   :allocation (allocation-pairs old-allocation allocation) :writes (paired-rates before after nil)
                   :unix (paired-rates before after t) :reads reads :read-pairs (read-pairs reads))))
          (ensure (equal (getf allocation :source-blobs-after) (getf read :source-blobs-after)))
          (with-open-file (stream (merge-pathnames "comparison.lisp" root) :direction :output :if-exists :error)
            (write result :stream stream :pretty t) (terpri stream))
          (format t "~S~%" '(:kind :active-directory-comparison :status :passed :allocation-pairs 6
                            :write-pairs 48 :unix-pairs 8 :read-samples 240 :read-pairs 24))))))
