;;;; C4: eight independent synchronous clients; limit 1/8 on the same product code.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:group.local-bench
  (:use #:cl) (:local-nicknames (#:l #:arcdocdb.local) (#:p #:arcdocdb.local.process.tests)))
(in-package #:group.local-bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (value) (unless value (error "Unix group benchmark oracle failed")) value)
(defun document (id)
  (let ((doc (make-array 2048 :element-type '(unsigned-byte 8) :initial-element (+ id 17))))
    (setf (aref doc 0) #x59 (aref doc 1) #x07 (aref doc 2) #xFD) doc))
(defun check-values (client)
  (dotimes (i 8)
    (multiple-value-bind (status actual) (l:client-get client (p::automatic-local-key i))
      (ensure (and (eq :found status) (equalp actual (document i)))))) nil)
(defun histogram (path)
  (let ((counts (make-array 9 :initial-element 0)))
    (with-open-file (stream path)
      (loop for line = (read-line stream nil) while line do
        (when (and (<= 12 (length line)) (string= line "GROUP-FLUSH " :end1 12))
          (let ((n (parse-integer line :start 12 :junk-allowed nil)))
            (ensure (<= 1 n 8)) (incf (svref counts n))))))
    counts))
(defun delta-histogram (after before)
  (map 'simple-vector #'- after before))
(defun wait-eight (semaphore)
  (dotimes (i 8) (ensure (sb-thread:wait-on-semaphore semaphore :timeout 45))))
(defun worker (id socket repetitions count gate ready done results failures)
  (let ((client nil) (announced nil) (completed 0))
    (handler-case
        (unwind-protect
             (progn
               (setf client (l:connect-local (namestring socket)))
               (let ((key (p::automatic-local-key id)) (doc (document id)) (rows (svref results id)))
                 (setf announced t) (sb-thread:signal-semaphore ready)
                 (dotimes (rep repetitions)
                   (ensure (sb-thread:wait-on-semaphore gate :timeout 45))
                   (let* ((row (svref rows rep)) (csns (first row)) (ticks (second row)))
                     (dotimes (n count)
                       (let ((start (get-internal-real-time)))
                         (setf (aref csns n) (l:client-put client key doc)
                               (aref ticks n) (- (get-internal-real-time) start))))
                     (setf (third row) (get-internal-real-time)))
                   (incf completed) (sb-thread:signal-semaphore (svref done rep)))))
          (when client (l:close-local client)))
      (error (condition)
        (setf (svref failures id) condition)
        (unless announced (sb-thread:signal-semaphore ready))
        (loop for rep from completed below repetitions do (sb-thread:signal-semaphore (svref done rep))))))
  :joined)
(defun checked-csns (csns first)
  (let ((sorted (sort (copy-seq csns) #'<)))
    (dotimes (i (length sorted)) (ensure (= (+ first i) (aref sorted i))))) nil)
(defun samples (server socket mode version limit population repetitions per-client)
  (let* ((gate (sb-thread:make-semaphore)) (ready (sb-thread:make-semaphore))
         (done (make-array repetitions)) (results (make-array 8)) (failures (make-array 8 :initial-element nil))
         (threads nil) (first (1+ population)) (operations (* 8 per-client)))
    (dotimes (rep repetitions) (setf (svref done rep) (sb-thread:make-semaphore)))
    (dotimes (i 8)
      (setf (svref results i) (make-array repetitions))
      (dotimes (rep repetitions)
        (setf (svref (svref results i) rep)
              (list (make-array per-client :element-type '(unsigned-byte 64))
                    (make-array per-client :element-type '(unsigned-byte 64)) 0))))
    ;; Negative control detects a duplicate/missing ACK; no product operation is repeated.
    (ensure (handler-case (progn (checked-csns #(1 2 2) 1) nil) (error () t)))
    (unwind-protect
         (progn
           (dotimes (i 8)
             (let ((id i)) (push (sb-thread:make-thread
               (lambda () (worker id socket repetitions per-client gate ready done results failures))
               :name (format nil "group-client-~D" i)) threads)))
           (wait-eight ready) (ensure (every #'null failures))
           (dotimes (rep repetitions)
             (let ((before (histogram (p::child-stderr server))))
               (sb-ext:gc :full t)
               (let ((allocated (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
                 (sb-thread:signal-semaphore gate 8) (wait-eight (svref done rep))
                 (let* ((end (loop for rows across results maximize (third (svref rows rep))))
                        (allocation (- (sb-ext:get-bytes-consed) allocated))
                        (csns (make-array operations :element-type '(unsigned-byte 64)))
                        (ticks (make-array operations :element-type '(unsigned-byte 64)))
                        (flushes (delta-histogram (histogram (p::child-stderr server)) before)))
                   (ensure (every #'null failures)) (ensure (> end start))
                   (dotimes (i 8)
                     (replace csns (first (svref (svref results i) rep)) :start1 (* i per-client))
                     (replace ticks (second (svref (svref results i) rep)) :start1 (* i per-client)))
                   (checked-csns csns first)
                   (ensure (= operations (loop for n from 1 to 8 sum (* n (svref flushes n)))))
                   (when (= limit 1) (ensure (= operations (svref flushes 1))))
                   (format t "~&~S~%" (list :kind :group-unix-sample :mode mode :version version :group-limit limit
                     :repetition rep :clients 8 :value-bytes 2048 :operations operations :wall-ticks (- end start)
                     :ticks-per-second internal-time-units-per-second :client-allocated-bytes allocation
                     :flush-size-histogram flushes :ack-csns csns :roundtrip-ticks ticks))
                   (incf first operations)))))
           (dolist (thread threads) (ensure (eq :joined (sb-thread:join-thread thread :timeout 10 :default :timeout)))))
      ;; A failed parent must release only its own waiting workers before fixture teardown.
      (sb-thread:signal-semaphore gate (* 8 (1+ repetitions)))
      (dolist (thread threads)
        (when (sb-thread:thread-alive-p thread) (sb-thread:join-thread thread :timeout 45 :default :timeout))))) nil)
(defun preserve-logs (server small)
  (dolist (source (list (p::child-stdout server) (p::child-stderr server)))
    (let ((target (merge-pathnames
                   (format nil "unix-logs/~A-~A" (if small "self-test" "benchmark") (file-namestring source))
                   (uiop:pathname-directory-pathname *load-truename*))))
      (ensure (not (probe-file target))) (ensure-directories-exist target) (uiop:copy-file source target))))
(defun one-case (runtime mode version limit stage small)
  (let* ((data (p::subdirectory (format nil "group-bench-~D/" stage)))
         (population (if (eq mode :paged) 1200 8)) (repetitions (if small 1 5)) (count (if small 4 16))
         (budget (when (eq mode :paged) 3400000)))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version stage :create t :index-budget budget
          :script "tools/local-group-server.lisp" :group-limit limit)
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect
             (dotimes (i population)
               (ensure (= (1+ i) (l:client-put client (p::automatic-local-key i) (document (mod i 8))))))
          (l:close-local client)))
      (when (eq mode :paged) (ensure (p::local-automatic-files data)))
      (samples server socket mode version limit population repetitions count)
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect (check-values client) (l:close-local client)))
      (p::stop-server server sb-posix:sigterm :group-benchmark-complete) (preserve-logs server small))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version (+ stage 1000) :index-budget budget)
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect
             (progn (check-values client)
               (ensure (= (+ population (* repetitions count 8) 1)
                          (l:client-put client (p::automatic-local-key 9) (document 1)))))
          (l:close-local client)))
      (p::stop-server server sb-posix:sigterm :group-benchmark-recovered) (preserve-logs server small))))
(let* ((args (uiop:command-line-arguments)) (small (equal args '("--self-test"))) (stage 110))
  (unless (or small (equal args '("--run"))) (error "Expected --run or --self-test"))
  (format t "~&~S~%" (list :kind :benchmark-driver :self-test small :sha256-output
    (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
  (p::call-with-run
   (lambda ()
     (let ((runtime (p::subdirectory "group-bench-runtime/")))
       (dolist (version (if small '(2) '(1 2)))
         (dolist (mode (if small '(:resident) '(:resident :paged)))
           (dolist (limit (if (oddp version) '(1 8) '(8 1)))
             (one-case runtime mode version limit (incf stage) small)))))))
  (format t "~&~S~%" (list :kind :group-unix-benchmark :status :passed :self-test small
      :limits '(:eight-synchronous-clients :2048-byte-CBOR :fixed-concurrency :client-allocation-only :not-loaded-tail))))
