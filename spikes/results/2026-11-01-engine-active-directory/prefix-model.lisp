;;;; SPK-07 variant: independent finite append-only prefix observations; product is not loaded.
(require :asdf)
(format t "~S~%" (list :kind :prefix-model-driver :sha256-output
  (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
(defpackage #:active-prefix.model (:use #:cl))
(in-package #:active-prefix.model)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "Append-only prefix model invariant failed")) truth)
(defstruct state (ends (make-array 3 :initial-element 0)) (limits (make-array 4 :initial-element 0))
  (rows (make-array 3 :initial-element 0)) (prepared 0) (appended 0) (durable 0) (published 0) (fault nil))
(defun clone (state)
  (let ((copy (copy-state state)))
    (setf (state-ends copy) (copy-seq (state-ends state)) (state-limits copy) (copy-seq (state-limits state))
          (state-rows copy) (copy-seq (state-rows state))) copy))
(defun puts-before (mask n) (logcount (logand mask (1- (ash 1 n)))))
(defun plan (mask width)
  (let ((events nil))
    (loop for start from 0 below 3 by width do
      (let ((end (min 3 (+ start width))))
        (loop for i from start below end do
          (when (logbitp i mask) (push (list :row i) events))
          (push (list :end i) events) (push (list :limit i) events) (push (list :prepare i) events))
        (loop for i from start below end do (push (list :append i) events))
        (push (list :flush end) events)
        (loop for i from start below end do (push (list :publish i) events))))
    (coerce (reverse events) 'simple-vector)))
(defun advance (state event mask &optional unsafe)
  (unless unsafe (ensure (not (state-fault state))))
  (destructuring-bind (kind i) event
    (case kind
      (:row (setf (svref (state-rows state) (puts-before mask i)) (+ 11 i)))
      (:end (setf (svref (state-ends state) i) (+ 64 (* 100 (1+ i)))))
      (:limit (setf (svref (state-limits state) (1+ i)) (puts-before mask (1+ i))))
      (:prepare (ensure (= i (state-prepared state))) (incf (state-prepared state)))
      (:append (ensure (and (= i (state-appended state)) (< i (state-prepared state)))) (incf (state-appended state)))
      (:flush (ensure (<= i (state-appended state))) (setf (state-durable state) i))
      (:publish (ensure (and (= i (state-published state)) (< i (state-durable state)))) (incf (state-published state)))
      (otherwise (error "Unknown model event")))) state)
(defun check-root (state mask root phase)
  ;; Expectations come directly from logical input, not the producer's stored boundaries.
  (ensure (<= root (state-published state) (state-durable state)))
  (case phase
    (0 (dotimes (i root) (ensure (= (+ 64 (* 100 (1+ i))) (svref (state-ends state) i)))))
    (1 (dotimes (i (1+ root)) (ensure (= (puts-before mask i) (svref (state-limits state) i)))))
    (2 (let ((row 0)) (dotimes (i root)
         (when (logbitp i mask) (ensure (= (+ 11 i) (svref (state-rows state) row))) (incf row)))))
    (otherwise (error "Unknown reader phase"))) t)
(defun run-model ()
  (let ((schedules 0) (captures 0) (cuts 0))
    (dotimes (mask 8)
      (dolist (width '(1 2 3))
        (let* ((events (plan mask width)) (states (make-array (1+ (length events)))) (current (make-state)))
          (setf (svref states 0) (clone current))
          (dotimes (i (length events))
            (advance current (svref events i) mask) (setf (svref states (1+ i)) (clone current)))
          (dotimes (capture (length states))
            (dotimes (root (1+ (state-published (svref states capture))))
              (incf captures)
              ;; Three reader phases interleave at every nondecreasing future writer boundary.
              (loop for a from capture below (length states) do
                (check-root (svref states a) mask root 0)
                (loop for b from a below (length states) do
                  (check-root (svref states b) mask root 1)
                  (loop for c from b below (length states) do
                    (check-root (svref states c) mask root 2) (incf schedules)))))
            (let ((failed (clone (svref states capture))))
              (setf (state-fault failed) t)
              (let ((before (clone failed)))
                (ensure (handler-case (progn (advance failed '(:row 0) mask) nil) (error () t)))
                (ensure (equalp before failed)))
              (incf cuts))))))
    (let ((state (make-state)))
      (setf (state-published state) 1)
      (ensure (handler-case (progn (check-root state 7 1 0) nil) (error () t))))
    (let ((state (make-state)))
      (loop for event across (plan 7 3) do (advance state event 7))
      (setf (svref (state-rows state) 0) 999)
      (ensure (handler-case (progn (check-root state 7 1 2) nil) (error () t))))
    (let ((state (make-state :fault t)))
      (let ((before (clone state)))
        (advance state '(:row 0) 7 t)
        (ensure (handler-case (progn (ensure (equalp before state)) nil) (error () t)))))
    (format t "~S~%" (list :kind :active-prefix-finite-model :status :passed :input-patterns 8 :group-widths '(1 2 3)
      :captures captures :reader-schedules schedules :incomplete-cuts cuts
      :negative-controls '(:premature-publication :prefix-mutation :missing-fault-admission-guard)
      :limits '(:three-pages :SC-with-explicit-publication :not-weak-memory-proof :not-power-loss)))))
(run-model)
