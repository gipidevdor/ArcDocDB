(let* ((*read-eval* nil) (root (make-pathname :name nil :type nil :defaults *load-truename*))
       (data (with-open-file (stream (merge-pathnames "comparison.lisp" root)) (read stream))))
  (flet ((range (rows)
           (format t "~&ratio range ~,4F .. ~,4F~%"
             (reduce #'min rows :key (lambda (r) (getf r :throughput-ratio)))
             (reduce #'max rows :key (lambda (r) (getf r :throughput-ratio))))))
    (dolist (row (getf data :allocation))
      (format t "~&allocation ~S ~,4F -> ~,4F B/write, reduction ~,4F%~%" (getf row :case)
        (getf row :before-bytes-per-operation) (getf row :after-bytes-per-operation) (* 100d0 (- 1 (getf row :remaining-ratio)))))
    (dolist (width '(1 8))
      (format t "~&writes, width ~D: " width)
      (range (remove-if-not (lambda (r) (= width (fourth (getf r :case)))) (getf data :writes))))
    (format t "~&| Primary | v | Limit | Before op/s | After op/s | Ratio | P99 before ms | P99 after ms |~%|---|---:|---:|---:|---:|---:|---:|---:|~%")
    (dolist (row (getf data :unix))
      (let ((key (getf row :case)))
        (format t "| ~A | ~D | ~D | ~,1F | ~,1F | ~,3F | ~,3F | ~,3F |~%" (first key) (second key) (fourth key)
          (getf row :before-ops-per-second) (getf row :after-ops-per-second) (getf row :throughput-ratio)
          (/ (getf row :before-p99-us) 1000d0) (/ (getf row :after-p99-us) 1000d0))))
    (range (getf data :unix))
    (dolist (phase '(:active :closed))
      (format t "~&~A read layout comparison~%" phase)
      (format t "| Primary | v | Bytes | Persistent op/s | Append op/s | Ratio | P99 persistent us | P99 append us |~%|---|---:|---:|---:|---:|---:|---:|---:|~%")
      (let ((rows (remove-if-not (lambda (r) (eq phase (fourth (getf r :case)))) (getf data :read-pairs))))
        (dolist (row rows)
          (let ((key (getf row :case)))
            (format t "| ~A | ~D | ~D | ~,1F | ~,1F | ~,3F | ~,0F | ~,0F |~%" (first key) (second key) (third key)
              (getf row :persistent-ops-per-second) (getf row :append-ops-per-second) (getf row :throughput-ratio)
              (getf row :persistent-p99-us) (getf row :append-p99-us))))
        (range rows)))))
