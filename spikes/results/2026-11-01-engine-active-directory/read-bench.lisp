;;;; C4: same final code, generic source-layout option injected only during cold M1 construction.
(require :asdf)
(require :sb-posix)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb")
(defpackage #:active-directory.read-bench (:use #:cl)
  (:local-nicknames (#:e #:arcdocdb.engine) (#:a #:arcdocdb.active) (#:r #:arcdocdb.get.resolver)))
(in-package #:active-directory.read-bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (value) (unless value (error "ACTIVE read benchmark oracle failed")) value)
(defun bytes (n v) (make-array n :element-type '(unsigned-byte 8) :initial-element v))
(defun fresh-root ()
  (loop for serial below 1000 for root = (merge-pathnames
      (format nil "arcdocdb-active-read-bench-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
      (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Read fixture namespace exhausted"))
(defun open-engine (root mode layout version create)
  (let ((original (symbol-function 'a:crea-sorgente-get-preparata)) (engine nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'a:crea-sorgente-get-preparata)
             (lambda (controller lease prepared &rest options)
               (setf (getf options :directory-mode) layout)
               (apply original controller lease prepared options)))
           (setf engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :create create :version version :clock (lambda () 10)
               :max-file-bytes 67108864 :max-record-bytes 65536 :max-records 1024 :index-capacity 32 :key-arena-bytes 4096
               :index-policy (if (eq mode :legacy) :legacy (e:crea-politica-indice-automatico :budget 8388608 :frames 1)))))
      (setf (symbol-function 'a:crea-sorgente-get-preparata) original))
    (ensure (eq (not (null (r::sorgente-get-attiva-arena (e::motore-source engine)))) (eq layout :append-only)))
    (when (eq mode :paged)
      (e:configura-budget-indice-motore engine (getf (e:statistiche-indice-motore engine) :reserved-fixed))
      (ensure (eq :paged (e:modo-indice-motore engine))))
    engine))
(defun checked-get (engine keys target id)
  (multiple-value-bind (status size) (e:leggi-documento engine (svref keys id) target)
    (ensure (and (eq :found status) (= size (length target))
                 (= (+ id 17) (aref target 0) (aref target (1- size)))))
    (aref target 0)))
(defun check-all (engine keys size)
  (let ((target (bytes size 0)))
    (dotimes (id 8) (checked-get engine keys target id) (ensure (every (lambda (n) (= n (+ 17 id))) target)))) nil)
(defun sample (engine keys size mode layout version phase repetitions count)
  (let ((target (bytes size 0)))
    (dotimes (i 32) (checked-get engine keys target (mod i 8)))
    (dotimes (rep repetitions)
      (let ((ticks (make-array count :element-type '(unsigned-byte 64))) (sink 0))
        (sb-ext:gc :full t)
        (let ((allocation (sb-ext:get-bytes-consed)) (begin (get-internal-real-time)))
          (dotimes (i count)
            (let ((start (get-internal-real-time)))
              (incf sink (checked-get engine keys target (mod (* i 5) 8)))
              (setf (aref ticks i) (- (get-internal-real-time) start))))
          (let ((elapsed (- (get-internal-real-time) begin)) (allocated (- (sb-ext:get-bytes-consed) allocation)))
            (ensure (and (plusp elapsed) (= sink (* count 41/2))))
            (format t "~S~%" (list :kind :active-layout-read-sample :mode mode :layout layout :version version
                :value-bytes size :phase phase :repetition rep :operations count :wall-ticks elapsed
                :ticks-per-second internal-time-units-per-second :allocated-bytes allocated :latency-ticks ticks))))))
    (check-all engine keys size)))
(defun one-case (mode layout version size small)
  (let ((root (fresh-root)) (engine nil) (success nil) (keys (make-array 8)) (ops (make-array 8))
        (out (make-array 8 :element-type '(unsigned-byte 64))))
    (dotimes (i 8) (setf (svref keys i) (bytes 16 i)))
    (dotimes (i 8) (setf (svref ops i) (e:crea-operazione-scrittura :put (svref keys i) (bytes size (+ i 17)))))
    (unwind-protect
         (progn
           (setf engine (open-engine root mode layout version t))
           (dotimes (round 16)
             (e:scrivi-gruppo-documenti engine ops out)
             (dotimes (i 8) (ensure (= (+ 1 (* round 8) i) (aref out i)))))
           (check-all engine keys size)
           (let ((bad (bytes size 0)))
             (ensure (handler-case (progn (checked-get engine keys bad 0) (ensure (= 255 (aref bad 0))) nil) (error () t))))
           (sample engine keys size mode layout version :active (if small 1 5) (if small 16 2048))
           (ensure (eq :compacted (getf (e:compatta-motore engine :force t) :status)))
           ;; Compaction uses the normal M1 layout. CLOSED reads do not use this fresh ACTIVE arena.
           (sample engine keys size mode layout version :closed (if small 1 5) (if small 16 2048))
           (e:chiudi-motore engine) (setf engine nil)
           (setf engine (open-engine root mode layout version nil)) (check-all engine keys size)
           (ensure (= 129 (e:scrivi-documento engine (svref keys 0) (bytes size 17))))
           (setf success t))
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t)
          (format *error-output* "~&ACTIVE-READ-RETAINED ~A~%" root)))))
(let* ((args (uiop:command-line-arguments)) (small (equal args '("--self-test"))))
  (unless (or small (equal args '("--run"))) (error "Expected --run or --self-test"))
  (format t "~S~%" (list :kind :active-read-driver :sha256-output
    (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
  (dolist (version (if small '(2) '(1 2)))
    (dolist (mode (if small '(:resident) '(:legacy :resident :paged)))
      (dolist (size (if small '(2048) '(2048 60000)))
        (dolist (layout (if (oddp version) '(:persistent :append-only) '(:append-only :persistent)))
          (one-case mode layout version size small)))))
  (format t "~S~%" (list :kind :active-layout-read-campaign :status :passed :self-test small
    :limits '(:same-code-layout-pair :warm-hot-eight-keys :CLOSED-control :not-loaded-tail :not-RSS))))
