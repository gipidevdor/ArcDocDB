(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (x) (unless x (error "Sync metric oracle failed")) x)
(defun median (xs) (let ((sorted (sort (copy-list xs) #'<)))
                    (ensure (= 5 (length sorted))) (third sorted)))
(let* ((*read-eval* nil) (root (uiop:pathname-directory-pathname *load-truename*))
       (data (arcdocdb.evidence:call-with-evidence-bytes (pathname (first (uiop:command-line-arguments)))
               (lambda (path) (with-open-file (stream path) (read stream)))))
       (stdout (getf data :stdout)) (start 0) (samples nil) (buckets nil) (rows nil) (pairs nil))
  (ensure (and (eq :ok (getf data :status)) (eq :stable (getf data :source-consistency))
               (= 1636 (length (getf data :source-blobs-after)))
               (search ":ACTIVE-SYNC-DIAGNOSTIC :STATUS :PASSED" stdout)))
  (loop repeat 10000 for pos = (search "(:KIND :ACTIVE-SYNC-SAMPLE" stdout :start2 start) while pos do
    (multiple-value-bind (form next) (read-from-string stdout nil nil :start pos)
      (push form samples) (setf start next)))
  (ensure (= 80 (length samples)))
  (dolist (sample (reverse samples))
    (ensure (and (= 128 (getf sample :operations)) (= 1000000 (getf sample :ticks-per-second))
                 (= (/ 128 (getf sample :group-size)) (getf sample :canonical-flushes))
                 (<= 0 (getf sample :flush-wall-ticks) (getf sample :wall-ticks))))
    (let* ((key (list (getf sample :mode) (getf sample :group-size) (getf sample :value-bytes) (getf sample :layout)))
           (bucket (assoc key buckets :test #'equal)))
      (unless bucket (setf bucket (cons key nil)) (push bucket buckets)) (push sample (cdr bucket))))
  (ensure (= 16 (length buckets)))
  (dolist (bucket (reverse buckets))
    (let ((items (cdr bucket)))
      (ensure (equal '(0 1 2 3 4) (sort (mapcar (lambda (r) (getf r :repetition)) items) #'<)))
      (push (list :case (car bucket)
          :median-wall-us-per-operation (median (mapcar (lambda (r) (/ (getf r :wall-ticks) 128d0)) items))
          :median-cpu-us-per-operation (median (mapcar (lambda (r) (/ (getf r :cpu-ticks) 128d0)) items))
          :median-flush-share (median (mapcar (lambda (r) (/ (float (getf r :flush-wall-ticks) 1d0) (getf r :wall-ticks))) items))) rows)))
  (setf rows (reverse rows))
  (dolist (row rows)
    (let ((key (getf row :case)))
      (when (eq :append-only (fourth key))
        (let ((base (find (append (subseq key 0 3) '(:persistent)) rows :test #'equal :key (lambda (r) (getf r :case)))))
          (ensure base)
          (push (list :case (subseq key 0 3) :persistent-cpu-us (getf base :median-cpu-us-per-operation)
              :append-cpu-us (getf row :median-cpu-us-per-operation)
              :persistent-wall-us (getf base :median-wall-us-per-operation) :append-wall-us (getf row :median-wall-us-per-operation)
              :persistent-flush-share (getf base :median-flush-share) :append-flush-share (getf row :median-flush-share)) pairs)))))
  (setf pairs (reverse pairs)) (ensure (= 8 (length pairs)))
  (with-open-file (stream (merge-pathnames "sync-metrics.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :active-sync-metrics :status :passed :samples 80 :rows rows :pairs pairs) :stream stream :pretty t)
    (terpri stream))
  (format t "| Primary | Width | Bytes | CPU persistent us/op | CPU append us/op | Flush persistent % | Flush append % |~%|---|---:|---:|---:|---:|---:|---:|~%")
  (dolist (pair pairs)
    (let ((key (getf pair :case)))
      (format t "| ~A | ~D | ~D | ~,2F | ~,2F | ~,2F | ~,2F |~%" (first key) (second key) (third key)
        (getf pair :persistent-cpu-us) (getf pair :append-cpu-us)
        (* 100 (getf pair :persistent-flush-share)) (* 100 (getf pair :append-flush-share)))))
  (format t "~S~%" (list :kind :active-sync-summary :status :passed :samples 80 :pairs 8
    :minimum-flush-share (reduce #'min rows :key (lambda (r) (getf r :median-flush-share)))
    :maximum-flush-share (reduce #'max rows :key (lambda (r) (getf r :median-flush-share))))))
