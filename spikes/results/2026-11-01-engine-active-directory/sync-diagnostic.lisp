;;;; C4 follow-up: ordinary strong writes, separate process CPU and canonical flush wall duration.
(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb")
(defpackage #:active-sync.diagnostic (:use #:cl)
  (:local-nicknames (#:e #:arcdocdb.engine) (#:a #:arcdocdb.active) (#:r #:arcdocdb.get.resolver)))
(in-package #:active-sync.diagnostic)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "ACTIVE sync diagnostic oracle failed")) truth)
(defun bytes (n v) (make-array n :element-type '(unsigned-byte 8) :initial-element v))
(defun fresh-root ()
  (loop for serial below 1000 for root = (merge-pathnames
      (format nil "arcdocdb-active-sync-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
      (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Sync fixture namespace exhausted"))
(defun open-engine (root mode layout)
  (let ((original (symbol-function 'a:crea-sorgente-get-preparata)) (engine nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'a:crea-sorgente-get-preparata)
                 (lambda (controller lease prepared &rest options)
                   (setf (getf options :directory-mode) layout) (apply original controller lease prepared options)))
           (setf engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :create t :version 2 :clock (lambda () 10)
               :max-file-bytes 67108864 :max-record-bytes 65536 :max-records 2048 :index-capacity 32 :key-arena-bytes 4096
               :index-policy (e:crea-politica-indice-automatico :budget 8388608 :frames 1))))
      (setf (symbol-function 'a:crea-sorgente-get-preparata) original))
    (ensure (eq (eq layout :append-only) (not (null (r::sorgente-get-attiva-arena (e::motore-source engine))))))
    (when (eq mode :paged)
      (e:configura-budget-indice-motore engine (getf (e:statistiche-indice-motore engine) :reserved-fixed))
      (ensure (eq :paged (e:modo-indice-motore engine)))) engine))
(defun sample (engine keys doc ops out width operations rep mode layout first)
  (let ((original (symbol-function 'arcdocdb.io:durable-flush)) (flushes 0) (sync-ticks 0))
    (sb-ext:gc :full t)
    (unwind-protect
         (progn
           (setf (symbol-function 'arcdocdb.io:durable-flush)
                 (lambda (file)
                   (if (eq file (e::motore-append engine))
                       (let ((start (get-internal-real-time)))
                         (multiple-value-prog1 (funcall original file)
                           (incf sync-ticks (- (get-internal-real-time) start)) (incf flushes)))
                       (funcall original file))))
           (let ((start (get-internal-real-time)) (cpu (get-internal-run-time)))
             (dotimes (n (/ operations width))
               (if (= width 1)
                   (ensure (= (+ first n) (e:scrivi-documento engine (svref keys (mod n 8)) doc)))
                   (progn (e:scrivi-gruppo-documenti engine ops out)
                     (dotimes (i 8) (ensure (= (+ first (* n 8) i) (aref out i)))))))
             (let ((cpu-ticks (- (get-internal-run-time) cpu)) (elapsed (- (get-internal-real-time) start)))
               (ensure (and (= flushes (/ operations width)) (<= 0 sync-ticks elapsed) (plusp elapsed)))
               (format t "~S~%" (list :kind :active-sync-sample :mode mode :layout layout :value-bytes (length doc)
                   :group-size width :repetition rep :operations operations :wall-ticks elapsed :cpu-ticks cpu-ticks
                   :canonical-flushes flushes :flush-wall-ticks sync-ticks :ticks-per-second internal-time-units-per-second)))))
      (setf (symbol-function 'arcdocdb.io:durable-flush) original))))
(defun one-case (mode layout width size small)
  (let ((root (fresh-root)) (engine nil) (success nil) (keys (make-array 8)) (ops (make-array 8))
        (out (make-array 8 :element-type '(unsigned-byte 64))) (doc (bytes size 117))
        (count (if small 16 128)) (repetitions (if small 1 5)) (csn 8))
    (dotimes (i 8) (setf (svref keys i) (bytes 16 i) (svref ops i) (e:crea-operazione-scrittura :put (svref keys i) doc)))
    (unwind-protect
         (progn
           (setf engine (open-engine root mode layout))
           (e:scrivi-gruppo-documenti engine ops out)
           (dotimes (i 8) (ensure (= (1+ i) (aref out i))))
           (dotimes (rep repetitions)
             (sample engine keys doc ops out width count rep mode layout (1+ csn)) (incf csn count))
           (let ((target (bytes size 0)))
             (dotimes (i 8)
               (multiple-value-bind (status length) (e:leggi-documento engine (svref keys i) target)
                 (ensure (and (eq :found status) (= size length) (equalp target doc))))))
           (ensure (equal (list 0 csn 0 csn) (multiple-value-list (e:frontiere-motore engine)))) (setf success t))
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t)
          (format *error-output* "~&SYNC-ROOT-RETAINED ~A~%" root)))))
(let* ((args (uiop:command-line-arguments)) (small (equal args '("--self-test"))))
  (unless (or small (equal args '("--run"))) (error "Expected --run or --self-test"))
  (format t "~S~%" (list :kind :active-sync-driver :sha256-output
    (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
  (dolist (mode (if small '(:resident) '(:resident :paged)))
    (dolist (width (if small '(8) '(1 8)))
      (dolist (size (if small '(2048) '(2048 60000)))
        (dolist (layout (if (= width 1) '(:persistent :append-only) '(:append-only :persistent)))
          (one-case mode layout width size small)))))
  (format t "~S~%" (list :kind :active-sync-diagnostic :status :passed :self-test small
    :limits '(:instrumented-follow-up :strong-durability-unchanged :process-CPU-includes-kernel :not-isolated-function-cost))))
