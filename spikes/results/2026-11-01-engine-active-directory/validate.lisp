;;;; C4: validate complete campaigns, exact historical/final source identities and measurement driver hashes.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "ACTIVE qualification identity oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path
      (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun require-record (root name marker count)
  (let ((data (read-data (merge-pathnames (format nil "~A/report.lisp" name) root))))
    (ensure (and (eq :ok (getf data :status)) (eq :stable (getf data :source-consistency)) (eql 0 (getf data :exit-code))
                 (= count (length (getf data :source-blobs-after))) (search marker (getf data :stdout)))) data))
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (progn
        (ensure (handler-case (progn (ensure nil) nil) (error () t)))
        ;; This prior explicitly interrupted process returned zero; a completion marker must still reject it.
        (let* ((old (read-data "spikes/results/2026-10-31-engine-group-commit/interrupted-pre-merge-2.6.10/report.lisp")))
          (ensure (eql 0 (getf old :exit-code)))
          (ensure (not (search "build e test: nessun avviso, tutti i controlli superati" (getf old :stdout)))))
        (format t "~S~%" '(:kind :active-identity-self-test :status :passed :incomplete-zero-exit :excluded)))
      (progn
        (ensure (equal args '("--run")))
        (let ((before nil) (after nil) (commands nil) (drivers nil))
          (dolist (entry '(("baseline-allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED")
                           ("baseline-engine" ":GROUP-ENGINE-BENCHMARK :STATUS :PASSED")
                           ("baseline-unix" ":GROUP-UNIX-BENCHMARK :STATUS :PASSED")))
            (let* ((record (require-record root (first entry) (second entry) 1630)) (source (getf record :source-blobs-after)))
              (if before (ensure (equal before source)) (setf before source))
              (push (list :name (first entry) :variant :baseline :status :passed) commands)))
          (ensure (equal before (getf (read-data "spikes/results/2026-10-31-engine-group-commit/source-identity.lisp") :sources)))
          (dolist (entry '(("full-check-2.6.9" "build e test: nessun avviso, tutti i controlli superati")
                           ("strict-2.6.10" "build e test: nessun avviso, tutti i controlli superati")
                           ("documentation" "Public Lisp example passed:")
                           ("allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED")
                           ("engine-benchmark" ":GROUP-ENGINE-BENCHMARK :STATUS :PASSED")
                           ("unix-benchmark" ":GROUP-UNIX-BENCHMARK :STATUS :PASSED")
                           ("read-benchmark" ":ACTIVE-LAYOUT-READ-CAMPAIGN :STATUS :PASSED")
                           ("sync-diagnostic" ":ACTIVE-SYNC-DIAGNOSTIC :STATUS :PASSED")))
            (let* ((record (require-record root (first entry) (second entry) 1636)) (source (getf record :source-blobs-after)))
              (if after (ensure (equal after source)) (setf after source))
              (push (list :name (first entry) :variant :final :status :passed) commands)))
          (dolist (entry '(("allocation.lisp" "baseline-allocation" "allocation")
                           ("bench.lisp" "baseline-engine" "engine-benchmark")
                           ("local-bench.lisp" "baseline-unix" "unix-benchmark")
                           ("read-bench.lisp" "read-benchmark") ("prefix-model.lisp" "prefix-model")
                           ("sync-diagnostic.lisp" "sync-diagnostic")))
            (let ((hash (arcdocdb.evidence:file-sha256 (merge-pathnames (first entry) root))))
              (dolist (name (rest entry))
                (ensure (search hash (getf (read-data (merge-pathnames (format nil "~A/report.lisp" name) root)) :stdout))))
              (push (list :path (first entry) :sha256 hash) drivers)))
          (dolist (name '("compare.lisp" "summarize-groups.lisp" "validate.lisp" "archive.lisp"))
            (push (list :path name :sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames name root))) drivers))
          (let ((metrics (read-data (merge-pathnames "comparison.lisp" root))))
            (ensure (and (= 6 (length (getf metrics :allocation))) (= 48 (length (getf metrics :writes)))
                         (= 8 (length (getf metrics :unix))) (= 48 (length (getf metrics :reads)))
                         (= 24 (length (getf metrics :read-pairs))))))
          (with-open-file (stream (merge-pathnames "source-identity.lisp" root) :direction :output :if-exists :error)
            (write (list :kind :active-directory-qualified-identity :status :passed :baseline-source-files 1630 :source-files 1636
                         :campaigns (reverse commands) :drivers (reverse drivers) :baseline-sources before :sources after)
                   :stream stream :pretty t) (terpri stream))
          (format t "~S~%" '(:kind :active-directory-evidence-validation :status :passed
                             :baseline-campaigns 3 :final-campaigns 8 :final-source-files 1636))))))
