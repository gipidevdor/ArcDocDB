;;;; C4: immutable historical metrics and same-final-code paired executor observations.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Group append metrics oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil)) (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun forms-of-kind (text kind)
  (let ((marker (format nil "(:KIND ~S" kind)) (start 0) (out nil) (*read-eval* nil))
    (loop repeat 10000 for at = (search marker text :start2 start) while at do
      (multiple-value-bind (form next) (read-from-string text nil nil :start at)
        (ensure (and (eq kind (getf form :kind)) (> next at))) (push form out) (setf start next))) (reverse out)))
(defun median (numbers)
  (ensure (and (plusp (length numbers)) (oddp (length numbers))))
  (nth (floor (length numbers) 2) (sort (copy-list numbers) #'<)))
(defun require-record (root name marker count)
  (let ((record (read-data (merge-pathnames (format nil "~A/report.lisp" name) root))))
    (ensure (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
                 (eql 0 (getf record :exit-code)) (= count (length (getf record :source-blobs-after)))
                 (search marker (getf record :stdout)))) record))
(defun rate-pairs (old new expected)
  (ensure (= expected (length old) (length new)))
  (loop for row in new for key = (getf row :case)
    for before = (find key old :key (lambda (r) (getf r :case)) :test #'equal) do (ensure before)
    collect (list :case key :before-ops-per-second (getf before :median-ops-per-second)
        :after-ops-per-second (getf row :median-ops-per-second)
        :ratio (/ (getf row :median-ops-per-second) (getf before :median-ops-per-second))
        :before-p99-us (getf before :median-call-p99-us) :after-p99-us (getf row :median-call-p99-us))))
(defun allocation-pairs (old new)
  (ensure (= 6 (length old) (length new)))
  (loop for row in new for key = (list (getf row :mode) (getf row :group-size))
    for before = (find key old :key (lambda (r) (list (getf r :mode) (getf r :group-size))) :test #'equal) do
      (ensure (and before (= 4096 (getf before :operations) (getf row :operations))
                   (zerop (getf row :directory-builder-calls)) (zerop (getf before :directory-builder-calls))))
    collect (list :case key :before-bytes-per-operation (getf before :bytes-per-operation)
                  :after-bytes-per-operation (getf row :bytes-per-operation))))
(defun executor-rows (samples)
  (ensure (= 100 (length samples)))
  (let ((rows nil))
    (dolist (size '(128 2048 6144 8192 60000))
      (dolist (width '(1 8))
        (dolist (method '(:sequential :staged))
          (let ((cell (remove-if-not (lambda (s) (and (= size (getf s :value-bytes))
                            (= width (getf s :width)) (eq method (getf s :method)))) samples)))
            (ensure (= 5 (length cell)))
            (ensure (equal '(0 1 2 3 4) (sort (mapcar (lambda (s) (getf s :repetition)) cell) #'<)))
            (dolist (sample cell)
              (ensure (and (= 128 (getf sample :operations)) (= 1000000 (getf sample :ticks-per-second))
                           (= (/ 128 width) (getf sample :strong-flushes))
                           (= (if (and (eq method :staged) (= width 8) (<= (* 8 (+ size 96)) 65536)) 16 128)
                              (getf sample :append-calls)))))
            (push (list :case (list size width method)
                :append-cpu-us-per-group (median (mapcar (lambda (s) (/ (* 1d0 width (getf s :append-cpu-ticks)) 128)) cell))
                :cpu-us-per-op (median (mapcar (lambda (s) (/ (getf s :cpu-ticks) 128d0)) cell))
                :ops-per-second (median (mapcar (lambda (s) (/ 128000000d0 (getf s :wall-ticks))) cell))) rows)))))
    (reverse rows)))
(defun executor-pairs (rows)
  (let ((pairs nil))
    (dolist (row rows)
      (let ((key (getf row :case)))
        (when (eq :staged (third key))
          (let ((old (find (list (first key) (second key) :sequential) rows :test #'equal :key (lambda (r) (getf r :case)))))
            (ensure old)
            (push (list :case (subseq key 0 2) :sequential old :staged row
                        :append-cpu-ratio (/ (getf row :append-cpu-us-per-group) (getf old :append-cpu-us-per-group))
                        :whole-cpu-ratio (/ (getf row :cpu-us-per-op) (getf old :cpu-us-per-op))
                        :throughput-ratio (/ (getf row :ops-per-second) (getf old :ops-per-second))) pairs)))))
    (ensure (= 10 (length pairs))) (reverse pairs)))
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (args (uiop:command-line-arguments))
       (prior (merge-pathnames "../2026-11-01-engine-active-directory/" root)))
  (if (equal args '("--self-test"))
      (progn
        (ensure (= 3 (median '(9 1 3))))
        (ensure (handler-case (progn (median '(1 2)) nil) (error () t)))
        (ensure (handler-case (progn (rate-pairs (list (list :case '(a))) (list (list :case '(b))) 1) nil) (error () t)))
        (ensure (handler-case (progn (executor-rows nil) nil) (error () t)))
        (ensure (handler-case (progn (forms-of-kind "(:KIND :BAD :X #.(ERROR :BAD))" :bad) nil) (error () t)))
        (format t "~S~%" '(:kind :group-append-analysis-self-test :status :passed)))
      (progn
        (ensure (equal args '("--run")))
        (let* ((old (read-data (merge-pathnames "metrics.lisp" prior))) (new (read-data (merge-pathnames "metrics.lisp" root)))
               (old-allocation (require-record prior "allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED" 1636))
               (new-allocation (require-record root "allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED" 1640))
               (executor (require-record root "executor-benchmark" ":GROUP-APPEND-EXECUTOR-BENCHMARK :STATUS :PASSED" 1640))
               (allocation (allocation-pairs (forms-of-kind (getf old-allocation :stdout) :active-allocation-sample)
                                            (forms-of-kind (getf new-allocation :stdout) :active-allocation-sample)))
               (writes (rate-pairs (getf old :engine) (getf new :engine) 48))
               (unix (rate-pairs (getf old :unix) (getf new :unix) 8))
               (paired (executor-pairs (executor-rows (forms-of-kind (getf executor :stdout) :group-append-executor-sample)))))
          (with-open-file (stream (merge-pathnames "comparison.lisp" root) :direction :output :if-exists :error)
            (write (list :kind :group-append-comparison :status :passed
                         :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                         :allocation allocation :engine writes :unix unix :executor paired)
                   :stream stream :pretty t) (terpri stream))
          (dolist (row allocation) (format t "allocation ~S ~,4F -> ~,4F B/op~%" (getf row :case)
                                    (getf row :before-bytes-per-operation) (getf row :after-bytes-per-operation)))
          (dolist (pair paired)
            (format t "executor ~S append CPU ratio ~,4F, whole CPU ratio ~,4F, wall ratio ~,4F~%"
              (getf pair :case) (getf pair :append-cpu-ratio) (getf pair :whole-cpu-ratio) (getf pair :throughput-ratio)))
          (dolist (rows (list writes unix))
            (format t "~D historical pairs, throughput ratio ~,4F .. ~,4F~%" (length rows)
              (reduce #'min rows :key (lambda (r) (getf r :ratio))) (reduce #'max rows :key (lambda (r) (getf r :ratio)))))
          (format t "~S~%" '(:kind :group-append-analysis :status :passed :engine-pairs 48 :unix-pairs 8 :executor-pairs 10))))))
