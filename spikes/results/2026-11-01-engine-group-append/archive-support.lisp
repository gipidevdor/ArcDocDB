(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (copies nil))
  (labels ((copy-one (source target)
             (when (probe-file target) (error "Support archive target exists"))
             (ensure-directories-exist target) (uiop:copy-file source target)
             (let ((hash (arcdocdb.evidence:file-sha256 source)))
               (unless (string= hash (arcdocdb.evidence:file-sha256 target)) (error "Support byte mismatch"))
               (push (list :source (namestring source) :target (namestring target) :sha256 hash) copies))))
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((leaf (car (last (pathname-directory directory)))))
        (when (or (search "command-archive-collector-self-test-" leaf)
                  (search "reader-self-test-" leaf) (search "snapshot-self-test-" leaf)
                  (search "evidence-parallel-self-test-" leaf)
                  (and (search "-command-" leaf) (not (probe-file (merge-pathnames "report.lisp" directory)))))
          (dolist (name '("self-test-report.lisp" "report.lisp"))
            (let ((source (merge-pathnames name directory)))
              (when (probe-file source)
                (copy-one source (merge-pathnames (format nil "support/~A/~A" leaf name) root))))))))
    ;; These are the final evidence reader's actual worker diagnostics, not its negative fixture trees.
    (dolist (worker (uiop:subdirectories #p"spikes/out/evidence-check-PviZ3v/"))
      (dolist (source (uiop:directory-files worker))
        (copy-one source (merge-pathnames
          (format nil "support/evidence-check-final/~A/~A" (car (last (pathname-directory worker))) (file-namestring source)) root)))))
  (with-open-file (stream (merge-pathnames "support-archive.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :group-append-support-archive :status :passed :copies (reverse copies)) :stream stream :pretty t) (terpri stream))
  (format t "~S~%" (list :kind :group-append-support-archive :status :passed :files (length copies))))
