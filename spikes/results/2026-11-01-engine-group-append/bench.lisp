;;;; C4: serial durability-equivalent experiment, eight immutable hot-key inputs.
(require :asdf)
(require :sb-posix)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb")
(defpackage #:group.bench (:use #:cl) (:local-nicknames (#:e #:arcdocdb.engine)))
(in-package #:group.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (value) (unless value (error "Group benchmark oracle failed")) value)
(defun bytes (n &optional (v 0)) (make-array n :element-type '(unsigned-byte 8) :initial-element v))
(defun fresh-root ()
  (loop for serial below 1000 for root = (merge-pathnames
        (format nil "arcdocdb-group-bench-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
        (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Fixture namespace exhausted"))
(defun open-engine (root mode version create)
  (let ((engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :create create :version version
                  :clock (lambda () 10) :index-capacity 32 :key-arena-bytes 4096
                  :max-file-bytes 67108864 :max-record-bytes 65536 :max-records 2048
                  :index-policy (if (eq mode :legacy) :legacy
                      (e:crea-politica-indice-automatico :budget 8388608 :frames 1)))))
    (when (eq mode :paged)
      (e:configura-budget-indice-motore engine (getf (e:statistiche-indice-motore engine) :reserved-fixed))
      (ensure (eq :paged (e:modo-indice-motore engine))))
    engine))
(defun check-values (engine keys values)
  (let ((target (bytes (length (svref values 0)))))
    (dotimes (i 8)
      (multiple-value-bind (status size) (e:leggi-documento engine (svref keys i) target)
        (ensure (and (eq :found status) (= size (length target)) (equalp target (svref values i)))))))
  nil)
(defun sample (engine keys values groups width first operations rep mode version)
  (let* ((calls (/ operations width)) (ticks (make-array calls :element-type '(unsigned-byte 64)))
         (output (make-array 8 :element-type '(unsigned-byte 64))) (flushes 0)
         (original (symbol-function 'arcdocdb.io:durable-flush)))
    (sb-ext:gc :full t)
    (unwind-protect
         (progn
           (setf (symbol-function 'arcdocdb.io:durable-flush)
                 (lambda (file) (when (eq file (e::motore-append engine)) (incf flushes)) (funcall original file)))
           (let ((allocated (sb-ext:get-bytes-consed)) (begin (get-internal-real-time)))
             (dotimes (n calls)
               (let* ((key-id (mod (* n width) 8)) (start (get-internal-real-time)))
                 (if (= width 1)
                     (setf (aref output 0) (e:scrivi-documento engine (svref keys key-id) (svref values key-id)))
                     (e:scrivi-gruppo-documenti engine (svref groups key-id) output :count width))
                 (setf (aref ticks n) (- (get-internal-real-time) start))
                 (dotimes (i width) (ensure (= (+ first (* n width) i) (aref output i))))))
             (let ((elapsed (- (get-internal-real-time) begin)) (allocation (- (sb-ext:get-bytes-consed) allocated)))
               (ensure (and (plusp elapsed) (= calls flushes)))
               (format t "~&~S~%" (list :kind :group-engine-sample :mode mode :version version
                   :value-bytes (length (svref values 0)) :group-size width :repetition rep :operations operations
                   :api-calls calls :canonical-strong-flushes flushes :wall-ticks elapsed
                   :ticks-per-second internal-time-units-per-second :allocated-bytes allocation :api-call-ticks ticks)))))
      (setf (symbol-function 'arcdocdb.io:durable-flush) original)))
  (check-values engine keys values))
(defun one-case (mode version size width repetitions operations)
  (let ((root (fresh-root)) (engine nil) (success nil) (keys (make-array 8))
        (values (make-array 8)) (groups (make-array 8)) (csn 8))
    (dotimes (i 8) (setf (svref keys i) (bytes 16 i) (svref values i) (bytes size (+ i 17))))
    (dotimes (start 8)
      (setf (svref groups start) (make-array 8))
      (dotimes (i 8)
        (let ((id (mod (+ start i) 8)))
          (setf (svref (svref groups start) i) (e:crea-operazione-scrittura :put (svref keys id) (svref values id))))))
    (unwind-protect
         (progn
           (setf engine (open-engine root mode version t))
           (dotimes (i 8) (ensure (= (1+ i) (e:scrivi-documento engine (svref keys i) (svref values i)))))
           (check-values engine keys values)
           ;; Deliberately false expected bytes must be detected, outside every timing window.
           (let ((bad (copy-seq values)))
             (setf (svref bad 0) (bytes size 255))
             (ensure (handler-case (progn (check-values engine keys bad) nil) (error () t))))
           (dotimes (rep repetitions)
             (sample engine keys values groups width (1+ csn) operations rep mode version)
             (incf csn operations))
           (ensure (equal (list 0 csn 0 csn) (multiple-value-list (e:frontiere-motore engine))))
           (e:chiudi-motore engine) (setf engine nil)
           (setf engine (open-engine root mode version nil))
           (check-values engine keys values)
           (ensure (= (1+ csn) (e:scrivi-documento engine (svref keys 0) (svref values 0))))
           (setf success t))
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t)
          (format *error-output* "~&GROUP-BENCH-RETAINED ~A~%" root)))))
(let* ((args (uiop:command-line-arguments)) (self (equal args '("--self-test"))))
  (unless (or self (equal args '("--run"))) (error "Expected --run or --self-test"))
  (format t "~&~S~%" (list :kind :benchmark-driver :self-test self :sha256-output
    (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
  (dolist (version (if self '(2) '(1 2)))
    (dolist (mode '(:legacy :resident :paged))
      (dolist (size (if self '(2048) '(2048 60000)))
        ;; Rotate paired order to reduce systematic first/last cache and thermal effects.
        (dolist (width (if self '(1 8) (if (oddp version) '(1 2 4 8) '(8 4 2 1))))
          (one-case mode version size width (if self 1 5) (if self 16 128))))))
  (format t "~&~S~%" (list :kind :group-engine-benchmark :status :passed :self-test self
      :platform (list (software-type) (machine-type) (lisp-implementation-version))
      :limits '(:serial-M1 :eight-hot-keys :API-call-latency-is-not-per-request-tail :not-RSS :not-power-loss))))
