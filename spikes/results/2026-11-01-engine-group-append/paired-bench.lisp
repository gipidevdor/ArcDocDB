;;;; C4 post-result follow-up: alternate executor choice on one live engine/file, keep every strong flush.
(require :asdf)
(require :sb-posix)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb")
(defpackage #:group-append.paired-bench (:use #:cl)
  (:local-nicknames (#:e #:arcdocdb.engine) (#:w #:arcdocdb.wal) (#:io #:arcdocdb.io)))
(in-package #:group-append.paired-bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "Group append candidate oracle failed")) truth)
(defun bytes (n v) (make-array n :element-type '(unsigned-byte 8) :initial-element v))
(defun verify-stage (engine scratch)
  (let* ((work (e::motore-write-workspace engine)) (at 0))
    (dotimes (i 8)
      (let* ((batch (svref (e::write-group-workspace-batches work) i))
             (used (+ (aref (e::write-group-workspace-sizes work) i) w::+seal-total+)))
        (ensure (not (mismatch scratch (w::lotto-buffer batch) :start1 at :end1 (+ at used) :end2 used)))
        (incf at used)))))
(defun fresh-root ()
  (loop for serial below 1000 for root = (merge-pathnames
      (format nil "arcdocdb-group-append-~D-~D-~D/" (get-universal-time) (sb-posix:getpid) serial)
      (uiop:temporary-directory)) do
    (handler-case (progn (sb-posix:mkdir (namestring root) #o700) (return-from fresh-root root))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error "Candidate fixture namespace exhausted"))
(defun check-values (engine keys doc)
  (let ((out (bytes (length doc) 0)))
    (dotimes (i 8)
      (multiple-value-bind (status size) (e:leggi-documento engine (svref keys i) out)
        (ensure (and (eq :found status) (= size (length doc)) (equalp out doc)))))))
(defun sample (engine keys doc ops out width method scratch rep first small)
  (let ((executor (symbol-function 'w:scrivi-gruppo)) (writer (symbol-function 'io:append-esatto))
        (flush (symbol-function 'io:durable-flush)) (append-cpu 0) (append-calls 0) (flushes 0)
        (operations (if small 16 512)) (file (e::motore-append engine)))
    (unwind-protect
         (progn
           (setf (symbol-function 'w:scrivi-gruppo)
                 (lambda (group &key buffer)
                   (let ((begin (get-internal-run-time)))
                     (multiple-value-prog1
                         (if (eq method :staged) (funcall executor group :buffer buffer) (funcall executor group))
                       (incf append-cpu (- (get-internal-run-time) begin)))))
                 (symbol-function 'io:append-esatto)
                 (lambda (target buffer start end)
                   (when (eq file target) (incf append-calls))
                   (funcall writer target buffer start end))
                 (symbol-function 'io:durable-flush)
                 (lambda (target) (when (eq file target) (incf flushes)) (funcall flush target)))
           (sb-ext:gc :full t)
           (let ((begin (get-internal-real-time)) (cpu (get-internal-run-time)) (allocation (sb-ext:get-bytes-consed)))
             (dotimes (n (/ operations width))
               (if (= width 1)
                   (ensure (= (+ first n) (e:scrivi-documento engine (svref keys (mod n 8)) doc)))
                   (progn (e:scrivi-gruppo-documenti engine ops out)
                     (dotimes (i 8) (ensure (= (+ first (* n 8) i) (aref out i)))))))
             (let* ((wall (- (get-internal-real-time) begin)) (cpu-ticks (- (get-internal-run-time) cpu))
                    (allocated (- (sb-ext:get-bytes-consed) allocation))
                    (staged (and (eq method :staged) (= width 8) (<= (* 8 (+ (length doc) 96)) 65536))))
               (ensure (= flushes (/ operations width)))
               (ensure (= append-calls (if staged (/ operations width) operations)))
               (format t "~S~%" (list :kind :group-append-paired-sample :method method :value-bytes (length doc)
                   :width width :repetition rep :operations operations :wall-ticks wall :cpu-ticks cpu-ticks
                   :append-cpu-ticks append-cpu :append-calls append-calls :strong-flushes flushes
                   :allocated-bytes allocated :ticks-per-second internal-time-units-per-second)))))
      (setf (symbol-function 'w:scrivi-gruppo) executor (symbol-function 'io:append-esatto) writer
            (symbol-function 'io:durable-flush) flush))
    (check-values engine keys doc)
    (when (and (eq method :staged) (= width 8) (<= (* 8 (+ (length doc) 96)) 65536)) (verify-stage engine scratch))))
(defun one-case (size width small)
  (let ((root (fresh-root)) (engine nil) (success nil) (keys (make-array 8)) (ops (make-array 8))
        (doc (bytes size 117)) (out (make-array 8 :element-type '(unsigned-byte 64))) (scratch nil)
        (count (if small 16 512)) (csn 8))
    (dotimes (i 8) (setf (svref keys i) (bytes 16 i) (svref ops i) (e:crea-operazione-scrittura :put (svref keys i) doc)))
    (unwind-protect
         (progn
           (setf engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :create t :version 2 :clock (lambda () 10)
               :max-file-bytes 67108864 :max-record-bytes 65536 :max-records 8192 :index-capacity 32 :key-arena-bytes 4096
               :index-policy (e:crea-politica-indice-automatico :budget 8388608 :frames 1)))
           (setf scratch (e::motore-scratch engine))
           (e:scrivi-gruppo-documenti engine ops out)
           (dotimes (rep (if small 1 7))
             (dolist (method (if (evenp rep) '(:sequential :staged) '(:staged :sequential)))
               (sample engine keys doc ops out width method scratch rep (1+ csn) small) (incf csn count)))
           (ensure (equal (list 0 csn 0 csn) (multiple-value-list (e:frontiere-motore engine))))
           (e:chiudi-motore engine) (setf engine nil)
           (setf engine (e:apri-motore root (bytes 16 73) (bytes 16 41) :clock (lambda () 10)
               :max-file-bytes 67108864 :max-record-bytes 65536 :max-records 8192 :index-capacity 32 :key-arena-bytes 4096))
           (check-values engine keys doc)
           (ensure (= (1+ csn) (e:scrivi-documento engine (svref keys 0) doc))) (setf success t))
      (when engine (e:chiudi-motore engine))
      (if success (uiop:delete-directory-tree root :validate t)
          (format *error-output* "~&GROUP-APPEND-RETAINED ~A~%" root)))))
(let* ((args (uiop:command-line-arguments)) (small (equal args '("--self-test"))))
  (ensure (or small (equal args '("--run"))))
  (format t "~S~%" (list :kind :group-append-paired-driver :sha256-output
    (uiop:run-program (list "shasum" "-a" "256" (namestring *load-truename*)) :output :string)))
  (dolist (cell (if small '((2048 8)) '((128 8) (2048 8) (6144 8) (2048 1))))
    (one-case (first cell) (second cell) small))
  (format t "~S~%" (list :kind :group-append-paired-benchmark :status :passed :self-test small)))
