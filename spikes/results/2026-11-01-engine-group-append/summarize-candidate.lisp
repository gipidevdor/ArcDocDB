;;;; C4: cardinality-checked append experiment; samples are never replaced by summaries.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Append candidate summary failed")) truth)
(defun median (values)
  (ensure (and (oddp (length values)) (plusp (length values))))
  (nth (floor (length values) 2) (sort (copy-list values) #'<)))
(let* ((*read-eval* nil) (args (uiop:command-line-arguments))
       (root (uiop:pathname-directory-pathname *load-truename*)))
  (if (equal args '("--self-test"))
      (progn (ensure (= 3 (median '(5 1 3))))
        (ensure (handler-case (progn (median '(1 2)) nil) (error () t)))
        (format t "~S~%" '(:kind :candidate-summary-self-test :status :passed)))
      (let* ((record (arcdocdb.evidence:call-with-evidence-bytes (first args)
                       (lambda (path) (with-open-file (stream path) (read stream)))))
             (stdout (getf record :stdout)) (marker "(:KIND :GROUP-APPEND-CANDIDATE-SAMPLE")
             (start 0) (samples nil) (rows nil) (pairs nil))
        (ensure (and (= 1 (length args)) (eq :ok (getf record :status))
                     (eq :stable (getf record :source-consistency))
                     (search ":GROUP-APPEND-CANDIDATE :STATUS :PASSED" stdout)))
        (loop repeat 1000 for at = (search marker stdout :start2 start) while at do
          (multiple-value-bind (form next) (read-from-string stdout nil nil :start at)
            (push form samples) (setf start next)))
        (ensure (= 60 (length samples)))
        (dolist (size '(128 2048 60000))
          (dolist (width '(1 8))
            (dolist (method '(:sequential :staged))
              (let ((cell (remove-if-not (lambda (s) (and (= size (getf s :value-bytes))
                              (= width (getf s :width)) (eq method (getf s :method)))) samples)))
                (ensure (= 5 (length cell)))
                (ensure (equal '(0 1 2 3 4) (sort (mapcar (lambda (s) (getf s :repetition)) cell) #'<)))
                (dolist (sample cell)
                  (ensure (and (= 128 (getf sample :operations))
                               (= (/ 128 width) (getf sample :strong-flushes))
                               (= (if (and (eq method :staged) (= width 8) (< size 60000)) 16 128)
                                  (getf sample :append-calls)))))
                (push (list :case (list size width method)
                    :append-cpu-us-per-group (median (mapcar (lambda (s) (/ (* 1d0 width (getf s :append-cpu-ticks)) 128)) cell))
                    :cpu-us-per-op (median (mapcar (lambda (s) (/ (getf s :cpu-ticks) 128d0)) cell))
                    :ops-per-second (median (mapcar (lambda (s) (/ 128000000d0 (getf s :wall-ticks))) cell))) rows)))))
        (dolist (row rows)
          (let ((key (getf row :case)))
            (when (eq :staged (third key))
              (let ((before (find (list (first key) (second key) :sequential) rows :test #'equal :key (lambda (s) (getf s :case)))))
                (ensure before)
                (push (list :case (subseq key 0 2) :sequential before :staged row) pairs)))))
        (with-open-file (stream (merge-pathnames "candidate-metrics.lisp" root) :direction :output :if-exists :error)
          (write (list :kind :group-append-candidate-metrics :status :passed :samples 60 :pairs (reverse pairs))
                 :stream stream :pretty t) (terpri stream))
        (dolist (pair (reverse pairs))
          (let ((a (getf pair :sequential)) (b (getf pair :staged)))
            (format t "~S append CPU ~,3F -> ~,3F us/group, whole CPU ~,3F -> ~,3F us/op, wall ratio ~,4F~%"
              (getf pair :case) (getf a :append-cpu-us-per-group) (getf b :append-cpu-us-per-group)
              (getf a :cpu-us-per-op) (getf b :cpu-us-per-op) (/ (getf b :ops-per-second) (getf a :ops-per-second)))))
        (format t "~S~%" '(:kind :group-append-candidate-summary :status :passed :samples 60 :pairs 6)))))
