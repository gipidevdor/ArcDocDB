;;;; C4: pair adjacent same-engine windows by repetition; keep every original sample.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Paired append evidence oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil)) (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun median (values)
  (ensure (and (plusp (length values)) (oddp (length values))))
  (nth (floor (length values) 2) (sort (copy-list values) #'<)))
(defun samples (text)
  (let ((marker "(:KIND :GROUP-APPEND-PAIRED-SAMPLE") (start 0) (out nil) (*read-eval* nil))
    (loop repeat 1000 for at = (search marker text :start2 start) while at do
      (multiple-value-bind (form next) (read-from-string text nil nil :start at)
        (ensure (> next at)) (push form out) (setf start next))) (reverse out)))
(let* ((args (uiop:command-line-arguments)) (root (uiop:pathname-directory-pathname *load-truename*)))
  (if (equal args '("--self-test"))
      (progn (ensure (= 3 (median '(9 1 3))))
        (ensure (handler-case (progn (median nil) nil) (error () t)))
        (ensure (handler-case (progn (samples "(:KIND :GROUP-APPEND-PAIRED-SAMPLE :X #.(ERROR :BAD))") nil) (error () t)))
        (format t "~S~%" '(:kind :paired-summary-self-test :status :passed)))
      (let* ((record (read-data (first args))) (text (getf record :stdout)) (all (samples text))
             (identity (read-data (merge-pathnames "source-identity.lisp" root))) (pairs nil)
             (driver-hash (arcdocdb.evidence:file-sha256 (merge-pathnames "paired-bench.lisp" root))))
        (ensure (and (= 1 (length args)) (eq :ok (getf record :status)) (eql 0 (getf record :exit-code))
                     (eq :stable (getf record :source-consistency)) (= 1640 (length (getf record :source-blobs-after)))
                     (equal (getf record :source-blobs-after) (getf identity :sources))
                     (search ":GROUP-APPEND-PAIRED-BENCHMARK :STATUS :PASSED" text) (search driver-hash text)))
        (ensure (= 56 (length all)))
        (dolist (cell '((128 8) (2048 8) (6144 8) (2048 1)))
          (let ((sequential nil) (staged nil) (append-ratios nil) (cpu-ratios nil) (wall-ratios nil))
            (dolist (method '(:sequential :staged))
              (let ((rows (remove-if-not (lambda (s) (and (eq method (getf s :method))
                              (= (first cell) (getf s :value-bytes)) (= (second cell) (getf s :width)))) all)))
                (ensure (= 7 (length rows)))
                (ensure (equal '(0 1 2 3 4 5 6) (sort (mapcar (lambda (s) (getf s :repetition)) rows) #'<)))
                (dolist (row rows)
                  (ensure (and (= 512 (getf row :operations)) (= 1000000 (getf row :ticks-per-second))
                               (= (/ 512 (second cell)) (getf row :strong-flushes))
                               (= (if (and (eq method :staged) (= 8 (second cell))) 64 512) (getf row :append-calls)))))
                (if (eq method :sequential) (setf sequential rows) (setf staged rows))))
            (dotimes (rep 7)
              (let ((a (find rep sequential :key (lambda (s) (getf s :repetition))))
                    (b (find rep staged :key (lambda (s) (getf s :repetition)))))
                (push (/ (getf b :append-cpu-ticks) (float (getf a :append-cpu-ticks) 1d0)) append-ratios)
                (push (/ (getf b :cpu-ticks) (float (getf a :cpu-ticks) 1d0)) cpu-ratios)
                (push (/ (getf a :wall-ticks) (float (getf b :wall-ticks) 1d0)) wall-ratios)))
            (push (list :case cell :sequential-append-cpu-us-per-group
                    (median (mapcar (lambda (s) (/ (* (second cell) (getf s :append-cpu-ticks)) 512d0)) sequential))
                    :staged-append-cpu-us-per-group
                    (median (mapcar (lambda (s) (/ (* (second cell) (getf s :append-cpu-ticks)) 512d0)) staged))
                    :median-paired-append-cpu-ratio (median append-ratios)
                    :median-paired-whole-cpu-ratio (median cpu-ratios)
                    :median-paired-throughput-ratio (median wall-ratios)
                    :paired-append-cpu-ratios (reverse append-ratios) :paired-whole-cpu-ratios (reverse cpu-ratios)
                    :paired-throughput-ratios (reverse wall-ratios)) pairs)))
        (with-open-file (stream (merge-pathnames "paired-metrics.lisp" root) :direction :output :if-exists :error)
          (write (list :kind :group-append-paired-metrics :status :passed :samples 56 :operations 28672 :source-files 1640
                       :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*) :benchmark-driver-sha256 driver-hash
                       :qualified-identity-uncompressed-sha256
                       (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "source-identity.lisp" root)
                         #'arcdocdb.evidence:file-sha256) :pairs (reverse pairs)) :stream stream :pretty t) (terpri stream))
        (dolist (pair (reverse pairs))
          (format t "~S append CPU ~,3F -> ~,3F us/group; paired ratios: append ~,4F, whole CPU ~,4F, wall ~,4F~%"
            (getf pair :case) (getf pair :sequential-append-cpu-us-per-group) (getf pair :staged-append-cpu-us-per-group)
            (getf pair :median-paired-append-cpu-ratio) (getf pair :median-paired-whole-cpu-ratio)
            (getf pair :median-paired-throughput-ratio)))
        (format t "~S~%" '(:kind :group-append-paired-summary :status :passed :samples 56 :pairs 4)))))
