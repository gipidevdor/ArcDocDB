;;;; C4: whole source inventories and exact benchmark drivers, including reused immutable baseline.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Group append identity oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path
      (lambda (expanded) (with-open-file (stream expanded) (read stream))))))
(defun valid-record-p (record marker count)
  (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
       (eql 0 (getf record :exit-code)) (= count (length (getf record :source-blobs-after)))
       (search marker (getf record :stdout))))
(defun require-record (root name marker count)
  (let ((record (read-data (merge-pathnames (format nil "~A/report.lisp" name) root))))
    (ensure (valid-record-p record marker count)) record))
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (args (uiop:command-line-arguments))
       (prior (merge-pathnames "../2026-11-01-engine-active-directory/" root)))
  (if (equal args '("--self-test"))
      (let ((record (list :status :ok :source-consistency :stable :exit-code 0 :source-blobs-after '(one) :stdout "COMPLETE")))
        (ensure (valid-record-p record "COMPLETE" 1))
        (dolist (mutation '((:status :running) (:source-consistency :changed) (:exit-code 7)
                            (:source-blobs-after nil) (:stdout "incomplete zero exit")))
          (let ((bad (copy-list record))) (setf (getf bad (first mutation)) (second mutation))
            (ensure (not (valid-record-p bad "COMPLETE" 1)))))
        (format t "~S~%" '(:kind :group-append-identity-self-test :status :passed :independent-negatives 5)))
      (progn
        (ensure (equal args '("--run")))
        (let ((before nil) (after nil) (commands nil) (drivers nil))
          (dolist (entry '(("allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED")
                           ("engine-benchmark" ":GROUP-ENGINE-BENCHMARK :STATUS :PASSED")
                           ("unix-benchmark" ":GROUP-UNIX-BENCHMARK :STATUS :PASSED")))
            (let* ((record (require-record prior (first entry) (second entry) 1636)) (source (getf record :source-blobs-after)))
              (if before (ensure (equal before source)) (setf before source))
              (push (list :name (first entry) :variant :reused-baseline :status :passed) commands)))
          (ensure (equal before (getf (read-data (merge-pathnames "source-identity.lisp" prior)) :sources)))
          (ensure (equal before (getf (require-record root "candidate" ":GROUP-APPEND-CANDIDATE :STATUS :PASSED" 1636)
                                     :source-blobs-after)))
          (dolist (entry '(("full-check-2.6.9" "build e test: nessun avviso, tutti i controlli superati")
                           ("strict-2.6.10" "build e test: nessun avviso, tutti i controlli superati")
                           ("documentation" "Public Lisp example passed:")
                           ("focused" ":GROUP-APPEND-FOCUSED :STATUS :PASSED")
                           ("allocation" ":ACTIVE-ALLOCATION-CAMPAIGN :STATUS :PASSED")
                           ("engine-benchmark" ":GROUP-ENGINE-BENCHMARK :STATUS :PASSED")
                           ("unix-benchmark" ":GROUP-UNIX-BENCHMARK :STATUS :PASSED")
                           ("executor-benchmark" ":GROUP-APPEND-EXECUTOR-BENCHMARK :STATUS :PASSED")))
            (let* ((record (require-record root (first entry) (second entry) 1640)) (source (getf record :source-blobs-after)))
              (if after (ensure (equal after source)) (setf after source))
              (push (list :name (first entry) :variant :final :status :passed) commands)))
          (dolist (entry '(("allocation.lisp" "allocation") ("bench.lisp" "engine-benchmark") ("local-bench.lisp" "unix-benchmark")))
            (let ((hash (arcdocdb.evidence:file-sha256 (merge-pathnames (first entry) root))))
              (ensure (string= hash (arcdocdb.evidence:file-sha256 (merge-pathnames (first entry) prior))))
              (ensure (search hash (getf (read-data (merge-pathnames (format nil "~A/report.lisp" (second entry)) prior)) :stdout)))
              (ensure (search hash (getf (read-data (merge-pathnames (format nil "~A/report.lisp" (second entry)) root)) :stdout)))
              (push (list :path (first entry) :sha256 hash :baseline-identical t) drivers)))
          (dolist (entry '(("candidate.lisp" "candidate") ("executor-bench.lisp" "executor-benchmark")))
            (let ((hash (arcdocdb.evidence:file-sha256 (merge-pathnames (first entry) root))))
              (ensure (search hash (getf (read-data (merge-pathnames (format nil "~A/report.lisp" (second entry)) root)) :stdout)))
              (push (list :path (first entry) :sha256 hash) drivers)))
          (dolist (name '("analyze.lisp" "validate.lisp" "summarize-groups.lisp" "archive.lisp"))
            (push (list :path name :sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames name root))) drivers))
          (with-open-file (stream (merge-pathnames "source-identity.lisp" root) :direction :output :if-exists :error)
            (write (list :kind :group-append-qualified-identity :status :passed :baseline-source-files 1636 :source-files 1640
                         :campaigns (reverse commands) :drivers (reverse drivers) :baseline-sources before :sources after)
                   :stream stream :pretty t) (terpri stream))
          (format t "~S~%" '(:kind :group-append-evidence-validation :status :passed :baseline-campaigns 3
                             :final-campaigns 8 :final-source-files 1640))))))
