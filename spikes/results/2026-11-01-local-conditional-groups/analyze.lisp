;;;; C4 exact immutable driver/log hashes, complete cases and actual flush counts.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Explicit conditional measurement oracle failed")) truth)
(defun data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path (lambda (p) (with-open-file (in p) (read in))))))
(defun median (values)
  (let* ((s (sort (copy-list values) #'<)) (n (length s)))
    (ensure (plusp n)) (if (oddp n) (nth (floor n 2) s) (/ (+ (nth (1- (/ n 2)) s) (nth (/ n 2) s)) 2))))
(defun row-key (r) (list (getf r :version) (getf r :mode) (getf r :width)))
(defun valid-row (r)
  (and (member (getf r :version) '(1 2)) (member (getf r :mode) '(:resident :paged))
       (member (getf r :width) '(1 2 4 8)) (typep (getf r :round) '(integer 0 4))
       (eql (* 8 (getf r :width)) (getf r :operations))
       (realp (getf r :microseconds-per-op)) (plusp (getf r :microseconds-per-op))))
(defun log-forms (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (p)
      (let ((text (uiop:read-file-string p)) (cursor 0) (rows nil) (*read-eval* nil))
        (loop for start = (search "(:KIND :EXPLICIT-CONDITIONAL-FLUSH" text :start2 cursor) while start do
          (multiple-value-bind (form end) (read-from-string text nil nil :start start) (push form rows) (setf cursor end))) (reverse rows)))))
(defun valid-logs (rows width baseline)
  (and (= (if baseline (* 40 width) 40) (length rows))
       (every (lambda (r) (and (eq :explicit-conditional-flush (getf r :kind))
                               (eql (if baseline 1 width) (getf r :members)) (eql 1 (getf r :flushes)))) rows)))
(defun campaign (root name runtime baseline)
  (let* ((record (data (merge-pathnames name root))) (rows (getf record :rows))
         (copies (getf record :copies)) (logs nil) (seen nil) (cases nil) (requests 0) (operations 0))
    (ensure (and (eq :explicit-conditional-measurements (getf record :kind)) (eq :passed (getf record :status))
                 (eq baseline (getf record :baseline)) (equal runtime (getf record :runtime))
                 (= 80 (length rows)) (= 32 (length copies))))
    (ensure (string= (getf record :driver-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" root))))
    (ensure (string= (getf record :server-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-server.lisp" root))))
    (dolist (copy copies)
      (let ((path (pathname (getf copy :target))))
        (ensure (arcdocdb.evidence:call-with-evidence-bytes path
                  (lambda (p) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 p)))))
        (when (equal "stderr" (pathname-type path)) (push (log-forms path) logs))))
    (setf logs (reverse logs)) (ensure (= 16 (length logs)))
    (dolist (row rows)
      (ensure (valid-row row))
      (let ((key (append (row-key row) (list (getf row :round)))))
        (ensure (not (member key seen :test #'equal))) (push key seen)))
    (dolist (version '(1 2)) (dolist (mode '(:resident :paged)) (dolist (width '(1 2 4 8))
      (let* ((key (list version mode width)) (samples (remove-if-not (lambda (r) (equal key (row-key r))) rows)) (cohort (pop logs)))
        (ensure (= 5 (length samples))) (ensure (valid-logs cohort width baseline))
        (incf requests (length cohort)) (incf operations (loop for row in cohort sum (getf row :members)))
        (push (list :key key :median-us-per-op (median (mapcar (lambda (r) (getf r :microseconds-per-op)) samples))) cases)))))
    (ensure (and (null logs) (= 2400 operations) (= 2400 (loop for row in rows sum (getf row :operations)))))
    (list :runtime runtime :baseline baseline :samples 80 :groups 640 :operations operations :requests requests
          :flushes requests :cases (reverse cases))))
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
     (let ((row '(:version 2 :mode :paged :width 8 :round 0 :operations 64 :microseconds-per-op 500d0))
           (logs (loop repeat 40 collect (list :kind :explicit-conditional-flush :members 8 :flushes 1))))
       (ensure (valid-row row)) (ensure (valid-logs logs 8 nil))
       (dolist (mutation '((:width 9) (:round 5) (:operations 8) (:microseconds-per-op 0) (:mode :unknown)))
         (let ((bad (copy-list row))) (setf (getf bad (first mutation)) (second mutation)) (ensure (not (valid-row bad)))))
       (dolist (mutation '((:members 1) (:flushes 0) (:kind :wrong)))
         (let ((bad (copy-tree logs))) (setf (getf (first bad) (first mutation)) (second mutation)) (ensure (not (valid-logs bad 8 nil)))))
       (ensure (not (valid-logs (rest logs) 8 nil)))
       (format t "~S~%" '(:kind :explicit-if-analysis-self-test :status :passed :negatives 9))))
    ((equal args '("--baseline-check"))
     (campaign root "baseline-samples.lisp" "2.6.9" t)
     (format t "~S~%" '(:kind :explicit-if-baseline-integrity :status :passed)))
    ((null args)
     (let* ((base (campaign root "baseline-samples.lisp" "2.6.9" t))
            (final (campaign root "final-samples-2.6.9.lisp" "2.6.9" nil))
            (next (campaign root "final-samples-2.6.10.lisp" "2.6.10" nil)) (ratios nil))
       (dolist (case (getf base :cases))
         (let* ((key (getf case :key)) (after (find key (getf final :cases) :key (lambda (r) (getf r :key)) :test #'equal))
                (ratio (/ (getf case :median-us-per-op) (getf after :median-us-per-op))))
           (push (list :key key :before-us (getf case :median-us-per-op) :after-us (getf after :median-us-per-op) :gain ratio) ratios)
           (format t "v~D ~A width ~D: ~,3F -> ~,3F us/op; ~,4Fx~%" (first key) (second key) (third key)
                   (getf case :median-us-per-op) (getf after :median-us-per-op) ratio)))
       (let* ((summary (list :kind :explicit-if-metrics :status :passed :baseline base :final final :supplementary-runtime next
                             :same-runtime-gains (reverse ratios) :limits '(:single-synchronous-client :no-2.6.10-baseline :not-p99 :not-power-loss)))
              (target (merge-pathnames "metrics.lisp" root)))
         (if (probe-file target) (ensure (equalp summary (data target)))
             (with-open-file (out target :direction :output :if-exists :error) (write summary :stream out :pretty t) (terpri out))))
       (format t "~S~%" '(:kind :explicit-if-analysis :status :passed))))
    (t (error "Use --self-test, --baseline-check or no arguments"))))
