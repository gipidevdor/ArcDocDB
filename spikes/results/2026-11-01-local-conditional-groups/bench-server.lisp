;;;; C4: count actual conditional-request flushes; no scheduling gate or batching delay.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(defun mutation-members (connection envelope)
  (let ((buffer (arcdocdb.local::local-connection-input connection))
        (start (arcdocdb.local:envelope-payload-start envelope)) (end (arcdocdb.local:envelope-payload-end envelope)))
    (case (arcdocdb.local:envelope-code envelope)
      (7 (multiple-value-bind (major count next) (arcdocdb.local::%wire-head buffer start end)
           (declare (ignore next)) (unless (= 4 major) (error "Expected group")) count))
      (6 (multiple-value-bind (major count next) (arcdocdb.local::%wire-head buffer start end)
           (declare (ignore count)) (unless (= 4 major) (error "Expected version operation"))
           (if (member (arcdocdb.local::%wire-uint buffer next end 3) '(1 3)) 1 0)))
      (otherwise 0))))
(let ((open (symbol-function 'arcdocdb.engine:apri-motore))
      (dispatch (symbol-function 'arcdocdb.local::dispatch-local-ready))
      (flush (symbol-function 'arcdocdb.io:durable-flush)) (flushes 0))
  (setf (symbol-function 'arcdocdb.engine:apri-motore)
        (lambda (&rest args)
          (let ((engine (apply open args)))
            (when (equal "paged" (uiop:getenv "ARCDOCDB_EXPLICIT_CONDITIONAL_MODE"))
              (arcdocdb.engine:configura-budget-indice-motore engine
                (getf (arcdocdb.engine:statistiche-indice-motore engine) :reserved-fixed))) engine))
        (symbol-function 'arcdocdb.io:durable-flush)
        (lambda (file) (incf flushes) (funcall flush file))
        (symbol-function 'arcdocdb.local::dispatch-local-ready)
        (lambda (engine connections clock queue)
          (let ((before flushes)
                (members (loop for connection across connections
                               when (eq :pending (arcdocdb.local::local-connection-state connection))
                               sum (mutation-members connection (arcdocdb.local::local-connection-pending connection)))))
            (multiple-value-prog1 (funcall dispatch engine connections clock queue)
              (when (plusp members)
                (format *error-output* "~S~%" (list :kind :explicit-conditional-flush :members members :flushes (- flushes before)))
                (finish-output *error-output*))))))
  (arcdocdb.local::server-cli-main (uiop:command-line-arguments)))
