;;;; C4 serial single-client conditional writes with verified versions and actual strong flushes.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/tests"))
(load "tools/evidence-storage.lisp")
(defparameter *bench-root* (uiop:pathname-directory-pathname *load-truename*))
(defparameter *baseline* (equal (uiop:command-line-arguments) '("--baseline")))
(defparameter *rows* nil)
(defparameter *copies* nil)
(defun ensure (truth) (unless truth (error "Explicit conditional benchmark oracle failed")) truth)
(defun flush-records (path)
  (let ((*read-eval* nil) (text (uiop:read-file-string path)) (cursor 0) (out nil))
    (loop for start = (search "(:KIND :EXPLICIT-CONDITIONAL-FLUSH" text :start2 cursor) while start do
      (multiple-value-bind (form end) (read-from-string text nil nil :start start)
        (push form out) (setf cursor end))) (reverse out)))
(defun wave (client operations expected tokens applied frontier grouped)
  (let ((count (length operations)))
    (if *baseline*
        (dotimes (i count)
          (let ((op (svref operations i)))
            (multiple-value-bind (status token)
                (arcdocdb.local:client-put-if client (arcdocdb.engine::operazione-scrittura-key op)
                  (arcdocdb.engine::operazione-scrittura-value op) (aref expected i))
              (ensure (eq :applied status)) (setf (aref tokens i) token (aref applied i) 1))))
        (ensure (= count (funcall grouped client operations expected tokens applied))))
    (dotimes (i count)
      (ensure (and (= 1 (aref applied i)) (= (+ frontier 1 i) (aref tokens i)))))
    (replace expected tokens) (+ frontier count)))
(defun run-case (version mode width)
  (sb-posix:setenv "ARCDOCDB_EXPLICIT_CONDITIONAL_MODE" (string-downcase (symbol-name mode)) 1)
  (arcdocdb.local.process.tests::call-with-run
   (lambda ()
     (let* ((runtime (arcdocdb.local.process.tests::subdirectory "runtime/"))
            (data (arcdocdb.local.process.tests::subdirectory "data/"))
            (operations (make-array width)) (expected (make-array width :element-type '(unsigned-byte 64) :initial-element 0))
            (tokens (make-array width :element-type '(unsigned-byte 64) :initial-element 0))
            (applied (make-array width :element-type '(unsigned-byte 8) :initial-element 0))
            (document (arcdocdb.local.wire.tests::get-document 128)) (frontier 0)
            (grouped (unless *baseline* (symbol-function (find-symbol "CLIENT-WRITE-GROUP-IF" "ARCDOCDB.LOCAL")))))
       (dotimes (i width)
         (setf (svref operations i) (arcdocdb.engine:crea-operazione-scrittura :put (arcdocdb.engine.tests::key (1+ i)) document)))
       (multiple-value-bind (server socket)
           (arcdocdb.local.process.tests::start-server data runtime version 710 :create t :index-budget 8388608
             :script (enough-namestring (merge-pathnames "bench-server.lisp" *bench-root*) (truename "./")))
         (let ((client (apply #'arcdocdb.local:connect-local (namestring socket)
                             (append (list :versions t) (unless *baseline* (list :conditional-groups t))))))
           (unwind-protect
                (dotimes (round 5)
                  (let ((start (get-internal-real-time)))
                    (dotimes (n 8) (setf frontier (wave client operations expected tokens applied frontier grouped)))
                    (let ((row (list :version version :mode mode :width width :round round :operations (* 8 width)
                                     :microseconds-per-op (/ (* 1000000d0 (- (get-internal-real-time) start)) internal-time-units-per-second 8 width))))
                      (push row *rows*) (format t "~S~%" row)))
                  (dotimes (i width)
                    (multiple-value-bind (status actual token)
                        (arcdocdb.local:client-get-version client (arcdocdb.engine::operazione-scrittura-key (svref operations i)))
                      (ensure (and (eq :found status) (equalp document actual) (= token (aref expected i)))))))
             (arcdocdb.local:close-local client)))
         (arcdocdb.local.process.tests::stop-server server sb-posix:sigterm :explicit-conditional-measured)
         (let ((records (flush-records (arcdocdb.local.process.tests::child-stderr server))))
           (ensure (= (if *baseline* (* 40 width) 40) (length records)))
           (dolist (record records) (ensure (= (if *baseline* 1 width) (getf record :members))) (ensure (= 1 (getf record :flushes))))))))))
(let ((finish (symbol-function 'arcdocdb.local.process.tests::finish-children)))
  (unwind-protect
       (progn
         (setf (symbol-function 'arcdocdb.local.process.tests::finish-children)
               (lambda ()
                 (funcall finish)
                 (dolist (child arcdocdb.local.process.tests::*children*)
                   (dolist (source (list (arcdocdb.local.process.tests::child-stdout child) (arcdocdb.local.process.tests::child-stderr child)))
                     (let ((target (merge-pathnames (format nil "~A-logs/~A/~D-~A/~A" (if *baseline* "baseline" "final")
                                      (lisp-implementation-version) (length *rows*) (car (last (pathname-directory arcdocdb.local.process.tests::*root*)))
                                      (file-namestring source)) *bench-root*)))
                       (ensure-directories-exist target) (uiop:copy-file source target)
                       (let ((hash (arcdocdb.evidence:file-sha256 source)))
                         (ensure (string= hash (arcdocdb.evidence:file-sha256 target)))
                         (push (list :source (namestring source) :target (namestring target) :sha256 hash) *copies*)))))))
         (dolist (version '(1 2)) (dolist (mode '(:resident :paged)) (dolist (width '(1 2 4 8)) (run-case version mode width)))))
    (setf (symbol-function 'arcdocdb.local.process.tests::finish-children) finish)))
(ensure (= 80 (length *rows*)))
(with-open-file (out (merge-pathnames (if *baseline* "baseline-samples.lisp" (format nil "final-samples-~A.lisp" (lisp-implementation-version))) *bench-root*)
                     :direction :output :if-exists :error)
  (write (list :kind :explicit-conditional-measurements :status :passed :baseline *baseline* :runtime (lisp-implementation-version)
               :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
               :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench-server.lisp" *bench-root*))
               :rows (reverse *rows*) :copies (reverse *copies*) :limits '(:single-synchronous-client :not-tail-latency :not-power-loss))
         :stream out :pretty t) (terpri out))
(format t "~S~%" '(:kind :explicit-conditional-benchmark :status :passed))
