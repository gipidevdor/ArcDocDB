;;;; C4 counted end-to-end useful bandwidth, exact latency quantiles and byte-verified child logs.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Current Unix GET measurement oracle failed")) truth)
(defun data (path)
  (let ((*read-eval* nil)) (arcdocdb.evidence:call-with-evidence-bytes path (lambda (p) (with-open-file (in p) (read in))))))
(defun median (values) (let ((s (sort (copy-list values) #'<))) (ensure (= 5 (length s))) (third s)))
(defun sample-key (r) (list (getf r :mode) (getf r :version) (getf r :budget)))
(defun valid-sample (r)
  (and (eq :cache-unix-sample (getf r :kind)) (member (getf r :mode) '(:resident :paged))
       (member (getf r :version) '(1 2)) (member (getf r :budget) '(0 4194304))
       (eql 60000 (getf r :value-bytes)) (typep (getf r :repetition) '(integer 0 4))
       (eql 1024 (getf r :operations)) (typep (getf r :wall-ticks) '(integer 1))
       (typep (getf r :ticks-per-second) '(integer 1)) (typep (getf r :client-allocated-bytes) '(integer 0))
       (vectorp (getf r :latency-ticks)) (= 1024 (length (getf r :latency-ticks)))
       (every (lambda (tick) (typep tick '(integer 0))) (getf r :latency-ticks))
       (<= (reduce #'+ (getf r :latency-ticks)) (getf r :wall-ticks))
       (let ((ticks (sort (copy-seq (getf r :latency-ticks)) #'<)))
         (and (eql (aref ticks 511) (getf r :p50-ticks)) (eql (aref ticks 1013) (getf r :p99-ticks))))))
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (args (uiop:command-line-arguments)))
  (if (equal args '("--self-test"))
      (let ((r (list :kind :cache-unix-sample :mode :resident :version 1 :budget 0 :value-bytes 60000 :repetition 0
                     :operations 1024 :wall-ticks 2048 :ticks-per-second 1000000 :client-allocated-bytes 0
                     :latency-ticks (make-array 1024 :initial-element 1) :p50-ticks 1 :p99-ticks 1)))
        (ensure (valid-sample r))
        (dolist (mutation '((:operations 1) (:value-bytes 60001) (:p99-ticks 2) (:wall-ticks 1023) (:repetition 5)))
          (let ((bad (copy-list r))) (setf (getf bad (first mutation)) (second mutation)) (ensure (not (valid-sample bad)))))
        (format t "~S~%" '(:kind :current-get-analysis-self-test :status :passed :negatives 5)))
      (progn
        (ensure (null args))
        (let* ((record (data (merge-pathnames "get-benchmark/report.lisp" root))) (text (getf record :stdout))
               (cursor 0) (rows nil) (seen nil) (metrics nil) (*read-eval* nil)
               (copies (data (merge-pathnames "get-copies.lisp" root))))
          (ensure (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency)) (eql 0 (getf record :exit-code))
                       (equal (getf record :source-blobs-before) (getf record :source-blobs-after))
                       (search ":CACHE-UNIX-BENCHMARK :STATUS :PASSED :SELF-TEST NIL" text)
                       (search ":VERIFIED-GET-DRIVER :STATUS :PASSED" text)))
          (ensure (and (eq :passed (getf copies :status)) (= 16 (length (getf copies :copies)))
                       (string= (getf copies :driver-sha256) (arcdocdb.evidence:file-sha256 (merge-pathnames "get-bench.lisp" root)))))
          (dolist (copy (getf copies :copies))
            (ensure (arcdocdb.evidence:call-with-evidence-bytes (pathname (getf copy :target))
                      (lambda (p) (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 p))))))
          (loop for start = (search "(:KIND :CACHE-UNIX-SAMPLE" text :start2 cursor) while start do
            (multiple-value-bind (r end) (read-from-string text nil nil :start start)
              (ensure (valid-sample r))
              (let ((key (append (sample-key r) (list (getf r :repetition)))))
                (ensure (not (member key seen :test #'equal))) (push key seen))
              (push r rows) (setf cursor end)))
          (ensure (= 40 (length rows)))
          (dolist (version '(1 2)) (dolist (mode '(:resident :paged)) (dolist (budget '(0 4194304))
            (let* ((key (list mode version budget)) (samples (remove-if-not (lambda (r) (equal key (sample-key r))) rows))
                   (ops (median (mapcar (lambda (r) (/ (* 1d0 (getf r :operations) (getf r :ticks-per-second)) (getf r :wall-ticks))) samples)))
                   (p50 (median (mapcar (lambda (r) (/ (* 1000000d0 (getf r :p50-ticks)) (getf r :ticks-per-second))) samples)))
                   (p99 (median (mapcar (lambda (r) (/ (* 1000000d0 (getf r :p99-ticks)) (getf r :ticks-per-second))) samples))))
              (push (list :case key :median-ops-per-second ops :useful-MB-per-second (* ops 0.06d0)
                          :useful-MiB-per-second (/ (* ops 60000d0) 1048576) :median-p50-us p50 :median-p99-us p99
                          :client-allocated-bytes (mapcar (lambda (r) (getf r :client-allocated-bytes)) samples)) metrics)
              (format t "~S: ~,2F GET/s, ~,2F MB/s, ~,2F MiB/s; P50 ~,1F P99 ~,1F us~%" key ops (* ops 0.06d0)
                      (/ (* ops 60000d0) 1048576) p50 p99)))))
          (let ((target (merge-pathnames "get-metrics.lisp" root))
                (summary (list :kind :current-get-metrics :status :passed :samples 40 :operations 40960 :value-bytes 60000 :rows (reverse metrics)
                               :limits '(:warm-reads :single-synchronous-client :client-allocation-only :not-physical-disk-bandwidth :not-loaded-service-tail))))
            (if (probe-file target) (ensure (equalp summary (data target)))
                (with-open-file (out target :direction :output :if-exists :error) (write summary :stream out :pretty t) (terpri out))))
          (format t "~S~%" '(:kind :current-get-analysis :status :passed))))))
