;;;; C4: real product server in a separate process; bounded synchronous round trips.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:record-cache.local-bench
  (:use #:cl) (:local-nicknames (#:l #:arcdocdb.local) (#:p #:arcdocdb.local.process.tests)))
(in-package #:record-cache.local-bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (value) (unless value (error "Local cache oracle failed")) value)
(defun document (size)
  (let ((result (make-array size :element-type '(unsigned-byte 8) :initial-element 117)))
    (setf (aref result 0) #x59 (aref result 1) (ldb (byte 8 8) (- size 3))
          (aref result 2) (ldb (byte 8 0) (- size 3))) result))
(defun checked-get (client keys doc n)
  (multiple-value-bind (status result) (l:client-get client (svref keys (mod n (length keys))))
    (ensure (eq status :found)) (ensure (equalp result doc))) nil)
(defun samples (client keys doc mode version budget repeats count)
  (dotimes (n 32) (checked-get client keys doc n))
  (dotimes (rep repeats)
    (let ((ticks (make-array count :element-type '(unsigned-byte 64))) (begin (get-internal-real-time))
          (allocated (sb-ext:get-bytes-consed)))
      (dotimes (n count)
        (let ((tick (get-internal-real-time)))
          (checked-get client keys doc n)
          (setf (aref ticks n) (- (get-internal-real-time) tick))))
      (let ((elapsed (- (get-internal-real-time) begin)) (allocation (- (sb-ext:get-bytes-consed) allocated))
            (sorted (sort (copy-seq ticks) #'<)))
        (ensure (plusp elapsed))
        (format t "~&~S~%" (list :kind :cache-unix-sample :mode mode :version version :budget budget
          :value-bytes (length doc) :repetition rep :operations count :wall-ticks elapsed
          :ticks-per-second internal-time-units-per-second :client-allocated-bytes allocation
          :p50-ticks (aref sorted (1- (ceiling count 2)))
          :p99-ticks (aref sorted (1- (ceiling (* count 99) 100))) :latency-ticks ticks))))))
(defun one-case (runtime version mode budget stage small)
  (let* ((data (p::subdirectory (format nil "cache-~D/" stage)))
         (keys (make-array 8)) (doc (document (if small 1024 60000)))
         (population (if small 8 (if (eq mode :paged) 1200 8))))
    (dotimes (n 8) (setf (svref keys n) (p::automatic-local-key n)))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version stage :create t :record-cache-budget budget
                         :index-budget (when (eq mode :paged) 3400000))
      (let ((client (l:connect-local (namestring socket))))
        (unwind-protect
             (progn
               (dotimes (n population)
                 (ensure (= (1+ n) (l:client-put client (p::automatic-local-key n) (p::decode-hex "182A")))))
               (dotimes (n 8) (ensure (= (+ population n 1) (l:client-put client (svref keys n) doc))))
               (when (and (eq mode :paged) (not small)) (ensure (p::local-automatic-files data)))
               (ensure (handler-case
                           (progn (checked-get client keys (document (1- (length doc))) 0) nil)
                         (error () t)))
               (samples client keys doc mode version budget (if small 1 5) (if small 8 1024)))
          (l:close-local client)
          (p::stop-server server sb-posix:sigterm :cache-benchmark-completed)
          (dolist (source (list (p::child-stdout server) (p::child-stderr server)))
            (let ((target (merge-pathnames
                           (format nil "unix-logs/~A-~A" (if small "self-test" "benchmark") (file-namestring source))
                           (uiop:pathname-directory-pathname *load-truename*))))
              (ensure (not (probe-file target))) (ensure-directories-exist target) (uiop:copy-file source target))))))))
(let* ((args (uiop:command-line-arguments)) (small (equal args '("--self-test"))) (stage 100))
  (unless (or small (equal args '("--run"))) (error "Expected --self-test or --run"))
  (p::call-with-run
    (lambda ()
      (let ((runtime (p::subdirectory "cache-runtime/")))
        (dolist (version (if small '(2) '(1 2)))
          (dolist (mode (if small '(:resident) '(:resident :paged)))
            (dolist (budget (if (oddp version) '(4194304 0) '(0 4194304)))
              (one-case runtime version mode budget (incf stage) small)))))))
  (format t "~&~S~%" (list :kind :cache-unix-benchmark :status :passed :self-test small
                          :limits '(:local-C4 :single-synchronous-client :warm-reads :client-allocation-only :no-load-tail-qualification))))
