;;;; C4: immutable historical GET workload, explicit own output root and before/after driver identity.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error asdf:*compile-file-failure-behaviour* :error)
(load "tools/evidence-storage.lisp")
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (driver (merge-pathnames "get-bench.lisp" root))
       (args (uiop:command-line-arguments)) (hash (arcdocdb.evidence:file-sha256 driver))
       (blob (string-trim '(#\Newline #\Return) (uiop:run-program (list "git" "hash-object" "--" (namestring driver)) :output :string)))
       (expected (string-trim '(#\Newline #\Return)
                    (uiop:run-program '("git" "rev-parse" "6361666:spikes/results/2026-10-31-engine-record-cache/local-bench.lisp") :output :string)))
       (finish nil) (finish-symbol nil) (copies nil) (hook nil))
  (unless (and (or (equal args '("--self-test")) (equal args '("--run"))) (string= blob expected))
    (error "GET driver/options differ from immutable method"))
  (unwind-protect
       (progn
         ;; The immutable driver owns the sole ASDF load. Install the untimed copy verifier afterward.
         (setf hook
               (defmethod asdf:perform :after ((operation asdf:load-op) (system asdf:system))
                 (declare (ignore operation))
                 (when (and (equal "arcdocdb/tests" (asdf:component-name system)) (null finish))
                   (setf finish-symbol (find-symbol "FINISH-CHILDREN" "ARCDOCDB.LOCAL.PROCESS.TESTS")
                         finish (symbol-function finish-symbol)
                         (symbol-function finish-symbol)
                         (lambda ()
                           (funcall finish)
                           (dolist (child (symbol-value (find-symbol "*CHILDREN*" "ARCDOCDB.LOCAL.PROCESS.TESTS")))
                             (dolist (source (list (uiop:symbol-call :arcdocdb.local.process.tests :child-stdout child)
                                                  (uiop:symbol-call :arcdocdb.local.process.tests :child-stderr child)))
                               (let* ((target (merge-pathnames (format nil "unix-logs/~A-~A"
                                                                (if (equal args '("--self-test")) "self-test" "benchmark")
                                                                (file-namestring source)) root))
                                      (sha (arcdocdb.evidence:file-sha256 source)))
                                 (unless (string= sha (arcdocdb.evidence:file-sha256 target)) (error "GET child log copy differs"))
                                 (push (list :source (namestring source) :target (namestring target) :sha256 sha) copies)))))))))
         (load driver))
    (when hook (remove-method #'asdf:perform hook))
    (when finish (setf (symbol-function finish-symbol) finish))
    (unless (string= hash (arcdocdb.evidence:file-sha256 driver)) (error "GET driver changed during execution")))
  (unless (= (if (equal args '("--self-test")) 4 16) (length copies)) (error "Incomplete GET child logs"))
  (with-open-file (out (merge-pathnames (if (equal args '("--self-test")) "get-self-test-copies.lisp" "get-copies.lisp") root)
                       :direction :output :if-exists :error)
    (write (list :kind :verified-get-log-copies :status :passed :driver-sha256 hash :copies (reverse copies)) :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :verified-get-driver :status :passed :driver-sha256 hash :git-blob blob :arguments args :copied-logs (length copies))))
