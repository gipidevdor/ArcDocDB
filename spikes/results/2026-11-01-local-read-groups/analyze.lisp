;;;; C4: cardinality-checked original-driver single-client measurements.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Explicit Unix measurement oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (with-open-file (in expanded) (read in))))))
(defun forms (text kind)
  (let ((marker (format nil "(:KIND ~S" kind)) (cursor 0) (out nil) (*read-eval* nil))
    (loop for start = (search marker text :start2 cursor) while start do
      (multiple-value-bind (form end) (read-from-string text nil nil :start start)
        (ensure (eq kind (getf form :kind))) (push form out) (setf cursor end))) (nreverse out)))
(defun sample-key (sample)
  (mapcar (lambda (key) (getf sample key)) '(:version :mode :cache-bytes :value-bytes :width :repetition)))
(defun valid-sample (sample widths)
  (let* ((width (getf sample :width)) (ops (getf sample :operations)) (ticks (getf sample :rpc-ticks))
         (cache (getf sample :cache-bytes)))
    (and (member (getf sample :version) '(1 2)) (member (getf sample :mode) '(:resident :paged))
         (member cache '(0 1048576)) (member (getf sample :value-bytes) '(2048 6144)) (member width widths)
         (typep (getf sample :repetition) '(integer 0 4)) (eql ops 128) (vectorp ticks)
         (= (/ ops width) (getf sample :rpc-calls) (length ticks))
         (eql ops (getf sample :engine-gets)) (eql 0 (getf sample :strong-flushes))
         (= (getf sample :cache-hits) (if (plusp cache) ops 0))
         (every (lambda (n) (and (integerp n) (plusp n))) ticks)
         (typep (getf sample :client-allocated-bytes) '(integer 0))
         (eql 1000000 (getf sample :ticks-per-second))
         (>= (getf sample :wall-ticks) (reduce #'+ ticks) 1))))
(defun checked-samples (record widths)
  (ensure (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
               (eql 0 (getf record :exit-code))))
  (let* ((stdout (getf record :stdout)) (samples (forms stdout :unix-read-group-sample))
         (terminal (forms stdout :unix-read-group-campaign)))
    (ensure (and (= 1 (length terminal)) (eq :passed (getf (first terminal) :status))
                 (null (getf (first terminal) :self-test))))
    (ensure (= (* 80 (length widths)) (length samples)))
    (ensure (every (lambda (s) (valid-sample s widths)) samples))
    (ensure (= (length samples) (length (remove-duplicates samples :key #'sample-key :test #'equal)))) samples))
(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<)) (n (length sorted)))
    (ensure (plusp n)) (if (oddp n) (nth (floor n 2) sorted)
                         (/ (+ (nth (1- (/ n 2)) sorted) (nth (/ n 2) sorted)) 2))))
(defun percentile (values p)
  (let* ((sorted (sort (copy-list values) #'<)) (n (length sorted)))
    (ensure (plusp n)) (nth (1- (ceiling (* n p))) sorted)))
(defun select (samples version mode cache size width)
  (let ((found (remove-if-not (lambda (s) (equal (list version mode cache size width) (subseq (sample-key s) 0 5))) samples)))
    (ensure (= 5 (length found))) found))
(defun metric (samples)
  (let ((rpc (loop for s in samples append (coerce (getf s :rpc-ticks) 'list))))
    (list :median-reads-per-second (/ 128000000d0 (median (mapcar (lambda (s) (getf s :wall-ticks)) samples)))
          :rpc-p50-us (median rpc) :rpc-p99-us (percentile rpc 99/100)
          :client-bytes-per-read (/ (reduce #'+ samples :key (lambda (s) (getf s :client-allocated-bytes))) 640d0))))
(let ((args (uiop:command-line-arguments)) (root (uiop:pathname-directory-pathname *load-truename*)))
  (cond
    ((equal args '("--self-test"))
     (let* ((sample (list :version 1 :mode :resident :cache-bytes 1048576 :value-bytes 2048 :width 8 :repetition 0
                         :operations 128 :rpc-calls 16 :engine-gets 128 :strong-flushes 0 :cache-hits 128 :ticks-per-second 1000000
                         :wall-ticks 17 :client-allocated-bytes 0 :rpc-ticks (make-array 16 :initial-element 1))) (negative 0))
       (ensure (valid-sample sample '(1 2 4 8)))
       (dolist (mutation '((:operations 127) (:strong-flushes 1) (:rpc-calls 17) (:repetition 5)
                           (:wall-ticks 0) (:rpc-ticks #(1 1)) (:client-allocated-bytes -1) (:width 9)
                           (:engine-gets 127) (:cache-hits 127) (:cache-bytes 99)))
         (let ((bad (copy-list sample))) (setf (getf bad (first mutation)) (second mutation))
           (ensure (not (valid-sample bad '(1 2 4 8)))) (incf negative)))
       (ensure (= 3 (median '(1 9 3)))) (ensure (= 99 (percentile (loop for n from 1 to 100 collect n) 99/100)))
       (format t "~S~%" (list :kind :read-group-analysis-self-test :status :passed :negatives negative))))
    ((equal args '("--run"))
     (let* ((before (read-data (merge-pathnames "baseline/report.lisp" root)))
            (after (read-data (merge-pathnames "benchmark/report.lisp" root)))
            (bs (checked-samples before '(1))) (fs (checked-samples after '(1 2 4 8))) (rows nil))
       (dolist (record (list before after))
         (let ((drivers (forms (getf record :stdout) :read-benchmark-driver)))
           (ensure (= 2 (length drivers)))
           (loop for name in '("bench.lisp" "bench-server.lisp") for driver in drivers do
             (ensure (string= (arcdocdb.evidence:file-sha256 (merge-pathnames name root))
                              (subseq (getf driver :sha256-output) 0 64))))))
       (dolist (version '(1 2))
         (dolist (mode '(:resident :paged))
           (dolist (cache '(0 1048576))
            (dolist (size '(2048 6144))
             (let* ((base (metric (select bs version mode cache size 1)))
                    (individual (metric (select fs version mode cache size 1))))
               (dolist (width '(1 2 4 8))
                 (let* ((metrics (metric (select fs version mode cache size width)))
                        (rate (getf metrics :median-reads-per-second)))
                   (push (append (list :version version :mode mode :cache-bytes cache :value-bytes size :width width
                               :baseline-reads-per-second (getf base :median-reads-per-second)
                               :versus-baseline (/ rate (getf base :median-reads-per-second))
                               :versus-same-server-individual (/ rate (getf individual :median-reads-per-second))) metrics) rows))))))))
       (with-open-file (out (merge-pathnames "metrics.lisp" root) :direction :output :if-exists :error)
         (write (list :kind :read-group-metrics :status :passed :baseline-samples (length bs) :final-samples (length fs)
                      :logical-reads (+ (* 128 (length bs)) (* 128 (length fs))) :rows (nreverse rows)
                      :latency :rpc-nearest-rank-p99 :allocation-scope :client-managed-allocation
                      :limits '(:serial-single-client :five-samples-per-case :external-load-uncontrolled
                                :not-server-allocation-or-rss :not-universal-performance)) :stream out :pretty t) (terpri out))
       (format t "~S~%" '(:kind :read-group-analysis :status :passed :cases 64 :baseline-samples 80 :final-samples 320))))
    (t (error "Use --self-test or --run"))))
