;;;; C4: real startup/service; cold backend choice and counters only, no timed logging.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local" :verbose nil))
(let ((open (symbol-function 'arcdocdb.engine:apri-motore))
      (get (symbol-function 'arcdocdb.engine:leggi-documento))
      (queue (symbol-function 'arcdocdb.local::queue-local-output))
      (serve (symbol-function 'arcdocdb.local:serve-local))
      (paged (member "--index-budget" (uiop:command-line-arguments) :test #'string=))
      (handle nil) (reads 0) (pending 0) (flushes 0) (histogram (make-array 9 :initial-element 0)))
  (setf (symbol-function 'arcdocdb.engine:apri-motore)
        (lambda (&rest options)
          (let ((engine (apply open options)))
            (when paged (arcdocdb.engine:configura-budget-indice-motore engine
                          (getf (arcdocdb.engine:statistiche-indice-motore engine) :reserved-fixed)))
            (unless (eq (arcdocdb.engine:modo-indice-motore engine) (if paged :paged :resident))
              (error "Unexpected read benchmark primary"))
            (setf handle engine) engine))
        (symbol-function 'arcdocdb.engine:leggi-documento)
        (lambda (&rest args) (incf reads) (incf pending) (apply get args))
        (symbol-function 'arcdocdb.local::queue-local-output)
        (lambda (connection size kind now)
          (let* ((env (arcdocdb.local::local-connection-pending connection))
                 (opcode (when env (arcdocdb.local:envelope-code env))))
            (when (and (eq kind :response) (member opcode '(2 5)))
              (unless (<= 0 pending 8) (error "Unbounded observed read group"))
              (incf (svref histogram pending)) (setf pending 0))
            (when (and (eq kind :response) (eql opcode 0))
              (format *error-output* "~S~%" (list :kind :read-counters :gets reads :flushes flushes :rpc histogram
                :cache (arcdocdb.engine:statistiche-cache-motore handle))) (finish-output *error-output*)))
          (funcall queue connection size kind now))
        (symbol-function 'arcdocdb.local:serve-local)
        (lambda (directory archive series path &rest options)
          (apply serve directory archive series path
            :observer (lambda (engine phase) (declare (ignore engine)) (when (eq phase :after-flush) (incf flushes)) nil) options)))
  (arcdocdb.local::server-cli-main (uiop:command-line-arguments)))
