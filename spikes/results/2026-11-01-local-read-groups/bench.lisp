;;;; C4: same driver before/after; full byte, RPC, cache and restart oracles outside/inside declared windows.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:read-groups.bench (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:p #:arcdocdb.local.process.tests)))
(in-package #:read-groups.bench)
(defun ensure (truth) (unless truth (error "Read group benchmark oracle failed")) truth)
(defun document (size value)
  (let ((out (make-array size :element-type '(unsigned-byte 8) :initial-element value)))
    (setf (aref out 0) #x59 (aref out 1) (ldb (byte 8 8) (- size 3)) (aref out 2) (ldb (byte 8 0) (- size 3))) out))
(defun connect (socket grouped)
  (apply #'l:connect-local (namestring socket) (when grouped '(:read-groups t))))
(defun counters (client server)
  (l:client-ping client)
  (let* ((text (uiop:read-file-string (p::child-stderr server)))
         (start (search "(:KIND :READ-COUNTERS " text :from-end t)) (*read-eval* nil))
    (ensure start) (read-from-string text nil nil :start start)))
(defun verify-window (before after width operations cache)
  (ensure (= operations (- (getf after :gets) (getf before :gets))))
  (ensure (= (getf before :flushes) (getf after :flushes)))
  (dotimes (i 9)
    (ensure (= (- (svref (getf after :rpc) i) (svref (getf before :rpc) i))
               (if (= i width) (/ operations width) 0))))
  (when (plusp cache)
    (ensure (= operations (- (getf (getf after :cache) :hits) (getf (getf before :cache) :hits))))))
(defun sample (client server keys docs groups width version mode cache size repetition small)
  (let* ((operations (if small 16 128)) (calls (/ operations width)) (ticks (make-array calls :element-type '(unsigned-byte 64)))
         (group (when (> width 1) (find-symbol "CLIENT-GET-GROUP" :arcdocdb.local))) (before (counters client server)))
    (when (> width 1) (ensure (and group (fboundp group)))) (sb-ext:gc :full t)
    (let ((start (get-internal-real-time)) (allocated (sb-ext:get-bytes-consed)))
      (dotimes (n calls)
        (let ((begin (get-internal-real-time)) (id (mod (* n width) 8)))
          (if (= width 1)
              (multiple-value-bind (status doc) (l:client-get client (svref keys id))
                (ensure (and (eq :found status) (equalp doc (svref docs id)))))
              (let ((results (funcall group client (svref groups id) :count width)))
                (ensure (= width (length results)))
                (dotimes (i width) (ensure (equalp (svref results i) (svref docs (mod (+ id i) 8)))))))
          (setf (aref ticks n) (- (get-internal-real-time) begin))))
      (let ((wall (- (get-internal-real-time) start)) (bytes (- (sb-ext:get-bytes-consed) allocated))
            (after (counters client server)))
        (ensure (plusp wall)) (verify-window before after width operations cache)
        (format t "~S~%" (list :kind :unix-read-group-sample :version version :mode mode :cache-bytes cache
          :value-bytes size :width width :repetition repetition :operations operations :rpc-calls calls :engine-gets operations
          :strong-flushes 0 :cache-hits (if (plusp cache) operations 0) :wall-ticks wall
          :ticks-per-second internal-time-units-per-second :client-allocated-bytes bytes :rpc-ticks ticks))))))
(defun preserve (server label)
  (dolist (source (list (p::child-stdout server) (p::child-stderr server)))
    (let ((target (merge-pathnames (format nil "unix-logs/~A-~A" label (file-namestring source))
                                  (uiop:pathname-directory-pathname *load-truename*))))
      (ensure (not (probe-file target))) (ensure-directories-exist target) (uiop:copy-file source target))))
(defun check-all (client keys docs)
  (dotimes (i 8) (multiple-value-bind (status doc) (l:client-get client (svref keys i))
                  (ensure (and (eq :found status) (equalp doc (svref docs i)))))))
(defun one-case (runtime version mode cache size stage widths small label)
  (let ((data (p::subdirectory (format nil "reads-~D/" stage))) (keys (make-array 8)) (docs (make-array 8)) (groups (make-array 8))
        (script (enough-namestring (merge-pathnames "bench-server.lisp" *load-truename*) (truename "./"))))
    (dotimes (i 8) (setf (svref keys i) (p::automatic-local-key i) (svref docs i) (document size (+ i 17))))
    (dotimes (i 8) (setf (svref groups i) (make-array 8))
      (dotimes (j 8) (setf (svref (svref groups i) j) (svref keys (mod (+ i j) 8)))))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version stage :create t :script script :index-budget (when (eq mode :paged) 3400000)
                         :record-cache-budget cache)
      (let ((client (connect socket nil)))
        (unwind-protect
             (progn (dotimes (i 8) (ensure (= (1+ i) (l:client-put client (svref keys i) (svref docs i)))))
                    (check-all client keys docs)) (l:close-local client)))
      (dolist (width widths)
        (let ((client (connect socket (> width 1))))
          (unwind-protect
               (dotimes (rep (if small 1 5)) (sample client server keys docs groups width version mode cache size rep small))
            (l:close-local client))))
      (p::stop-server server sb-posix:sigterm :read-benchmark-done) (preserve server label))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version (+ stage 1000) :script script :index-budget (when (eq mode :paged) 3400000)
                         :record-cache-budget cache)
      (let ((client (connect socket nil)))
        (unwind-protect (progn (check-all client keys docs)
                         (ensure (= 9 (l:client-put client (svref keys 0) (svref docs 0))))) (l:close-local client)))
      (p::stop-server server sb-posix:sigterm :read-benchmark-reopened) (preserve server label))))
(let* ((args (uiop:command-line-arguments)) (base (equal args '("--baseline")))
       (small (member args '(("--self-test") ("--group-self-test")) :test #'equal))
       (widths (cond (base '(1)) ((equal args '("--self-test")) '(1)) (small '(1 8)) (t '(1 2 4 8))))
       (label (if small "self-test" (if base "baseline" "final"))) (stage 300))
  (ensure (or base small (equal args '("--run"))))
  (dolist (path (list *load-truename* (merge-pathnames "bench-server.lisp" *load-truename*)))
    (format t "~S~%" (list :kind :read-benchmark-driver :sha256-output
      (uiop:run-program (list "shasum" "-a" "256" (namestring path)) :output :string))))
  (p::call-with-run (lambda ()
    (let ((runtime (p::subdirectory "read-runtime/")))
      (dolist (version (if small '(2) '(1 2)))
        (dolist (mode (if small '(:resident) '(:resident :paged)))
          (dolist (cache (if small '(1048576) '(0 1048576)))
            (dolist (size (if small '(2048) '(2048 6144)))
              (one-case runtime version mode cache size (incf stage) widths small label))))))))
  (format t "~S~%" (list :kind :unix-read-group-campaign :status :passed :baseline base :self-test (not (null small)))))
