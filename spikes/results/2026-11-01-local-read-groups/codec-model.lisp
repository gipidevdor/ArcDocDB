;;;; C4: independent request/result fixtures across widths, IDs, key/document sizes and absence patterns.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:read-groups.model (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:w #:arcdocdb.local.wire.tests)))
(in-package #:read-groups.model)
(defun ensure (truth) (unless truth (error "Independent read-group byte model failed")) truth)
(let ((cases 0) (accepted 0) (refused 0) (out (w::output)) (space (arcdocdb.cbor:crea-spazio-cbor))
      (spans (make-array 8 :element-type '(unsigned-byte 64))))
  (dolist (id '(1 24 65536 18446744073709551615))
    (loop for count from 1 to 8 do
      (dolist (key-size '(1 24 1024))
        (dolist (doc-size '(1 24 256 2048 4096 60000))
          (dolist (pattern '(:all :alternate :absent))
            (let ((keys (make-array (1+ count) :initial-element :unselected)) (documents (make-array count)) (key-parts nil) (parts nil))
              (dotimes (i count)
                (let* ((key (make-array key-size :element-type '(unsigned-byte 8) :initial-element (mod i 3)))
                       (found (or (eq pattern :all) (and (eq pattern :alternate) (evenp i))))
                       (doc (when found (w::get-document doc-size))))
                  (setf (svref keys i) key (svref documents i) doc)
                  (push (w::bstr key) key-parts)
                  (push (if found (w::join (w::bytes #x82 #xf5) (w::bstr doc)) (w::bytes #x82 #xf4 #xf6)) parts)))
              (let* ((expected (w::request 5 (apply #'w::join (w::uint count 4) (nreverse key-parts)) id))
                     (end (l::encode-local-read-group out id keys count 65536)))
                (ensure (and (= end (length expected)) (equalp expected (subseq out 0 end)))))
              (let ((wire (w::framed (w::body 3 id 0 (apply #'w::join (w::uint count 4) (nreverse parts))))))
                (incf cases)
                (if (<= (length wire) 65540)
                    (let ((result (l::decode-local-read-group-response wire (w::envelope wire) space spans count)))
                      (ensure (equalp result documents)) (fill wire 0) (ensure (equalp result documents)) (incf accepted))
                    (let ((caught nil))
                      (handler-case (w::envelope wire) (l:protocol-error () (setf caught t)))
                      (ensure caught) (incf refused))))))))))
  (ensure (= 1728 cases (+ accepted refused)))
  (format t "~S~%" (list :kind :read-group-byte-model :status :passed :cases cases :accepted accepted :refused refused
                         :independent-writer t :benchmark nil)))
