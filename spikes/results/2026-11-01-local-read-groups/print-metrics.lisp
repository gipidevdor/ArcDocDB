(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((*read-eval* nil) (root (uiop:pathname-directory-pathname *load-truename*))
       (data (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "metrics.lisp" root)
               (lambda (path) (with-open-file (in path) (read in))))) (rows (getf data :rows)))
  (format t "| Format | Primary | Cache MiB | Document bytes | Baseline reads/s | Final single reads/s | Group 8 reads/s | Group/single | Group RPC p99 (us) |~%")
  (format t "|---|---|---:|---:|---:|---:|---:|---:|---:|~%")
  (dolist (row rows)
    (when (= 8 (getf row :width))
      (let ((single (find-if (lambda (one) (and (= 1 (getf one :width)) (= (getf one :version) (getf row :version))
                                 (eq (getf one :mode) (getf row :mode)) (= (getf one :cache-bytes) (getf row :cache-bytes))
                                 (= (getf one :value-bytes) (getf row :value-bytes)))) rows)))
        (format t "| v~D | ~A | ~D | ~D | ~D | ~D | ~D | ~,2Fx | ~D |~%"
          (getf row :version) (string-downcase (symbol-name (getf row :mode))) (/ (getf row :cache-bytes) 1048576)
          (getf row :value-bytes) (round (getf row :baseline-reads-per-second))
          (round (getf single :median-reads-per-second)) (round (getf row :median-reads-per-second))
          (getf row :versus-same-server-individual) (getf row :rpc-p99-us)))))
  (dolist (width '(1 2 4 8))
    (let* ((selected (remove-if-not (lambda (row) (= width (getf row :width))) rows))
           (ratios (sort (mapcar (lambda (row) (getf row :versus-same-server-individual)) selected) #'<))
           (base (sort (mapcar (lambda (row) (getf row :versus-baseline)) selected) #'<)))
      (format t "~S~%" (list :width width :same-server-min (first ratios) :same-server-median (/ (+ (nth 7 ratios) (nth 8 ratios)) 2)
                             :same-server-max (car (last ratios)) :baseline-min (first base) :baseline-max (car (last base))))))
  (dolist (cache '(0 1048576))
    (let* ((selected (remove-if-not (lambda (row) (and (= 8 (getf row :width)) (= cache (getf row :cache-bytes)))) rows))
           (ratios (sort (mapcar (lambda (row) (getf row :versus-same-server-individual)) selected) #'<)))
      (format t "~S~%" (list :width 8 :cache-bytes cache :median-ratio (/ (+ (nth 3 ratios) (nth 4 ratios)) 2)
                             :min (first ratios) :max (car (last ratios)))))))
