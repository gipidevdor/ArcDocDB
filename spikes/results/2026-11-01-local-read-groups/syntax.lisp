;;;; C4 reader-only parenthesis check; mask package colons, preserving uninterned-symbol dispatch.
(require :asdf)
(let ((*read-eval* nil) (failures 0))
  (dolist (name (uiop:command-line-arguments))
    (let* ((text (uiop:read-file-string name)) (masked (copy-seq text)))
     (dotimes (i (length masked))
       (when (and (char= #\: (char masked i)) (or (zerop i) (char/= #\# (char masked (1- i)))))
         (setf (char masked i) #\_)))
     (with-input-from-string (in masked)
      (handler-case
          (let ((eof (gensym)) (forms 0))
            (loop until (eq eof (read in nil eof)) do (incf forms))
            (format t "syntax ~A: ~D forms~%" name forms))
        (error (condition)
          (incf failures)
          (let ((position (min (length text) (file-position in))))
            (format t "syntax ~A: line ~D: ~A~%" name (1+ (count #\Newline text :end position)) condition)))))))
  (format t "~S~%" (list :kind :read-group-reader-check :status (if (zerop failures) :passed :failed) :failures failures))
  (unless (zerop failures) (sb-ext:exit :code 1)))
