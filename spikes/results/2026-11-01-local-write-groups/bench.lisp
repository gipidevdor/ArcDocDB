;;;; C4: one synchronous connection, durability-equivalent individual and negotiated grouped writes.
(require :asdf)
(require :sb-posix)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:local-groups.bench (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:e #:arcdocdb.engine) (#:p #:arcdocdb.local.process.tests)))
(in-package #:local-groups.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun ensure (truth) (unless truth (error "Explicit Unix group benchmark oracle failed")) truth)
(defun bytes (size value) (make-array size :element-type '(unsigned-byte 8) :initial-element value))
(defun document (size id)
  (let ((doc (bytes size (+ id 17))))
    (setf (aref doc 0) #x59 (aref doc 1) (ldb (byte 8 8) (- size 3)) (aref doc 2) (ldb (byte 8 0) (- size 3))) doc))
(defun histogram (server)
  (let ((out (make-array 9 :initial-element 0)))
    (with-open-file (stream (p::child-stderr server))
      (loop for line = (read-line stream nil) while line do
        (when (uiop:string-prefix-p "GROUP-FLUSH " line)
          (let ((count (parse-integer line :start 12 :junk-allowed nil)))
            (ensure (<= 1 count 8)) (incf (svref out count)))))) out))
(defun check-values (client keys docs)
  (dotimes (i 8)
    (multiple-value-bind (status value) (l:client-get client (svref keys i))
      (ensure (and (eq :found status) (equalp value (svref docs i)))))))
(defun connect (socket grouped)
  (apply (symbol-function (find-symbol "CONNECT-LOCAL" :arcdocdb.local))
         (namestring socket) (when grouped (list :write-groups t))))
(defun sample (client server keys docs groups results width first version mode size rep operations)
  (let ((ticks (make-array (/ operations width) :element-type '(unsigned-byte 64)))
        (before (histogram server))
        (grouped (when (> width 1) (find-symbol "CLIENT-WRITE-GROUP" :arcdocdb.local))))
    (when (> width 1) (ensure (and grouped (fboundp grouped))))
    (sb-ext:gc :full t)
    (let ((begin (get-internal-real-time)) (allocated (sb-ext:get-bytes-consed)))
      (dotimes (n (/ operations width))
        (let ((start (get-internal-real-time)) (key-id (mod (* n width) 8)))
          (if (= width 1)
              (ensure (= (+ first n) (l:client-put client (svref keys key-id) (svref docs key-id))))
              (progn
                (ensure (= width (funcall grouped client (svref groups key-id) results :count width)))
                (dotimes (i width) (ensure (= (+ first (* n width) i) (aref results i))))))
          (setf (aref ticks n) (- (get-internal-real-time) start))))
      (let ((wall (- (get-internal-real-time) begin)) (allocation (- (sb-ext:get-bytes-consed) allocated))
            (after (histogram server)))
        (ensure (plusp wall))
        (dotimes (i 9) (ensure (= (- (svref after i) (svref before i)) (if (= width i) (/ operations width) 0))))
        (format t "~S~%" (list :kind :explicit-unix-group-sample :version version :mode mode :value-bytes size
          :group-size width :repetition rep :operations operations :rpc-calls (/ operations width)
          :strong-flushes (/ operations width) :wall-ticks wall :ticks-per-second internal-time-units-per-second
          :client-allocated-bytes allocation :rpc-ticks ticks)))))
  (check-values client keys docs))
(defun preserve (server label)
  (dolist (source (list (p::child-stdout server) (p::child-stderr server)))
    (let ((target (merge-pathnames (format nil "unix-logs/~A-~A" label (file-namestring source))
                                  (uiop:pathname-directory-pathname *load-truename*))))
      (ensure (not (probe-file target))) (ensure-directories-exist target) (uiop:copy-file source target))))
(defun one-case (runtime version mode size stage widths small label)
  (let ((data (p::subdirectory (format nil "explicit-group-~D/" stage))) (keys (make-array 8)) (docs (make-array 8))
        (ops (make-array 8)) (groups (make-array 8)) (out (make-array 8 :element-type '(unsigned-byte 64)))
        (csn 8) (count (if small 16 128))
        (script (enough-namestring (merge-pathnames "bench-server.lisp" *load-truename*) (truename "./"))))
    (dotimes (i 8) (setf (svref keys i) (bytes 16 i) (svref docs i) (document size i)
                         (svref ops i) (e:crea-operazione-scrittura :put (svref keys i) (svref docs i))))
    (dotimes (start 8) (setf (svref groups start) (make-array 8))
      (dotimes (i 8) (setf (svref (svref groups start) i) (svref ops (mod (+ start i) 8)))))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version stage :create t :script script :index-budget (when (eq mode :paged) 3400000))
      (let ((client (connect socket nil)))
        (unwind-protect (dotimes (i 8) (ensure (= (1+ i) (l:client-put client (svref keys i) (svref docs i)))))
          (l:close-local client)))
      (dolist (width widths)
        (let ((client (connect socket (> width 1))))
          (unwind-protect
               (dotimes (rep (if small 1 5))
                 (sample client server keys docs groups out width (1+ csn) version mode size rep count) (incf csn count))
            (l:close-local client))))
      (p::stop-server server sb-posix:sigterm :explicit-benchmark-done) (preserve server label))
    (multiple-value-bind (server socket)
        (p::start-server data runtime version (+ stage 1000) :script script :index-budget (when (eq mode :paged) 3400000))
      (let ((client (connect socket nil)))
        (unwind-protect
             (progn (check-values client keys docs)
               (ensure (= (1+ csn) (l:client-put client (svref keys 0) (svref docs 0)))))
          (l:close-local client)))
      (p::stop-server server sb-posix:sigterm :explicit-benchmark-reopened) (preserve server label))))
(let* ((args (uiop:command-line-arguments)) (baseline (equal args '("--baseline")))
       (small (member args '(("--self-test") ("--group-self-test")) :test #'equal))
       (widths (cond (baseline '(1)) ((equal args '("--self-test")) '(1)) (small '(1 8)) (t '(1 2 4 8))))
       (label (if small "self-test" (if baseline "baseline" "final"))) (stage 30))
  (ensure (or baseline small (equal args '("--run"))))
  (dolist (name (list *load-truename* (merge-pathnames "bench-server.lisp" *load-truename*)))
    (format t "~S~%" (list :kind :benchmark-driver :sha256-output
      (uiop:run-program (list "shasum" "-a" "256" (namestring name)) :output :string))))
  (p::call-with-run (lambda ()
    (let ((runtime (p::subdirectory "explicit-group-runtime/")))
      (dolist (version (if small '(2) '(1 2)))
        (dolist (mode (if small '(:resident) '(:resident :paged)))
          (dolist (size (if small '(2048) '(2048 6144)))
            (one-case runtime version mode size (incf stage) widths small label)))))))
  (format t "~S~%" (list :kind :explicit-unix-group-campaign :status :passed :baseline baseline :self-test (not (null small)))))
