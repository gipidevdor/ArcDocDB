;;;; C4 self-recording cleanup, run only after the closed evidence inventory verifies.
(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(let* ((worktree (truename "./")) (result-root (uiop:pathname-directory-pathname *load-truename*))
       (closure (let ((*read-eval* nil))
                  (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "closure.lisp" result-root)
                    (lambda (path) (with-open-file (stream path) (read stream))))))
       (roots (list (merge-pathnames "_build/" worktree) (merge-pathnames "spikes/out/" worktree))) (rows nil))
  (unless (and (equal worktree #p"/Users/gpicchiarelli/.codex/worktrees/m1-service-index-discovery/ArcDocDB/")
               (eq :explicit-group-evidence-closure (getf closure :kind)) (eq :passed (getf closure :status)))
    (error "Owned worktree and completed evidence closure are required"))
  (dolist (directory (uiop:subdirectories (merge-pathnames "spikes/" worktree)))
    (when (uiop:string-prefix-p "SPK-" (car (last (pathname-directory directory))))
      (push (merge-pathnames "out/" directory) roots)))
  (dolist (version '("2.6.9" "2.6.10"))
    (push (pathname (format nil "/Users/gpicchiarelli/.cache/common-lisp/sbcl-~A-macosx-arm64/Users/gpicchiarelli/.codex/worktrees/m1-service-index-discovery/ArcDocDB/" version)) roots))
  ;; Exact interrupted development test fixtures, after raw command/child diagnostic archival.
  (dolist (leaf '("arcdocdb-active-4002502611-77022-0/" "arcdocdb-active-4002502612-77025-0/"))
    (push (merge-pathnames leaf (uiop:temporary-directory)) roots))
  (dolist (leaf '("1U6ZGU8-1MHF-0/" "1U6ZHXB-1MP0-0/"))
    (push (merge-pathnames leaf #p"/Users/gpicchiarelli/.arcdocdb-p3-tests/") roots))
  (dolist (root roots)
    (when (probe-file root)
      (let* ((stat (sb-posix:lstat (string-right-trim "/" (namestring root))))
             (paths (uiop:split-string
                     (uiop:run-program (list "rg" "--files" "--hidden" "--no-ignore" "-0" "--" (namestring root))
                                       :output :string :ignore-error-status t) :separator '(#\Null)))
             (bytes 0) (files 0))
        (unless (and (sb-posix:s-isdir (sb-posix:stat-mode stat)) (= (sb-posix:getuid) (sb-posix:stat-uid stat)))
          (error "Cleanup root is not an owned real directory"))
        (when (> (length paths) 1000000) (error "Cleanup inventory ceiling exceeded"))
        (dolist (path paths)
          (when (plusp (length path))
            (let ((file-stat (sb-posix:lstat path)))
              (when (sb-posix:s-isreg (sb-posix:stat-mode file-stat))
                (incf files) (incf bytes (sb-posix:stat-size file-stat))))))
        (uiop:delete-directory-tree root :validate t)
        (when (probe-file root) (error "Cleanup root remains"))
        (push (list :path (namestring root) :regular-files files :regular-file-bytes bytes :status :removed) rows))))
  (with-open-file (stream (merge-pathnames "cleanup.lisp" result-root) :direction :output :if-exists :error)
    (write (list :kind :explicit-group-worktree-cleanup :status :passed :universal-time (get-universal-time)
                 :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*) :removed (reverse rows)
                 :regular-file-bytes (loop for row in rows sum (getf row :regular-file-bytes))
                 :limits '(:regenerable-owned-paths-only :not-physical-free-space :no-shared-git-gc
                           :primary-checkout-and-other-chat-paths-untouched)) :stream stream :pretty t)
    (terpri stream))
  (format t "~S~%" (list :kind :explicit-group-worktree-cleanup :status :passed :paths (length rows)
                         :regular-file-bytes (loop for row in rows sum (getf row :regular-file-bytes)))))
