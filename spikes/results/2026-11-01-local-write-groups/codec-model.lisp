;;;; C4 independent bytes for mixed operation prefixes, canonical widths and frame refusal.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:explicit-groups.model (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local) (#:e #:arcdocdb.engine) (#:w #:arcdocdb.local.wire.tests)))
(in-package #:explicit-groups.model)
(defun ensure (truth) (unless truth (error "Explicit group independent byte model failed")) truth)
(let ((cases 0) (accepted 0) (refused 0) (space (arcdocdb.cbor:crea-spazio-cbor))
      (work (l::make-local-group-workspace)) (out (w::output)))
  (dolist (id '(1 24 65536 18446744073709551615))
    (loop for count from 1 to 8 do
      (dolist (size '(1 24 256 2048 4096 60000))
        (dolist (key-size '(1 24 1024))
          (dolist (parity '(0 1))
            (let ((ops (make-array (1+ count) :initial-element :ignored-tail)) (parts nil))
              (dotimes (i count)
                (let* ((put (evenp (+ i parity)))
                       (key (make-array key-size :element-type '(unsigned-byte 8) :initial-element (mod (* 127 i) 256)))
                       (doc (when put (w::get-document size))))
                  (setf (svref ops i) (e:crea-operazione-scrittura (if put :put :delete) key doc))
                  (push (if put (w::group-put key doc) (w::group-delete key)) parts)))
              (let* ((expected (w::request 4 (apply #'w::join (w::uint count 4) (nreverse parts)) id))
                     (fit (<= (length expected) 65540)))
                (fill out #xcc) (incf cases)
                (if fit
                    (let* ((end (l::encode-local-write-group out id ops count space 65536))
                           (env (l:decode-local-envelope out 4 end)))
                      (ensure (and (= end (length expected)) (equalp expected (subseq out 0 end))))
                      (multiple-value-bind (status actual) (l::decode-local-write-group out env space work 8)
                        (ensure (and (zerop status) (= actual count))))
                      (dotimes (i count)
                        (let ((actual (svref (l::local-group-workspace-operations work) i)) (wanted (svref ops i)))
                          (ensure (and (= (e::operazione-scrittura-kind actual) (e::operazione-scrittura-kind wanted))
                                       (equalp (e::operazione-scrittura-key actual) (e::operazione-scrittura-key wanted))
                                       (equalp (e::operazione-scrittura-value actual) (e::operazione-scrittura-value wanted))))))
                      (l::clear-local-group-workspace work) (incf accepted))
                    (let ((caught nil))
                      (handler-case (l::encode-local-write-group out id ops count space 65536)
                        (arcdocdb.conditions:resource-exhausted () (setf caught t)))
                      (ensure caught) (ensure (every (lambda (n) (= #xcc n)) out)) (incf refused))))))))))
  (ensure (= cases 1152 (+ accepted refused)))
  (format t "~S~%" (list :kind :explicit-group-byte-model :status :passed :cases cases :accepted accepted :refused refused
                         :independent-writer t :unselected-tail :invalid-and-ignored :benchmark nil)))
