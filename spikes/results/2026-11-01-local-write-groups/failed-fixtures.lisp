;;;; C4: keep exact raw child diagnostics before removing only our two failed development fixtures.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (copies nil) (fixtures nil))
  (dolist (leaf '("1U6ZGU8-1MHF-0/" "1U6ZHXB-1MP0-0/"))
    (let ((directory (merge-pathnames leaf #p"/Users/gpicchiarelli/.arcdocdb-p3-tests/")))
      (unless (probe-file directory) (error "Owned failed fixture is missing"))
      (push (namestring directory) fixtures)
      (dolist (path (uiop:directory-files directory))
        (when (member (pathname-type path) '("stdout" "stderr") :test #'equal)
          (let* ((target (merge-pathnames (format nil "development-fixtures/~A~A" leaf (file-namestring path)) root))
                 (hash (arcdocdb.evidence:file-sha256 path)))
            (ensure-directories-exist target)
            (unless (probe-file target) (uiop:copy-file path target))
            (unless (string= hash (arcdocdb.evidence:file-sha256 target)) (error "Owned fixture byte mismatch"))
            (push (list :source (namestring path) :target (namestring target) :sha256 hash) copies))))))
  (with-open-file (out (merge-pathnames "failed-fixture-archive.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :explicit-group-failed-fixtures :status :passed :fixtures (nreverse fixtures) :copies (nreverse copies))
           :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :explicit-group-failed-fixture-archive :status :passed :raw-files (length copies))))
