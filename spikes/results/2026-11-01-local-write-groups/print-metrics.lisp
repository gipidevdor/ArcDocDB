(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((*read-eval* nil) (root (uiop:pathname-directory-pathname *load-truename*))
       (data (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "metrics.lisp" root)
               (lambda (path) (with-open-file (in path) (read in))))) (rows (getf data :rows)))
  (format t "| Format | Primary | Document | Baseline writes/s | Final single writes/s | Group 8 writes/s | Group/single | RPC p99 (ms) |~%")
  (format t "|---|---|---:|---:|---:|---:|---:|---:|~%")
  (dolist (row rows)
    (when (= 8 (getf row :width))
      (let ((single (find-if (lambda (one) (and (= 1 (getf one :width))
                                 (= (getf one :version) (getf row :version)) (eq (getf one :mode) (getf row :mode))
                                 (= (getf one :value-bytes) (getf row :value-bytes)))) rows)))
        (format t "| v~D | ~A | ~D | ~,0F | ~,0F | ~,0F | ~,2Fx | ~,3F |~%"
          (getf row :version) (string-downcase (symbol-name (getf row :mode))) (getf row :value-bytes)
          (getf row :baseline-writes-per-second) (getf single :median-writes-per-second)
          (getf row :median-writes-per-second) (getf row :versus-same-server-individual) (/ (getf row :rpc-p99-us) 1000d0)))))
  (dolist (width '(1 2 4 8))
    (let* ((selected (remove-if-not (lambda (row) (= width (getf row :width))) rows))
           (ratios (sort (mapcar (lambda (row) (getf row :versus-same-server-individual)) selected) #'<))
           (base (sort (mapcar (lambda (row) (getf row :versus-baseline)) selected) #'<)))
      (format t "~S~%" (list :width width :same-server-min (first ratios) :same-server-median (/ (+ (nth 3 ratios) (nth 4 ratios)) 2)
                             :same-server-max (car (last ratios)) :baseline-min (first base) :baseline-max (car (last base)))))))
