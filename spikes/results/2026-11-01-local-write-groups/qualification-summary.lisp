;;;; C4: retain terminal signals and structured crash/local-process counts without long raw log lines.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Qualification summary oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (with-open-file (in expanded) (read in))))))
(defun forms (text kind)
  (let ((marker (format nil "(:KIND ~S" kind)) (cursor 0) (out nil) (*read-eval* nil))
    (loop for start = (search marker text :start2 cursor) while start do
      (multiple-value-bind (form end) (read-from-string text nil nil :start start)
        (ensure (eq kind (getf form :kind))) (push form out) (setf cursor end))) (nreverse out)))
(let ((root (uiop:pathname-directory-pathname *load-truename*)) (rows nil))
  (dolist (name '("full-check-2.6.9" "strict-2.6.10"))
    (let* ((record (read-data (merge-pathnames (format nil "~A/report.lisp" name) root))) (stdout (getf record :stdout))
           (matrix (forms stdout :group-crash-matrix)) (local (forms stdout :production-local-tests)))
      (ensure (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
                   (search "build e test: nessun avviso, tutti i controlli superati" stdout)))
      (ensure (and (= 1 (length matrix)) (eq :passed (getf (first matrix) :status))
                   (= 36 (getf (first matrix) :scenarios)) (= 108 (getf (first matrix) :children))
                   (= 72 (getf (first matrix) :sigkills))))
      (ensure (and (= 1 (length local)) (eq :passed (getf (first local) :status))
                   (null (getf (first local) :condition)) (null (getf (first local) :cleanup-errors))))
      (push (list :name name :source-files (length (getf record :source-blobs-after))
                  :group-crash-matrix (first matrix) :local-methods (getf (first local) :tests)
                  :local-children (length (getf (first local) :processes)) :local-scenarios (length (getf (first local) :scenarios))
                  :local-sigkills (getf (first local) :sigkills) :terminal-build-marker t) rows)))
  (with-open-file (out (merge-pathnames "qualification.lisp" root) :direction :output :if-exists :error)
    (write (list :kind :explicit-group-qualification-summary :status :passed :rows (nreverse rows)) :stream out :pretty t) (terpri out))
  (format t "~S~%" '(:kind :explicit-group-qualification-summary :status :passed)))
