;;;; C4: reject changed/incomplete qualification and compare the complete current source inventory.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defun ensure (truth) (unless truth (error "Explicit Unix source qualification oracle failed")) truth)
(defun read-data (path)
  (let ((*read-eval* nil))
    (arcdocdb.evidence:call-with-evidence-bytes path (lambda (expanded) (with-open-file (in expanded) (read in))))))
(defun qualified (record marker)
  (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency)) (eql 0 (getf record :exit-code))
       (equal (getf record :source-blobs-before) (getf record :source-blobs-after))
       (consp (getf record :source-blobs-after)) (search marker (getf record :stdout))))
(defun current-sources ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                       (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                           :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-trim '(#\Newline #\Return)
                    (uiop:run-program (append '("git" "hash-object" "--") paths) :output :string)) :separator '(#\Newline))))
    (ensure (= (length paths) (length hashes)))
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(let ((args (uiop:command-line-arguments)) (root (uiop:pathname-directory-pathname *load-truename*)))
  (cond
    ((equal args '("--self-test"))
     (let ((record (list :status :ok :source-consistency :stable :exit-code 0
                         :source-blobs-before '(one) :source-blobs-after '(one) :stdout "COMPLETE")))
       (ensure (qualified record "COMPLETE"))
       (dolist (mutation '((:status :running) (:source-consistency :changed) (:exit-code 1)
                           (:source-blobs-after (two)) (:stdout "incomplete")))
         (let ((bad (copy-list record))) (setf (getf bad (first mutation)) (second mutation))
           (ensure (not (qualified bad "COMPLETE")))))
       (format t "~S~%" '(:kind :explicit-group-identity-self-test :status :passed :negatives 5))))
    ((equal args '("--run"))
     (let* ((sources (current-sources)) (records nil)
            (baseline (read-data (merge-pathnames "baseline/report.lisp" root))))
       (ensure (qualified baseline ":EXPLICIT-UNIX-GROUP-CAMPAIGN :STATUS :PASSED"))
       (ensure (= 1640 (length (getf baseline :source-blobs-after))))
       (ensure (equal (getf baseline :source-blobs-after)
                      (getf (read-data (merge-pathnames "../2026-11-01-engine-group-append/source-identity.lisp" root)) :sources)))
       (dolist (entry '(("focused" ":EXPLICIT-LOCAL-GROUP-FOCUSED :STATUS :PASSED")
                        ("codec-model" ":EXPLICIT-GROUP-BYTE-MODEL :STATUS :PASSED")
                        ("full-check-2.6.9" "build e test: nessun avviso, tutti i controlli superati")
                        ("strict-2.6.10" "build e test: nessun avviso, tutti i controlli superati")
                        ("documentation" "Public Lisp example passed:")
                        ("benchmark" ":EXPLICIT-UNIX-GROUP-CAMPAIGN :STATUS :PASSED")))
         (let ((record (read-data (merge-pathnames (format nil "~A/report.lisp" (first entry)) root))))
           (ensure (qualified record (second entry)))
           (ensure (equal sources (getf record :source-blobs-after)))
           (push (list :name (first entry) :status :passed :source-files (length sources)) records)))
       (ensure (eq :passed (getf (read-data (merge-pathnames "metrics.lisp" root)) :status)))
       (with-open-file (out (merge-pathnames "source-identity.lisp" root) :direction :output :if-exists :error)
         (write (list :kind :explicit-group-source-identity :status :passed :source-files (length sources)
                      :commands (nreverse records) :baseline-files 1640 :sources sources) :stream out :pretty t) (terpri out))
       (format t "~S~%" (list :kind :explicit-group-identity :status :passed :qualified-source-files (length sources)))))
    ((equal args '("--current"))
     (let ((identity (read-data (merge-pathnames "source-identity.lisp" root))))
       (ensure (and (eq :passed (getf identity :status)) (equal (current-sources) (getf identity :sources))))
       (format t "~S~%" (list :kind :explicit-group-current-source :status :passed :source-files (getf identity :source-files)))))
    (t (error "Use --self-test, --run or --current"))))
