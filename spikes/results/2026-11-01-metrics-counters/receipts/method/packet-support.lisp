;;;; Trusted C4 libraries only; no CI producer entrypoint is loaded.
(require :asdf)
(require :sb-posix)
(defpackage #:arcdocdb.ci (:use #:cl))
(defparameter arcdocdb.ci::*ci-root* (truename "./"))
(defparameter arcdocdb.ci::*ci-entry* (merge-pathnames "tools/ci.lisp" (truename "./")))
(defparameter arcdocdb.ci::*ci-sbcl* (namestring sb-ext:*runtime-pathname*))
(load (merge-pathnames "tools/evidence-storage.lisp" (truename "./")))
(dolist (name '("data" "identity" "support" "archive"))
  (load (merge-pathnames (format nil "tools/ci/~A.lisp" name) (truename "./"))))
(in-package #:cl-user)
(defun save-data (data path)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream))))
(defun add-compact-file (source stage relative)
  (let ((bytes (arcdocdb.evidence:file-bytes source)) (hash (arcdocdb.evidence:file-sha256 source)))
    (prog1
        (mapcar (lambda (row) (list :source (namestring (merge-pathnames (getf row :path) stage))
                                   :path (getf row :path)))
                (arcdocdb.ci::ci-packet-file source stage relative))
      (unless (and (= bytes (arcdocdb.evidence:file-bytes source))
                   (string= hash (arcdocdb.evidence:file-sha256 source)))
        (error "Original changed during retention: ~A" source)))))
(defun add-command-record (directory label stage)
  (let* ((source (merge-pathnames "report.lisp" directory))
         (record (arcdocdb.evidence:read-evidence source))
         (relative (format nil "processes/~A/report.lisp" label)) (files nil))
    (unless (and (eq :command-verification (getf record :kind))
                 (member (getf record :status) '(:ok :failed :source-changed))
                 (getf record :finished-at-universal-time))
      (error "Nonterminal command record: ~A" source))
    (setf files (add-compact-file source stage relative))
    (dolist (side '("report.lisp.gz" "conservazione.lisp"))
      (let ((path (merge-pathnames side directory)))
        (when (probe-file path)
          (setf files (append files (add-compact-file path stage (format nil "processes/~A/~A" label side)))))))
    (values files (list :label label :record-path relative))))
