(require :asdf)
(require :sb-posix)
(defparameter *out* (merge-pathnames "spikes/out/metrics-main-merge-20261101/full/" (truename "./")))
(ensure-directories-exist *out*)
(sb-posix:setenv "ASDF_OUTPUT_TRANSLATIONS"
                (format nil "(:output-translations ((:root :**/ :*.*.*) (~S :**/ :*.*.*)) :ignore-inherited-configuration)"
                        (namestring (merge-pathnames "fasl/" *out*))) 1)
(asdf:initialize-output-translations)
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (condition)
                         (unless (typep condition 'sb-kernel:redefinition-warning) (error condition)))))
  (let ((*compile-verbose* nil) (*compile-print* nil) (*load-verbose* nil))
    (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
    (asdf:load-system "arcdocdb" :force '("arcdocdb"))
    (asdf:load-system "arcdocdb/local" :force '("arcdocdb/local"))
    (asdf:load-system "arcdocdb/tests" :force '("arcdocdb/tests")))
  (unless (= 60 (length (uiop:symbol-call :arcdocdb.ci.tests :suite-specifications)))
    (error "Combined suite catalog must contain 60 distinct suites."))
  (unless (= 9 (length (symbol-value (find-symbol "*COVERAGE-EXCLUSIONS*" "ARCDOCDB.CI.TESTS"))))
    (error "Combined allocation coverage exclusions must remain explicit."))
  (let ((report (uiop:symbol-call :arcdocdb.ci.tests :run :report-path (merge-pathnames "tests.lisp" *out*))))
    (format t "~S~%" (list :kind :metrics-main-integration-verification :status (getf report :status)
                           :planned (getf report :planned) :passed (getf report :passed)
                           :failed (getf report :failed) :not-run (getf report :not-run)
                           :skipped (getf report :skipped) :suites (length (getf report :suites))
                           :strict-compilation t :performance-measurement nil))
    (unless (eq :passed (getf report :status)) (error "Combined product catalog failed."))))
