;;;; C4: independent ledger/quantile/copy checks and window-level comparisons.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:unix-latency-analysis (:use #:cl))
(in-package #:unix-latency-analysis)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :analysis)) (unless truth (error "Unix analysis: ~S" reason)) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<)) (count (length sorted)))
    (ensure (plusp count))
    (if (oddp count) (nth (floor count 2) sorted)
        (/ (+ (nth (1- (floor count 2)) sorted) (nth (floor count 2) sorted)) 2))))
(defun key (row)
  (mapcar (lambda (field) (getf row field))
          '(:version :mode :document-bytes :connections :write-twentieths :maintenance :calibration)))
(defun q (row rank)
  (getf (find rank (getf (getf row :histogram) :quantiles) :key (lambda (entry) (getf entry :per-thousand))) :exact))
(defun valid-row (row rounds)
  (handler-case
    (let* ((width (getf row :connections)) (count (* width rounds)) (rate (getf row :write-twentieths))
           (raw (getf row :latency-ticks)) (csns (getf row :write-csns)) (hist (getf row :histogram))
           (writes (* count (/ rate 20))) (frontier (getf row :frontier-before))
           (sorted (sort (copy-seq raw) #'<)) (positive (sort (remove 0 csns) #'<)))
      (and (eq :unix-client-window (getf row :kind)) (member width '(1 2 4 8))
           (member rate '(0 1 10)) (member (getf row :version) '(1 2))
           (member (getf row :mode) '(:resident :paged)) (member (getf row :document-bytes) '(64 1024 60000))
           (= count (getf row :operations) (length raw) (length csns) (getf hist :count))
           (= writes (getf row :writes) (length positive))
           (= (getf row :returned-document-bytes) (* (- count writes) (getf row :document-bytes)))
           (= (getf row :frontier-after) (+ frontier writes))
           (loop for csn across positive for n from (1+ frontier) always (= csn n))
           (plusp (getf row :wall-ticks)) (plusp (getf row :ticks-per-second))
           (every (lambda (entry)
             (let ((exact (aref sorted (1- (ceiling (* count (getf entry :per-thousand)) 1000)))))
               (and (eq :ok (getf entry :status)) (eq t (getf entry :complete))
                    (= exact (getf entry :exact)) (<= (getf entry :lower) exact (getf entry :upper)))))
             (getf hist :quantiles))
           (= 4 (length (getf hist :quantiles))) (= (aref sorted (1- count)) (getf hist :max))))
    (error () nil)))
(defun metric (row field)
  (/ (* 1d0 (getf row field)) (getf row :ticks-per-second)))
(defun case-summary (rows server)
  (let ((first (first rows)))
    (list :key (key first) :windows (length rows)
      :median-operations-per-second (median (mapcar (lambda (r) (/ (getf r :operations) (metric r :wall-ticks))) rows))
      :median-MB-per-second (median (mapcar (lambda (r) (/ (getf r :returned-document-bytes) (metric r :wall-ticks) 1000000)) rows))
      :median-window-P50-us (median (mapcar (lambda (r) (* 1d6 (/ (q r 500) (getf r :ticks-per-second)))) rows))
      :median-window-P99-us (median (mapcar (lambda (r) (* 1d6 (/ (q r 990) (getf r :ticks-per-second)))) rows))
      :median-client-allocated-bytes-per-op (median (mapcar (lambda (r) (/ (getf r :allocated-bytes) (getf r :operations))) rows))
      :median-server-allocated-bytes-per-op (median (loop for r in rows for s in server collect
                                                     (/ (getf s :allocated-bytes) (getf r :operations))))
      :strong-groups (reduce #'+ server :key (lambda (r) (getf r :strong-groups)))
      :writes (reduce #'+ rows :key (lambda (r) (getf r :writes))))))
(defun campaign (name)
  (let* ((root (merge-pathnames (uiop:ensure-directory-pathname name) *here*))
         (start (data (merge-pathnames "started.lisp" root))) (done (data (merge-pathnames "completed.lisp" root)))
         (calibration (not (null (member (first (getf done :command)) '("--calibrate" "--self-test") :test #'equal))))
         (small (not (null (member (first (getf done :command)) '("--self-test" "--transport-self-test") :test #'equal))))
         (transport (not (null (member (first (getf done :command)) '("--transport-check" "--transport-self-test") :test #'equal))))
         (rounds (if small 20 400)) (repeats (if small 2 (if calibration 6 5)))
         (expected (if transport 4 (if small 2 (if calibration 8 66)))) (cases nil) (all nil) (server-all nil))
    (ensure (and (eq :passed (getf done :status)) (= expected (getf done :cases))
                 (= (* expected repeats) (getf done :windows))))
    (loop for file in '("bench.lisp" "server.lisp" "common.lisp")
          for field in '(:driver-sha256 :server-sha256 :common-sha256) do
      (ensure (string= (getf start field) (arcdocdb.evidence:file-sha256 (merge-pathnames file *here*))) :driver-identity))
    (dolist (copy (getf done :copies))
      (ensure (arcdocdb.evidence:call-with-evidence-bytes (getf copy :target)
        (lambda (path) (and (= (getf copy :bytes) (arcdocdb.evidence:file-bytes path))
                           (string= (getf copy :sha256) (arcdocdb.evidence:file-sha256 path))))) :child-copy))
    (loop for stage from 1 to expected do
      (let* ((bundle (data (merge-pathnames (format nil "server-~D.lisp" stage) root)))
             (server (getf bundle :windows))
             (rows (loop for rep below repeats collect
                     (data (merge-pathnames (format nil "windows/~D-~D.lisp" stage rep) root))))
             (frontier (* 8 (getf (first rows) :connections))))
        (ensure (= repeats (length server)))
        (loop for row in rows for state in server for rep from 0 do
          (ensure (valid-row row rounds) :row) (ensure (= rep (getf row :window) (getf state :window)))
          (ensure (= frontier (getf row :frontier-before))) (setf frontier (getf row :frontier-after))
          (ensure (and (= (getf row :writes) (getf state :writes))
                       (<= (ceiling (getf row :writes) 8) (getf state :strong-groups) (getf row :writes))
                       (equal (getf state :frontier) (list 0 frontier 0 frontier))
                       (eq (getf row :mode) (getf (getf state :index) :mode))
                       (eq (getf row :profile) (and calibration (oddp rep)))
                       (eq (getf row :profile) (getf state :profile))) :server-ledger)
          (when (getf state :profile)
            (ensure (= (getf row :operations) (getf state :responses)
                       (getf (second (assoc :queue-residence (getf state :phases))) :count)))))
        (push (case-summary rows server) cases) (setf all (append all rows) server-all (append server-all server))))
    (list :name name :status :passed :runtime (getf done :runtime) :cases (reverse cases)
          :windows (length all) :operations (reduce #'+ all :key (lambda (r) (getf r :operations)))
          :raw all :server server-all)))
(defun public-summary (campaign) (let ((copy (copy-list campaign))) (remf copy :raw) (remf copy :server) copy))
(defun calibration-summary (campaign)
  (loop for rows on (getf campaign :raw) by (lambda (x) (nthcdr 6 x))
        for states on (getf campaign :server) by (lambda (x) (nthcdr 6 x)) collect
    (list :key (key (first rows))
      :paired-profile-wall-ratios (loop for pair on (subseq rows 0 6) by #'cddr collect
                                   (/ (getf (second pair) :wall-ticks) (float (getf (first pair) :wall-ticks) 1d0)))
      :profiled-server-windows (loop for state in (subseq states 0 6) when (getf state :profile) collect state))))
(defun save (name result)
  (let ((path (merge-pathnames name *here*)))
    (if (probe-file path) (ensure (equalp result (data path)) :repeat-analysis)
        (with-open-file (out path :direction :output :if-exists :error) (write result :stream out :pretty t) (terpri out)))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let* ((sample (data (merge-pathnames "smoke-05/windows/1-0.lisp" *here*))) (negatives 0))
        (ensure (valid-row sample 20))
        (dolist (field '(:writes :returned-document-bytes :frontier-after :operations))
          (let ((bad (copy-list sample))) (incf (getf bad field)) (ensure (not (valid-row bad 20))) (incf negatives)))
        (let ((bad (copy-tree sample))) (setf (getf (first (getf (getf bad :histogram) :quantiles)) :complete) nil)
          (ensure (not (valid-row bad 20))) (incf negatives))
        (format t "~S~%" (list :kind :unix-analysis-self-test :status :passed :negatives negatives))))
    ((and (= 2 (length args)) (equal (first args) "--check"))
      (let ((result (campaign (second args))))
        (save (format nil "~A-analysis.lisp" (string-right-trim "/" (second args)))
              (list :kind :unix-analysis :campaign (public-summary result)
                    :calibration (when (getf (first (getf result :raw)) :calibration) (calibration-summary result))))
        (format t "~S~%" (public-summary result))))
    ((and (= 3 (length args)) (equal (first args) "--compare"))
      (let ((before (campaign (second args))) (after (campaign (third args))) (comparisons nil))
        (ensure (equal (getf before :runtime) (getf after :runtime)) :same-runtime)
        (loop for right in (getf after :cases)
              for left = (find (getf right :key) (getf before :cases) :key (lambda (r) (getf r :key)) :test #'equal) do
          (ensure left :matching-baseline)
          (push (list :key (getf left :key) :baseline left :candidate right
                  :throughput-gain (/ (getf right :median-operations-per-second) (getf left :median-operations-per-second))) comparisons))
        (save (format nil "comparison-~A.lisp" (substitute #\- #\/ (string-right-trim "/" (third args))))
              (list :kind :unix-comparison :status :passed :before (public-summary before)
                    :after (public-summary after) :cases (reverse comparisons)))
        (format t "~S~%" (list :kind :unix-comparison :status :passed :cases (length comparisons)))))
    (t (error "Use --self-test, --check campaign/, or --compare before/ after/"))))
