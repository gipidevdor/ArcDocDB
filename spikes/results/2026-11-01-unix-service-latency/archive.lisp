;;;; C4: scoped copy archive of completed commands and explicitly named failed private fixtures.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:unix-latency-archive (:use #:cl))
(in-package #:unix-latency-archive)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth) (unless truth (error "Unix archive byte/capability oracle")) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun hash-matches (path hash)
  (or (string= hash (arcdocdb.evidence:file-sha256 path))
      (arcdocdb.evidence:call-with-evidence-bytes path
        (lambda (file) (string= hash (arcdocdb.evidence:file-sha256 file))))))
(defun copy-one (source target)
  (let ((hash (arcdocdb.evidence:file-sha256 source)) (bytes (arcdocdb.evidence:file-bytes source)))
    (unless (probe-file target) (ensure-directories-exist target) (uiop:copy-file source target))
    (ensure (hash-matches target hash))
    (list :source (namestring source) :target (namestring target) :sha256 hash :bytes bytes)))
(defun copy-directory-tree (source target)
  (append (loop for file in (uiop:directory-files source) collect (copy-one file (merge-pathnames (file-namestring file) target)))
          (loop for child in (uiop:subdirectories source) append
            (copy-directory-tree child (merge-pathnames (format nil "~A/" (car (last (pathname-directory child)))) target)))))
(defun retained-root (text)
  (let ((start (search "(:KIND :PRODUCTION-LOCAL-TESTS" text)) (*read-eval* nil))
    (when start (let ((form (read-from-string text nil nil :start start)))
                  (when (and (eq :failed (getf form :status)) (getf form :retained)) (getf form :root))))))
(defun collect-commands ()
  (let ((copies nil) (failed nil) (commands nil))
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((name (car (last (pathname-directory directory)))))
        (when (probe-file (merge-pathnames "report.lisp" directory))
          (let ((record (if (uiop:string-prefix-p "unix-latency-" name)
                            (data (merge-pathnames "report.lisp" directory))
                            (handler-case (data (merge-pathnames "report.lisp" directory)) (error () nil)))))
            (when (and (eq :command-verification (getf record :kind)) (not (eq :running (getf record :status))))
              (push (list :name name :status (getf record :status) :source-consistency (getf record :source-consistency)) commands)
              (setf copies (append copies (copy-directory-tree directory (merge-pathnames (format nil "commands/~A/" name) *here*))))
              (let ((root (retained-root (getf record :stdout)))) (when root (pushnew root failed :test #'equal))))))))
    ;; Completed worker logs and top-level self-test receipts; corrupted nested negative fixtures stay excluded.
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((name (car (last (pathname-directory directory)))))
        (cond
          ((or (uiop:string-prefix-p "evidence-check-" name)
               (and (search "-check-" name) (not (uiop:string-prefix-p "unix-latency-" name))))
           (setf copies (append copies (copy-directory-tree directory (merge-pathnames (format nil "support/~A/" name) *here*)))))
          (t (dolist (leaf '("self-test-report.lisp"))
               (let ((file (merge-pathnames leaf directory)))
                 (when (probe-file file) (push (copy-one file (merge-pathnames (format nil "support/~A/~A" name leaf) *here*)) copies))))))))
    (when (probe-file #p"spikes/out/ci/")
      (dolist (directory (uiop:subdirectories #p"spikes/out/ci/"))
        (let ((name (car (last (pathname-directory directory)))))
          (when (uiop:string-prefix-p "selftest-" name)
            (dolist (file (uiop:directory-files directory))
              (push (copy-one file (merge-pathnames (format nil "support/ci/~A/~A" name (file-namestring file)) *here*)) copies))))))
    (dolist (root failed)
      (let ((path (pathname root)) (parent (merge-pathnames ".arcdocdb-p3-tests/" (user-homedir-pathname))))
        (ensure (uiop:subpathp path parent))
        (setf copies (append copies (copy-directory-tree path (merge-pathnames (format nil "failed-fixtures/~A/"
                                  (car (last (pathname-directory path)))) *here*))))))
    (list :kind :unix-command-archive :status :passed :commands (sort commands #'string< :key (lambda (r) (getf r :name)))
          :failed-fixture-roots (sort failed #'string<) :copies copies :limits '(:negative-nested-self-test-fixtures-excluded))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (uiop:with-temporary-file (:pathname source :stream out :keep t)
        (write-string "Exact diagnostic with trailing spaces.  " out) (finish-output out)
        (let ((target (pathname (concatenate 'string (namestring source) ".copy"))))
          (unwind-protect
            (progn (copy-one source target)
              (with-open-file (stream target :direction :output :if-exists :supersede) (write-string "changed" stream))
              (ensure (handler-case (progn (copy-one source target) nil) (error () t))))
            (delete-file source) (when (probe-file target) (delete-file target)))))
      (format t "~S~%" '(:kind :unix-archive-self-test :status :passed :altered-copy :detected)))
    ((and (= 2 (length args)) (equal (first args) "--run"))
      (let ((result (collect-commands)))
        (with-open-file (out (merge-pathnames (second args) *here*) :direction :output :if-exists :error)
          (write result :stream out :pretty t) (terpri out))
        (format t "~S~%" (list :kind :unix-command-archive :status :passed :files (length (getf result :copies))))))
    (t (error "Use --self-test or --run manifest.lisp"))))
