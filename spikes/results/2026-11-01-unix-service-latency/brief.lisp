;;;; C4: compact rendering of the separately checked ledger; no new inference.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((root (uiop:pathname-directory-pathname *load-truename*)) (*read-eval* nil))
  (dolist (name (uiop:command-line-arguments))
    (let ((data (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames name root)
                  (lambda (file) (with-open-file (in file) (read in))))))
      (format t "~&~A~%" name)
      (dolist (row (getf (getf data :campaign) :cases))
        (destructuring-bind (version mode size width rate maintenance calibration) (getf row :key)
          (when (and (= version 2) (member width '(1 8)) (member size '(1024 60000)))
            (format t "v~D ~A ~D bytes n~D PUT~D/20 maint~S profile~S: ~,1F ops/s ~,2F MB/s P50 ~,2F us P99 ~,2F us alloc C/S ~,1F/~,1F B/op~%"
              version mode size width rate maintenance calibration (getf row :median-operations-per-second)
              (getf row :median-MB-per-second) (getf row :median-window-P50-us) (getf row :median-window-P99-us)
              (getf row :median-client-allocated-bytes-per-op) (getf row :median-server-allocated-bytes-per-op)))))
      (dolist (row (getf data :calibration))
        (format t "~S overhead: ~{~,3F ~}~%" (getf row :key) (getf row :paired-profile-wall-ratios))
        (dolist (state (getf row :profiled-server-windows))
          (format t "window ~D accept/op ~,3F: " (getf state :window)
            (/ (getf state :accept-calls) (float (getf state :responses) 1d0)))
          (dolist (name '(:queue-residence :engine-read :accept :dispatch :send))
            (let* ((hist (second (assoc name (getf state :phases)))) (q (first (getf hist :quantiles)))
                   (scale (/ 1d6 (getf state :ticks-per-second))))
              (format t "~A P50[~,2F,~,2F]us " name (* scale (getf q :lower)) (* scale (getf q :upper)))))
          (terpri)))
      (dolist (row (getf data :cases))
        (let ((key (getf row :key)))
          (when (and (eql 2 (first key)) (member (fourth key) '(1 8)))
            (format t "~S gain ~,4Fx P50 ~,2F -> ~,2F us MB/s ~,2F -> ~,2F~%" key (getf row :throughput-gain)
              (getf (getf row :baseline) :median-window-P50-us) (getf (getf row :candidate) :median-window-P50-us)
              (getf (getf row :baseline) :median-MB-per-second) (getf (getf row :candidate) :median-MB-per-second))))))))
