;;;; C4 self-recording cleanup: exact owned worktree, closed archive and named failed fixtures only.
(require :asdf)
(require :sb-posix)
(load (merge-pathnames "../../../tools/evidence-storage.lisp" *load-truename*))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (let* ((fixture (merge-pathnames (format nil "spikes/out/unix-cleanup-guard-~D/" (sb-posix:getpid)) (truename "./")))
         (marker (merge-pathnames "keep.txt" fixture)))
    (ensure-directories-exist (merge-pathnames ".parent" (uiop:pathname-parent-directory-pathname fixture)))
    (sb-posix:mkdir fixture #o700)
    (unwind-protect
      (progn
        (with-open-file (out marker :direction :output :if-exists :error) (write-string "owned fixture stays" out))
        (multiple-value-bind (stdout stderr code)
            (uiop:run-program (list (namestring sb-ext:*runtime-pathname*) "--script" (namestring *load-truename*))
                              :directory fixture :output :string :error-output :string :ignore-error-status t)
          (declare (ignore stdout))
          (unless (and (not (zerop code)) (search "Own worktree and completed evidence closure required" stderr)
                       (equal "owned fixture stays" (uiop:read-file-string marker)))
            (error "Cleanup scope rejection failed"))))
      (uiop:delete-directory-tree fixture :validate t)))
  (format t "~S~%" '(:kind :unix-cleanup-self-test :status :passed :wrong-worktree :rejected :marker :preserved))
  (sb-ext:exit :code 0))
(when (uiop:command-line-arguments) (error "Use --self-test or no arguments after evidence closure"))
(let* ((worktree (truename "./")) (here (uiop:pathname-directory-pathname *load-truename*))
       (roots (list (merge-pathnames "_build/" worktree) (merge-pathnames "spikes/out/" worktree))) (rows nil))
  (labels ((data (name)
             (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames name here)
               (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in)))))))
    (unless (and (equal worktree #p"/Users/gpicchiarelli/.codex/worktrees/m1-service-index-discovery/ArcDocDB/")
                 (eq :unix-buffer-evidence-closure (getf (data "closure.lisp") :kind))
                 (eq :passed (getf (data "closure.lisp") :status)))
      (error "Own worktree and completed evidence closure required"))
    (let ((tail (data "tail-archive-data.lisp")))
      (unless (and (eq :passed (getf tail :status))
                   (every (lambda (name)
                            (let ((entry (find name (getf tail :commands) :key (lambda (r) (getf r :name)) :test #'equal)))
                              (and (eq :ok (getf entry :status)) (eq :stable (getf entry :source-consistency)))))
                          '("unix-latency-close" "unix-latency-closing-archive")))
        (error "Closure command and final archive receipts must be retained before cleanup")))
    (dolist (directory (uiop:subdirectories (merge-pathnames "spikes/" worktree)))
      (when (uiop:string-prefix-p "SPK-" (car (last (pathname-directory directory))))
        (push (merge-pathnames "out/" directory) roots)))
    (dolist (version '("2.6.9" "2.6.10"))
      (push (pathname (format nil "/Users/gpicchiarelli/.cache/common-lisp/sbcl-~A-macosx-arm64/Users/gpicchiarelli/.codex/worktrees/m1-service-index-discovery/ArcDocDB/" version)) roots))
    (dolist (name (getf (data "final-archive.lisp") :failed-fixture-roots))
      (let ((path (pathname name)))
        (unless (uiop:subpathp path (merge-pathnames ".arcdocdb-p3-tests/" (user-homedir-pathname)))
          (error "Fixture outside private parent")) (push path roots)))
    (dolist (root roots)
      (when (probe-file root)
        (let* ((stat (sb-posix:lstat (string-right-trim "/" (namestring root))))
               (paths (uiop:split-string
                 (uiop:run-program (list "rg" "--files" "--hidden" "--no-ignore" "-0" "--" (namestring root))
                                   :output :string :ignore-error-status t) :separator '(#\Null)))
               (bytes 0) (files 0))
          (unless (and (sb-posix:s-isdir (sb-posix:stat-mode stat)) (= (sb-posix:getuid) (sb-posix:stat-uid stat)))
            (error "Cleanup root is not an owned real directory"))
          (when (> (length paths) 1000000) (error "Cleanup inventory ceiling"))
          (dolist (path paths) (when (plusp (length path))
            (let ((file (sb-posix:lstat path)))
              (when (sb-posix:s-isreg (sb-posix:stat-mode file)) (incf files) (incf bytes (sb-posix:stat-size file))))))
          (uiop:delete-directory-tree root :validate t)
          (when (probe-file root) (error "Cleanup root remains"))
          (push (list :path (namestring root) :files files :logical-bytes bytes :status :removed) rows))))
    (with-open-file (out (merge-pathnames "cleanup.lisp" here) :direction :output :if-exists :error)
      (write (list :kind :unix-buffer-worktree-cleanup :status :passed :universal-time (get-universal-time)
              :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*) :removed (reverse rows)
              :logical-bytes (loop for row in rows sum (getf row :logical-bytes))
              :limits '(:own-regenerable-paths-only :not-physical-free-space :no-shared-git-gc :other-worktrees-untouched))
             :stream out :pretty t) (terpri out))
    (format t "~S~%" (list :kind :unix-buffer-worktree-cleanup :status :passed :paths (length rows)
                          :logical-bytes (loop for row in rows sum (getf row :logical-bytes))))))
