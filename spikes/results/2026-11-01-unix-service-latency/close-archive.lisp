;;;; C4: verified lossless closure, scoped to this one completed campaign.
(require :asdf)
(let ((args (uiop:command-line-arguments)) (here (uiop:pathname-directory-pathname *load-truename*)))
  (flet ((valid (values)
           (handler-case
             (and (= 4 (length values)) (equal (first values) "--root")
                  (equal (nthcdr 2 values) '("--jobs" "1")) (equal (truename (second values)) here))
             (error () nil))))
    (when (equal args '("--self-test"))
      (unless (and (valid (list "--root" (namestring here) "--jobs" "1"))
                   (not (valid '("--root" "/" "--jobs" "1")))
                   (not (valid (list "--root" (namestring here) "--jobs" "4")))
                   (not (valid (list "--root" (namestring here)))))
        (error "Closure scope self-test"))
      (format t "~S~%" '(:kind :unix-closure-self-test :status :passed :negatives 3))
      (sb-ext:exit :code 0))
    (unless (valid args) (error "Explicit own result root and one compaction worker required"))))
(load "tools/compact-evidence.lisp")
(defpackage #:unix-latency-closure (:use #:cl))
(in-package #:unix-latency-closure)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth) (unless truth (error "Unix evidence closure failed")) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun hash-matches (path hash)
  (or (string= hash (arcdocdb.evidence:file-sha256 path))
      (arcdocdb.evidence:call-with-evidence-bytes path
        (lambda (file) (string= hash (arcdocdb.evidence:file-sha256 file))))))
(defun compact-tree (directory nested)
  (let ((rows nil))
    (dolist (file (uiop:directory-files directory))
      (let ((type (pathname-type file)) (name (file-namestring file)))
        (when (and (not (probe-file (pathname (concatenate 'string (namestring file) ".gz"))))
                   (or (and (member type '("stdout" "stderr") :test #'equal) (> (arcdocdb.evidence:file-bytes file) 1024))
                       (and (equal type "lisp") (> (arcdocdb.evidence:file-bytes file) 4096)
                            (or nested (member name '("initial-archive.lisp" "final-archive.lisp" "source-identity.lisp"
                               "baseline-analysis.lisp" "baseline-profile-analysis.lisp" "buffer-profile-analysis.lisp"
                               "comparison-final.lisp" "statistics-data.lisp" "qualification-data.lisp") :test #'equal)))))
          (push (cl-user::compact-one file) rows))))
    (dolist (child (uiop:subdirectories directory)) (setf rows (append rows (compact-tree child t)))) rows))
(let ((verified 0) (compactions nil))
  (ensure (eq :passed (getf (data (merge-pathnames "source-identity.lisp" *here*)) :status)))
  (ensure (eq :passed (getf (data (merge-pathnames "integration-source-identity.lisp" *here*)) :status)))
  (ensure (eq :passed (getf (data (merge-pathnames "statistics-data.lisp" *here*)) :status)))
  (setf compactions (compact-tree *here* nil))
  (dolist (manifest '("initial-archive.lisp" "increment-archive.lisp" "increment-ci-archive.lisp" "final-archive.lisp" "closing-archive.lisp"))
    (let ((record (data (merge-pathnames manifest *here*))))
      (ensure (eq :passed (getf record :status)))
      (dolist (copy (getf record :copies))
        (ensure (hash-matches (getf copy :target) (getf copy :sha256))) (incf verified))))
  (dolist (campaign '("baseline/" "final/" "integrated/" "baseline-profile/" "buffer-profile/" "smoke-01/" "smoke-02/" "smoke-03/" "smoke-04/" "smoke-05/"))
    (let ((record (data (merge-pathnames (concatenate 'string campaign "child-copies.lisp") *here*))))
      (dolist (copy record) (ensure (hash-matches (getf copy :target) (getf copy :sha256))) (incf verified))))
  (dolist (campaign '("smoke-01/" "smoke-02/" "smoke-03/" "smoke-04/"))
    (let* ((root (merge-pathnames campaign *here*)) (start (data (merge-pathnames "started.lisp" root))))
      (loop for name in (list (if (equal campaign "smoke-01/") "bench-variant.lisp" "bench.lisp") "server.lisp" "common.lisp")
            for field in '(:driver-sha256 :server-sha256 :common-sha256) do
        (ensure (hash-matches (merge-pathnames name root) (getf start field))) (incf verified))))
  (let ((record (list :kind :unix-buffer-evidence-closure :status :passed :universal-time (get-universal-time)
                      :verified-files verified :compactions compactions :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                      :limits '(:own-result-root-only :raw-byte-hashes :verified-lossless-expansion :no-negative-fixture-qualification))))
    (with-open-file (out (merge-pathnames "closure.lisp" *here*) :direction :output :if-exists :error)
      (write record :stream out :pretty t) (terpri out))
    (when (> (arcdocdb.evidence:file-bytes (merge-pathnames "closure.lisp" *here*)) 4096)
      (cl-user::compact-one (merge-pathnames "closure.lisp" *here*))))
  (format t "~S~%" (list :kind :unix-buffer-evidence-closure :status :passed :verified-files verified :compactions (length compactions))))
