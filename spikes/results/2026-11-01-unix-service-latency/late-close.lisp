;;;; C4: retain the final concurrent-main integration without rewriting the earlier closed scope.
(require :asdf)
(defparameter *late-file* *load-truename*)
(defun load-c4-definitions (name)
  (with-open-file (in (merge-pathnames name *load-truename*))
    (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
      (when (eq form :eof) (error "Missing C4 entry point"))
      (if (and (consp form) (member (first form) '(let let*)))
          (progn (unless (eq :eof (read in nil :eof)) (error "Unexpected C4 trailing forms")) (return))
          (eval form)))))
(load-c4-definitions "archive.lisp")
(cl-user::load-c4-definitions "verify.lisp")
(defpackage #:unix-latency-late (:use #:cl)
  (:local-nicknames (#:a #:unix-latency-archive) (#:v #:unix-latency-verification)))
(in-package #:unix-latency-late)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth) (unless truth (error "Late main qualification/archive failed")) truth)
(defun save-new (name form)
  (with-open-file (out (merge-pathnames name *here*) :direction :output :if-exists :error)
    (write form :stream out :pretty t) (terpri out)))
(defparameter *backup-extension*
  '("CHANGELOG.md" "docs/implementazione/backup-offline-m1.md" "spikes/backup-compare-analyze.lisp"
    "spikes/backup-compare-bench.lisp" "spikes/backup-compare-check.lisp" "src/backup/copy.lisp" "tests/backup/streaming.lisp"))
(defun unchanged-outside-backup-extension (left right)
  (flet ((kept (row) (not (member (getf row :path) *backup-extension* :test #'equal))))
    (equal (remove-if-not #'kept left) (remove-if-not #'kept right))))
(let ((good '(:status :ok :source-consistency :stable :exit-code 0
              :source-blobs-before (one) :source-blobs-after (one) :stdout "COMPLETE")))
  (ensure (v::qualified good "COMPLETE"))
  (let ((bad (copy-list good))) (setf (getf bad :source-consistency) :changed)
    (ensure (not (v::qualified bad "COMPLETE")))))
(ensure (unchanged-outside-backup-extension '((:path "src/local/native.lisp" :git-blob "same") (:path "src/backup/copy.lisp" :git-blob "old"))
                                          '((:path "src/local/native.lisp" :git-blob "same") (:path "src/backup/copy.lisp" :git-blob "new"))))
(ensure (not (unchanged-outside-backup-extension '((:path "src/local/native.lisp" :git-blob "old"))
                                               '((:path "src/local/native.lisp" :git-blob "new")))))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (format t "~S~%" '(:kind :late-closure-self-test :status :passed :changed-source :rejected))
  (sb-ext:exit :code 0))
(when (uiop:command-line-arguments) (error "Use --self-test or no arguments after final commands"))
(let* ((root (merge-pathnames "late-main/" *here*)) (a::*here* root) (v::*here* root)
       (sources (v::current)) (archive (a::collect-commands)) (receipts nil)
       (base "dc8e3fcab9b7696ee3048de85827843629b0b58c") (previous (v::data (merge-pathnames "source-identity.lisp" *here*))))
  (ensure (equal "src/local/native.lisp"
    (string-trim '(#\Newline #\Return)
      (uiop:run-program (list "git" "diff" "--name-only" base "HEAD" "--" "src") :output :string))))
  (ensure (equal (find "src/local/native.lisp" sources :key (lambda (r) (getf r :path)) :test #'equal)
                 (find "src/local/native.lisp" (getf previous :sources) :key (lambda (r) (getf r :path)) :test #'equal)))
  (dolist (entry '(("unix-latency-late-control" ":UNIX-LATENCY-CONTROL :STATUS :PASSED")
                   ("unix-latency-late-analysis" ":UNIX-COMPARISON :STATUS :PASSED")
                   ("unix-latency-late-9" "Integrated backup, verifier, metrics and four Unix suites passed;")
                   ("unix-latency-late-10" "Integrated backup, verifier, metrics and four Unix suites passed;")))
    (let ((record (v::command (first entry) (second entry))))
      (ensure (unchanged-outside-backup-extension sources (getf record :source-blobs-after)))
      (push (list :name (first entry) :status :ok :source-files (length (getf record :source-blobs-after))
                  :compatibility :unchanged-outside-declared-backup-extension) receipts)))
  (dolist (entry '(("unix-latency-final-backup-9" "Forced product compilation and both offline suites passed.")
                   ("unix-latency-final-backup-10" "Forced product compilation and both offline suites passed.")
                   ("unix-latency-final-docs" "Public Lisp example passed:")
                   ("unix-latency-final-ci" ":KIND :CI-SELF-TEST :STATUS :PASSED")
                   ("unix-latency-final-audits" ":UNIX-INTEGRATED-AUDITS :STATUS :PASSED")))
    (let ((record (v::command (first entry) (second entry))))
      (ensure (equal sources (getf record :source-blobs-after)))
      (push (list :name (first entry) :status :ok :source-files (length sources)) receipts)))
  (ensure (eq :passed (getf (v::data (merge-pathnames "comparison-late-main-read-control.lisp" *here*)) :status)))
  (ensure (equal sources (v::current)))
  (save-new "late-main/command-archive.lisp" archive)
  (save-new "late-main/source-identity.lisp"
    (list :kind :unix-final-main-source-identity :status :passed :sources sources :source-files (length sources)
      :upstream-base base :only-product-difference "src/local/native.lisp" :native-identical-to-prior-full-run t
      :later-backup-extension *backup-extension* :other-prior-sources-identical t
      :commands (reverse receipts) :limits '(:affected-suite-integration :four-large-read-controls :prior-full-matrices-retained)))
  (uiop:run-program (list "/opt/homebrew/bin/sbcl" "--script" "tools/compact-evidence.lisp" "--root" (namestring root) "--jobs" "1")
                    :output t :error-output t)
  (dolist (copy (getf archive :copies)) (ensure (a::hash-matches (getf copy :target) (getf copy :sha256))))
  (save-new "late-closure.lisp" (list :kind :unix-buffer-evidence-closure :status :passed
    :universal-time (get-universal-time) :driver-sha256 (arcdocdb.evidence:file-sha256 cl-user::*late-file*)
    :verified-files (length (getf archive :copies)) :source-files (length sources) :upstream-base base))
  (format t "~S~%" (list :kind :late-main-evidence-closure :status :passed :source-files (length sources))))
