;;;; C4: retain crash/process summaries with explicit rejection of incomplete ledgers.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:unix-latency-qualification (:use #:cl))
(in-package #:unix-latency-qualification)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth) (unless truth (error "Unix qualification summary")) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun extract-forms (text kind)
  (let ((marker (format nil "(:KIND ~S" kind)) (cursor 0) (out nil) (*read-eval* nil))
    (loop for start = (search marker text :start2 cursor) while start do
      (multiple-value-bind (form end) (read-from-string text nil nil :start start)
        (ensure (eq kind (getf form :kind))) (push form out) (setf cursor end))) (reverse out)))
(defun valid-matrix (row)
  (and (eq :passed (getf row :status)) (eql 36 (getf row :scenarios))
       (eql 108 (getf row :children)) (eql 72 (getf row :sigkills))))
(defun valid-local (row)
  (and (eq :passed (getf row :status)) (null (getf row :condition)) (null (getf row :cleanup-errors))
       (eql 18 (getf row :tests)) (= 169 (length (getf row :processes)))
       (= 50 (length (getf row :scenarios))) (eql 30 (getf row :sigkills))
       (every (lambda (r) (eq :pass (getf r :outcome))) (getf row :processes))
       (every (lambda (r) (eq :pass (getf r :outcome))) (getf row :scenarios))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let ((row '(:status :passed :scenarios 36 :children 108 :sigkills 72)))
        (ensure (valid-matrix row))
        (dolist (change '((:status :failed) (:scenarios 35) (:children 107) (:sigkills 71)))
          (let ((bad (copy-list row))) (setf (getf bad (first change)) (second change)) (ensure (not (valid-matrix bad))))))
      (ensure (not (valid-local '(:status :passed :tests 18))))
      (format t "~S~%" '(:kind :unix-qualification-self-test :status :passed :negatives 5)))
    ((and (= 4 (length args)) (equal (first args) "--run"))
      (let ((rows nil))
        (dolist (name (subseq args 1 3))
          (let* ((record (data (merge-pathnames (format nil "spikes/out/~A/report.lisp" name))))
                 (stdout (getf record :stdout)) (matrix (extract-forms stdout :group-crash-matrix))
                 (local (extract-forms stdout :production-local-tests)))
            (ensure (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
                         (search "build e test: nessun avviso, tutti i controlli superati" stdout)))
            (ensure (and (= 1 (length matrix)) (valid-matrix (first matrix))))
            (ensure (and (= 1 (length local)) (valid-local (first local))))
            (push (list :name name :source-files (length (getf record :source-blobs-after))
                    :group-crash-matrix (first matrix) :local-methods 18 :local-children 169
                    :local-scenarios 50 :local-sigkills 30 :terminal-build-marker t) rows)))
        (with-open-file (out (merge-pathnames (fourth args) *here*) :direction :output :if-exists :error)
          (write (list :kind :unix-buffer-qualification :status :passed :rows (reverse rows)) :stream out :pretty t) (terpri out))
        (format t "~S~%" '(:kind :unix-buffer-qualification :status :passed))))
    (t (error "Use --self-test or --run command9 command10 output.lisp"))))
