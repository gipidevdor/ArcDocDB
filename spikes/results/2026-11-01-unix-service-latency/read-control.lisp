;;;; C4: reuse the exact trusted benchmark definitions, selecting only four final large-read controls.
;;; The original entry point is not evaluated; ASDF is loaded once by the original definitions.
(require :asdf)
(defparameter *control-file* *load-truename*)
(with-open-file (in (merge-pathnames "bench.lisp" *load-truename*))
  (let ((count 0))
    (loop for form = (let ((*read-eval* nil)) (read in nil :eof)) do
      (when (eq form :eof) (error "Missing benchmark entry point"))
      (if (and (consp form) (eq (first form) 'let*))
          (progn (unless (and (> count 20) (eq :eof (read in nil :eof))) (error "Benchmark definition boundary"))
                 (return))
          (progn (eval form) (incf count))))))
(in-package #:unix-latency)
(let* ((args (uiop:command-line-arguments)) (*rows* nil) (*copies* nil) (stage 0)
       (small (equal (first args) "--self-test"))
       (*output* (merge-pathnames (uiop:ensure-directory-pathname (second args)) *here*))
       (finish (symbol-function 'p::finish-children)))
  (ensure (and (= 2 (length args)) (member (first args) '("--self-test" "--run") :test #'equal)))
  (ensure (not (probe-file *output*))) (ensure-directories-exist (merge-pathnames ".keep" *output*))
  (save-new (merge-pathnames "started.lisp" *output*)
    (list :kind :unix-latency-started :runtime (lisp-implementation-version)
      :driver-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" *here*))
      :server-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "server.lisp" *here*))
      :common-sha256 (arcdocdb.evidence:file-sha256 (merge-pathnames "common.lisp" *here*))
      :control-sha256 (arcdocdb.evidence:file-sha256 cl-user::*control-file*)))
  (self-test)
  (setf (symbol-function 'p::finish-children) (lambda () (funcall finish) (copy-logs)))
  (unwind-protect
    (p::call-with-run (lambda ()
      (let ((runtime (p::subdirectory "runtime/")))
        (dolist (mode '(:resident :paged)) (dolist (width '(1 8))
          (one-case runtime 2 mode 60000 width 0 nil nil (incf stage) small))))))
    (setf (symbol-function 'p::finish-children) finish))
  (save-new (merge-pathnames "completed.lisp" *output*)
    (list :kind :unix-latency-campaign :status :passed :cases stage :windows (length *rows*)
      :runtime (lisp-implementation-version) :command (list (if small "--transport-self-test" "--transport-check") (second args))
      :copies (reverse *copies*)))
  (emit-row (list :kind :unix-latency-control :status :passed :cases stage :windows (length *rows*))))
