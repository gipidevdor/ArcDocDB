;;;; C4 wrapper. The product owns all framing, storage, scheduling, I/O and cleanup.
(require :asdf)
(require :sb-posix)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(load (merge-pathnames "common.lisp" *load-truename*))
(in-package #:unix-latency)
(defvar *active* nil)
(defvar *arm* nil)
(defvar *calibration* nil)
(defvar *profile* nil)
(defvar *window* 0)
(defvar *cpu* 0)
(defvar *allocation* 0)
(defvar *begin* 0)
(defvar *flushes* 0)
(defvar *writes* 0)
(defvar *responses* 0)
(defvar *hists* (make-array 7))
(defvar *counts* (make-array 6 :initial-element 0))
(defvar *slots* (make-array 8 :initial-element nil))
(defvar *queued* (make-array 8 :initial-element nil))
(defvar *originals* nil)
(defun record-phase (index start)
  (when *active* (record-ticks (svref *hists* index) (- (get-internal-real-time) start))))
(defun slot (connection)
  (or (position connection *slots* :test #'eq)
      (let ((i (position nil *slots*))) (ensure i :slot-budget) (setf (svref *slots* i) connection) i)))
(defun profile-queue (connection size state now)
  (funcall (getf *originals* 'l::queue-local-output) connection size state now)
  (when (and *active* (eq state :response))
    (ensure (null (svref *queued* (slot connection))))
    (setf (svref *queued* (slot connection)) (get-internal-real-time)) (incf *responses*)) nil)
(defun profile-output (connection now)
  (let ((index (slot connection)))
    (multiple-value-prog1 (funcall (getf *originals* 'l::step-local-output) connection now)
      (when (and *active* (svref *queued* index)
                 (not (eq :response (l::local-connection-state connection))))
        (record-phase 6 (svref *queued* index)) (setf (svref *queued* index) nil)))))
(defun profile-transfer (fd buffer start end direction &optional backend)
  (let ((tick (get-internal-real-time)))
    (multiple-value-bind (status count)
        (funcall (getf *originals* 'l::local-transfer-step) fd buffer start end direction backend)
      (when *active*
        (record-phase (if (eq direction :input) 2 3) tick)
        (incf (svref *counts* (if (eq direction :input) 0 1)))
        (incf (svref *counts* (if (eq direction :input) 2 3)) count))
      (values status count))))
(defun profile-accept (listener connections now)
  (let ((tick (get-internal-real-time)))
    (multiple-value-prog1 (funcall (getf *originals* 'l::accept-local-connection) listener connections now)
      (when *active* (incf (svref *counts* 4)) (record-phase 0 tick)))))
(defun profile-dispatch (engine connections clock queue)
  (let ((tick (get-internal-real-time)))
    (multiple-value-prog1 (funcall (getf *originals* 'l::dispatch-local-ready) engine connections clock queue)
      (record-phase 1 tick))))
(defun profile-read (engine key out &key (start 0))
  (let ((tick (get-internal-real-time)))
    (multiple-value-prog1 (funcall (getf *originals* 'e:leggi-documento) engine key out :start start) (record-phase 4 tick))))
(defun profile-wait (waiter milliseconds)
  (let ((tick (get-internal-real-time)))
    (multiple-value-prog1 (funcall (getf *originals* 'io::attendi-io) waiter milliseconds)
      (when *active* (incf (svref *counts* 5)) (record-phase 5 tick)))))
(defparameter *wrappers*
  (list 'l::queue-local-output #'profile-queue 'l::step-local-output #'profile-output
        'l::local-transfer-step #'profile-transfer 'l::accept-local-connection #'profile-accept
        'l::dispatch-local-ready #'profile-dispatch 'e:leggi-documento #'profile-read 'io::attendi-io #'profile-wait))
(loop for tail on *wrappers* by #'cddr for symbol = (first tail) do
  (setf (getf *originals* symbol) (symbol-function symbol)))
(defun set-profile (enabled)
  (loop for (symbol function) on *wrappers* by #'cddr do
    (setf (symbol-function symbol) (if enabled function (getf *originals* symbol))))
  (setf *profile* enabled))
(defun start-window ()
  (fill *counts* 0) (fill *queued* nil)
  (loop for hist across *hists* do (m:azzera-istogramma hist))
  (set-profile (and *calibration* (oddp *window*)))
  (setf *writes* 0 *flushes* 0 *responses* 0 *cpu* (get-internal-run-time)
        *allocation* (sb-ext:get-bytes-consed) *begin* (get-internal-real-time) *active* t)
  (incf *window*))
(defun stop-window (engine)
  (let ((wall (- (get-internal-real-time) *begin*)) (cpu (- (get-internal-run-time) *cpu*))
        (allocation (- (sb-ext:get-bytes-consed) *allocation*)))
    (setf *active* nil)
    (ensure (every #'null *queued*) :undrained-responses)
    (emit-row (list :kind :unix-server-window :window (1- *window*) :profile *profile*
      :wall-ticks wall :cpu-ticks cpu :allocated-bytes allocation :ticks-per-second internal-time-units-per-second
      :strong-groups *flushes* :writes *writes* :responses *responses*
      :frontier (multiple-value-list (e:frontiere-motore engine)) :index (e:statistiche-indice-motore engine)
      :transfer-input-calls (svref *counts* 0) :transfer-output-calls (svref *counts* 1)
      :input-bytes (svref *counts* 2) :output-bytes (svref *counts* 3)
      :accept-calls (svref *counts* 4) :wait-calls (svref *counts* 5)
      :phases (when *profile* (loop for hist across *hists*
                                  for name in '(:accept :dispatch :recv :send :engine-read :poll :queue-residence)
                                  collect (list name (histogram-row hist))))) *error-output*)))
(let ((dispatch (symbol-function 'l::local-dispatch-command)) (reset (symbol-function 'l::reset-local-input)))
  (setf (symbol-function 'l::local-dispatch-command)
    (lambda (engine connection id opcode status key document)
      (when (= 0 opcode)
        (if *active* (stop-window engine) (setf *arm* connection)))
      (funcall dispatch engine connection id opcode status key document)))
  (setf (symbol-function 'l::reset-local-input)
    (lambda (connection now)
      (funcall reset connection now)
      (when (eq connection *arm*) (setf *arm* nil) (start-window)) nil)))
(dotimes (i (length *hists*)) (setf (svref *hists* i) (histogram :server-runtime)))
(handler-case
  (let* ((args (uiop:command-line-arguments)) (directory (first args)) (socket (second args))
         (archive (l::local-unhex (third args) 16 16)) (series (l::local-unhex (fourth args) 16 16))
         (version (parse-integer (fifth args))) (paged (equal (sixth args) "paged"))
         (maintenance (equal (seventh args) "maintenance")) (stopping nil)
         (open (symbol-function 'e:apri-motore)))
    (ensure (= 8 (length args))) (setf *calibration* (equal (eighth args) "calibration"))
    (setf (symbol-function 'e:apri-motore)
      (lambda (&rest values)
        (let ((engine (apply open (append values (when maintenance '(:max-file-bytes 131072 :max-records 128))))))
          (when paged (e:configura-budget-indice-motore engine
                        (getf (e:statistiche-indice-motore engine) :reserved-fixed)))
          (ensure (eq (if paged :paged :resident) (getf (e:statistiche-indice-motore engine) :mode))) engine)))
    (flet ((signal-stop (signal info context) (declare (ignore signal info context)) (setf stopping t)))
      (sb-sys:enable-interrupt sb-posix:sigterm #'signal-stop)
      (sb-sys:enable-interrupt sb-posix:sigint #'signal-stop)
      (l:serve-local directory archive series socket :create t :version version :stop (lambda () stopping)
        :observer (lambda (engine phase)
          (when (and *active* (eq phase :after-flush))
            (incf *flushes*) (incf *writes* (arcdocdb.wal::gruppo-count (e::motore-group engine)))) nil)
        :ready (lambda () (emit-row (list :kind :local-server :state :ready :pid (sb-posix:getpid))) nil))))
  (error (condition) (format *error-output* "~&UNIX-LATENCY-SERVER-FAIL ~A: ~A~%" (type-of condition) condition)
    (sb-ext:exit :code 1)))
