;;;; C4: derive ranges and syscall ledgers from independently checked analysis artifacts.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:unix-latency-statistics (:use #:cl))
(in-package #:unix-latency-statistics)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth) (unless truth (error "Unix statistics input/ledger")) truth)
(defun data (name)
  (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames name *here*)
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun range-row (rows)
  (let ((values (mapcar (lambda (r) (getf r :throughput-gain)) rows)))
    (ensure (and rows (every (lambda (x) (and (realp x) (plusp x))) values)))
    (list :cases (length rows) :gain-min (reduce #'min values) :gain-max (reduce #'max values))))
(defun profiles (name)
  (let ((result nil))
    (dolist (case (getf (data name) :calibration))
      (let ((key (getf case :key)))
        (when (= 60000 (third key))
          (push (list :key key :paired-profiler-wall-ratios (getf case :paired-profile-wall-ratios)
            :windows (loop for row in (getf case :profiled-server-windows) collect
              (let ((count (getf row :responses)))
                (ensure (= count (* 400 (fourth key))))
                (list :window (getf row :window) :responses count
                  :send-attempts-per-response (/ (getf row :transfer-output-calls) (float count 1d0))
                  :recv-attempts-per-response (/ (getf row :transfer-input-calls) (float count 1d0))
                  :accept-attempts-per-response (/ (getf row :accept-calls) (float count 1d0))
                  :output-bytes-per-response (/ (getf row :output-bytes) (float count 1d0)))))) result))))
    (reverse result)))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (ensure (equal '(:cases 2 :gain-min 1 :gain-max 2) (range-row '((:throughput-gain 2) (:throughput-gain 1)))))
      (ensure (handler-case (progn (range-row '((:throughput-gain -1))) nil) (error () t)))
      (format t "~S~%" '(:kind :unix-statistics-self-test :status :passed :negative :detected)))
    ((equal args '("--run"))
      (let* ((comparison (data "comparison-final.lisp")) (rows (getf comparison :cases)))
        (ensure (and (eq :passed (getf comparison :status)) (= 66 (length rows))))
        (let ((result (list :kind :unix-buffer-statistics :status :passed
          :read-only (range-row (remove-if-not (lambda (r) (zerop (fifth (getf r :key)))) rows))
          :large-read (range-row (remove-if-not (lambda (r) (and (= 60000 (third (getf r :key))) (zerop (fifth (getf r :key))))) rows))
          :mixed (range-row (remove-if-not (lambda (r) (and (plusp (fifth (getf r :key))) (null (sixth (getf r :key))))) rows))
          :maintenance (range-row (remove-if-not (lambda (r) (sixth (getf r :key))) rows))
          :baseline-profile (profiles "baseline-profile-analysis.lisp") :candidate-profile (profiles "buffer-profile-analysis.lisp"))))
          (with-open-file (out (merge-pathnames "statistics-data.lisp" *here*) :direction :output :if-exists :error)
            (write result :stream out :pretty t) (terpri out))
          (write result :pretty t) (terpri))))
    (t (error "Use --self-test or --run"))))
