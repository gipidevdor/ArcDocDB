;;;; C4: exact base/current inventories, immutable runtime comparison and terminal qualification.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:unix-latency-verification (:use #:cl))
(in-package #:unix-latency-verification)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun ensure (truth &optional (reason :identity)) (unless truth (error "Unix qualification: ~S" reason)) truth)
(defun data (path)
  (arcdocdb.evidence:call-with-evidence-bytes path
    (lambda (file) (with-open-file (in file) (let ((*read-eval* nil)) (read in))))))
(defun qualified (record marker)
  (and (eq :ok (getf record :status)) (eq :stable (getf record :source-consistency))
       (eql 0 (getf record :exit-code)) (consp (getf record :source-blobs-after))
       (equal (getf record :source-blobs-before) (getf record :source-blobs-after))
       (search marker (getf record :stdout))))
(defun current ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                       (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                           :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-trim '(#\Newline #\Return)
                    (uiop:run-program (append '("git" "hash-object" "--") paths) :output :string)) :separator '(#\Newline))))
    (ensure (= (length paths) (length hashes)))
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(defun base ()
  (sort (loop for line in (uiop:split-string
           (uiop:run-program '("git" "ls-tree" "-r" "--full-tree" "--format=%(objectname)%x09%(path)"
                               "904b0e216c19076c120344c896da59ce9dcec127") :output :string) :separator '(#\Newline))
         when (plusp (length line))
         unless (uiop:string-prefix-p "spikes/results/" (subseq line 41))
         collect (list :path (subseq line 41) :git-blob (subseq line 0 40))) #'string< :key (lambda (r) (getf r :path))))
(defun runtime (sources)
  (remove-if-not (lambda (r) (or (equal (getf r :path) "arcdocdb.asd") (uiop:string-prefix-p "src/" (getf r :path)))) sources))
(defun command (name marker)
  (let ((record (data (merge-pathnames (format nil "commands/~A/report.lisp" name) *here*))))
    (ensure (qualified record marker) name) record))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (let ((record '(:status :ok :source-consistency :stable :exit-code 0
                      :source-blobs-before (one) :source-blobs-after (one) :stdout "COMPLETE")))
        (ensure (qualified record "COMPLETE"))
        (dolist (change '((:status :running) (:source-consistency :changed) (:exit-code 1)
                           (:source-blobs-after (two)) (:stdout "unfinished")))
          (let ((bad (copy-list record))) (setf (getf bad (first change)) (second change))
            (ensure (not (qualified bad "COMPLETE"))))))
      (format t "~S~%" '(:kind :unix-identity-self-test :status :passed :negatives 5)))
    ((equal args '("--baseline-check"))
      (let ((expected (base)))
        (dolist (name '("unix-latency-baseline" "unix-latency-baseline-profile"))
          (ensure (equal expected (getf (command name ":UNIX-LATENCY-CAMPAIGN :STATUS :PASSED") :source-blobs-after))))
        (ensure (equal (runtime (current))
                       (runtime (getf (command "unix-latency-buffer-profile" ":UNIX-LATENCY-CAMPAIGN :STATUS :PASSED") :source-blobs-after))))
        (format t "~S~%" (list :kind :unix-baseline-identity :status :passed :source-files (length expected)))))
    ((equal args '("--run"))
      (let* ((sources (current)) (baseline (base)) (receipts nil))
        (dolist (name '("unix-latency-baseline" "unix-latency-baseline-profile"))
          (let ((record (command name ":UNIX-LATENCY-CAMPAIGN :STATUS :PASSED")))
            (ensure (equal baseline (getf record :source-blobs-after)) :base-inventory)))
        (let ((record (command "unix-latency-buffer-profile" ":UNIX-LATENCY-CAMPAIGN :STATUS :PASSED")))
          (ensure (equal (runtime sources) (runtime (getf record :source-blobs-after))) :calibrated-runtime))
        (dolist (entry '(("unix-latency-final" ":UNIX-LATENCY-CAMPAIGN :STATUS :PASSED")
                         ("unix-latency-full-2.6.9" "build e test: nessun avviso, tutti i controlli superati")
                         ("unix-latency-strict-2.6.10" "build e test: nessun avviso, tutti i controlli superati")
                         ("unix-latency-documentation-final" "Public Lisp example passed:")
                         ("unix-latency-focused-final" ":UNIX-BUFFER-FOCUSED :STATUS :PASSED")))
          (let ((record (command (first entry) (second entry))))
            (ensure (equal sources (getf record :source-blobs-after)) (first entry))
            (when (equal (first entry) "unix-latency-full-2.6.9")
              (ensure (search "11 spike completati" (getf record :stdout))))
            (push (list :name (first entry) :status :passed :source-files (length sources)) receipts)))
        (let ((found nil))
          (dolist (directory (uiop:subdirectories (merge-pathnames "commands/" *here*)))
            (let ((record (data (merge-pathnames "report.lisp" directory))))
              (when (and (member "tools/ci.lisp" (getf record :command) :test #'equal)
                         (member "self-test" (getf record :command) :test #'equal))
                (ensure (qualified record ":KIND :CI-SELF-TEST :STATUS :PASSED"))
                (ensure (equal sources (getf record :source-blobs-after))) (push directory found))))
          (ensure (= 1 (length found)) :ci-self-test-record)
          (push (list :name (namestring (first found)) :status :passed :source-files (length sources)) receipts))
        (ensure (eq :passed (getf (data (merge-pathnames "comparison-final.lisp" *here*)) :status)))
        (with-open-file (out (merge-pathnames "source-identity.lisp" *here*) :direction :output :if-exists :error)
          (write (list :kind :unix-buffer-source-identity :status :passed :source-files (length sources)
                  :base "904b0e216c19076c120344c896da59ce9dcec127" :base-files (length baseline)
                  :commands (reverse receipts) :sources sources) :stream out :pretty t) (terpri out))
        (format t "~S~%" (list :kind :unix-buffer-source-identity :status :passed :source-files (length sources)))))
    ((equal args '("--integration-run"))
      (let* ((sources (current)) (previous (data (merge-pathnames "source-identity.lisp" *here*))) (receipts nil)
             (allowed '("src/io/types.lisp" "src/io/open-relative.lisp" "src/io/package.lisp"
                        "src/verify/package.lisp" "src/verify/resources.lisp")))
        (ensure (eq :passed (getf previous :status)))
        (dolist (entry (getf previous :sources))
          (let ((path (getf entry :path)))
            (when (and (uiop:string-prefix-p "src/" path) (not (member path allowed :test #'equal)))
              (ensure (equal entry (find path sources :key (lambda (r) (getf r :path)) :test #'equal)) :unchanged-prior-core))))
        (dolist (entry '(("unix-latency-integrated-benchmark" ":UNIX-LATENCY-CAMPAIGN :STATUS :PASSED")
                         ("unix-latency-integrated-2.6.9" "Integrated backup, verifier, metrics and four Unix suites passed;")
                         ("unix-latency-integrated-2.6.10" "Integrated backup, verifier, metrics and four Unix suites passed;")
                         ("unix-latency-integrated-documentation" "Public Lisp example passed:")
                         ("unix-latency-integrated-audits" ":UNIX-INTEGRATED-AUDITS :STATUS :PASSED")
                         ("unix-latency-integrated-ci" ":KIND :CI-SELF-TEST :STATUS :PASSED")))
          (let ((record (command (first entry) (second entry))))
            (ensure (equal sources (getf record :source-blobs-after)) (first entry))
            (push (list :name (first entry) :status :passed :source-files (length sources)) receipts)))
        (ensure (eq :passed (getf (data (merge-pathnames "comparison-integrated.lisp" *here*)) :status)))
        (with-open-file (out (merge-pathnames "integration-source-identity.lisp" *here*) :direction :output :if-exists :error)
          (write (list :kind :unix-integrated-source-identity :status :passed :source-files (length sources)
                  :remote-base "2acefea76b624da312c13083d67d498ad3b4da34" :prior-full-run-files (getf previous :source-files)
                  :unchanged-prior-core-except allowed :commands (reverse receipts) :sources sources
                  :limits '(:combined-affected-suite-integration :prior-full-runs-retained-separately))
                 :stream out :pretty t) (terpri out))
        (format t "~S~%" (list :kind :unix-integrated-source-identity :status :passed :source-files (length sources)))))
    ((equal args '("--current"))
      (let ((proof (data (merge-pathnames (if (probe-file (merge-pathnames "integration-source-identity.lisp" *here*))
                                            "integration-source-identity.lisp" "source-identity.lisp") *here*))))
        (ensure (and (eq :passed (getf proof :status)) (equal (current) (getf proof :sources))))
        (format t "~S~%" '(:kind :unix-buffer-current-source :status :passed))))
    (t (error "Use --self-test, --baseline-check, --run, --integration-run or --current"))))
