;;;; C4: real public all-conflict calls, immutable inputs and caller allocation positive controls.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/tests")
(defpackage #:engine-conditional-allocation (:use #:cl) (:local-nicknames (#:e #:arcdocdb.engine) (#:et #:arcdocdb.engine.tests)))
(in-package #:engine-conditional-allocation)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun demand (value) (unless value (error "Public conditional allocation/result oracle")) value)
(defun measure-calls (engine operations expected tokens applied count allocate calls)
  (declare (type fixnum calls count))
  (dotimes (iteration calls)
    (let ((out (if allocate (make-array 10 :element-type '(unsigned-byte 64) :initial-element 999) tokens))
          (flags (if allocate (make-array 10 :element-type '(unsigned-byte 8) :initial-element 204) applied)))
      (demand (zerop (e:scrivi-gruppo-documenti-se-versione engine operations expected out flags :count count)))
      (dotimes (i count) (demand (= (if (zerop i) 1 0) (aref out i))) (demand (zerop (aref flags i))))
      (demand (= 999 (aref out count))) (demand (= 204 (aref flags count))))) nil)
(dolist (mode '(:legacy :resident)) (dolist (count '(1 8))
  (et::with-root (root)
    (et::with-engine (engine (et::rotation-open root :create t :mode mode :records 1))
      (e:scrivi-documento engine (et::key 0) (et::value 0))
      (let ((operations (et::conditional-group-ops 0 1 2 3 4 5 6 7))
            (expected (make-array 8 :element-type '(unsigned-byte 64) :initial-element 99))
            (tokens (make-array 10 :element-type '(unsigned-byte 64) :initial-element 999)) (applied (et::bytes 10 204))
            (images (et::images root)))
        (dotimes (sample 5)
          (dolist (allocate (if (evenp sample) '(nil t) '(t nil)))
            (measure-calls engine operations expected tokens applied count allocate 100)
            (sb-ext:gc :full t)
            (let ((before (sb-ext:get-bytes-consed)))
              (measure-calls engine operations expected tokens applied count allocate 10000)
              (let ((bytes (- (sb-ext:get-bytes-consed) before)))
                (format t "~S~%" (list :kind :engine-conditional-allocation :status :measured :sample (1+ sample)
                  :mode mode :members count :caller-buffers (if allocate :allocated :reused) :calls 10000 :allocated-bytes bytes))
                (demand (if allocate (plusp bytes) (zerop bytes)))))
            (et::conditional-group-cleared engine) (et::check-frontier engine 1) (et::check-images root images))))))))
(format t "~S~%" '(:kind :engine-conditional-allocation :status :passed :windows 40 :calls 400000
                  :limits (:real-legacy-resident-lookups :all-conflict :full-ACTIVE :not-writing-throughput :GC-before-window)))
