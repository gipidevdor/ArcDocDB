;;;; C4: self-recording cleanup, only exact owned worktree/cache and verified successful P3 fixtures.
(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(defparameter *vi-cleanup-here* (uiop:pathname-directory-pathname *load-truename*))
(defun vi-cleanup-data (name) (arcdocdb.evidence:read-evidence (merge-pathnames name *vi-cleanup-here*)))
(defun vi-cleanup-scope ()
  (unless (equal (truename "./") #p"/Users/gpicchiarelli/.codex/worktrees/m1-service-index-discovery/ArcDocDB/")
    (error "Own worktree required for cleanup")))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (uiop:with-temporary-file (:pathname marker :stream out)
    (write-string "keep" out) (finish-output out)
    (uiop:with-current-directory ((uiop:temporary-directory))
      (unless (handler-case (progn (vi-cleanup-scope) nil) (error () t)) (error "Cleanup scope guard failed")))
    (unless (equal "keep" (uiop:read-file-string marker)) (error "Scope fixture was changed")))
  (format t "~S~%" '(:kind :engine-conditional-cleanup-self-test :status :passed :wrong-worktree :rejected :marker :preserved))
  (sb-ext:exit :code 0))
(when (uiop:command-line-arguments) (error "Use --self-test or no arguments after closed archive"))
(vi-cleanup-scope)
(let* ((worktree (truename "./")) (archive (vi-cleanup-data "closing-archive.lisp"))
       (roots (list (merge-pathnames "_build/" worktree) (merge-pathnames "spikes/out/" worktree))) (rows nil))
  (unless (and (eq :passed (getf (vi-cleanup-data "closure.lisp") :status))
               (eq :passed (getf (vi-cleanup-data "source-identity.lisp") :status))
               (eq :passed (getf archive :status))) (error "Completed and verified evidence closure required"))
  (dolist (name '("engine-if-close" "engine-if-verify"))
    (let ((row (find name (getf archive :commands) :key (lambda (r) (getf r :name)) :test #'equal)))
      (unless (and (eq :ok (getf row :status)) (eq :stable (getf row :source-consistency)))
        (error "Completed closure/verifier receipt required"))))
  (when (probe-file (merge-pathnames "cleanup.lisp" *vi-cleanup-here*)) (error "Cleanup receipt already exists; nothing removed"))
  (dolist (directory (uiop:subdirectories (merge-pathnames "spikes/" worktree)))
    (when (uiop:string-prefix-p "SPK-" (car (last (pathname-directory directory))))
      (push (merge-pathnames "out/" directory) roots)))
  (dolist (version '("2.6.9" "2.6.10"))
    (push (pathname (format nil "/Users/gpicchiarelli/.cache/common-lisp/sbcl-~A-macosx-arm64/Users/gpicchiarelli/.codex/worktrees/m1-service-index-discovery/ArcDocDB/" version)) roots))
  (dolist (name (getf archive :retained-successful-P3-roots))
    (let ((path (pathname name)))
      (unless (uiop:subpathp path (merge-pathnames ".arcdocdb-p3-tests/" (user-homedir-pathname))) (error "Fixture scope"))
      (push path roots)))
  ;; Verify every archived original byte again before consuming regenerable storage.
  (dolist (copy (getf archive :copies))
    (let ((path (getf copy :target)) (hash (getf copy :sha256)))
      (unless (or (string= hash (arcdocdb.evidence:file-sha256 path))
                  (arcdocdb.evidence:call-with-evidence-bytes path (lambda (p) (string= hash (arcdocdb.evidence:file-sha256 p)))))
        (error "Archive changed before cleanup"))))
  (dolist (root roots)
    (when (probe-file root)
      (let ((stat (sb-posix:lstat (string-right-trim "/" (namestring root)))) (bytes 0) (files 0)
            (names (uiop:split-string (uiop:run-program (list "rg" "--files" "--hidden" "--no-ignore" "-0" "--" (namestring root))
                                                       :output :string :ignore-error-status t) :separator '(#\Null))))
        (unless (and (sb-posix:s-isdir (sb-posix:stat-mode stat)) (= (sb-posix:getuid) (sb-posix:stat-uid stat)) (< (length names) 1000000))
          (error "Cleanup root is not an owned real bounded directory"))
        (dolist (name names) (when (plusp (length name))
          (let ((file (sb-posix:lstat name))) (when (sb-posix:s-isreg (sb-posix:stat-mode file))
            (incf files) (incf bytes (sb-posix:stat-size file))))))
        (uiop:delete-directory-tree root :validate t)
        (when (probe-file root) (error "Cleanup root remains"))
        (push (list :path (namestring root) :files files :logical-bytes bytes :status :removed) rows))))
  (with-open-file (out (merge-pathnames "cleanup.lisp" *vi-cleanup-here*) :direction :output :if-exists :error)
    (write (list :kind :engine-conditional-worktree-cleanup :status :passed :removed (reverse rows)
                 :logical-bytes (loop for row in rows sum (getf row :logical-bytes))
                 :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                 :limits '(:own-regenerable-paths-only :successful-fixtures-after-verified-log-retention :not-physical-free-space
                           :no-shared-git-gc :other-worktrees-untouched)) :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :engine-conditional-worktree-cleanup :status :passed :paths (length rows)
                         :logical-bytes (loop for row in rows sum (getf row :logical-bytes)))))
