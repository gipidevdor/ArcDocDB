;;;; C4: exact affected-case selection, original suite runners and no fabricated full-suite totals.
(require :asdf)
(defun ecg-selected-p (package name processes)
  (cond ((equal package "ARCDOCDB.ENGINE.TESTS") (not (null (search "CONDITIONAL-" name))))
        ((equal package "ARCDOCDB.LOCAL.SERVER.TESTS") (not (null (or (search "CONDITIONAL-" name) (search "EXPLICIT-IF-" name)))))
        ((equal package "ARCDOCDB.LOCAL.WIRE.TESTS") (not (null (search "CONDITIONAL-EXPLICIT-" name))))
        ((and processes (equal package "ARCDOCDB.LOCAL.PROCESS.TESTS")) (not (null (search "EXPLICIT-IF-" name))))
        (t nil)))
(defun ecg-claim (id planned seen)
  (unless (and (member id planned :test #'equal) (not (gethash id seen))) (error "Unplanned/duplicate case ~A" id))
  (setf (gethash id seen) :started))
(defun ecg-complete (planned passed)
  (unless (and planned (equal planned (sort (copy-list passed) #'string<))) (error "Missing/duplicate selected cases")))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (let ((seen (make-hash-table :test #'equal)))
    (ecg-claim "one" '("one") seen)
    (dolist (id '("one" "unplanned"))
      (unless (handler-case (progn (ecg-claim id '("one") seen) nil) (error () t)) (error "Ledger accepted bad case")))
    (dolist (passed '(nil ("one" "one") ("other")))
      (unless (handler-case (progn (ecg-complete '("one") passed) nil) (error () t)) (error "Ledger accepted coverage gap")))
    (ecg-complete '("one") '("one"))
    (unless (and (ecg-selected-p "ARCDOCDB.ENGINE.TESTS" "TEST-CONDITIONAL-PUBLIC-COUNT" nil)
                 (not (ecg-selected-p "ARCDOCDB.ENGINE.TESTS" "TEST-OTHER" t))
                 (not (ecg-selected-p "ARCDOCDB.LOCAL.PROCESS.TESTS" "TEST-EXPLICIT-IF-REAL" nil))
                 (ecg-selected-p "ARCDOCDB.LOCAL.PROCESS.TESTS" "TEST-EXPLICIT-IF-REAL" t)) (error "Selection fixture")))
  (format t "~S~%" '(:kind :engine-conditional-qualification-self-test :status :passed :duplicate :rejected :unplanned :rejected :selection :passed))
  (sb-ext:exit :code 0))
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (cause) (unless (typep cause 'sb-kernel:redefinition-warning) (error "COD-01: ~A" cause)))))
  (asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/local" :force t)
  (asdf:load-system "arcdocdb/tests"))
(defun ecg-save (path form)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :error)
    (with-standard-io-syntax (write form :stream out :readably t :pretty nil) (terpri out))))
(let* ((args (uiop:command-line-arguments)) (processes (equal (first args) "--qualify"))
       (inventory (arcdocdb.ci.tests:discover))
       (rows (getf inventory :tests))
       (selected (remove-if-not (lambda (r) (ecg-selected-p (getf r :suite) (getf r :name) processes)) rows))
       (planned (sort (mapcar (lambda (r) (getf r :id)) selected) #'string<))
       (excluded (loop for row in rows unless (member (getf row :id) planned :test #'equal) collect (getf row :id)))
       (packages (remove-duplicates (mapcar (lambda (r) (getf r :suite)) selected) :test #'equal))
       (specs (remove-if-not (lambda (s) (member (getf s :package) packages :test #'equal)) (arcdocdb.ci.tests:suite-specifications)))
       (seen (make-hash-table :test #'equal)) (passed nil))
  (unless (and (= 2 (length args)) (member (first args) '("--focused" "--qualify") :test #'equal)
               (= (if processes 4 3) (length specs)) (eq :ready (getf inventory :status)) (plusp (length planned)))
    (error "Use --focused or --qualify NEW-OUTPUT; exact affected registry required"))
  (let ((root (merge-pathnames (uiop:ensure-directory-pathname (second args)) (uiop:pathname-directory-pathname *load-truename*))))
    (when (probe-file root) (error "Qualification output exists"))
    (ecg-save (merge-pathnames "planned.lisp" root)
      (list :kind :engine-conditional-qualification :status :started :runtime (lisp-implementation-version)
            :scope :selected-affected-cases :planned planned :excluded excluded))
    (with-open-file (events (merge-pathnames "events.lisp" root) :direction :output :if-exists :error)
      (let ((arcdocdb.ci.tests::*case-observer*
              (lambda (id thunk)
                (ecg-claim id planned seen)
                (write (list :kind :started :id id) :stream events) (terpri events) (finish-output events)
                (multiple-value-prog1 (funcall thunk)
                  (push id passed) (setf (gethash id seen) :passed)
                  (write (list :kind :passed :id id) :stream events) (terpri events) (finish-output events)))))
        (dolist (spec specs) (arcdocdb.ci.tests::invoke-suite spec excluded))))
    (ecg-complete planned passed)
    (ecg-save (merge-pathnames "completed.lisp" root)
      (list :kind :engine-conditional-qualification :status :passed :runtime (lisp-implementation-version)
            :scope :selected-affected-cases :suites (length specs) :cases (length passed) :passed (sort passed #'string<)))
    (format t "~S~%" (list :kind :engine-conditional-qualification :status :passed
                           :scope :selected-affected-cases :suites (length specs) :cases (length planned)))))
