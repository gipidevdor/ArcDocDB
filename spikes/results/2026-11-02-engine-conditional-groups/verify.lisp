;;;; C4: final source/ledger/allocation/complete-check verification with altered-receipt fixtures.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *ecg-here* (uiop:pathname-directory-pathname *load-truename*))
(defun ecg-demand (value reason) (unless value (error "Engine conditional evidence: ~A" reason)) value)
(defun ecg-data (path) (arcdocdb.evidence:read-evidence path))
(defun ecg-record (name) (ecg-data (format nil "spikes/out/~A/report.lisp" name)))
(defun ecg-rows (text prefix)
  (let ((cursor 0) (rows nil))
    (loop repeat 1000 for start = (search prefix text :start2 cursor) while start do
      (multiple-value-bind (row end) (let ((*read-eval* nil)) (read-from-string text nil nil :start start))
        (ecg-demand (> end start) :row-progress) (push row rows) (setf cursor end)))
    (ecg-demand (not (search prefix text :start2 cursor)) :row-ceiling) (nreverse rows)))
(defun ecg-current-sources ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                                 (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                                    :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-right-trim '(#\Newline) (uiop:run-program (append '("git" "hash-object" "--") paths)
                                                                                  :output :string)) :separator '(#\Newline))))
    (ecg-demand (= (length paths) (length hashes)) :source-count)
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(defun ecg-receipt-valid (record sources)
  (ecg-demand (and (eq :command-verification (getf record :kind)) (eq :ok (getf record :status))
                   (eql 0 (getf record :exit-code)) (eq :stable (getf record :source-consistency))
                   (equal sources (getf record :source-blobs-before)) (equal sources (getf record :source-blobs-after)))
              :current-stable-passing-receipt))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (let* ((sources '((:path "one" :git-blob "hash")))
         (record (list :kind :command-verification :status :ok :exit-code 0 :source-consistency :stable
                       :source-blobs-before sources :source-blobs-after sources)))
    (ecg-receipt-valid record sources)
    (dolist (key '(:status :source-consistency :exit-code :source-blobs-before :source-blobs-after))
      (let ((bad (copy-list record))) (setf (getf bad key) :invalid)
        (ecg-demand (handler-case (progn (ecg-receipt-valid bad sources) nil) (error () t)) :altered-receipt-detected)))
    (ecg-demand (= 2 (length (ecg-rows "(:KIND :ECG) text (:KIND :ECG)" "(:KIND :ECG"))) :row-fixture))
  (format t "~S~%" '(:kind :engine-conditional-verifier-self-test :status :passed :altered-receipts-rejected 5))
  (sb-ext:exit :code 0))
(when (uiop:command-line-arguments) (error "Use --self-test or no arguments after all required commands complete"))
(let* ((sources (ecg-current-sources)) (base "3bf46428e03d7b9e8ef9bd1e6394201b038c3ffe")
       (receipts nil) (qualifications nil) (allocations nil) (nested nil)
       (required '("engine-if-focused-final" "engine-if-allocation-sbcl9" "engine-if-allocation-sbcl10"
                   "engine-if-qualification-sbcl9" "engine-if-qualification-sbcl10" "engine-if-checks" "engine-if-docs" "engine-if-static")))
  (ecg-demand (equal '("src/engine/conditional-group.lisp" "src/engine/package.lisp" "src/local/conditional-group-dispatch.lisp")
                     (uiop:split-string (string-right-trim '(#\Newline)
                       (uiop:run-program (list "git" "diff" "--name-only" base "--" "src/") :output :string)) :separator '(#\Newline)))
             :exact-runtime-scope)
  (dolist (name required)
    (let ((record (ecg-record name)))
      (ecg-receipt-valid record sources)
      (push (list :name name :status :passed :command (getf record :command)
                  :runtime (getf (getf record :environment) :version)) receipts)))
  (dolist (runtime '("sbcl9" "sbcl10"))
    (let* ((root (merge-pathnames (format nil "qualification-~A/" runtime) *ecg-here*))
           (planned-record (ecg-data (merge-pathnames "planned.lisp" root)))
           (planned (getf planned-record :planned)) (completed (ecg-data (merge-pathnames "completed.lisp" root))) (events nil))
      (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "events.lisp" root)
        (lambda (path) (with-open-file (in path) (let ((*read-eval* nil))
          (loop for row = (read in nil :eof) until (eq row :eof) do (push row events))))))
      (ecg-demand (and (= 58 (length planned)) (eq :selected-affected-cases (getf completed :scope))
                       (eq :passed (getf completed :status)) (= 58 (getf completed :cases)) (= 4 (getf completed :suites))
                       (equal planned (getf completed :passed))
                       (equal planned (sort (loop for row in events when (eq :started (getf row :kind)) collect (getf row :id)) #'string<))
                       (equal planned (sort (loop for row in events when (eq :passed (getf row :kind)) collect (getf row :id)) #'string<)))
                   :exact-selected-case-ledger)
      (push (list :runtime runtime :cases 58 :scope :selected-affected-cases :status :passed) qualifications))
    (let* ((record (ecg-record (format nil "engine-if-allocation-~A" runtime)))
           (rows (ecg-rows (getf record :stdout) "(:KIND :ENGINE-CONDITIONAL-ALLOCATION"))
           (measured (remove-if-not (lambda (r) (eq :measured (getf r :status))) rows))
           (reused (remove-if-not (lambda (r) (eq :reused (getf r :caller-buffers))) measured))
           (control (remove-if-not (lambda (r) (eq :allocated (getf r :caller-buffers))) measured)))
      (ecg-demand (and (= 41 (length rows)) (= 40 (length measured)) (= 20 (length reused)) (= 20 (length control))
                       (every (lambda (r) (zerop (getf r :allocated-bytes))) reused)
                       (every (lambda (r) (plusp (getf r :allocated-bytes))) control)
                       (eq :passed (getf (car (last rows)) :status))) :allocation-controls)
      (push (list :runtime runtime :reused-calls 200000 :reused-allocated-bytes 0 :rows rows) allocations)))
  (dolist (directory (uiop:subdirectories #p"spikes/out/"))
    (let ((path (merge-pathnames "report.lisp" directory)))
      (when (probe-file path)
        (let ((record (handler-case (ecg-data path) (error () nil))))
          (when (and (eq :command-verification (getf record :kind)) (= 2 (length (getf record :command)))
                     (equal "make" (pathname-name (first (getf record :command)))) (equal "check-core" (second (getf record :command))))
            (ecg-receipt-valid record sources)
            (ecg-demand (and (search "11 spike completati" (getf record :stdout))
                            (search "build e test: nessun avviso, tutti i controlli superati" (getf record :stdout))) :complete-check-and-spikes)
            (setf nested (list :path (namestring path) :status :passed)))))))
  (ecg-demand nested :nested-full-check)
  (let* ((initial (ecg-record "engine-if-focused-01"))
         (blob (getf (find "tests/engine/conditional-group.lisp" (getf initial :source-blobs-before)
                          :key (lambda (row) (getf row :path)) :test #'equal) :git-blob))
         (frozen (namestring (merge-pathnames "variants/focused-01/conditional-group.lisp.source" *ecg-here*))))
    (ecg-demand (string= blob (string-trim '(#\Newline) (uiop:run-program (list "git" "hash-object" "--" frozen) :output :string)))
                :exact-earlier-test-variant))
  (with-open-file (out (merge-pathnames "source-identity.lisp" *ecg-here*) :direction :output :if-exists :error)
    (write (list :kind :engine-conditional-source-identity :status :passed :base base :sources sources
                 :receipts (reverse receipts) :qualifications (reverse qualifications) :allocations (reverse allocations)
                 :nested-full-check nested :limits '(:selected-qualification-not-full-suite :local-macOS-arm64
                                                    :all-conflict-allocation-only :not-Linux-or-power-loss)) :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :engine-conditional-source-identity :status :passed :sources (length sources)
                         :selected-cases-per-runtime 58 :reused-allocation-windows-per-runtime 20)))
