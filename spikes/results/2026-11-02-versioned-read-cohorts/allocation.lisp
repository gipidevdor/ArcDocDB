;;;; C4: classifier-only allocation witness with live result counts and allocating control.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/tests"))
(in-package #:arcdocdb.local.server.tests)
(defvar *cohort-allocation-sink* nil)
(defun cohort-allocation-window (function expected control)
  (dotimes (i 1000) (funcall function)) (sb-ext:gc :full t)
  (let ((start (sb-ext:get-bytes-consed)) (accepted 0))
    (dotimes (i 100000)
      (when (funcall function) (incf accepted))
      (when control (setf *cohort-allocation-sink* (make-array 16 :initial-element i))))
    (let ((bytes (- (sb-ext:get-bytes-consed) start)))
      (is (= accepted expected)) (is (if control (plusp bytes) (zerop bytes)))
      (list :calls 100000 :accepted accepted :allocated-bytes bytes :control control))))
(with-engine (engine root :create t)
  (let* ((queue (l::make-local-write-queue)) (read (conditional-pending (bytes 99) 0 0 nil))
         (ordinary (group-pending 8 2 (bytes 99))) (key (bytes 99)) (same (bytes 7)))
    (unwind-protect
         (progn
           (dotimes (i 7) (l::dispatch-local-pending engine (group-pending (1+ i) 1 (bytes (1+ i))) queue (lambda () 10)))
           (dolist (kind '(:versioned :ordinary :same-key))
             (let ((function (case kind
                               (:versioned (lambda () (l::independent-local-version-get-p engine read queue 0 key 0)))
                               (:ordinary (lambda () (l::independent-local-get-p engine ordinary queue 0 key)))
                               (:same-key (lambda () (l::independent-local-version-get-p engine read queue 0 same 0)))))
                   (expected (if (eq kind :same-key) 0 100000)))
               (dotimes (window 3)
                 (format t "~S~%" (append (list :kind :versioned-read-classifier-allocation :variant kind :window window)
                                          (cohort-allocation-window function expected nil))))
               (when (eq kind :versioned)
                 (format t "~S~%" (append (list :kind :versioned-read-classifier-allocation :variant kind :window :control)
                                          (cohort-allocation-window function expected t)))))))
      (l::clear-local-write-queue queue))))
(format t "~S~%" '(:kind :versioned-read-classifier-allocation :status :passed :scope :classifier-only :measured-windows 9 :control-windows 1))
