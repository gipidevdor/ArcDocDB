;;;; C4: paired mechanism audit, exact campaign cells and no inverse-percentile throughput.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *vrc-analysis-root* (uiop:pathname-directory-pathname *load-truename*))
(defun vrc-data (name) (arcdocdb.evidence:read-evidence (merge-pathnames name *vrc-analysis-root*)))
(defun vrc-assert (truth) (unless truth (error "Cohort comparison oracle")))
(defun vrc-cell (row) (mapcar (lambda (k) (getf row k)) '(:version :profile :bytes :versioned :dependent)))
(defun vrc-campaign (record phase hash)
  (vrc-assert (and (eq :passed (getf record :status)) (eq phase (getf record :phase))
                   (equal hash (getf record :driver-sha256)) (= 48 (getf record :cases))
                   (= 144 (getf record :windows)) (= 720 (getf record :turns))
                   (= 144 (length (getf record :rows))) (plusp (getf record :clock-units))))
  (let ((seen (make-hash-table :test #'equal)) (cells nil))
    (dolist (row (getf record :rows))
      (let* ((cell (vrc-cell row)) (window (getf row :window)) (id (cons window cell)))
        (vrc-assert (and (member (first cell) '(1 2)) (member (second cell) '(:legacy :resident :paged))
                         (member (third cell) '(1 60000)) (typep (fourth cell) 'boolean) (typep (fifth cell) 'boolean)
                         (member window '(0 1 2)) (= 5 (length (getf row :samples))) (not (gethash id seen))))
        (setf (gethash id seen) t) (pushnew cell cells :test #'equal)
        (loop for sample in (getf row :samples) for i from 0 for before = (+ 1 (* 10 window) (* 2 i)) do
          (vrc-assert (and (= before (getf sample :before)) (= (+ 2 before) (getf sample :after))
                           (typep (getf sample :ticks) '(integer 0 *))
                           (= (if (or (fifth cell) (and (fourth cell) (eq phase :baseline))) 2 1) (getf sample :flushes))
                           (eql (if (fourth cell) (if (fifth cell) (1+ before) 1) nil) (getf sample :read-token)))))))
    (vrc-assert (= 48 (length cells))) cells))
(let* ((before (vrc-data "baseline.lisp")) (after (vrc-data "candidate-final.lisp"))
       (hash (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" *vrc-analysis-root*)))
       (cells (vrc-campaign before :baseline hash)) (rows nil))
  (vrc-assert (equal cells (vrc-campaign after :candidate hash)))
  ;; Negative control: a modified driver identity is not accepted as unchanged.
  (let ((altered (copy-list before))) (setf (getf altered :driver-sha256) "changed")
    (vrc-assert (handler-case (progn (vrc-campaign altered :baseline hash) nil) (error () t))))
  (dolist (cell cells)
    (let ((values nil))
      (dolist (record (list before after))
        (let* ((selected (remove-if-not (lambda (r) (equal cell (vrc-cell r))) (getf record :rows)))
               (samples (loop for row in selected append (getf row :samples))))
          (vrc-assert (= 15 (length samples)))
          (push (list :phase (getf record :phase) :turns 15
                      :flushes (reduce #'+ samples :key (lambda (r) (getf r :flushes)))
                      :dispatch-milliseconds (/ (* 1000d0 (reduce #'+ samples :key (lambda (r) (getf r :ticks))))
                                                (getf record :clock-units))) values)))
      (push (list :cell cell :measurements (nreverse values)) rows)))
  (with-open-file (out (merge-pathnames "comparison-final.lisp" *vrc-analysis-root*) :direction :output :if-exists :error)
    (write (list :kind :versioned-read-cohort-comparison :status :passed :unchanged-driver hash :altered-driver :rejected
                 :cases 48 :turns-per-phase 720 :rows (nreverse rows)
                 :limits '(:controlled-ready-cohorts :dispatch-only :three-five-turn-windows :not-service-throughput)) :stream out :pretty nil) (terpri out))
  (format t "~S~%" '(:kind :versioned-read-cohort-comparison :status :passed :cases 48 :turns-per-phase 720
                     :versioned-independent-flushes (360 180) :same-key-flushes-per-turn (2 2) :ordinary-independent-flushes-per-turn (1 1))))
