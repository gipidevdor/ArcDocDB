;;;; C4: exact copies of completed command records and explicitly referenced P3 child logs.
(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(defpackage #:versioned-read-cohort-archive (:use #:cl))
(in-package #:versioned-read-cohort-archive)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun demand (truth) (unless truth (error "Version-into archive scope/byte oracle")) truth)
(defun data (path) (arcdocdb.evidence:read-evidence path))
(defun hash-matches (path hash)
  (or (string= hash (arcdocdb.evidence:file-sha256 path))
      (arcdocdb.evidence:call-with-evidence-bytes path (lambda (file) (string= hash (arcdocdb.evidence:file-sha256 file))))))
(defun copy-one (source target)
  (let ((hash (arcdocdb.evidence:file-sha256 source)) (bytes (arcdocdb.evidence:file-bytes source)))
    (unless (probe-file target) (ensure-directories-exist target) (uiop:copy-file source target))
    (demand (hash-matches target hash))
    (list :source (namestring source) :target (namestring target) :sha256 hash :bytes bytes)))
(defvar *socket-nodes* nil)
(defun copy-directory-tree (source target &optional sockets)
  (append (loop for file in (uiop:directory-files source)
                for node = (sb-posix:lstat (namestring file)) append
                  (cond ((sb-posix:s-isreg (sb-posix:stat-mode node))
                         (list (copy-one file (merge-pathnames (file-namestring file) target))))
                        ((and sockets (sb-posix:s-issock (sb-posix:stat-mode node)))
                         (push (list :source (namestring file) :kind :unix-socket :regular-content-bytes 0
                                     :mode (sb-posix:stat-mode node) :uid (sb-posix:stat-uid node) :gid (sb-posix:stat-gid node))
                               *socket-nodes*) nil)
                        (t (error "Archive refuses special node ~A" file))))
          (loop for child in (uiop:subdirectories source) append
            (copy-directory-tree child (merge-pathnames (format nil "~A/" (car (last (pathname-directory child)))) target) sockets))))
(defun socket-metadata (root target)
  (let* ((file (merge-pathnames "socket-nodes.lisp" target))
         (text (with-standard-io-syntax
                 (with-output-to-string (out)
                   (write (sort (copy-list *socket-nodes*) #'string< :key (lambda (r) (getf r :source))) :stream out :pretty nil)
                   (terpri out)))))
    (ensure-directories-exist file)
    (if (probe-file file)
        (arcdocdb.evidence:call-with-evidence-bytes file (lambda (raw) (demand (equal text (uiop:read-file-string raw)))))
        (with-open-file (out file :direction :output :if-exists :error) (write-string text out)))
    (arcdocdb.evidence:call-with-evidence-bytes file
      (lambda (raw) (list :source (namestring root) :target (namestring file) :kind :socket-metadata
                         :sha256 (arcdocdb.evidence:file-sha256 raw) :bytes (arcdocdb.evidence:file-bytes raw))))))
(defun summaries (text)
  (let ((cursor 0) (rows nil) (prefix "(:KIND :PRODUCTION-LOCAL-TESTS"))
    (loop repeat 256 for start = (search prefix text :start2 cursor) while start do
      (multiple-value-bind (row end) (let ((*read-eval* nil)) (read-from-string text nil nil :start start))
        (demand (and (eq :production-local-tests (getf row :kind)) (> end start)))
        (push row rows) (setf cursor end)))
    (demand (not (search prefix text :start2 cursor))) (nreverse rows)))
(defun archive-summary (row)
  (when (getf row :retained)
    (let* ((root (pathname (getf row :root)))
           (parent (merge-pathnames ".arcdocdb-p3-tests/" (user-homedir-pathname)))
           (leaf (car (last (pathname-directory root)))) (copies nil))
      (demand (and (uiop:subpathp root parent) (member (getf row :status) '(:passed :failed))))
      (when (eq :failed (getf row :status))
        (let* ((target (merge-pathnames (format nil "failed-fixtures/~A/" leaf) *here*))
               (*socket-nodes* nil) (files (copy-directory-tree root target t)))
          (when *socket-nodes* (push (socket-metadata root target) files))
          (return-from archive-summary (values files (namestring root)))))
      (dolist (process (getf row :processes))
        (demand (eq :pass (getf process :outcome)))
        (dolist (key '(:stdout :stderr))
          (let ((file (pathname (getf process key))))
            (demand (uiop:subpathp file root))
            (push (copy-one file (merge-pathnames (format nil "child-logs/~A/~A" leaf (file-namestring file)) *here*)) copies))))
      (values copies (namestring root)))))
(defun collect-commands ()
  (let ((copies nil) (commands nil) (roots nil))
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((name (car (last (pathname-directory directory)))) (path (merge-pathnames "report.lisp" directory)))
        (when (probe-file path)
          (let ((record (handler-case (data path) (error () nil))))
            (when (and (eq :command-verification (getf record :kind)) (not (eq :running (getf record :status))))
              (push (list :name name :status (getf record :status) :source-consistency (getf record :source-consistency)) commands)
              (setf copies (append copies (copy-directory-tree directory (merge-pathnames (format nil "commands/~A/" name) *here*))))
              (dolist (row (summaries (getf record :stdout)))
                (multiple-value-bind (child-copies root) (archive-summary row)
                  (setf copies (append copies child-copies))
                  (when root (pushnew root roots :test #'equal)))))))))
    ;; Real spike/evidence worker output and completed CI self-test artifacts only.
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((name (car (last (pathname-directory directory)))))
        (cond
          ((or (uiop:string-prefix-p "evidence-check-" name) (search "-check-" name))
           (setf copies (append copies (copy-directory-tree directory (merge-pathnames (format nil "support/~A/" name) *here*)))))
          (t (let ((file (merge-pathnames "self-test-report.lisp" directory)))
               (when (probe-file file) (push (copy-one file (merge-pathnames (format nil "support/~A/self-test-report.lisp" name) *here*)) copies)))))))
    (when (probe-file #p"spikes/out/ci/")
      (dolist (directory (uiop:subdirectories #p"spikes/out/ci/"))
        (let ((name (car (last (pathname-directory directory)))))
          (when (uiop:string-prefix-p "selftest-" name)
            (dolist (file (uiop:directory-files directory))
              (push (copy-one file (merge-pathnames (format nil "support/ci/~A/~A" name (file-namestring file)) *here*)) copies))))))
    (list :kind :versioned-read-cohort-command-archive :status :passed :commands (sort commands #'string< :key (lambda (r) (getf r :name)))
          :retained-verified-P3-roots (sort roots #'string<) :copies copies
          :limits '(:completed-commands-only :exact-child-logs :successful-storage-fixtures-regenerable :failed-fixture-regular-bytes-retained-verbatim :unix-sockets-as-metadata
                    :negative-nested-ci-fixtures-excluded :no-negative-fixture-qualification))))
(let ((args (uiop:command-line-arguments)))
  (cond
    ((equal args '("--self-test"))
      (uiop:with-temporary-file (:pathname source :stream out :keep t)
        (write-string "Exact bytes and trailing spaces.  " out) (finish-output out)
        (let ((target (pathname (concatenate 'string (namestring source) ".copy"))))
          (unwind-protect
               (progn (copy-one source target)
                 (with-open-file (stream target :direction :output :if-exists :supersede) (write-string "changed" stream))
                 (demand (handler-case (progn (copy-one source target) nil) (error () t))))
            (delete-file source) (when (probe-file target) (delete-file target)))))
      (demand (null (summaries "No test summary")))
      (demand (= 1 (length (summaries "(:KIND :PRODUCTION-LOCAL-TESTS :STATUS :PASSED)"))))
      (format t "~S~%" '(:kind :versioned-read-cohort-archive-self-test :status :passed :altered-copy :detected :summary-fixtures :passed)))
    ((and (= 2 (length args)) (equal (first args) "--run"))
      (let ((result (collect-commands)))
        (with-open-file (out (merge-pathnames (second args) *here*) :direction :output :if-exists :error)
          (write result :stream out :pretty t) (terpri out))
        (format t "~S~%" (list :kind :versioned-read-cohort-command-archive :status :passed :files (length (getf result :copies))))))
    (t (error "Use --self-test or --run NEW-MANIFEST.lisp"))))
