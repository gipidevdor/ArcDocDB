;;;; C4: identical before/after ready-cohort driver, real strong I/O, exact response oracles.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/tests"))
(load "tools/evidence-storage.lisp")
(in-package #:arcdocdb.local.server.tests)
(defparameter *cohort-driver* *load-truename*)
(defun cohort-document (size)
  (if (= size 1) (bytes #xf6)
      (let ((doc (make-array size :element-type '(unsigned-byte 8) :initial-element 42)))
        (setf (aref doc 0) #x59 (aref doc 1) (ldb (byte 8 8) (- size 3)) (aref doc 2) (ldb (byte 8 0) (- size 3))) doc)))
(defun cohort-sample (engine doc versioned dependent phase frontier)
  (let* ((key (bytes 2)) (a (group-pending 1 1 (if dependent key (bytes 1)) doc))
         (read (if versioned (conditional-pending key 0 0 nil) (group-pending 2 2 key)))
         (b (group-pending 3 1 (bytes 3) doc)) (slots (vector a read b)) (queue (l::make-local-write-queue))
         (original (symbol-function 'arcdocdb.io:durable-flush)) (flushes 0) (ticks 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'arcdocdb.io:durable-flush) (lambda (file) (incf flushes) (funcall original file)))
           (let ((start (get-internal-real-time)))
             (l::dispatch-local-ready engine slots (lambda () 10) queue)
             (setf ticks (- (get-internal-real-time) start))))
      (setf (symbol-function 'arcdocdb.io:durable-flush) original))
    (is (= (1+ frontier) (group-response a 1))) (is (= (+ 2 frontier) (group-response b 1)))
    (multiple-value-bind (status value token) (if versioned (conditional-response read 0) (group-response read 2))
      (is (eq :found status)) (is (equalp doc value))
      (when versioned (is (= (if dependent (1+ frontier) 1) token))))
    (conditional-queue-cleared queue)
    (is (= (if (or dependent (and versioned (eq phase :baseline))) 2 1) flushes))
    (list :ticks ticks :flushes flushes :before frontier :after (+ 2 frontier)
          :read-token (when versioned (if dependent (1+ frontier) 1)))))
(let* ((args (uiop:command-line-arguments)) (phase (cond ((equal (first args) "baseline") :baseline)
                                                                   ((equal (first args) "candidate") :candidate)))
       (rows nil) (path (and (= 2 (length args)) (pathname (second args)))))
  (unless (and phase path (not (probe-file path))) (error "Use baseline|candidate NEW-OUTPUT.lisp"))
  (dolist (version '(1 2)) (dolist (mode '(:legacy :resident :paged)) (dolist (size '(1 60000))
    (dolist (versioned '(nil t)) (dolist (dependent '(nil t))
      (arcdocdb.engine.tests::with-root (root)
        (let ((engine (read-test-open root t version mode)) (doc (cohort-document size)) (frontier 1))
          (unwind-protect
               (progn
                 (is (= 1 (e:scrivi-documento engine (bytes 2) doc)))
                 (dotimes (window 3)
                   (let ((samples nil))
                     (dotimes (i 5)
                       (let ((sample (cohort-sample engine doc versioned dependent phase frontier)))
                         (setf frontier (getf sample :after)) (push sample samples)))
                     (push (list :version version :profile mode :bytes size :versioned versioned :dependent dependent
                                 :window window :samples (nreverse samples)) rows))))
            (e:chiudi-motore engine)))))))))
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :error)
    (write (list :kind :versioned-read-cohort-campaign :status :passed :phase phase
                 :runtime (lisp-implementation-version) :driver-sha256 (arcdocdb.evidence:file-sha256 *cohort-driver*)
                 :clock-units internal-time-units-per-second :cases 48 :windows (length rows)
                 :turns (* 5 (length rows)) :rows (nreverse rows)) :stream out :pretty nil) (terpri out))
  (format t "~S~%" (list :kind :versioned-read-cohort-campaign :status :passed :phase phase :cases 48 :windows (length rows) :turns (* 5 (length rows)))))
