;;;; C4 archive operation: retain the archive command's own terminal receipt before cleanup.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((here (uiop:pathname-directory-pathname *load-truename*))
       (from #p"spikes/out/version-cohort-closing-archive/")
       (to (merge-pathnames "commands/version-cohort-closing-archive/" here))
       (record (arcdocdb.evidence:read-evidence (merge-pathnames "report.lisp" from)))
       (identity (arcdocdb.evidence:read-evidence (merge-pathnames "source-identity.lisp" here))) (copies nil))
  (unless (and (eq :passed (getf identity :status)) (eq :ok (getf record :status))
               (eql 0 (getf record :exit-code)) (eq :stable (getf record :source-consistency))
               (equal (getf identity :sources) (getf record :source-blobs-before))
               (equal (getf identity :sources) (getf record :source-blobs-after)))
    (error "Closed terminal archive with exact qualified sources required"))
  (let* ((sources (getf identity :sources))
         (hashes (uiop:split-string (string-right-trim '(#\Newline)
                    (uiop:run-program (append '("git" "hash-object" "--") (mapcar (lambda (r) (getf r :path)) sources))
                                      :output :string)) :separator '(#\Newline))))
    (unless (equal hashes (mapcar (lambda (r) (getf r :git-blob)) sources)) (error "Sources changed before tail copy")))
  (dolist (file (uiop:directory-files from))
    (let* ((target (merge-pathnames (file-namestring file) to)) (hash (arcdocdb.evidence:file-sha256 file)))
      (when (probe-file target) (error "Tail copy already exists"))
      (ensure-directories-exist target) (uiop:copy-file file target)
      (unless (equal hash (arcdocdb.evidence:file-sha256 target)) (error "Tail byte mismatch"))
      (push (list :source (namestring file) :target (namestring target) :sha256 hash :bytes (arcdocdb.evidence:file-bytes file)) copies)))
  (with-open-file (out (merge-pathnames "tail-receipt.lisp" here) :direction :output :if-exists :error)
    (write (list :kind :versioned-read-cohort-final-receipt :status :passed :source-consistency :stable
                 :qualified-sources (length (getf identity :sources)) :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                 :copies (nreverse copies)) :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :versioned-read-cohort-final-receipt :status :passed :files (length copies))))
