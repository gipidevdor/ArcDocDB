;;;; C4 archive operation: losslessly compact only finished records copied after closure.
(require :asdf)
(let ((args (uiop:command-line-arguments)) (here (uiop:pathname-directory-pathname *load-truename*)))
  (unless (and (= 4 (length args)) (equal (first args) "--root")
               (equal (nthcdr 2 args) '("--jobs" "1")) (equal (truename (second args)) here))
    (error "Explicit own campaign root and one worker required")))
(load "tools/compact-evidence.lisp")
(let* ((here (uiop:pathname-directory-pathname *load-truename*))
       (identity (arcdocdb.evidence:read-evidence (merge-pathnames "source-identity.lisp" here)))
       (tail (arcdocdb.evidence:read-evidence (merge-pathnames "tail-receipt.lisp" here)))
       (cleanup (arcdocdb.evidence:read-evidence (merge-pathnames "cleanup.lisp" here)))
       (paths (list (merge-pathnames "closing-archive.lisp" here))) (rows nil))
  (unless (every (lambda (r) (eq :passed (getf r :status))) (list identity tail cleanup))
    (error "Completed archive, source identity and cleanup required"))
  (dolist (directory (uiop:subdirectories (merge-pathnames "commands/" here)))
    (push (merge-pathnames "report.lisp" directory) paths))
  (dolist (path paths)
    (when (and (probe-file path) (> (arcdocdb.evidence:file-bytes path) 4096)
               (not (probe-file (pathname (concatenate 'string (namestring path) ".gz")))))
      (let ((row (compact-one path)))
        (unless (eq :ok (getf row :status)) (error "Late compaction failed")) (push row rows))))
  (with-open-file (out (merge-pathnames "late-compaction.lisp" here) :direction :output :if-exists :error)
    (write (list :kind :versioned-read-cohort-late-compaction :status :passed :rows (nreverse rows)
                 :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                 :limits '(:own-finished-copied-records-only :verified-original-and-expanded-byte-hashes))
           :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :versioned-read-cohort-late-compaction :status :passed :files (length rows))))
