;;;; C4: final source/ledger/allocation/complete-check verification with altered-receipt fixtures.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *vrc-here* (uiop:pathname-directory-pathname *load-truename*))
(defun vrc-demand (value reason) (unless value (error "Engine conditional evidence: ~A" reason)) value)
(defun vrc-data (path) (arcdocdb.evidence:read-evidence path))
(defun vrc-record (name) (vrc-data (format nil "spikes/out/~A/report.lisp" name)))
(defun vrc-rows (text prefix)
  (let ((cursor 0) (rows nil))
    (loop repeat 1000 for start = (search prefix text :start2 cursor) while start do
      (multiple-value-bind (row end) (let ((*read-eval* nil)) (read-from-string text nil nil :start start))
        (vrc-demand (> end start) :row-progress) (push row rows) (setf cursor end)))
    (vrc-demand (not (search prefix text :start2 cursor)) :row-ceiling) (nreverse rows)))
(defun vrc-current-sources ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                                 (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                                    :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-right-trim '(#\Newline) (uiop:run-program (append '("git" "hash-object" "--") paths)
                                                                                  :output :string)) :separator '(#\Newline))))
    (vrc-demand (= (length paths) (length hashes)) :source-count)
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(defun vrc-receipt-valid (record sources)
  (vrc-demand (and (eq :command-verification (getf record :kind)) (eq :ok (getf record :status))
                   (eql 0 (getf record :exit-code)) (eq :stable (getf record :source-consistency))
                   (equal sources (getf record :source-blobs-before)) (equal sources (getf record :source-blobs-after)))
              :current-stable-passing-receipt))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (let* ((sources '((:path "one" :git-blob "hash")))
         (record (list :kind :command-verification :status :ok :exit-code 0 :source-consistency :stable
                       :source-blobs-before sources :source-blobs-after sources)))
    (vrc-receipt-valid record sources)
    (dolist (key '(:status :source-consistency :exit-code :source-blobs-before :source-blobs-after))
      (let ((bad (copy-list record))) (setf (getf bad key) :invalid)
        (vrc-demand (handler-case (progn (vrc-receipt-valid bad sources) nil) (error () t)) :altered-receipt-detected)))
    (vrc-demand (= 2 (length (vrc-rows "(:KIND :ECG) text (:KIND :ECG)" "(:KIND :ECG"))) :row-fixture))
  (format t "~S~%" '(:kind :versioned-read-cohort-verifier-self-test :status :passed :altered-receipts-rejected 5))
  (sb-ext:exit :code 0))
(when (uiop:command-line-arguments) (error "Use --self-test or no arguments after all required commands complete"))
(let* ((sources (vrc-current-sources)) (base "31b8bdd862829a3aae9aedbc3e66c0a65c653945")
       (receipts nil) (qualifications nil) (allocations nil) (nested nil)
       (required '("version-cohort-candidate-final" "version-cohort-allocation-sbcl9-final" "version-cohort-allocation-sbcl10-final"
                   "version-cohort-qualification-sbcl9-final" "version-cohort-qualification-sbcl10-final"
                   "version-cohort-checks" "version-cohort-docs" "version-cohort-static-final")))
  (vrc-demand (equal '("src/local/version-dispatch.lisp" "src/local/write-group.lisp" "src/local/write-queue.lisp")
                     (uiop:split-string (string-right-trim '(#\Newline)
                       (uiop:run-program (list "git" "diff" "--name-only" base "--" "src/") :output :string)) :separator '(#\Newline)))
              :exact-runtime-scope)
  (dolist (name required)
    (let ((record (vrc-record name)))
      (vrc-receipt-valid record sources)
      (push (list :name name :status :passed :command (getf record :command)
                  :runtime (getf (getf record :environment) :version)) receipts)))
  (dolist (runtime '("sbcl9" "sbcl10"))
    (let* ((root (merge-pathnames (format nil "qualification-~A-final/" runtime) *vrc-here*))
           (planned (getf (vrc-data (merge-pathnames "planned.lisp" root)) :planned))
           (completed (vrc-data (merge-pathnames "completed.lisp" root))) (events nil))
      (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "events.lisp" root)
        (lambda (path) (with-open-file (in path) (let ((*read-eval* nil))
          (loop for row = (read in nil :eof) until (eq row :eof) do (push row events))))))
      (vrc-demand (and (= 52 (length planned)) (= 12 (count-if (lambda (id) (search "::TEST-REQ-IPC-002-DISJOINT-VERSION-GET-" id)) planned))
                       (eq :selected-affected-cases (getf completed :scope))
                       (eq :passed (getf completed :status)) (= 52 (getf completed :cases)) (= 2 (getf completed :suites))
                       (equal planned (getf completed :passed))
                       (equal planned (sort (loop for row in events when (eq :started (getf row :kind)) collect (getf row :id)) #'string<))
                       (equal planned (sort (loop for row in events when (eq :passed (getf row :kind)) collect (getf row :id)) #'string<)))
                   :exact-selected-case-ledger)
      (push (list :runtime runtime :cases 52 :scope :selected-affected-cases :status :passed) qualifications))
    (let* ((record (vrc-record (format nil "version-cohort-allocation-~A-final" runtime)))
           (rows (vrc-rows (getf record :stdout) "(:KIND :VERSIONED-READ-CLASSIFIER-ALLOCATION"))
           (measured (remove-if-not (lambda (r) (getf r :calls)) rows))
           (ordinary (remove-if (lambda (r) (getf r :control)) measured))
           (control (remove-if-not (lambda (r) (getf r :control)) measured)))
      (vrc-demand (and (= 11 (length rows)) (= 9 (length ordinary)) (= 1 (length control))
                       (every (lambda (r) (zerop (getf r :allocated-bytes))) ordinary)
                       (every (lambda (r) (plusp (getf r :allocated-bytes))) control)
                       (eq :passed (getf (car (last rows)) :status))) :allocation-controls)
      (push (list :runtime runtime :scope :classifier-only :calls 900000 :reported-bytes 0 :rows rows) allocations)))
  (dolist (directory (uiop:subdirectories #p"spikes/out/"))
    (let ((path (merge-pathnames "report.lisp" directory)))
      (when (probe-file path)
        (let ((record (handler-case (vrc-data path) (error () nil))))
          (when (and (eq :command-verification (getf record :kind)) (= 2 (length (getf record :command)))
                     (equal "make" (pathname-name (first (getf record :command)))) (equal "check-core" (second (getf record :command))))
            (vrc-receipt-valid record sources)
            (vrc-demand (and (search "11 spike completati" (getf record :stdout))
                            (search "build e test: nessun avviso, tutti i controlli superati" (getf record :stdout))) :complete-check-and-spikes)
            (setf nested (list :path (namestring path) :status :passed)))))))
  (vrc-demand nested :nested-full-check)
  (dolist (variant '("01" "02"))
    (let* ((initial (vrc-record (format nil "version-cohort-focused-~A" variant)))
           (blob (getf (find "tests/local/versioned-disjoint-read.lisp" (getf initial :source-blobs-before)
                            :key (lambda (r) (getf r :path)) :test #'equal) :git-blob))
           (frozen (namestring (merge-pathnames (format nil "variants/focused-~A/versioned-disjoint-read.lisp.source" variant) *vrc-here*))))
      (vrc-demand (string= blob (string-trim '(#\Newline) (uiop:run-program (list "git" "hash-object" "--" frozen) :output :string)))
                  :exact-earlier-test-variant)))
  (let* ((initial (vrc-record "version-cohort-qualification-sbcl9"))
         (blob (getf (find "tests/local/disjoint-read-processes.lisp" (getf initial :source-blobs-before)
                          :key (lambda (r) (getf r :path)) :test #'equal) :git-blob))
         (frozen (namestring (merge-pathnames "variants/qualification-sbcl9-01/disjoint-read-processes.lisp.source" *vrc-here*))))
    (vrc-demand (string= blob (string-trim '(#\Newline) (uiop:run-program (list "git" "hash-object" "--" frozen) :output :string)))
                :exact-earlier-process-variant))
  (let ((comparison (vrc-data (merge-pathnames "comparison-final.lisp" *vrc-here*)))
        (baseline (vrc-record "version-cohort-baseline")))
    (vrc-demand (and (eq :passed (getf comparison :status)) (= 48 (getf comparison :cases))
                     (= 720 (getf comparison :turns-per-phase))
                     (equal (getf comparison :unchanged-driver)
                            (arcdocdb.evidence:file-sha256 (merge-pathnames "bench.lisp" *vrc-here*)))
                     (eq :ok (getf baseline :status)) (eq :stable (getf baseline :source-consistency))) :paired-driver))
  (with-open-file (out (merge-pathnames "source-identity.lisp" *vrc-here*) :direction :output :if-exists :error)
    (write (list :kind :versioned-read-cohort-source-identity :status :passed :base base :sources sources
                 :receipts (reverse receipts) :qualifications (reverse qualifications) :allocations (reverse allocations)
                 :nested-full-check nested :limits '(:selected-qualification-not-full-suite :local-macOS-arm64
                                                    :classifier-allocation-only :controlled-ready-cohorts :not-Linux-or-power-loss))
           :stream out :pretty t) (terpri out))
  (format t "~S~%" (list :kind :versioned-read-cohort-source-identity :status :passed :sources (length sources)
                         :selected-cases-per-runtime 52 :classifier-allocation-windows-per-runtime 9)))
