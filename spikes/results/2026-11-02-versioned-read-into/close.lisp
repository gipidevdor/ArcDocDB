;;;; C4: explicit campaign-only lossless compaction and independent copied-byte verification.
(require :asdf)
(let ((args (uiop:command-line-arguments)) (here (uiop:pathname-directory-pathname *load-truename*)))
  (flet ((valid (values)
           (handler-case (and (= 4 (length values)) (equal (first values) "--root")
                              (equal (nthcdr 2 values) '("--jobs" "1")) (equal (truename (second values)) here))
             (error () nil))))
    (when (equal args '("--self-test"))
      (unless (and (valid (list "--root" (namestring here) "--jobs" "1"))
                   (not (valid '("--root" "/" "--jobs" "1")))
                   (not (valid (list "--root" (namestring here) "--jobs" "4")))) (error "Closure scope self-test"))
      (format t "~S~%" '(:kind :version-into-closure-self-test :status :passed :wrong-root :rejected :wrong-jobs :rejected))
      (sb-ext:exit :code 0))
    (unless (valid args) (error "Explicit own result root and one compaction worker required"))))
(load "tools/compact-evidence.lisp")
(defpackage #:version-into-closure (:use #:cl))
(in-package #:version-into-closure)
(defparameter *here* (uiop:pathname-directory-pathname *load-truename*))
(defun demand (truth) (unless truth (error "Version-into evidence closure")) truth)
(defun data (name) (arcdocdb.evidence:read-evidence (merge-pathnames name *here*)))
(defun hash-matches (path hash)
  (or (string= hash (arcdocdb.evidence:file-sha256 path))
      (arcdocdb.evidence:call-with-evidence-bytes path (lambda (file) (string= hash (arcdocdb.evidence:file-sha256 file))))))
(defun compact-directory (directory nested)
  (let ((rows nil))
    (dolist (file (uiop:directory-files directory))
      (when (and (not (equal (pathname-type file) "gz"))
                 (not (probe-file (pathname (concatenate 'string (namestring file) ".gz"))))
                 (or (and nested (equal (pathname-type file) "lisp") (> (arcdocdb.evidence:file-bytes file) 4096))
                     (and (member (pathname-type file) '("stdout" "stderr") :test #'equal)
                          (> (arcdocdb.evidence:file-bytes file) 1024))
                     (and (not nested) (member (file-namestring file) '("archive-data.lisp" "source-identity.lisp") :test #'equal))))
        (push (cl-user::compact-one file) rows)))
    (dolist (child (uiop:subdirectories directory)) (setf rows (append rows (compact-directory child t)))) rows))
(let ((identity (data "source-identity.lisp")) (archive (data "archive-data.lisp")) (verified 0))
  (demand (and (eq :passed (getf identity :status)) (eq :passed (getf archive :status))))
  (let ((compactions (compact-directory *here* nil)))
    (dolist (row (getf (data "archive-data.lisp") :copies))
      (demand (hash-matches (getf row :target) (getf row :sha256))) (incf verified))
    (with-open-file (out (merge-pathnames "closure.lisp" *here*) :direction :output :if-exists :error)
      (write (list :kind :version-into-evidence-closure :status :passed :verified-files verified :compactions compactions
                   :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*)
                   :limits '(:own-result-root-only :lossless-original-byte-hashes :all-copied-command-and-child-logs))
             :stream out :pretty t) (terpri out))
    (when (> (arcdocdb.evidence:file-bytes (merge-pathnames "closure.lisp" *here*)) 4096)
      (cl-user::compact-one (merge-pathnames "closure.lisp" *here*)))
    (format t "~S~%" (list :kind :version-into-evidence-closure :status :passed :files verified :compactions (length compactions)))))
