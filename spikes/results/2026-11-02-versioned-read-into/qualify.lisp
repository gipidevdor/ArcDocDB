;;;; C4: strict build and exact selected case ledger; fixtures also reject missing/duplicate/unplanned IDs.
(require :asdf)
(defun version-into-claim (id planned seen)
  (unless (and (member id planned :test #'equal) (not (gethash id seen))) (error "Unexpected/duplicate case ~A" id))
  (setf (gethash id seen) :started))
(defun version-into-complete (planned passed)
  (unless (and planned (equal planned (sort (copy-list passed) #'string<))) (error "Selected case coverage gap")))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (let ((seen (make-hash-table :test #'equal)))
    (version-into-claim "a" '("a") seen)
    (dolist (id '("a" "unplanned"))
      (unless (handler-case (progn (version-into-claim id '("a") seen) nil) (error () t)) (error "Ledger accepted bad ID")))
    (dolist (passed '(nil ("a" "a") ("unplanned")))
      (unless (handler-case (progn (version-into-complete '("a") passed) nil) (error () t)) (error "Ledger accepted missing/duplicate case")))
    (version-into-complete '("a") '("a")))
  (format t "~S~%" '(:kind :version-into-qualification-self-test :status :passed :duplicate :rejected :unplanned :rejected :missing :rejected))
  (sb-ext:exit :code 0))
(setf asdf:*compile-file-failure-behaviour* :error asdf:*compile-file-warnings-behaviour* :error)
(handler-bind ((warning (lambda (cause) (unless (typep cause 'sb-kernel:redefinition-warning) (error "COD-01: ~A" cause)))))
  (asdf:load-asd (truename "arcdocdb.asd")) (asdf:load-system "arcdocdb/local" :force t)
  (asdf:load-system "arcdocdb/tests"))
(defun version-into-save (path value)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :error)
    (with-standard-io-syntax (write value :stream out :readably t :pretty nil) (terpri out))))
(let* ((args (uiop:command-line-arguments)) (focused (equal (first args) "--focused"))
       (packages (if focused '("ARCDOCDB.LOCAL.WIRE.TESTS" "ARCDOCDB.LOCAL.NATIVE.TESTS" "ARCDOCDB.LOCAL.SERVER.TESTS")
                     '("ARCDOCDB.IO.TESTS" "ARCDOCDB.CBOR.TESTS" "ARCDOCDB.CBOR.MINIMAL.TESTS" "ARCDOCDB.CBOR.STRUCTURE.TESTS"
                       "ARCDOCDB.CBOR.MINIMAL.SCAN.TESTS" "ARCDOCDB.LOCAL.WIRE.TESTS" "ARCDOCDB.LOCAL.NATIVE.TESTS"
                       "ARCDOCDB.LOCAL.SERVER.TESTS" "ARCDOCDB.LOCAL.PROCESS.TESTS")))
       (specs (remove-if-not (lambda (s) (member (getf s :package) packages :test #'equal))
                            (arcdocdb.ci.tests:suite-specifications)))
       (inventory (arcdocdb.ci.tests:discover))
       (planned (sort (loop for row in (getf inventory :tests) when (member (getf row :suite) packages :test #'equal)
                            collect (getf row :id)) #'string<))
       (seen (make-hash-table :test #'equal)) (passed nil))
  (unless (and (= 2 (length args)) (member (first args) '("--focused" "--qualify") :test #'equal)
               (= (length packages) (length specs)) (plusp (length planned)) (eq :ready (getf inventory :status)))
    (error "Use --focused or --qualify NEW-OUTPUT; exact selected inventory required"))
  (let ((root (merge-pathnames (uiop:ensure-directory-pathname (second args))
                (uiop:pathname-directory-pathname *load-truename*))))
    (when (probe-file root) (error "Qualification output already exists"))
    (version-into-save (merge-pathnames "planned.lisp" root)
      (list :kind :version-into-qualification :status :started :runtime (lisp-implementation-version) :packages packages :planned planned))
    (with-open-file (events (merge-pathnames "events.lisp" root) :direction :output :if-exists :error)
      (let ((arcdocdb.ci.tests::*case-observer*
              (lambda (id thunk)
                (version-into-claim id planned seen)
                (write (list :kind :started :id id) :stream events) (terpri events) (finish-output events)
                (multiple-value-prog1 (funcall thunk)
                  (push id passed) (setf (gethash id seen) :passed)
                  (write (list :kind :passed :id id) :stream events) (terpri events) (finish-output events)))))
        (dolist (spec specs) (arcdocdb.ci.tests::invoke-suite spec nil))))
    (version-into-complete planned passed)
    (version-into-save (merge-pathnames "completed.lisp" root)
      (list :kind :version-into-qualification :status :passed :runtime (lisp-implementation-version)
            :suites (length specs) :cases (length passed) :passed (sort passed #'string<)))
    (format t "~S~%" (list :kind :version-into-qualification :status :passed :suites (length specs) :cases (length planned)))))
