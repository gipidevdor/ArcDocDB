;;;; C4 allocation fixture: public APIs, bounded preallocated I/O, persistent positive control.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/local")
(defpackage #:version-into-allocation (:use #:cl) (:local-nicknames (#:l #:arcdocdb.local)))
(in-package #:version-into-allocation)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defun demand (value) (unless value (error "Version-into allocation byte/token/ownership oracle")) value)
(defun fixture (document)
  (let ((reply (l::local-buffer)) (end 0) (cursor 0) (sends 0) (reads 0))
    (let* ((backend (l::make-native-backend
                     :send (lambda (fd buffer start count)
                             (declare (ignore fd)) (demand (zerop start)) (demand (>= cursor end))
                             (multiple-value-bind (id next) (l::%wire-uint buffer 7 count #xffffffffffffffff)
                               (demand (= 6 (aref buffer next)))
                               (setf cursor 0 end (l::encode-local-version-response reply id 0 (not (null document))
                                                   (if document 7 0) (or document reply) (if document (length document) 0))))
                             (incf sends) (values count 0))
                     :recv (lambda (fd buffer start count)
                             (declare (ignore fd))
                             (let ((size (min count (- end cursor))))
                               (demand (plusp size))
                               (replace buffer reply :start1 start :end1 (+ start size) :start2 cursor :end2 (+ cursor size))
                               (incf cursor size) (incf reads) (values size 0)))
                     :control (lambda (operation arguments) (declare (ignore operation arguments)) (error "Unexpected fixture poll"))))
           (client (l::make-local-client :socket (l::new-local-socket) :state :ready :versions t :clock (lambda () 0)
                                        :io-backend backend :waiter (l::make-local-waiter 1 backend))))
      (values client (lambda (calls) (demand (and (= sends reads calls) (= cursor end)
                                                  (= (1+ calls) (l::local-client-next-id client)))))))))
(defun window (client key target document buffered calls)
  (declare (type fixnum calls) (type (simple-array (unsigned-byte 8) (*)) key target))
  (dotimes (i calls)
    (if buffered
        (multiple-value-bind (status size token) (l:client-get-version-into client key target :start 4)
          (demand (eq status (if document :found :absent)))
          (demand (= size (if document (length document) 0))) (demand (= token (if document 7 0))))
        (multiple-value-bind (status copied token) (l:client-get-version client key)
          (demand (eq status (if document :found :absent))) (demand (equalp document copied))
          (demand (= token (if document 7 0)))))
    (when (and buffered document)
      (demand (not (mismatch document target :start2 4 :end2 (+ 4 (length document))))))
    (demand (= #xa5 (aref target 0))) (demand (= #xa5 (aref target 60004))))
  nil)
(dolist (size '(0 1 1024 60000))
  (let* ((document (when (plusp size) (make-array size :element-type '(unsigned-byte 8) :initial-element #x42)))
         (key (make-array 1 :element-type '(unsigned-byte 8) :initial-element 1))
         (target (make-array 60008 :element-type '(unsigned-byte 8) :initial-element #xa5)))
    (when document (if (= size 1) (setf (aref document 0) #xf6)
                       (progn (setf (aref document 0) #x59) (arcdocdb.binary:scrivi-u16 document 1 (- size 3)))))
    (dotimes (sample 5)
      (dolist (buffered (if (evenp sample) '(nil t) '(t nil)))
        (multiple-value-bind (client finish) (fixture document)
          (unwind-protect
               (progn
                 (window client key target document buffered 100)
                 (sb-ext:gc :full t)
                 (let ((before (sb-ext:get-bytes-consed)))
                   (window client key target document buffered 10000)
                   (let ((bytes (- (sb-ext:get-bytes-consed) before)))
                     (format t "~S~%" (list :kind :version-into-allocation :status :measured :sample (1+ sample)
                                            :api (if buffered :into :persistent) :document-bytes size :calls 10000
                                            :allocated-bytes bytes :scope :injected-I/O-current-fixnum-token))
                     (demand (if (or buffered (zerop size)) (zerop bytes) (plusp bytes)))))
                 (funcall finish 10100))
            (l:close-local client)))))))
(format t "~S~%" '(:kind :version-into-allocation :status :passed :windows 40 :calls 400000
                   :limits (:injected-I/O :no-kernel-throughput :fixnum-IDs-and-tokens :GC-before-window)))
