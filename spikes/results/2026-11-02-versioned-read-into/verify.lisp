;;;; C4: exact sources, selected-case ledgers, allocation controls and complete check provenance.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defparameter *version-into-here* (uiop:pathname-directory-pathname *load-truename*))
(defun vi-demand (value reason) (unless value (error "Version-into verification: ~A" reason)) value)
(defun vi-data (path) (arcdocdb.evidence:read-evidence path))
(defun vi-rows (text prefix)
  (let ((cursor 0) (rows nil))
    (loop repeat 1000 for start = (search prefix text :start2 cursor) while start do
      (multiple-value-bind (row end) (let ((*read-eval* nil)) (read-from-string text nil nil :start start))
        (vi-demand (> end start) :row-progress) (push row rows) (setf cursor end)))
    (vi-demand (not (search prefix text :start2 cursor)) :row-ceiling) (nreverse rows)))
(defun vi-command (name)
  (vi-data (format nil "spikes/out/~A/report.lisp" name)))
(defun vi-validate-receipt (record sources)
  (vi-demand (and (eq :command-verification (getf record :kind)) (eq :ok (getf record :status))
                 (eql 0 (getf record :exit-code)) (eq :stable (getf record :source-consistency))
                 (equal sources (getf record :source-blobs-before)) (equal sources (getf record :source-blobs-after)))
             :current-stable-passing-command))
(defun vi-current-sources ()
  (let* ((paths (sort (remove-if (lambda (p) (or (zerop (length p)) (uiop:string-prefix-p "spikes/results/" p)))
                                (uiop:split-string (uiop:run-program '("git" "ls-files" "-z" "--cached" "--others" "--exclude-standard")
                                                                    :output :string) :separator '(#\Null))) #'string<))
         (hashes (uiop:split-string (string-right-trim '(#\Newline)
                                    (uiop:run-program (append '("git" "hash-object" "--") paths) :output :string))
                                   :separator '(#\Newline))))
    (vi-demand (= (length paths) (length hashes)) :source-count)
    (loop for path in paths for hash in hashes collect (list :path path :git-blob hash))))
(when (equal (uiop:command-line-arguments) '("--self-test"))
  (let* ((sources '((:path "a" :git-blob "one")))
         (record (list :kind :command-verification :status :ok :exit-code 0 :source-consistency :stable
                       :source-blobs-before sources :source-blobs-after sources)))
    (vi-validate-receipt record sources)
    (dolist (field '(:status :source-consistency :exit-code :source-blobs-before :source-blobs-after))
      (let ((bad (copy-list record)))
        (setf (getf bad field) :invalid)
        (vi-demand (handler-case (progn (vi-validate-receipt bad sources) nil) (error () t)) :bad-receipt-detected)))
    (vi-demand (= 2 (length (vi-rows "(:KIND :VI) text (:KIND :VI)" "(:KIND :VI"))) :row-fixture))
  (format t "~S~%" '(:kind :version-into-verifier-self-test :status :passed :altered-receipts-rejected 5))
  (sb-ext:exit :code 0))
(unless (null (uiop:command-line-arguments)) (error "Use --self-test or no arguments after all commands complete"))
(let* ((sources (vi-current-sources)) (receipts nil) (allocations nil) (qualifications nil)
       (names '("version-into-ledger-selftest" "version-into-focused-01" "version-into-allocation-final-sbcl9"
                "version-into-allocation-final-sbcl10" "version-into-qualification-sbcl9" "version-into-qualification-sbcl10"
                "version-into-checks" "version-into-docs" "version-into-static")))
  (let* ((base "059e91b1f17609c14ddf597853ec54799d41c37d")
         (changed (uiop:split-string (string-right-trim '(#\Newline)
                    (uiop:run-program (list "git" "diff" "--name-only" base "--" "src/") :output :string))
                   :separator '(#\Newline)))
         (frozen (namestring (merge-pathnames "variants/base/version-wire.lisp.source" *version-into-here*))))
    (vi-demand (equal changed '("src/local/client-get-into.lisp" "src/local/client-version.lisp" "src/local/client.lisp"
                               "src/local/package.lisp" "src/local/version-wire.lisp")) :exact-runtime-scope)
    (vi-demand (string= (string-trim '(#\Newline) (uiop:run-program (list "git" "hash-object" "--" frozen) :output :string))
                       (string-trim '(#\Newline) (uiop:run-program (list "git" "rev-parse" (concatenate 'string base ":src/local/version-wire.lisp"))
                                                                 :output :string))) :exact-base-validator-source))
  (dolist (name names)
    (let ((record (vi-command name)))
      (vi-validate-receipt record sources)
      (push (list :name name :status :passed :command (getf record :command) :runtime (getf (getf record :environment) :version)) receipts)))
  (dolist (runtime '("sbcl9" "sbcl10"))
    (let* ((record (vi-command (format nil "version-into-allocation-final-~A" runtime)))
           (rows (vi-rows (getf record :stdout) "(:KIND :VERSION-INTO-ALLOCATION"))
           (measured (remove-if-not (lambda (r) (eq :measured (getf r :status))) rows))
           (into (remove-if-not (lambda (r) (eq :into (getf r :api))) measured))
           (copies (remove-if-not (lambda (r) (and (eq :persistent (getf r :api)) (plusp (getf r :document-bytes)))) measured)))
      (vi-demand (and (= 41 (length rows)) (= 40 (length measured)) (= 20 (length into)) (= 15 (length copies))
                     (every (lambda (r) (zerop (getf r :allocated-bytes))) into)
                     (every (lambda (r) (plusp (getf r :allocated-bytes))) copies)
                     (eq :passed (getf (car (last rows)) :status))) :allocation-controls)
      (push (list :runtime runtime :measured-windows 40 :into-windows 20 :into-calls 200000 :into-allocated-bytes 0 :rows rows) allocations))
    (let* ((root (merge-pathnames (format nil "qualification-~A/" runtime) *version-into-here*))
           (planned (getf (vi-data (merge-pathnames "planned.lisp" root)) :planned))
           (completed (vi-data (merge-pathnames "completed.lisp" root))) (events nil))
      (arcdocdb.evidence:call-with-evidence-bytes (merge-pathnames "events.lisp" root)
        (lambda (path) (with-open-file (in path) (let ((*read-eval* nil))
          (loop for row = (read in nil :eof) until (eq row :eof) do (push row events))))))
      (vi-demand (and (= 469 (length planned)) (eq :passed (getf completed :status))
                     (= 9 (getf completed :suites)) (= (length planned) (getf completed :cases))
                     (equal planned (getf completed :passed))
                     (equal planned (sort (loop for row in events when (eq :started (getf row :kind)) collect (getf row :id)) #'string<))
                     (equal planned (sort (loop for row in events when (eq :passed (getf row :kind)) collect (getf row :id)) #'string<)))
                 :exact-planned-started-passed)
      (push (list :runtime runtime :suites 9 :cases 469 :status :passed) qualifications)))
  ;; MAKE CHECK's outer receipt contains only the nested recorder summary, not the full build output.
  (let ((nested nil))
    (dolist (directory (uiop:subdirectories #p"spikes/out/"))
      (let ((path (merge-pathnames "report.lisp" directory)))
        (when (probe-file path)
          (let ((record (handler-case (vi-data path) (error () nil))))
            (when (and (eq :command-verification (getf record :kind))
                       (= 2 (length (getf record :command)))
                       (equal "make" (pathname-name (first (getf record :command))))
                       (equal "check-core" (second (getf record :command))))
              (vi-validate-receipt record sources)
              (vi-demand (search "11 spike completati" (getf record :stdout)) :all-eleven-spikes)
              (vi-demand (search "build e test: nessun avviso, tutti i controlli superati" (getf record :stdout)) :complete-warning-free-build)
              (setf nested (list :path (namestring path) :status :passed)))))))
    (vi-demand nested :nested-full-check)
    (let ((out (merge-pathnames "source-identity.lisp" *version-into-here*)))
      (with-open-file (stream out :direction :output :if-exists :error)
        (write (list :kind :version-into-source-identity :status :passed :base "059e91b1f17609c14ddf597853ec54799d41c37d"
                     :sources sources :receipts (reverse receipts) :nested-full-check nested
                     :qualifications (reverse qualifications) :allocations (reverse allocations)
                     :limits '(:local-macOS-arm64 :not-Linux :not-power-loss :allocation-fixture-not-throughput))
               :stream stream :pretty t) (terpri stream)))
    (format t "~S~%" (list :kind :version-into-source-identity :status :passed :sources (length sources)
                           :qualification-cases-per-runtime 469 :into-windows-per-runtime 20))))
