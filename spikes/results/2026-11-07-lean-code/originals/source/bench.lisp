;;;; C4 component comparison: identical decoder, original copy policy versus private-key sharing.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error asdf:*compile-file-failure-behaviour* :error)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/local")
(load "tools/evidence-storage.lisp")
(defpackage #:lean-key-bench (:use #:cl) (:local-nicknames (#:l #:arcdocdb.local)))
(in-package #:lean-key-bench)
(declaim (optimize (safety 3) (speed 2)))
(defun original-copy-policy (buffer work i)
  (let* ((spans (l::local-group-workspace-spans work)) (base (* i l::+group-span-words+)))
    (l::%wire-copy buffer (aref spans (+ base l::+group-key-start+)) (aref spans (+ base l::+group-key-size+)))))
(defun keys (kind size)
  (map 'simple-vector
       (lambda (i)
         (let ((key (make-array size :element-type '(unsigned-byte 8) :initial-element 65)))
           (setf (aref key (if (eq kind :near-distinct) (1- size) 0))
                 (ecase kind (:identical 0) (:mixed (mod i 3)) ((:distinct :near-distinct) i))) key))
       #(0 1 2 3 4 5 6 7)))
(defun check-decode (wire envelope work expected)
  (multiple-value-bind (status count) (l::decode-local-read-group wire envelope work)
    (assert (and (zerop status) (= 8 count))))
  (dotimes (i 8) (assert (equalp (svref expected i) (svref (l::local-group-workspace-operations work) i)))))
(let ((candidate (symbol-function 'l::%wire-read-key-copy)) (copy (symbol-function 'l::%wire-copy)) (rows nil)
      (self-test (equal '("--self-test") (uiop:command-line-arguments))))
  (unwind-protect
       (dolist (size '(1 32 1024))
         (dolist (kind '(:identical :mixed :distinct :near-distinct))
           (let* ((selected (keys kind size)) (wire (make-array 65540 :element-type '(unsigned-byte 8)))
                  (end (l::encode-local-read-group wire 1 selected 8 65536))
                  (envelope (l::decode-local-envelope wire 4 end)) (work (l::make-local-group-workspace)))
             (dolist (phase '(:copy-all :share))
               (setf (symbol-function 'l::%wire-read-key-copy) (if (eq phase :share) candidate #'original-copy-policy))
               (let ((copies 0) (wanted (if (eq phase :copy-all) 8 (length (remove-duplicates selected :test #'equalp)))))
                 (unwind-protect
                      (progn (setf (symbol-function 'l::%wire-copy)
                                   (lambda (&rest args) (incf copies) (apply copy args)))
                             (check-decode wire envelope work selected) (assert (= wanted copies)))
                   (setf (symbol-function 'l::%wire-copy) copy))
                 (dotimes (warmup 500) (l::decode-local-read-group wire envelope work))
                 (dotimes (sample (if self-test 1 3))
                   (let* ((iterations (if self-test 1 2000)) (before (sb-ext:get-bytes-consed)) (start (get-internal-real-time)))
                     (dotimes (i iterations) (l::decode-local-read-group wire envelope work))
                     (let ((ticks (- (get-internal-real-time) start)) (allocated (- (sb-ext:get-bytes-consed) before)))
                       (check-decode wire envelope work selected)
                       (push (list :key-bytes size :pattern kind :phase phase :sample sample :iterations iterations
                                   :copies-per-request copies :elapsed-ticks ticks :allocated-bytes allocated) rows))))
                 (l::clear-local-group-workspace work))))))
    (setf (symbol-function 'l::%wire-read-key-copy) candidate (symbol-function 'l::%wire-copy) copy))
  (let ((result (list :schema-version 1 :kind :read-key-preparation-comparison :status :passed
                      :driver-sha256 (arcdocdb.evidence:file-sha256 *load-truename*) :self-test self-test
                      :clock-units-per-second internal-time-units-per-second :rows (nreverse rows)
                      :limits '(:component-only :same-decoder-different-key-copy-policy :not-whole-service-throughput
                                :natural-gc-in-measured-windows :private-key-sharing-only :canonical-get-per-member-unchanged))))
    (format t "~S~%" result)))
