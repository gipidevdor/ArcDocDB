;;;; C4 fixtures own every temporary root; failed roots remain available for diagnosis.
(defpackage #:arcdocdb.backup.tests
  (:use #:cl)
  (:local-nicknames (#:bk #:arcdocdb.backup) (#:e #:arcdocdb.engine) (#:et #:arcdocdb.engine.tests)
                   (#:vt #:arcdocdb.verify.tests) (#:io #:arcdocdb.io) (#:b #:arcdocdb.binary))
  (:import-from #:arcdocdb.foundation.tests #:is #:signals)
  (:export #:run #:child-main))
(in-package #:arcdocdb.backup.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body) `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D offline backup tests passed.~%" (length *tests*)) t)
(defun options () '(:max-file-bytes 8192 :max-segments 16 :max-records 32 :max-total-bytes 1048576 :buffer-bytes 4096))
(defun backup (source target &rest options)
  (apply #'bk:crea-backup-m1 source target (et::archive-id) (et::series-id) (append options (options))))
(defun restore (source target &rest options)
  (apply #'bk:ripristina-backup-m1 source target (et::archive-id) (et::series-id) (append options (options))))
(defun verify (source &rest options)
  (apply #'bk:verifica-backup-m1 source (et::archive-id) (et::series-id) (append options (options))))
(defun compare-backup (source target &rest options)
  (apply #'bk:confronta-backup-m1 source target (et::archive-id) (et::series-id) (append options (options))))
(defun source-store (root version &optional (count 5))
  (let ((path (merge-pathnames "source/" root)))
    (ensure-directories-exist (merge-pathnames ".fixture" path))
    (et::with-engine (engine (et::open-engine path :create t :version version))
      (if (= count 5) (et::initial-workload engine)
          (dotimes (i count) (e:scrivi-documento engine (et::key (mod i 3)) (et::value (mod i 16))))))
    path))
(defun root-cause (condition)
  (loop repeat 8 do
    (let ((next (cond ((typep condition 'bk:backup-error) (bk:backup-primary condition))
                      ((typep condition 'arcdocdb.verify:verification-error)
                       (arcdocdb.verify:verification-primary condition)) (t nil))))
      (unless next (return-from root-cause condition)) (setf condition next)))
  (error "Nested failure exceeds fixture budget."))
(defun refused (function &optional reason)
  (let ((seen nil))
    (handler-case (funcall function) (bk:backup-error (cause) (setf seen cause)))
    (is seen)
    (when reason (is (eq reason (arcdocdb.conditions:error-reason (root-cause seen)))))
    seen))
(defun canonical-images (directory)
  (remove "backup.manifest" (vt::store-image directory) :key #'car :test #'string=))
(defun test-job (&key (bytes 8192) (segments 16) (records 32) (total 1048576))
  (bk::prepare-job (et::archive-id) (et::series-id) bytes segments records total 4096 nil nil))
