;;;; C4: retained-root witnesses across actual group writes, backend migration and canonical maintenance.
(in-package #:arcdocdb.engine.tests)
(defun engine-active-arena (engine)
  (arcdocdb.get.resolver::sorgente-get-attiva-arena (e::motore-source engine)))
(defun engine-prefix-image (root)
  (let* ((arena (arcdocdb.get.resolver::sorgente-get-attiva-arena (arcdocdb.get.resolver::radice-get-attiva-source root)))
         (count (arcdocdb.get.resolver::radice-get-attiva-count root))
         (puts (arcdocdb.get.resolver::radice-get-attiva-puts root)))
    (list count puts (arcdocdb.get.resolver::radice-get-attiva-end root)
      (subseq (arcdocdb.get.resolver::arena-get-attiva-ends arena) 0 count)
      (subseq (arcdocdb.get.resolver::arena-get-attiva-limits arena) 0 (1+ count))
      (subseq (arcdocdb.get.resolver::arena-get-attiva-rows arena) 0 (* 6 puts)))))

;;; REQ: REQ-IDX-001 REQ-WAL-006 REQ-AFF-002 REQ-AFF-008
(deftest test-REQ-WAL-006-engine-append-arena-keeps-old-root-prefix-v1-v2
  (dolist (version '(1 2))
    (with-root (root)
      (let ((retained nil) (image nil))
        (with-engine (engine (group-open root :create t :version version :mode :legacy))
          (is (= 1028 (arcdocdb.get.resolver::payload-arena-get-attiva (engine-active-arena engine))))
          (is (= 1 (e:scrivi-documento engine (key 1) (value 1))))
          (setf retained (arcdocdb.series:leggi-radice-serie (e::motore-controller engine)) image (engine-prefix-image retained))
          (group-run engine (vector (group-put 2 2) (group-delete 1) (group-put 1 3) (group-delete 9) (group-put 3 4)) 2)
          (is (equalp image (engine-prefix-image retained)))
          (is (= 6 (arcdocdb.get.resolver::arena-get-attiva-count (engine-active-arena engine))))
          (check-get engine 1 (value 3)) (check-get engine 2 (value 2)) (check-get engine 3 (value 4)))
        (with-engine (engine (group-open root :version version :mode :legacy))
          (is (zerop (arcdocdb.get.resolver::arena-get-attiva-count (engine-active-arena engine))))
          (is (equalp image (engine-prefix-image retained)))
          (check-get engine 1 (value 3)) (check-get engine 3 (value 4))
          (group-run engine (vector (group-delete 1) (group-put 2 5)) 7)
          (check-get engine 1 nil) (check-get engine 2 (value 5)))))))

;;; REQ: REQ-IDX-001 REQ-IDX-013 REQ-CMP-001 REQ-STO-003 REQ-WAL-006
(deftest test-REQ-IDX-013-engine-append-arena-follows-ACTIVE-not-primary-backend
  (dolist (version '(1 2))
    (with-root (root)
      (with-engine (engine (group-open root :create t :version version))
        (let ((arena (engine-active-arena engine)))
          (group-run engine (map 'simple-vector (lambda (i) (group-put i i)) #(0 1 2 3 4 5 6 7)) 1)
          (rotation-force-paged engine :paged)
          (is (eq arena (engine-active-arena engine))) (is (eq :paged (e:modo-indice-motore engine)))
          (group-run engine (map 'simple-vector (lambda (i) (group-put i (+ i 10))) #(0 1 2 3 4 5 6 7)) 9)
          (e:configura-budget-indice-motore engine 8388608)
          (is (eq arena (engine-active-arena engine))) (is (= 16 (arcdocdb.get.resolver::arena-get-attiva-count arena)))
          (is (eq :compacted (getf (e:compatta-motore engine :force t) :status)))
          (is (not (eq arena (engine-active-arena engine)))))
          (is (zerop (arcdocdb.get.resolver::arena-get-attiva-count (engine-active-arena engine))))
          (dotimes (i 8) (check-get engine i (value (+ i 10))))
          (group-run engine (vector (group-delete 0) (group-put 1 21)) 17))
      (with-engine (engine (group-open root :version version))
        (check-frontier engine 18) (check-get engine 0 nil) (check-get engine 1 (value 21))
        (dotimes (i 6) (check-get engine (+ i 2) (value (+ i 12))))))))
