(in-package #:arcdocdb.engine.tests)

(defun activate-delta (engine option &key (keys 8) (bytes 128))
  (e:attiva-indice-paginato-motore engine option :delta-keys keys :delta-key-bytes bytes))

(deftest test-REQ-IDX-010-delta-put-delete-resurrection-v1-v2-tre-taglie
  (dolist (version '(1 2))
    (dolist (size '(4096 16384 65536))
      (with-root (root)
        (let ((first (build-option 1 :page-size size)) (second (build-option 2 :page-size size)))
          (with-engine (engine (open-build-engine root :create t :version version))
            (initial-workload engine) (e:costruisci-indice-paginato-motore engine first)
            (activate-delta engine first)
            (let ((file (check-active-file engine)) (original (image (build-path root first))))
              ;; Due chiavi assenti in origine: delete e poi PUT devono rimanere nel delta.
              (e:cancella-documento engine (key 7)) (check-get engine 7 nil)
              (e:scrivi-documento engine (key 7) (value 7)) (check-get engine 7 (value 7))
              (e:scrivi-documento engine (key 1) (value 8)) (check-get engine 1 (value 8))
              (e:cancella-documento engine (key 3)) (check-get engine 3 nil)
              (e:cancella-documento engine (key 3)) (check-get engine 3 nil)
              (e:scrivi-documento engine (key 3) (value 9)) (check-get engine 3 (value 9))
              (check-get engine 2 nil) (check-get engine 99 nil)
              (is (= 3 (e::delta-indice-motore-count (e::motore-delta engine))))
              (is (eq :paged (e:modo-indice-motore engine))) (is (eq file (check-active-file engine)))
              (is (equalp original (image (build-path root first))))
              ;; Ricostruzione dal canonico corrente, non dal vecchio derivato.
              (e:costruisci-indice-paginato-motore engine second)
              (activate-delta engine second)
              (is (eq :closed (arcdocdb.io:stato-file file)))
              (is (zerop (e::delta-indice-motore-count (e::motore-delta engine))))
              (check-get engine 1 (value 8)) (check-get engine 3 (value 9))))
          (with-engine (engine (open-build-engine root :version version :option second))
            (check-get engine 7 (value 7)) (check-get engine 3 (value 9))
            (is (null (e::motore-delta engine)))))))))

(deftest test-REQ-IDX-010-delta-key-and-byte-quota-no-wal-effects
  (dolist (limits '((1 128) (8 16)))
    (with-root (root)
      (with-engine (engine (open-build-engine root :create t))
        (initial-workload engine)
        (let ((option (build-option 1)))
          (e:costruisci-indice-paginato-motore engine option)
          (activate-delta engine option :keys (first limits) :bytes (second limits))
          (e:cancella-documento engine (key 1))
          (let ((before (images root)) (frontier (multiple-value-list (e:frontiere-motore engine)))
                (file (check-active-file engine)))
            (signals arcdocdb.conditions:resource-exhausted (e:scrivi-documento engine (key 9) (value 9)))
            (signals arcdocdb.conditions:resource-exhausted (e:cancella-documento engine (key 9)))
            (is (eq :ready (e:stato-motore engine))) (check-images root before)
            (is (equal frontier (multiple-value-list (e:frontiere-motore engine))))
            (is (eq file (check-active-file engine)))
            ;; Quota piena: la stessa chiave continua ad aggiornarsi, senza nuovo spazio.
            (e:scrivi-documento engine (key 1) (value 9)) (check-get engine 1 (value 9))
            (e:cancella-documento engine (key 1)) (check-get engine 1 nil)))))))

(deftest test-REQ-IDX-010-delta-preflight-configuration-and-double-reservation
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (let ((option (build-option 1)))
        (e:costruisci-indice-paginato-motore engine option)
        (dolist (pair '((-1 16) (65537 16) (1 -1) (1 16777217) (0 1) (1 0) (nil 1) (1 nil)))
          (signals arcdocdb.conditions:invalid-argument
                   (activate-delta engine option :keys (first pair) :bytes (second pair)))
          (is (eq :ready (e:stato-motore engine))))
        (activate-delta engine option)
        (let ((current (e::motore-delta engine))
              (quota (e::payload-attivazione-immagine engine option))
              (extra (e::payload-delta-indice 8 128)))
          (signals arcdocdb.conditions:resource-exhausted
                   (e:attiva-indice-paginato-motore engine option :delta-keys 8 :delta-key-bytes 128
                     :max-activation-payload (1- (+ quota extra))))
          (is (eq current (e::motore-delta engine)))
          (e:attiva-indice-paginato-motore engine option :delta-keys 8 :delta-key-bytes 128
            :max-activation-payload (+ quota extra))
          (is (not (eq current (e::motore-delta engine)))))
        (e:attiva-indice-paginato-motore engine option)
        (is (null (e::motore-delta engine)))
        (e:scrivi-documento engine (key 1) (value 1)) (is (eq :resident (e:modo-indice-motore engine)))))))

(deftest test-REQ-IDX-010-delta-collision-exact-key-span-and-copy
  (let* ((delta (e::crea-delta-indice-motore 4 64)) (table (e::delta-indice-motore-table delta))
         (arena (e::delta-indice-motore-arena delta)) (key (bytes 8 7)))
    ;; Stesso digest forzato, chiave diversa: deve proseguire fino allo slot libero.
    (replace arena key) (setf (aref table 0) 10 (aref table 1) 0 (aref table 2) 0 (aref table 3) 8)
    (is (nth-value 1 (e::sonda-delta-indice delta key 0 8 10 0)))
    (setf (aref key 3) 9)
    (multiple-value-bind (slot found) (e::sonda-delta-indice delta key 0 8 10 0)
      (is (not found)) (is (= slot 4)))
    (is (not (nth-value 1 (e::sonda-delta-indice delta key 0 7 10 0))))
    (is (not (nth-value 1 (e::sonda-delta-indice delta key 0 8 11 0))))
    (is (not (nth-value 1 (e::sonda-delta-indice delta key 0 8 10 8))))
    (setf (aref key 3) 7)
    (let ((framed (bytes 12 99)))
      (replace framed key :start1 2)
      (is (nth-value 1 (e::sonda-delta-indice delta framed 2 10 10 0))))
    (signals arcdocdb.conditions:invariant-violation (e::sonda-delta-indice delta key 0 0 10 0))
    (loop for slot from 0 below (length table) by 4 do (setf (aref table (+ slot 3)) 8))
    (signals arcdocdb.conditions:invariant-violation (e::sonda-delta-indice delta (bytes 8 99) 0 8 0 0)))
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (let ((option (build-option 1)) (mutable (key 1)))
        (e:costruisci-indice-paginato-motore engine option) (activate-delta engine option)
        (e:scrivi-documento engine mutable (value 1)) (fill mutable 99)
        (check-get engine 1 (value 1)) (check-get engine 99 nil)))))

(deftest test-REQ-IDX-010-delta-admitted-failure-and-preflight-invariant
  (dolist (phase '(:before-append :after-flush :after-commit))
    (with-root (root)
      (let ((armed nil))
        (with-engine (engine (open-build-engine root :create t
                               :observer (lambda (engine step)
                                           (declare (ignore engine))
                                           (when (and armed (eq phase step)) (throw 'stop :stopped)) nil)))
          (let ((option (build-option 1)))
            (initial-workload engine) (e:costruisci-indice-paginato-motore engine option)
            (activate-delta engine option) (setf armed t)
            (is (eq :stopped (catch 'stop (e:cancella-documento engine (key 1)))))
            (is (eq :faulted (e:stato-motore engine)))
            (is (not (e::motore-busy engine))) (check-active-file engine))))))
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (let ((option (build-option 1)))
        (e:costruisci-indice-paginato-motore engine option) (activate-delta engine option)
        (setf (e::motore-paged engine) nil)
        (signals arcdocdb.conditions:invariant-violation (e:cancella-documento engine (key 1)))
        (is (eq :faulted (e:stato-motore engine)))))))

(defun delta-child-main (arguments)
  (destructuring-bind (mode path format stage) arguments
    (let* ((root (uiop:ensure-directory-pathname path)) (version (parse-integer format))
           (option (build-option 1)) (armed nil))
      (with-engine (engine (open-build-engine root :create (string= mode "delta-write") :version version
                            :observer (lambda (engine phase)
                                        (when (and armed (string-equal stage (symbol-name phase)))
                                          (check-active-file engine) (crash phase)) nil)))
        (cond ((string= mode "delta-write")
               (initial-workload engine) (e:costruisci-indice-paginato-motore engine option)
               (activate-delta engine option) (e:scrivi-documento engine (key 1) (value 9))
               (setf armed t) (e:cancella-documento engine (key 3)) (error "Crash mancante."))
              ((string= mode "delta-verify")
               (is (eq :resident (e:modo-indice-motore engine)))
               (check-get engine 1 (value 9))
               (check-get engine 3 (if (string= stage "before-append") (value 4) nil))
               (check-frontier engine (if (string= stage "before-append") 6 7)))
              (t (error "Mode sconosciuto."))))
      (format t "~&DELTA-VERIFIED v~D ~A~%" version stage))))

(deftest test-REQ-IDX-010-delta-SIGKILL-replay-canonico-v1-v2
  (dolist (version '(1 2))
    (dolist (stage '("before-append" "after-flush" "after-commit"))
      (with-root (root)
        (child root version "delta-write" stage :signaled sb-posix:sigkill)
        (let* ((storage (merge-pathnames "storage/" root))
               (original (image (build-path storage (build-option 1)))))
          (child root version "delta-verify" stage :exited 0)
          (is (equalp original (image (build-path storage (build-option 1))))))))))

(deftest test-REQ-IDX-010-delta-publication-ownership-and-admission-guards
  (dolist (phase '(:before-image-publication :image-published))
    (with-root (root)
      (let ((armed nil))
        (with-engine (engine (open-build-engine root :create t
                               :observer (lambda (engine step)
                                           (declare (ignore engine))
                                           (when (and armed (eq phase step)) (throw 'stop :stopped)) nil)))
          (let ((option (build-option 1)))
            (e:costruisci-indice-paginato-motore engine option) (activate-delta engine option)
            (let ((old (e::motore-delta engine)) (file (check-active-file engine)))
              (setf armed t)
              (is (eq :stopped (catch 'stop (activate-delta engine option))))
              (is (eq :faulted (e:stato-motore engine)))
              (if (eq phase :before-image-publication)
                  (progn (is (eq old (e::motore-delta engine))) (is (eq file (check-active-file engine))))
                  (progn (is (not (eq old (e::motore-delta engine))))
                         (is (eq :closed (arcdocdb.io:stato-file file)))))
              (check-active-file engine)))))))
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (let ((option (build-option 1)))
        (e:costruisci-indice-paginato-motore engine option) (activate-delta engine option)
        (signals arcdocdb.conditions:invariant-violation
                 (e::chiave-nel-delta-motore-p engine (key 1) 0 16))
        (signals arcdocdb.conditions:invariant-violation
                 (e::registra-chiave-delta-motore engine (key 1) t))
        (is (zerop (e::delta-indice-motore-count (e::motore-delta engine))))))))
