;;; OWNER: runner C4 seriale; immagini prodotte dal motore, contatori FD solo fuori dalle misure.
;;; REQ: REQ-IDX-010 REQ-REC-001 REQ-AFF-008 REQ-AFF-004
(in-package #:arcdocdb.engine.tests)
(declaim (optimize (safety 3) (speed 2) (debug 3)))

(defun activation-fds ()
  (loop for fd below 1024
        when (handler-case (progn (sb-posix:fcntl fd sb-posix:f-getfd) t)
               (sb-posix:syscall-error (condition)
                 (unless (= sb-posix:ebadf (sb-posix:syscall-errno condition)) (error condition)) nil))
        collect fd))
(defun check-active-file (engine)
  (let ((file (e::motore-paged-file engine)) (view (e::motore-paged engine)))
    (is file) (is view) (is (e::motore-paged-option engine))
    (is (eq :open (arcdocdb.io:stato-file file)))
    (is (not (member file (e::motore-fds engine))))
    (is (eq file (arcdocdb.index.page::immagine-indice-verificata-file
                  (arcdocdb.index.page::vista-indice-paginato-current view))))
    file))

(deftest test-REQ-IDX-010-activate-v1-v2-tre-taglie-sostituzione-e-ritiro
  (dolist (version '(1 2))
    (dolist (size '(4096 16384 65536))
      (with-root (root)
        (let ((first (build-option 1 :page-size size :frames 1)) (second (build-option 2 :page-size size :frames 1))
              (last nil))
          (with-engine (engine (open-build-engine root :create t :version version))
            (initial-workload engine)
            (e:costruisci-indice-paginato-motore engine first)
            (let ((originals (images root)) (source (e:fonte-indice-motore engine))
                  (fds (length (activation-fds))) (owned (length (e::motore-fds engine))))
              (is (null (e:attiva-indice-paginato-motore engine first)))
              (is (eq :paged (e:modo-indice-motore engine)))
              (setf last (check-active-file engine)) (check-initial engine)
              (is (= (1+ fds) (length (activation-fds))))
              (check-images root originals)
              (e:costruisci-indice-paginato-motore engine second)
              (dotimes (i 8)
                (let ((previous last) (previous-view (e::motore-paged engine)))
                  (e:attiva-indice-paginato-motore engine second)
                  (setf last (check-active-file engine))
                  (is (not (eq last previous))) (is (eq :closed (arcdocdb.io:stato-file previous)))
                  (is (= (1+ fds) (length (activation-fds)))) (check-initial engine)
                  ;; Anche un frame caldo non autorizza letture tramite la capacita' ritirata.
                  (let ((words (make-array 5 :element-type '(unsigned-byte 64) :initial-element 99)))
                    (signals arcdocdb.conditions:io-fault
                             (arcdocdb.index.page:leggi-vista-indice-paginato previous-view (key 1) 0 16 words))
                    (is (every (lambda (word) (= word 99)) words)))))
              (is (= owned (length (e::motore-fds engine))))
              (is (same-engine-source source (e:fonte-indice-motore engine)))))
          (is (eq :closed (arcdocdb.io:stato-file last)))
          ;; L'attivazione e' privata: un riavvio senza opzione non sceglie alcun derivato.
          (with-engine (engine (open-build-engine root :version version))
            (is (eq :resident (e:modo-indice-motore engine))) (check-initial engine)
            (e:attiva-indice-paginato-motore engine second)
            (setf last (check-active-file engine))
            (is (= 6 (e:scrivi-documento engine (key 1) (value 6))))
            (is (eq :closed (arcdocdb.io:stato-file last)))
            (is (null (e::motore-paged-file engine))) (is (null (e::motore-paged-option engine)))
            (is (eq :resident (e:modo-indice-motore engine))) (check-get engine 1 (value 6))))))))

