(deftest test-REQ-IDX-010-activate-quota-transitoria-e-thread
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (initial-workload engine)
      (let ((first (build-option 1 :frames 1)) (second (build-option 2 :page-size 65536 :frames 1)))
        (e:costruisci-indice-paginato-motore engine first) (e:costruisci-indice-paginato-motore engine second)
        (signals arcdocdb.conditions:invariant-violation
                 (e::verifica-fonte-attivazione engine (e:fonte-indice-motore engine)
                   (arcdocdb.index.primary::indice-primario-revision (e::motore-index engine))))
        (e:attiva-indice-paginato-motore engine first)
        (let ((old (check-active-file engine)) (fds (activation-fds))
              (bare (+ 65536 65535 80 (* 65536 6))))
          (dolist (budget '(-1 536870913))
            (signals arcdocdb.conditions:invalid-argument
                     (e:attiva-indice-paginato-motore engine second :max-activation-payload budget)))
          ;; Il solo nuovo candidato starebbe in BARE: la vecchia cache trattenuta deve essere addebitata.
          (signals arcdocdb.conditions:resource-exhausted
                   (e:attiva-indice-paginato-motore engine second :max-activation-payload bare)
                   :engine-image-activation-memory)
          (is (= (+ bare (* 4096 3)) (e::payload-attivazione-immagine engine second)))
          (is (equal fds (activation-fds))) (is (eq old (check-active-file engine))) (check-initial engine)
          (let ((thread (sb-thread:make-thread
                         (lambda () (signals arcdocdb.conditions:invalid-argument
                                       (e:attiva-indice-paginato-motore engine second) :engine-owner)))))
            (sb-thread:join-thread thread))
          (e:attiva-indice-paginato-motore engine second :max-activation-payload (+ bare (* 4096 3)))
          (is (eq :closed (arcdocdb.io:stato-file old))) (check-initial engine))))))

(defun corrupt-activation-footer (path)
  (with-open-file (stream path :direction :io :element-type '(unsigned-byte 8) :if-exists :overwrite)
    (file-position stream (1- (file-length stream)))
    (let ((last (read-byte stream)))
      (file-position stream (1- (file-length stream))) (write-byte (logxor last 1) stream))))

(deftest test-REQ-IDX-010-activate-candidato-rifiutato-conserva-root-e-chiude-locale
  (dolist (failure '(:missing :corrupt :visits :size :stale))
    (with-root (root)
      (let ((active nil))
        (with-engine (engine (open-build-engine root :create t))
          (initial-workload engine)
          (let ((first (build-option 1)) (second (build-option 2)))
            (e:costruisci-indice-paginato-motore engine first)
            (when (eq failure :stale) (e:scrivi-documento engine (key 1) (value 6)))
            (e:costruisci-indice-paginato-motore engine second)
            (e:attiva-indice-paginato-motore engine (if (eq failure :stale) second first))
            (setf active (check-active-file engine))
            (when (eq failure :corrupt) (corrupt-activation-footer (build-path root second)))
            (let* ((view (e::motore-paged engine)) (fds (activation-fds)) (originals (images root))
                   (candidate (case failure (:missing (build-option 3)) (:visits (build-option 2 :max-visits 2))
                                (:size (build-option 2 :page-size 65536)) (:stale first) (otherwise second)))
                   (expected (case failure (:missing 'arcdocdb.conditions:io-fault)
                               (:visits 'arcdocdb.conditions:resource-exhausted) (otherwise 'arcdocdb.conditions:corruption-detected)))
                   (seen nil))
              (handler-case (e:attiva-indice-paginato-motore engine candidate)
                (arcdocdb.conditions:arcdocdb-error (condition) (is (typep condition expected)) (setf seen t)))
              (is seen) (is (eq :faulted (e:stato-motore engine)))
              (is (eq view (e::motore-paged engine))) (is (eq active (check-active-file engine)))
              (is (equal fds (activation-fds))) (check-images root originals))))
        (is (eq :closed (arcdocdb.io:stato-file active)))
        (with-engine (engine (open-build-engine root))
          (check-get engine 1 (value (if (eq failure :stale) 6 3))))))))

(deftest test-REQ-IDX-010-activate-nonlocal-prima-dopo-swap-e-rientro
  (dolist (phase '(:before-image-activation :image-activation-verified :before-image-publication :image-published))
    (with-root (root)
      (let ((armed nil) (last nil))
        (with-engine (engine (open-build-engine root :create t
                              :observer (lambda (engine observed)
                                          (when (and armed (eq phase observed))
                                            (signals arcdocdb.conditions:invalid-argument
                                                     (e:attiva-indice-paginato-motore engine (build-option 2)))
                                            (signals arcdocdb.conditions:invalid-argument
                                                     (e:leggi-documento engine (key 1) (bytes 64)))
                                            (throw 'activation-abort :unwound)) nil)))
          (initial-workload engine)
          (let ((first (build-option 1)) (second (build-option 2)))
            (e:costruisci-indice-paginato-motore engine first) (e:costruisci-indice-paginato-motore engine second)
            (e:attiva-indice-paginato-motore engine first)
            (let ((old (check-active-file engine)) (view (e::motore-paged engine)) (fds (activation-fds)))
              (setf armed t)
              (is (eq :unwound (catch 'activation-abort (e:attiva-indice-paginato-motore engine second))))
              (is (eq :faulted (e:stato-motore engine))) (is (not (e::motore-busy engine)))
              (setf last (check-active-file engine))
              (if (eq phase :image-published)
                  (progn (is (not (eq view (e::motore-paged engine)))) (is (eq :closed (arcdocdb.io:stato-file old))))
                  (progn (is (eq old last)) (is (eq view (e::motore-paged engine))) (is (equal fds (activation-fds))))))))
        (is (eq :closed (arcdocdb.io:stato-file last)))))))

(deftest test-REQ-IDX-010-activate-fonte-mutata-e-causa-io-dopo-swap
  (dolist (failure '(:revision :token :io-after :busy-after :state-after :controller-after))
    (with-root (root)
      (let ((armed nil) (cause (make-condition 'arcdocdb.conditions:io-fault :reason :activation-test-eio :operation :close)))
        (with-engine (engine (open-build-engine root :create t
                              :observer (lambda (engine phase)
                                          (when armed
                                            (case failure
                                              (:revision (when (eq phase :before-image-publication)
                                                           (incf (arcdocdb.index.primary::indice-primario-revision (e::motore-index engine)))))
                                              (:token (when (eq phase :before-image-publication)
                                                        (incf (aref (e::motore-source-token engine) 24))))
                                              (:io-after (when (eq phase :image-published) (error cause)))
                                              (:busy-after (when (eq phase :image-published) (setf (e::motore-busy engine) nil)))
                                              (:state-after (when (eq phase :image-published) (setf (e::motore-state engine) :recovering)))
                                              (:controller-after (when (eq phase :image-published)
                                                                   (arcdocdb.series:fault-controllore-serie
                                                                     (e::motore-controller engine) (e::motore-lease engine)))))) nil)))
          (initial-workload engine)
          (let ((first (build-option 1)) (second (build-option 2)))
            (e:costruisci-indice-paginato-motore engine first) (e:costruisci-indice-paginato-motore engine second)
            (e:attiva-indice-paginato-motore engine first)
            (let ((old (check-active-file engine)) (view (e::motore-paged engine)) (originals (images root)) (seen nil))
              (setf armed t)
              (handler-case (e:attiva-indice-paginato-motore engine second)
                (arcdocdb.conditions:arcdocdb-error (condition)
                  (if (eq failure :io-after) (is (eq cause condition))
                      (is (typep condition 'arcdocdb.conditions:invariant-violation))) (setf seen t)))
              (is seen) (is (eq :faulted (e:stato-motore engine))) (check-images root originals)
              (if (member failure '(:io-after :busy-after :state-after :controller-after))
                  (progn (is (eq :closed (arcdocdb.io:stato-file old))) (is (not (eq view (e::motore-paged engine)))))
                  (progn (is (eq old (check-active-file engine))) (is (eq view (e::motore-paged engine))))))))))))

(defun fake-activation-file (close)
  (let* ((backend (arcdocdb.io:make-backend #'identity #'identity #'identity #'identity #'identity close))
         (file (arcdocdb.io::%make-file :input backend 4096 65536)))
    (setf (arcdocdb.io::file-fd file) 100) file))

(defun fake-activation-view (file)
  ;; Soltanto per test di ownership/close: nessuna prova di contenuto viene dedotta da questi oggetti.
  (let* ((source (arcdocdb.index.page:crea-fonte-indice (archive-id) (series-id) (bytes 32) 0 0))
         (identity (arcdocdb.index.page:crea-identita-pagina (series-id) 1 4096 1))
         (reader (arcdocdb.index.page:crea-lettore-indice-pagine
                   (arcdocdb.index.page:crea-cache-pagine 4096 1
                     (lambda (identity buffer) (declare (ignore identity buffer)) (error "No synthetic reads."))) identity))
         (seal (arcdocdb.index.page::%make-sigillo-immagine source identity 4096 1 0 0))
         (proof (arcdocdb.index.page::%make-immagine-indice-verificata file seal reader))
         (view (arcdocdb.index.page:crea-vista-indice-paginato source)))
    (arcdocdb.index.page:pubblica-immagine-verificata view proof) view))

(deftest test-REQ-IDX-010-activate-close-fallito-dopo-trasferimento-e-ritiro
  (let* ((old-closed 0) (new-closed 0) (option (build-option 1))
         (old (fake-activation-file (lambda (fd) (declare (ignore fd)) (incf old-closed) -1)))
         (new (fake-activation-file (lambda (fd) (declare (ignore fd)) (incf new-closed) 0)))
         (view (fake-activation-view new))
         (engine (e::%make-motore :archive-id (archive-id) :series-id (series-id) :scratch (bytes 0) :empty (bytes 0)
                   :busy t :paged-file old :paged-option option)))
    (signals arcdocdb.conditions:io-fault (e::installa-vista-paginata-motore engine view new option) :io-close-result)
    (is (= old-closed 1)) (is (eq :closed (arcdocdb.io:stato-file old)))
    (is (eq new (e::motore-paged-file engine))) (is (eq view (e::motore-paged engine)))
    (is (eq :open (arcdocdb.io:stato-file new)))
    (e::ritira-indice-paginato-motore engine)
    (is (= new-closed 1)) (is (null (e::motore-paged engine)))
    (is (null (e::motore-paged-file engine))) (is (null (e::motore-paged-option engine)))
    (setf (e::motore-paged-file engine) (fake-activation-file (lambda (fd) (declare (ignore fd)) -1))
          (e::motore-paged engine) view (e::motore-paged-option engine) option)
    (signals arcdocdb.conditions:io-fault (e::ritira-indice-paginato-motore engine))
    (is (null (e::motore-paged engine))) (is (null (e::motore-paged-file engine)))
    (is (null (e::motore-paged-option engine)))
    (e::ritira-indice-paginato-motore engine) (is (= new-closed 1))))

