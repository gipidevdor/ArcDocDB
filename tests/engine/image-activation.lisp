(deftest test-REQ-IDX-010-activate-close-al-primo-put-fallisce-prima-del-wal
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (initial-workload engine)
      (let ((option (build-option 1)))
        (e:costruisci-indice-paginato-motore engine option)
        (e:attiva-indice-paginato-motore engine option)
        (let* ((native (check-active-file engine))
               (old-proof (arcdocdb.index.page::vista-indice-paginato-current (e::motore-paged engine)))
               (closed 0)
               ;; Wrapper C4: chiude il FD reale ma simula un esito negativo della close.
               (wrapped (fake-activation-file (lambda (fd) (declare (ignore fd))
                                               (incf closed) (arcdocdb.io:chiudi native) -1)))
               (view (arcdocdb.index.page:crea-vista-indice-paginato
                       (arcdocdb.index.page::vista-indice-paginato-source (e::motore-paged engine))))
               (proof (arcdocdb.index.page::%make-immagine-indice-verificata wrapped
                        (arcdocdb.index.page::immagine-indice-verificata-seal old-proof)
                        (arcdocdb.index.page::immagine-indice-verificata-reader old-proof)))
               (frontier (multiple-value-list (e:frontiere-motore engine))) (originals (images root)))
          (setf (arcdocdb.io::file-fd wrapped) (arcdocdb.io::file-fd native))
          (arcdocdb.index.page:pubblica-immagine-verificata view proof)
          (setf (e::motore-paged engine) view (e::motore-paged-file engine) wrapped)
          (signals arcdocdb.conditions:io-fault (e:scrivi-documento engine (key 1) (value 9)) :io-close-result)
          (is (eq :faulted (e:stato-motore engine))) (is (= closed 1))
          (is (eq :closed (arcdocdb.io:stato-file native)))
          (is (null (e::motore-paged engine))) (is (null (e::motore-paged-file engine)))
          (is (equal frontier (multiple-value-list (arcdocdb.csn:leggi-frontiere-csn (e::motore-registry engine)))))
          (check-images root originals))))))

(defun activation-child-main (arguments)
  (destructuring-bind (mode path version-string stage) arguments
    (let ((root (uiop:ensure-directory-pathname path)) (version (parse-integer version-string))
          (first (build-option 1)) (second (build-option 2)) (retired nil))
      (cond ((string= mode "activate-run")
             (with-engine (engine (open-build-engine root :version version :option first
                                    :observer (lambda (engine phase)
                                                (when (string-equal (symbol-name phase) stage)
                                                  (when retired
                                                    (is (null (e::motore-paged-file engine)))
                                                    (is (eq :closed (arcdocdb.io:stato-file retired))))
                                                  (crash phase)) nil)))
               (e:attiva-indice-paginato-motore engine second)
               (setf retired (check-active-file engine))
               (e:scrivi-documento engine (key 1) (value 9))
               (error "Activation crash not reached.")))
            ((string= mode "activate-verify")
             (if (string= stage "after-flush")
                 (progn
                   (signals arcdocdb.conditions:corruption-detected
                            (open-build-engine root :version version :option second) :index-image-source-mismatch)
                   (with-engine (engine (open-build-engine root :version version))
                     (check-get engine 1 (value 9)) (check-frontier engine 6)))
                 (progn
                   (with-engine (engine (open-build-engine root :version version))
                     (is (eq :resident (e:modo-indice-motore engine))) (check-initial engine))
                   (with-engine (engine (open-build-engine root :version version :option second))
                     (is (eq :paged (e:modo-indice-motore engine))) (check-initial engine))))
             (format t "~&ENGINE-ACTIVATION-VERIFIED ~A v~D~%" stage version))
            (t (error "Unknown activation mode."))))))

(deftest test-REQ-IDX-010-activate-SIGKILL-swap-e-prima-scrittura-v1-v2
  (dolist (version '(1 2))
    (dolist (stage '("before-image-publication" "image-published" "after-flush"))
      (with-root (root)
        (let ((storage (merge-pathnames "storage/" root)))
          (ensure-directories-exist storage)
          (with-engine (engine (open-build-engine storage :create t :version version))
            (initial-workload engine)
            (e:costruisci-indice-paginato-motore engine (build-option 1))
            (e:costruisci-indice-paginato-motore engine (build-option 2)))
          (let ((images (list (cons (build-path storage (build-option 1)) (image (build-path storage (build-option 1))))
                              (cons (build-path storage (build-option 2)) (image (build-path storage (build-option 2)))))))
            (child root version "activate-run" stage :signaled sb-posix:sigkill)
            (child root version "activate-verify" stage :exited 0)
            (dolist (entry images) (is (equalp (cdr entry) (image (car entry)))))))))))
