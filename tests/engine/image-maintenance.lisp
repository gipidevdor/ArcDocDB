(in-package #:arcdocdb.engine.tests)

(deftest test-REQ-IDX-010-maintain-policy-domini-soglie-arrotondamento
  (dolist (bad '(0 101 nil 75.0 1/2 -1))
    (signals arcdocdb.conditions:invalid-argument (e:crea-politica-rinnovo-indice :soglia-percentuale bad)))
  (dolist (sample '((4 128 2 32 75 nil) (4 128 3 48 75 t)
                    (8 64 2 47 75 nil) (8 64 2 48 75 t)
                    (100 1000 0 0 1 nil) (100 1000 1 1 1 t)
                    (4 128 3 127 100 nil) (4 128 4 127 100 t) (4 128 3 128 100 t)
                    (3 100 2 2 75 nil) (3 100 3 3 75 t)
                    (65536 16777216 64880 16609443 99 nil)
                    (65536 16777216 64880 16609444 99 t)))
    (destructuring-bind (limit bytes count used percent expected) sample
      (let ((delta (e::crea-delta-indice-motore limit bytes))
            (policy (e:crea-politica-rinnovo-indice :soglia-percentuale percent)))
        ;; Fixture dei soli contatori: non pretende di provare lookup o membership del delta.
        (setf (e::delta-indice-motore-count delta) count (e::delta-indice-motore-used delta) used)
        (is (eq expected (e::delta-oltre-soglia-p delta policy)))))))

(deftest test-REQ-IDX-010-maintain-noop-e-rinnovo-quote-preservate-v1-v2
  (dolist (version '(1 2))
    (dolist (size '(4096 16384 65536))
      (with-root (root)
        (with-engine (engine (open-build-engine root :create t :version version))
          (let ((policy (e:crea-politica-rinnovo-indice))
                (first (build-option 1 :page-size size)) (next (build-option 2 :page-size size)))
            (initial-workload engine) (renew-image engine first :keys 4 :bytes 128)
            (e:scrivi-documento engine (key 1) (value 9)) (e:scrivi-documento engine (key 3) (value 8))
            (let ((before (images root)) (delta (e::motore-delta engine)) (file (check-active-file engine)))
              (is (not (e:rinnovo-indice-richiesto-p engine policy)))
              (is (eq :mantieni (e:mantieni-indice-paginato-motore engine policy next :max-maintenance-payload 0)))
              (is (not (probe-file (build-path root next)))) (check-images root before)
              (is (eq delta (e::motore-delta engine))) (is (eq file (check-active-file engine)))
              (e:cancella-documento engine (key 7))
              (let ((source (e:fonte-indice-motore engine)) (images (images root)))
                (is (e:rinnovo-indice-richiesto-p engine policy))
                (is (eq :rinnovato (e:mantieni-indice-paginato-motore engine policy next)))
                (check-images root images) (is (same-engine-source source (e:fonte-indice-motore engine))))
              (is (eq :closed (arcdocdb.io:stato-file file)))
              (is (not (eq delta (e::motore-delta engine))))
              (let ((new (e::motore-delta engine)))
                (is (= 4 (e::delta-indice-motore-limit new)))
                (is (= 128 (length (e::delta-indice-motore-arena new))))
                (is (zerop (e::delta-indice-motore-count new))) (is (zerop (e::delta-indice-motore-used new))))
              (is (not (e:rinnovo-indice-richiesto-p engine policy)))
              ;; Lo stesso candidato puo' essere riproposto nel no-op: nessun controllo di namespace necessario.
              (let ((before (images root)))
                (is (eq :mantieni (e:mantieni-indice-paginato-motore engine policy next))) (check-images root before))
              (check-frontier engine 8) (check-get engine 1 (value 9)) (check-get engine 3 (value 8))
              (check-get engine 7 nil))))))))

(deftest test-REQ-IDX-010-maintain-soglia-byte-preflight-nome-e-memoria
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (let ((policy (e:crea-politica-rinnovo-indice)) (first (build-option 1)) (next (build-option 2)))
        (initial-workload engine) (renew-image engine first :keys 8 :bytes 64)
        (dolist (id '(1 3 7)) (e:cancella-documento engine (key id)))
        (let ((before (images root)) (delta (e::motore-delta engine)) (file (check-active-file engine)))
          (is (= 3 (e::delta-indice-motore-count delta))) (is (= 48 (e::delta-indice-motore-used delta)))
          (is (e:rinnovo-indice-richiesto-p engine policy))
          (signals arcdocdb.conditions:invalid-argument (e:mantieni-indice-paginato-motore engine policy first))
          (signals arcdocdb.conditions:resource-exhausted
                   (e:mantieni-indice-paginato-motore engine policy next :max-maintenance-payload 0))
          (check-images root before) (is (not (probe-file (build-path root next))))
          (is (eq :ready (e:stato-motore engine))) (is (eq delta (e::motore-delta engine)))
          (is (eq file (check-active-file engine))) (check-frontier engine 8)
          (is (eq :rinnovato (e:mantieni-indice-paginato-motore engine policy next
                              :max-maintenance-payload (e::payload-rinnovo-immagine engine next 8 64))))
          (check-get engine 1 nil) (check-get engine 3 nil))))))

(deftest test-REQ-IDX-010-maintain-guardie-e-contatori-corrotti
  (with-root (root)
    (with-engine (engine (open-build-engine root :create t))
      (let ((policy (e:crea-politica-rinnovo-indice)) (option (build-option 1)))
        (signals arcdocdb.conditions:invalid-argument (e:rinnovo-indice-richiesto-p engine policy))
        (signals arcdocdb.conditions:invalid-argument (e:mantieni-indice-paginato-motore engine policy option))
        (e:rinnova-indice-paginato-motore engine option)
        (signals arcdocdb.conditions:invalid-argument (e:rinnovo-indice-richiesto-p engine policy))
        (renew-image engine (build-option 2) :keys 4 :bytes 128)
        (dolist (args '((:max-maintenance-payload nil) (:max-maintenance-payload -1)
                        (:max-maintenance-payload 536870913) (:max-pages 0) (:max-pages 65537)))
          (signals arcdocdb.conditions:invalid-argument
                   (apply #'e:mantieni-indice-paginato-motore engine policy option args)))
        (is (eq :wrong-owner (sb-thread:join-thread
                             (sb-thread:make-thread
                              (lambda () (handler-case (e:rinnovo-indice-richiesto-p engine policy)
                                           (arcdocdb.conditions:invalid-argument () :wrong-owner)))))))
        (is (eq :ready (e:stato-motore engine))))))
  (dolist (sample '((5 5) (2 1) (2 129) (0 1) :missing-view))
    (with-root (root)
      (with-engine (engine (open-build-engine root :create t))
        (renew-image engine (build-option 1) :keys 4 :bytes 128)
        (if (eq sample :missing-view)
            (setf (e::motore-paged engine) nil)
            (setf (e::delta-indice-motore-count (e::motore-delta engine)) (first sample)
                  (e::delta-indice-motore-used (e::motore-delta engine)) (second sample)))
        (signals arcdocdb.conditions:invariant-violation
                 (e:rinnovo-indice-richiesto-p engine (e:crea-politica-rinnovo-indice)))
        (is (eq :faulted (e:stato-motore engine)))))))

(deftest test-REQ-IDX-010-maintain-rinnovo-fallito-e-non-rientrabile
  (dolist (phase '(:image-renewal-built :image-published))
    (with-root (root)
      (let ((armed nil) (policy (e:crea-politica-rinnovo-indice :soglia-percentuale 100)))
        (with-engine (engine (open-build-engine root :create t
                               :observer (lambda (engine step)
                                           (when (and armed (eq step phase))
                                             (signals arcdocdb.conditions:invalid-argument (e:rinnovo-indice-richiesto-p engine policy))
                                             (signals arcdocdb.conditions:invalid-argument
                                                      (e:mantieni-indice-paginato-motore engine policy (build-option 9)))
                                             (throw 'stop :stopped)) nil)))
          (initial-workload engine) (renew-image engine (build-option 1))
          (e:scrivi-documento engine (key 1) (value 9))
          (let ((file (check-active-file engine)))
            (setf armed t)
            (is (eq :stopped (catch 'stop (e:mantieni-indice-paginato-motore engine policy (build-option 2)))))
            (is (eq :faulted (e:stato-motore engine))) (is (not (e::motore-busy engine)))
            (if (eq phase :image-published)
                (is (eq :closed (arcdocdb.io:stato-file file)))
                (is (eq file (check-active-file engine))))
            (check-active-file engine)))))))

(deftest test-REQ-IDX-010-maintain-policy-condivisa-due-motori-isolati
  (with-root (one)
    (with-root (two)
      (with-engine (first (open-build-engine one :create t))
        (with-engine (second (open-build-engine two :create t))
          (let ((policy (e:crea-politica-rinnovo-indice)))
            (initial-workload first) (initial-workload second)
            (renew-image first (build-option 1) :keys 4 :bytes 128)
            (renew-image second (build-option 1) :keys 4 :bytes 128)
            (let ((before (images two)) (file (check-active-file second)))
              (dolist (id '(1 3 7)) (e:cancella-documento first (key id)))
              (is (e:rinnovo-indice-richiesto-p first policy))
              (is (not (e:rinnovo-indice-richiesto-p second policy)))
              (is (eq :rinnovato (e:mantieni-indice-paginato-motore first policy (build-option 2))))
              (is (eq :mantieni (e:mantieni-indice-paginato-motore second policy (build-option 2))))
              (check-images two before) (is (eq file (check-active-file second))) (check-initial second))))))))
