(in-package #:arcdocdb.engine.tests)
(declaim (optimize (safety 3) (speed 2) (debug 3)))

(defun engine-image-name () "primary-0000000000000001.idx.tmp")
(defun image-option (&rest options)
  (apply #'e:crea-opzione-indice-paginato (engine-image-name) options))

(defun engine-candidate (engine id)
  (let ((index (e::motore-index engine)) (key (key id))
        (words (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0)))
    (multiple-value-bind (high low) (arcdocdb.index.primary:digest-chiave-indice index key 0 (length key))
      (is (eq :live (arcdocdb.index.primary:leggi-indice-primario index key 0 (length key) high low
                         (e::motore-index-context engine) words))))
    (setf (aref words 2) (logand (aref words 2) #xffffffff00000000))
    words))

(defun write-engine-image (root engine ids &key (size 4096) mutate source (overflow nil))
  (let* ((file (arcdocdb.io:crea-temporaneo (merge-pathnames (engine-image-name) root) :max-transfer size))
         (canonical (or source (e:fonte-indice-motore engine))))
    (unwind-protect
         (progn
           (is (= size (arcdocdb.io:append-esatto file (bytes size) 0 size)))
           (let* ((builder (arcdocdb.index.page:crea-costruttore-pagine-file file
                            (arcdocdb.index.page:crea-identita-pagina (series-id) 1 size 1) size #x243f6a88 #x85a308d3))
                  (tail (when overflow (arcdocdb.index.page:costruisci-bucket-pagine builder #())))
                  (entries (map 'simple-vector
                             (lambda (id)
                               (let ((words (engine-candidate engine id)))
                                 (when mutate (funcall mutate words))
                                 (arcdocdb.index.page:crea-entry-costruzione builder (key id) words))) ids))
                  (proof (arcdocdb.index.page:costruisci-bucket-pagine builder entries :next tail)))
             (arcdocdb.index.page:sigilla-immagine-pagine builder proof file canonical)))
      (arcdocdb.io:chiudi file))))

(defun same-engine-source (left right)
  (arcdocdb.index.page::stessa-fonte-indice-p left right))

(deftest test-REQ-IDX-010-startup-paginato-get-e-ritiro-put-delete
  (dolist (version '(1 2))
    (dolist (size '(4096 16384 65536))
      (with-root (root)
        (let ((source nil))
          (with-engine (engine (open-engine root :create t :version version))
            (initial-workload engine)
            (setf source (e:fonte-indice-motore engine))
            (write-engine-image root engine '(1 3) :size size :overflow t))
          (let ((original (image (merge-pathnames (engine-image-name) root))))
            (with-engine (engine (open-engine root :version version :index-image (image-option :page-size size :frames 1)))
              (is (eq :paged (e:modo-indice-motore engine)))
              (is (same-engine-source source (e:fonte-indice-motore engine)))
              (check-initial engine)
              (signals arcdocdb.conditions:invalid-argument (e:scrivi-documento engine (bytes 0) (value 1)))
              (is (eq :paged (e:modo-indice-motore engine)))
              (is (= 6 (e:scrivi-documento engine (key 1) (value 6))))
              (is (eq :resident (e:modo-indice-motore engine)))
              (check-get engine 1 (value 6)) (check-get engine 3 (value 4))
              (is (= 7 (e:cancella-documento engine (key 3)))) (check-get engine 3 nil)
              (is (not (same-engine-source source (e:fonte-indice-motore engine)))))
            (is (equalp original (image (merge-pathnames (engine-image-name) root))))
            (with-engine (engine (open-engine root :version version))
              (check-get engine 1 (value 6)) (check-get engine 3 nil))))))))

(deftest test-REQ-IDX-010-fonte-vuota-tombstone-checkpoint-stabile
  (dolist (only-tombstone '(nil t))
    (with-root (root)
      (let ((source nil))
        (with-engine (engine (open-engine root :create t))
          (when only-tombstone (is (= 1 (e:cancella-documento engine (key 1)))))
          (setf source (e:fonte-indice-motore engine))
          (write-engine-image root engine nil))
        (dotimes (i 2)
          (with-engine (engine (open-engine root :index-image (image-option)))
            (is (eq :paged (e:modo-indice-motore engine)))
            (is (same-engine-source source (e:fonte-indice-motore engine)))
            (check-get engine 1 nil)))))))

(deftest test-REQ-IDX-010-candidato-obsoleto-rifiutato-senza-fallback
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (is (= 1 (e:scrivi-documento engine (key 1) (value 1))))
      (write-engine-image root engine '(1))
      (is (= 2 (e:scrivi-documento engine (key 1) (value 2)))))
    (let ((original (image (merge-pathnames (engine-image-name) root))))
      (signals arcdocdb.conditions:corruption-detected (open-engine root :index-image (image-option))
               :index-image-source-mismatch)
      (is (equalp original (image (merge-pathnames (engine-image-name) root))))
      (with-engine (engine (open-engine root)) (check-get engine 1 (value 2))))))

(deftest test-REQ-IDX-010-candidato-falso-con-fonte-esatta
  (dolist (field '(0 1 3))
    (with-root (root)
      (with-engine (engine (open-engine root :create t))
        (initial-workload engine)
        (write-engine-image root engine '(1 3) :mutate (lambda (words) (incf (aref words field)))))
      (signals arcdocdb.conditions:corruption-detected (open-engine root :index-image (image-option)))
      (with-engine (engine (open-engine root)) (check-initial engine)))))

(deftest test-REQ-IDX-010-configurazione-e-budget-immagine
  (let* ((name (copy-seq (engine-image-name))) (option (e:crea-opzione-indice-paginato name)))
    (fill name #\x)
    (is (string= (e::opzione-indice-paginato-name option) (engine-image-name))))
  (is (typep (image-option :frames 64 :max-visits (1- (ash 1 60)) :max-bytes 4295098368)
             'e:opzione-indice-paginato))
  (with-root (root)
    (signals arcdocdb.conditions:invalid-argument
             (open-engine root :create t :index-image (image-option)) :engine-image-on-create)
    (is (null (uiop:directory-files root))))
  (dolist (name '(nil "control.log" "xprimary0000000000000001.idx.tmp"
                    "primary-0000000000000001.idx.xxx" "../primary-0000000000000001.idx.tmp" "primary-000000000000000G.idx.tmp"))
    (signals arcdocdb.conditions:invalid-argument (e:crea-opzione-indice-paginato name) :engine-image-name))
  (dolist (args '((:page-size 8192) (:frames 0) (:frames 65) (:max-visits 0) (:max-visits 1152921504606846976) (:max-bytes 12287)
                  (:max-bytes 4295098369)
                  (:page-size 65536 :max-bytes 12288)))
    (signals arcdocdb.conditions:invalid-argument (apply #'image-option args) :engine-image-budgets))
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (initial-workload engine) (write-engine-image root engine '(1 3)))
    (signals arcdocdb.conditions:resource-exhausted
             (open-engine root :index-image (image-option :max-visits 2)) :index-image-visit-budget)
    (signals arcdocdb.conditions:corruption-detected
             (open-engine root :index-image (image-option :page-size 16384)))
    (signals arcdocdb.conditions:io-fault
             (open-engine root :index-image (e:crea-opzione-indice-paginato "primary-0000000000000002.idx.tmp")))
    (with-engine (engine (open-engine root)) (check-initial engine))))

(deftest test-REQ-IDX-010-preflight-capienza-conserva-paginato
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (loop for id from 1 to 28 do (e:scrivi-documento engine (key id) (value id)))
      (write-engine-image root engine (loop for id from 1 to 28 collect id)))
    (with-engine (engine (open-engine root :index-image (image-option)))
      (reject-index-limit root engine 29 :primary-fragment-load)
      (is (eq :paged (e:modo-indice-motore engine)))
      (check-get engine 1 (value 1))
      (is (= 29 (e:cancella-documento engine (key 1))))
      (is (eq :resident (e:modo-indice-motore engine))) (check-get engine 1 nil))))

(deftest test-REQ-IDX-010-get-usa-paginato-e-non-residente
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (initial-workload engine) (write-engine-image root engine '(1 3)))
    (with-engine (engine (open-engine root :index-image (image-option)))
      ;; Oracolo di selezione: il residente guasto non deve essere consultato dal GET paginato.
      (arcdocdb.index.primary:invalida-indice-primario (e::motore-index engine))
      (check-initial engine))))

(deftest test-REQ-IDX-010-fallimento-startup-dopo-adozione-rilascia-risorse
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (initial-workload engine) (write-engine-image root engine '(1 3)))
    (dolist (phase '(:before-index-image :index-image-ready :before-admission))
      (is (eq :unwound
              (catch 'abort-image
                (open-engine root :index-image (image-option)
                  :observer (lambda (engine observed)
                              (when (eq observed phase)
                                (signals arcdocdb.conditions:invalid-argument (e:fonte-indice-motore engine))
                                (throw 'abort-image :unwound)) nil)))))
      (with-engine (engine (open-engine root :index-image (image-option))) (check-initial engine)))))

(deftest test-REQ-IDX-010-file-chiuso-anche-con-cache-calda-nessun-fallback
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (initial-workload engine) (write-engine-image root engine '(1 3)))
    (with-engine (engine (open-engine root :index-image (image-option)))
      (check-initial engine)
      (let* ((view (e::motore-paged engine))
             (proof (arcdocdb.index.page::vista-indice-paginato-current view))
             (file (arcdocdb.index.page::immagine-indice-verificata-file proof))
             (target (bytes 64 204)))
        (arcdocdb.io:chiudi file)
        (signals arcdocdb.conditions:io-fault (e:leggi-documento engine (key 1) target) :io-unavailable)
        (is (every (lambda (byte) (= byte 204)) target))
        (is (eq :faulted (e:stato-motore engine)))))))

(deftest test-REQ-IDX-010-decisioni-fonte-validatore-e-fase
  (let ((engine (e::%make-motore :archive-id (archive-id) :series-id (series-id) :scratch (bytes 0) :empty (bytes 0))))
    (signals arcdocdb.conditions:invariant-violation (e::registra-fonte-indice-motore engine 0 0 64 64))
    (signals arcdocdb.conditions:invariant-violation (e::registra-fonte-indice-motore engine 0 1 64 0))
    (e::registra-fonte-indice-motore engine 0 1 64 64)
    (signals arcdocdb.conditions:invariant-violation (e::registra-fonte-indice-motore engine 0 1 128 64)))
  (with-root (root)
    (with-engine (engine (open-engine root :create t))
      (initial-workload engine)
      (let ((key (key 1)) (words (engine-candidate engine 1)))
        (is (e::verifica-candidato-immagine-motore engine key 0 (length key) words))
        (dotimes (field 5)
          (let ((copy (copy-seq words)))
            (incf (aref copy field))
            (is (not (e::verifica-candidato-immagine-motore engine key 0 (length key) copy)))))
        (is (not (e::verifica-candidato-immagine-motore engine (key 2) 0 16 words))))
      (signals arcdocdb.conditions:invariant-violation (e::recupera-indice-paginato-motore engine))
      (let* ((index (e::motore-index engine)) (original (arcdocdb.index.primary::indice-primario-root index)))
        (unwind-protect
             (dolist (bad (list (arcdocdb.index.primary::%make-root-indice 1 0 (vector nil))
                               (arcdocdb.index.primary::%make-root-indice 0 0 (vector nil nil))))
               (setf (arcdocdb.index.primary::indice-primario-root index) bad)
               (signals arcdocdb.conditions:unsupported-format (e:fonte-indice-motore engine)
                        :engine-image-source-outside-m1))
          (setf (arcdocdb.index.primary::indice-primario-root index) original)))
      (write-engine-image root engine '(1 3)))
    (with-engine (engine (open-engine root :index-image (image-option)))
      (unwind-protect
           (progn (setf (e::motore-state engine) :recovering)
                  (signals arcdocdb.conditions:invariant-violation (e::recupera-indice-paginato-motore engine)))
        (setf (e::motore-state engine) :ready)))))

(defun image-child-main (arguments)
  (destructuring-bind (mode path format stage) arguments
    (let ((root (uiop:ensure-directory-pathname path)) (version (parse-integer format)))
      (cond
        ((member mode '("image-startup" "image-write") :test #'string=)
         (with-engine (engine (open-engine root :version version :index-image (image-option)
                                :observer (lambda (engine phase)
                                            (when (string-equal (symbol-name phase) stage)
                                              (when (string= mode "image-write") (is (null (e::motore-paged engine))))
                                              (crash phase)) nil)))
           (when (string= mode "image-write")
             (is (eq :paged (e:modo-indice-motore engine)))
             (e:scrivi-documento engine (key 1) (value 9)))
           (error "Crash immagine non raggiunto.")))
        ((string= mode "image-verify")
         (with-engine (engine (open-engine root :version version :index-image (image-option)))
           (is (eq :paged (e:modo-indice-motore engine))) (check-initial engine)))
        ((string= mode "image-reject")
         (signals arcdocdb.conditions:corruption-detected
                  (open-engine root :version version :index-image (image-option)) :index-image-source-mismatch)
         (with-engine (engine (open-engine root :version version))
           (check-get engine 1 (value 9)) (check-get engine 3 (value 4)) (check-get engine 2 nil)
           (check-frontier engine 6)))
        (t (error "Mode immagine sconosciuto.")))
      (format t "~&ENGINE-IMAGE-VERIFIED v~D ~A ~A~%" version mode stage))))

(deftest test-REQ-IDX-010-SIGKILL-adozione-e-prima-scrittura-v1-v2
  (dolist (version '(1 2))
    (dolist (stage '("before-index-image" "index-image-ready" "after-flush"))
      (with-root (root)
        (let ((storage (uiop:ensure-directory-pathname (merge-pathnames "storage/" root))))
          (ensure-directories-exist storage)
          (with-engine (engine (open-engine storage :create t :version version))
            (initial-workload engine) (write-engine-image storage engine '(1 3)))
          (let ((original (image (merge-pathnames (engine-image-name) storage)))
                (write-p (string= stage "after-flush")))
            (child root version (if write-p "image-write" "image-startup") stage :signaled sb-posix:sigkill)
            (child root version (if write-p "image-reject" "image-verify") stage :exited 0)
            (is (equalp original (image (merge-pathnames (engine-image-name) storage))))))))))
