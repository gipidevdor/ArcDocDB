;;;; Real distinct peers, actual flush counters, SIGKILL/reopen and public-client response loss.
(in-package #:arcdocdb.local.process.tests)
(defmacro with-cohort-environment ((mode &optional drop) &body body)
  `(let ((old-width (uiop:getenv "ARCDOCDB_CONDITIONAL_COHORT")) (old-mode (uiop:getenv "ARCDOCDB_CONDITIONAL_MODE"))
         (old-drop (uiop:getenv "ARCDOCDB_CONDITIONAL_DROP_REPLY")))
     (unwind-protect
          (progn (sb-posix:setenv "ARCDOCDB_CONDITIONAL_COHORT" "8" 1)
                 (sb-posix:setenv "ARCDOCDB_CONDITIONAL_MODE" (string-downcase (symbol-name ,mode)) 1)
                 (sb-posix:setenv "ARCDOCDB_CONDITIONAL_DROP_REPLY" (if ,drop "1" "0") 1) ,@body)
       (flet ((restore (name value) (if value (sb-posix:setenv name value 1) (sb-posix:unsetenv name))))
         (restore "ARCDOCDB_CONDITIONAL_COHORT" old-width) (restore "ARCDOCDB_CONDITIONAL_MODE" old-mode)
         (restore "ARCDOCDB_CONDITIONAL_DROP_REPLY" old-drop)))))
(defun cohort-request (clients keys expected document)
  (dotimes (i 8)
    (let* ((client (aref clients i)) (id (l::local-client-next-id client)) (buffer (l::local-client-output client))
           (end (l::encode-local-version buffer id 1 (aref keys i) document (aref expected i) 65536)))
      (setf (l::local-client-next-id client) (1+ id))
      (l::transfer-local-client client buffer 0 end :output (deadline 30))))
  (let ((results (make-array 8)))
    (dotimes (i 8 results)
      (let* ((client (aref clients i)) (env (l::receive-local-client client 65536 (deadline 30))))
        (check (= (l:envelope-id env) (1- (l::local-client-next-id client))) "Conditional cohort response ID")
        (setf (aref results i) (multiple-value-list (l::decode-local-version-response
                               (l::local-client-input client) env (l::local-client-space client) 1)))))))
(defun cohort-log-records (server)
  (let ((text (uiop:read-file-string (child-stderr server))) (cursor 0) (records nil) (*read-eval* nil))
    (loop for start = (search "(:KIND :CONDITIONAL-COHORT" text :start2 cursor) while start do
      (multiple-value-bind (record end) (read-from-string text nil nil :start start)
        (push record records) (setf cursor end))) (reverse records)))
(defun cohort-close-clients (clients)
  (dotimes (i 8) (when (aref clients i) (l:close-local (aref clients i)))))
(defun cohort-public-pair (socket keys document)
  (let ((results (make-array 8 :initial-element nil)) (second-results (make-array 8 :initial-element nil)) (threads (make-array 8)))
    (dotimes (i 8)
      (let ((slot i))
        (setf (aref threads i)
              (sb-thread:make-thread
               (lambda ()
                 (let ((client (l:connect-local (namestring socket) :versions t)))
                   (unwind-protect
                        (progn
                          (setf (aref results slot)
                              (handler-case (multiple-value-list (l:client-put-if client (aref keys slot) document 0))
                                (l:outcome-unknown () '(:unknown)) (error (cause) (list :error (princ-to-string cause)))))
                          (when (eq :closed (l::local-client-state client)) (setf client (l:connect-local (namestring socket) :versions t)))
                          (setf (aref second-results slot) (multiple-value-list (l:client-put-if client (aref keys slot) document 0)))
                          (version-check-result (list :found document (second (aref second-results slot)))
                                                (multiple-value-list (l:client-get-version client (aref keys slot))))
                          (when (zerop slot) (check (= 9 (l:client-put client (decode-hex *key-three*) document)) "Unknown outcome allocated another CSN")))
                     (l:close-local client))))))))
    (dotimes (i 8) (check (not (eq :timed-out (sb-thread:join-thread (aref threads i) :timeout 60 :default :timed-out))) "Client join timeout"))
    (values results second-results)))

;;; REQ: REQ-TXS-002 REQ-TXS-003 REQ-WAL-002 REQ-WAL-006 REQ-REC-001 REQ-IDX-013
(deftest test-REQ-TXS-002-conditional-cohort-real-mixed-same-key-SIGKILL-reopen
  (call-with-run
   (lambda ()
     (let ((runtime (subdirectory "cohort-runtime/")) (keys (map 'vector #'automatic-local-key #(0 1 2 3 4 5 6 7))))
       (dolist (version '(1 2)) (dolist (mode '(:resident :paged))
         (scenario :conditional-cohort version
           (lambda ()
             (with-cohort-environment (mode)
               (let ((data (subdirectory (format nil "cohort-v~D-~A/" version mode)))
                     (clients (make-array 8 :initial-element nil)) (tokens (make-array 8 :initial-element 0))
                     (docs (make-array 8 :initial-element (decode-hex "182A"))))
                 (multiple-value-bind (server socket) (start-server data runtime version (if (eq mode :paged) 712 710) :create t :index-budget 8388608
                                                        :script "tools/local-conditional-group-server.lisp")
                   (unwind-protect
                        (progn
                          (dotimes (i 8) (setf (aref clients i) (l:connect-local (namestring socket) :versions t)))
                          (let ((results (cohort-request clients keys tokens (decode-hex "182A"))))
                            (dotimes (i 8) (check (eq :applied (first (aref results i))) "Initial condition failed")
                              (setf (aref tokens i) (second (aref results i)))))
                          (let ((expected (copy-seq tokens)))
                            (dotimes (i 8) (when (oddp i) (setf (aref expected i) 0)))
                            (let ((results (cohort-request clients keys expected (decode-hex "F6"))))
                              (dotimes (i 8)
                                (if (evenp i)
                                    (progn (check (eq :applied (first (aref results i))) "Matching condition failed")
                                           (setf (aref tokens i) (second (aref results i)) (aref docs i) (decode-hex "F6")))
                                    (version-check-result (list :conflict (aref tokens i)) (aref results i))))))
                          (let ((results (cohort-request clients keys (make-array 8 :initial-element #xffffffffffffffff) (decode-hex "00"))))
                            (dotimes (i 8) (version-check-result (list :conflict (aref tokens i)) (aref results i))))
                          (let ((results (cohort-request clients (make-array 8 :initial-element (aref keys 0))
                                                        (make-array 8 :initial-element (aref tokens 0)) (decode-hex "182B"))))
                            (check (= 1 (count :applied results :key #'first)) "Same-key cohort applied twice")
                            (dotimes (i 8) (check (= 13 (second (aref results i))) "Same-key version order"))
                            (setf (aref tokens 0) 13 (aref docs 0) (decode-hex "182B"))))
                     (cohort-close-clients clients))
                   (let ((logs (cohort-log-records server)))
                     (check (equal '(1 1 0 1) (mapcar (lambda (r) (getf r :flushes)) logs)) "Incorrect cohort flush history"))
                   (stop-server server sb-posix:sigkill :conditional-cohort-strong-confirmed))
                 (multiple-value-bind (server socket) (start-server data runtime version (if (eq mode :paged) 713 711))
                   (let ((client (l:connect-local (namestring socket) :versions t)))
                     (unwind-protect
                          (progn (dotimes (i 8) (version-check-result (list :found (aref docs i) (aref tokens i))
                                                                      (multiple-value-list (l:client-get-version client (aref keys i)))))
                                 (check (= 14 (l:client-put client (decode-hex *key-three*) (decode-hex "F6"))) "Group CSN gap"))
                       (l:close-local client)))
                   (stop-server server sb-posix:sigterm :conditional-cohort-recovered))))))))))))

;;; REQ: REQ-IPC-002 REQ-TXS-002 REQ-WAL-006 REQ-AFF-004 REQ-REC-001
(deftest test-REQ-WAL-006-conditional-cohort-real-public-client-lost-response
  (call-with-run
   (lambda ()
     (let ((runtime (subdirectory "cohort-loss-runtime/")) (keys (map 'vector #'automatic-local-key #(0 1 2 3 4 5 6 7)))
           (doc (decode-hex "182A")))
       (dolist (version '(1 2)) (dolist (mode '(:resident :paged))
         (scenario :conditional-cohort-loss version
           (lambda ()
             (with-cohort-environment (mode t)
               (let ((data (subdirectory (format nil "cohort-loss-v~D-~A/" version mode))))
                 (multiple-value-bind (server socket) (start-server data runtime version (if (eq mode :paged) 722 720) :create t :index-budget 8388608
                                                       :script "tools/local-conditional-group-server.lisp")
                   (multiple-value-bind (first second) (cohort-public-pair socket keys doc)
                     (check (= 1 (count :unknown first :key #'first)) "Lost response was falsely confirmed/retried")
                     (check (= 7 (count :applied first :key #'first)) "Unrelated group responses lost")
                     (check (= 8 (count :conflict second :key #'first)) "Retry changed existing values"))
                   (check (search "CONDITIONAL-COHORT-RESPONSE-DROPPED" (uiop:read-file-string (child-stderr server))) "Wrong loss injection")
                   (check (equal '(1 0) (mapcar (lambda (r) (getf r :flushes)) (cohort-log-records server))) "Wrong loss flushes")
                   (stop-server server sb-posix:sigterm :conditional-cohort-loss-verified))))))))))))
