;;;; Independent expected bytes/counters; engine APIs produce the stores, never verification setup.
(defpackage #:arcdocdb.verify.tests
  (:use #:cl)
  (:local-nicknames (#:v #:arcdocdb.verify) (#:e #:arcdocdb.engine) (#:et #:arcdocdb.engine.tests))
  (:import-from #:arcdocdb.foundation.tests #:is #:signals)
  (:export #:run))
(in-package #:arcdocdb.verify.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D offline M1 verifier tests passed.~%" (length *tests*)) t)
(defun inspect-store (root &rest options)
  (apply #'v:verifica-storage-m1 root (et::archive-id) (et::series-id)
         :max-file-bytes 8192 :max-segments 16 :max-records 32 options))
(defun store-image (root)
  (sort (et::images root) #'string< :key #'car))
(defun check-unchanged (root before) (is (equalp before (store-image root))))
(defun write-fixture (path bytes)
  (with-open-file (out path :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
    (write-sequence bytes out)))
(defun append-fixture-byte (path)
  (with-open-file (out path :direction :output :if-exists :append :element-type '(unsigned-byte 8))
    (write-byte 0 out)))
(defun damage-fixture (path offset)
  (with-open-file (file path :direction :io :if-exists :overwrite :element-type '(unsigned-byte 8))
    (file-position file offset)
    (let ((byte (read-byte file))) (file-position file offset) (write-byte (logxor 1 byte) file))))
(defun segment-path (root row)
  (merge-pathnames (format nil "~16,'0x.seg~A" (getf row :id)
                          (if (eq :temporary (getf row :form)) ".tmp" "")) root))
(defun data-store (root version &optional (count 3))
  (et::with-engine (engine (et::open-engine root :create t :version version))
    (dotimes (i count) (e:scrivi-documento engine (et::key (mod i 3)) (et::value (mod i 16))))))
(defun refusal (root stage thunk &optional reason)
  (let ((before (store-image root)) (seen nil))
    (handler-case (funcall thunk)
      (v:verification-error (condition)
        (setf seen condition)
        (is (eq stage (v:verification-stage condition)))
        (is (null (v:verification-cleanup condition)))
        (when reason (is (eq reason (arcdocdb.conditions:error-reason (v:verification-primary condition)))))))
    (is seen) (check-unchanged root before) seen))
(defun run-verifier-cli (&rest arguments)
  (uiop:run-program (append (list (namestring sb-ext:*runtime-pathname*) "--noinform" "--no-userinit"
                                  "--no-sysinit" "--script" "tools/arcdocdb-verify.lisp") arguments)
                    :output :string :error-output :string :ignore-error-status t))
(defun read-cli-result (text)
  (let ((*read-eval* nil))
    (with-input-from-string (in text)
      (let ((result (read in)) (eof (gensym)))
        (is (eq eof (read in nil eof))) result))))
