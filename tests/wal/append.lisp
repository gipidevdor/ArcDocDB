;;;; C4: independent byte concatenation and prefix oracles; injected writer counts actual backend calls.
(in-package #:arcdocdb.wal.tests)
(defun append-batch (version start stamp kinds &optional (value-size 1))
  (let ((batch (crea-lotto :segment 31 :version version :capacity (+ 512 value-size) :max-records 8)))
    (dolist (kind kinds)
      (aggiungi-record batch kind (bytes 17) (if (= kind 2) (buffer 0) (buffer value-size))))
    (sigilla-lotto batch stamp start 0) batch))
(defun append-lots (version)
  (let* ((a (append-batch version 0 11 '(1)))
         (b (append-batch version (lunghezza-lotto a) 12 '(2)))
         (c (append-batch version (+ (lunghezza-lotto a) (lunghezza-lotto b)) 13 '(1 1))))
    (list a b c)))
(defun append-expected (lots)
  (let ((out (buffer (loop for batch in lots sum (lunghezza-lotto batch)))) (at 0))
    (dolist (batch lots)
      (replace out (arcdocdb.wal::lotto-buffer batch) :start1 at :end2 (lunghezza-lotto batch))
      (incf at (lunghezza-lotto batch))) out))
(defun append-check-fault (group file)
  (is (eq :faulted (stato-gruppo group))) (is (eq :faulted (stato-log (arcdocdb.wal::gruppo-log group))))
  (is (eq group (arcdocdb.wal::log-io-active (arcdocdb.wal::gruppo-log group))))
  (dotimes (i (arcdocdb.wal::gruppo-count group))
    (let ((batch (svref (arcdocdb.wal::gruppo-slots group) i)))
      (is (eq :faulted (stato-lotto batch))) (is (not (coperto-p batch :async)))
      (is (not (coperto-p batch :strong))) (is (eq group (arcdocdb.wal::lotto-owner batch)))))
  (is (zerop (arcdocdb.io:posizione-durevole file))))

;;; REQ: REQ-WAL-002 REQ-WAL-005 REQ-WAL-006 REQ-AFF-008
(deftest test-REQ-WAL-002-buffered-identical-mixed-seals-one-write-and-reuse
  (dolist (version '(1 2))
    (let* ((lots (append-lots version)) (expected (append-expected lots)) (out (buffer 4096))
           (pos 0) (calls 0) (flushes 0) (scratch (buffer (length expected)))
           (file (fixture-file :writer (lambda (fd data start count) (declare (ignore fd))
                    (incf calls) (replace out data :start1 pos :start2 start :end2 (+ start count)) (incf pos count) count)
                  :flush (lambda (fd) (declare (ignore fd)) (incf flushes) 0)))
           (log (crea-log-io file :segment 31 :version version)) (group (apply #'fixture-group log lots)))
      (is (= (length expected) (scrivi-gruppo group :buffer scratch))) (is (= calls 1)) (is (zerop flushes))
      (is (equalp scratch expected)) (is (not (mismatch out expected :end1 pos)))
      (dolist (batch lots) (is (coperto-p batch :async)) (is (not (coperto-p batch :strong))))
      (is (= pos (sincronizza-gruppo group))) (is (= flushes 1)) (fill scratch 255)
      (is (equalp expected (append-expected lots))) (is (not (mismatch out expected :end1 pos)))
      (riusa-gruppo group) (dolist (batch lots) (riusa-lotto batch))
      (let ((next (append-batch version pos 14 '(1))))
        (aggiungi-lotto group next) (chiudi-gruppo group) (scrivi-gruppo group :buffer scratch)
        (sincronizza-gruppo group) (is (= calls 2)) (is (= flushes 2)) (is (coperto-p next :strong)))
      (arcdocdb.io:chiudi file))))

;;; REQ: REQ-WAL-002 REQ-LIM-003 REQ-AFF-008
(deftest test-REQ-AFF-008-buffered-fallback-and-exact-64KiB-capacity
  (dolist (case '(:none :empty :one-short :single :exact :over-cap :transfer-cap :transfer-fits :oversized-scratch))
    (let* ((calls 0) (large (member case '(:exact :over-cap :transfer-cap)))
           (a (append-batch 2 0 11 '(1) (if large 32687 1)))
           (b (append-batch 2 (lunghezza-lotto a) 12 '(1) (if large (if (eq case :over-cap) 32688 32687) 1)))
           (lots (if (eq case :single) (list a) (list a b))) (total (loop for batch in lots sum (lunghezza-lotto batch)))
           (scratch (case case (:none nil) (:empty (buffer 0)) (:one-short (buffer (1- total)))
                      (:oversized-scratch (buffer 65537))
                      (otherwise (buffer total))))
           (file (fixture-file :writer (lambda (fd data start count) (declare (ignore fd data start)) (incf calls) count)
                   :max-transfer (case case (:transfer-cap 32768) (:transfer-fits total) (otherwise 268435456))))
           (log (crea-log-io file :segment 31)) (group (apply #'fixture-group log lots)))
      (is (= total (scrivi-gruppo group :buffer scratch)))
      (is (= calls (if (member case '(:exact :single :transfer-fits :oversized-scratch)) 1 2)))
      (when (eq case :exact) (is (= total 65536))) (when (eq case :over-cap) (is (= total 65537)))
      (sincronizza-gruppo group) (arcdocdb.io:chiudi file))))

;;; REQ: REQ-WAL-002 REQ-AFF-008
(deftest test-REQ-AFF-008-buffer-type-alias-and-file-refusal-before-acquisition
  (let* ((calls 0) (file (fixture-file :writer (lambda (fd data start count)
                         (declare (ignore fd data start)) (incf calls) count)))
         (log (crea-log-io file :segment 31)) (lots (append-lots 2)) (group (apply #'fixture-group log lots))
         (original (append-expected lots)))
    (dolist (bad (cons 17 (mapcar #'arcdocdb.wal::lotto-buffer lots)))
      (signals invalid-argument (scrivi-gruppo group :buffer bad))
      (is (eq :ready (stato-gruppo group))) (is (eq :open (stato-log log)))
      (is (null (arcdocdb.wal::log-io-active log))) (is (equalp original (append-expected lots))))
    (is (zerop calls)) (is (zerop (arcdocdb.io:posizione-scritta file))) (arcdocdb.io:chiudi file))
  (let* ((file (fixture-file :max-file-bytes 163)) (log (crea-log-io file :segment 31))
         (group (fixture-group log (fixture-lotto) (fixture-lotto :start 82))) (scratch (buffer 164)))
    (fill scratch 219) (signals resource-exhausted (scrivi-gruppo group :buffer scratch))
    (is (every (lambda (n) (= n 219)) scratch)) (is (eq :ready (stato-gruppo group)))
    (is (null (arcdocdb.wal::log-io-active log))) (arcdocdb.io:chiudi file)))

;;; REQ: REQ-WAL-005 REQ-WAL-006 REQ-REC-001 REQ-AFF-001
(deftest test-REQ-WAL-006-buffered-every-byte-cut-and-short-write-prefix-model
  (dolist (version '(1 2))
    (let* ((geometry (append-lots version)) (expected (append-expected geometry)) (total (length expected))
           (ends (loop for batch in geometry for end = (lunghezza-lotto batch) then (+ end (lunghezza-lotto batch)) collect end)))
      (dolist (chunk (list 1 7 total))
        (dotimes (cut (1+ total))
          (let* ((out (buffer total)) (pos 0) (flushes 0) (lots (append-lots version))
                 (file (fixture-file :writer (lambda (fd data start count) (declare (ignore fd))
                          (when (= pos cut) (error 'sb-posix:syscall-error :errno sb-posix:eio :name 'write))
                          (let ((n (min chunk count (- cut pos))))
                            (replace out data :start1 pos :start2 start :end2 (+ start n)) (incf pos n) n))
                        :flush (lambda (fd) (declare (ignore fd)) (incf flushes) 0)))
                 (log (crea-log-io file :segment 31 :version version)) (group (apply #'fixture-group log lots)))
            (if (< cut total) (progn (signals io-fault (scrivi-gruppo group :buffer (buffer total)))
                                    (append-check-fault group file))
                (progn (scrivi-gruppo group :buffer (buffer total)) (sincronizza-gruppo group)))
            (is (= pos cut (arcdocdb.io:posizione-scritta file))) (is (= flushes (if (= cut total) 1 0)))
            (is (not (mismatch out expected :end1 cut :end2 cut)))
            (multiple-value-bind (end state batches records)
                (arcdocdb.recovery.scan:scansiona-log out 0 cut 31 :version version :file-size cut)
              (let ((complete (count-if (lambda (limit) (<= limit cut)) ends)))
                (is (= end (if (zerop complete) 0 (nth (1- complete) ends)))) (is (= batches complete))
                (is (= records (if (= complete 3) 4 complete)))
                (is (eq state (if (or (zerop cut) (member cut ends)) :complete :tail)))))
            (arcdocdb.io:chiudi file)))))))

;;; REQ: REQ-WAL-006 REQ-AFF-001
(deftest test-REQ-AFF-001-buffered-hard-errors-no-fallback-or-flush
  (dolist (errno (list sb-posix:eio sb-posix:enospc sb-posix:eintr))
    (let* ((calls 0) (flushes 0) (file (fixture-file
             :writer (lambda (fd data start count) (declare (ignore fd data start count))
                       (incf calls) (if (= calls 1) 7 (error 'sb-posix:syscall-error :errno errno :name 'write)))
             :flush (lambda (fd) (declare (ignore fd)) (incf flushes) 0)))
           (log (crea-log-io file :segment 31)) (group (fixture-group log (fixture-lotto) (fixture-lotto :start 82))))
      (signals io-fault (scrivi-gruppo group :buffer (buffer 164)) :io-syscall)
      (is (= calls 2)) (is (zerop flushes)) (is (= 7 (arcdocdb.io:posizione-scritta file)))
      (append-check-fault group file) (signals invalid-argument (scrivi-gruppo group :buffer (buffer 164)))
      (is (= calls 2)) (arcdocdb.io:chiudi file))))

;;; REQ: REQ-WAL-006 REQ-AFF-001 REQ-AFF-004
(deftest test-REQ-AFF-004-all-append-exits-fault-and-preserve-primary-control
  (dolist (buffered '(nil t))
    (dolist (mode '(:error :throw))
      (let* ((primary (make-condition 'invalid-argument :reason :test-writer-exit))
             (file (fixture-file :writer (lambda (fd data start count) (declare (ignore fd data start count))
                     (if (eq mode :error) (error primary) (throw 'append-exit :same-control)))))
             (log (crea-log-io file :segment 31)) (group (fixture-group log (fixture-lotto) (fixture-lotto :start 82))))
        (is (eq (if (eq mode :error) primary :same-control)
                (catch 'append-exit (handler-case (scrivi-gruppo group :buffer (when buffered (buffer 164)))
                                     (invalid-argument (condition) condition)))))
        (append-check-fault group file) (is (eq :faulted (arcdocdb.io:stato-file file)))
        (arcdocdb.io:chiudi file)))))

