;;; REQ: REQ-WAL-002 REQ-WAL-006 REQ-AFF-004
(deftest test-REQ-AFF-004-acquisition-exit-faults-only-owned-group
  (dolist (acquired '(nil t))
    (dolist (buffered '(nil t))
      (let* ((calls 0) (file (fixture-file :writer (lambda (fd data start count)
                            (declare (ignore fd data start)) (incf calls) count)))
             (log (crea-log-io file :segment 31)) (group (fixture-group log (fixture-lotto) (fixture-lotto :start 82)))
             (original (symbol-function 'arcdocdb.wal::acquisisci-gruppo)))
        (unwind-protect
             (progn
               (setf (symbol-function 'arcdocdb.wal::acquisisci-gruppo)
                     (lambda (candidate) (when acquired (funcall original candidate)) (throw 'acquisition-exit :original)))
               (is (eq :original (catch 'acquisition-exit (scrivi-gruppo group :buffer (when buffered (buffer 164)))))))
          (setf (symbol-function 'arcdocdb.wal::acquisisci-gruppo) original))
        (is (zerop calls)) (is (eq :open (arcdocdb.io:stato-file file)))
        (if acquired (append-check-fault group file)
            (progn (is (eq :ready (stato-gruppo group))) (is (eq :open (stato-log log)))
                   (is (null (arcdocdb.wal::log-io-active log)))))
        (arcdocdb.io:chiudi file)))))

;;; REQ: REQ-WAL-002 REQ-WAL-006 REQ-AFF-001
(deftest test-REQ-AFF-001-buffered-shape-and-return-invariants-fault-before-confirmation
  (dolist (mode '(:contiguity :sum :return))
    (let* ((calls 0) (file (fixture-file :writer (lambda (fd data start count)
                          (declare (ignore fd data start)) (incf calls) count)))
           (log (crea-log-io file :segment 31)) (a (fixture-lotto)) (b (fixture-lotto :start 82))
           (group (fixture-group log a b)) (original (symbol-function 'arcdocdb.io:append-esatto)))
      (case mode (:contiguity (incf (arcdocdb.wal::lotto-start b)))
                 (:sum (incf (arcdocdb.wal::gruppo-bytes group))) (otherwise nil))
      (unwind-protect
           (progn
             (when (eq mode :return)
               (setf (symbol-function 'arcdocdb.io:append-esatto)
                     (lambda (handle data start end) (1- (funcall original handle data start end)))))
             (signals invariant-violation (scrivi-gruppo group :buffer (buffer 165))))
        (setf (symbol-function 'arcdocdb.io:append-esatto) original))
      (is (= calls (if (eq mode :return) 1 0)))
      (is (= (arcdocdb.io:posizione-scritta file) (if (eq mode :return) 164 0)))
      (is (eq :open (arcdocdb.io:stato-file file))) (append-check-fault group file)
      (arcdocdb.io:chiudi file))))
