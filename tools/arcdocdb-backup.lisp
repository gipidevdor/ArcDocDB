;;;; Offline M1 create/verify/compare/restore. No external Lisp reader, native helper or engine startup.
;;; REQ: REQ-AFF-014 REQ-AFF-010 REQ-VAL-001
(require :asdf)
(asdf:load-asd (merge-pathnames "../arcdocdb.asd" *load-truename*))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb"))

(defun backup-cli-uuid (text)
  (unless (= 32 (length text)) (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-uuid))
  (let ((result (make-array 16 :element-type '(unsigned-byte 8))))
    (labels ((digit (c)
               (let ((code (char-code c)))
                 (cond ((<= 48 code 57) (- code 48)) ((<= 65 code 70) (- code 55))
                       ((<= 97 code 102) (- code 87))
                       (t (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-uuid))))))
      (dotimes (i 16 result)
        (setf (aref result i) (+ (* 16 (digit (char text (* 2 i)))) (digit (char text (1+ (* 2 i))))))))))

(defun backup-cli-number (text)
  (unless (and (<= 1 (length text) 20) (every (lambda (c) (<= 48 (char-code c) 57)) text))
    (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-number))
  (parse-integer text :radix 10))

(defun backup-cli-options (arguments)
  (unless (and (evenp (length arguments)) (<= (length arguments) 10))
    (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-options))
  (let ((options nil) (seen nil))
    (loop for (flag value) on arguments by #'cddr do
      (let ((key (cond ((string= flag "--max-file-bytes") :max-file-bytes)
                       ((string= flag "--max-segments") :max-segments)
                       ((string= flag "--max-records") :max-records)
                       ((string= flag "--max-total-bytes") :max-total-bytes)
                       ((string= flag "--buffer-bytes") :buffer-bytes)
                       (t (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-option)))))
        (when (member key seen) (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-duplicate))
        (push key seen) (setf options (append options (list key (backup-cli-number value))))))
    options))

(defun backup-cli-arguments (arguments)
  (unless (<= 4 (length arguments) 15)
    (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-arguments))
  (let* ((mode (first arguments))
         (function (cond ((string= mode "create") #'arcdocdb.backup:crea-backup-m1)
                         ((string= mode "restore") #'arcdocdb.backup:ripristina-backup-m1)
                         ((string= mode "verify") #'arcdocdb.backup:verifica-backup-m1)
                         ((string= mode "compare") #'arcdocdb.backup:confronta-backup-m1)
                         (t (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-command))))
         (paths (if (string= mode "verify") 1 2)) (base (+ 3 paths)))
    (unless (>= (length arguments) base)
      (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-arguments))
    (let ((path-arguments (subseq arguments 1 (1+ paths))))
      (unless (every (lambda (path) (plusp (length path))) path-arguments)
        (error 'arcdocdb.conditions:invalid-argument :reason :backup-cli-path))
      (values function
              (append path-arguments (list (backup-cli-uuid (nth (1+ paths) arguments))
                                           (backup-cli-uuid (nth (+ 2 paths) arguments)))
                      (backup-cli-options (nthcdr base arguments)))))))

(defun backup-cli-condition (condition &optional (depth 0))
  (when condition
    (let ((basic (list :condition (princ-to-string (type-of condition))
                       :reason (when (typep condition 'arcdocdb.conditions:arcdocdb-error)
                                 (arcdocdb.conditions:error-reason condition))
                       :offset (when (typep condition 'arcdocdb.conditions:arcdocdb-error)
                                 (arcdocdb.conditions:error-offset condition)))))
      (when (typep condition 'arcdocdb.conditions:io-fault)
        (setf basic (append basic (list :operation (arcdocdb.conditions:error-operation condition)
                                       :errno (arcdocdb.conditions:error-errno condition)
                                       :cleanup-errno (arcdocdb.conditions:error-cleanup-errno condition)
                                       :transferred (arcdocdb.conditions:error-transferred condition)))))
      (if (>= depth 4) (append basic (list :nested-detail-truncated t))
          (cond ((typep condition 'arcdocdb.backup:backup-error)
                 (append basic (list :stage (arcdocdb.backup:backup-stage condition)
                   :file (arcdocdb.backup:backup-file condition) :published (arcdocdb.backup:backup-published condition)
                   :durable (arcdocdb.backup:backup-durable condition)
                   :primary (backup-cli-condition (arcdocdb.backup:backup-primary condition) (1+ depth))
                   :cleanup (mapcar (lambda (c) (backup-cli-condition c (1+ depth)))
                                   (arcdocdb.backup:backup-cleanup condition)))))
                ((typep condition 'arcdocdb.verify:verification-error)
                 (append basic (list :stage (arcdocdb.verify:verification-stage condition)
                   :file (arcdocdb.verify:verification-file condition)
                   :primary (backup-cli-condition (arcdocdb.verify:verification-primary condition) (1+ depth))
                   :cleanup (mapcar (lambda (c) (backup-cli-condition c (1+ depth)))
                                   (arcdocdb.verify:verification-cleanup condition)))))
                ((typep condition 'arcdocdb.recovery.manifest:recovery-sources-cleanup-error)
                 (append basic (list :count (arcdocdb.recovery.manifest:recovery-sources-cleanup-count condition)
                   :primary (backup-cli-condition (arcdocdb.recovery.manifest:recovery-sources-primary condition) (1+ depth))
                   :cleanup (backup-cli-condition (arcdocdb.recovery.manifest:recovery-sources-cleanup condition) (1+ depth)))))
                (t (append basic (list :diagnostic (princ-to-string condition)))))))))

(defun backup-cli-self-test ()
  (let ((checks 0) (uuid "49494949494949494949494949494949"))
    (labels ((check (value) (unless value (error "Backup CLI fixture failed.")) (incf checks))
             (reject (function)
               (check (handler-case (progn (funcall function) nil)
                        (arcdocdb.conditions:invalid-argument () t)))))
      (check (equalp (backup-cli-uuid uuid) (make-array 16 :element-type '(unsigned-byte 8) :initial-element 73)))
      (check (= 17179869184 (backup-cli-number "17179869184")))
      (dolist (text '("" "00" "4949494949494949494949494949494z")) (reject (lambda () (backup-cli-uuid text))))
      (dolist (text '("" "-1" "+2" " 2" "2.0" "123456789012345678901"))
        (reject (lambda () (backup-cli-number text))))
      (dolist (mode '("create" "restore" "compare"))
        (check (= 4 (length (nth-value 1 (backup-cli-arguments (list mode "/source/" "/target/" uuid uuid)))))))
      (check (= 5 (length (nth-value 1 (backup-cli-arguments
                                      (list "verify" "/backup/" uuid uuid "--max-segments" "16"))))))
      (dolist (tail '(("--unknown" "1") ("--buffer-bytes") ("--max-records" "1" "--max-records" "2")))
        (reject (lambda () (backup-cli-arguments (append (list "verify" "/backup/" uuid uuid) tail))))))
    (list :schema-version 1 :kind :backup-cli-self-test :status :ok :checks checks)))

(handler-case
    (let* ((arguments (uiop:command-line-arguments))
           (result (cond ((equal arguments '("--self-test")) (backup-cli-self-test))
                         ((equal arguments '("--help"))
                          (list :schema-version 1 :kind :backup-cli-help
                                :commands (list "create SOURCE NEWDEST ARCHIVE32 SERIES32"
                                                "verify BACKUP ARCHIVE32 SERIES32"
                                                "compare SOURCE BACKUP ARCHIVE32 SERIES32"
                                                "restore BACKUP NEWDEST ARCHIVE32 SERIES32")))
                         (t (multiple-value-bind (function args) (backup-cli-arguments arguments)
                              (apply function args))))))
      (write result :readably t :pretty t) (terpri)
      (sb-ext:exit :code (if (eq :different (getf result :status)) 2 0)))
  (error (condition)
    (write (list :schema-version 1 :kind :m1-offline-backup :status :failed :error (backup-cli-condition condition))
           :readably t :pretty t) (terpri)
    (sb-ext:exit :code 1)))
