;;;; Offline M1 canonical verifier. No recovery, repair or Lisp-reader input.
;;; REQ: REQ-AFF-010 REQ-AFF-008 REQ-VAL-001
(require :asdf)
(asdf:load-asd (merge-pathnames "../arcdocdb.asd" *load-truename*))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb"))

(defun verify-hex-digit (character)
  (let ((code (char-code character)))
    (cond ((<= 48 code 57) (- code 48)) ((<= 65 code 70) (- code 55))
          ((<= 97 code 102) (- code 87))
          (t (error 'arcdocdb.conditions:invalid-argument :reason :verify-cli-uuid)))))

(defun verify-uuid (text)
  (unless (= 32 (length text))
    (error 'arcdocdb.conditions:invalid-argument :reason :verify-cli-uuid))
  (let ((bytes (make-array 16 :element-type '(unsigned-byte 8))))
    (dotimes (i 16 bytes)
      (setf (aref bytes i) (+ (* 16 (verify-hex-digit (char text (* i 2))))
                             (verify-hex-digit (char text (1+ (* i 2)))))))))

(defun verify-decimal (text)
  (unless (and (<= 1 (length text) 10)
               (every (lambda (c) (<= 48 (char-code c) 57)) text))
    (error 'arcdocdb.conditions:invalid-argument :reason :verify-cli-budget))
  (parse-integer text :radix 10))

(defun verify-arguments (arguments)
  (unless (and (<= 3 (length arguments) 9) (oddp (length arguments))
               (plusp (length (first arguments))))
    (error 'arcdocdb.conditions:invalid-argument :reason :verify-cli-arguments))
  (let ((options nil) (seen nil))
    (loop for (flag value) on (cdddr arguments) by #'cddr do
      (let ((key (cond ((string= flag "--max-file-bytes") :max-file-bytes)
                       ((string= flag "--max-segments") :max-segments)
                       ((string= flag "--max-records") :max-records)
                       (t (error 'arcdocdb.conditions:invalid-argument :reason :verify-cli-option)))))
        (when (member key seen)
          (error 'arcdocdb.conditions:invalid-argument :reason :verify-cli-duplicate-option))
        (push key seen)
        (setf options (append options (list key (verify-decimal value))))))
    (append (list (first arguments) (verify-uuid (second arguments)) (verify-uuid (third arguments))) options)))

(defun verify-cli-self-test ()
  (let ((checks 0) (uuid "49494949494949494949494949494949"))
    (labels ((check (ok) (unless ok (error "Verifier CLI fixture failed.")) (incf checks))
             (reject (thunk)
               (check (handler-case (progn (funcall thunk) nil)
                        (arcdocdb.conditions:invalid-argument () t)))))
      (check (equalp (verify-uuid uuid) (make-array 16 :element-type '(unsigned-byte 8) :initial-element 73)))
      (check (equalp (verify-uuid "aAbBcCdDeEfF00112233445566778899")
                     #(170 187 204 221 238 255 0 17 34 51 68 85 102 119 136 153)))
      (dolist (text '("" "00" "4949494949494949494949494949494Z" "4949494949494949494949494949494949FF"))
        (reject (lambda () (verify-uuid text))))
      (dolist (text '("" "-1" "+2" "1e3" " 4" "12345678901"))
        (reject (lambda () (verify-decimal text))))
      (check (= 268435456 (verify-decimal "268435456")))
      (check (= 9 (length (verify-arguments (list "/fixture/" uuid uuid "--max-segments" "64"
                                                 "--max-records" "32" "--max-file-bytes" "8192")))))
      (dolist (tail '(("--unknown" "1") ("--max-records")
                      ("--max-records" "2" "--max-records" "3")))
        (reject (lambda () (verify-arguments (append (list "/fixture/" uuid uuid) tail))))))
    (list :schema-version 1 :kind :verify-cli-self-test :status :ok :checks checks)))

(defun verify-failure-data (condition)
  (let* ((wrapped (typep condition 'arcdocdb.verify:verification-error))
         (primary (if wrapped (arcdocdb.verify:verification-primary condition) condition))
         (typed (typep primary 'arcdocdb.conditions:arcdocdb-error)))
    (list :schema-version 1 :kind :m1-storage-verification :profile :m1-canonical :status :failed
          :stage (when wrapped (arcdocdb.verify:verification-stage condition))
          :file (when wrapped (arcdocdb.verify:verification-file condition))
          :condition (when primary (princ-to-string (type-of primary)))
          :reason (when typed (arcdocdb.conditions:error-reason primary))
          :offset (when typed (arcdocdb.conditions:error-offset primary))
          :diagnostic (when primary (princ-to-string primary))
          :inventory-actions (when wrapped (arcdocdb.verify:verification-actions condition))
          :cleanup-errors (when wrapped (mapcar #'princ-to-string (arcdocdb.verify:verification-cleanup condition))))))

(handler-case
    (let* ((args (uiop:command-line-arguments))
           (self-test (equal args '("--self-test")))
           (result (if self-test (verify-cli-self-test)
                       (apply #'arcdocdb.verify:verifica-storage-m1 (verify-arguments args)))))
      (write result :readably t :pretty t) (terpri)
      (sb-ext:exit :code (if (or self-test (eq :clean (getf result :status))) 0 2)))
  (error (condition)
    (write (verify-failure-data condition) :readably t :pretty t) (terpri)
    (sb-ext:exit :code 1)))
