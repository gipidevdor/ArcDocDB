;;;; C4: preserve declared notices in source and distribution artifacts.
;;;; This checks notice integrity, not legal compliance or dependency discovery.
(require :asdf)
(require :sb-posix)
(declaim (optimize (safety 3) (debug 2)))
(defpackage #:arcdocdb.legal.notices (:use #:cl))
(in-package #:arcdocdb.legal.notices)
(defparameter *root* (uiop:pathname-parent-directory-pathname
                     (uiop:pathname-directory-pathname *load-truename*)))

(defun text (path)
  (uiop:read-file-string path :external-format :utf-8))

(defun digest (path)
  (subseq (uiop:run-program (list "shasum" "-a" "256" "--" (namestring path))
                            :output :string) 0 64))

(defun data (path)
  (with-open-file (in path :external-format :utf-8)
    (when (> (file-length in) 1048576) (error "Notice metadata exceeds 1 MiB: ~A" path))
    (let ((*read-eval* nil))
      (let ((value (read in)))
        (unless (eq (read in nil :eof) :eof) (error "Extra notice metadata: ~A" path))
        value))))

(defun safe-path-p (path)
  (and (stringp path) (plusp (length path))
       (every (lambda (part)
                (and (plusp (length part)) (not (member part '("." "..") :test #'equal))
                     (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"))
                            part)))
              (uiop:split-string path :separator '(#\/)))))

(defun notice-files ()
  (let* ((inventory (data (merge-pathnames "legal/notice-files.lisp" *root*)))
         (files (getf inventory :files)))
    (unless (and (= (getf inventory :schema-version) 1)
                 (eq (getf inventory :kind) :distribution-notice-files)
                 (listp files) (<= 4 (length files) 64)
                 (every #'safe-path-p files)
                 (= (length files) (length (remove-duplicates files :test #'equalp)))
                 (every (lambda (name) (member name files :test #'equal))
                        '("LICENSE" "THIRD-PARTY-NOTICES.txt" "data/unicode/18.0.0/LICENSE.txt"
                          "legal/runtime/SBCL-2.6.9-COPYING.txt")))
      (error "Invalid distribution notice inventory."))
    files))

(defun check-sources ()
  (dolist (file (notice-files))
    (unless (probe-file (merge-pathnames file *root*)) (error "Missing notice: ~A" file)))
  (dolist (entry (getf (data (merge-pathnames "legal/notice-files.lisp" *root*)) :originals))
    (unless (and (member (getf entry :path) (notice-files) :test #'equal)
                 (equal (getf entry :sha256) (digest (merge-pathnames (getf entry :path) *root*))))
      (error "Original license changed without review: ~A" (getf entry :path))))
  (let ((unicode (text (merge-pathnames "data/unicode/18.0.0/LICENSE.txt" *root*)))
        (notices (text (merge-pathnames "THIRD-PARTY-NOTICES.txt" *root*))))
    (unless (and (search "UNICODE LICENSE V3" unicode)
                 (search "Copyright © 1991-2026 Unicode, Inc." unicode)
                 (search unicode notices))
      (error "Root notices must preserve the complete original Unicode notice.")))
  (dolist (file '("src/fulltext/unicode-tables.lisp" "tools/fulltext-unicode-tables.lisp"))
    (unless (search "Copyright © 1991-2026 Unicode, Inc." (text (merge-pathnames file *root*)))
      (error "Generated-table attribution missing or not reproducible: ~A" file)))
  (unless (search "BSD-2-Clause AND Unicode-3.0" (text (merge-pathnames "arcdocdb.asd" *root*)))
    (error "Aggregate system metadata omits the Unicode data terms."))
  (let* ((inventory (data (merge-pathnames "tools/pages/third-party-notices.lisp" *root*)))
         (collection (merge-pathnames "tools/pages/third-party-notices.txt" *root*)))
    (unless (equal (getf inventory :notices-sha256) (digest collection))
      (error "Browser notice collection differs from its inventory.")))
  t)

(defun file-records (root)
  (loop for file in (notice-files)
        for path = (merge-pathnames file root)
        for bytes = (with-open-file (in path :element-type '(unsigned-byte 8)) (file-length in))
        collect (list :path file :sha256 (digest path)
                      :bytes bytes)))

(defun expected-manifest ()
  (list :schema-version 1 :kind :distribution-notice-manifest :files (file-records *root*)
        :limits '(:notice-integrity-only :actual-runtime-not-attested
                  :additional-components-not-discovered :artifact-code-not-attested :not-legal-approval)))

(defun manifest-text ()
  (with-output-to-string (out)
    (write (expected-manifest) :stream out :readably t :pretty nil) (terpri out)))

(defun check-artifact (directory)
  (check-sources)
  (let ((root (uiop:ensure-directory-pathname directory)))
    ;; Never invoke the Lisp reader on artifact-controlled contents.
    (let ((path (merge-pathnames "legal-notices.lisp" root)))
      (with-open-file (in path)
        (when (> (file-length in) 1048576) (error "Artifact notice manifest exceeds its budget.")))
      (unless (equal (text path) (manifest-text))
        (error "Artifact notice manifest is missing, stale or incomplete.")))
    (dolist (entry (file-records *root*))
      (let ((path (merge-pathnames (getf entry :path) root)))
        (with-open-file (in path :element-type '(unsigned-byte 8))
          (unless (= (file-length in) (getf entry :bytes))
            (error "Artifact notice length differs: ~A" path)))
        (unless (equal (digest path) (getf entry :sha256))
          (error "Artifact notice differs: ~A" path)))))
  t)

(defun stage-new (directory)
  (check-sources)
  (let ((root (uiop:ensure-directory-pathname directory)))
    ;; mkdir, rather than a check followed by writes, refuses an existing name.
    ;; Partial output is retained on failure for inspection; it is never approved.
    (sb-posix:mkdir (namestring root) #o755)
    (dolist (file (notice-files))
      (let ((target (merge-pathnames file root)))
        (ensure-directories-exist target)
        (uiop:copy-file (merge-pathnames file *root*) target)))
    (with-open-file (out (merge-pathnames "legal-notices.lisp" root)
                         :direction :output :if-exists :error :external-format :utf-8)
      (write-string (manifest-text) out))
    (check-artifact root))
  t)

(defun self-test ()
  (let ((count 0))
    (flet ((check (truth) (incf count) (assert truth)))
      (dolist (path '("LICENSE" "data/unicode/18.0.0/LICENSE.txt")) (check (safe-path-p path)))
      (dolist (path '("" "../LICENSE" "/LICENSE" "a//b" "a/../b" "a/./b" "a\\b"))
        (check (not (safe-path-p path))))
      (uiop:with-temporary-file (:pathname marker :prefix "arcdocdb-legal-")
        (let* ((root (uiop:ensure-directory-pathname (concatenate 'string (namestring marker) "-notices/")))
               (license (merge-pathnames "LICENSE" root)) (owned nil))
          (unwind-protect
               (progn
                 (check (stage-new root)) (setf owned t) (check (check-artifact root))
                 (check (handler-case (progn (stage-new root) nil) (sb-posix:syscall-error () t)))
                 (check (check-artifact root))
                 (with-open-file (out license :direction :output :if-exists :supersede) (write-string "damaged" out))
                 (check (handler-case (progn (check-artifact root) nil) (simple-error () t)))
                 (uiop:copy-file (merge-pathnames "LICENSE" *root*) license)
                 (delete-file (merge-pathnames "data/unicode/18.0.0/LICENSE.txt" root))
                 (check (handler-case (progn (check-artifact root) nil) (file-error () t)))
                 (uiop:copy-file (merge-pathnames "data/unicode/18.0.0/LICENSE.txt" *root*)
                                 (merge-pathnames "data/unicode/18.0.0/LICENSE.txt" root))
                 (with-open-file (out (merge-pathnames "legal-notices.lisp" root)
                                      :direction :output :if-exists :supersede)
                   (write '(:schema-version 1 :files nil) :stream out))
                 (check (handler-case (progn (check-artifact root) nil) (simple-error () t))))
            (when owned (uiop:delete-directory-tree root :validate t))))))
    (format t "(:status :ok :kind :notice-integrity-self-test :checks ~D)~%" count)))

(defun main (args)
  (cond ((equal args '("--check"))
         (check-sources) (format t "(:status :ok :kind :notice-integrity :files ~D)~%" (length (notice-files))))
        ((equal args '("--self-test")) (self-test))
        ((and (= (length args) 2) (equal (first args) "--stage-new"))
         (stage-new (second args)) (format t "(:status :ok :kind :notice-staging :legal-approval nil)~%"))
        ((and (= (length args) 2) (equal (first args) "--check-artifact"))
         (check-artifact (second args)) (format t "(:status :ok :kind :artifact-notice-integrity :legal-approval nil)~%"))
        (t (error "Usage: --check | --self-test | --stage-new DIR | --check-artifact DIR"))))

(main (uiop:command-line-arguments))
