;;;; C4-only three-peer cohort and failure gate; actual product dispatch, sockets and strong I/O.
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(let ((*standard-output* *error-output*)) (asdf:load-system "arcdocdb/local"))
(let ((dispatch (symbol-function 'arcdocdb.local::dispatch-local-ready))
      (open (symbol-function 'arcdocdb.engine:apri-motore))
      (flush (symbol-function 'arcdocdb.io:durable-flush))
      (send (symbol-function 'arcdocdb.local::native-send-span))
      (mode (uiop:getenv "ARCDOCDB_DISJOINT_MODE"))
      (failure (uiop:getenv "ARCDOCDB_DISJOINT_FAILURE"))
      (armed nil) (strong nil) (slots nil) (flushes 0))
  (flet ((early-copy ()
           (unless (and (eq :response (arcdocdb.local::local-connection-state (aref slots 1)))
                        (zerop (arcdocdb.local::local-connection-written (aref slots 1))))
             (error "DISJOINT-EARLY-COPY missing"))))
    (setf (symbol-function 'arcdocdb.local::dispatch-local-ready)
          (lambda (engine connections clock queue)
            (let ((pending (count :pending connections :key #'arcdocdb.local::local-connection-state)))
              (when (or (zerop pending) (= pending 3))
                (when (= pending 3)
                  (unless (equal '(1 2 1) (loop for i below 3 collect
                    (arcdocdb.local:envelope-code (arcdocdb.local::local-connection-pending (aref connections i)))))
                    (error "DISJOINT-COHORT wrong order"))
                  (setf armed t slots connections))
                (funcall dispatch engine connections clock queue))))
          (symbol-function 'arcdocdb.io:durable-flush)
          (lambda (file)
            (when armed
              (early-copy)
              (when (equal failure "before")
                (error 'arcdocdb.conditions:io-fault :reason :disjoint-before-flush :operation :test)))
            (prog1 (funcall flush file) (when armed (incf flushes))))
          (symbol-function 'arcdocdb.local::native-send-span)
          (lambda (&rest args)
            (when (and armed (not strong)) (error "DISJOINT-SEND before strong"))
            (apply send args))
          (symbol-function 'arcdocdb.engine:apri-motore)
          (lambda (&rest args)
            (let* ((observer (getf (nthcdr 3 args) :observer))
                   (options (copy-list (nthcdr 3 args))))
              (setf (getf options :observer)
                    (lambda (engine phase)
                      (when observer (funcall observer engine phase))
                      (when (and armed (eq phase :after-flush))
                        (early-copy)
                        (unless (= 1 flushes) (error "DISJOINT-FLUSH count"))
                        (setf strong t)
                        (format *error-output* "DISJOINT-STRONG 2~%") (finish-output *error-output*)
                        (when (equal failure "after")
                          (error 'arcdocdb.conditions:io-fault :reason :disjoint-after-flush :operation :test))) nil))
              (let ((engine (apply open (append (subseq args 0 3) options))))
                (when (equal mode "paged")
                  (arcdocdb.engine:configura-budget-indice-motore engine
                    (getf (arcdocdb.engine:statistiche-indice-motore engine) :reserved-fixed))) engine))))
    (handler-case (arcdocdb.local::server-cli-main (uiop:command-line-arguments))
      (error (cause)
        (format *error-output* "DISJOINT-SERVER-FAIL ~A~%" cause) (finish-output *error-output*)
        (sb-ext:exit :code 1)))))
