(in-package #:arcdocdb.pages)

(defun output-files (directory)
  (append (uiop:directory-files directory)
          (mapcan #'output-files (uiop:subdirectories directory))))

(defun parse-json-file (path)
  (with-open-file (in path :external-format :utf-8) (yason:parse in)))

(defun page-links (nodes)
  "Retain strings, not DOM nodes and their parent trees, between page checks."
  (let ((links nil))
    (dolist (node nodes)
      (dolist (attribute '("href" "src"))
        (let ((value (plump:attribute node attribute))) (when value (push value links))))
      (let ((srcset (plump:attribute node "srcset")))
        (when srcset
          (dolist (item (uiop:split-string srcset :separator '(#\,)))
            (push (first (remove "" (uiop:split-string item :separator '(#\Space #\Tab)) :test #'equal)) links)))))
    links))

(defun verify-site (output)
  "Verify the emitted artifact, independently of its CommonDoc intermediate tree."
  (let ((errors nil) (checked 0) (documents (make-hash-table :test #'equal))
        (ids (make-hash-table :test #'equal))
        (manifest (parse-json-file (merge-pathnames "manifest.json" output)))
        (search (parse-json-file (merge-pathnames "search-index.json" output))))
    (flet ((failure (control &rest args) (push (apply #'format nil control args) errors)))
      (let* ((published (gethash "pages" manifest))
             (sources (source-files))
             (listed (mapcar (lambda (entry) (gethash "source" entry)) published))
             (hashes (source-hashes)))
        (unless (and (= (length sources) (length listed))
                     (null (set-exclusive-or sources listed :test #'equal)))
          (failure "Documentation coverage differs from the source inventory."))
        (unless (and (= (length sources) (length search))
                     (null (set-exclusive-or sources (mapcar (lambda (p) (gethash "path" p)) search) :test #'equal)))
          (failure "Search coverage differs from the source inventory."))
        (dolist (entry published)
          (unless (equal (gethash "sha256" entry) (gethash (gethash "source" entry) hashes))
            (failure "Source changed during build: ~A" (gethash "source" entry)))
          (unless (probe-file (merge-pathnames (gethash "url" entry) output))
            (failure "Missing published page: ~A" (gethash "url" entry)))))
      (dolist (file (output-files output))
        (when (equal (pathname-type file) "html")
          (let* ((name (enough-namestring file output)) (tree (plump:parse (read-text file)))
                 (nodes (elements tree)) (page-ids (make-hash-table :test #'equal))
                 (h1 0) (main 0) (language nil) (canonical nil))
            (dolist (node nodes)
              (let ((tag (plump:tag-name node)) (id (plump:attribute node "id")))
                (when (equal tag "h1") (incf h1))
                (when (equal tag "main") (incf main))
                (when (equal tag "html") (setf language (plump:attribute node "lang")))
                (when (and (equal tag "link") (equal (plump:attribute node "rel") "canonical"))
                  (setf canonical (plump:attribute node "href")))
                (when id
                  (when (gethash id page-ids) (failure "Duplicate ID in ~A: ~A" name id))
                  (setf (gethash id page-ids) t))))
            (unless (and (= h1 1) (= main 1) (equal language "en") canonical)
              (failure "Invalid page structure in ~A (h1=~D, main=~D, lang=~S)." name h1 main language))
            (dolist (issue (editorial-page-issues name nodes)) (failure "~A" issue))
            (setf (gethash name documents) (page-links nodes) (gethash name ids) page-ids))))
      (maphash
       (lambda (name links)
         (dolist (target links)
               (unless (or (null target) (cl-ppcre:scan "^[a-zA-Z][a-zA-Z0-9+.-]*:" target)
                           (uiop:string-prefix-p "//" target))
                 (incf checked)
                 (cond ((uiop:string-prefix-p "/" target)
                        (failure "Nonportable root-relative link in ~A: ~A" name target))
                       (t
                        (let* ((uri (quri:uri target))
                               (path (quri:uri-path uri))
                               (fragment (quri:uri-fragment uri))
                               (destination (if (or (null path) (equal path "")) name
                                                (normalized-path (decode-url-part path) name))))
                          (cond ((not (probe-file (merge-pathnames destination output)))
                                 (failure "Broken local link in ~A: ~A" name target))
                                ((and (equal (pathname-type destination) "html") fragment
                                      (not (gethash (decode-url-part fragment) (gethash destination ids))))
                                 (failure "Missing anchor in ~A: ~A" name target)))))))))
       documents)
      (let ((sitemap (plump:parse (read-text (merge-pathnames "sitemap.xml" output)))))
        (unless (= (count "url" (elements sitemap) :key #'plump:tag-name :test #'equal)
                   (1- (hash-table-count documents)))
          (failure "Sitemap coverage differs from the emitted pages.")))
      (unless (probe-file (merge-pathnames ".nojekyll" output)) (failure "Missing .nojekyll marker."))
      (verify-publication-copies output)
      (let ((pairs (verify-palette output)))
        (format t "Editorial artifact checks: ~D declared contrast pairs; ~D exact license/notice copies.~%"
                pairs (length *publication-copies*)))
      (when (plusp (length (uiop:run-program (list "find" (namestring output) "-type" "l") :output :string)))
        (failure "Pages artifacts may not contain symlinks."))
      (when errors
        (dolist (error (reverse errors)) (format *error-output* "~A~%" error))
        (error "Documentation verification failed: ~D errors." (length errors)))
      (format t "Documentation verified: ~D source documents, ~D HTML pages, ~D local links and anchors, zero errors.~%"
              (length (gethash "pages" manifest)) (hash-table-count documents) checked))))

(defun verify-publication-gates (output)
  "Prove that publication rejects damaged artifacts, restoring each fixture."
  (let ((count 0))
    (labels ((reject (name damaged)
               (let* ((path (merge-pathnames name output)) (original (read-text path)))
                 (unwind-protect
                      (progn
                        (write-text path damaged)
                        (let ((*error-output* (make-string-output-stream))
                              (*standard-output* (make-string-output-stream)))
                          (unless (handler-case (progn (verify-site output) nil) (error () t))
                            (error "Publication gate accepted damaged fixture: ~A" name)))
                        (incf count))
                   (write-text path original)))))
      (let ((home (read-text (merge-pathnames "index.html" output))))
        (reject "index.html" (cl-ppcre:regex-replace "</main>" home "<a href=\"library.html#missing-publication-anchor\">Broken anchor</a></main>"))
        (reject "index.html" (cl-ppcre:regex-replace "</main>" home "<span id=\"main\"></span></main>")))
      (reject "search-index.json" "[]")
      (reject "manifest.json" "{\"pages\":[]}")
      (let* ((path (merge-pathnames "manifest.json" output)) (manifest (parse-json-file path)))
        (setf (gethash "sha256" (first (gethash "pages" manifest))) (make-string 64 :initial-element #\0))
        (reject "manifest.json" (json manifest)))
      (reject "licenses/ArcDocDB-BSD-2-Clause.txt" "Damaged license text")
      (reject "licenses/third-party-notices.txt" "Missing third-party notice text")
      (reject "index.html" (cl-ppcre:regex-replace "form-action 'none'" (read-text (merge-pathnames "index.html" output)) "form-action 'self'"))
      (reject "static/site.css" (cl-ppcre:regex-replace "--quiet: #6e6e73" (read-text (merge-pathnames "static/site.css" output)) "--quiet: #d2d2d7")))
    (format t "Documentation publication gates: ~D damaged artifacts rejected and restored.~%" count)))
