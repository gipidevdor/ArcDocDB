;;;; Source-derived reference pages, emitted through the CommonDoc Codex template.
(in-package #:arcdocdb.pages)

(defun code-package-for (name)
  (or (find name *code-packages* :key #'code-package-name :test #'equal)
      (error "Unknown source package: ~A" name)))

(defun code-public-p (entry)
  (member (code-entry-name entry) (code-package-exports (code-package-for (code-entry-package entry))) :test #'equal))

(defun code-file-route (file)
  (concatenate 'string "api/" (subseq file 4 (- (length file) 5)) ".html"))

(defun code-package-route (name) (format nil "api/packages/~A.html" name))
(defun code-anchor-component (text)
  (with-output-to-string (out)
    (loop for char across text do
      (if (or (find char "abcdefghijklmnopqrstuvwxyz0123456789-")
              (find char "ABCDEFGHIJKLMNOPQRSTUVWXYZ"))
          (write-char (char-downcase char) out)
          (write-string (string-downcase (format nil "_~X_" (char-code char))) out)))))

(defun code-entry-anchor (entry)
  (format nil "definition-~A-~A-~A~{_if_~A~}"
          (code-anchor-component (code-entry-package entry))
          (code-anchor-component (code-entry-kind entry))
          (code-anchor-component (code-entry-name entry))
          (mapcar #'code-anchor-component (code-entry-condition entry))))
(defun code-entry-url (entry)
  (format nil "~A#~A" (code-file-route (code-entry-file entry)) (code-entry-anchor entry)))
(defun code-source-link (entry)
  (format nil "~A#L~D" (source-url (code-entry-file entry)) (code-entry-line entry)))

(defun code-option (name options)
  (find name options :key #'code-head :test #'equal))

(defun add-generated-code (parent name kind signature description)
  (when (and name (not (equal name "nil")))
    (unless (find-if (lambda (entry) (and (equal (code-entry-package entry) (code-entry-package parent))
                                         (equal (code-entry-name entry) name))) *code-entries*)
      (let ((entry (copy-code-entry parent)))
        (setf (code-entry-name entry) name (code-entry-kind entry) kind
              (code-entry-signature entry) signature (code-entry-declaration entry) nil
              (code-entry-doc entry) description (code-entry-doc-start entry) nil (code-entry-doc-end entry) nil
              (code-entry-generated entry) parent)
        (when (code-public-p entry) (push entry *code-entries*))))))

(defun collect-generated-code ()
  "Resolve exported DEFSTRUCT operations and condition readers to their source declarations."
  (dolist (entry (copy-list *code-entries*))
    (let* ((items (code-items (code-entry-form entry))) (name (code-entry-name entry)))
      (cond
        ((equal (code-entry-kind entry) "defstruct")
         (let* ((options (rest (code-items (second items))))
                (slots (remove-if-not (lambda (slot) (member (code-token-kind slot) '(:list :atom))) (cddr items)))
                (conc-option (code-option "conc-name" options))
                (conc-name (if conc-option (code-name (second (code-items conc-option))) (concatenate 'string name "-")))
                (constructors (remove-if-not (lambda (option) (equal (code-head option) "constructor")) options))
                (text (read-text (merge-pathnames (code-entry-file entry) *root*))))
           (if constructors
               (dolist (constructor constructors)
                 (add-generated-code entry (code-name (second (code-items constructor))) "generated constructor"
                                     (code-spelling (third (code-items constructor)) text)
                                     (format nil "Construct an instance of ~A. The source DEFSTRUCT declaration governs the arguments and valid state; any explicit constructor lambda list is shown above." name)))
               (add-generated-code entry (concatenate 'string "make-" name) "generated constructor" nil
                                   (format nil "Keyword constructor generated by DEFSTRUCT for ~A. Keyword arguments correspond to the declared and inherited slots; see the structure contract." name)))
           (dolist (operation '(("predicate" "-p" "Predicate") ("copier" "copy-" "Shallow copier")))
             (let* ((option (code-option (first operation) options))
                    (generated-name (if option (code-name (second (code-items option)))
                                        (if (equal (first operation) "predicate")
                                            (concatenate 'string name (second operation))
                                            (concatenate 'string (second operation) name)))))
               (add-generated-code entry generated-name (concatenate 'string "generated " (first operation)) "(object)"
                                   (format nil "~A generated by DEFSTRUCT for ~A." (third operation) name))))
           (dolist (slot slots)
             (let ((slot-name (code-name (if (eq (code-token-kind slot) :list) (first (code-items slot)) slot))))
               (when (and conc-name (not (equal conc-name "nil")))
                 (add-generated-code entry (concatenate 'string conc-name slot-name) "generated accessor" "(instance)"
                                     (format nil "Return the ~A slot of ~A. The source slot declaration specifies its type and whether it is read-only; the structure contract governs access." slot-name name)))))))
        ((member (code-entry-kind entry) '("define-condition" "defclass") :test #'equal)
         (dolist (slot (code-items (fourth items)))
           (loop for (key value) on (rest (code-items slot)) by #'cddr do
             (when (member (code-name key) '("reader" "accessor") :test #'equal)
               (add-generated-code entry (code-name value) "generated reader" "(instance)"
                                   (format nil "Return the ~A slot declared by ~A." (code-name (first (code-items slot))) name))))))))))

(defun code-export-bindings (package name &optional seen)
  (when (member package seen :test #'equal) (error "Cyclic source re-export: ~A:~A" package name))
  (or (remove-if-not (lambda (entry) (and (equal (code-entry-package entry) package)
                                         (equal (code-entry-name entry) name))) *code-entries*)
      (let ((import (assoc name (code-package-imports (code-package-for package)) :test #'equal)))
        (when import (code-export-bindings (cdr import) name (cons package seen))))))

(defun code-reference-inventory ()
  (let* ((files (code-source-files)) (hashes (hashes-for-files files)))
    (collect-code-inventory)
    (unless (and (equal files *code-files*) (equalp hashes (hashes-for-files *code-files*)))
      (error "Lisp source changed during reference extraction."))
    (setf *code-source-hashes* hashes))
  (collect-generated-code)
  (setf *code-entries* (sort *code-entries*
                            (lambda (left right)
                              (or (string< (code-entry-file left) (code-entry-file right))
                                  (and (equal (code-entry-file left) (code-entry-file right))
                                       (or (< (code-entry-line left) (code-entry-line right))
                                           (and (= (code-entry-line left) (code-entry-line right))
                                                (string< (code-entry-name left) (code-entry-name right)))))))))
  (let ((missing nil))
    (dolist (package *code-packages*)
      (dolist (name (code-package-exports package))
        (unless (code-export-bindings (code-package-name package) name)
          (push (format nil "~A:~A" (code-package-name package) name) missing))))
    (when missing (error "Exported symbols without source definitions:~%~{~A~%~}" (sort missing #'string<)))))

(defun code-kind-label (entry)
  (or (cdr (assoc (code-entry-kind entry)
                 '(("defun" . "Function") ("defmacro" . "Macro") ("defstruct" . "Structure")
                   ("deftype" . "Type") ("define-condition" . "Condition") ("defconstant" . "Constant")
                   ("defparameter" . "Parameter") ("defvar" . "Variable")
                   ("sb-alien:define-alien-routine" . "Foreign routine declaration")
                   ("sb-alien:define-alien-type" . "Foreign type declaration")
                   ("sb-c:defknown" . "SBCL compiler declaration") ("sb-c:define-vop" . "SBCL VOP")) :test #'equal))
      (string-capitalize (code-entry-kind entry))))

(defun code-display (entry) (format nil "~A:~A" (code-entry-package entry) (code-entry-name entry)))

(defun code-direct-conditions (entry)
  (let ((conditions nil))
    (labels ((walk (token)
               (when (eq (code-token-kind token) :list)
                 (let* ((items (code-items token)) (head (code-head token))
                        (argument (if (equal head "cerror") (third items) (second items))))
                   (when (member head '("error" "cerror" "signal" "warn") :test #'equal)
                     (cond ((and argument (eq (code-token-kind argument) :prefix)
                                 (equal (code-token-text argument) "'"))
                            (pushnew (code-name (first (code-items argument))) conditions :test #'equal))
                           ((and argument (eq (code-token-kind argument) :string))
                            (pushnew (if (equal head "warn") "simple-warning" "simple-error") conditions :test #'equal))))
                   (mapc #'walk items)))))
      (unless (code-entry-generated entry) (walk (code-entry-form entry))))
    (sort conditions #'string<)))

(defun code-definition-content (entry)
  (with-output-to-string (out)
    (format out "<section class=\"api-definition\" id=\"~A\"><p class=\"eyebrow\">~A · ~A</p><h2><code>~A</code></h2>"
            (h (code-entry-anchor entry)) (h (code-kind-label entry))
            (if (code-public-p entry) "Exported" "Internal") (h (code-entry-name entry)))
    (format out "<p class=\"api-qualified\"><code>~A</code> · <a href=\"~A\">Source, line ~D ↗</a></p>"
            (h (code-display entry)) (h (code-source-link entry)) (code-entry-line entry))
    (dolist (condition (code-entry-condition entry))
      (format out "<p>Reader conditional: <code>~A</code>. This is a source variant, not a claim that it is active on this platform.</p>" (h condition)))
    (let ((signature (code-entry-signature entry)))
      (when signature
        (if (> (length signature) 4096)
            (write-string "<p>This source form is too large to repeat here; it remains available in the linked definition.</p>" out)
            (format out "<pre><code>~A</code></pre>" (h signature)))))
    (when (code-entry-declaration entry)
      (format out "<details><summary>Declared function type</summary><pre><code>~A</code></pre></details>"
              (h (code-entry-declaration entry))))
    (when (and (not (code-entry-generated entry))
               (member (code-entry-kind entry) '("defstruct" "deftype" "define-condition" "defclass") :test #'equal))
      (let* ((items (code-items (code-entry-form entry)))
             (text (read-text (merge-pathnames (code-entry-file entry) *root*)))
             (declarations (cond ((equal (code-entry-kind entry) "defstruct")
                                  (remove-if-not (lambda (token) (member (code-token-kind token) '(:list :atom))) (cddr items)))
                                 ((equal (code-entry-kind entry) "deftype")
                                  (remove-if (lambda (token) (eq (code-token-kind token) :string)) (cdddr items)))
                                 (t (code-items (fourth items))))))
        (when declarations
          (write-string "<details><summary>Source type and slot declarations</summary>" out)
          (dolist (declaration declarations)
            (format out "<pre><code>~A</code></pre>" (h (code-spelling declaration text))))
          (write-string "</details>" out))))
    (cond ((code-entry-doc entry) (format out "<div class=\"api-contract\">~A</div>" (h (code-entry-doc entry))))
          ((member (code-entry-kind entry) '("defconstant" "defparameter" "defvar") :test #'equal)
           (write-string "<p>The linked source defines this binding. No separate prose contract is declared.</p>" out))
          ((equal (code-entry-kind entry) "deftype")
           (write-string "<p>The type expansion is defined in the linked source. No separate prose contract is declared.</p>" out))
          (t (write-string "<p>No docstring is declared for this definition. Inspect the source and its surrounding module contract before using it.</p>" out)))
    (let ((conditions (code-direct-conditions entry)))
      (when conditions
        (write-string "<details><summary>Direct condition signals</summary><ul>" out)
        (dolist (condition conditions) (format out "<li><code>~A</code></li>" (h condition)))
        (write-string "</ul><p>These condition types appear directly in the source definition. Calls, callbacks and re-signaling can propagate additional conditions; this list is not a complete error contract.</p></details>" out)))
    (when (code-entry-generated entry)
      (format out "<p>Generated from <a href=\"~A\"><code>~A</code></a>.</p>"
              (h (relative-url (code-entry-url (code-entry-generated entry))))
              (h (code-display (code-entry-generated entry)))))
    (write-string "</section>" out)))

(defun code-file-content (file)
  (with-output-to-string (out)
    (format out "<h1>~A</h1><p>Source-derived reference for the definitions in this file. Exported bindings and internal implementation details retain their distinct scope. Preconditions, postconditions and error behavior are reproduced from the source docstrings.</p>" (h file))
    (format out "<p><a href=\"~A\">View the complete Lisp source ↗</a> · <a href=\"~A\">All code</a></p>"
            (h (source-url file)) (h (relative-url "api/index.html")))
    (dolist (package (remove-if-not (lambda (package) (equal (code-package-file package) file)) *code-packages*))
      (format out "<h2>Package <code>~A</code></h2><p><a href=\"~A\">Exported symbols and their definitions</a></p>"
              (h (code-package-name package)) (h (relative-url (code-package-route (code-package-name package))))))
    (dolist (entry (remove-if-not (lambda (entry) (equal (code-entry-file entry) file)) *code-entries*))
      (write-string (code-definition-content entry) out))))

(defun code-package-content (package)
  (with-output-to-string (out)
    (format out "<h1>~A</h1><p>Symbols exported by this package's source declaration. An export identifies a package boundary; it does not, by itself, qualify an API for concurrent use or production.</p>" (h (code-package-name package)))
    (when (code-package-documentation package) (format out "<p>~A</p>" (h (code-package-documentation package))))
    (format out "<p><a href=\"~A#L~D\">Package declaration ↗</a> · <a href=\"~A\">Code reference</a></p>"
            (h (source-url (code-package-file package))) (code-package-line package) (h (relative-url "api/index.html")))
    (write-string "<table><caption>Exported bindings</caption><thead><tr><th scope=\"col\">Symbol</th><th scope=\"col\">Kind and source definitions</th></tr></thead><tbody>" out)
    (dolist (name (sort (copy-list (code-package-exports package)) #'string<))
      (format out "<tr><td><code>~A</code></td><td>" (h name))
      (dolist (entry (code-export-bindings (code-package-name package) name))
        (format out "<a href=\"~A\">~A · ~A:~D</a><br>" (h (relative-url (code-entry-url entry)))
                (h (code-kind-label entry)) (h (code-entry-file entry)) (code-entry-line entry)))
      (write-string "</td></tr>" out))
    (write-string "</tbody></table>" out)))

(defun code-index-content ()
  (with-output-to-string (out)
    (format out "<h1>The code reference.</h1><p>~D Lisp source files. ~D packages. ~D source definitions and exported generated bindings. Signatures, declared types, contracts and source locations are extracted from the source files recorded in this edition's manifest.</p>"
            (length *code-files*) (length *code-packages*) (length *code-entries*))
    (format out "<p>Both branches of reader conditionals are inventoried. This static reference does not start the server, execute reader evaluation or imply runtime qualification. See <a href=\"~A\">how the reference is generated and verified</a>.</p>" (h (page-url "docs/code-reference.md")))
    (write-string "<h2 id=\"package-interfaces\">Package interfaces</h2><ul>" out)
    (dolist (package *code-packages*)
      (format out "<li><a href=\"~A\"><code>~A</code></a> · ~D exports</li>"
              (h (relative-url (code-package-route (code-package-name package))))
              (h (code-package-name package)) (length (code-package-exports package))))
    (write-string "</ul><h2 id=\"source-files\">Source files</h2><ul>" out)
    (dolist (file *code-files*)
      (format out "<li><a href=\"~A\"><code>~A</code></a></li>" (h (relative-url (code-file-route file))) (h file)))
    (write-string "</ul>" out)))

(defun prepare-code-pages ()
  (code-reference-inventory)
  (let ((pages (append (list (make-page :route "api/index.html" :title "Code reference" :group "code" :kind :code))
                       (loop for package in *code-packages* collect
                         (make-page :route (code-package-route (code-package-name package))
                                    :title (code-package-name package) :group "code" :kind :code :data package))
                       (loop for file in *code-files* collect
                         (make-page :route (code-file-route file) :title file :group "code" :kind :code :data file)))))
    (dolist (page pages)
      (let* ((*current-page* page)
             (html (cond ((typep (page-data page) 'code-package) (code-package-content (page-data page)))
                         ((page-data page) (code-file-content (page-data page)))
                         (t (code-index-content))))
             (tree (plump:parse html)))
        (setf (page-html page) html (page-text page) (plain (plump:text tree))
              (page-headings page)
              (cond ((stringp (page-data page))
                     (loop for entry in *code-entries* when (equal (code-entry-file entry) (page-data page))
                           collect (list (code-entry-anchor entry) (code-entry-name entry) "h2")))
                    ((null (page-data page)) '(("package-interfaces" "Package interfaces" "h2") ("source-files" "Source files" "h2"))))
              (page-description page) (format nil "Source-derived Common Lisp reference: ~A. Signatures, contracts, exported bindings and source locations." (page-title page)))))
    pages))

(defun code-manifest ()
  (let ((hashes (hashes-for-files *code-files*)))
  (unless (equalp hashes *code-source-hashes*) (error "Lisp source changed after reference extraction."))
  (object "files" (loop for file in *code-files* collect
                    (object "source" file "sha256" (gethash file hashes) "url" (code-file-route file)))
          "packages" (loop for package in *code-packages* collect
                       (object "name" (code-package-name package) "url" (code-package-route (code-package-name package))
                               "exports" (loop for name in (code-package-exports package) collect
                                           (object "name" name "definitions" (mapcar #'code-entry-url (code-export-bindings (code-package-name package) name))))))
          "definitions" (loop for entry in *code-entries* collect
                          (object "package" (code-entry-package entry) "name" (code-entry-name entry) "kind" (code-entry-kind entry)
                                  "source" (code-entry-file entry) "line" (code-entry-line entry) "url" (code-entry-url entry)
                                  "documentation" (code-entry-doc entry))))))
