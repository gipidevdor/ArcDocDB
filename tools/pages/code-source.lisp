;;;; Static Lisp source inventory. Never interns symbols, reads forms or evaluates code.
(in-package #:arcdocdb.pages)

(defstruct code-token kind text start end children)
(defstruct code-entry package name kind file line signature declaration doc doc-start doc-end form condition generated)
(defstruct code-package name file line exports imports documentation doc-start doc-end)
(defvar *code-entries*)
(defvar *code-packages*)
(defvar *code-files*)
(defvar *code-source-hashes*)

(defun tokenize-code (text)
  "Parse source syntax while retaining offsets and both reader-conditional branches."
  (let ((i 0) (n (length text)))
    (labels ((peek (&optional (offset 0)) (when (< (+ i offset) n) (char text (+ i offset))))
             (spacep (c) (and c (find c '(#\Space #\Tab #\Newline #\Return #\Page))))
             (delimiterp (c) (or (null c) (spacep c) (find c "();\"'`,")))
             (skip ()
               (loop do
                 (cond ((spacep (peek)) (incf i))
                       ((eql (peek) #\;) (loop while (and (peek) (not (eql (peek) #\Newline))) do (incf i)))
                       ((and (eql (peek) #\#) (eql (peek 1) #\|))
                        (incf i 2)
                        (loop with depth = 1 while (plusp depth) do
                          (cond ((null (peek)) (error "Unterminated Lisp block comment at ~D." i))
                                ((and (eql (peek) #\#) (eql (peek 1) #\|)) (incf depth) (incf i 2))
                                ((and (eql (peek) #\|) (eql (peek 1) #\#)) (decf depth) (incf i 2))
                                (t (incf i)))))
                       (t (return)))))
             (node (kind start &optional value children)
               (make-code-token :kind kind :text (or value (subseq text start i))
                                :start start :end i :children children))
             (next (depth)
               (when (> depth 256) (error "Lisp source nesting exceeds documentation budget."))
               (skip)
               (when (= i n) (return-from next nil))
               (let ((start i) (c (peek)))
                 (cond
                   ((eql c #\() (incf i)
                    (let ((children nil))
                      (loop (skip) (when (null (peek)) (error "Unterminated Lisp list at ~D." start))
                            (when (eql (peek) #\)) (incf i) (return))
                            (push (next (1+ depth)) children))
                      (node :list start nil (nreverse children))))
                   ((eql c #\)) (error "Unexpected closing Lisp parenthesis at ~D." i))
                   ((eql c #\") (incf i)
                    (let ((value (with-output-to-string (out)
                                   (loop (when (null (peek)) (error "Unterminated Lisp string at ~D." start))
                                         (when (eql (peek) #\") (incf i) (return))
                                         (when (eql (peek) #\\) (incf i)
                                           (unless (peek) (error "Unterminated Lisp escape at ~D." i)))
                                         (write-char (peek) out) (incf i)))))
                      (node :string start value)))
                   ((or (find c "'`,")
                        (and (eql c #\#) (find (or (peek 1) #\Space) "'.+-")))
                    (if (eql c #\#) (incf i 2) (incf i))
                    (when (and (eql c #\,) (eql (peek) #\@)) (incf i))
                    (let* ((prefix (subseq text start i))
                           (children (loop repeat (if (member prefix '("#+" "#-") :test #'equal) 2 1)
                                           collect (or (next (1+ depth)) (error "Missing Lisp prefix operand.")))))
                      (node :prefix start prefix children)))
                   ((and (eql c #\#) (eql (peek 1) #\())
                    (incf i) (node :prefix start "#" (list (next (1+ depth)))))
                   ((and (eql c #\#) (eql (peek 1) #\\))
                    (incf i 2) (unless (peek) (error "Missing Lisp character literal.")) (incf i)
                    (loop until (delimiterp (peek)) do (incf i)) (node :atom start))
                   (t
                    (loop with escaped = nil with bar = nil while (peek) do
                      (let ((current (peek)))
                        (when (and (not escaped) (not bar) (delimiterp current)) (return))
                        (cond (escaped (setf escaped nil))
                              ((eql current #\\) (setf escaped t))
                              ((eql current #\|) (setf bar (not bar)))) (incf i))
                      finally (when (or escaped bar) (error "Unterminated Lisp symbol at ~D." start)))
                    (when (= i start) (error "Unrecognized Lisp source at ~D." i))
                    (node :atom start))))))
      (loop for token = (next 0) while token collect token))))

(defun code-items (token) (when token (code-token-children token)))
(defun code-name (token)
  (when token
    (let ((text (code-token-text token)))
      (string-downcase (cond ((uiop:string-prefix-p "#:" text) (subseq text 2))
                             ((uiop:string-prefix-p ":" text) (subseq text 1))
                             (t text))))))
(defun code-head (token) (when (eq (code-token-kind token) :list) (code-name (first (code-items token)))))
(defun code-spelling (token text) (when token (subseq text (code-token-start token) (code-token-end token))))
(defun code-documentation-option (items)
  (second (code-items (find "documentation" items :key #'code-head :test #'equal))))

(defun code-body-docstring (items)
  (loop for tail on items for item = (first tail) do
    (cond ((eq (code-token-kind item) :string) (return (and (rest tail) item)))
          ((not (equal (code-head item) "declare")) (return nil)))))

(defun code-source-files ()
  (sort (remove "" (uiop:split-string
                    (git "ls-files" "--cached" "--others" "--exclude-standard" "--" "src/*.lisp" "src/**/*.lisp")
                    :separator '(#\Newline)) :test #'equal) #'string<))

(defun scan-code-file (file &optional (contents nil contents-p))
  (let* ((text (if contents-p contents (read-text (merge-pathnames file *root*)))) (package nil)
         (entries nil) (packages nil) (declarations (make-hash-table :test #'equal)))
    (labels ((visit (token condition)
               (let* ((items (code-items token)) (head (code-head token)))
                 (cond
                   ((and (eq (code-token-kind token) :prefix)
                         (member (code-token-text token) '("#+" "#-") :test #'equal))
                    (visit (second items) (append condition (list (format nil "~A~A" (code-token-text token)
                                                                         (code-spelling (first items) text))))))
                   ((equal head "in-package") (setf package (code-name (second items))))
                   ((equal head "declaim")
                    (dolist (declaration (rest items))
                      (when (equal (code-head declaration) "ftype")
                        (dolist (name (cddr (code-items declaration)))
                          (setf (gethash (code-name name) declarations)
                                (code-spelling (second (code-items declaration)) text))))))
                   ((member head '("progn" "eval-when" "locally") :test #'equal)
                    (mapc (lambda (item) (visit item condition)) (nthcdr (if (equal head "eval-when") 2 1) items)))
                   ((equal head "defpackage")
                    (let ((name (code-name (second items))) (exports nil) (imports nil))
                      (dolist (option (cddr items))
                        (let ((values (rest (code-items option))))
                          (cond ((equal (code-head option) "export") (setf exports (append exports (mapcar #'code-name values))))
                                ((member (code-head option) '("import-from" "shadowing-import-from") :test #'equal)
                                 (dolist (symbol (rest values))
                                   (push (cons (code-name symbol) (code-name (first values))) imports))))))
                      (push (make-code-package :name name :file file :line (1+ (count #\Newline text :end (code-token-start token)))
                                               :exports exports :imports imports
                                               :documentation (let ((doc (code-documentation-option (cddr items))))
                                                                (when doc (code-token-text doc)))
                                               :doc-start (let ((doc (code-documentation-option (cddr items))))
                                                            (when doc (code-token-start doc)))
                                               :doc-end (let ((doc (code-documentation-option (cddr items))))
                                                          (when doc (code-token-end doc)))) packages)))
                   ((member head '("defun" "defmacro" "define-setf-expander" "deftype" "defstruct" "defclass"
                                   "define-condition" "defgeneric" "defmethod" "defvar" "defparameter" "defconstant"
                                   "sb-alien:define-alien-routine" "sb-alien:define-alien-type" "sb-c:defknown" "sb-c:define-vop") :test #'equal)
                    (let* ((name-token (second items))
                           (name (if (eq (code-token-kind name-token) :list)
                                     (if (equal (code-name (first (code-items name-token))) "setf")
                                         (format nil "(setf ~A)" (code-name (second (code-items name-token))))
                                         (code-name (if (equal head "sb-alien:define-alien-routine")
                                                        (second (code-items name-token)) (first (code-items name-token)))))
                                     (code-name name-token)))
                           (doc (cond ((member head '("defun" "defmacro" "deftype" "define-setf-expander") :test #'equal)
                                       (code-body-docstring (cdddr items)))
                                      ((equal head "defstruct")
                                       (let ((candidate (third items)))
                                         (when (and candidate (eq (code-token-kind candidate) :string)) candidate)))
                                      ((member head '("defclass" "define-condition") :test #'equal)
                                       (code-documentation-option (nthcdr 4 items)))
                                      ((equal head "defgeneric") (code-documentation-option (cdddr items)))
                                      ((member head '("defvar" "defparameter" "defconstant") :test #'equal)
                                       (let ((candidate (fourth items)))
                                         (when (and candidate (eq (code-token-kind candidate) :string)) candidate)))))
                           (signature (cond ((member head '("defun" "defmacro" "deftype" "defgeneric" "define-setf-expander") :test #'equal)
                                              (code-spelling (third items) text))
                                            ((equal head "defstruct") (code-spelling name-token text))
                                            ((member head '("defvar" "defparameter" "defconstant") :test #'equal)
                                             (code-spelling (third items) text)))))
                      (unless package (error "Definition without an IN-PACKAGE in ~A: ~A" file name))
                      (push (make-code-entry :package package :name name :kind head :file file
                                             :line (1+ (count #\Newline text :end (code-token-start token)))
                                             :signature signature :doc (when doc (code-token-text doc))
                                             :doc-start (when doc (code-token-start doc)) :doc-end (when doc (code-token-end doc))
                                             :form token :condition condition) entries)))))))
      (mapc (lambda (token) (visit token nil)) (tokenize-code text)))
    (dolist (entry entries) (setf (code-entry-declaration entry) (gethash (code-entry-name entry) declarations)))
    (values (nreverse entries) (nreverse packages))))

(defun collect-code-inventory ()
  (setf *code-files* (code-source-files) *code-entries* nil *code-packages* nil)
  (dolist (file *code-files*)
    (multiple-value-bind (entries packages) (scan-code-file file)
      (setf *code-entries* (nconc *code-entries* entries) *code-packages* (nconc *code-packages* packages))))
  (setf *code-packages* (sort *code-packages* #'string< :key #'code-package-name))
  (unless (and *code-files* *code-entries* *code-packages*) (error "Empty Lisp source inventory.")))

(defun code-editorial-input ()
  (append
  (loop for entry in *code-entries* when (and (code-entry-doc entry) (code-entry-doc-start entry)) collect
    (object "file" (code-entry-file entry) "line" (code-entry-line entry)
            "package" (code-entry-package entry) "name" (code-entry-name entry)
            "start" (code-entry-doc-start entry) "end" (code-entry-doc-end entry)
            "original" (code-entry-doc entry) "translation" (code-entry-doc entry)))
  (loop for package in *code-packages* when (code-package-documentation package) collect
    (object "file" (code-package-file package) "line" (code-package-line package)
            "package" (code-package-name package) "name" "[package documentation]"
            "start" (code-package-doc-start package) "end" (code-package-doc-end package)
            "original" (code-package-documentation package) "translation" (code-package-documentation package)))))
