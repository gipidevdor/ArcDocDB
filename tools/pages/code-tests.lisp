(in-package #:arcdocdb.pages)

(defun run-code-tests ()
  (let ((count 0))
    (flet ((check (truth) (incf count) (unless truth (error "Code reference regression ~D failed." count))))
      (uiop:with-temporary-file (:pathname path :stream out :type "lisp" :prefix "arcdocdb-code-fixture-")
        (write-string "(defpackage #:fixture.source (:use #:cl) (:export #:read-one #:thing #:thing-value #:thing-error #:reason))
(in-package #:fixture.source)
#| (defun ignored ()) #| nested |# |#
(declaim (ftype (function (integer) integer) read-one))
(defun read-one (x)
  \"Pre: X is an integer. Post: returns X. The word \\\"quoted\\\" is literal.\"
  (list #\\) #\\( #\\; #.(error \"Reader evaluation must not execute.\"))
  '(error 'not-a-signal)
  (when (minusp x) (error 'invalid-argument)) x)
'(defun quoted-data () \"Not a definition.\")
(defun literal-result () \"A returned string, not a docstring.\")
#+(and sbcl arm64) (defun variant () \"ARM source variant.\" 1)
#-arm64 (defun variant () \"Other source variant.\" 2)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defstruct (thing (:constructor make-thing (value)) (:copier nil))
    \"A structure contract.\" (value 0 :type integer :read-only t)))
(define-condition thing-error (error)
  ((reason :initarg :reason :reader reason)) (:documentation \"A condition contract.\"))
" out)
        :close-stream
        (multiple-value-bind (entries packages) (scan-code-file (namestring path))
          (let* ((*code-entries* entries) (*code-packages* packages)
                 (function (find "read-one" entries :key #'code-entry-name :test #'equal))
                 (variants (remove-if-not (lambda (entry) (equal (code-entry-name entry) "variant")) entries)))
            (check (= (length entries) 6))
            (check (= (length packages) 1))
            (check (not (find-package "FIXTURE.SOURCE")))
            (check (equal (code-entry-signature function) "(x)"))
            (check (equal (code-entry-declaration function) "(function (integer) integer)"))
            (check (search "\"quoted\"" (code-entry-doc function)))
            (check (= (length variants) 2))
            (check (equal (mapcar #'code-entry-condition variants) '(("#+(and sbcl arm64)") ("#-arm64"))))
            (check (equal (code-direct-conditions function) '("invalid-argument")))
            (check (not (find "quoted-data" entries :key #'code-entry-name :test #'equal)))
            (check (null (code-entry-doc (find "literal-result" entries :key #'code-entry-name :test #'equal))))
            (collect-generated-code)
            (check (equal (code-entry-kind (first (code-export-bindings "fixture.source" "thing-value"))) "generated accessor"))
            (check (equal (code-entry-kind (first (code-export-bindings "fixture.source" "reason"))) "generated reader"))
            (check (null (code-export-bindings "fixture.source" "missing-export"))))))
      (dolist (broken '("(defun broken ()" "\"unterminated" "#| unterminated" ")" "#.("))
        (check (handler-case (progn (tokenize-code broken) nil) (error () t))))
      (check (not (find-package :arcdocdb.engine)))
      (let* ((entry (copy-code-entry (first *code-entries*))) (anchor (code-entry-anchor entry)))
        (incf (code-entry-line entry) 100)
        (check (equal anchor (code-entry-anchor entry))))
      (check (not (equal (code-anchor-component "%read") (code-anchor-component "_25_read"))))
      (check (= (length *code-files*) (length (code-source-files))))
      (check (every (lambda (package)
                      (every (lambda (name) (code-export-bindings (code-package-name package) name))
                             (code-package-exports package))) *code-packages*)))
    (format t "Code reference regression checks: ~D passed.~%" count)))
