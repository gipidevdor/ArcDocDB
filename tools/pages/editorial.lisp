(in-package #:arcdocdb.pages)

(defun protected-prose (text)
  "Exclude literal code, destinations and markup from prose-language checks."
  (dolist (pattern '("(?ms)^ *```[^\\n]*\\n.*?^ *```[^\\n]*$"
                     "(?ms)^ *~~~[^\\n]*\\n.*?^ *~~~[^\\n]*$"
                     "(?s)`[^`]*`" "\\]\\([^)]*\\)" "<[^>]+>" "https?://[^\\s)]+>?") text)
    (setf text (cl-ppcre:regex-replace-all pattern text " LITERAL "))))

(defun prose-issues (text)
  (let ((prose (protected-prose text)) (issues nil))
    (dolist (rule
             '(("ED-LANG" "(?i)(?<![a-z0-9_./:-])(della|delle|dello|senza|quindi|oppure|vengono|perché|può|devono|nessuno|nessuna|documentazione)(?![a-z0-9_./:-])" "Untranslated Italian prose")
               ("ED-US" "(?i)(?<![a-z0-9_./:-])(acknowledgements?|behaviours?|colours?|normalisation|optimisation|initialisation|catalogue)(?![a-z0-9_./:-])" "Use American English outside literal identifiers")
               ("ED-NUM" "(?<![a-z0-9_./:-])[0-9]{1,3}(?:\\.[0-9]{3}){2,}(?![a-z0-9_./:-])" "Use English separators for grouped prose numbers")
               ("ED-REPEAT" "(?i)\\b(the|an|and|of|to) +\\1\\b" "Repeated prose word")))
      (multiple-value-bind (start end) (cl-ppcre:scan (second rule) prose)
        (when start (push (format nil "~A: ~A (~A)" (first rule) (third rule) (subseq prose start end)) issues))))
    (nreverse issues)))

(defun check-editorial-sources ()
  (let ((issues nil) (count 0))
    (dolist (source (source-files))
      (incf count)
      (dolist (issue (prose-issues (read-text (merge-pathnames source *root*))))
        (push (format nil "~A: ~A" source issue) issues)))
    (when issues
      (dolist (issue (reverse issues)) (format *error-output* "~A~%" issue))
      (error "Editorial source checks failed: ~D issues." (length issues)))
    (format t "Editorial source checks: ~D documents, zero rule violations.~%" count)))

(defun editorial-page-issues (name nodes)
  (let ((issues nil) (csp nil) (referrer nil))
    (labels ((issue (rule detail) (push (format nil "~A in ~A: ~A" rule name detail) issues)))
      (dolist (node nodes)
        (let ((tag (plump:tag-name node)))
          (when (and (equal tag "meta") (equalp (plump:attribute node "http-equiv") "Content-Security-Policy"))
            (setf csp (plump:attribute node "content")))
          (when (and (equal tag "meta") (equal (plump:attribute node "name") "referrer"))
            (setf referrer (plump:attribute node "content")))
          (when (and (equal tag "img") (not (plump:has-attribute node "alt")))
            (issue "ED-ALT" "Image lacks an alt attribute"))
          (when (equal tag "input")
            (let ((id (plump:attribute node "id")))
              (unless (and id (find id nodes :test #'equal :key (lambda (n) (and (equal (plump:tag-name n) "label") (plump:attribute n "for")))))
                (issue "ED-LABEL" "Input lacks an associated label")))
            (unless (plump:has-attribute node "disabled")
              (issue "ED-PRIVACY" "Search must remain disabled before its local handlers are ready")))
          (when (and (equal tag "form") (or (plump:attribute node "action") (plump:attribute node "method")))
            (issue "ED-PRIVACY" "Unexpected visitor form submission endpoint"))
          (when (and (equal tag "script")
                     (or (not (plump:attribute node "src"))
                         (search "://" (plump:attribute node "src"))))
            (issue "ED-REMOTE" "Only local external script files are allowed"))
          (when (member tag '("iframe" "object" "embed") :test #'equal)
            (issue "ED-REMOTE" "Embedded visitor-facing third-party content needs a policy review"))
          (when (and (equal tag "th") (not (member (plump:attribute node "scope") '("col" "row" "colgroup" "rowgroup") :test #'equal)))
            (issue "ED-TABLE" "Table header has no scope"))
          (when (and (equal tag "pre") (equal (plump:attribute node "class") "mermaid")
                     (< (length (or (plump:attribute node "data-diagram-description") "")) 40))
            (issue "ED-DIAGRAM" "Diagram lacks its authored text description"))))
      (unless (and csp (search "form-action 'none'" csp) (search "connect-src 'self'" csp))
        (issue "ED-PRIVACY" "Required local-search page policy is missing"))
      (unless (equal referrer "no-referrer") (issue "ED-PRIVACY" "Referrer policy is missing"))
      (dolist (source '("docs/legal/README.md" "docs/legal/privacy.md" "docs/legal/third-party.md" "docs/legal/accessibility.md"))
        (unless (find (relative-url (page-route (find-page source)) name) nodes :test #'equal :key (lambda (node) (and (equal (plump:tag-name node) "a") (plump:attribute node "href"))))
          (issue "ED-NOTICE" (format nil "Missing publication notice link: ~A" source)))))
    (nreverse issues)))

(defun verify-publication-copies (output)
  (dolist (entry *publication-copies*)
    (let ((source (merge-pathnames (first entry) *root*))
          (published (merge-pathnames (second entry) output)))
      (unless (and (probe-file published) (equal (path-sha256 source) (path-sha256 published)))
        (error "Published license or notice is absent or differs from its source: ~A" (second entry)))))
  (prepare-publication)
  (unless (equal (getf (getf *notice-data* :bundle) :sha256)
                 (path-sha256 (merge-pathnames "static/mermaid.min.js" output)))
    (error "Published browser code does not match its notice inventory.")))

(defun relative-luminance (color)
  (let ((hex (subseq color 1)))
    (when (= (length hex) 3)
      (setf hex (format nil "~C~C~C~C~C~C" (char hex 0) (char hex 0)
                       (char hex 1) (char hex 1) (char hex 2) (char hex 2))))
    (unless (= (length hex) 6) (error "Unsupported publication color: ~A" color))
    (loop for offset in '(0 2 4) for weight in '(0.2126d0 0.7152d0 0.0722d0)
          for channel = (/ (parse-integer hex :start offset :end (+ offset 2) :radix 16) 255d0)
          sum (* weight (if (<= channel 0.04045d0) (/ channel 12.92d0)
                           (expt (/ (+ channel 0.055d0) 1.055d0) 2.4d0))))))

(defun color-contrast (foreground background)
  (let ((a (relative-luminance foreground)) (b (relative-luminance background)))
    (/ (+ (max a b) 0.05d0) (+ (min a b) 0.05d0))))

(defun verify-palette (output)
  "Check the declared text and focus pairs; this is not a browser/WCAG audit."
  (let ((css (read-text (merge-pathnames "static/site.css" output))) (count 0))
    (dolist (marker '(":root {" ":root:not([data-theme=\"light\"])" ":root[data-theme=\"dark\"]"))
      (let* ((position (or (search marker css) (error "Publication palette missing: ~A" marker)))
             (start (position #\{ css :start position))
             (end (position #\} css :start start))
             (block (subseq css start end)))
        (flet ((color (name)
                 (multiple-value-bind (match captures)
                     (cl-ppcre:scan-to-strings (format nil "--~A: *(#[a-fA-F0-9]{3,6})" name) block)
                   (unless match (error "Publication color --~A missing in ~A" name marker))
                   (aref captures 0))))
          (dolist (pair '(("ink" "paper" 4.5d0) ("muted" "paper" 4.5d0)
                          ("quiet" "paper" 4.5d0) ("ink" "wash" 4.5d0)
                          ("muted" "wash" 4.5d0) ("quiet" "wash" 4.5d0)
                          ("focus" "paper" 3d0) ("focus" "wash" 3d0)))
            (let ((ratio (color-contrast (color (first pair)) (color (second pair)))))
              (unless (>= ratio (third pair))
                (error "ED-CONTRAST ~A: ~A/~A gives ~,3F, requires ~,1F." marker (first pair) (second pair) ratio (third pair)))
              (incf count))))))
    count))
