(in-package #:arcdocdb.pages)

(defun elements (root)
  (let ((result nil))
    (labels ((walk (node)
               (when (plump:element-p node) (push node result))
               (when (typep node 'plump:nesting-node)
                 (loop for child across (plump:children node) do (walk child)))))
      (walk root))
    (nreverse result)))

(defun slug (title)
  "Match the repository's GitHub anchor convention, including Unicode letters."
  (with-output-to-string (out)
    (loop for c across (string-downcase (string-trim '(#\Space) title)) do
      (cond ((or (alphanumericp c) (find c "-_")) (write-char c out))
            ((char= c #\Space) (write-char #\- out))))))

(defun normalized-path (path source)
  (let ((parts (butlast (uiop:split-string source :separator '(#\/)))))
    (dolist (part (uiop:split-string path :separator '(#\/)))
      (cond ((member part '("" ".") :test #'equal))
            ((equal part "..")
             (unless parts (error "Link escapes the repository: ~A in ~A" path source))
             (setf parts (butlast parts)))
            (t (setf parts (append parts (list part))))))
    (format nil "~{~A~^/~}" parts)))

(defun rewrite-url (url source)
  (cond ((or (zerop (length url)) (char= (char url 0) #\#)
             (char= (char url 0) #\/)
             (cl-ppcre:scan "^[a-zA-Z][a-zA-Z0-9+.-]*:" url)) url)
        (t
         (let* ((end (or (position #\# url) (length url)))
                (query (position #\? url :end end))
                (path-end (or query end))
                (target (normalized-path (decode-url-part (subseq url 0 path-end)) source))
                (suffix (subseq url path-end))
                (page (find target *pages* :key #'page-source :test #'equal)))
           (cond ((publication-copy-url target)
                  (concatenate 'string (relative-url (publication-copy-url target)) suffix))
                 (page (concatenate 'string (relative-url (page-route page)) suffix))
                 ((and (probe-file (merge-pathnames target *root*))
                       (member (string-downcase (or (pathname-type target) ""))
                               '("svg" "png" "jpg" "jpeg" "webp" "gif") :test #'equal))
                  (concatenate 'string (relative-url target) suffix))
                 ((probe-file (merge-pathnames target *root*))
                  (concatenate 'string (source-url target) suffix))
                 (t (error "Unresolved documentation link ~A in ~A" url source)))))))

(defun rewrite-srcset (value source)
  (format nil "~{~A~^, ~}"
          (loop for item in (uiop:split-string value :separator '(#\,))
                for parts = (remove "" (uiop:split-string (string-trim '(#\Space) item)
                                                         :separator '(#\Space #\Tab)) :test #'equal)
                when parts collect (format nil "~A~{ ~A~}" (rewrite-url (first parts) source) (rest parts)))))

(defun normalize-table-gaps (text)
  "Render legacy table row gaps without changing the canonical Markdown.
Keep the gap when the following row starts a distinct table, and keep fences."
  (let* ((lines (coerce (uiop:split-string text :separator '(#\Newline)) 'vector))
         (fence nil) (in-table nil))
    (labels ((row-p (line) (uiop:string-prefix-p "|" (string-left-trim '(#\Space) line)))
             (separator-p (line) (cl-ppcre:scan "^ *\\|? *:?-{3,}" line)))
      (with-output-to-string (out)
        (loop for line across lines for n from 0 do
          (when (or (uiop:string-prefix-p "```" line) (uiop:string-prefix-p "~~~" line))
            (setf fence (not fence) in-table nil))
          (unless fence
            (cond ((separator-p line) (setf in-table t))
                  ((and (plusp (length line)) (not (row-p line))) (setf in-table nil))))
          (let* ((next (1+ n))
                 (skip (and in-table (not fence) (zerop (length line))
                            (< next (length lines)) (row-p (aref lines next))
                            (or (>= (1+ next) (length lines))
                                (not (separator-p (aref lines (1+ next))))))))
            (unless skip (write-string line out) (terpri out))))))))

(defun render-markdown (page)
  (let* ((source (page-source page))
         (*current-page* page)
         (3bmd-tables:*tables* t)
         (3bmd-code-blocks:*code-blocks* t)
         (3bmd-code-blocks:*renderer* :nohighlight)
         (3bmd:*smart-quotes* nil)
         (tree (plump:parse
                (with-output-to-string (out)
                  (3bmd:parse-string-and-print-to-stream
                   (concatenate 'string
                                (normalize-table-gaps (read-text (merge-pathnames source *root*)))
                                (if (equal source "docs/legal/third-party.md") (notice-table) "")) out))))
         (seen (make-hash-table :test #'equal))
         (headings nil) (title nil) (description nil) (diagram 0))
    (dolist (node (elements tree))
      (let ((tag (plump:tag-name node)))
        (when (and (equal tag "th") (not (plump:attribute node "scope")))
          (setf (plump:attribute node "scope") "col"))
        (when (and (equal tag "pre") (equal (plump:attribute node "class") "mermaid"))
          (let ((text (nth (incf diagram) (assoc source *diagram-descriptions* :test #'equal))))
            (unless text (error "A Mermaid diagram needs an authored text description: ~A #~D" source diagram))
            (setf (plump:attribute node "data-diagram-description") text)
            (let ((paragraph (make-instance 'plump:element :tag-name "p" :parent (plump:parent node))))
              (setf (plump:attribute paragraph "class") "diagram-description")
              (plump:make-text-node paragraph text)
              (plump:insert-before node paragraph))))
        (when (and (equal tag "p") (not description) (> (length (plain (plump:text node))) 40))
          (setf description (plain (plump:text node))))
        (when (member tag '("h1" "h2" "h3" "h4" "h5" "h6") :test #'equal)
          (let* ((text (plain (plump:text node)))
                 (base (slug text)) (count (gethash base seen 0))
                 (id (if (zerop count) base (format nil "~A-~D" base count))))
            (incf (gethash base seen 0))
            (setf (plump:attribute node "id") id)
            (when (equal tag "h1")
              (if title (setf (plump:tag-name node) "h2") (setf title text)))
            (when (member (plump:tag-name node) '("h2" "h3") :test #'equal)
              (push (list id text (plump:tag-name node)) headings))))
        (dolist (attr '("href" "src"))
          (let ((value (plump:attribute node attr)))
            (when value (setf (plump:attribute node attr) (rewrite-url value source)))))
        (let ((srcset (plump:attribute node "srcset")))
          (when srcset (setf (plump:attribute node "srcset") (rewrite-srcset srcset source))))))
    (unless title (error "Markdown document has no title: ~A" source))
    (setf (page-title page) title
          (page-headings page) (nreverse headings)
          (page-description page) (subseq (or description title) 0 (min 180 (length (or description title))))
          (page-text page) (plain (plump:text tree))
          (page-html page) (plump:serialize tree nil))
    page))

;; An actual Codex/CommonDoc extension: Markdown remains canonical, while Codex
;; expands each page macro and emits it through our registered HTML template.
(common-doc:define-node markdown-page (common-doc.macro:macro-node)
  ((path :reader markdown-path :type string :attribute-name "path"))
  (:tag-name "arc:page"))

(defclass rendered-page (common-doc:document-node)
  ((html :initarg :html :reader rendered-html)))

(defmethod common-doc.macro:expand-macro ((node markdown-page))
  (let ((page (find-page (markdown-path node))))
    (make-instance 'rendered-page :html (page-html page))))

(defmethod common-html.emitter::emit ((node rendered-page))
  (write-string (rendered-html node) common-html.emitter::*output-stream*))
