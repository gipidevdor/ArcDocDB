(in-package #:arcdocdb.pages)

(defun run-tests ()
  (let ((count 0))
    (flet ((check (truth) (incf count) (unless truth (error "Documentation regression ~D failed." count))))
      (check (equal (slug "Commit, snapshot & MVCC") "commit-snapshot--mvcc"))
      (check (equal (slug "A `key` → B") "a-key--b"))
      (check (equal (plain "AP-01 QA-01 FMEA") "AP-01 QA-01 FMEA"))
      (check (equal (plain (format nil "A~CB" (code-char #xA0))) "A B"))
      (check (equal (decode-url-part "atomicità") "atomicità"))
      (check (equal (decode-url-part "atomicit%C3%A0") "atomicità"))
      (check (equal (decode-url-part "crc+wal") "crc+wal"))
      (check (handler-case (progn (decode-url-part "bad%xy") nil) (error () t)))
      (check (not (search (format nil "~%~%|")
                          (normalize-table-gaps (format nil "| A | B |~%|---|---|~%| 1 | 2 |~%~%| 3 | 4 |~%")))))
      (check (search (format nil "~%~%|")
                     (normalize-table-gaps (format nil "| A | B |~%|---|---|~%| 1 | 2 |~%~%| C | D |~%|---|---|~%"))))
      (check (equal (json (object "key" (format nil "quote\"~%slash\\"))) "{\"key\":\"quote\\\"\\u000Aslash\\\\\"}"))
      (check (equal (relative-url "docs/architettura.html" "docs/adr/README.html") "../architettura.html"))
      (check (equal (relative-url "index.html" "docs/implementazione/README.html") "../../index.html"))
      (check (equal (relative-url "search-index.json" "index.html") "search-index.json"))
      (let ((*current-page* (find-page "docs/architettura.md")))
        (check (equal (rewrite-url "adr/README.md#decisioni" "docs/architettura.md") "adr/README.html#decisioni"))
        (check (equal (rewrite-url "#snapshot" "docs/architettura.md") "#snapshot"))
        (check (equal (rewrite-url "https://example.org/manual.md" "docs/architettura.md") "https://example.org/manual.md"))
        (check (search "/blob/" (rewrite-url "../src/engine/package.lisp" "docs/architettura.md")))
        (check (handler-case (progn (rewrite-url "../../../../lost.md" "docs/architettura.md") nil) (error () t)))
        (check (handler-case (progn (rewrite-url "missing-document.md" "docs/architettura.md") nil) (error () t))))
      (let ((3bmd-tables:*tables* t) (3bmd-code-blocks:*code-blocks* t)
            (3bmd-code-blocks:*renderer* :nohighlight))
        (let ((html (with-output-to-string (out)
                      (3bmd:parse-string-and-print-to-stream
                       (format nil "# Title~%~%| A | B |~%|---|---|~%| one | two |~%~%```lisp~%(print \"<ok>\")~%```~%") out))))
          (check (search "<table" html))
          (check (search "&lt;ok&gt;" html))
          (check (search "<pre class=\"lisp\">" html))))
      (check (equal (page-group (find-page "docs/analisi-progettuale.md")) "design"))
      (check (equal (page-group (find-page "docs/specifica/specifica-originale.md")) "design"))
      (check (> (length (remove-if-not (lambda (p) (equal (page-group p) "decisions")) *pages*)) 70))
      (check (not (find-package :arcdocdb.engine)))
      (check (prose-issues "The reader reader is fast. The the record is valid."))
      (check (prose-issues "The behaviour is documented."))
      (check (prose-issues "This uses 17.179.869.184 bytes."))
      (check (prose-issues "Read this senza a lock."))
      (check (null (prose-issues "Use `leggi` and `verifica` and the record.")))
      (check (null (prose-issues (format nil "```lisp~%della colour 17.179.869.184~%```~%"))))
      (check (null (prose-issues "Read the [method](metodo-della-verifica.md) for 16,777,216 bytes.")))
      (check (< (abs (- (color-contrast "#000" "#fff") 21d0)) 0.00001d0))
      (check (< (color-contrast "#737378" "#f5f5f7") 4.5d0))
      (check (equal (publication-copy-url "LICENSE") "licenses/ArcDocDB-BSD-2-Clause.txt"))
      (check (equal (page-group (find-page "docs/legal/privacy.md")) "publication"))
      (check (= (length (getf *notice-data* :components)) 71))
      (check (every (lambda (entry) (getf entry :notices)) (getf *notice-data* :components)))
      (check (not (notice-header-present-p '(:name "Missing component" :version "0" :license "MIT" :source "missing") "unrelated notice")))
      (check (not (find-if (lambda (p) (and (page-source p) (uiop:string-prefix-p "spikes/results/" (page-source p)))) *pages*))))
    (format t "~&Documentation regression checks: ~D passed.~%" count)))
